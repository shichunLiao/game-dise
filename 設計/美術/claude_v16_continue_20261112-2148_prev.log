(); }","+  x.strokeStyle = 'rgba(168,32,43,.55)'; x.lineWidth = 3; x.strokeRect(m + 16, m + 16, W - 2 * m - 32, H - 2 * m - 32);","+  const s = 0.78; x.drawImage(im, W * (1 - s) / 2, H * (1 - s) / 2, W * s, H * s);","+}","+function buildDeco(g) {","+  if (!ART.on) return;","+  deco = { stage: [], n: 0 };","+  const flat = (map, o) => new THREE.MeshLambertMaterial(Object.assign({ map, transparent: true, alphaTest: 0.35, side: THREE.DoubleSide }, o || {}));","+  // 守舊：小戲台後面那幅背幕，往後仰一點對著戲台鏡頭；只在台上出現（別的鏡頭要看得見對面的阿檀）","+  const sj = artTex('deco/shoujiu.png');","+  if (sj) {","+    const w = 1.2, h = w / 1.5, m = new THREE.Mesh(new THREE.PlaneGeometry(w, h).translate(0, h / 2, 0), new THREE.MeshLambertMaterial({ map: sj }));","+    m.position.set(0, TOP + 0.108, -0.62); m.rotation.x = -0.36; m.visible = false; g.add(m); deco.stage.push(m); deco.n += 1;","+  }","+  // 台毯：暗朱紅的團花回紋，平鋪在台板上，四邊留一圈木板","+  const cp = artTex('deco/carpet.png');","+  if (cp) {","+    cp.wrapS = cp.wrapT = THREE.RepeatWrapping; cp.repeat.set(2.5, 1.35);","+    const m = new THREE.Mesh(new THREE.PlaneGeometry(1.42, 0.76), toon(0xffffff, cp)); m.rotation.x = -Math.PI / 2; m.position.set(0, TOP + 0.1115, -0.2); g.add(m); deco.n += 1;","+  }","+  // 窗花：後牆格窗的窗紙上，如意、蝙蝠、牡丹、燈籠各一（灯坊、門口、夜裡的鏡頭看得見）","+  [[1, -1.81, 1.4], [2, -1.29, 1.96], [3, 1.29, 1.96], [4, 1.81, 1.4]].forEach(([n, x0, y0]) => {","+    const t = artTex(`deco/chuanghua_0${n}.png`);","+    if (!t) return;","+    const m = new THREE.Mesh(new THREE.PlaneGeometry(0.42, 0.42), flat(t, { emissive: 0x220406 })); m.position.set(x0, y0, -3.085); g.add(m); deco.n += 1;","+  });","+  // 臉譜剪紙：裱在宣紙上，貼在格窗兩邊的牆上","+  [[1, -2.5, 1.6, 0.05], [2, -2.98, 1.52, -0.04], [3, 2.5, 1.6, -0.05], [4, 2.98, 1.52, 0.04]].forEach(([n, x0, y0, rz]) => {","+    const t = artTex(`deco/lianpu_0${n}.png`, mountPaper);","+    if (!t) return;","+    const m = new THREE.Mesh(new THREE.PlaneGeometry(0.4, 0.5), flat(t, { alphaTest: 0.1, emissive: 0x141010 })); m.position.set(x0, y0, -3.085); m.rotation.z = rz; g.add(m); deco.n += 1;","+  });","+  // 燈紙：那盞燈的每一片紅紙上印極淡的墨線小團花（原圖很淡，疊幾次才看得出）","+  const lp = artImg('deco/lampaper.png');","+  if (lp && lampPatches.length) {","+    const c = document.createElement('canvas'); c.width = 128; c.height = 512;","+    const x = c.getContext('2d'); x.fillStyle = '#b3202b'; x.fillRect(0, 0, 128, 512);","+    for (let k = 0; k < 4; k++) for (let i = 0; i < 4; i++) x.drawImage(lp, 0, i * 128, 128, 128);","+    const t = new THREE.CanvasTexture(c);","+    lampPatches.forEach(p => { p.material.map = t; p.material.color.setHex(0xffffff); p.material.needsUpdate = true; });","+    deco.n += 1;","+  }","+  // 木匣蓋：如意雲頭，染赭金，貼在蓋子外面","+  const cl = artTint('deco/chest_lid.png', '#b8913f', 512);","+  if (cl && chestLid) {","+    const m = new THREE.Mesh(new THREE.PlaneGeometry(0.34, 0.34), new THREE.MeshLambertMaterial({ map: new THREE.CanvasTexture(cl), transparent: true, alphaTest: 0.3 }));","+    m.rotation.x = -Math.PI / 2; m.position.y = 0.0158; chestLid.add(m); deco.n += 1;","+  }","+}","+// 換鏡頭時：守舊只在戲台上出現","+function artScene(v) {","+  if (!deco) return;","+  deco.stage.forEach(m => { m.visible = v === 'stage'; });"," }"," // 鏡頭：全桌、戲台、門口（她起身伸手過來）、對面、夜裡的鏡子"," const VIEWS = {"]}]}],"moreFiles":0,"changedFiles":["/Users/tsun/Projects/game-dise/原型/v1.6/index.html"]}},"tool_result_meta":[{"id":"toolu_01HWbhLSASUvm4dwvBJn5B3j","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
