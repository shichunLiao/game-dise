);\n3251\t// 台下聊起她今晚的事：第 1 天在第二張之後，其餘天在第一張之後\n3252\tfunction crowdIntel() {\n3253\t  const t = S.T;\n3254\t  // 第 1 天傍晚是自動的，台下不聊她\n3255\t  if (S.day === 1 || t.heard || seatEmpty(S) || S.choice === 'stage' || S.choice === 'lamp') return;\n3256\t  if (!hearCrowd(S)) return;\n3257\t  const nd = needOf(S);\n3258\t  setTimeout(() => {\n3259\t    const html = `${CROWD_TX[nd.look]}${nd.items[1] ? `还有人说，${CROWD_B[nd.items[1].look]}` : ''}`;\n3260\t    bubble(`${html}<div><span class=\"itag\">今晚她要：${recipeShort(nd)}</span></div>`, 'intel');\n3261\t    refresh();\n3262\t  }, 650);\n3263\t}\n3264\tconst onStage = id => run(async () => {\n3265\t  const name = tOf(S, id).n, f = fOf(S, id);\n3266\t  await fly(id, 'stage');\n3267\t  const p = playStage(S, id);\n3268\t  if (!p) return;\n3269\t  if (actor) { actor.perform(f); actor.setLayers(S.T.layers); }\n3270\t  sfx(p.broke ? 'boo' : 'cheer');\n3271\t  const tp = tOf(S, id), t = S.T;\n3272\t  // 台下：起伏、說話；聚光燈跟著連擊亮起來\n3273\t  crowdKick(p.broke ? 'down' : t.chain >= 3 ? 'big' : 'up');\n3274\t  stageHeat = p.broke ? 0 : Math.min(2.4, (t.chain - 1) * 0.6);\n3275\t  if (glOK && p.broke) { lights.spot.color.setHex(0xff6a5a); setTimeout(() => lights.spot.color.setHex(0xffe0b0), 600); }\n3276\t  const pool = p.broke ? CROWD.broke : p.seeped ? CROWD.seep : p.fin ? CROWD.fin : tp.wild && (p.hit || p.open || t.plays.length === 1) ? CROWD.wild : tp.boost && p.hit ? CROWD.boost : tp.clean ? CROWD.clean : tp.heavy ? CROWD.heavy : tp.blank ? CROWD.blank : p.open ? CROWD.open : t.chain >= 3 ? CROWD.big : CROWD.hit;\n3277\t  // 第一天只在第一張和接錯時開口；教學框開著也不插嘴\n3278\t  if ((S.day > 1 || p.broke || t.plays.length === 1) && !coachOn()) bubble(esc(pick(pool)), p.broke ? 'boo' : 'n');\n3279\t  comboFx(p);\n3280\t  if (p.broke) say('', p.grudge ? '台下一声低低的嘘，跟着你下了台。' : '台下一声低低的嘘。', p.grudge ? '接错了 · 怨气 +1' : '接错了');\n3281\t  else if (p.seeped) say('', '这一层没挂住，直接渗了进去。', p.extra ? `连击 +${p.extra} 金` : '');\n3282\t  else if (p.open) sayN(`开得正 +${p.open} 金`);\n3283\t  else if (t.plays.length === 1 && tp.wild) sayN('百搭起手');\n3284\t  else sayN(`连击 ×${t.chain} · 多 ${p.extra} 金${tp.boost ? '（托）' : ''}${p.fin ? ` · 压轴 +${p.fin}` : ''}${tp.heavy ? ' · 两层' : ''}${tp.clean ? ' · 不上妆' : ''}`);\n3285\t  crowdIntel();\n3286\t});\n3287\tconst onEndStage = () => run(async () => {\n3288\t  endStage(S);\n3289\t  const t = S.T;\n3290\t  if (t.die !== null) await showDice({ label: '连击到 3：掷到 4 以上，金 ×1.5', v: t.die, ok: t.perfect, result: t.perfect ? '完美' : '没中，不扣金' });\n3291\t  if (t.gold) { burst(t.gold * 2); sfx('cheer'); crowdKick('big'); }\n3292\t  if (t.perfect) { stamp('完美'); bubble(esc(pick(CROWD.perfect)), 'n'); spawn('foil', 140); spawn('ribbon', 8); [0, 300, 600, 900].forEach(d => setTimeout(() => spawn('fw', 70, { x: innerWidth * (0.15 + Math.random() * 0.7), y: innerHeight * (0.1 + Math.random() * 0.25) }), d)); }\n3293\t  stageHeat = t.perfect ? 2.4 : 0.6;\n3294\t  actor?.pose('bow');\n3295\t  const who = S.choice === 'cover' ? `这 ${t.gold} 金，记在小凤名下。` : S.choice === 'stage' ? `元宵，金 ×2：${t.gold} 金。` : '';\n3296\t  say('班主', t.plays.length ? (who || `散戏。${t.gold} 金。`) : '今天你没有上台。');\n3297\t});\n3298\tconst onToDoor = () => run(async () => {\n3299\t  parts.length = 0;\n3300\t  if (S.phase === 'night') {\n3301\t    await ink(() => { view = 'night'; placeScene(); say('', ''); });\n3302\t    say('', '元宵的灯笼从窗外过去。你没有回家。', S.T.layers.length ? '剩下的牌还能卸。' : '');\n3303\t    return;\n3304\t  }\n3305\t  await ink(() => { view = 'door'; placeScene(); say('', ''); });\n3306\t  if (glOK && S.scars <= R.wipeScarMax && S.T.layers.length && !seatEmpty(S)) wife.pose('reach');\n3307\t  if (!S.T.layers.length) say('', '脸是干净的。');\n3308\t  else if (S.scars <= R.wipeScarMax) say('阿檀', '回来啦。擦一擦？');\n3309\t  else say('', '她坐着，没有起身。');\n3310\t});\n3311\tconst onWipe = () => run(async () => {\n3312\t  if (!canWipe(S)) return;\n3313\t  const n = Math.min(R.wipeLayers, S.T.layers.length), cols = S.T.layers.slice(-n).reverse().map(l => FCOL[l.f]);\n3314\t  if (gl