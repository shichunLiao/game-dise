); cl.position.set(0, 0.145, -0.1); cl.rotation.x = -0.6; chest.add(inked(cl, 0.004));\n  chestG = new THREE.Group(); chestG.position.set(0, 0.13, 0); chest.add(chestG);\n}\nfunction buildTable() {\n  const g = new THREE.Group(); scene.add(g);\n  const wall = plane(9, 4.5, new THREE.MeshLambertMaterial({ map: latticeTex() })); wall.position.set(0, 2.1, -3.1); g.add(wall);\n  const floor = plane(12, 12, toon(0x1c130e)); floor.rotation.x = -Math.PI / 2; g.add(floor);\n  const top = box(3.7, 0.08, 2.6, toon(0xffffff, woodTex())); top.position.set(0, TOP - 0.04, -0.15); g.add(inked(top, 0.008));\n  [[-1.75, 0.98], [1.75, 0.98], [-1.75, -1.28], [1.75, -1.28]].forEach(([a, b]) => { const l = box(0.1, TOP - 0.08, 0.1, toon(0x20130c)); l.position.set(a, (TOP - 0.08) / 2, b); g.add(l); });\n  stainM = new THREE.MeshBasicMaterial({ map: stainTex(), transparent: true, opacity: 0, depthWrite: false });\n  const st = plane(3.7, 2.6, stainM); st.rotation.x = -Math.PI / 2; st.position.set(0, TOP + 0.002, -0.15); g.add(st);\n  buildMiniStage(g); buildBox(g); buildMirror(g); buildRope(g); buildSeat(g); buildCrowd(g);\n  goldG = new THREE.Group(); goldG.position.set(0.98, TOP, 0.42); g.add(goldG);\n  lights.c1 = candle(g, -0.42, TOP, -0.92); lights.c2 = candle(g, 0.98, TOP, 0.05);\n  lights.hemi = new THREE.HemisphereLight(0xf3e4d0, 0x241812, 0.7); g.add(lights.hemi);\n  lights.key = new THREE.DirectionalLight(0xfff1dc, 0.5); lights.key.position.set(-2, 4, 3); g.add(lights.key);\n}\n// 鏡頭：全桌、戲台、門口（她起身伸手過來）、對面、夜裡的鏡子\nconst VIEWS = {\n  table: { pos: [0, 2.2, 2.72], look: [0, 0.62, -0.42] },\n  stage: { pos: [0, 2.62, 0.9], look: [0, 0.74, -0.08] },\n  door: { pos: [0.2, 1.72, 2.05], look: [0.2, 0.84, -0.65] },\n  home: { pos: [0, 1.66, 1.5], look: [0.1, 0.72, -1.15] },\n  night: { pos: [0.42, 1.78, 2.05], look: [0.42, 0.72, -0.28] },\n  mirror: { pos: [1.02, 1.26, 1.06], look: [1.3, 1.14, -0.02] },\n  lamp: { pos: [0.98, 1.42, 0.22], look: [0.5, 0.98, -0.98] },\n};\nconst MOODS = {\n  day: { hemi: 0.75, key: 0.55, spot: 0.5, c: 1.0, bg: 0x241a14 },\n  stage: { hemi: 0.34, key: 0.2, spot: 2.6, c: 0.6, bg: 0x0d0a0c },\n  door: { hemi: 0.3, key: 0.18, spot: 0, c: 0.9, bg: 0x0a0a10 },\n  home: { hemi: 0.52, key: 0.3, spot: 0, c: 1.4, bg: 0x1a1210 },\n  night: { hemi: 0.13, key: 0.05, spot: 0, c: 1.5, bg: 0x070506 },\n};\nfunction focus(v, mood) {\n  if (!glOK) return;\n  const fit = camera.aspect < 0.8 ? 1.72 : camera.aspect < 1.25 ? 1.32 : 1;\n  const d = VIEWS[v], l = V(...d.look), p = V(...d.pos).sub(l).multiplyScalar(fit).add(l);\n  camTo = { p, l };\n  if (!camPos) { camPos = p.clone(); camAim = l.clone(); }\n  if (mood) moodTo = MOODS[mood];\n}\nfunction initGL() {\n  if (!glOK) return;\n  try { renderer = new THREE.WebGLRenderer({ canvas: $('#gl'), antialias: true }); } catch (e) { glOK = false; return; }\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n  renderer.setSize(innerWidth, innerHeight);\n  scene = new THREE.Scene();\n  camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.03, 40); scene.add(camera);\n  clock = new THREE.Clock();\n  const d = new Uint8Array([70, 70, 70, 150, 150, 150, 220, 220, 220, 255, 255, 255]);\n  grad = new THREE.DataTexture(d, 4, 1, THREE.RGBFormat); grad.minFilter = grad.magFilter = THREE.NearestFilter; grad.generateMipmaps = false; grad.needsUpdate = true;\n  backTex = new THREE.CanvasTexture(drawBack());\n  buildTable();\n  const tw = plane(0.5, 0.36, new THREE.MeshLambertMaterial({ map: canvasTex(256, 180, (x, w, h) => { x.fillStyle = '#f4efe6'; x.fillRect(0, 0, w, h); x.strokeStyle = '#cfc6b8'; x.lineWidth = 4; for (let i = 0; i < 6; i++) { x.beginPath(); x.moveTo(0, 20 + i * 28); x.quadraticCurveTo(w / 2, 10 + i * 28, w, 24 + i * 28); x.stroke(); } }), side: THREE.DoubleSide, transparent: true }));\n  towel = tw; towel.visible = false; camera.add(towel);\n  addEventListener('resize', () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); renderSmear(); });\n  addEventListener('pointermove', e => { pointer.x = e.clientX / innerWidth - 0.5; pointer.y = e.clientY / innerHeight - 0.5; });\n  requestAnimationFrame(loop);\n}\nfunction tween(dur, fn) {\n  if (!glOK || calm()) { fn(1); return Promise.resolve(); }\n  // 分頁在背景時畫面不更新：動畫不能卡住流程，時間到了就直接跳到結尾\n  return new Promise(res => {\n    const w = { t: 0, dur: dur / 1000, fn, res };\n    tweens.push(w);\n    setTimeout(() => { const i = tweens.indexOf(w); if (i >= 0) { tweens.splice(i, 1); fn(1); res(); } }, dur + 500);\n  });\n}\nconst ease = e => (e < 0.5 ? 2 * e * e : 1 - Math.pow(-2 * e + 2, 2) / 2);\nfunction loop() {\n  requestAnimationFrame(loop);\n  // 補間動畫按真實時間走：幀率低時不能跟著變慢，否則流程會等很久\n  const raw = clock.getDelta(), dt = Math.min(raw, 0.05), t = clock.elapsedTime;\n  for (let i = tweens.length - 1; i >= 0; i--) { const w = tweens[i]; w.t += Math.min(raw, 0.25); const k = Math.min(1, w.t / w.dur); w.fn(ease(k)); if (k >= 1) { tweens.splice(i, 1); w.res(); } }\n  if (camTo) {\n    const k = calm() ? 1 : 1 - Math.exp(-Math.min(raw, 0.25) * 2.6);\n    camPos.lerp(camTo.p, k); camAim.lerp(camTo.l, k);\n    camera.position.set(camPos.x + pointer.x * 0.1, camPos.y + Math.sin(t * 0.7) * 0.006 - pointer.y * 0.05, camPos.z);\n    camera.lookAt(camAim);\n  }\n  if (moodTo) {\n    const k = 1 - Math.exp(-Math.min(raw, 0.25) * 2.2);\n    lights.hemi.intensity += (moodTo.hemi - lights.hemi.intensity) * k;\n    lights.key.intensity += (moodTo.key - lights.key.intensity) * k;\n    lights.spot.intensity += (moodTo.spot + (moodTo === MOODS.stage ? stageHeat : 0) - lights.spot.intensity) * k;\n    [lights.c1, lights.c2].forEach(c => { c.base = moodTo.c; });\n    if (!scene.background) scene.background = new THREE.Color(moodTo.bg);\n    scene.background.lerp(new THREE.Color(moodTo.bg), k);\n  }\n  wife?.update(dt, t); actor?.update(dt, t);\n  if (crowdG && crowdG.visible) {\n    crowdTick(t);\n    swayKick *= Math.exp(-dt * 1.6); lanternKick *= Math.exp(-dt * 3);\n    stageCurtains.forEach((c, i) => { c.rotation.y = Math.sin(t * 3.2 + i * 2) * 0.12 * swayKick; c.rotation.z = Math.sin(t * 2.1 + i) * 0.03 * swayKick; });\n    lanterns.forEach((m, i) => { const k = 1 + lanternKick * (0.35 + 0.15 * Math.sin(t * 9 + i)); m.scale.set(k, 1.25 * k, k); });\n  }\n  [lights.c1, lights.c2].forEach(c => { if (c && c.base !== undefined) { c.fl.scale.y = 0.11 + Math.sin(t * 11) * 0.008; c.L.intensity = c.base * (0.92 + Math.sin(t * 13) * 0.05 + Math.sin(t * 7.3) * 0.03); } });\n  renderer.render(scene, camera);\n}\n// 桌面跟著狀態走：金堆、燈紙、痕、布、油彩漬、她的座位\nfunction updateTable() {\n  if (!glOK || !S) return;\n  const act = actOf(S.day), n = S.lit || S.litAlone ? 12 : Math.min(12, Math.round(S.lamp * 12 / R.lampFull));\n  lampPatches.forEach((p, i) => { p.visible = i < n; });\n  lampScars.forEach((m, i) => { m.visible = i < S.scars; });\n  lampLight.intensity = S.lit || S.litAlone ? 1.7 : 0;\n  stainM.opacity = [0, 0.8, 1][act] * Math.min(1, 0.75 + S.base * 0.1);\n  const z = SEAT_Z[act];\n  stool.position.set(0, 0, z - 0.02);\n  const empty = seatEmpty(S) || !!S.left;\n  wife.root.visible = !empty;\n  if (!empty) wife.root.position.set(0, -0.32, z);\n  // 晾繩上的布、木匣裡的布\n  while (clothG.children.length) clothG.remove(clothG.children[0]);\n  S.rope.slice(-24).forEach((e, i) => {\n    const m = plane(0.13, 0.19, new THREE.MeshBasicMaterial({ color: new THREE.Color(FCOL[e.f]).lerp(new THREE.Color(0xe6ddcf), 0.25), side: THREE.DoubleSide }));\n    m.position.set(-1.6 + i * 0.14, TOP + 0.16, 0.78); m.rotation.z = (i % 2 ? 1 : -1) * 0.05; clothG.add(m);\n  });\n  while (chestG.children.length) chestG.remove(chestG.children[0]);\n  S.chest.slice(-14).forEach((e, i) => { const m = box(0.3, 0.008, 0.2, new THREE.MeshLambertMaterial({ color: FCOL[e.f] })); m.position.y = i * 0.008; m.rotation.y = (i % 3 - 1) * 0.08; chestG.add(m); });\n  // 金箔堆\n  const coins = Math.min(44, Math.round(S.gold / 4));\n  while (goldG.children.length > coins) goldG.remove(goldG.children[goldG.children.length - 1]);\n  const r = rng(61 + goldG.children.length);\n  while (goldG.children.length < coins) { const i = goldG.children.length, m = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.008, 12), new THREE.MeshLambertMaterial({ color: 0xd9b25a, emissive: 0x3a2a08 })); m.position.set((r() - 0.5) * 0.2, 0.005 + i * 0.0035, (r() - 0.5) * 0.14); goldG.add(m); }\n  updateMirror();\n  updateLanterns();\n  setBoxStack();\n}\nfunction updateMirror() {\n  if (!glOK || !S) return;\n  drawPortrait(mirrorCv, { who: 'you', layers: S.T.layers, base: S.baseSeen ? S.base : 0, baseF: topFams()[0], bg: ['#8d9396', '#3b4044'] });\n  mirrorTex.needsUpdate = true;\n}\nfunction updateLanterns() {\n  if (!glOK || !S) return;\n  lanterns.forEach((m, i) => { const p = S.T.plays[i]; m.material.color.setHex(p ? (p.broke ? 0x7a3a2a : 0xff6a3c) : 0x4a1414); });\n}\nfunction setBoxStack() {\n  if (!glOK || !S) return;\n  while (boxStack.children.length) boxStack.remove(boxStack.children[0]);\n  const n = S.T.box.filter(id => !S.T.used[id]).length, m = new THREE.MeshLambertMaterial({ map: backTex });\n  for (let i = 0; i < n; i++) { const c = new THREE.Mesh(new THREE.BoxGeometry(0.29, 0.005, 0.19), [m, m, m, m, m, m]); c.position.set((i % 2) * 0.004, -0.05 + i * 0.006, 0); c.rotation.y = (i % 3 - 1) * 0.03; boxStack.add(c); }\n}\nfunction clear3DCards() { played3D.forEach(m => m.parent && m.parent.remove(m)); played3D = []; }\nfunction cardSpot(where, n) {\n  return where === 'stage' ? V(-0.54 + n * 0.27, TOP + 0.118, 0.04) : V(-0.34 + n * 0.34, TOP + 0.008, -0.72);\n}\nasync function spawnCard(t, side, pos) {\n  if (!glOK) return;\n  const m = cardMesh(t, side, side === 'stage' ? 1.4 : 1.3);\n  m.rotation.x = -Math.PI / 2; m.rotation.z = (Math.random() - 0.5) * (side === 'stage' ? 0.08 : 0.18); m.position.copy(pos); m.position.y += 0.25; scene.add(m); played3D.push(m);\n  const y0 = m.position.y;\n  await tween(300, k => { m.position.y = y0 - 0.25 * k; });\n}\nasync function towelSwipe(color) {\n  if (!glOK) { await wait(300); return; }\n  towel.visible = true; towel.material.color = new THREE.Color(0xffffff).lerp(new THREE.Color(color), 0.35);\n  await tween(620, k => { towel.position.set(-0.55 + 1.1 * k, 0.05 - Math.sin(k * Math.PI) * 0.1, -0.42); towel.rotation.z = -0.4 + 0.8 * k; });\n  towel.visible = false;\n}\n\n// 她的樣子：畫面為主，放大（滑過、聚焦或點開）才附文字\nconst LOOK_ICON = {\n  等: '<svg viewBox=\"0 0 24 24\"><path d=\"M2.5 12.5h8.5c0 3.2-1.9 5.3-4.25 5.3S2.5 15.7 2.5 12.5zM13 12.5h8.5c0 3.2-1.9 5.3-4.25 5.3S13 15.7 13 12.5z\" fill=\"currentColor\"/><path d=\"M15 10.5l4.5-7M17 10.5l4.5-7\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M4 20.5h16\" stroke=\"currentColor\" stroke-width=\"1\"/></svg>',\n  累: '<svg viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"9\" r=\"4.3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" transform=\"rotate(18 11 9)\"/><path d=\"M8.6 9.8q1 .7 2 0M11.8 10.6q1 .7 2 0\" stroke=\"currentColor\" fill=\"none\" stroke-width=\"1.1\"/><path d=\"M4 22c1-4.5 3.6-7.2 7.4-7.2S18 17.5 19 22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M16.5 3.2h3.2l-3.2 3.2h3.2\" stroke=\"currentColor\" fill=\"none\" stroke-width=\"1\"/></svg>',\n  忙: '<svg viewBox=\"0 0 24 24\"><ellipse cx=\"12\" cy=\"13.2\" rx=\"7\" ry=\"8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 5.2v16M7.4 6.8c-2 3.6-2 9.4 0 12.9M16.6 6.8c2 3.6 2 9.4 0 12.9M5 13.2h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\"/><rect x=\"9\" y=\"2\" width=\"6\" height=\"2.6\" fill=\"currentColor\"/></svg>',\n  想说: '<svg viewBox=\"0 0 24 24\"><path d=\"M3.5 4.5h17v11H10l-5 4.2v-4.2H3.5z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/><circle cx=\"8.5\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/><circle cx=\"15.5\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/></svg>',\n};\n\n// ── 教學小框：連擊、接口、被染第一次出現時解釋（第八節）；要玩家動手的步驟，只放行框裡的東西 ──\nconst TUT_KEY = 'dise-v15-tut';\nconst tutPref = () => { try { return localStorage.getItem(TUT_KEY) !== '0'; } catch (e) { return true; } };\nconst setTutPref = on => { try { localStorage.setItem(TUT_KEY, on ? '1' : '0'); } catch (e) { /* 存不了就算了 */ } };\nconst handOf = t => { const id = S.T.box.find(x => cardOf(S, x).t === t && !S.T.used[x]); return id === undefined ? null : document.querySelector(`.hc[data-id=\"${id}\"]`); };\nconst famOfLook = look => Object.keys(FAM).find(f => FAM[f].home === LOOK_HOME[look]);\n// 她要的：「累」照顧 ×2 + 「忙」共勞 ×1\nconst recipeTx = nd => nd.items.map(x => `「${x.look}」${HOME[LOOK_HOME[x.look]].n} ×${x.n}`).join(' + ');\nconst recipeShort = nd => nd.items.map(x => `${x.look}·${HOME[LOOK_HOME[x.look]].n}×${x.n}`).join(' + ');\nconst needTx = (nd = needOf(S)) => `要 ${nd.items.map(x => `<b>${HOME[LOOK_HOME[x.look]].n}</b>×${x.n}（${fc(famOfLook(x.look))}牌的背面）`).join(' + ')}`;\n// 3D 裡的東西在螢幕上的位置：教學框要指著它\nfunction anchor(name, at, w = 150, h = 150) {\n  let el = document.getElementById(`anc-${name}`);\n  if (!el) { el = document.createElement('div'); el.id = `anc-${name}`; $('#anchors').appendChild(el); }\n  if (!glOK) { el.style.display = 'none'; return null; }\n  const v = at.clone().project(camera);\n  if (v.z > 1 || Math.abs(v.x) > 0.95 || Math.abs(v.y) > 0.95) { el.style.display = 'none'; return null; }\n  const x = (v.x + 1) / 2 * innerWidth, y = (1 - v.y) / 2 * innerHeight;\n  Object.assign(el.style, { display: 'block', left: `${x - w / 2}px`, top: `${y - h / 2}px`, width: `${w}px`, height: `${h}px` });\n  return el;\n}\n// v1.5 教學：第 1 天手把手（做對了就往下，不用按「知道了」）；只看不做的步驟只留四處；其餘改成不擋畫面的小提示（NUDGES）\nconst handCards = () => Array.from(document.querySelectorAll('#hand .hc'));\nconst firstPlayed = () => { const p = S.T.plays[0]; return p ? cardOf(S, p.id).t : 'changqiang'; };\nconst LESSONS = {\n  open: [\n    { at: () => [handOf('changqiang')], until: () => S.T.plays.length > 0, text: () => `金框的牌能打。第一张要打木牌上的起手${fc('sing')}：点「长腔」。`, tap: '点这张' },\n  ],\n  chain: [\n    { at: () => [handOf('bai')], until: () => S.T.plays.length > 1, text: () => `长腔写着「接 → ${fc('speak')}」。下一张打${fc('speak')}，就接上了，多拿金。点「白」。`, tap: '点这张' },\n  ],\n  chain2: [\n    { at: handCards, place: 'left', until: () => S.T.plays.length >= 4 || S.T.ended, text: () => '金框的牌都接得上。照「接」再打两张。' },\n  ],\n  end: [\n    { at: () => [$('[data-act=\"endstage\"]')], until: () => S.T.ended, text: () => '四张了，脸上也有四层油彩。见好就收：点收场。', tap: '点收场' },\n  ],\n  door: [\n    { at: () => [glOK ? anchor('mirror', new THREE.Vector3(1.32, TOP + 0.46, -0.02), 200, 200) : $('#topmid')], follow: true, title: '你的脸', text: () => '台上打几张，脸上就有几层油彩。', rule: '进门前卸掉；没卸的，会染到推给她的牌' },\n    { at: handCards, place: 'left', until: () => !S.T.layers.length || view !== 'door', text: () => '点一张牌弃掉，卸一层。卸干净再进门。' },\n  ],\n  home: [\n    { title: '一张牌，两面', vis: () => `<div class=\"flip\"><div class=\"fl\"><img src=\"${cardArt(firstPlayed(), 'stage').url}\" alt=\"\"><img class=\"b\" src=\"${cardArt(firstPlayed(), 'home').url}\" alt=\"\"></div><div class=\"cap\">台上面：<b>${T[firstPlayed()].n}</b><br>家里面：<b>${HOME[FAM[T[firstPlayed()].f].home].n}</b></div></div>`, text: () => '台上打掉、卸妆弃掉的牌，今晚就没了。', rule: '留在手里的，回家翻过来推给她' },\n    { at: () => [$('#homep')], title: '她的灯', text: () => '往后每晚她要一样东西，推对了，灯亮一片。', rule: '没满足她，灯熄一截' },\n  ],\n  intel: [\n    { at: () => [$('.intel')], title: '今晚她要', text: () => `今晚她${needTx()}。`, rule: '印着「家」的牌，留着别打上台' },\n  ],\n  need: [\n    { at: handCards, place: 'left', title: '被染', read: () => !S.T.box.some(id => !S.T.used[id] && canHome(S, id) && isMatch(S, id) && !willDye(S, id)) && !S.T.box.some(id => !S.T.used[id] && canHome(S, id) && !isMatch(S, id)), until: () => gotOf(S.T) >= S.T.need.k || S.T.pushed.length >= S.T.homeCap, text: () => { const n = HOME[LOOK_HOME[S.T.need.items[0].look]].n, spare = S.T.box.some(id => !S.T.used[id] && canHome(S, id) && !isMatch(S, id)); return !S.T.dye ? `点金框的「${n}」，推给她。` : spare ? `牌角红的会被染：先推一张不要紧的，再推她要的「${n}」。` : `脸没卸干净，牌角红的会被染：推了，灯上留一道痕。下回卸干净再进门。`; } },\n  ],\n  pick: [\n    { at: () => [$('.spread')], title: '自己装妆匣', text: () => '上面是你的卡组：点一张，放进妆匣（下面一排）；点下面的，拿回去。', rule: '起手那一族一定要带；印着「家」的是她今晚要的' },\n  ],\n};\n// 小提示：不擋畫面、不用按；每條只出一次，同一時刻只有一條\nconst NUDGES = {\n  board: { at: () => $('#wboard'), when: () => view === 'morning' && S.day >= 2, tx: () => `<b>水牌</b>你和同门按卖座排名。第 3 天散戏后垫底，就被摘牌。` },\n  book: { at: () => $('#bookBtn'), when: () => view === 'morning' && S.day >= 2 && S.tut.seen.board, tx: () => '<b>图鉴</b>看不懂的牌和词，都在这里。' },\n  crowd: { at: () => $('.bub.intel'), when: () => view === 'stage', tx: () => '<b>台下的话</b>金框那句说的是她今晚要什么，会记在上面那一排。' },\n  wipe: { at: () => $('[data-act=\"wipe\"]'), when: () => view === 'door', tx: () => `<b>让她擦</b>一次擦 ${R.wipeLayers} 层，不耗牌；但今晚她只听得下 1 张。` },\n  stakes: { at: () => $('#homep'), when: () => view === 'night' && S.day >= 2 && !$('#lampfb:not([hidden])'), tx: () => `<b>她会走</b>灯熄满 ${R.brokenOuts} 回，或痕到 ${R.brokenScar} 道。` },\n  shop: { at: () => $('[data-act=\"shop\"]'), when: () => view === 'morning', tx: () => '<b>后台</b>孙师父卖牌和物件。花的就是卖座，名次会掉；越早买越划算。' },\n  wild: { at: () => $('.hc[data-wild].play'), when: () => view === 'stage', tx: () => '<b>百搭</b>前后都接得上，还能起手。链要断的时候用它。' },\n  grudge: { at: () => $('.nowline'), when: () => view === 'stage' && S.T.grudge > 0, tx: () => '<b>怨气</b>接错了，嘘声跟你回家：今晚多染一张牌。' },\n  gift: { at: () => $('.spread .spc[data-t^=\"home_\"]') || $('.spread'), when: () => view === 'morning' && S.gifts.length > 0 && !lockedBox(S), tx: () => '<b>家常牌</b>她送的，不上台。对上她的需要，一张算两张。' },\n};\nconst coach = { lesson: null, i: 0, shown: '' };\nfunction lessonNow() {\n  if (panel || sheet) return null;\n  const d = S.day, t = S.T;\n  if (view === 'stage') {\n    if (d !== 1) return null;\n    if (t.ended) return null;\n    return !t.plays.length ? 'open' : t.plays.length === 1 ? 'chain' : t.plays.length < 4 && !t.plays.some(p => p.broke) ? 'chain2' : t.plays.length >= 4 ? 'end' : null;\n  }\n  if (d === 1 && view === 'door' && t.layers.length) return 'door';\n  if (d === 1 && view === 'night') return 'home';\n  if (d === 2 && view === 'evening' && t.pushed.length === 0) return 'need';\n  if (view === 'morning' && !lockedBox(S) && d === 3) return 'pick';\n  if (view === 'morning' && d === 2) return 'intel';\n  return null;\n}\nfunction coachStart(k) { coach.lesson = k; coach.i = 0; coach.shown = ''; coach.view = view; }\nfunction coachNext() {\n  if (!coach.lesson) return;\n  coach.i += 1;\n  if (coach.i < LESSONS[coach.lesson].length) return;\n  S.tut.seen[coach.lesson] = true;\n  coach.lesson = null;\n  if ([...Object.keys(LESSONS), ...Object.keys(NUDGES)].every(k => S.tut.seen[k])) setTutPref(false);\n}\nfunction coachSkip() { S.tut.off = true; coach.lesson = null; setTutPref(false); nudgeHide(true); }\n// 狀態一變就看一次：要玩家做的事做到了就往下；這個時段還沒教過就開始教\nfunction coachTick() {\n  if (busy || !S || view === 'title' || !S.tut) return;\n  for (let n = 0; n < 4; n++) {\n    if (coach.lesson) {\n      // 換了場景：這一課就算教完了，不跟著帶過去\n      if (view !== coach.view) { S.tut.seen[coach.lesson] = true; coach.lesson = null; continue; }\n      const st = LESSONS[coach.lesson][coach.i];\n      if (!st.until || !st.until()) return;\n      coachNext();\n    } else {\n      const k = lessonNow();\n      if (!k || S.tut.off || S.tut.seen[k]) return nudgeTick();\n      coachStart(k);\n    }\n  }\n}\nfunction coachRender(geom = false) {\n  const el = $('#coach'), on = !!S && !!coach.lesson && !busy && view !== 'title' && panel !== 'rules';\n  $('#hud').inert = false;\n  if (!on) { el.hidden = true; return; }\n  const steps = LESSONS[coach.lesson], st = steps[coach.i], key = `${coach.lesson}:${coach.i}`;\n  const els = st.at ? st.at().filter(x => x && x.getClientRects().length) : [];\n  const act = !!st.until && els.length > 0 && !(st.read && st.read());\n  if (coach.shown !== key && st.on) st.on();\n  if (coach.shown !== key && els[0] && !els[0].closest('#anchors')) els[0].scrollIntoV