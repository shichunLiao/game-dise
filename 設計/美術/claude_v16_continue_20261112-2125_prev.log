d3D = [], lights = {}, cards3D = {}, crowd = [], crowdG = null, stageHeat = 0, stageCurtains = [], swayKick = 0, lanternKick = 0;\nlet pointer = { x: 0, y: 0 }, camTo = null, camPos = null, camAim = null, moodTo = null;\nconst V = (a, b, c) => new THREE.Vector3(a, b, c);\nPOSES.work = { pitch: 0.28, lean: 0.08, aL: [-1.05, -0.32], aR: [-1.05, 0.32] };\nfunction cardMesh(t, side, k = 1) {\n  const key = `${t}|${side}`;\n  if (!cards3D[key]) cards3D[key] = new THREE.CanvasTexture(cardArt(t, side).c);\n  const edge = new THREE.MeshLambertMaterial({ color: 0x2a1a1c });\n  const front = new THREE.MeshLambertMaterial({ map: cards3D[key] }), back = new THREE.MeshLambertMaterial({ map: backTex });\n  return new THREE.Mesh(new THREE.BoxGeometry(0.15 * k, 0.225 * k, 0.003), [edge, edge, edge, edge, front, back]);\n}\nfunction drawBack() {\n  const c = document.createElement('canvas');\n  const im = artImg('cards/back.png');\n  // v1.6：牌背圖（深朱紅底、扇格圓環），中間留空處由程式寫「底」\n  if (im) {\n    c.width = CW * 2; c.height = CH * 2;\n    const x = c.getContext('2d'); x.scale(2, 2);\n    x.save(); rr(x, 0, 0, CW, CH, 16); x.clip(); x.drawImage(im, 0, 0, CW, CH); x.restore();\n    paperOver(x, 'back');\n    x.fillStyle = '#7d1219'; x.font = '78px \"Ma Shan Zheng\", serif'; x.textAlign = 'center'; x.textBaseline = 'middle'; x.fillText('底', CW / 2, CH / 2 + 4);\n    return c;\n  }\n  c.width = CW; c.height = CH;\n  const x = c.getContext('2d');\n  rr(x, 0, 0, CW, CH, 16); x.fillStyle = '#120e11'; x.fill();\n  x.strokeStyle = '#a8202b'; x.lineWidth = 3; notch(x, 14, 14, CW - 28, CH - 28, 20); x.stroke();\n  x.fillStyle = '#7d1219'; x.beginPath(); x.arc(CW / 2, CH / 2, 96, 0, Math.PI * 2); x.fill();\n  x.fillStyle = '#efe2c8'; x.font = '60px \"Ma Shan Zheng\", serif'; x.textAlign = 'center'; x.textBaseline = 'middle'; x.fillText('底', CW / 2, CH / 2 + 3);\n  return c;\n}\nfunction latticeTex() {\n  return canvasTex(1024, 512, (x, w, h) => {\n    x.fillStyle = '#2a1c15'; x.fillRect(0, 0, w, h);\n    x.fillStyle = '#c9b48c'; x.fillRect(w * 0.27, h * 0.1, w * 0.46, h * 0.62);\n    x.strokeStyle = '#1e130d'; x.lineWidth = 10; x.strokeRect(w * 0.27, h * 0.1, w * 0.46, h * 0.62);\n    x.lineWidth = 5;\n    for (let i = 1; i < 8; i++) { x.beginPath(); x.moveTo(w * 0.27 + i * w * 0.46 / 8, h * 0.1); x.lineTo(w * 0.27 + i * w * 0.46 / 8, h * 0.72); x.stroke(); }\n    for (let i = 1; i < 5; i++) { x.beginPath(); x.moveTo(w * 0.27, h * 0.1 + i * h * 0.62 / 5); x.lineTo(w * 0.73, h * 0.1 + i * h * 0.62 / 5); x.stroke(); }\n  });\n}\nfunction woodTex() {\n  return canvasTex(1024, 720, (x, w, h) => {\n    x.fillStyle = '#3d2015'; x.fillRect(0, 0, w, h);\n    const r = rng(77);\n    for (let i = 0; i < 260; i++) { x.strokeStyle = `rgba(${r() < 0.5 ? '20,9,5' : '96,56,34'},${0.08 + r() * 0.16})`; x.lineWidth = 1 + r() * 2.4; const y0 = r() * h; x.beginPath(); x.moveTo(0, y0); x.bezierCurveTo(w * 0.3, y0 + r() * 16 - 8, w * 0.7, y0 + r() * 16 - 8, w, y0 + r() * 12 - 6); x.stroke(); }\n  });\n}\n// 油彩漬：從桌邊往裡爬，第二幕起才看得見\nfunction stainTex() {\n  return canvasTex(1024, 720, (x, w, h) => {\n    x.clearRect(0, 0, w, h);\n    const r = rng(19), cols = ['168,36,58', '143,99,56', '184,145,63', '43,36,39'];\n    for (let i = 0; i < 90; i++) {\n      const side = Math.floor(r() * 4), m = 0.03 + r() * 0.14;\n      const X = side === 0 ? m * w : side === 1 ? (1 - m) * w : r() * w, Y = side === 2 ? m * h : side === 3 ? (1 - m) * h : r() * h, Rd = 18 + r() * 62, c = cols[Math.floor(r() * 4)];\n      const g = x.createRadialGradient(X, Y, 0, X, Y, Rd); g.addColorStop(0, `rgba(${c},.85)`); g.addColorStop(0.7, `rgba(${c},.4)`); g.addColorStop(1, `rgba(${c},0)`);\n      x.fillStyle = g; x.beginPath(); x.ellipse(X, Y, Rd, Rd * (0.5 + r() * 0.6), r() * 3, 0, Math.PI * 2); x.fill();\n    }\n  });\n}\nfunction buildMiniStage(g) {\n  const s = new THREE.Group(); s.position.set(0, TOP, -0.2); g.add(s);\n  const boards = canvasTex(512, 256, (x, w, h) => { x.fillStyle = '#6d4427'; x.fillRect(0, 0, w, h); x.strokeStyle = 'rgba(0,0,0,.4)'; x.lineWidth = 2; for (let i = 0; i < w; i += 40) { x.beginPath(); x.moveTo(i, 0); x.lineTo(i, h); x.stroke(); } });\n  const plat = box(1.5, 0.11, 0.82, toon(0xffffff, boards)); plat.position.y = 0.055; s.add(inked(plat, 0.006));\n  // 中間不擋：看得見對面的阿檀，只有兩邊的幕和一根掛燈的竿\n  const cL = curtain(0.42, 0.72, 0xa01d24, 1), cR = curtain(0.42, 0.72, 0xa01d24, 3);\n  cL.position.set(-0.68, 0.47, -0.3); cR.position.set(0.68, 0.47, -0.3); s.add(cL, cR);\n  stageCurtains = [cL, cR];\n  const rod = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 1.5, 8), toon(0x2a1a14)); rod.rotation.z = Math.PI / 2; rod.position.set(0, 0.86, -0.3); s.add(rod);\n  lanterns = [-0.48, -0.24, 0, 0.24, 0.48].map(dx => {\n    const m = new THREE.Mesh(new THREE.SphereGeometry(0.038, 14, 10), new THREE.MeshBasicMaterial({ color: 0x4a1414 })); m.scale.y = 1.25; m.position.set(dx, 0.8, -0.3); s.add(m);\n    return m;\n  });\n  actor = makeFigure({ who: 'actor', robe: '#f3ede3', pat: '#5d7a62', petal: '#d99aa4', hem: '#a8202b', sash: 0xa8202b, cuff: 0.13, seed: 9, waterSleeve: true, headdress: true });\n  actor.root.scale.setScalar(0.34); actor.root.position.set(0, 0.11, -0.12); s.add(actor.root);\n  const spot = new THREE.SpotLight(0xffe0b0, 0, 5, 0.5, 0.6, 1.2); spot.position.set(0, 2.4, 0.9); spot.target.position.set(0, 0.2, -0.1); s.add(spot, spot.target);\n  lights.spot = spot;\n}\n// 觀眾：一排黑色剪紙背景板，立在戲台前面；打出牌時一起起伏，接錯了往下沉\nfunction silhouetteCv(seed) {\n  const c = document.createElement('canvas'); c.width = 256; c.height = 320;\n  const x = c.getContext('2d'), r = rng(seed), kind = seed % 5, hw = 50 + r() * 6;\n  const shape = (fill, grow) => {\n    x.save(); x.translate(128, 320); x.scale(1 + grow, 1 + grow); x.translate(-128, -320); x.fillStyle = fill; x.strokeStyle = fill;\n  // 肩膀\n  x.beginPath(); x.moveTo(10, 320); x.bezierCurveTo(14, 238, 60, 206, 128, 204); x.bezierCurveTo(196, 206, 242, 238, 246, 320); x.closePath(); x.fill();\n  // 脖子與頭\n  x.fillRect(108, 168, 40, 44);\n  x.beginPath(); x.ellipse(128, 126, hw, 58, 0, 0, Math.PI * 2); x.fill();\n  // 帽子、髮髻、斗笠、辮子、花\n  if (kind === 0) { x.beginPath(); x.ellipse(128, 82, 52, 30, 0, Math.PI, 0); x.fill(); x.beginPath(); x.arc(128, 50, 9, 0, Math.PI * 2); x.fill(); }\n  if (kind === 1) { x.beginPath(); x.ellipse(128, 64, 34, 26, 0, 0, Math.PI * 2); x.fill(); x.fillRect(150, 52, 44, 5); }\n  if (kind === 2) { x.beginPath(); x.moveTo(36, 96); x.lineTo(128, 36); x.lineTo(220, 96); x.closePath(); x.fill(); }\n  if (kind === 3) { x.lineWidth = 12; x.beginPath(); x.moveTo(170, 150); x.quadraticCurveTo(206, 220, 194, 300); x.stroke(); }\n  if (kind === 4) { for (let i = 0; i < 5; i++) { const a = i * Math.PI * 2 / 5; x.beginPath(); x.ellipse(92 + Math.cos(a) * 14, 70 + Math.sin(a) * 14, 10, 6, a, 0, Math.PI * 2); x.fill(); } }\n    x.restore();\n  };\n  // 先一層紅紙稍大一點，再一層黑紙：剪紙的紅邊\n  shape('#b3202c', 0.045); shape('#0b0809', 0);\n  // 剪紙的鏤空：一圈小窗花\n  x.globalCompositeOperation = 'destination-out';\n  for (let i = 0; i < 7; i++) { const a = Math.PI * (0.15 + i * 0.12); x.beginPath(); x.ellipse(128 + Math.cos(a) * 92, 300 - Math.sin(a) * 70, 7, 3.5, a, 0, Math.PI * 2); x.fill(); }\n  x.beginPath(); x.moveTo(118, 262); x.lineTo(128, 248); x.lineTo(138, 262); x.lineTo(128, 276); x.closePath(); x.fill();\n  return c;\n}\n// 前排九個（會說話），後排八個小一點，兩邊各一個靠著台\nconst CROWD_AT = [[-1.02, 0.34, 1.05], [-0.8, 0.5, 1.2], [-0.56, 0.4, 0.95], [-0.3, 0.6, 1.1], [-0.02, 0.5, 1.0], [0.27, 0.6, 1.15], [0.55, 0.4, 0.95], [0.8, 0.52, 1.2], [1.03, 0.34, 1.05],\n  [-0.92, 0.25, 0.8], [-0.68, 0.27, 0.78], [-0.42, 0.28, 0.82], [-0.16, 0.3, 0.76], [0.14, 0.3, 0.8], [0.4, 0.28, 0.78], [0.66, 0.27, 0.82], [0.92, 0.25, 0.8],\n  [-1.22, 0.05, 0.9], [1.22, 0.05, 0.9]];\nfunction buildCrowd(g) {\n  crowdG = new THREE.Group(); crowdG.visible = false; g.add(crowdG);\n  crowd = CROWD_AT.map(([x0, z0, k], i) => {\n    const tex = new THREE.CanvasTexture(silhouetteCv(31 + i * 7)), w = 0.22 * k, h = 0.275 * k;\n    const m = new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshBasicMaterial({ map: tex, transparent: true, alphaTest: 0.4, side: THREE.DoubleSide }));\n    // 往後仰，正面朝著俯看的鏡頭\n    m.rotation.x = -0.62; m.position.set(x0, TOP + h * 0.42, z0); crowdG.add(m);\n    return { m, y0: m.position.y, h, kick: null, phase: i * 1.7, front: i < 9, side: x0 < -0.4 ? 'L' : x0 > 0.4 ? 'R' : 'C' };\n  });\n}\n// 一起起伏：up 叫好往上跳，down 嘘聲往下沉\nfunction crowdKick(kind) {\n  const now = clock ? clock.elapsedTime : 0;\n  crowd.forEach((c, i) => { c.kick = { t0: now + (i % 3) * 0.06 + Math.random() * 0.12, amp: kind === 'down' ? -0.05 : kind === 'big' ? 0.07 : 0.04 }; });\n}\nfunction crowdTick(t) {\n  crowd.forEach(c => {\n    let y = Math.sin(t * 0.9 + c.phase) * 0.004;\n    if (c.kick) {\n      const k = (t - c.kick.t0) / 0.9;\n      if (k > 1) c.kick = null; else if (k > 0) y += c.kick.amp * Math.sin(k * Math.PI) * (c.kick.amp > 0 ? Math.abs(Math.sin(k * Math.PI * 2)) + 0.4 : 1);\n    }\n    c.m.position.y = c.y0 + y;\n  });\n}\n// 觀眾頭頂在螢幕上的位置：對白框貼著它\nfunction crowdHead(i) {\n  if (!glOK || !crowd[i]) return null;\n  const c = crowd[i], v = c.m.position.clone(); v.y += c.h * 0.4; v.z -= c.h * 0.25;\n  v.project(camera);\n  return { x: (v.x + 1) / 2 * innerWidth, y: (1 - v.y) / 2 * innerHeight };\n}\nfunction buildBox(g) {\n  const lacR = toon(0x7d1219), goldM = toon(0xb8913f), b = new THREE.Group();\n  b.position.set(-1.32, TOP, 0.12); b.rotation.y = 0.32; b.scale.setScalar(1.55); g.add(b);\n  const base = box(0.36, 0.13, 0.25, lacR); base.position.y = 0.065; b.add(inked(base, 0.005));\n  [[0, 0.125, 0.37, 0.012], [0, -0.125, 0.37, 0.012], [0.18, 0, 0.012, 0.25], [-0.18, 0, 0.012, 0.25]].forEach(([dx, dz, w, d]) => { const m = box(w, 0.014, d, goldM); m.position.set(dx, 0.132, dz); b.add(m); });\n  const lid = new THREE.Group(); lid.position.set(0, 0.135, -0.125); b.add(lid);\n  const lidM = box(0.36, 0.035, 0.25, lacR); lidM.position.set(0, 0.0175, 0.125); lid.add(inked(lidM, 0.005)); lid.rotation.x = -1.95;\n  boxStack = new THREE.Group(); boxStack.position.set(0, 0.135, 0); b.add(boxStack);\n}\nfunction buildMirror(g) {\n  const m = new THREE.Group(); m.position.set(1.32, TOP, -0.02); m.rotation.y = -0.34; g.add(m);\n  mirrorCv = document.createElement('canvas'); mirrorCv.width = mirrorCv.height = 320; mirrorTex = new THREE.CanvasTexture(mirrorCv);\n  const face = new THREE.Mesh(new THREE.CircleGeometry(0.31, 48), new THREE.MeshLambertMaterial({ map: mirrorTex, emissive: 0x333333 })); face.position.y = 0.46; m.add(face);\n  const rim = new THREE.Mesh(new THREE.TorusGeometry(0.32, 0.026, 10, 48), toon(0xb8913f)); rim.position.y = 0.46; m.add(inked(rim, 0.004));\n  const stand = box(0.05, 0.16, 0.05, toon(0xb8913f)); stand.position.set(0, 0.08, -0.02); m.add(stand);\n  const foot = box(0.26, 0.02, 0.14, toon(0x7a5a24)); foot.position.set(0, 0.01, -0.02); m.add(foot);\n}\nfunction buildRope(g) {\n  const z = 0.78, y = TOP + 0.26;\n  [-1.72, 1.72].forEach(x0 => { const p = box(0.03, 0.26, 0.03, toon(0x2a1a14)); p.position.set(x0, TOP + 0.13, z); g.add(p); });\n  const line = new THREE.Mesh(new THREE.CylinderGeometry(0.004, 0.004, 3.44, 6), toon(0x8b7f6a)); line.rotation.z = Math.PI / 2; line.position.set(0, y, z); g.add(line);\n  clothG = new THREE.Group(); g.add(clothG);\n}\nfunction buildSeat(g) {\n  // 阿檀的座位、燈骨、木匣\n  stool = new THREE.Group(); g.add(stool);\n  const seat = box(0.56, 0.05, 0.42, toon(0x2a1a14)); seat.position.y = 0.44; stool.add(inked(seat, 0.005));\n  const backR = box(0.56, 0.62, 0.04, toon(0x2a1a14)); backR.position.set(0, 0.76, -0.22); stool.add(inked(backR, 0.005));\n  wife = makeFigure({ who: 'wife', robe: '#d6d1ca', pat: '#7a7478', hem: '#3a3236', sash: 0xa8202b, cuff: 0.11, seed: 5, ribbons: true, pin: true });\n  g.add(wife.root);\n  const lamp = new THREE.Group(); lamp.position.set(0.74, TOP + 0.3, -0.98); lamp.scale.setScalar(1.45); g.add(lamp);\n  const bamboo = toon(0xb89a5a);\n  [-0.16, -0.08, 0, 0.08, 0.16].forEach(y => { const rr0 = 0.14 * Math.sqrt(1 - (y / 0.2) ** 2); const ring = new THREE.Mesh(new THREE.TorusGeometry(rr0, 0.004, 6, 32), bamboo); ring.rotation.x = Math.PI / 2; ring.position.y = y; lamp.add(ring); });\n  for (let i = 0; i < 8; i++) { const rib = new THREE.Mesh(new THREE.TorusGeometry(0.2, 0.0035, 6, 24, Math.PI), bamboo); rib.scale.x = 0.7; rib.rotation.set(0, i * Math.PI / 8, Math.PI / 2); lamp.add(rib); }\n  lampPatches = [];\n  for (let i = 0; i < 12; i++) { const a = i * Math.PI / 6; const p = new THREE.Mesh(new THREE.SphereGeometry(0.142, 10, 8, a, Math.PI / 6, Math.PI * 0.18, Math.PI * 0.64), new THREE.MeshLambertMaterial({ color: 0xb3202b, emissive: 0x3a0606, transparent: true, opacity: 0.88, side: THREE.DoubleSide })); p.visible = false; lamp.add(p); lampPatches.push(p); }\n  // 痕：燈上一道一道劃開的黑線，永久\n  lampScars = [];\n  for (let i = 0; i < 6; i++) { const m = new THREE.Mesh(new THREE.BoxGeometry(0.012, 0.2, 0.012), new THREE.MeshBasicMaterial({ color: 0x0a0506 })); const a = 0.5 + i * 0.75; m.position.set(Math.sin(a) * 0.145, (i % 3 - 1) * 0.03, Math.cos(a) * 0.145); m.rotation.set(0.3, a, 0.5 - (i % 2) * 1); m.visible = false; lamp.add(m); lampScars.push(m); }\n  lampLight = new THREE.PointLight(0xff7a4a, 0, 3.5, 2); lampLight.position.copy(lamp.position); g.add(lampLight);\n  const wood = toon(0x4d3220), chest = new THREE.Group(); chest.position.set(-0.86, TOP, -0.92); chest.rotation.y = 0.2; g.add(chest);\n  const cb = box(0.4, 0.13, 0.28, wood); cb.position.y = 0.065; chest.add(inked(cb, 0.005));\n  const cl = box(0.4, 0.03, 0.28, toon(0x5b3c27)); cl.position.set(0, 0.145, -0.1); cl.rotation.x = -0.6; chest.add(inked(cl, 0.004));\n  chestG = new THREE.Group(); chestG.position.set(0, 0.13, 0); chest.add(chestG);\n}\nfunction buildTable() {\n  const g = new THREE.Group(); scene.add(g);\n  const wall = plane(9, 4.5, new THREE.MeshLambertMaterial({ map: latticeTex() })); wall.position.set(0, 2.1, -3.1); g.add(wall);\n  const floor = plane(12, 12, toon(0x1c1