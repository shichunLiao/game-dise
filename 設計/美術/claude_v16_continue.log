 clickable: res.filter(x => x.hit).length,\n    cards: res.map(x => x.vis + (x.hit ? '' : 'x')).join(' ') };\n})()`;\nEOF\ncat > /private/tmp/v16qa/hand/repro.js <<'EOF'\n// 用法：node repro.js <url> <outprefix> [sizes...]（例 1440x900 390x844）\n// 情境：第 1 天台上（預設妝匣 10 張）、第 3 天早上妝匣裝滿、第 3 天台上滿手、加妝奩 11 張\nconst { chromium } = require('/tmp/dise-qa/node_modules/playwright-core');\nconst MEASURE = require('/private/tmp/v16qa/hand/measure.js');\nconst SCN = [\n  ['d1stage', `(() => { localStorage.setItem('dise-v15-tut','0'); localStorage.removeItem('dise-v13'); startGame('小满'); return S.phase + ' ' + S.T.box.length; })()`],\n  ['d3morning', `(() => { S.day = 3; beginDay(S); toDay(); S.deck.forEach(c => { if (S.T.box.length < S.T.cap) toggleBox(S, c.id); }); refresh(); return S.phase + ' cap ' + S.T.cap + ' box ' + S.T.box.length; })()`],\n  ['d3stage', `(() => { depart(S); view = 'stage'; placeScene(); refresh(); return S.phase + ' ' + S.T.box.length; })()`],\n  ['d3morning11', `(() => { S.relics.push('lian'); S.day = 3; beginDay(S); toDay(); S.deck.forEach(c => { if (S.T.box.length < S.T.cap) toggleBox(S, c.id); }); refresh(); return S.phase + ' cap ' + S.T.cap + ' box ' + S.T.box.length; })()`],\n  ['d3stage11', `(() => { depart(S); view = 'stage'; placeScene(); refresh(); return S.phase + ' ' + S.T.box.length; })()`],\n  ['d3evening11', `(() => { S.phase = 'evening'; view = 'evening'; placeScene(); refresh(); return S.phase + ' ' + S.T.box.length; })()`],\n];\n(async () => {\n  const [url, prefix, ...sizes] = process.argv.slice(2);\n  const browser = await chromium.launch({ executablePath: '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', headless: true, args: ['--use-angle=metal', '--ignore-gpu-blocklist'] });\n  for (const sz of sizes.length ? sizes : ['1440x900', '390x844']) {\n    const [w, h] = sz.split('x').map(Number);\n    const mobile = w < 600;\n    const ctx = await browser.newContext({ viewport: { width: w, height: h }, deviceScaleFactor: mobile ? 2