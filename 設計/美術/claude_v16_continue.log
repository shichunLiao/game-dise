{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U2SdHyg8x8nn8eP8nTLEyr","type":"tool_result","content":"The file /Users/tsun/Projects/game-dise/原型/v1.6/index.html has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"b8aac215-a6d7-40a1-80d9-8070eb8060bf","uuid":"4645bad3-d0ad-442b-bcec-1c8ae7b84161","timestamp":"2026-11-12T18:41:17.294Z","tool_use_result":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.6/index.html","oldString":"/* 手牌：字要在這個大小就讀得清 */\n.hand { pointer-events: auto; display: flex; justify-content: center; align-items: flex-end; overflow-x: auto; overflow-y: visible; padding: 16px 8px 2px; min-height: 0; scrollbar-width: none; }\n.hand::-webkit-scrollbar { display: none; }","newString":"/* 手牌：字要在這個大小就讀得清 */\n/* v1.6 修：不再是捲動框（v1.5 是 overflow-x: auto，overflow-y 跟著變成可捲，扇形外側的牌底被切；置中又溢出時左邊的牌捲不到）。\n   一排擺不下時由 fitHand() 把牌疊緊、縮小，見樣式表最後「手牌整排擺進畫面」 */\n.hand { pointer-events: auto; display: flex; justify-content: center; align-items: flex-end; overflow: visible; padding: 16px 8px 2px; min-height: 0; scrollbar-width: none; }\n.hand::-webkit-scrollbar { display: none; }","originalFile":"<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>底色·戏城 v1.6 美术接入</title>\n<meta name=\"claude:viewport-fit-sides\" content=\"cover\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;700&display=swap\">\n<style>\n/* 版面：一張 3D 的戲班桌子墊底，牌和字用 2D 浮在上面。沒有血條：金、燈、痕、底色都擺在桌上看。 */\n:root {\n  color-scheme: dark;\n  --ink: #120e11;\n  --ink-2: #1a1417;\n  --paper: #ece3d4;\n  --paper-2: #d6cab6;\n  --wash: #8d8487;\n  --red: #a8202b;\n  --red-2: #d8434c;\n  --gold: #b8913f;\n  --wood: #4a2f1e;\n  --display: \"Ma Shan Zheng\", \"Kaiti SC\", \"STKaiti\", \"KaiTi\", serif;\n  --body: \"Noto Serif SC\", \"Songti SC\", \"SimSun\", serif;\n}\n* { box-sizing: border-box; }\n[hidden] { display: none !important; }\nhtml, body { height: 100%; }\nbody { margin: 0; background: var(--ink); color: var(--paper); font-family: var(--body); font-size: 15px; line-height: 1.6; overflow: hidden; -webkit-tap-highlight-color: transparent; }\nbutton { font: inherit; color: inherit; }\np { margin: 0; }\n#gl, #smear, #vig, #grain, #stagefx { position: fixed; inset: 0; width: 100%; height: 100%; }\n#stagefx { pointer-events: none; }\n/* 連擊的大字：墨書蓋上來，一會兒就散 */\n#combo { position: fixed; left: 50%; top: 30%; transform: translate(-50%, -50%); pointer-events: none; z-index: 29; text-align: center; }\n#combo .cb { font-family: var(--display); font-size: clamp(44px, 8vw, 96px); line-height: 1; letter-spacing: .12em; color: #f6dc96; text-shadow: 0 0 2px #3a0a0e, 0 4px 0 #7d1219, 0 0 30px rgba(242, 212, 138, .7); animation: cbIn 1.5s cubic-bezier(.2, 1.4, .4, 1) both; white-space: nowrap; }\n#combo .cb.big { color: #fff1c8; font-size: clamp(56px, 10vw, 124px); text-shadow: 0 0 2px #3a0a0e, 0 5px 0 #a8202b, 0 0 46px rgba(255, 200, 120, .95); }\n#combo .cb.bad { color: #c9c0c2; text-shadow: 0 3px 0 #1c1719, 0 0 18px rgba(0, 0, 0, .8); font-size: clamp(36px, 6vw, 70px); }\n#combo .cb.slow, #combo .cb.slow + .cs { animation-duration: 3.6s; }\n#combo .cs { font-family: var(--body); font-size: 16px; letter-spacing: .3em; color: #f2d48a; text-shadow: 0 2px 6px #000; animation: cbIn 1.5s ease both; }\n@keyframes cbIn { 0% { opacity: 0; transform: scale(2.2) rotate(-6deg); filter: blur(6px); } 14% { opacity: 1; transform: scale(.94) rotate(-2deg); filter: none; } 22% { transform: scale(1) rotate(-2deg); } 78% { opacity: 1; } 100% { opacity: 0; transform: translateY(-24px) rotate(-2deg); } }\n.gainf { position: fixed; z-index: 30; pointer-events: none; font-family: var(--display); font-size: 34px; color: #f6dc96; text-shadow: 0 2px 0 #7d1219, 0 0 14px rgba(242, 212, 138, .8); transform: translate(-50%, -50%); animation: gainUp 1.2s ease-out both; }\n.gainf.bad { color: #d8c6c8; text-shadow: 0 2px 0 #1c1719; }\n@keyframes gainUp { from { opacity: 0; transform: translate(-50%, -20%) scale(.6); } 20% { opacity: 1; transform: translate(-50%, -60%) scale(1.15); } to { opacity: 0; transform: translate(-50%, -190%) scale(1); } }\n.bub.intel { animation: bubIn .28s cubic-bezier(.2, 1.4, .4, 1) both, intelGlow 1.6s ease-in-out .3s infinite; }\n@keyframes intelGlow { 50% { box-shadow: 0 0 0 7px rgba(242, 212, 138, .28), 0 0 40px rgba(242, 212, 138, .85), 0 10px 26px rgba(0, 0, 0, .6); } }\n#gl { display: block; }\n#smear, #vig, #grain { pointer-events: none; }\n#vig { background: radial-gradient(ellipse at 50% 42%, transparent 55%, rgba(8, 6, 7, .72) 100%); }\n#grain { opacity: .18; mix-blend-mode: overlay; background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .55  0 0 0 0 .5  0 0 0 0 .45  0 0 0 1 0'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>\"); }\n\n/* 浮層 */\n.hud { position: fixed; inset: 0; pointer-events: none; display: flex; flex-direction: column; padding-block: max(12px, env(safe-area-inset-top, 0px)) max(8px, env(safe-area-inset-bottom, 0px)); padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }\n.top { display: flex; align-items: flex-start; gap: 12px; }\n/* 木牌：第幾天、起手族、金箔 */\n.plate { flex: none; min-width: 112px; background: linear-gradient(180deg, #5c3b25, #3d2717); border: 1px solid #1d120b; box-shadow: inset 0 0 0 2px rgba(236, 200, 150, .14), 0 6px 18px rgba(0, 0, 0, .55); padding: 7px 12px 8px; color: #f0e2c8; text-align: center; }\n.plate .d { font-family: var(--display); font-size: 21px; line-height: 1.15; }\n.plate .a { font-size: 11px; letter-spacing: .25em; color: #c9b08c; }\n.plate .st { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 4px; font-size: 12px; letter-spacing: .1em; }\n.plate .g { margin-top: 4px; font-size: 12px; color: #e0c98f; font-variant-numeric: tabular-nums; }\n.plate .g b { font-family: var(--display); font-weight: 400; font-size: 20px; margin-left: 4px; }\n.fc { font-style: normal; display: inline-flex; width: 26px; height: 26px; border-radius: 50%; align-items: center; justify-content: center; font-family: var(--display); font-size: 17px; line-height: 1; color: var(--paper); border: 1px solid rgba(236, 227, 212, .75); flex: none; }\n.topmid { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 4px; }\n.side { flex: none; pointer-events: auto; }\n.tool { white-space: nowrap; background: rgba(18, 14, 17, .6); border: 1px solid rgba(236, 227, 212, .35); color: var(--paper); padding: 3px 10px; font-size: 12px; cursor: pointer; min-height: 30px; }\n\n/* 妝匣：10 個格子，異常出現在這裡 */\n/* 左欄：家（燈、熄、痕）和圖鑑 */\n.leftcol { position: absolute; left: max(16px, env(safe-area-inset-left, 0px)); top: 158px; width: 156px; display: flex; flex-direction: column; gap: 8px; pointer-events: auto; }\n.homep { background: linear-gradient(180deg, #efe6d6, #dccfb6); color: var(--ink); border: 1px solid #1d120b; box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .35), 0 6px 18px rgba(0, 0, 0, .55); padding: 5px 9px 8px; }\n.homep[hidden] { display: none; }\n.homep .hh { display: flex; justify-content: space-between; align-items: baseline; font-size: 11px; letter-spacing: .25em; color: #8a2a2a; border-bottom: 1px solid rgba(28, 23, 25, .2); padding-bottom: 2px; margin-bottom: 4px; }\n.homep .hh span:last-child { letter-spacing: .05em; color: #5a5156; }\n.homep .hl { display: flex; align-items: center; gap: 8px; }\n.homep .hl .lampsvg { width: 58px; height: 58px; flex: none; }\n.homep .hl b { font-family: var(--display); font-weight: 400; font-size: 32px; line-height: 1; color: var(--red); }\n.homep .hl small { display: block; font-size: 11px; color: #5a5156; line-height: 1.35; }\n.homep .hrow { display: flex; align-items: center; gap: 6px; margin-top: 5px; font-size: 12px; }\n.homep .hrow .k { font-family: var(--display); font-size: 17px; width: 1.1em; }\n.homep .hrow em { font-style: normal; font-size: 11px; color: #5a5156; margin-left: auto; white-space: nowrap; }\n.homep .hrow.hot em { color: var(--red); font-weight: 700; }\n.homep .outs { gap: 3px; }\n.homep .outs i { width: 12px; height: 12px; border-color: #6a5f62; }\n.homep .scars { gap: 5px; }\n.homep .scars i { width: 4px; height: 16px; background: rgba(28, 23, 25, .16); }\n.homep .scars i.on { background: var(--red); }\n.hud[data-v=\"morning\"] .homep:not(.warn), .hud[data-v=\"stage\"] .homep:not(.warn), .hud[data-v=\"door\"] .wb, .hud[data-v=\"evening\"] .wb, .hud[data-v=\"night\"] .wb, .hud[data-v=\"evening\"] .relics, .hud[data-v=\"night\"] .relics { opacity: .5; transition: opacity .2s; }\n.hud .homep:hover, .hud .wb:hover, .hud .wb:focus-visible, .hud .relics:hover { opacity: 1; }\n.homep.warn { box-shadow: 0 0 0 2px var(--red), 0 0 20px rgba(200, 40, 58, .55), 0 6px 18px rgba(0, 0, 0, .55); animation: warnP 1.8s ease-in-out infinite; }\n@keyframes warnP { 50% { box-shadow: 0 0 0 2px var(--red), 0 0 6px rgba(200, 40, 58, .3), 0 6px 18px rgba(0, 0, 0, .55); } }\n.tool.bookb { width: 100%; text-align: left; display: flex; justify-content: space-between; align-items: center; }\n.tool.bookb small { font-size: 11px; color: var(--paper-2); }\n.tools { display: flex; gap: 6px; justify-content: flex-end; }\n\n.mid { flex: 1; min-height: 0; position: relative; }\n/* 白天：這一場出過的牌與連擊 */\n.chain { pointer-events: none; display: flex; flex-direction: column; align-items: center; gap: 3px; }\n.played { display: flex; align-items: center; gap: 2px; }\n.pl { width: 56px; height: 42px; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1; font-family: var(--display); font-size: 16px; color: var(--paper); border: 1px solid rgba(236, 227, 212, .35); }\n.pl small { font-family: var(--body); font-size: 11px; color: #f4dfa8; font-variant-numeric: tabular-nums; }\n.pl.no { background: rgba(18, 14, 17, .45); border-style: dashed; }\n.lk { width: 12px; text-align: center; font-size: 12px; color: var(--gold); }\n.lk.x { color: var(--red-2); }\n.nowline { display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 2px 18px; background: rgba(14, 10, 12, .72); font-family: var(--display); font-size: 24px; color: #f2d48a; text-shadow: 0 1px 4px #000; }\n.nowline .fc { width: 32px; height: 32px; font-size: 18px; }\n.nowline small { font-family: var(--body); font-size: 12px; color: var(--paper-2); }\n.nowline b { font-family: var(--display); font-weight: 400; font-size: 20px; color: var(--gold); }\n.nowline .bad { color: var(--red-2); }\n.nx { animation: nxflash .9s ease-in-out infinite; }\n@keyframes nxflash { 50% { box-shadow: 0 0 0 5px rgba(236, 227, 212, .28), 0 0 14px rgba(236, 227, 212, .6); } }\n/* 她的樣子：畫面為主，放大（滑過、聚焦或點開）才附文字 */\n.lookb { pointer-events: auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: rgba(18, 14, 17, .62); border: 1px solid rgba(236, 227, 212, .35); border-radius: 50%; width: 58px; height: 58px; color: var(--paper); cursor: zoom-in; transition: width .2s ease, height .2s ease; }\n.lookb svg { width: 32px; height: 32px; }\n.lookb .lb { display: none; font-family: var(--display); font-size: 16px; line-height: 1; }\n.lookb:hover, .lookb:focus-visible, .lookb[aria-expanded=\"true\"] { width: 80px; height: 80px; }\n.lookb:hover .lb, .lookb:focus-visible .lb, .lookb[aria-expanded=\"true\"] .lb { display: block; }\n\n/* 早上：桌上攤開的卡組，點一張放進妝匣 */\n.spread { pointer-events: auto; position: absolute; left: 50%; top: 2px; transform: translateX(-50%); display: grid; grid-template-columns: repeat(var(--cols, 4), auto); gap: 8px 10px; background: rgba(18, 14, 17, .72); border: 1px solid rgba(236, 227, 212, .22); padding: 10px 12px; max-height: 100%; overflow: auto; }\n.spc { position: relative; width: var(--cw, 84px); height: var(--chh, 126px); border: none; background: none; padding: 0; cursor: pointer; transition: transform .15s ease; }\n.spc img { width: 100%; height: 100%; display: block; border-radius: 6px; }\n.spread .sph { grid-column: 1 / -1; font-size: 12px; letter-spacing: .2em; color: var(--paper-2); margin: -2px 0 2px; }\n.spc:hover:not(:disabled), .spc:focus-visible { transform: translateY(-4px); }\n.spc:disabled { cursor: default; filter: brightness(.42) saturate(.5); }\n.spc .ct { position: absolute; right: -5px; top: -5px; min-width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--ink); border: 1px solid var(--gold); font-size: 13px; font-variant-numeric: tabular-nums; }\n.tools2 { grid-column: 1 / -1; display: flex; gap: 8px; justify-content: center; }\n.mini { border: 1px solid rgba(236, 227, 212, .45); background: transparent; color: var(--paper); font-size: 12px; padding: 3px 10px; min-height: 32px; cursor: pointer; }\n.mini:disabled { opacity: .35; cursor: not-allowed; }\n.yuan { pointer-events: auto; position: absolute; left: 50%; top: 2px; transform: translateX(-50%); width: min(620px, 100%); background: rgba(18, 14, 17, .78); border: 1px solid rgba(184, 145, 63, .6); padding: 10px 12px; }\n.yuan h3 { font-family: var(--display); font-weight: 400; font-size: 24px; margin: 0 0 8px; text-align: center; }\n.yuan .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }\n.yn { border: 1px solid rgba(236, 227, 212, .45); background: transparent; color: var(--paper); text-align: left; padding: 8px 10px; cursor: pointer; font-family: var(--display); font-size: 20px; line-height: 1.3; }\n.yn small { display: block; font-family: var(--body); font-size: 12px; color: var(--paper-2); }\n.yn[aria-pressed=\"true\"] { background: var(--red); border-color: var(--red); }\n\n/* 紙：水牌、規矩 */\n.panel { pointer-events: auto; position: absolute; left: 50%; top: 4px; transform: translateX(-50%); width: min(520px, 100%); max-height: calc(100% - 8px); overflow: auto; background: var(--paper); color: var(--ink); padding: 14px 18px 16px; border-top: 6px solid var(--red); box-shadow: 0 12px 40px rgba(0, 0, 0, .55); }\n.panel h2 { font-family: var(--display); font-weight: 400; font-size: 30px; margin: 0 0 6px; letter-spacing: .08em; }\n.panel h4 { font-family: var(--display); font-weight: 400; font-size: 20px; margin: 14px 0 4px; }\n.panel .note { font-size: 13px; color: #5a5156; margin-top: 8px; }\n.panel .acts { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }\n.panel ol, .panel ul { padding-left: 1.3em; margin: 0; font-size: 14px; }\n.panel li + li { margin-top: 4px; }\n.panel.rules { width: min(620px, 100%); }\n.panel.shopp { width: min(700px, 100%); }\n.board { list-style: none; padding: 0; margin: 4px 0 0; }\n.board li { display: flex; justify-content: space-between; padding: 5px 2px; border-bottom: 1px solid #d3c7b4; font-size: 15px; font-variant-numeric: tabular-nums; }\n.board li.me { color: var(--red); font-weight: 700; }\n.board li.feng { color: #5a5156; }\n.book { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 6px; }\n.book > div { background: #e0d5c2; padding: 5px 6px; min-height: 58px; font-size: 12px; color: #5a5156; }\n.cl { display: flex; gap: 3px; flex-wrap: wrap; margin-top: 3px; }\n.cl i { width: 16px; height: 20px; display: block; clip-path: polygon(0 0, 100% 0, 92% 100%, 50% 88%, 8% 100%); }\n.ledger { display: grid; grid-template-columns: repeat(auto-fit, minmax(92px, 1fr)); gap: 4px 12px; background: #e0d5c2; padding: 8px 10px; font-size: 13px; font-variant-numeric: tabular-nums; }\n.btn { border: 1px solid var(--ink); background: var(--paper); color: var(--ink); padding: 8px 14px; cursor: pointer; min-height: 44px; }\n.btn.go { background: var(--red); border-color: var(--red); color: var(--paper); }\n.btn.small { min-height: 34px; padding: 3px 10px; font-size: 13px; }\n.btn:focus-visible, .opt:focus-visible, .hc:focus-visible, .tool:focus-visible, .mini:focus-visible, .spc:focus-visible, .yn:focus-visible, .lookb:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }\n\n/* 字幕與選項 */\n.talk { pointer-events: none; display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 0 4px 6px; }\n/* 三級字：一級「現在做什麼」金色大字（上方 .goal、主按鈕）；二級故事米白中字（字幕）；三級說明灰色小字（.gain、小籤） */\n.sub { max-width: min(42em, 100%); text-align: center; text-shadow: 0 1px 3px rgba(0, 0, 0, .9); animation: rise .5s ease both; background: linear-gradient(90deg, transparent, rgba(14, 10, 12, .82) 14%, rgba(14, 10, 12, .82) 86%, transparent); padding: 6px 56px 8px; }\n.sub.n { background: none; padding: 0; }\n.sub .who { display: inline-block; font-size: 12px; letter-spacing: .3em; background: var(--red); color: var(--paper); padding: 1px 8px 0; margin-bottom: 4px; text-shadow: none; }\n.sub .tx { font-family: var(--display); font-size: 20px; line-height: 1.5; color: var(--paper); }\n.sub .gain { display: inline-block; font-size: 13px; color: var(--paper-2); margin-top: 4px; padding: 1px 10px; background: rgba(14, 10, 12, .7); border: 1px solid rgba(236, 227, 212, .2); }\n.goal { pointer-events: none; display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; font-family: var(--display); font-size: 26px; line-height: 1.3; color: #f2d48a; background: rgba(14, 10, 12, .72); padding: 2px 18px; text-shadow: 0 1px 4px #000; }\n.goal b { font-weight: 400; font-size: 1.15em; color: #fff3cf; }\n.goal small { font-family: var(--body); font-size: 12px; color: var(--paper-2); letter-spacing: .05em; }\n.goal .fc { width: 32px; height: 32px; font-size: 18px; }\n.popin { animation: popin .9s cubic-bezier(.2, 1.4, .4, 1) both; }\n@keyframes popin { 0% { transform: scale(.6); opacity: 0; } 60% { transform: scale(1.06); opacity: 1; box-shadow: 0 0 0 3px #f2d48a, 0 0 30px rgba(242, 212, 138, .7); } 100% { transform: none; } }\n.tool.bookb[hidden] { display: none; }\n@keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }\n.choices { pointer-events: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 2px 22px; min-height: 44px; }\n.opt { background: rgba(14, 10, 12, .7); border: 1px solid rgba(236, 227, 212, .14); cursor: pointer; padding: 4px 14px 4px 10px; min-height: 44px; text-align: left; font-family: var(--display); font-size: 19px; color: var(--paper); text-shadow: 0 2px 8px rgba(0, 0, 0, .95); position: relative; }\n.opt::before { content: \"—\"; margin-right: 8px; color: var(--red-2); }\n.opt small { font-family: var(--body); font-size: 12px; color: var(--paper-2); margin-left: 8px; }\n.opt:hover::after, .opt:focus-visible::after { content: \"\"; position: absolute; left: 30px; right: 0; bottom: 4px; height: 3px; background: var(--red-2); border-radius: 2px; }\n.opt:disabled { opacity: .35; cursor: not-allowed; }\n/* 主按鈕：這一步最該按的那個，朱紅實底、大字 */\n.opt.pri { background: var(--red); border-color: #e0475a; font-size: 25px; padding: 5px 20px 5px 16px; box-shadow: 0 6px 18px rgba(0, 0, 0, .5), 0 0 0 1px rgba(242, 212, 138, .35) inset; }\n.opt.pri::before { content: none; }\n.opt.pri small { color: #f4d9d9; }\n.opt.pri:hover::after, .opt.pri:focus-visible::after { background: #f2d48a; left: 16px; }\n\n/* 手牌：字要在這個大小就讀得清 */\n.hand { pointer-events: auto; display: flex; justify-content: center; align-items: flex-end; overflow-x: auto; overflow-y: visible; padding: 16px 8px 2px; min-height: 0; scrollbar-width: none; }\n.hand::-webkit-scrollbar { display: none; }\n.hand.on { min-height: 178px; }\n.hc { flex: none; border: none; background: none; padding: 0; width: 104px; height: 156px; margin: 0 -6px; position: relative; cursor: default; transition: transform .16s ease, filter .16s ease; transform-origin: 50% 120%; }\n.hc img { width: 100%; height: 100%; display: block; border-radius: 7px; box-shadow: 0 6px 16px rgba(0, 0, 0, .6); }\n.hc img, .spc img { -webkit-touch-callout: none; user-select: none; -webkit-user-select: none; }\n.hc.play { cursor: pointer; }\n.hc.play:hover, .hc.play:focus-visible { transform: translateY(-14px) rotate(0deg) !important; z-index: 5; }\n/* 金框＝現在能打、該推的牌；她今晚要的牌不改樣子，只在頂上蓋一枚朱印「家」 */\n.hc.hot img { box-shadow: 0 0 0 3px #f2d48a, 0 0 22px rgba(242, 212, 138, .85); }\n.hc.off { filter: brightness(.48) saturate(.5); }\n/* 背面是她今晚要的：牌的形狀、大小都不動，只加一圈金邊，頂上一枚「今晚要」（手牌、攤開的牌一個樣子） */\n.wtag { position: absolute; left: 50%; top: -10px; z-index: 2; width: 26px; height: 26px; transform: translateX(-50%) rotate(-6deg); background: var(--red); color: #f6ecd9; font-family: var(--display); font-size: 17px; line-height: 26px; text-align: center; border-radius: 3px; box-shadow: inset 0 0 0 2px var(--red), inset 0 0 0 3px rgba(246, 236, 217, .75), 0 2px 6px rgba(0, 0, 0, .55); pointer-events: none; }\n/* 牌角一小塊紅：這張推出去會被染 */\n.hc .stain { position: absolute; right: 0; top: 0; width: 34px; height: 34px; border-top-right-radius: 7px; background: linear-gradient(225deg, #c21f2c 0 48%, transparent 50%); }\n.hand-label { pointer-events: none; display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13px; letter-spacing: .15em; color: var(--paper); min-height: 22px; }\n.hand-label .hlb { background: rgba(14, 10, 12, .72); padding: 2px 12px; }\n.hand-label .mini { pointer-events: auto; }\n.ghost { position: fixed; z-index: 40; pointer-events: none; border-radius: 7px; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); }\n\n/* 開場 */\n.title { position: fixed; inset: 0; display: flex; align-items: center; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 24px; background: linear-gradient(90deg, rgba(12, 9, 11, .88) 0%, rgba(12, 9, 11, .55) 55%, rgba(12, 9, 11, .1) 100%); overflow: auto; }\n.title-in { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 32px; align-items: start; max-width: 860px; margin-left: clamp(0px, 6vw, 80px); }\n.vb { background: var(--red); color: var(--paper); font-family: var(--display); padding: 26px 18px; display: flex; flex-direction: column; align-items: center; gap: 18px; box-shadow: 0 0 0 3px var(--ink), 0 0 0 4px var(--red); }\n.vb .t { writing-mode: vertical-rl; font-size: 88px; line-height: 1; letter-spacing: .12em; }\n.vb .s { writing-mode: vertical-rl; font-size: 15px; letter-spacing: .4em; }\n.intro { font-family: var(--display); font-size: 25px; line-height: 1.75; max-width: 24em; }\n.lede { margin-top: 10px; color: var(--paper-2); max-width: 38em; }\n.form { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-end; }\n.field label { display: block; font-size: 12px; letter-spacing: .2em; color: var(--paper-2); margin-bottom: 6px; }\n.field input { font: inherit; font-size: 18px; padding: 7px 12px; border: 1px solid var(--paper-2); background: rgba(236, 227, 212, .08); color: var(--paper); width: 8em; }\n.title .go { font-size: 17px; }\n.title .hint { margin-top: 12px; font-size: 12px; color: var(--paper-2); }\n.title .tg { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 14px; color: var(--paper-2); cursor: pointer; }\n.title .tg input { width: 18px; height: 18px; accent-color: var(--red); }\n\n/* 墨染轉場、更夫、印 */\n#ink { position: fixed; inset: -10%; background: #0b0809; pointer-events: none; opacity: 0; clip-path: circle(0% at 50% 58%); filter: url(#rough); z-index: 30; }\n#ink.on { opacity: 1; clip-path: circle(80% at 50% 58%); transition: clip-path .55s cubic-bezier(.6, 0, .4, 1); }\n#ink.off { opacity: 0; transition: opacity .45s ease; clip-path: circle(80% at 50% 58%); }\n.watch { position: fixed; inset: 0; z-index: 25; background: #070506; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 22px; padding: 24px; }\n.watch .w { writing-mode: vertical-rl; font-family: var(--display); font-size: clamp(28px, 5.4vh, 42px); line-height: 1.5; letter-spacing: .14em; color: var(--paper); max-height: 62vh; animation: rise 1.2s ease both; }\n.watch .w2 { color: var(--wash); font-size: 15px; letter-spacing: .2em; text-align: center; animation: rise 2s ease both; }\n.watch .knock { font-size: 12px; letter-spacing: .5em; color: var(--wash); }\n.watch .end { font-family: var(--display); font-size: clamp(44px, 9vh, 72px); color: var(--red-2); letter-spacing: .2em; }\n.watch .sum { font-size: 13px; color: var(--wash); text-align: center; max-width: 34em; }\n.watch .acts { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }\n.stamp { position: fixed; left: 50%; top: 34%; z-index: 35; transform: translate(-50%, -50%) rotate(-8deg); font-family: var(--display); font-size: 46px; color: var(--red-2); border: 5px solid var(--red-2); padding: 4px 22px; letter-spacing: .2em; pointer-events: none; animation: stampin .5s cubic-bezier(.2, 1.6, .4, 1) both; text-shadow: 0 0 12px rgba(0, 0, 0, .6); }\n@keyframes stampin { from { transform: translate(-50%, -50%) rotate(-8deg) scale(2.2); opacity: 0; } to { transform: translate(-50%, -50%) rotate(-8deg) scale(1); opacity: 1; } }\n#fx { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 32; }\n.fleck { position: absolute; top: -14px; width: 10px; height: 8px; background: var(--gold); animation: fall 1.8s ease-in forwards; }\n@keyframes fall { to { transform: translateY(105vh) rotate(560deg); opacity: .1; } }\n\n/* 骰子 */\n#dice { position: fixed; inset: 0; z-index: 36; display: flex; align-items: center; justify-content: center; pointer-events: none; }\n#dice .dbox { background: rgba(18, 14, 17, .92); border: 1px solid var(--gold); padding: 16px 24px 14px; display: flex; flex-direction: column; align-items: center; gap: 10px; box-shadow: 0 12px 40px rgba(0, 0, 0, .6); min-width: 220px; max-width: calc(100vw - 32px); text-align: center; }\n#dice .lb { font-size: 13px; letter-spacing: .12em; color: var(--paper-2); }\n#dice .res { font-family: var(--display); font-size: 26px; min-height: 1.3em; }\n#dice .res.ok { color: var(--gold); }\n#dice .res.bad { color: var(--red-2); }\n.die { display: inline-grid; width: 66px; height: 66px; background: #f4efe6; border-radius: 12px; grid-template: repeat(3, 1fr) / repeat(3, 1fr); padding: 9px; box-shadow: inset 0 -4px 0 #c9bca6, 0 4px 14px rgba(0, 0, 0, .5); }\n.die i { width: 11px; height: 11px; border-radius: 50%; background: var(--ink); place-self: center; visibility: hidden; }\n.die i.on { visibility: visible; }\n.die.red i.on { background: var(--red); }\n.die.spin { transform: rotate(18deg) translateY(-6px); }\n.die.land { animation: land .35s cubic-bezier(.2, 1.6, .4, 1) both; }\n@keyframes land { from { transform: scale(1.4) rotate(-20deg); } to { transform: none; } }\n\n/* 燈：吃完飯當場看到亮了還是熄了 */\n#lampfb { position: fixed; inset: 0; z-index: 27; display: flex; align-items: flex-start; justify-content: center; pointer-events: none; padding: 11vh 16px 16px; }\n#lampfb[hidden] { display: none; }\n@media (min-width: 760px) { #lampfb { justify-content: flex-start; padding-left: max(7vw, 190px); } }\n#lampfb .lf { background: rgba(14, 10, 12, .93); border: 1px solid var(--gold); padding: 16px 24px 14px; display: flex; flex-direction: column; align-items: center; gap: 6px; box-shadow: 0 14px 40px rgba(0, 0, 0, .65); max-width: min(420px, calc(100vw - 32px)); text-align: center; animation: peekIn .25s ease-out both; }\n#lampfb .lf.bad { border-color: #8a4a4e; }\n#lampfb .big { font-family: var(--display); font-size: clamp(30px, 5vw, 44px); line-height: 1.1; color: var(--gold); letter-spacing: .12em; }\n#lampfb .lf.bad .big { color: #e6d4d6; }\n#lampfb .row { font-size: 15px; color: var(--paper-2); letter-spacing: .04em; }\n#lampfb .row b { font-family: var(--display); font-weight: 400; font-size: 22px; color: var(--paper); margin: 0 2px; }\n#lampfb .warn { color: #ff9a8a; font-size: 14px; letter-spacing: .06em; }\n#lampfb .lfok { pointer-events: auto; margin-top: 6px; min-width: 96px; }\n.lampsvg { width: 150px; height: 150px; }\n.lampsvg .sg { transition: fill .5s, opacity .5s; }\n.lampsvg .sg.dying { animation: dying .22s steps(2) 5; }\n.lampsvg .sg.lighting { animation: lighting .9s ease both; }\n@keyframes dying { 50% { fill: #ffb070; } }\n@keyframes lighting { from { fill: #ffe9a8; } }\n.outs { display: inline-flex; gap: 3px; vertical-align: middle; }\n.outs i { width: 9px; height: 9px; border-radius: 50%; border: 1px solid #c9b08c; display: inline-block; }\n.outs i.on { background: #e8483e; border-color: #ff8a7a; box-shadow: 0 0 6px rgba(255, 90, 70, .7); }\n.outs i.new { animation: outPop 1s ease both; }\n@keyframes outPop { 0% { transform: scale(2.4); background: #ffb070; } 100% { transform: none; } }\n.scars { display: inline-flex; gap: 4px; vertical-align: middle; }\n.scars i { width: 3px; height: 12px; background: rgba(236, 200, 150, .25); display: inline-block; transform: rotate(14deg); }\n.scars i.on { background: #ff8a7a; }\n.plate .lm { margin-top: 6px; padding-top: 5px; border-top: 1px solid rgba(236, 200, 150, .2); font-size: 12px; color: #e0c98f; display: flex; flex-direction: column; gap: 3px; align-items: center; }\n.plate .lm b { font-family: var(--display); font-weight: 400; font-size: 17px; }\n.plate .lm .k { display: flex; align-items: center; gap: 4px; }\n.plate .lm .k2 { display: flex; gap: 8px; }\n.plate .lm .k.hot { color: #ff9a8a; }\n.wb .exam { display: block; color: #5a5156; font-size: 11px; }\n.wb .exam.bad { color: var(--red); font-weight: 700; }\n.offer .bad, .shopp .bad { color: var(--red); font-weight: 700; }\n.offer .ab { border-top: 1px dashed rgba(28, 23, 25, .25); padding-top: 4px; color: var(--ink); min-height: 0; }\n.panel.tujian { width: min(860px, 100%); }\n.panel .tabs { display: flex; gap: 6px; margin-bottom: 8px; }\n.bookg { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; margin-bottom: 6px; }\n.bc { border: none; background: none; padding: 0; cursor: pointer; text-align: center; font-size: 12px; color: var(--ink); }\n.bc img { width: 100%; display: block; border-radius: 5px; box-shadow: 0 3px 8px rgba(0, 0, 0, .35); margin-bottom: 2px; }\n.bc.un img { filter: grayscale(.9) brightness(.7); }\n.bc.un span { color: #8d8487; }\n.bc:hover img, .bc:focus-visible img { box-shadow: 0 0 0 3px var(--gold), 0 3px 8px rgba(0, 0, 0, .35); }\n.bookd { display: flex; gap: 16px; flex-wrap: wrap; }\n.bookd .faces { display: flex; gap: 8px; }\n.bookd figure { margin: 0; text-align: center; font-size: 12px; color: #5a5156; }\n.bookd figure img { width: 140px; display: block; border-radius: 6px; margin-bottom: 3px; }\n.bookd .bt { flex: 1; min-width: 220px; }\n.bookd h3 { font-family: var(--display); font-weight: 400; font-size: 30px; margin: 0; }\n.bookd h3 small { display: block; font-family: var(--body); font-size: 12px; color: #5a5156; }\n.bookr { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; }\n.bookr li { background: #e0d5c2; padding: 8px 10px; }\n.bookr li.own { box-shadow: inset 0 0 0 2px var(--gold); }\n.bookr b { font-family: var(--display); font-weight: 400; font-size: 20px; margin-right: 6px; }\n.bookr small { color: #5a5156; }\n.bookr p { margin: 4px 0 0; font-size: 13px; }\n.bookr .lore { color: #5a5156; }\n.bookt { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; }\n.bookt dt { font-family: var(--display); font-size: 18px; color: var(--red); }\n.bookt dd { margin: 0; font-size: 14px; }\n.panel .fired { color: var(--red-2); font-family: var(--display); font-size: 22px; }\n.mirrorc { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin: 6px 0; }\n.mirrorc figure { margin: 0; text-align: center; font-size: 12px; color: #5a5156; }\n.mirrorc img { width: 86px; display: block; margin-bottom: 4px; }\n\n/* 最後一次卸妝 */\n.lastwipe { position: fixed; inset: 0; z-index: 26; background: rgba(7, 5, 6, .9); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 16px; }\n.lastwipe .face { position: relative; width: min(340px, 78vw, 54vh); aspect-ratio: 4 / 5; }\n.lastwipe canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n.lastwipe #paint { touch-action: none; cursor: grab; }\n.lastwipe .tx { font-family: var(--display); font-size: 24px; line-height: 1.5; text-align: center; max-width: 24em; }\n.lastwipe .tx2 { font-size: 14px; color: var(--paper-2); text-align: center; max-width: 30em; letter-spacing: .04em; }\n.lastwipe .after { font-family: var(--display); font-size: 22px; line-height: 1.6; color: var(--paper); text-align: center; max-width: 24em; animation: rise 1.4s ease both; }\n\n/* 看牌：放大兩面，每面最多三行 */\n#peek { position: fixed; z-index: 35; pointer-events: none; display: flex; gap: 10px; filter: drop-shadow(0 14px 30px rgba(0, 0, 0, .7)); animation: peekIn .14s ease-out both; }\n#peek figure { margin: 0; width: 196px; background: var(--ink-2); border: 1px solid rgba(184, 145, 63, .45); padding: 8px 8px 10px; opacity: .78; }\n#peek figure.on { opacity: 1; border-color: var(--gold); border-top: 4px solid var(--red); }\n#peek img { width: 100%; aspect-ratio: 2 / 3; display: block; border-radius: 8px; }\n#peek figcaption { margin-top: 7px; font-size: 14px; line-height: 1.55; color: var(--paper); }\n#peek figcaption b { display: block; font-size: 12px; letter-spacing: .2em; color: var(--gold); font-weight: 400; }\n@keyframes peekIn { from { opacity: 0; transform: translateY(6px); } }\n\n/* 教學小框：遮罩挖洞框住要看的東西 */\n#coach { position: fixed; inset: 0; z-index: 34; pointer-events: none; }\n#coach .dim { position: absolute; inset: 0; background: rgba(8, 6, 7, .62); }\n#coach .shield { position: absolute; inset: 0; pointer-events: auto; }\n#coach .ring { position: absolute; border: 2px solid var(--gold); border-radius: 8px; box-shadow: 0 0 0 4px rgba(184, 145, 63, .22), 0 0 26px rgba(216, 67, 76, .55); animation: coachPulse 1.6s ease-in-out infinite; }\n#coach .ring[data-tap]::after { content: attr(data-tap); position: absolute; left: 50%; bottom: calc(100% + 8px); transform: translateX(-50%); background: var(--red); color: var(--paper); font-size: 13px; letter-spacing: .2em; padding: 2px 10px; white-space: nowrap; }\n@keyframes coachPulse { 50% { box-shadow: 0 0 0 9px rgba(184, 145, 63, .1), 0 0 38px rgba(216, 67, 76, .75); } }\n#coach .cbox { position: absolute; pointer-events: auto; width: min(330px, calc(100vw - 32px)); max-height: 60vh; overflow: auto; background: var(--ink-2); color: var(--paper); border: 1px solid rgba(184, 145, 63, .7); border-top: 4px solid var(--red); padding: 10px 14px 10px; box-shadow: 0 16px 44px rgba(0, 0, 0, .65); animation: rise .3s ease both; }\n#coach .cbox h4 { font-family: var(--display); font-weight: 400; font-size: 23px; line-height: 1.3; margin: 0 0 3px; }\n#coach .cbox .tx { font-size: 15px; line-height: 1.7; }\n#coach .cbox .tx b { color: #e8cf8f; }\n#coach .cbox .rule { margin: 8px 0 2px; padding: 2px 0 2px 10px; border-left: 3px solid var(--red); font-family: var(--display); font-size: 19px; line-height: 1.4; color: #f2d48a; }\n#coach .fc { width: 22px; height: 22px; font-size: 15px; vertical-align: -4px; margin: 0 2px; }\n#coach .cbox .row { display: flex; align-items: center; gap: 10px; margin-top: 8px; }\n#coach .cbox .do { font-size: 14px; color: #e8cf8f; letter-spacing: .1em; }\n#coach .cbox .skip { margin-left: auto; background: none; border: none; color: var(--paper-2); font-size: 12px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; min-height: 38px; padding: 0 4px; }\n#coach .arrow { position: absolute; width: 14px; height: 14px; background: var(--ink-2); transform: rotate(45deg); }\n#coach .arrow.up { top: -9px; background: var(--red); }\n#coach .arrow.down { bottom: -8px; border-right: 1px solid rgba(184, 145, 63, .7); border-bottom: 1px solid rgba(184, 145, 63, .7); }\n/* 做的步驟：不壓暗整個畫面，只一句話貼在要點的東西旁邊 */\n#coach.doing .dim { background: rgba(8, 6, 7, .38); }\n#coach.doing .cbox { width: auto; max-width: min(300px, calc(100vw - 32px)); padding: 8px 12px 6px; border-top-width: 3px; }\n#coach.doing .cbox .tx { font-family: var(--display); font-size: 19px; line-height: 1.45; }\n#coach.doing .cbox .row { margin-top: 2px; }\n#coach.doing .cbox .do { display: none; }\n#coach .cbox .step { position: absolute; right: 10px; top: 7px; font-size: 11px; letter-spacing: .1em; color: var(--paper-2); }\n/* 一張牌兩面：台上面翻過來就是家裡面 */\n.flip { display: flex; justify-content: center; margin: 6px 0 4px; perspective: 700px; }\n.flip .fl { position: relative; width: 92px; height: 138px; transform-style: preserve-3d; animation: flip 3.6s ease-in-out infinite; }\n.flip img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 6px; backface-visibility: hidden; box-shadow: 0 6px 14px rgba(0, 0, 0, .5); }\n.flip img.b { transform: rotateY(180deg); }\n.flip .cap { align-self: center; margin-left: 12px; font-size: 13px; line-height: 1.8; color: var(--paper-2); }\n.flip .cap b { color: #f2d48a; font-weight: 400; font-family: var(--display); font-size: 16px; }\n@keyframes flip { 0%, 30% { transform: rotateY(0); } 50%, 80% { transform: rotateY(180deg); } 100% { transform: rotateY(360deg); } }\n/* 小提示：不擋、不用按，貼在新出現的東西旁邊，一次只有一枚 */\n#nudge { position: fixed; z-index: 33; max-width: min(280px, calc(100vw - 24px)); background: rgba(22, 17, 20, .96); color: var(--paper); border-left: 3px solid #f2d48a; padding: 6px 26px 7px 10px; font-size: 14px; line-height: 1.55; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); animation: rise .3s ease both; cursor: pointer; }\n#nudge b { color: #f2d48a; font-weight: 400; font-family: var(--display); font-size: 16px; display: block; }\n#nudge .x { position: absolute; right: 6px; top: 3px; color: var(--paper-2); font-size: 14px; }\n#nudge.out { opacity: 0; transition: opacity .4s ease; }\n\n/* 早上選牌：妝匣的手牌、字幕都縮小，把高度讓給桌上攤開的牌 */\n.hud[data-v=\"morning\"] .hand.on { min-height: 118px; padding-top: 10px; }\n.hud[data-v=\"morning\"] .hc { width: 72px; height: 108px; margin: 0 -2px; }\n.hud[data-v=\"morning\"] .talk { gap: 2px; padding-bottom: 2px; }\n.hud[data-v=\"morning\"] .sub .tx { font-size: 18px; line-height: 1.35; }\n.hud[data-v=\"morning\"] .sub .gain { font-size: 12px; }\n.hud[data-v=\"morning\"] .opt { font-size: 21px; min-height: 40px; }\n.hud[data-v=\"morning\"] .choices { min-height: 40px; }\n.spc .ct { min-width: 28px; height: 28px; font-size: 15px; }\n/* v0.7：她的需要、情報、觀眾的話、後台、水牌小牌 */\nmark.k { background: none; color: #f2d48a; border-bottom: 2px solid rgba(242, 212, 138, .75); padding: 0 1px; }\n.sub mark.k { color: #f6dc96; }\n.panel mark.k, .bub mark.k { color: var(--red); border-bottom-color: rgba(168, 32, 43, .6); }\n.bub.intel mark.k { color: #ffe39a; border-bottom-color: #ffe39a; }\n.itag { display: inline-flex; align-items: center; gap: 6px; font-family: var(--body); font-size: 13px; letter-spacing: .08em; color: #1c1719; background: #f2d48a; padding: 1px 9px; margin-top: 4px; text-shadow: none; }\n.itag b { font-weight: 700; }\n.itag.ev { background: var(--red-2); color: var(--paper); }\n/* 情報簿：記下她（觀眾、玉樓、更夫）說過的需要 */\n.intel { pointer-events: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 6px; max-width: min(640px, 100%); }\n.intel .ic { display: inline-flex; align-items: center; gap: 5px; background: rgba(18, 14, 17, .78); border: 1px solid rgba(242, 212, 138, .7); padding: 1px 8px 1px 4px; font-size: 13px; color: var(--paper); white-space: nowrap; }\n.intel .ic.now { border-color: #f2d48a; box-shadow: 0 0 0 1px #f2d48a inset, 0 0 12px rgba(242, 212, 138, .35); }\n.intel .ic .d { color: #f2d48a; font-size: 12px; letter-spacing: .1em; }\n.intel .ic svg { width: 18px; height: 18px; }\n.intel .ic b { font-weight: 400; color: #f2d48a; }\n.intel .lbl { font-size: 11px; letter-spacing: .3em; color: #1c1719; background: #f2d48a; padding: 1px 6px; align-self: center; }\n/* 傍晚：她今晚的需要與推了幾張 */\n.need { pointer-events: auto; display: flex; align-items: center; gap: 10px; background: rgba(18, 14, 17, .72); border: 1px solid rgba(242, 212, 138, .6); padding: 4px 12px 4px 6px; }\n.need .lookb { width: 52px; height: 52px; }\n.need .nt { font-family: var(--display); font-size: 22px; line-height: 1.2; }\n.need .nt small { display: block; font-family: var(--body); font-size: 12px; color: var(--paper-2); }\n.need .nr { display: flex; align-items: center; gap: 6px; font-size: 19px; line-height: 1.3; }\n.need .nr svg { width: 22px; height: 22px; }\n.need .nr .lkn { font-style: normal; font-size: .72em; color: var(--paper-2); }\n.need .nr .hn { font-weight: 400; color: #f2d48a; }\n.need .nr.ok span:first-of-type { color: #f2d48a; }\n.pips { display: flex; gap: 5px; }\n.pips i { width: 16px; height: 16px; border-radius: 50%; border: 2px solid #f2d48a; }\n.pips i.on { background: #f2d48a; box-shadow: 0 0 10px rgba(242, 212, 138, .8); }\n.need.done { border-color: #f2d48a; box-shadow: 0 0 18px rgba(242, 212, 138, .35); }\n/* 傍晚的焦點就是她要什麼：放大 */\n.need { padding: 6px 18px 6px 8px; }\n.need .nr { font-size: 26px; }\n.need .nr svg { width: 28px; height: 28px; }\n.need .nr .hn { font-size: 1.15em; }\n.need .nt small { font-size: 13px; }\n/* 右上：水牌小牌 */\n.side { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }\n.wb { pointer-events: auto; text-align: right; background: linear-gradient(180deg, #e9dcc4, #d8c8aa); color: var(--ink); border: 1px solid #1d120b; padding: 4px 10px 5px; min-width: 128px; cursor: pointer; font-size: 12px; line-height: 1.45; box-shadow: 0 6px 16px rgba(0, 0, 0, .5); }\n.wb b { font-family: var(--display); font-weight: 400; font-size: 20px; color: var(--red); }\n.wb .gap { display: block; color: #5a5156; }\n.wb .wbh { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 12px; letter-spacing: .1em; }\n.wb ol { list-style: none; margin: 3px 0 2px; padding: 0; min-width: 150px; }\n.wb li { display: flex; justify-content: space-between; gap: 10px; padding: 1px 6px; font-size: 13px; text-align: left; font-variant-numeric: tabular-nums; }\n.wb li .n { color: #5a5156; margin-right: 4px; }\n.wb li.me { background: var(--red); color: var(--paper); font-weight: 700; }\n.wb li.me .n { color: #f2d48a; }\n.wb li.fail { border-top: 1px dashed var(--red); }\n.wb .dif { font-size: 11px; color: #5a5156; display: block; text-align: right; }\n\n/* 觀眾的話：對白框貼著剪紙頭頂 */\n#talkb { position: fixed; inset: 0; pointer-events: none; z-index: 31; }\n.bub { position: absolute; width: max-content; max-width: min(250px, 42vw); background: var(--paper); color: var(--ink); font-family: var(--display); font-size: 18px; line-height: 1.4; padding: 6px 12px 7px; border-radius: 12px; box-shadow: 0 8px 22px rgba(0, 0, 0, .55); transform: translate(-50%, -100%); animation: bubIn .28s cubic-bezier(.2, 1.4, .4, 1) both; }\n.bub::after { content: \"\"; position: absolute; left: var(--ax, 50%); bottom: -9px; width: 16px; height: 16px; background: inherit; transform: translateX(-50%) rotate(45deg); border-radius: 3px; }\n.bub.out { animation: bubOut .35s ease both; }\n.bub .tg { display: block; font-family: var(--body); font-size: 11px; letter-spacing: .3em; margin-bottom: 1px; }\n.bub.intel { background: #1c1417; color: var(--paper); border: 2px solid #f2d48a; box-shadow: 0 0 0 4px rgba(242, 212, 138, .2), 0 0 28px rgba(242, 212, 138, .55), 0 10px 26px rgba(0, 0, 0, .6); font-size: 19px; max-width: min(300px, 46vw); }\n.bub.intel::after { background: #f2d48a; }\n.bub.intel .tg { color: #f2d48a; }\n.bub.ev { background: #f3e6e2; border: 2px solid var(--red-2); }\n.bub.ev .tg { color: var(--red); }\n.bub.boo { background: #3a2a2c; color: #f0d6d6; }\n@keyframes bubIn { from { opacity: 0; transform: translate(-50%, -80%) scale(.7); } to { opacity: 1; transform: translate(-50%, -100%); } }\n@keyframes bubOut { to { opacity: 0; transform: translate(-50%, -115%); } }\n/* 後台 */\n.shop { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 8px; }\n.offer { background: #e0d5c2; padding: 8px; display: flex; flex-direction: column; gap: 6px; align-items: center; text-align: center; }\n.offer img { width: 96px; height: 144px; border-radius: 6px; box-shadow: 0 4px 10px rgba(0, 0, 0, .35); }\n.offer .kw { font-size: 12px; color: #3b3337; line-height: 1.5; min-height: 3em; }\n.offer .pr { font-family: var(--display); font-size: 20px; color: var(--red); }\n.offer.sold { opacity: .5; }\n.offer .pv { font-size: 13px; color: var(--red); min-height: 2.6em; }\n.offer .pv b { font-size: 16px; }\n.offer.isrel { background: #ead9b8; box-shadow: inset 0 0 0 2px #b8913f; }\n.relic { width: 96px; height: 144px; display: flex; align-items: center; justify-content: center; font-family: var(--display); font-size: 64px; color: #f2d48a; background: radial-gradient(circle at 50% 42%, #7d1219 0 38%, #3d0a0e 39% 41%, #1c1417 42%); border: 3px double #b8913f; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, .35); }\n.relics { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 3px; max-width: 150px; }\n.relics .rel { pointer-events: auto; font-family: var(--display); font-size: 15px; color: #f2d48a; background: #5e0f15; border: 1px solid #b8913f; padding: 1px 6px; cursor: help; min-height: 28px; }\n.relics .rel:hover, .relics .rel:focus-visible { background: #7a1620; outline: none; box-shadow: 0 0 0 2px #f2d48a; }\n#tip { position: fixed; z-index: 70; max-width: 280px; background: #1c1719; color: var(--paper); border: 1px solid var(--gold); padding: 8px 11px 9px; font-size: 13px; line-height: 1.55; pointer-events: none; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); }\n#tip b { display: block; font-family: var(--display); font-weight: 400; font-size: 18px; color: #f2d48a; margin-bottom: 2px; }\n.term { font-style: normal; border-bottom: 1px dashed currentColor; cursor: help; pointer-events: auto; }\n#anchors div { position: fixed; pointer-events: none; }\n.purse { display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; color: #3b3337; }\n.purse b { font-family: var(--display); font-weight: 400; font-size: 22px; color: var(--red); margin-left: 4px; }\n.tips li { font-size: 14px; }\n@media (max-width: 760px) {\n  .bub { font-size: 15px; max-width: 46vw; }\n  .hud[data-v=\"morning\"] .hc { width: 54px; height: 81px; margin: 0 -2px; }\n  .hud[data-v=\"morning\"] .hand.on { min-height: 92px; }\n  /* 早上手牌就是妝匣，窄螢幕上不再疊一排小格子 */\n  .bub.intel { font-size: 15px; max-width: 62vw; }\n  .need .nt { font-size: 17px; }\n  .need { gap: 6px; padding: 3px 8px 3px 4px; }\n  .wb { min-width: 0; padding: 3px 7px; }\n  .wb b { font-size: 16px; }\n  .intel .ic { font-size: 12px; }\n  .need .nt { font-size: 18px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .fleck { display: none; }\n  .sub, .watch .w, .watch .w2, .stamp, #peek, #coach .ring, #coach .cbox, .nx, .bub, .bub.intel, #combo .cb, #combo .cs, .gainf { animation: none; }\n  #ink.on { transition-duration: .01s; }\n}\n@media (max-width: 760px) {\n  .plate { min-width: 92px; padding: 5px 8px 6px; }\n  .plate .lm { gap: 1px; margin-top: 3px; padding-top: 3px; }\n  .plate .lm .k2 { flex-direction: column; gap: 1px; align-items: center; }\n  .plate .lm b { font-size: 15px; }\n  .outs { gap: 2px; }\n  .outs i { width: 7px; height: 7px; }\n  .need .lookb { width: 36px; height: 36px; }\n  .need .nr { font-size: 16px; white-space: nowrap; gap: 4px; }\n  .need .nr .lkn { display: none; }\n  .need .nt small { font-size: 11px; }\n  .wb .exam { font-size: 10px; max-width: 9.5em; margin-left: auto; line-height: 1.3; }\n  .plate .d { font-size: 17px; }\n  .plate .g b { font-size: 17px; }\n  /* 手機：家那一塊壓成一條，放在上面那排底下 */\n  .leftcol { bottom: auto; left: 8px; width: auto; max-width: calc(100vw - 16px); flex-direction: row; align-items: stretch; gap: 4px; }\n  .homep { display: flex; align-items: center; gap: 10px; padding: 3px 8px; }\n  .homep .hh { display: none; }\n  .homep .hl { gap: 4px; }\n  .homep .hrow { margin-top: 0; }\n  .tool.bookb { width: auto; }\n  .wb ol { min-width: 0; margin: 1px 0; }\n  .wb li:not(.me) { display: none; }\n  .wb li { font-size: 12px; padding: 0 4px; }\n  .wb .wbh { font-size: 11px; }\n  .tools .tool { padding: 4px 8px; }\n  .homep .hl .lampsvg { width: 28px; height: 28px; }\n  .homep .hl b { font-size: 20px; }\n  .homep .hl small { display: none; }\n  .homep .hrow em { display: none; }\n  .homep .outs i { width: 9px; height: 9px; }\n  .tool.bookb small { display: none; }\n  .slot { height: 28px; font-size: 12px; }\n  .pl { width: 42px; height: 38px; font-size: 14px; }\n  /* 手機：上面那一排放不下三樣，中間那塊（連擊、情報、她的需要）折到第二行 */\n  .top { flex-wrap: wrap; row-gap: 4px; }\n  .topmid { order: 3; flex-basis: 100%; }\n  .lk { width: 8px; }\n  .hand.on { min-height: 128px; }\n  .hc { width: 72px; height: 108px; margin: 0 -4px; }\n  .hc .stain { width: 24px; height: 24px; }\n  .spread { padding: 6px; gap: 6px; }\n  .sub .tx { font-size: 19px; }\n  .sub .gain { font-size: 12px; }\n  .opt { font-size: 20px; }\n  .talk { padding-bottom: 38px; }\n  .title-in { grid-template-columns: minmax(0, 1fr); gap: 18px; margin-left: 0; }\n  .vb { flex-direction: row; justify-content: center; padding: 14px; }\n  .vb .t { writing-mode: horizontal-tb; font-size: 54px; }\n  .vb .s { writing-mode: horizontal-tb; letter-spacing: .2em; }\n  .intro { font-size: 20px; }\n  .title { align-items: flex-start; background: rgba(12, 9, 11, .8); }\n  #peek { gap: 6px; }\n  #peek figure { width: calc((100vw - 38px) / 2); padding: 5px 5px 7px; }\n  #peek img { width: 70%; margin: 0 auto; }\n  #peek figcaption { font-size: 12px; }\n}\n/* ── v1.6 美術：圖到齊才生效（<html> 上的 art 與各 a-* class 由 artSetup() 掛上；缺圖的那一樣維持 v1.5）── */\n/* 她的樣子：四張剪影小圖（染成紙色）取代 v1.5 的線條圖示 */\n.lki { display: block; flex: none; width: 30px; height: 30px; object-fit: contain; }\n.lookb .lki { width: 62%; height: 62%; }\n.need .nr .lki { width: 30px; height: 30px; }\n.intel .ic .lki { width: 18px; height: 18px; }\n/* 後台物件：右上小牌、後台的物件卡、圖鑑 */\n.relics .rel { display: inline-flex; align-items: center; gap: 3px; }\n.relics .rel .ri { width: 22px; height: 22px; margin-left: -3px; }\n.relic.pic { flex-direction: column; gap: 2px; background: radial-gradient(circle at 50% 40%, #f4efe6 0 46%, #e3d8c4 100%); color: #7d1219; font-size: 19px; line-height: 1; }\n.relic.pic img { width: 84px; height: 84px; display: block; }\n.bookr li { position: relative; }\n.bookr .bri { float: left; width: 56px; height: 56px; margin: 0 10px 2px 0; }\n/* 同門、孫師父的木刻像 */\n.board .av { width: 28px; height: 28px; border-radius: 50%; vertical-align: middle; margin: -4px 6px -2px 2px; box-shadow: 0 0 0 1.5px #1c1719; }\n.board li.me .av { display: none; }\n.sub .sface { width: 42px; height: 42px; border-radius: 50%; vertical-align: middle; margin: -4px 8px 0 0; box-shadow: 0 0 0 2px var(--red), 0 3px 10px rgba(0, 0, 0, .7); }\n.sunq { display: flex; gap: 12px; align-items: center; }\n.sunq .pt { width: 64px; height: 96px; flex: none; box-shadow: 0 0 0 1px #1c1719, 0 4px 10px rgba(0, 0, 0, .35); }\n/* 紙：米白紙頁的毛邊（九宮格），標題下一筆朱紅；深色紙給燈的回饋、骰子 */\nhtml.a-paper .panel { background: none; border: 14px solid transparent; border-image: var(--ui-paper) 128 fill / 24px / 10px stretch; box-shadow: none; filter: drop-shadow(0 12px 24px rgba(0, 0, 0, .55)); padding: 4px 8px 6px; }\nhtml.a-brush .panel h2 { padding-bottom: 8px; background: var(--ui-brush) 0 100% / min(280px, 72%) 14px no-repeat; }\nhtml.a-paperdk #lampfb .lf, html.a-paperdk #dice .dbox { background: none; border: 0 solid transparent; border-image: var(--ui-paper-dk) 150 fill / 26px / 12px stretch; box-shadow: none; filter: drop-shadow(0 14px 28px rgba(0, 0, 0, .75)); }\n/* 印：「家」、「完美」用方印底（白文）；結局字壓在圓印上 */\nhtml.a-seal .wtag { background: var(--ui-seal) center / 100% 100% no-repeat; border-radius: 0; box-shadow: none; filter: drop-shadow(0 2px 3px rgba(0, 0, 0, .6)); color: #f6ecd9; }\nhtml.a-seal .stamp { background: var(--ui-seal) center / 100% 100% no-repeat; border: 0; color: #f6ecd9; padding: 14px 30px 16px; text-shadow: none; filter: drop-shadow(0 6px 14px rgba(0, 0, 0, .6)); }\nhtml.a-sealr .watch .end { display: flex; align-items: center; justify-content: center; width: clamp(108px, 17vh, 150px); height: clamp(108px, 17vh, 150px); padding-left: .1em; background: var(--ui-seal-r) center / 100% 100% no-repeat; color: #f6ecd9; letter-spacing: .1em; line-height: 1.1; text-align: center; font-size: clamp(34px, 5.6vh, 48px); filter: drop-shadow(0 6px 16px rgba(0, 0, 0, .7)); }\nhtml.a-sealr .watch .end.l3 { font-size: clamp(26px, 4.2vh, 36px); letter-spacing: .04em; padding-left: .04em; }\n/* 熄：五根燈芯，熄過一回就換成熄掉的那根；深色框裡的燈芯換成紙色 */\nhtml.a-wick .outs i, html.a-wick .homep .outs i { width: 10px; height: 18px; border: 0; border-radius: 0; background: var(--ui-wick) 50% 48% / auto 250% no-repeat; box-shadow: none; }\nhtml.a-wick .outs i.on, html.a-wick .homep .outs i.on { background-image: var(--ui-wick-out); box-shadow: none; }\nhtml.a-wick #lampfb .outs i { background-image: var(--ui-wick-l); }\nhtml.a-wick #lampfb .outs i.on { background-image: var(--ui-wick-out-l); }\nhtml.a-wick .outs i.new { animation: wickOut 1.1s ease both; }\n@keyframes wickOut { 0% { transform: scale(2.2); filter: drop-shadow(0 0 6px #ffb070); } 100% { transform: none; filter: none; } }\n/* 痕：一道墨劃痕；還沒有的那幾道淡淡的 */\nhtml.a-scar .scars i, html.a-scar .homep .scars i { width: 8px; height: 22px; background: var(--ui-scar) 50% 50% / 100% auto no-repeat; transform: none; opacity: .16; }\nhtml.a-scar .scars i.on, html.a-scar .homep .scars i.on { background-color: transparent; opacity: 1; }\nhtml.a-scar .homep .hrow.hot .scars i.on { filter: drop-shadow(0 0 3px rgba(200, 40, 58, .9)); }\n/* 散戲的金箔：圖集裡隨機一片 */\nhtml.a-gold .fleck { width: 18px; height: 18px; background: var(--fx-gold) 0 0 / 400% 400% no-repeat; }\n/* 更夫報更：夜空、遠山城牆、屋脊戲樓、近處屋簷燈籠、月亮（字放在中間的空白裡） */\nhtml.a-night .watch { background: radial-gradient(circle at 80% 16%, rgba(236, 227, 212, .1) 0, rgba(236, 227, 212, 0) 30%), linear-gradient(180deg, #23242f 0%, #13141c 30%, #0f1017 50%, #22232f 80%, #2c2c38 100%); }\n.watch .nite { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }\n.watch .nite img { position: absolute; left: 50%; width: max(100%, 1100px); height: auto; transform: translateX(-50%); }\n.watch .nite .n1 { bottom: 0; opacity: .5; animation: nDrift 26s ease-in-out infinite alternate; }\n.watch .nite .n2 { bottom: -2px; animation: nDrift 19s ease-in-out infinite alternate-reverse; }\n.watch .nite .n3 { top: 0; width: max(108%, 1180px); animation: nDrift 14s ease-in-out infinite alternate; }\n.watch .nite .mn { left: auto; right: 15%; top: 8vh; width: clamp(80px, 15vh, 150px); transform: none; opacity: .92; filter: drop-shadow(0 0 22px rgba(236, 227, 212, .35)); }\n.watch > :not(.nite) { position: relative; z-index: 1; }\n@keyframes nDrift { from { transform: translateX(calc(-50% - 8px)); } to { transform: translateX(calc(-50% + 8px)); } }\n@media (prefers-reduced-motion: reduce) { .watch .nite img { animation: none; } }\n@media (max-width: 760px) { .watch .nite .mn { right: 8%; top: 5vh; } .sub .sface { width: 34px; height: 34px; } }\n</style>\n\n<canvas id=\"gl\" aria-hidden=\"true\"></canvas>\n<canvas id=\"smear\" aria-hidden=\"true\"></canvas>\n<div id=\"vig\" aria-hidden=\"true\"></div>\n<div id=\"grain\" aria-hidden=\"true\"></div>\n<canvas id=\"stagefx\" aria-hidden=\"true\"></canvas>\n<div id=\"combo\" aria-hidden=\"true\"></div>\n<div class=\"hud\" id=\"hud\" hidden>\n  <div class=\"top\">\n    <div class=\"plate\" id=\"plate\"></div>\n    <div class=\"topmid\" id=\"topmid\"></div>\n    <div class=\"side\"><div class=\"tools\"><button class=\"tool\" data-act=\"music\" id=\"musicBtn\" aria-pressed=\"false\">乐</button><button class=\"tool\" data-act=\"rules\">规矩</button></div><div id=\"wboard\"></div></div>\n  </div>\n  <div class=\"leftcol\" id=\"leftcol\"><div class=\"homep\" id=\"homep\"></div><button class=\"tool bookb\" data-act=\"book\" id=\"bookBtn\">图鉴</button></div>\n  <div class=\"mid\" id=\"mid\"></div>\n  <div class=\"talk\"><div id=\"sub\"></div><div class=\"choices\" id=\"choices\"></div></div>\n  <div class=\"hand\" id=\"hand\"></div>\n  <div class=\"hand-label\" id=\"handLabel\"></div>\n</div>\n<div id=\"title\" class=\"title\" hidden></div>\n<div id=\"watch\" class=\"watch\" hidden></div>\n<div id=\"wipe\" class=\"lastwipe\" hidden></div>\n<div id=\"ink\" aria-hidden=\"true\"></div>\n<div id=\"fx\" aria-hidden=\"true\"></div>\n<div id=\"talkb\" aria-live=\"polite\"></div>\n<div id=\"dice\" hidden></div>\n<div id=\"lampfb\" hidden aria-live=\"polite\"></div>\n<div id=\"coach\" hidden></div>\n<div id=\"peek\" hidden aria-hidden=\"true\"></div>\n<div id=\"tip\" hidden role=\"tooltip\"></div>\n<div id=\"anchors\" aria-hidden=\"true\"></div>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><filter id=\"rough\"><feTurbulence type=\"fractalNoise\" baseFrequency=\".02\" numOctaves=\"3\" seed=\"7\"/><feDisplacementMap in=\"SourceGraphic\" scale=\"70\"/></filter></svg>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n<script>\n/* ENGINE START */\n// 規則依 設計/v1.0_戲城_平衡版.md（v1.1–v1.3 只改介面與教學）。數字都是占位；文件沒寫死的地方，列在 ASSUME（規矩頁）。\nconst R = {\n  days: 10, box: 10, boxMin: 6, stageMax: 5, homeMax: 3, homeAfterWipe: 1,\n  wipeLayers: 2, wipeScarMax: 2, layerMax: 4, openGold: 1, chainGold: [0, 0, 1, 2, 3, 3],\n  perfectChain: 3, perfectDie: 4, perfect: 1.5, stageDouble: 2,\n  dyeCap: [1, 2, 3], basePerSlot: 2, overBase: [2, 4], seatScar: 3, brokenScar: 4, brokenOuts: 5, happyScar: 1, happyOuts: 0, ranks: 6,\n  // v0.7：她的需要（每段兩天、要推夠張數）、滅燈、美滿要燈、後台、怨氣\n  // v1.0：不對路的牌燈不漲；美滿要燈糊滿（30）、每晚都接住（熄 0）、痕不過 1\n  lampMatch: 2, lampPlain: 0, lampOut: 3, happyLamp: 30, lampFull: 30, shopFrom: 3, shopOffers: 2,\n  // v0.9：幕末考核（名次到這裡就摘牌，這一季提前結束）\n  exam: { 3: 6, 7: 5 },\n};\n// 後台的物件：買一次，整季都有用（v0.8）\nconst RELICS = {\n  qinshi: { n: '琴师', price: 12, tx: '每接上一张，再 +1 金。' },\n  gujing: { n: '锣鼓经', price: 10, tx: '开得正：+4 金（不是 +1）。' },\n  cha: { n: '护嗓茶', price: 13, tx: '收场掷骰，3 以上就算完美。' },\n  lian: { n: '妆奁', price: 13, tx: '妆匣多一格。' },\n  jin: { n: '熟手巾', price: 11, tx: '她替你擦脸，一次擦 3 层。' },\n  you: { n: '灯油', price: 9, tx: '没满足她的需要，灯只熄 1（不是 3）。' },\n  luo: { n: '小锣', price: 10, tx: '每天第一次接错，不记怨气。' },\n};\nconst RELIC_KEYS = Object.keys(RELICS);\n// 台上四族；home 是這一族牌背面的家裡面\nconst FAM = {\n  sing: { n: '唱', home: 'listen' },\n  speak: { n: '念', home: 'comp' },\n  act: { n: '做', home: 'care' },\n  fight: { n: '打', home: 'labor' },\n};\nconst HOME = {\n  listen: { n: '倾听', look: '想说', hurt: '她说到一半停住了。从这天起，她不再开口。' },\n  comp: { n: '陪伴', look: '等', hurt: '你坐下来，她也开始跟你汇报今天的事。' },\n  care: { n: '照顾', look: '累', hurt: '她接了过去，却不信。' },\n  labor: { n: '共劳', look: '忙', hurt: '你的手一抖，灯纸被划破了。' },\n};\nconst LOOK_HOME = { 想说: 'listen', 等: 'comp', 累: 'care', 忙: 'labor' };\n// 牌：g 金，next 接哪一族\n// blank 背面空白（借來的牌）；heavy 重彩，留兩層；wild 百搭，前後都算接上（也能起手）；fin 壓軸，第 4 張起打出多給的金\n// clean 素，不上妝、不留層；boost 托，接上時連擊的金翻倍\n// home 家常牌，只能推給她（也能拿來卸妝），對上她的需要算兩張、燈 +3；price 後台的價錢\nconst T = {\n  changqiang: { f: 'sing', n: '长腔', g: 2, next: 'speak' },\n  liangsang: { f: 'sing', n: '亮嗓', g: 2, next: 'fight' },\n  bai: { f: 'speak', n: '白', g: 1, next: 'act' },\n  kuaiban: { f: 'speak', n: '快板', g: 1, next: 'sing' },\n  shenduan: { f: 'act', n: '身段', g: 1, next: 'fight' },\n  shuixiu: { f: 'act', n: '水袖', g: 1, next: 'sing' },\n  liangxiang: { f: 'fight', n: '亮相', g: 3, next: 'sing' },\n  fanshen: { f: 'fight', n: '翻身', g: 3, next: 'speak' },\n  jie_kutou: { f: 'sing', n: '哭头', g: 4, next: 'speak', blank: 1 },\n  jie_guankou: { f: 'speak', n: '贯口', g: 3, next: 'act', blank: 1 },\n  jie_dadao: { f: 'fight', n: '大刀', g: 5, next: 'sing', blank: 1 },\n  // 後台：孫師父手裡的牌\n  manban: { f: 'sing', n: '慢板', g: 8, next: 'speak', heavy: 1, price: 8 },\n  daoban: { f: 'sing', n: '导板', g: 3, next: 'act', wild: 1, price: 8 },\n  yunbai: { f: 'speak', n: '韵白', g: 3, next: 'act', fin: 5, price: 7 },\n  shuban: { f: 'speak', n: '数板', g: 2, next: 'fight', wild: 1, price: 7 },\n  woyu: { f: 'act', n: '卧鱼', g: 3, next: 'sing', fin: 6, price: 8 },\n  tazhuan: { f: 'act', n: '踏转', g: 6, next: 'speak', heavy: 1, price: 7 },\n  qiba: { f: 'fight', n: '起霸', g: 9, next: 'sing', heavy: 1, price: 9 },\n  jijifeng: { f: 'fight', n: '急急风', g: 4, next: 'speak', wild: 1, price: 9 },\n  qingchang: { f: 'sing', n: '清唱', g: 4, next: 'speak', clean: 1, price: 7 },\n  dingchang: { f: 'speak', n: '定场诗', g: 4, next: 'act', clean: 1, price: 7 },\n  tuoqiang: { f: 'sing', n: '托腔', g: 3, next: 'fight', boost: 1, price: 8 },\n  tangma: { f: 'fight', n: '趟马', g: 4, next: 'act', boost: 1, price: 8 },\n  // 家常牌：她的需要整段都對上了，她送你的\n  tang: { f: 'act', n: '热汤', g: 0, next: 'sing', home: 1 },\n  fan: { f: 'speak', n: '同桌', g: 0, next: 'sing', home: 1 },\n  xin: { f: 'sing', n: '旧信', g: 0, next: 'sing', home: 1 },\n  zhi: { f: 'fight', n: '剪纸', g: 0, next: 'sing', home: 1 },\n};\nconst BASIC = ['changqiang', 'liangsang', 'bai', 'kuaiban', 'shenduan', 'shuixiu', 'liangxiang', 'fanshen'];\nconst BORROWED = ['jie_kutou', 'jie_guankou', 'jie_dadao'];\nconst SHOP = ['manban', 'daoban', 'yunbai', 'shuban', 'woyu', 'tazhuan', 'qiba', 'jijifeng', 'qingchang', 'dingchang', 'tuoqiang', 'tangma'];\nconst GIFT = { care: 'tang', comp: 'fan', listen: 'xin', labor: 'zhi' };\nconst GIFTS = Object.values(GIFT);\n// 第 1、2 天妝匣是替你裝好的：走得通一條四張鏈，四種家裡面都有\nconst PRESET = ['changqiang', 'bai', 'shenduan', 'liangxiang', 'liangsang', 'kuaiban', 'shuixiu', 'fanshen', 'bai', 'shenduan'];\nconst STARTER = ['sing', 'speak', 'act', 'fight', 'sing', 'speak', 'act', 'speak', 'fight'];\nconst YUAN_START = { stage: 'fight', cover: 'sing', lamp: null };\n// 她的需要一段兩天：第 2–3、4–5、6–7、8–9 天，四段各有一個主要的樣子 A（每局洗過）\n// 每晚的要求從這一段的花樣裡挑：A1 一張、A2 兩張同樣、AB 兩種各一張、A2B 三張（最難）\nconst SPELLS = [\n  { from: 2, to: 3, pats: [['A1'], ['A1']] },\n  { from: 4, to: 5, pats: [['A2', 'AB'], ['A2', 'AB', 'A1']] },\n  { from: 6, to: 7, pats: [['AB', 'A2', 'A1'], ['A2', 'AB']] },\n  { from: 8, to: 9, pats: [['A2B', 'AB'], ['A2B']] },\n];\nconst PAT = { A1: [['A', 1]], A2: [['A', 2]], AB: [['A', 1], ['B', 1]], A2B: [['A', 2], ['B', 1]] };\nconst ACT_N = ['开锣', '借妆', '卸妆'];\n// 同門與班主：每天的金有起伏，事件會讓某一天特別高\nconst RIVALS = [{ n: '魏老板', g: 20, v: 0.12 }, { n: '金宝', g: 17, v: 0.3 }, { n: '月仙', g: 14, v: 0.3 }, { n: '玉楼', g: 7, v: 0.4 }, { n: '小凤', g: 9, v: 0.2, feng: 1 }];\nconst FENG_SICK = [4, 7];\n// 同門的事：第 3 天固定玉樓遞話（教學），第 4、8 天是小鳳；其餘天從這裡挑\nconst EVENTS = {\n  tip: { who: '玉楼', tx: '玉楼路过灯坊，回来跟你说了一句阿檀今晚的事。' },\n  hot: { who: '金宝', tx: '金宝昨晚唱了个满堂彩，今天的水牌，他要往上蹿一大截。', rival: '金宝', mul: 2 },\n  grab: { who: '月仙', tx: '月仙抢了今天的压轴。你只剩四张的戏。', stageMax: 4 },\n  cheer: { who: '魏老板', tx: '魏老板请了一帮捧场的，今天台下热：骰子 3 以上就算完美。', die: 3 },\n  wei: { who: '魏老板', tx: '魏老板今天亲自压轴，他的牌子要再高一截。', rival: '魏老板', mul: 1.8 },\n  sick: { who: '小凤', tx: '小凤病倒了，嗓子哑着。魏老板把她的三张牌推到你面前。' },\n  back: { who: '小凤', tx: '小凤能下床了，魏老板把牌收了回去。' },\n};\nconst EVENT_POOL = ['hot', 'grab', 'cheer', 'wei', 'tip'];\n// 結局：列是排名（第一／2–5／摘牌），欄是妻子（美滿／守住／破裂）\nconst ENDING_N = [['满堂彩', '压台', '头牌'], ['留白', '半台', '戏散'], ['卸尽', '素脸', '更夫']];\n\nconst clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));\nconst actOf = d => (d <= 3 ? 0 : d <= 7 ? 1 : 2);\nconst cardOf = (S, id) => S.deck.find(c => c.id === id);\nconst tOf = (S, id) => T[cardOf(S, id).t];\nconst fOf = (S, id) => tOf(S, id).f;\nconst homeOf = t => FAM[T[t].f].home;\nconst lockedBox = S => S.day < 3;\nconst boxCapOf = S => (actOf(S.day) >= 1 ? Math.max(R.boxMin, R.box - Math.floor(S.base / R.basePerSlot)) : R.box) + (S.relics && S.relics.includes('lian') ? 1 : 0);\nconst starterOf = S => (S.day === R.days ? (S.choice ? YUAN_START[S.choice] : null) : STARTER[S.day - 1]);\nconst seatEmpty = S => actOf(S.day) === 2 && S.scars >= R.seatScar;\nconst spellOf = d => SPELLS.findIndex(s => d >= s.from && d <= s.to);\n// 她那一天的需要：樣子與要幾張\n// 她那一天的需要：items 是要的樣子與張數，look 是主要的樣子，k 是總張數\nconst needOf = (S, d = S.day) => {\n  const i = spellOf(d), r = S.recipes[d];\n  const items = r || [{ look: '等', n: 1 }];\n  return { items, look: items[0].look, k: items.reduce((a, x) => a + x.n, 0), spell: i, pat: S.pats[d] || 'A1' };\n};\nconst has = (S, k) => S.relics.includes(k);\nconst lookNow = S => (seatEmpty(S) ? null : needOf(S).look);\n// v1.0：只有一種金。買東西花的就是賣座，名次跟著掉\nconst purseOf = S => S.gold;\n// 骰子：種子存在狀態裡，存檔、重玩、測試都能重現\nfunction d6(S) {\n  let a = S.seed | 0;\n  a = (a + 0x6D2B79F5) | 0;\n  S.seed = a >>> 0;\n  let t = Math.imul(a ^ (a >>> 15), 1 | a);\n  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n  return 1 + Math.floor((((t ^ (t >>> 14)) >>> 0) / 4294967296) * 6);\n}\n// 不吃玩家骰子的亂數：同門的金、事件、後台的貨，只看開局種子和天數\nfunction fixed(S, ...k) {\n  let h = (S.seed0 ^ 0x9E3779B9) >>> 0;\n  for (const v of k) { h = Math.imul(h ^ (v + 0x7F4A7C15), 2654435761) >>> 0; h ^= h >>> 15; }\n  h = Math.imul(h ^ (h >>> 13), 1274126177) >>> 0;\n  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;\n}\nfunction addCard(S, t) {\n  const c = { id: S.nid++, t };\n  S.deck.push(c);\n  return c;\n}\n\nfunction newGame(name, seed) {\n  const s0 = (seed >>> 0) || 1;\n  const S = { v: 13, name, seed: s0, seed0: s0, day: 1, phase: 'morning', deck: [], nid: 1,\n    gold: 0, spent: 0, lamp: 0, lit: false, litAlone: false, scars: 0, base: 0, baseSeen: false, fengGold: 0, outs: 0,\n    played: { sing: 0, speak: 0, act: 0, fight: 0 }, scarLog: [], rope: [], chest: [], log: [], lines: {}, choice: null, lastBox: null,\n    looks: [], recipes: {}, pats: {}, events: {}, known: {}, met: [0, 0, 0, 0], gifts: [], bought: [], relics: [],\n    opt: { open: true }, left: 0, fired: 0, T: null };\n  // 四段需要各是一種樣子，每局洗過\n  const L = ['等', '累', '忙', '想说'];\n  for (let i = L.length - 1; i > 0; i--) { const j = Math.floor(fixed(S, 900, i) * (i + 1)); [L[i], L[j]] = [L[j], L[i]]; }\n  S.looks = L;\n  // 每晚的要求：從這一段的花樣挑一個；B 是另一種樣子\n  SPELLS.forEach((sp, i) => {\n    const others = ['等', '累', '忙', '想说'].filter(x => x !== L[i]);\n    for (let d = sp.from; d <= sp.to; d++) {\n      const opts = sp.pats[d - sp.from], pat = opts[Math.floor(fixed(S, 800, d) * opts.length)];\n      const B = others[Math.floor(fixed(S, 810, d) * others.length)];\n      S.pats[d] = pat;\n      S.recipes[d] = PAT[pat].map(([w, n]) => ({ look: w === 'A' ? L[i] : B, n }));\n    }\n  });\n  // 同門的事\n  const pool = EVENT_POOL.slice();\n  [5, 6, 7, 9].forEach(d => { S.events[d] = pool.splice(Math.floor(fixed(S, 700, d) * pool.length), 1)[0]; });\n  S.events[3] = 'tip'; S.events[4] = 'sick'; S.events[8] = 'back';\n  BASIC.forEach(t => { addCard(S, t); addCard(S, t); });\n  beginDay(S);\n  return S;\n}\nconst eventOf = (S, d = S.day) => (S.events[d] ? EVENTS[S.events[d]] : null);\nfunction beginDay(S) {\n  // 第二幕：魏老闆借來小鳳的三張牌；第三幕收回\n  if (S.day === 4) BORROWED.forEach(t => addCard(S, t));\n  if (S.day === 8) S.deck = S.deck.filter(c => !T[c.t].blank);\n  const ev = eventOf(S);\n  S.T = { cap: boxCapOf(S), box: [], plays: [], chain: 0, maxChain: 0, layers: [], used: {},\n    stageGold: 0, comboGold: 0, openGold: 0, finGold: 0, gold: 0, die: null, perfect: false, ended: false,\n    stageMax: ev && ev.stageMax ? ev.stageMax : R.stageMax, perfectDie: Math.max(2, (ev && ev.die ? ev.die : R.perfectDie) - (has(S, 'cha') ? 1 : 0)),\n    wiped: 0, homeCap: R.homeMax, pushed: [], dye: 0, grudge: 0, lampGain: 0, scarsToday: 0, reacts: [], matched: 0,\n    need: needOf(S), got: {}, judged: false, met: null, lampOut: 0, gift: null, forecast: null, heard: false, freeBreak: has(S, 'luo'),\n    offers: [], sold: [], freeClean: 0, seep: 0, nightBase: 0, emptySeat: false, auto: false, watch: null, wasted: 0 };\n  if (ev === EVENTS.tip) S.known[S.day] = 'tip';\n  // 後台：第 3 天起每天早上兩張牌、一樣物件（物件賣完就只有牌）\n  if (S.day >= R.shopFrom) {\n    const pool = SHOP.slice();\n    for (let i = 0; i < R.shopOffers && pool.length; i++) S.T.offers.push(pool.splice(Math.floor(fixed(S, 500, S.day, i) * pool.length), 1)[0]);\n    const rel = RELIC_KEYS.filter(k => !S.relics.includes(k));\n    if (rel.length) S.T.offers.push(rel[Math.floor(fixed(S, 520, S.day) * rel.length)]);\n  }\n  if (lockedBox(S)) {\n    const taken = new Set();\n    S.T.box = PRESET.map(t => { const c = S.deck.find(x => x.t === t && !taken.has(x.id)); taken.add(c.id); return c.id; });\n  } else {\n    const ids = new Set(S.deck.map(c => c.id));\n    S.T.box = (S.lastBox || []).filter(id => ids.has(id)).slice(0, S.T.cap);\n  }\n  S.phase = S.day === 1 ? 'stage' : 'morning';\n}\n\n// ── 早 ──\nfunction choose(S, key) {\n  if (S.phase !== 'morning' || S.day !== R.days || !(key in YUAN_START)) return;\n  S.choice = key;\n}\nconst canAdd = (S, id) => S.phase === 'morning' && !lockedBox(S) && !S.T.box.includes(id) && S.T.box.length < S.T.cap;\nfunction toggleBox(S, id) {\n  if (S.phase !== 'morning' || lockedBox(S) || !cardOf(S, id)) return;\n  const b = S.T.box, i = b.indexOf(id);\n  if (i >= 0) b.splice(i, 1); else if (canAdd(S, id)) b.push(id);\n}\nfunction clearBox(S) { if (S.phase === 'morning' && !lockedBox(S)) S.T.box = []; }\nfunction boxYesterday(S) {\n  if (S.phase !== 'morning' || lockedBox(S)) return;\n  S.T.box = (S.lastBox || []).filter(id => cardOf(S, id)).slice(0, S.T.cap);\n}\n// 後台：花錢袋裡的金，水牌看賣座（掙過的總數），買東西不掉名次\nconst priceOf = k => (RELICS[k] ? RELICS[k].price : T[k].price);\nconst canBuy = (S, k) => S.phase === 'morning' && S.T.offers.includes(k) && !S.T.sold.includes(k) && !S.relics.includes(k) && purseOf(S) >= priceOf(k);\nfunction buy(S, k) {\n  if (!canBuy(S, k)) return null;\n  S.spent += priceOf(k);\n  S.gold -= priceOf(k);\n  S.T.sold.push(k);\n  S.bought.push({ day: S.day, t: k });\n  if (RELICS[k]) {\n    S.relics.push(k);\n    // 妝奩：今天就多一格\n    if (k === 'lian') S.T.cap += 1;\n    return { relic: k };\n  }\n  return addCard(S, k);\n}\nconst stageable = (S, id) => !tOf(S, id).home;\nfunction canDepart(S) {\n  if (S.phase !== 'morning') return false;\n  if (S.day === R.days && !S.choice) return false;\n  const st = starterOf(S);\n  return st === null || S.T.box.some(id => fOf(S, id) === st && stageable(S, id));\n}\nfunction depart(S) {\n  if (!canDepart(S)) return;\n  S.lastBox = S.T.box.slice();\n  // 回家點燈：不演，直接回家\n  S.phase = S.choice === 'lamp' ? 'evening' : 'stage';\n}\n\n// ── 白天 ──\n// 下一張要打哪一族：起手看木牌，之後看上一張右邊寫的「接」\n// 百搭後面打什麼都接得上：回 '*'\nconst nextFam = S => { const P = S.T.plays; if (!P.length) return starterOf(S); const tp = tOf(S, P[P.length - 1].id); return tp.wild ? '*' : tp.next; };\nconst nextBonus = S => (S.T.plays.length ? R.chainGold[Math.min(S.T.chain + 1, R.stageMax)] : 0);\nconst fits = (S, id) => { const nf = nextFam(S); return !!tOf(S, id).wild || nf === '*' || fOf(S, id) === nf; };\nfunction canStage(S, id) {\n  const t = S.T;\n  if (S.phase !== 'stage' || t.ended || !t.box.includes(id) || t.used[id] || t.plays.length >= t.stageMax || !stageable(S, id)) return false;\n  return t.plays.length > 0 || fOf(S, id) === starterOf(S) || !!tOf(S, id).wild;\n}\nfunction playStage(S, id) {\n  if (!canStage(S, id)) return null;\n  const t = S.T, tp = tOf(S, id), f = tp.f, first = !t.plays.length, hit = !first && fits(S, id);\n  t.chain = hit ? t.chain + 1 : 1;\n  t.maxChain = Math.max(t.maxChain, t.chain);\n  const extra = hit ? (R.chainGold[Math.min(t.chain, R.stageMax)] + (has(S, 'qinshi') ? 1 : 0)) * (tp.boost ? 2 : 1) : 0, open = first && S.opt.open ? R.openGold + (has(S, 'gujing') ? 3 : 0) : 0;\n  const fin = tp.fin && t.plays.length >= 3 ? tp.fin : 0;\n  const p = { id, f, g: tp.g, extra, open, fin, hit, broke: !first && !hit, chain: t.chain, layers: 0, seeped: 0 };\n  t.plays.push(p);\n  t.used[id] = 'stage';\n  t.stageGold += tp.g; t.comboGold += extra; t.openGold += open; t.finGold += fin;\n  S.played[f] += 1;\n  // 接錯了：台下的怨氣跟你回家，今晚多染一張（第 1 天不算）\n  if (p.broke && S.day > 1) {\n    // 小鑼：每天第一次接錯不記\n    if (t.freeBreak) { t.freeBreak = false; p.saved = true; } else { t.grudge += 1; p.grudge = true; }\n  }\n  // 重彩留兩層、素不上妝；第 5 層起直接滲進底色\n  for (let i = 0; i < (tp.heavy ? 2 : tp.clean ? 0 : 1); i++) {\n    if (t.layers.length >= R.layerMax) { S.base += 1; t.seep += 1; p.seeped += 1; } else { t.layers.push({ f }); p.layers += 1; }\n  }\n  return p;\n}\n// 台下的閒話裡有她今晚的事：聽到了就記下來\nfunction hearCrowd(S) {\n  if (S.phase !== 'stage' || S.T.heard || seatEmpty(S)) return false;\n  S.T.heard = true;\n  if (!S.known[S.day]) S.known[S.day] = 'crowd';\n  return true;\n}\nconst canEndStage = S => S.phase === 'stage' && !S.T.ended;\nfunction endStage(S) {\n  if (!canEndStage(S)) return;\n  const t = S.T, sum = t.stageGold + t.comboGold + t.openGold + t.finGold;\n  t.ended = true;\n  if (t.maxChain >= R.perfectChain) { t.die = d6(S); t.perfect = t.die >= t.perfectDie; }\n  t.gold = t.perfect ? Math.floor(sum * R.perfect) : sum;\n  if (S.choice === 'stage') t.gold *= R.stageDouble;\n  // 代演：金記在小鳳名下\n  if (S.choice === 'cover') S.fengGold += t.gold; else S.gold += t.gold;\n  if (S.choice === 'stage') { S.litAlone = true; S.phase = 'night'; } else S.phase = 'door';\n}\n\n// ── 門口 ──\nconst canWipe = S => S.phase === 'door' && !S.T.wiped && S.T.layers.length > 0 && S.scars <= R.wipeScarMax;\nfunction wipe(S) {\n  if (!canWipe(S)) return 0;\n  const t = S.T, n = Math.min(R.wipeLayers + (has(S, 'jin') ? 1 : 0), t.layers.length);\n  for (let i = 0; i < n; i++) S.chest.push({ day: S.day, f: t.layers.pop().f });\n  t.wiped = n;\n  t.homeCap = R.homeAfterWipe;\n  return n;\n}\nconst canClean = (S, id) => (S.phase === 'door' || S.phase === 'night') && S.T.layers.length > 0 && S.T.box.includes(id) && !S.T.used[id];\nfunction selfClean(S, id) {\n  if (!canClean(S, id)) return;\n  const t = S.T;\n  S.rope.push({ day: S.day, f: t.layers.pop().f });\n  t.used[id] = 'clean';\n}\n// 進門會染幾張：沒卸的層（每幕有上限）加上怨氣，最多就是今晚能推的張數\nconst dyeOf = S => Math.min(R.homeMax, Math.min(S.T.layers.length, R.dyeCap[actOf(S.day)]) + S.T.grudge);\nfunction enterHome(S) {\n  if (S.phase !== 'door') return;\n  const t = S.T;\n  t.dye = dyeOf(S);\n  if (S.day === 1) { autoEvening(S); return; }\n  if (seatEmpty(S)) { t.emptySeat = true; S.phase = 'night'; return; }\n  S.phase = 'evening';\n}\n\n// ── 傍晚 ──\n// 第 1 天傍晚與夜自動結算：她把燈糊了一點，說了這兩天的事；剩下的層用剩下的牌卸\nfunction autoEvening(S) {\n  const t = S.T;\n  t.auto = true;\n  S.lamp += 1; t.lampGain = 1;\n  S.phase = 'night';\n  forecast(S, 'wife');\n  t.box.filter(id => !t.used[id]).forEach(id => selfClean(S, id));\n}\n// 台上的字蓋住家裡面：底色 ≥2 是演得最多的一族，≥4 是兩族（第三幕）\nfunction coveredFams(S) {\n  if (actOf(S.day) !== 2 || S.base < R.overBase[0]) return [];\n  const order = Object.keys(S.played).sort((a, b) => S.played[b] - S.played[a]);\n  return order.slice(0, S.base >= R.overBase[1] ? 2 : 1);\n}\nconst willDye = (S, id) => S.T.pushed.length < S.T.dye || (!tOf(S, id).home && coveredFams(S).includes(fOf(S, id)));\nconst canHome = (S, id) => S.phase === 'evening' && !S.lit && S.choice !== 'lamp' && S.T.box.includes(id) && !S.T.used[id] && S.T.pushed.length < S.T.homeCap;\n// 對路：背面是她今晚要的任何一種樣子\nconst lookOfCard = (S, id) => HOME[FAM[fOf(S, id)].home].look;\nconst isMatch = (S, id) => !tOf(S, id).blank && !seatEmpty(S) && S.T.need.items.some(x => x.look === lookOfCard(S, id));\n// 這一種還缺幾張\nconst lack = (S, look) => { const it = S.T.need.items.find(x => x.look === look); return it ? Math.max(0, it.n - (S.T.got[look] || 0)) : 0; };\nfunction playHome(S, id) {\n  if (!canHome(S, id)) return null;\n  const t = S.T, tp = tOf(S, id), h = FAM[tp.f].home;\n  const dyed = willDye(S, id), match = isMatch(S, id);\n  const r = { id, h, blank: !!tp.blank, gift: !!tp.home, dyed, match: false, gain: 0, scar: 0, count: 0, name: tp.blank ? '空白' : tp.home ? tp.n : HOME[h].n };\n  if (dyed) {\n    r.scar = 1;\n    S.scars += r.scar; t.scarsToday += r.scar;\n    if (r.scar) S.scarLog.push({ day: S.day, h, blank: r.blank });\n  } else if (!tp.blank) {\n    r.match = match;\n    // 家常牌對上了算兩張，燈 +3\n    r.count = match ? (tp.home ? 2 : 1) : 0;\n    r.gain = match ? R.lampMatch + (tp.home ? 1 : 0) : R.lampPlain;\n    if (match) { const lk = lookOfCard(S, id); r.look = lk; t.got[lk] = (t.got[lk] || 0) + r.count; }\n    S.lamp += r.gain; t.lampGain += r.gain;\n    if (match) t.matched += 1;\n  }\n  t.pushed.push(id);\n  t.used[id] = 'home';\n  t.reacts.push(r);\n  return r;\n}\n// 吃完飯看她的需要：推夠了，這一段記一次；整段都對上，她送你一張家常牌。沒推夠，燈滅一截\nfunction judgeNeed(S) {\n  const t = S.T;\n  if (t.judged) return;\n  t.judged = true;\n  const nd = t.need;\n  t.met = nd.items.every(x => (t.got[x.look] || 0) >= x.n);\n  if (t.met) {\n    if (nd.spell >= 0) {\n      S.met[nd.spell] += 1;\n      const sp = SPELLS[nd.spell];\n      if (S.met[nd.spell] === sp.to - sp.from + 1) { const g = GIFT[LOOK_HOME[nd.look]]; addCard(S, g); S.gifts.push({ day: S.day, t: g }); t.gift = g; }\n    }\n  } else {\n    t.lampOut = Math.min(S.lamp, has(S, 'you') ? 1 : R.lampOut);\n    S.lamp -= t.lampOut;\n    S.outs += 1;\n  }\n  // 一段的最後一晚，她說起往後兩天的事\n  forecast(S, 'wife');\n}\n// 下一段需要從明天開始：她（或更夫）把兩晚各要什麼都說了，後兩天早上都看得到\nfunction forecast(S, how) {\n  const t = S.T, nx = S.day + 1, i = spellOf(nx);\n  if (nx >= R.days || i < 0 || i === t.need.spell) return;\n  const sp = SPELLS[i];\n  t.forecast = { spell: i, from: sp.from, to: sp.to, look: S.looks[i], nights: [] };\n  for (let d = sp.from; d <= sp.to; d++) { t.forecast.nights.push({ d, ...needOf(S, d) }); if (!S.known[d]) S.known[d] = how; }\n}\nfunction endEvening(S) {\n  if (S.phase !== 'evening' || S.choice === 'lamp') return;\n  judgeNeed(S);\n  // 痕到 4、或燈熄了 5 回：她走了，這一季到這裡為止（元宵那晚照常算結局）\n  if (S.day < R.days && broken(S)) { S.left = S.day; S.T.forecast = null; }\n  S.phase = 'night';\n}\n// 元宵回家點燈\nfunction lightLamp(S) {\n  if (S.phase !== 'evening' || S.choice !== 'lamp') return;\n  S.lit = true;\n  S.phase = 'night';\n}\n\n// ── 夜 ──\nfunction sleep(S) {\n  if (S.phase !== 'night') return;\n  const t = S.T;\n  // 座位空了、或沒回家：需要沒人接，燈也不糊；下一段的事由更夫說\n  if (!t.judged && !t.auto && t.emptySeat) { t.judged = true; forecast(S, 'watch'); }\n  t.nightBase = t.layers.length;\n  S.base += t.layers.length;\n  t.layers = [];\n  t.wasted = t.box.filter(id => !t.used[id]).length;\n  if (S.day === 7 || S.left) S.baseSeen = true;\n  t.watch = watchLine(S);\n  S.log.push({ day: S.day, cap: t.cap, starter: starterOf(S), stage: t.plays.length, maxChain: t.maxChain, die: t.die, perfect: t.perfect, gold: t.gold,\n    wiped: t.wiped, pushed: t.pushed.length, look: lookNow(S), need: t.need.k, pat: t.need.pat, got: Object.values(t.got).reduce((a, v) => a + v, 0), met: t.met, lampOut: t.lampOut, grudge: t.grudge, lampGain: t.lampGain,\n    scarsToday: t.scarsToday, matched: t.matched, nightBase: t.nightBase, seep: t.seep, wasted: t.wasted, emptySeat: t.emptySeat,\n    total: S.gold, purse: purseOf(S), lamp: S.lamp, scars: S.scars, base: S.base, watch: t.watch });\n  S.phase = 'watch';\n}\nfunction dawn(S) {\n  if (S.phase !== 'watch') return;\n  // 她走了，或演完最後一天：最後一次卸妝\n  if (S.day === R.days || S.left) { S.phase = 'lastwipe'; return; }\n  // 每幕末翻一次水牌，順便考核\n  if (S.day === 3 || S.day === 7) { S.phase = 'board'; return; }\n  S.day += 1;\n  beginDay(S);\n}\n// 幕末考核：名次到 R.exam[天] 就沒過\nconst examOf = (S, d = S.day) => (R.exam[d] ? { day: d, fail: R.exam[d], rank: rankOf(S, d), pass: rankOf(S, d) < R.exam[d] } : null);\n// 下一次考核在哪天、名次不能到幾\nconst nextExam = S => { const d = Object.keys(R.exam).map(Number).find(x => x >= S.day); return d ? { day: d, fail: R.exam[d] } : null; };\nfunction nextAct(S) {\n  if (S.phase !== 'board') return;\n  const ex = examOf(S);\n  if (ex && !ex.pass) { S.fired = S.day; S.phase = 'lastwipe'; return; }\n  S.day += 1;\n  beginDay(S);\n}\nfunction finishWipe(S) { if (S.phase === 'lastwipe') S.phase = 'reveal'; }\n\n// ── 水牌與結局 ──\n// 同門每天的金：底數上下浮動，事件那天乘上去；小鳳病的那幾天沒有，代演的金記在她名下\nfunction rivalDay(S, i, d) {\n  const r = RIVALS[i];\n  if (r.feng && d >= FENG_SICK[0] && d <= FENG_SICK[1]) return 0;\n  const ev = S.events[d] ? EVENTS[S.events[d]] : null;\n  const mul = ev && ev.rival === r.n ? ev.mul : 1;\n  return Math.round(r.g * (1 + r.v * (fixed(S, 300, i, d) * 2 - 1)) * mul);\n}\n// 水牌記到哪一天：早上和台上還沒散戲，看的是昨天的\nconst boardDay = S => (S.phase === 'morning' || (S.phase === 'stage' && !S.T.ended) ? S.day - 1 : S.day);\nfunction rivalGold(S, i, d = boardDay(S)) {\n  let g = 0;\n  for (let k = 1; k <= d; k++) g += rivalDay(S, i, k);\n  return g + (RIVALS[i].feng ? S.fengGold : 0);\n}\nfunction boardOf(S, d = boardDay(S)) {\n  const rows = RIVALS.map((r, i) => ({ n: r.n, g: rivalGold(S, i, d) }));\n  // 同分時對手在前\n  rows.sort((a, b) => b.g - a.g);\n  const i = rows.findIndex(r => S.gold > r.g);\n  rows.splice(i < 0 ? rows.length : i, 0, { n: S.name, g: S.gold, me: true });\n  return rows;\n}\nconst rankOf = (S, d) => boardOf(S, d).findIndex(r => r.me) + 1;\n// 美滿要的三樣：痕、熄、燈（元宵還要回家點燈）\nconst happyOK = S => S.scars <= R.happyScar && S.outs <= R.happyOuts && S.lamp >= R.happyLamp;\n// 破裂：痕到 4，或燈滅了五回\nconst broken = S => S.scars >= R.brokenScar || S.outs >= R.brokenOuts;\nfunction wifeOf(S) {\n  if (broken(S)) return 2;\n  // 提前摘牌：那時候還沒到元宵，痕少、燈幾乎沒熄過就算美滿\n  if (S.fired) return S.scars <= R.happyScar && S.outs <= R.happyOuts ? 0 : 1;\n  return happyOK(S) && S.choice === 'lamp' ? 0 : 1;\n}\n// 一季在哪天結束：她走的那天、摘牌那天，或第 10 天\nconst endDay = S => S.left || S.fired || R.days;\nfunction endingOf(S) {\n  const rank = rankOf(S, endDay(S));\n  return ENDING_N[S.fired || rank === R.ranks ? 2 : rank === 1 ? 0 : 1][wifeOf(S)];\n}\n\n// 更夫：只描述畫面；同一件事第三次起會變短\nconst LINES = {\n  listen: { at: '三更天', full: ['灯坊里，有人张了张嘴，又闭上了。'], short: '那张嘴又闭上了。' },\n  comp: { at: '三更天', full: ['饭桌上，两个人都在报账。'], short: '又在报账。' },\n  care: { at: '三更天', full: ['碗接过去了，放在一边，没动。'], short: '碗又没动。' },\n  labor: { at: '三更天', full: ['灯纸上多了一道口子。'], short: '灯纸又破了。' },\n  blank: { at: '三更天', full: ['有人把一张白牌推过桌子，她翻过来，看了很久。'], short: '又一张白牌。' },\n  out: { at: '二更天', full: ['灯坊的灯，熄了一截。', '有一盏灯，今夜没人添油。'], short: '灯又熄了一截。' },\n  seat: { at: '五更天', full: ['灯坊对面的椅子空着。'], short: '椅子还空着。' },\n  left: { at: '五更天', full: ['有户人家的门开着，一直没关。灯坊里的灯，没糊完。'] },\n  red: { at: '四更天', full: ['有人带着戏脸睡了，枕头一片红。'], short: '又带着戏脸睡了。' },\n  wiped: { at: '一更天', full: ['门口有人拧干了一条热毛巾。', '有人在门口替谁擦了脸。'], short: '毛巾又热了一回。' },\n  lamp: { at: '二更天', full: ['灯坊里，两个人糊完了一片纸。', '灯骨上多了一片红。'], short: '又多了一片红。' },\n  cold: { at: '二更天', full: ['有户人家的饭桌，摆了两副碗筷，凉了一副。'], short: '碗筷又凉了一副。' },\n  perfect: { at: '一更天', full: ['戏园门口，有人把手拍红了。'], short: '手又拍红了。' },\n  quiet: { at: '五更天', full: ['城里很静，有人睡得很沉。'] },\n};\n// 座位空了，她不再說往後的事：更夫多說一句，只說畫面，猜得到後兩天\nconst LOOK_HINT = {\n  等: '饭桌上已经多摆了一副碗筷。',\n  累: '灯坊的灯，今夜灭得比平时早。',\n  忙: '灯骨堆到了门边，纸还没裁。',\n  想说: '有人对着窗子，嘴动了动。',\n};\nfunction watchLine(S) {\n  const t = S.T, c = [], lastScar = t.reacts.filter(r => r.scar).pop();\n  if (S.left) c.push('left');\n  if (t.emptySeat) c.push('seat');\n  if (lastScar) c.push(lastScar.blank ? 'blank' : lastScar.h);\n  if (t.lampOut) c.push('out');\n  if (t.nightBase > 0) c.push('red');\n  if (t.matched > 0) c.push('lamp');\n  if (t.wiped > 0) c.push('wiped');\n  if (t.perfect) c.push('perfect');\n  if (!t.pushed.length && !t.auto && S.choice !== 'stage' && S.choice !== 'lamp') c.push('cold');\n  const cat = c[0] || 'quiet', def = LINES[cat];\n  const n = (S.lines[cat] = (S.lines[cat] || 0) + 1);\n  const tx = n >= 3 && def.short ? def.short : def.full[(n - 1) % def.full.length];\n  const hint = t.emptySeat && t.forecast ? LOOK_HINT[t.forecast.look] : '';\n  return { tx: `${def.at}，${tx}`, hint };\n}\n/* ENGINE END */\n\n// ── 小工具 ───────────────────────────────────────────\nconst $ = s => document.querySelector(s);\nconst esc = s => String(s).replace(/[&<>\"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[ch]));\nconst wait = ms => new Promise(r => setTimeout(r, ms));\nconst calm = () => matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n// ── v1.6 美術：從 原型/assets/ 載圖（打包的單檔從內嵌資料載）────────────\n// 載不到的圖、或瀏覽器不讓讀（file:// 直接開，畫進 canvas 會被擋），都退回 v1.5 的程式繪製，不會出現空白。\n// 圖檔一律不改：染色、紅紙邊、紙紋都在這裡做。阿檀、台上的你、鏡中的臉這一包沒有圖，沿用 v1.5 畫法。\nconst ART_DIR = '../assets/';\nconst ART = { on: false, blocked: false, img: {}, failed: [], tint: {}, box: {}, url: {}, ms: 0 };\nconst ART_FILES = (() => {\n  const f = [], two = n => String(n).padStart(2, '0');\n  Object.keys(T).forEach(k => f.push(`cards/art_${k}_line.png`, `cards/art_${k}_accent.png`));\n  Object.keys(HOME).forEach(h => f.push(`cards/art_home_${h}_line.png`, `cards/art_home_${h}_accent.png`));\n  for (let i = 1; i <= 4; i++) f.push(`cards/paper_${two(i)}.png`);\n  f.push('cards/border_stage.png', 'cards/border_home.png', 'cards/back.png');\n  for (let i = 1; i <= 16; i++) f.push(`crowd/a${two(i)}.png`);\n  for (let i = 1; i <= 8; i++) f.push(`crowd/b${two(i)}_idle.png`, `crowd/b${two(i)}_act.png`);\n  for (let i = 1; i <= 8; i++) f.push(`crowd/c${two(i)}.png`);\n  f.push('deco/shoujiu.png', 'deco/carpet.png', 'deco/lampaper.png', 'deco/chest_lid.png');\n  for (let i = 1; i <= 4; i++) f.push(`deco/chuanghua_${two(i)}.png`, `deco/lianpu_${two(i)}.png`);\n  RELIC_KEYS.forEach(k => f.push(`relics/${k}_line.png`, `relics/${k}_accent.png`));\n  ['paper_light', 'paper_dark', 'seal_square', 'seal_round', 'look_wait', 'look_tired', 'look_busy', 'look_talk', 'wick_on', 'wick_out', 'scar_mark', 'brush_underline'].forEach(n => f.push(`ui/${n}.png`));\n  ['paper_flakes', 'gold_leaf', 'ink_drops', 'paper_burnt', 'ribbon'].forEach(n => f.push(`fx/${n}.png`));\n  ['layer_1_far', 'layer_2_roofs', 'layer_3_near', 'moon'].forEach(n => f.push(`night/${n}.png`));\n  ['wei', 'jinbao', 'yuexian', 'yulou', 'xiaofeng'].forEach(n => f.push(`draft/rival_${n}.png`));\n  f.push('draft/sun_shifu.png');\n  return f;\n})();\nconst artSrc = p => (window.__ART && window.__ART[p]) || ART_DIR + p;\nconst artImg = p => (ART.on && ART.img[p]) || null;\nfunction artLoad(timeout = 9000) {\n  const t0 = performance.now();\n  const one = p => new Promise(res => {\n    const im = new Image();\n    im.onload = () => { ART.img[p] = im; res(); };\n    im.onerror = () => { ART.failed.push(p); res(); };\n    im.src = artSrc(p);\n  });\n  return Promise.race([Promise.all(ART_FILES.map(one)), wait(timeout)]).then(() => {\n    // 試畫一張：被瀏覽器擋住（file:// 開的不是打包版），整套退回 v1.5\n    const any = Object.values(ART.img)[0];\n    if (any) { try { const c = document.createElement('canvas'); c.width = c.height = 2; const x = c.getContext('2d'); x.drawImage(any, 0, 0, 2, 2); x.getImageData(0, 0, 1, 1); } catch (e) { ART.blocked = true; } }\n    ART.on = !ART.blocked && !!any;\n    ART.ms = Math.round(performance.now() - t0);\n    const n = Object.keys(ART.img).length;\n    if (ART.failed.length) console.warn(`[v16 ART] 载不到 ${ART.failed.length} 张，退回程序画法：${ART.failed.join('、')}`);\n    console.log(`[v16 ART] ${ART.on ? `载入 ${n}/${ART_FILES.length} 张，${ART.ms} ms${window.__ART ? '（内嵌）' : ''}` : ART.blocked ? '浏览器挡住了本机图（file://），全部退回 v1.5 画法' : '没有图，全部退回 v1.5 画法'}`);\n  });\n}\n// 單色圖染色：line 是純黑、accent 是朱紅，染成要的顏色；size 是長邊縮到幾像素（結果快取）\nfunction artTint(p, col, size = 0) {\n  const im = artImg(p);\n  if (!im) return null;\n  const k = `${p}|${col}|${size}`;\n  if (ART.tint[k]) return ART.tint[k];\n  const s = size ? size / Math.max(im.width, im.height) : 1, w = Math.round(im.width * s), h = Math.round(im.height * s);\n  const c = document.createElement('canvas'); c.width = w; c.height = h;\n  const x = c.getContext('2d'); x.imageSmoothingQuality = 'high'; x.drawImage(im, 0, 0, w, h);\n  x.globalCompositeOperation = 'source-in'; x.fillStyle = col; x.fillRect(0, 0, w, h);\n  return (ART.tint[k] = c);\n}\n// 圖裡有東西的那一塊（0–1），插圖按這一塊縮放置中，每張看起來一樣大\nfunction artBox(key, paths) {\n  if (ART.box[key]) return ART.box[key];\n  const N = 160, c = document.createElement('canvas'); c.width = c.height = N;\n  const x = c.getContext('2d');\n  paths.forEach(p => { const im = artImg(p); if (im) x.drawImage(im, 0, 0, N, N); });\n  const d = x.getImageData(0, 0, N, N).data;\n  let x0 = N, y0 = N, x1 = -1, y1 = -1;\n  for (let y = 0; y < N; y++) for (let X = 0; X < N; X++) if (d[(y * N + X) * 4 + 3] > 24) { if (X < x0) x0 = X; if (X > x1) x1 = X; if (y < y0) y0 = y; if (y > y1) y1 = y; }\n  return (ART.box[key] = x1 < 0 ? [0, 0, 1, 1] : [x0 / N, y0 / N, (x1 + 1) / N, (y1 + 1) / N]);\n}\n// 雙層插圖（卡面、物件）：line 染 lineCol、accent 染 accCol，主體縮進 (X, Y, W, H) 置中\nfunction drawDuo(x, base, X, Y, W, H, lineCol, accCol, res = 512) {\n  const L = `${base}_line.png`, A = `${base}_accent.png`;\n  if (!artImg(L)) return false;\n  const b = artBox(base, [L, A]), bw = b[2] - b[0], bh = b[3] - b[1], s = Math.min(W / bw, H / bh);\n  const ox = X + W / 2 - (b[0] + bw / 2) * s, oy = Y + H / 2 - (b[1] + bh / 2) * s;\n  x.drawImage(artTint(L, lineCol, res), ox, oy, s, s);\n  if (artImg(A)) x.drawImage(artTint(A, accCol, res), ox, oy, s, s);\n  return true;\n}\n// 卡紙：50% 灰的紙紋用「疊加」蓋在整張卡上，依牌輪換四張\nfunction paperOver(x, t, alpha = 1) {\n  const p = artImg(`cards/paper_0${1 + (hash(t) % 4)}.png`);\n  if (!p) return false;\n  x.save(); rr(x, 0, 0, CW, CH, 16); x.clip();\n  x.globalCompositeOperation = 'overlay'; x.globalAlpha = alpha; x.drawImage(p, 0, 0, CW, CH);\n  x.restore();\n  return true;\n}\n// 邊框：純黑紋樣染成要的顏色；位置與 v1.5 的缺角框一樣（邊距 14）\nfunction borderArt(x, which, col) {\n  const p = `cards/border_${which}.png`;\n  if (!artImg(p)) return false;\n  x.drawImage(artTint(p, col), 0, 0, CW, CH);\n  return true;\n}\n// 卡面插圖的點題色：紅底的唱族牌上朱紅看不見，改用深一截的胭脂\nconst accentOn = f => (f === 'sing' ? '#4e0a10' : '#a8202b');\n// 圖到齊之後：界面用到的圖掛成 CSS 變數，<html> 加上 .art（樣式表裡 html.art 開頭的規則才生效）\nfunction artSetup() {\n  if (!ART.on) return;\n  const r = document.documentElement;\n  // 一樣界面要的圖都在，才掛上那一樣的 class；缺一張，那一樣就維持 v1.5 的畫法\n  const feat = (cls, vars) => {\n    if (!Object.values(vars).every(p => artImg(p))) return false;\n    Object.entries(vars).forEach(([k, p]) => r.style.setProperty(k, `url(\"${artSrc(p)}\")`));\n    r.classList.add(cls);\n    return true;\n  };\n  feat('a-paper', { '--ui-paper': 'ui/paper_light.png' });\n  feat('a-paperdk', { '--ui-paper-dk': 'ui/paper_dark.png' });\n  feat('a-brush', { '--ui-brush': 'ui/brush_underline.png' });\n  feat('a-seal', { '--ui-seal': 'ui/seal_square.png' });\n  feat('a-sealr', { '--ui-seal-r': 'ui/seal_round.png' });\n  feat('a-scar', { '--ui-scar': 'ui/scar_mark.png' });\n  feat('a-gold', { '--fx-gold': 'fx/gold_leaf.png' });\n  // 燈芯：淺色紙上用原圖（墨黑燈芯、朱紅火苗）；深色框裡把墨黑換成紙色\n  if (feat('a-wick', { '--ui-wick': 'ui/wick_on.png', '--ui-wick-out': 'ui/wick_out.png' })) {\n    r.style.setProperty('--ui-wick-l', `url(\"${artRecolorURL('ui/wick_on.png', [236, 227, 212])}\")`);\n    r.style.setProperty('--ui-wick-out-l', `url(\"${artRecolorURL('ui/wick_out.png', [190, 180, 170])}\")`);\n  }\n  if (['layer_1_far', 'layer_2_roofs', 'layer_3_near', 'moon'].every(n => artImg(`night/${n}.png`))) r.classList.add('a-night');\n  // 她的樣子：四張剪影小圖，染成紙色（都擺在深色底上）\n  Object.entries(LOOK_ART).forEach(([look, n]) => { const u = artIconURL(`ui/${n}.png`, '#ece3d4', 96); if (u) LOOK_ICON[look] = `<img class=\"lki\" src=\"${u}\" alt=\"\">`; });\n  r.classList.add('art');\n}\nconst LOOK_ART = { 等: 'look_wait', 累: 'look_tired', 忙: 'look_busy', 想说: 'look_talk' };\n// 染好色的小圖做成 dataURL（界面 <img> 用）\nfunction artTintURL(p, col, size) {\n  const k = `t|${p}|${col}|${size}`;\n  if (ART.url[k] !== undefined) return ART.url[k];\n  const c = artTint(p, col, size);\n  return (ART.url[k] = c ? c.toDataURL() : '');\n}\n// 小圖示：按圖裡有東西的那一塊裁成正方（四張大小一致），染色\nfunction artIconURL(p, col, size) {\n  const k = `i|${p}|${col}|${size}`;\n  if (ART.url[k] !== undefined) return ART.url[k];\n  const im = artImg(p);\n  if (!im) return (ART.url[k] = '');\n  const b = artBox(p, [p]), bw = b[2] - b[0], bh = b[3] - b[1], sc = size * 0.94 / Math.max(bw, bh);\n  const c = document.createElement('canvas'); c.width = c.height = size;\n  c.getContext('2d').drawImage(artTint(p, col, 512), size / 2 - (b[0] + bw / 2) * sc, size / 2 - (b[1] + bh / 2) * sc, sc, sc);\n  return (ART.url[k] = c.toDataURL());\n}\n// 只把墨黑的部分換成別的顏色（燈芯放在深色框裡用），朱紅的火苗不動\nfunction artRecolorURL(p, rgb) {\n  const k = `r|${p}|${rgb}`;\n  if (ART.url[k] !== undefined) return ART.url[k];\n  const im = artImg(p);\n  if (!im) return (ART.url[k] = '');\n  const c = document.createElement('canvas'); c.width = im.width; c.height = im.height;\n  const x = c.getContext('2d'); x.drawImage(im, 0, 0);\n  const d = x.getImageData(0, 0, c.width, c.height);\n  for (let i = 0; i < d.data.length; i += 4) if (d.data[i] + d.data[i + 1] + d.data[i + 2] < 240) { d.data[i] = rgb[0]; d.data[i + 1] = rgb[1]; d.data[i + 2] = rgb[2]; }\n  x.putImageData(d, 0, 0);\n  return (ART.url[k] = c.toDataURL());\n}\n// 後台物件的圖示：line 染 line 色、accent 染 acc 色，畫進 size 見方\nfunction relicIcon(k, size = 96, line = '#1c1719', acc = '#a8202b') {\n  const key = `rel|${k}|${size}|${line}|${acc}`;\n  if (ART.url[key] !== undefined) return ART.url[key];\n  if (!artImg(`relics/${k}_line.png`)) return (ART.url[key] = '');\n  const c = document.createElement('canvas'); c.width = c.height = size;\n  drawDuo(c.getContext('2d'), `relics/${k}`, 0, 0, size, size, line, acc, Math.max(128, size * 2));\n  return (ART.url[key] = c.toDataURL());\n}\n// 同門與孫師父的木刻像（草稿）：水牌上用頭像，字幕、後台用整張\nconst DRAFT = { 魏老板: ['rival_wei', 282, 190], 金宝: ['rival_jinbao', 300, 215], 月仙: ['rival_yuexian', 285, 245], 玉楼: ['rival_yulou', 278, 255], 小凤: ['rival_xiaofeng', 290, 265], 孙师父: ['sun_shifu', 262, 190] };\nconst portraitURL = name => (DRAFT[name] && artImg(`draft/${DRAFT[name][0]}.png`) ? artSrc(`draft/${DRAFT[name][0]}.png`) : '');\nfunction faceURL(name, size = 64) {\n  const d = DRAFT[name], im = d && artImg(`draft/${d[0]}.png`);\n  if (!im) return '';\n  const k = `face|${name}|${size}`;\n  if (ART.url[k] !== undefined) return ART.url[k];\n  const side = 370, sx = clamp(d[1] - side / 2, 0, im.width - side), sy = clamp(d[2] - side / 2, 0, im.height - side);\n  const c = document.createElement('canvas'); c.width = c.height = size;\n  const x = c.getContext('2d'); x.imageSmoothingQuality = 'high'; x.drawImage(im, sx, sy, side, side, 0, 0, size, size);\n  return (ART.url[k] = c.toDataURL());\n}\nconst faceTag = (name, cls = 'av') => { const u = faceURL(name); return u ? `<img class=\"${cls}\" src=\"${u}\" alt=\"\">` : ''; };\nfunction rng(a) {\n  return () => { a |= 0; a = (a + 0x6D2B79F5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };\n}\nconst hash = s => { let h = 2166136261; for (const ch of s) { h ^= ch.codePointAt(0); h = Math.imul(h, 16777619); } return h >>> 0; };\nconst hexRgb = h => { const n = parseInt(h.slice(1), 16); return `${n >> 16},${(n >> 8) & 255},${n & 255}`; };\nconst pick = a => a[Math.floor(Math.random() * a.length)];\n// 台上臉、布的顏色：唱紅、念墨、做土、打金\nconst FCOL = { sing: '#a8243a', speak: '#2b2427', act: '#8f6338', fight: '#b8913f' };\nconst SKIN = 0xf2e8de;\n\n// ── 卡面（2D，畫在 canvas 上；手牌和 3D 桌上的牌用同一張）────────\nconst CW = 300, CH = 450;\nfunction rr(x, X, Y, w, h, r) { x.beginPath(); x.moveTo(X + r, Y); x.arcTo(X + w, Y, X + w, Y + h, r); x.arcTo(X + w, Y + h, X, Y + h, r); x.arcTo(X, Y + h, X, Y, r); x.arcTo(X, Y, X + w, Y, r); x.closePath(); }\n// 塔羅式缺角框\nfunction notch(x, X, Y, w, h, r) {\n  x.beginPath(); x.moveTo(X + r, Y); x.lineTo(X + w - r, Y); x.arc(X + w, Y, r, Math.PI, Math.PI / 2, true);\n  x.lineTo(X + w, Y + h - r); x.arc(X + w, Y + h, r, Math.PI * 1.5, Math.PI, true);\n  x.lineTo(X + r, Y + h); x.arc(X, Y + h, r, 0, -Math.PI / 2, true);\n  x.lineTo(X, Y + r); x.arc(X, Y, r, Math.PI / 2, 0, true); x.closePath();\n}\nfunction bez(x, p) { x.beginPath(); x.moveTo(p[0][0], p[0][1]); x.bezierCurveTo(p[1][0], p[1][1], p[2][0], p[2][1], p[3][0], p[3][1]); x.stroke(); }\nfunction wrapText(x, text, X, Y, maxW, lh) {\n  let line = '', y = Y;\n  for (const ch of text) {\n    if (x.measureText(line + ch).width > maxW && line) { x.fillText(line, X, y); line = ch; y += lh; } else line += ch;\n  }\n  if (line) x.fillText(line, X, y);\n  return y;\n}\nfunction tassel(x, X, Y, len, col) {\n  x.strokeStyle = col; x.lineWidth = 1.6;\n  for (let i = -2; i <= 2; i++) { x.beginPath(); x.moveTo(X, Y); x.quadraticCurveTo(X + i * 2, Y + len * 0.5, X + i * 3.5, Y + len); x.stroke(); }\n  x.fillStyle = col; x.beginPath(); x.arc(X, Y, 3.5, 0, Math.PI * 2); x.fill();\n}\n// 木刻風的主圖：墨填滿，再用卡底色刻出白線\nconst EMBLEM = {\n  sing(x, cx, cy, s, P) { // 摺扇與聲紋\n    x.strokeStyle = P.line; x.lineWidth = 3;\n    for (let i = 0; i < 3; i++) { x.beginPath(); x.arc(cx, cy + s * 0.5, s * (1.08 + i * 0.15), Math.PI * 1.22, Math.PI * 1.78); x.stroke(); }\n    const px = cx, py = cy + s * 0.55, R = s * 0.98, a0 = Math.PI * 1.13, a1 = Math.PI * 1.87;\n    x.fillStyle = P.line; x.beginPath(); x.moveTo(px, py); x.arc(px, py, R, a0, a1); x.closePath(); x.fill();\n    x.strokeStyle = P.carve; x.lineWidth = 2;\n    for (let i = 0; i <= 12; i++) { const a = a0 + (a1 - a0) * i / 12; x.beginPath(); x.moveTo(px + Math.cos(a) * R * 0.28, py + Math.sin(a) * R * 0.28); x.lineTo(px + Math.cos(a) * R * 0.95, py + Math.sin(a) * R * 0.95); x.stroke(); }\n    x.lineWidth = 3; x.beginPath(); x.arc(px, py, R * 0.6, a0 + 0.06, a1 - 0.06); x.stroke();\n    x.lineWidth = 1.5; x.beginPath(); x.arc(px, py, R * 0.86, a0 + 0.04, a1 - 0.04); x.stroke();\n    // 扇面上的雲紋\n    for (let i = 0; i < 3; i++) { const a = a0 + (a1 - a0) * (0.25 + i * 0.25), r0 = R * 0.73; x.beginPath(); x.arc(px + Math.cos(a) * r0, py + Math.sin(a) * r0, 6, 0, Math.PI * 1.6); x.stroke(); }\n    x.fillStyle = P.carve; x.beginPath(); x.arc(px, py, 6, 0, Math.PI * 2); x.fill();\n    tassel(x, px, py + 6, 42, P.carve);\n  },\n  speak(x, cx, cy, s, P) { // 卷軸與醒木\n    const w = s * 0.92, h = s * 1.45, r = rng(5);\n    x.fillStyle = P.carve; x.fillRect(cx - w / 2, cy - h / 2, w, h);\n    x.strokeStyle = P.line; x.lineWidth = 1.5; x.strokeRect(cx - w / 2 + 6, cy - h / 2 + 8, w - 12, h - 16);\n    x.lineCap = 'round';\n    for (let i = 0; i < 4; i++) {\n      const lx = cx + w * 0.3 - i * w * 0.2;\n      for (let j = 0; j < 6; j++) { const y0 = cy - h / 2 + 20 + j * (h - 40) / 6; x.lineWidth = 3 + r() * 2; x.beginPath(); x.moveTo(lx + (r() - 0.5) * 3, y0); x.lineTo(lx + (r() - 0.5) * 3, y0 + 8 + r() * 8); x.stroke(); }\n    }\n    x.fillStyle = P.line; x.fillRect(cx - w / 2 - 12, cy - h / 2 - 12, w + 24, 13); x.fillRect(cx - w / 2 - 12, cy + h / 2 - 1, w + 24, 13);\n    [[-1, -1], [1, -1], [-1, 1], [1, 1]].forEach(([a, b]) => { x.beginPath(); x.arc(cx + a * (w / 2 + 14), cy + b * (h / 2 + 5.5), 7, 0, Math.PI * 2); x.fill(); });\n    x.fillStyle = '#a8202b'; x.fillRect(cx - w / 2 + 12, cy + h / 2 - 34, 18, 18);\n  },\n  act(x, cx, cy, s, P) { // 水袖\n    const band = (p, w) => { x.lineCap = 'round'; x.strokeStyle = P.line; x.lineWidth = w; bez(x, p); x.strokeStyle = P.carve; x.lineWidth = w * 0.5; bez(x, p); x.strokeStyle = P.line; x.lineWidth = 1.6; bez(x, p); };\n    band([[cx - s * 0.6, cy + s * 0.85], [cx - s * 1.05, cy - s * 0.1], [cx + s * 0.75, cy + s * 0.2], [cx + s * 0.25, cy - s * 0.95]], 24);\n    band([[cx + s * 0.62, cy + s * 0.9], [cx + s * 1.05, cy - s * 0.05], [cx - s * 0.6, cy - s * 0.05], [cx - s * 0.3, cy - s * 0.9]], 17);\n    x.fillStyle = P.line; x.beginPath(); x.ellipse(cx, cy + s * 0.95, s * 0.7, s * 0.16, 0, 0, Math.PI * 2); x.fill();\n    x.strokeStyle = P.carve; x.lineWidth = 2; x.beginPath(); x.ellipse(cx, cy + s * 0.95, s * 0.55, s * 0.08, 0, 0, Math.PI * 2); x.stroke();\n  },\n  fight(x, cx, cy, s, P) { // 靠旗與雙槍\n    x.fillStyle = P.line; x.beginPath(); x.moveTo(cx, cy - s * 0.95); x.lineTo(cx - s * 0.58, cy + s * 0.15); x.lineTo(cx + s * 0.58, cy + s * 0.15); x.closePath(); x.fill();\n    x.strokeStyle = P.carve; x.lineWidth = 2; x.beginPath(); x.moveTo(cx, cy - s * 0.78); x.lineTo(cx - s * 0.44, cy + s * 0.06); x.lineTo(cx + s * 0.44, cy + s * 0.06); x.closePath(); x.stroke();\n    for (let i = 0; i < 4; i++) { x.beginPath(); x.arc(cx, cy - s * 0.18 + i * 0.0, 6 + i * 6, Math.PI * 1.1, Math.PI * 1.9); x.stroke(); }\n    const spear = (x0, y0, x1, y1) => {\n      x.strokeStyle = P.line; x.lineWidth = 7; x.lineCap = 'round'; x.beginPath(); x.moveTo(x0, y0); x.lineTo(x1, y1); x.stroke();\n      x.strokeStyle = P.carve; x.lineWidth = 1.6; x.beginPath(); x.moveTo(x0, y0); x.lineTo(x1, y1); x.stroke();\n      const a = Math.atan2(y1 - y0, x1 - x0), L = s * 0.32;\n      x.fillStyle = P.line; x.beginPath(); x.moveTo(x1 + Math.cos(a) * L, y1 + Math.sin(a) * L); x.lineTo(x1 + Math.cos(a + 1.9) * 12, y1 + Math.sin(a + 1.9) * 12); x.lineTo(x1 + Math.cos(a - 1.9) * 12, y1 + Math.sin(a - 1.9) * 12); x.closePath(); x.fill();\n      tassel(x, x1 - Math.cos(a) * 6, y1 - Math.sin(a) * 6, 26, P.carve);\n    };\n    spear(cx - s * 0.9, cy + s * 1.0, cx + s * 0.62, cy - s * 0.72);\n    spear(cx + s * 0.9, cy + s * 1.0, cx - s * 0.62, cy - s * 0.72);\n  },\n  care(x, cx, cy, s, P) { // 一碗熱湯\n    x.strokeStyle = P.line; x.lineWidth = 3; x.lineCap = 'round';\n    for (let i = -1; i <= 1; i++) bez(x, [[cx + i * s * 0.3, cy - s * 0.15], [cx + i * s * 0.3 - 14, cy - s * 0.45], [cx + i * s * 0.3 + 14, cy - s * 0.6], [cx + i * s * 0.3, cy - s * 0.95]]);\n    x.fillStyle = P.line; x.beginPath(); x.moveTo(cx - s * 0.9, cy); x.bezierCurveTo(cx - s * 0.85, cy + s * 0.75, cx + s * 0.85, cy + s * 0.75, cx + s * 0.9, cy); x.closePath(); x.fill();\n    x.fillRect(cx - s * 0.32, cy + s * 0.58, s * 0.64, s * 0.14);\n    x.fillStyle = P.carve; x.beginPath(); x.ellipse(cx, cy, s * 0.9, s * 0.17, 0, 0, Math.PI * 2); x.fill();\n    x.strokeStyle = P.line; x.lineWidth = 2.5; x.stroke();\n    x.fillStyle = 'rgba(120,70,40,.5)'; x.beginPath(); x.ellipse(cx, cy + 2, s * 0.72, s * 0.1, 0, 0, Math.PI * 2); x.fill();\n    x.strokeStyle = P.carve; x.lineWidth = 2;\n    for (let i = 0; i < 5; i++) { x.beginPath(); x.arc(cx - s * 0.5 + i * s * 0.25, cy + s * 0.32, 7, Math.PI, 0); x.stroke(); }\n  },\n  comp(x, cx, cy, s, P) { // 一根竹竿挑兩盞燈\n    x.strokeStyle = P.line; x.lineWidth = 4; x.beginPath(); x.moveTo(cx - s, cy - s * 0.85); x.lineTo(cx + s, cy - s * 0.95); x.stroke();\n    [-0.45, 0.45].forEach((d, i) => {\n      const lx = cx + d * s, ly = cy + s * 0.05 + i * 6;\n      x.lineWidth = 1.5; x.beginPath(); x.moveTo(lx, cy - s * 0.88 - i * 4); x.lineTo(lx, ly - s * 0.52); x.stroke();\n      x.fillStyle = P.line; x.fillRect(lx - 14, ly - s * 0.56, 28, 9); x.fillRect(lx - 14, ly + s * 0.47, 28, 9);\n      x.fillStyle = '#a8202b'; x.beginPath(); x.ellipse(lx, ly, s * 0.36, s * 0.5, 0, 0, Math.PI * 2); x.fill();\n      x.strokeStyle = P.line; x.lineWidth = 2.5; x.stroke();\n      x.lineWidth = 1.4; for (let k = -2; k <= 2; k++) { x.beginPath(); x.ellipse(lx, ly, Math.abs(k) * s * 0.09 + 0.5, s * 0.5, 0, 0, Math.PI * 2); x.stroke(); }\n      tassel(x, lx, ly + s * 0.56, 26, P.line);\n    });\n  },\n  listen(x, cx, cy, s, P) { // 月下靜水\n    x.fillStyle = P.line; x.beginPath(); x.arc(cx, cy - s * 0.35, s * 0.55, 0, Math.PI * 2); x.fill();\n    x.fillStyle = P.base; x.beginPath(); x.arc(cx + s * 0.22, cy - s * 0.48, s * 0.5, 0, Math.PI * 2); x.fill();\n    x.strokeStyle = P.line;\n    for (let i = 0; i < 4; i++) { x.lineWidth = 3 - i * 0.5; x.beginPath(); x.ellipse(cx, cy + s * 0.62, s * (0.25 + i * 0.22), s * (0.06 + i * 0.05), 0, 0, Math.PI * 2); x.stroke(); }\n    x.fillStyle = '#a8202b'; x.beginPath(); x.arc(cx - s * 0.75, cy + s * 0.15, 5, 0, Math.PI * 2); x.fill();\n  },\n  labor(x, cx, cy, s, P) { // 燈骨與竹篾\n    x.strokeStyle = P.line; x.lineWidth = 3.5;\n    x.beginPath(); x.ellipse(cx, cy, s * 0.62, s * 0.85, 0, 0, Math.PI * 2); x.stroke();\n    x.lineWidth = 2; for (let k = 1; k <= 3; k++) { x.beginPath(); x.ellipse(cx, cy, s * 0.62 * (1 - k * 0.27), s * 0.85, 0, 0, Math.PI * 2); x.stroke(); }\n    [-0.5, 0, 0.5].forEach(d => { x.beginPath(); x.ellipse(cx, cy + d * s * 0.85, s * 0.62 * Math.sqrt(1 - d * d), s * 0.08, 0, 0, Math.PI * 2); x.stroke(); });\n    x.fillStyle = '#a8202b'; x.globalAlpha = 0.85; x.beginPath(); x.moveTo(cx, cy - s * 0.85); x.bezierCurveTo(cx + s * 0.5, cy - s * 0.7, cx + s * 0.62, cy - s * 0.2, cx + s * 0.6, cy + s * 0.05); x.lineTo(cx, cy + s * 0.05); x.closePath(); x.fill(); x.globalAlpha = 1;\n    x.fillStyle = P.line; x.fillRect(cx - 16, cy - s * 0.98, 32, 10); x.fillRect(cx - 16, cy + s * 0.86, 32, 10);\n  },\n};\n// 小卡只放四樣：族色、牌名與金、「接 → X」、背面牌名。字要在手牌這個大小就讀得清\nfunction clothLines(x, line, r) {\n  x.globalAlpha = 0.07; x.strokeStyle = line; x.lineWidth = 0.6;\n  for (let i = 0; i < CH; i += 3) { x.beginPath(); x.moveTo(0, i + r()); x.lineTo(CW, i + r()); x.stroke(); }\n  for (let i = 0; i < CW; i += 3) { x.beginPath(); x.moveTo(i + r(), 0); x.lineTo(i + r(), CH); x.stroke(); }\n  x.globalAlpha = 1;\n}\nfunction chip(x, cx, cy, rad, f, fg) {\n  x.fillStyle = FCOL[f]; x.beginPath(); x.arc(cx, cy, rad, 0, Math.PI * 2); x.fill();\n  x.strokeStyle = fg; x.lineWidth = 2.5; x.stroke();\n  x.fillStyle = f === 'fight' ? '#1c1719' : '#f4ecdc'; x.font = `${Math.round(rad * 1.3)}px \"Ma Shan Zheng\", serif`; x.textAlign = 'center'; x.textBaseline = 'middle';\n  x.fillText(FAM[f].n, cx, cy + 2);\n}\n// 家常牌的正面：不上台，只寫背面是什麼\nfunction drawGiftFace(x, t) {\n  const tp = T[t], h = FAM[tp.f].home, r = rng(hash(t + 'g'));\n  const paper = !!artImg(`cards/paper_0${1 + (hash(t) % 4)}.png`);\n  rr(x, 0, 0, CW, CH, 16); x.fillStyle = '#d9cdb8'; x.fill();\n  if (!paper) { x.save(); rr(x, 0, 0, CW, CH, 16); x.clip(); clothLines(x, '#4a3f3a', r); x.restore(); }\n  if (!borderArt(x, 'home', '#a8202b')) { x.strokeStyle = '#a8202b'; x.lineWidth = 4; notch(x, 14, 14, CW - 28, CH - 28, 20); x.stroke(); }\n  // v1.6：家常牌的插圖（熱湯、同桌、舊信、剪紙）印在牌名和「不上台」之間\n  if (!drawDuo(x, `cards/art_${t}`, 60, 194, 180, 112, '#1c1719', '#a8202b')) { x.globalAlpha = 0.3; EMBLEM[h](x, CW / 2 - 4, 240, 52, { base: '#d9cdb8', line: '#1c1719', carve: '#d9cdb8', hi: '#a8202b' }); x.globalAlpha = 1; }\n  x.fillStyle = '#1c1719'; x.textAlign = 'center'; x.textBaseline = 'alphabetic';\n  x.font = '30px \"Noto Serif SC\", serif'; x.fillText('家常', CW / 2, 76);\n  x.font = '86px \"Ma Shan Zheng\", serif'; x.fillText(tp.n, CW / 2, 178);\n  x.fillStyle = '#a8202b'; x.font = '34px \"Ma Shan Zheng\", serif'; x.fillText('不上台', CW / 2, 340);\n  x.fillStyle = 'rgba(28,23,25,.82)'; x.fillRect(28, 374, CW - 56, 46);\n  x.fillStyle = '#f4ecdc'; x.font = '32px \"Ma Shan Zheng\", serif'; x.textBaseline = 'middle'; x.fillText(`背 ${HOME[h].n}`, CW / 2, 398);\n  paperOver(x, t);\n}\nconst kwOf = tp => (tp.wild ? '百搭' : tp.heavy ? '重彩' : tp.fin ? `压轴+${tp.fin}` : tp.clean ? '素·不上妆' : tp.boost ? '托·连击×2' : '');\n// 這張牌後面接哪一族；百搭後面什麼都接得上\nconst nextN = tp => (tp.wild ? '任意' : FAM[tp.next].n);\nfunction drawStageFace(x, t) {\n  if (T[t].home) { drawGiftFace(x, t); return; }\n  const tp = T[t], f = tp.f, r = rng(hash(t)), fg = f === 'fight' ? '#1c1719' : '#f4ecdc', P = { base: FCOL[f], line: f === 'speak' ? '#0d0a0b' : '#1c1416', carve: '#efe2c8', hi: fg };\n  const paper = !!artImg(`cards/paper_0${1 + (hash(t) % 4)}.png`);\n  rr(x, 0, 0, CW, CH, 16); x.fillStyle = FCOL[f]; x.fill();\n  x.save(); rr(x, 0, 0, CW, CH, 16); x.clip();\n  // v1.6：有紙紋就不畫布紋；四周壓暗也減輕，像印在紙上\n  if (!paper) clothLines(x, fg, r);\n  const vg = x.createRadialGradient(CW / 2, CH / 2, CH * 0.25, CW / 2, CH / 2, CH * 0.72); vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, `rgba(10,3,5,${paper ? 0.24 : 0.45})`); x.fillStyle = vg; x.fillRect(0, 0, CW, CH);\n  x.restore();\n  // 借來的牌：金邊\n  if (!borderArt(x, 'stage', tp.blank ? '#f2d48a' : fg)) { x.strokeStyle = tp.blank ? '#f2d48a' : fg; x.lineWidth = tp.blank ? 6 : 2.5; notch(x, 14, 14, CW - 28, CH - 28, 20); x.stroke(); }\n  // v1.6：插圖印在牌名底下、「接 →」上面；有關鍵詞或「借」字時往下讓\n  const ib = kwOf(tp) ? [44, 231, 212, 64] : tp.blank ? [44, 221, 212, 72] : [40, 190, 220, 102];\n  if (!drawDuo(x, `cards/art_${t}`, ...ib, fg, accentOn(f))) { x.globalAlpha = 0.34; EMBLEM[f](x, CW / 2 - 4, 232, 46, P); x.globalAlpha = 1; }\n  // 族與金\n  chip(x, 62, 64, 32, f, fg);\n  x.fillStyle = fg; x.font = '30px \"Ma Shan Zheng\", serif'; x.textAlign = 'right'; x.textBaseline = 'alphabetic'; x.fillText('金', CW - 76, 80);\n  x.font = '66px \"Ma Shan Zheng\", serif'; x.textAlign = 'left'; x.fillText(String(tp.g), CW - 72, 88);\n  // 牌名\n  x.textAlign = 'center'; x.font = `${tp.n.length > 1 ? 74 : 96}px \"Ma Shan Zheng\", serif`; x.fillText(tp.n, CW / 2, 182);\n  if (tp.blank) { x.font = '28px \"Noto Serif SC\", serif'; x.fillText('借', CW / 2, 216); }\n  // 後台的牌：一個詞說它強在哪\n  if (kwOf(tp)) {\n    x.font = '30px \"Ma Shan Zheng\", serif'; const kw = kwOf(tp), w = x.measureText(kw).width + 26;\n    x.fillStyle = f === 'fight' ? '#1c1719' : '#f2d48a'; x.fillRect(CW / 2 - w / 2, 196, w, 36);\n    x.fillStyle = f === 'fight' ? '#f2d48a' : '#1c1719'; x.textBaseline = 'middle'; x.fillText(kw, CW / 2, 215); x.textBaseline = 'alphabetic';\n  }\n  // 接 → X\n  x.font = '44px \"Ma Shan Zheng\", serif'; x.textAlign = 'left'; x.fillText('接', 56, 340);\n  x.lineWidth = 5; x.strokeStyle = fg; x.beginPath(); x.moveTo(108, 325); x.lineTo(170, 325); x.lineTo(156, 313); x.moveTo(170, 325); x.lineTo(156, 337); x.stroke();\n  if (tp.wild) { x.font = '40px \"Ma Shan Zheng\", serif'; x.textAlign = 'center'; x.fillText('任意', 222, 340); } else chip(x, 214, 324, 36, tp.next, fg);\n  // 背面牌名\n  x.fillStyle = 'rgba(12,8,10,.5)'; x.fillRect(28, 374, CW - 56, 46);\n  x.fillStyle = '#f4ecdc'; x.font = '32px \"Ma Shan Zheng\", serif'; x.textAlign = 'center'; x.textBaseline = 'middle';\n  x.fillText(tp.blank ? '背 空白' : `背 ${HOME[FAM[f].home].n}`, CW / 2, 398);\n  paperOver(x, t);\n}\nfunction drawHomeFace(x, t, over) {\n  const tp = T[t], f = tp.f, h = FAM[f].home, r = rng(hash(t + 'h')), line = '#1c1719', P = { base: '#ebe2d3', line, carve: '#ebe2d3', hi: '#a8202b' };\n  const paper = !!artImg(`cards/paper_0${1 + (hash(t + 'h') % 4)}.png`);\n  rr(x, 0, 0, CW, CH, 16); x.fillStyle = tp.blank ? '#f4f0e8' : '#ebe2d3'; x.fill();\n  x.save(); rr(x, 0, 0, CW, CH, 16); x.clip();\n  if (!paper) clothLines(x, line, r);\n  if (!tp.blank) for (let i = 0; i < 6; i++) { const X = r() * CW, Y = r() * CH, Rd = 60 + r() * 120, g = x.createRadialGradient(X, Y, 0, X, Y, Rd); g.addColorStop(0, `rgba(60,52,54,${(0.05 + r() * 0.12) * (paper ? 0.5 : 1)})`); g.addColorStop(1, 'rgba(60,52,54,0)'); x.fillStyle = g; x.fillRect(0, 0, CW, CH); }\n  x.restore();\n  if (!borderArt(x, 'home', line)) { x.strokeStyle = line; x.lineWidth = 2.5; notch(x, 14, 14, CW - 28, CH - 28, 20); x.stroke(); }\n  x.fillStyle = line; x.textAlign = 'center'; x.textBaseline = 'alphabetic';\n  if (tp.blank) {\n    // 借來的牌：家裡面是空白，不貼插圖\n    x.globalAlpha = 0.25; x.font = '74px \"Ma Shan Zheng\", serif'; x.fillText('空白', CW / 2, 190); x.globalAlpha = 1;\n    x.font = '38px \"Ma Shan Zheng\", serif'; x.fillText('灯不涨', CW / 2, 340);\n  } else {\n    x.font = '74px \"Ma Shan Zheng\", serif'; x.fillText(HOME[h].n, CW / 2, 112);\n    // v1.6：家裡面的插圖（倾听、陪伴、照顾、共劳）；家常牌用它自己的那一張\n    if (!drawDuo(x, tp.home ? `cards/art_${t}` : `cards/art_home_${h}`, 44, 130, 212, 170, line, '#a8202b')) EMBLEM[h](x, CW / 2 - 4, 216, 58, P);\n    x.fillStyle = '#a8202b'; x.font = '42px \"Ma Shan Zheng\", serif'; x.fillText(tp.home ? `${HOME[h].look} 算两张` : `${HOME[h].look} 记一张`, CW / 2, 348);\n  }\n  x.fillStyle = 'rgba(28,23,25,.82)'; x.fillRect(28, 374, CW - 56, 46);\n  x.fillStyle = '#f4ecdc'; x.font = '32px \"Ma Shan Zheng\", serif'; x.textBaseline = 'middle'; x.fillText(`面 ${tp.n}`, CW / 2, 398);\n  // 第三幕：台上面的字蓋住家裡面\n  if (over) {\n    x.save(); x.translate(CW / 2, 200); x.rotate(-0.16); x.globalAlpha = 0.92; x.fillStyle = FCOL[f]; x.font = `${tp.n.length > 1 ? 112 : 150}px \"Ma Shan Zheng\", serif`; x.textBaseline = 'middle'; x.fillText(tp.n, 0, 0); x.restore();\n  }\n  paperOver(x, t + 'h');\n}\nfunction drawCard(t, side, over) {\n  const c = document.createElement('canvas'); c.width = CW * 2; c.height = CH * 2;\n  const x = c.getContext('2d'); x.scale(2, 2);\n  if (side === 'home') drawHomeFace(x, t, over); else drawStageFace(x, t);\n  return c;\n}\nconst cardCache = {};\nfunction cardArt(t, side = 'stage', over = false) {\n  const k = `${t}|${side}|${over ? 1 : 0}`;\n  if (!cardCache[k]) { const c = drawCard(t, side, over); cardCache[k] = { c, url: c.toDataURL('image/png') }; }\n  return cardCache[k];\n}\n// 看牌的文字：每面最多三行，每行不超過 14 字（第八節）\nfunction stageLines(t) {\n  const tp = T[t];\n  if (tp.home) return ['家常牌，不上台。', '推给她，或拿来卸妆。'];\n  const kw = tp.wild ? '百搭：接谁都算接上，也能起手。' : tp.heavy ? '重彩：留两层油彩。' : tp.fin ? `压轴：第 4 张起打，再 +${tp.fin} 金。` : tp.clean ? '素：不上妆，脸上不添层。' : tp.boost ? '托：接上时，连击的金翻倍。' : '接上上一张，连击 +1。';\n  return [`打出得 ${tp.g} 金。`, kw, tp.wild ? '下一张打哪一族都接得上。' : `下一张请打：${FAM[tp.next].n}。`];\n}\nfunction homeLines(t) {\n  const tp = T[t], look = HOME[FAM[tp.f].home].look;\n  if (tp.blank) return ['背面是空白。', '推出去，灯不涨。'];\n  if (tp.home) return [`她「${look}」时：算两张，灯 +3。`, '有没擦的油彩，这张被染。'];\n  return [`她「${look}」时：记一张，灯 +2。`, '不对路灯不涨；被染留一道痕。'];\n}\n\n// ── 臉（鏡子、手邊小像、3D 頭上的貼圖共用）──────────────\nconst ZONES = [\n  [[-0.42, -0.06, 0.36, 0.3], [0.42, -0.06, 0.36, 0.3]],\n  [[-0.52, 0.28, 0.3, 0.3], [0.52, 0.28, 0.3, 0.3]],\n  [[0, -0.6, 0.55, 0.22]],\n  [[0, 0.06, 0.15, 0.48]],\n  [[0, 0.74, 0.58, 0.28]],\n  [[0, 0.02, 0.95, 1.15]],\n];\nfunction eye(x, ex, ey, r, d, mode, painted) {\n  const outer = ex + d * r, inner = ex - d * r;\n  x.strokeStyle = '#140f13'; x.fillStyle = '#140f13'; x.lineCap = 'round';\n  if (mode === 'closed' || mode === 'down') {\n    x.lineWidth = r * 0.3; x.beginPath(); x.moveTo(inner, ey); x.quadraticCurveTo(ex, ey + r * (mode === 'down' ? 0.5 : 0.3), outer, ey - r * 0.08); x.stroke();\n    if (mode === 'down') { x.lineWidth = r * 0.1; for (let i = 0; i < 4; i++) { const px = inner + (outer - inner) * (0.3 + i * 0.18), py = ey + r * 0.32; x.beginPath(); x.moveTo(px, py); x.lineTo(px + d * r * 0.05, py + r * 0.22); x.stroke(); } }\n    return;\n  }\n  if (painted) {\n    x.fillStyle = '#f7f1ea'; x.beginPath(); x.ellipse(ex, ey - r * 0.08, r * 1.15, r * 0.62, 0, 0, Math.PI * 2); x.fill();\n    x.fillStyle = '#140f13'; x.lineWidth = r * 0.26; x.beginPath(); x.moveTo(outer, ey - r * 0.12); x.lineTo(ex + d * r * 1.55, ey - r * 0.6); x.stroke();\n  }\n  x.lineWidth = r * 0.26; x.beginPath(); x.moveTo(inner, ey); x.quadraticCurveTo(ex, ey - r * 0.62, outer, ey - r * 0.12); x.quadraticCurveTo(ex, ey + r * 0.45, inner, ey); x.stroke();\n  x.beginPath(); x.arc(ex + d * r * 0.05, ey - r * 0.1, r * 0.36, 0, Math.PI * 2); x.fill();\n  x.fillStyle = '#f7f1ea'; x.beginPath(); x.arc(ex + d * r * 0.12, ey - r * 0.2, r * 0.08, 0, Math.PI * 2); x.fill();\n  x.fillStyle = '#140f13'; x.beginPath(); x.moveTo(outer, ey - r * 0.12); x.lineTo(ex + d * r * 1.3, ey - r * 0.38); x.stroke();\n}\nfunction paintFace(x, cx, cy, s, o) {\n  const L = o.layers || [], painted = L.length > 0;\n  L.forEach((ly, i) => {\n    const z = ZONES[Math.min(i, ZONES.length - 1)], top = i === L.length - 1;\n    x.globalAlpha = top ? 0.85 : 0.5; x.fillStyle = FCOL[ly.f];\n    z.forEach(([dx, dy, rx, ry]) => { x.beginPath(); x.ellipse(cx + dx * s, cy + dy * s, rx * s, ry * s, 0, 0, Math.PI * 2); x.fill(); });\n  });\n  x.globalAlpha = 1;\n  if (!painted) { x.fillStyle = 'rgba(214,120,128,.22)'; [-1, 1].forEach(d => { x.beginPath(); x.ellipse(cx + d * s * 0.5, cy + s * 0.28, s * 0.22, s * 0.14, 0, 0, Math.PI * 2); x.fill(); }); }\n  x.strokeStyle = '#140f13'; x.lineCap = 'round'; x.lineWidth = s * (painted ? 0.075 : 0.05);\n  [-1, 1].forEach(d => { x.beginPath(); x.moveTo(cx + d * s * 0.17, cy - s * 0.27); x.quadraticCurveTo(cx + d * s * 0.42, cy - s * (painted ? 0.5 : 0.41), cx + d * s * 0.68, cy - s * (painted ? 0.54 : 0.31)); x.stroke(); });\n  [-1, 1].forEach(d => eye(x, cx + d * s * 0.4, cy - s * 0.06, s * 0.2, d, o.eyes || 'open', painted));\n  x.lineWidth = s * 0.02; x.strokeStyle = '#6a5a5c'; x.beginPath(); x.moveTo(cx + s * 0.03, cy + s * 0.06); x.lineTo(cx - s * 0.03, cy + s * 0.33); x.quadraticCurveTo(cx, cy + s * 0.37, cx + s * 0.06, cy + s * 0.34); x.stroke();\n  const my = cy + s * 0.6, mw = s * 0.2;\n  x.fillStyle = painted ? '#4e0a10' : '#b3202b';\n  x.beginPath(); x.moveTo(cx - mw, my); x.quadraticCurveTo(cx - mw * 0.5, my - s * 0.08, cx, my - s * 0.03); x.quadraticCurveTo(cx + mw * 0.5, my - s * 0.08, cx + mw, my);\n  x.quadraticCurveTo(cx, my + s * (o.smile ? 0.12 : 0.09), cx - mw, my); x.fill();\n  if (o.smile) { x.strokeStyle = '#7a3a3e'; x.lineWidth = s * 0.012; [-1, 1].forEach(d => { x.beginPath(); x.moveTo(cx + d * mw, my); x.lineTo(cx + d * mw * 1.25, my - s * 0.04); x.stroke(); }); }\n  if (o.who === 'wife') { x.fillStyle = '#b3202b'; x.beginPath(); x.moveTo(cx, cy - s * 0.58); x.quadraticCurveTo(cx + s * 0.05, cy - s * 0.5, cx, cy - s * 0.44); x.quadraticCurveTo(cx - s * 0.05, cy - s * 0.5, cx, cy - s * 0.58); x.fill(); }\n}\n// 鏡中與手邊的小像：髮、臉、台上臉\nfunction drawPortrait(cv, o) {\n  const x = cv.getContext('2d'), W = cv.width, H = cv.height, cx = W / 2, cy = H * 0.55, s = W * 0.3;\n  x.clearRect(0, 0, W, H);\n  if (o.bg) { const g = x.createRadialGradient(cx, cy, 0, cx, cy, W * 0.6); g.addColorStop(0, o.bg[0]); g.addColorStop(1, o.bg[1]); x.fillStyle = g; x.fillRect(0, 0, W, H); }\n  x.fillStyle = '#151115'; x.beginPath(); x.ellipse(cx, cy - s * 0.15, s * 1.15, s * 1.4, 0, 0, Math.PI * 2); x.fill();\n  x.beginPath(); x.arc(cx, cy - s * 1.45, s * 0.42, 0, Math.PI * 2); x.fill();\n  x.save(); x.beginPath(); x.ellipse(cx, cy, s * 0.92, s * 1.18, 0, 0, Math.PI * 2); x.clip();\n  x.fillStyle = '#f2e8de'; x.fillRect(0, 0, W, H);\n  paintFace(x, cx, cy, s, o);\n  // 底色：最常演的那一族的顏色，淡淡地留在眼窩、兩頰、額上，卸不掉\n  if (o.base) {\n    x.fillStyle = FCOL[o.baseF] || '#a8243a';\n    ZONES.slice(0, Math.min(5, 1 + Math.floor(o.base / 2))).forEach((z, i) => { x.globalAlpha = Math.min(0.5, 0.12 + o.base * 0.035) * (i ? 0.8 : 1); z.forEach(([dx, dy, rx, ry]) => { x.beginPath(); x.ellipse(cx + dx * s, cy + dy * s, rx * s, ry * s, 0, 0, Math.PI * 2); x.fill(); }); });\n    x.globalAlpha = 1;\n  }\n  x.restore();\n  x.fillStyle = '#151115'; x.beginPath(); x.ellipse(cx, cy - s * 1.0, s * 0.98, s * 0.42, 0, Math.PI, Math.PI * 2); x.fill();\n  x.strokeStyle = '#151115'; x.lineWidth = Math.max(1.5, W / 120); x.beginPath(); x.ellipse(cx, cy, s * 0.92, s * 1.18, 0, 0, Math.PI * 2); x.stroke();\n}\n// 3D 頭上的貼圖：球面會把字拉寬，先橫向壓回去\nfunction drawSphereFace(cv, o) {\n  const x = cv.getContext('2d'), W = cv.width;\n  x.fillStyle = '#f2e8de'; x.fillRect(0, 0, W, W);\n  x.save(); x.translate(W / 2, 0); x.scale(0.74, 1); x.translate(-W / 2, 0);\n  paintFace(x, W / 2, W * 0.47, W * 0.3, o);\n  x.restore();\n}\n\n/* ──────────────── 3D 共用 ──────────────── */\nfunction canvasTex(w, h, draw) { const c = document.createElement('canvas'); c.width = w; c.height = h; draw(c.getContext('2d'), w, h); const t = new THREE.CanvasTexture(c); t.anisotropy = 4; return t; }\nconst toon = (color, map, side) => new THREE.MeshToonMaterial({ color, map: map || null, gradientMap: grad, side: side || THREE.FrontSide });\nfunction outline(w) {\n  return new THREE.ShaderMaterial({ uniforms: { w: { value: w } }, side: THREE.BackSide,\n    vertexShader: 'uniform float w; void main(){ vec3 p = position + normal * w; gl_Position = projectionMatrix * modelViewMatrix * vec4(p, 1.0); }',\n    fragmentShader: 'void main(){ gl_FragColor = vec4(0.07, 0.055, 0.06, 1.0); }' });\n}\nfunction inked(mesh, w = 0.007) { mesh.add(new THREE.Mesh(mesh.geometry, outline(w))); return mesh; }\nconst box = (w, h, d, m) => new THREE.Mesh(new THREE.BoxGeometry(w, h, d), m);\nconst plane = (w, h, m) => new THREE.Mesh(new THREE.PlaneGeometry(w, h), m);\nfunction softDot() {\n  const c = document.createElement('canvas'); c.width = c.height = 64; const x = c.getContext('2d');\n  const g = x.createRadialGradient(32, 32, 0, 32, 32, 32); g.addColorStop(0, 'rgba(255,255,255,1)'); g.addColorStop(1, 'rgba(255,255,255,0)'); x.fillStyle = g; x.fillRect(0, 0, 64, 64);\n  return new THREE.CanvasTexture(c);\n}\nfunction washTex(w, h, base, ink, seed, extra) {\n  return canvasTex(w, h, (x) => {\n    x.fillStyle = base; x.fillRect(0, 0, w, h);\n    const r = rng(seed);\n    for (let i = 0; i < 26; i++) { const X = r() * w, Y = r() * h, R = (0.08 + r() * 0.3) * w, g = x.createRadialGradient(X, Y, 0, X, Y, R); g.addColorStop(0, `rgba(${ink},${0.05 + r() * 0.16})`); g.addColorStop(1, `rgba(${ink},0)`); x.fillStyle = g; x.fillRect(0, 0, w, h); }\n    if (extra) extra(x, w, h, r);\n  });\n}\nfunction robeTex(o) {\n  return canvasTex(512, 512, (x, w, h) => {\n    x.fillStyle = o.robe; x.fillRect(0, 0, w, h);\n    const r = rng(o.seed);\n    for (let i = 0; i < 34; i++) {\n      const px = r() * w, py = r() * h * 0.9, rad = 10 + r() * 18;\n      x.strokeStyle = o.pat; x.globalAlpha = 0.45; x.lineWidth = 1.4;\n      for (let k = 0; k < 5; k++) { const a = k * Math.PI * 2 / 5; x.beginPath(); x.ellipse(px + Math.cos(a) * rad * 0.5, py + Math.sin(a) * rad * 0.5, rad * 0.45, rad * 0.28, a, 0, Math.PI * 2); x.stroke(); }\n      if (o.petal) { x.fillStyle = o.petal; x.globalAlpha = 0.35; x.beginPath(); x.arc(px, py, rad * 0.35, 0, Math.PI * 2); x.fill(); }\n    }\n    x.globalAlpha = 1; x.fillStyle = o.hem; x.fillRect(0, h * 0.94, w, h * 0.06); x.fillRect(0, 0, w, h * 0.03);\n  });\n}\nconst POSES = {\n  idle: { pitch: 0, yaw: 0, lean: 0, aL: [0.12, -0.14], aR: [0.12, 0.14] },\n  seat: { pitch: 0.05, yaw: 0, lean: 0.04, aL: [-0.85, -0.12], aR: [-0.85, 0.12] },\n  sing: { pitch: -0.24, lean: -0.05, aL: [-0.5, -1.15], aR: [-0.5, 1.15] },\n  speak: { pitch: 0.02, lean: 0.06, aR: [-1.35, 0.3] },\n  act: { pitch: -0.08, aL: [-0.95, -0.55], aR: [-0.25, 1.75] },\n  fight: { pitch: 0.06, lean: 0.24, aL: [-1.5, -0.25], aR: [-1.65, 0.25] },\n  bow: { pitch: 0.35, lean: 0.26, aL: [-0.6, -0.1], aR: [-0.6, 0.1] },\n  reach: { pitch: 0.14, lean: 0.12, aR: [-1.45, -0.08] },\n  up: { pitch: -0.14, lean: 0.03 },\n  down: { pitch: 0.42, lean: 0.02 },\n  none: { pitch: 0.07 },\n  lean: { pitch: 0.04, lean: 0.14, aL: [-0.5, -0.2], aR: [-0.5, 0.2] },\n};\nfunction makeFigure(o) {\n  const root = new THREE.Group(), body = new THREE.Group(); root.add(body);\n  const map = robeTex(o), robeM = toon(0xffffff, map), sleeveM = toon(0xffffff, map, THREE.DoubleSide);\n  const prof = [[0.36, 0], [0.31, 0.2], [0.25, 0.5], [0.2, 0.78], [0.175, 0.97], [0.19, 1.12], [0.18, 1.26], [0.13, 1.35], [0.07, 1.4], [0.02, 1.42]].map(([a, b]) => new THREE.Vector2(a, b));\n  body.add(inked(new THREE.Mesh(new THREE.LatheGeometry(prof, 36), robeM), 0.008));\n  const sash = new THREE.Mesh(new THREE.CylinderGeometry(0.183, 0.18, 0.07, 32, 1, true), toon(o.sash, null, THREE.DoubleSide)); sash.position.y = 0.97; body.add(sash);\n  const ribbons = [];\n  if (o.ribbons) [-0.06, 0.05].forEach(dx => { const rb = new THREE.Mesh(new THREE.PlaneGeometry(0.028, 0.62), toon(o.sash, null, THREE.DoubleSide)); rb.position.set(dx, 0.64, 0.19); body.add(rb); ribbons.push(rb); });\n  const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.048, 0.12, 16), toon(SKIN)); neck.position.y = 1.45; body.add(neck);\n  const head = new THREE.Group(); head.position.y = 1.55; body.add(head);\n  const sc = V(0.9, 1.1, 0.96), hair = toon(0x151115);\n  const skull = new THREE.Mesh(new THREE.SphereGeometry(0.105, 32, 24), toon(SKIN)); skull.scale.copy(sc); head.add(inked(skull, 0.005));\n  const faceCv = document.createElement('canvas'); faceCv.width = faceCv.height = 512;\n  const faceTex = new THREE.CanvasTexture(faceCv);\n  const face = new THREE.Mesh(new THREE.SphereGeometry(0.1063, 32, 24, Math.PI * 0.08, Math.PI * 0.84, Math.PI * 0.18, Math.PI * 0.62), toon(0xffffff, faceTex)); face.scale.copy(sc); head.add(face);\n  const back = new THREE.Mesh(new THREE.SphereGeometry(0.113, 32, 20, Math.PI, Math.PI, 0, Math.PI * 0.8), hair); back.scale.copy(sc); head.add(inked(back, 0.005));\n  const cap = new THREE.Mesh(new THREE.SphereGeometry(0.1125, 32, 10, 0, Math.PI * 2, 0, Math.PI * (o.headdress ? 0.29 : 0.33)), hair); cap.scale.copy(sc); head.add(cap);\n  const bun = new THREE.Mesh(new THREE.SphereGeometry(0.064, 20, 16), hair); bun.position.set(0, 0.125, -0.05); head.add(inked(bun, 0.005));\n  const longHair = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.05, 0.5, 14, 1, true), toon(0x151115, null, THREE.DoubleSide)); longHair.position.set(0, -0.22, -0.07); head.add(longHair);\n  if (o.pin) {\n    const pin = new THREE.Mesh(new THREE.CylinderGeometry(0.004, 0.004, 0.22, 6), toon(0xb8913f)); pin.rotation.z = 1.2; pin.position.set(0, 0.13, -0.05); head.add(pin);\n    [-0.02, 0.02].forEach(dx => { const rb = new THREE.Mesh(new THREE.PlaneGeometry(0.018, 0.55), toon(0xa8202b, null, THREE.DoubleSide)); rb.position.set(0.07 + dx, -0.12, -0.04); head.add(rb); ribbons.push(rb); });\n  }\n  if (o.headdress) {\n    const pearl = toon(0xf4efe6), ruby = toon(0xb3202b);\n    for (let i = 0; i < 17; i++) { const a = Math.PI * (0.05 + i * 0.9 / 16); const p = new THREE.Mesh(new THREE.SphereGeometry(i % 4 === 0 ? 0.016 : 0.011, 10, 8), i % 4 === 0 ? ruby : pearl); p.position.set(-Math.cos(a) * 0.11, 0.075 + Math.sin(a) * 0.035, Math.sin(a) * 0.075); head.add(p); }\n    const jewel = new THREE.Mesh(new THREE.SphereGeometry(0.02, 12, 10), ruby); jewel.position.set(0, 0.105, 0.085); head.add(jewel);\n    [-1, 1].forEach(d => { for (let k = 0; k < 5; k++) { const p = new THREE.Mesh(new THREE.SphereGeometry(0.008, 8, 6), pearl); p.position.set(d * 0.105, 0.02 - k * 0.032, 0.02); head.add(p); } });\n  }\n  const arms = [-1, 1].map(side => {\n    const sh = new THREE.Group(); sh.position.set(0.165 * side, 1.31, 0); body.add(sh);\n    const len = 0.52, sg = new THREE.CylinderGeometry(0.048, o.cuff, len, 18, 1, true); sg.translate(0, -len / 2, 0);\n    sh.add(inked(new THREE.Mesh(sg, sleeveM), 0.005));\n    const hand = new THREE.Mesh(new THREE.SphereGeometry(0.028, 12, 10), toon(SKIN)); hand.scale.set(0.8, 1.25, 0.6); hand.position.y = -len + 0.01; sh.add(hand);\n    let ws = null;\n    if (o.waterSleeve) {\n      const g = new THREE.PlaneGeometry(0.15, 0.85, 1, 14); g.translate