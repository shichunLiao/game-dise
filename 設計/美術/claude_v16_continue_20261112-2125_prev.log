(); });\n    x.fillStyle = '#a8202b'; x.fillRect(cx - w / 2 + 12, cy + h / 2 - 34, 18, 18);\n  },\n  act(x, cx, cy, s, P) { // 水袖\n    const band = (p, w) => { x.lineCap = 'round'; x.strokeStyle = P.line; x.lineWidth = w; bez(x, p); x.strokeStyle = P.carve; x.lineWidth = w * 0.5; bez(x, p); x.strokeStyle = P.line; x.lineWidth = 1.6; bez(x, p); };\n    band([[cx - s * 0.6, cy + s * 0.85], [cx - s * 1.05, cy - s * 0.1], [cx + s * 0.75, cy + s * 0.2], [cx + s * 0.25, cy - s * 0.95]], 24);\n    band([[cx + s * 0.62, cy + s * 0.9], [cx + s * 1.05, cy - s * 0.05], [cx - s * 0.6, cy - s * 0.05], [cx - s * 0.3, cy - s * 0.9]], 17);\n    x.fillStyle = P.line; x.beginPath(); x.ellipse(cx, cy + s * 0.95, s * 0.7, s * 0.16, 0, 0, Math.PI * 2); x.fill();\n    x.strokeStyle = P.carve; x.lineWidth = 2; x.beginPath(); x.ellipse(cx, cy + s * 0.95, s * 0.55, s * 0.08, 0, 0, Math.PI * 2); x.stroke();\n  },\n  fight(x, cx, cy, s, P) { // 靠旗與雙槍\n    x.fillStyle = P.line; x.beginPath(); x.moveTo(cx, cy - s * 0.95); x.lineTo(cx - s * 0.58, cy + s * 0.15); x.lineTo(cx + s * 0.58, cy + s * 0.15); x.closePath(); x.fill();\n    x.strokeStyle = P.carve; x.lineWidth = 2; x.beginPath(); x.moveTo(cx, cy - s * 0.78); x.lineTo(cx - s * 0.44, cy + s * 0.06); x.lineTo(cx + s * 0.44, cy + s * 0.06); x.closePath(); x.stroke();\n    for (let i = 0; i < 4; i++) { x.beginPath(); x.arc(cx, cy - s * 0.18 + i * 0.0, 6 + i * 6, Math.PI * 1.1, Math.PI * 1.9); x.stroke(); }\n    const spear = (x0, y0, x1, y1) => {\n      x.strokeStyle = P.line; x.lineWidth = 7; x.lineCap = 'round'; x.beginPath(); x.moveTo(x0, y0); x.lineTo(x1, y1); x.stroke();\n      x.strokeStyle = P.carve; x.lineWidth = 1.6; x.beginPath(); x.moveTo(x0, y0); x.lineTo(x1, y1); x.stroke();\n      const a = Math.atan2(y1 - y0, x1 - x0), L = s * 0.32;\n      x.fillStyle = P.line; x.beginPath(); x.moveTo(x1 + Math.cos(a) * L, y1 + Math.sin(a) * L); x.lineTo(x1 + Math.cos(a + 1.9) * 12, y1 + Math.sin(a + 1.9) * 12); x.lineTo(x1 + Math.cos(a - 1.9) * 12, y1 + Math.sin(a - 1.9) * 12); x.closePath(); x.fill();\n      tassel(x, x1 - Math.cos(a) * 6, y1 - Math.sin(a) * 6, 26, P.carve);\n    };\n    spear(cx - s * 0.9, cy + s * 1.0, cx + s * 0.62, cy - s * 0.72);\n    spear(cx + s * 0.9, cy + s * 1.0, cx - s * 0.62, cy - s * 0.72);\n  },\n  care(x, cx, cy, s, P) { // 一碗熱湯\n    x.strokeStyle = P.line; x.lineWidth = 3; x.lineCap = 'round';\n    for (let i = -1; i <= 1; i++) bez(x, [[cx + i * s * 0.3, cy - s * 0.15], [cx + i * s * 0.3 - 14, cy - s * 0.45], [cx + i * s * 0.3 + 14, cy - s * 0.6], [cx + i * s * 0.3, cy - s * 0.95]]);\n    x.fillStyle = P.line; x.beginPath(); x.moveTo(cx - s * 0.9, cy); x.bezierCurveTo(cx - s * 0.85, cy + s * 0.75, cx + s * 0.85, cy + s * 0.75, cx + s * 0.9, cy); x.closePath(); x.fill();\n    x.fillRect(cx - s * 0.32, cy + s * 0.58, s * 0.64, s * 0.14);\n    x.fillStyle = P.carve; x.beginPath(); x.ellipse(cx, cy, s * 0.9, s * 0.17, 0, 0, Math.PI * 2); x.fill();\n    x.strokeStyle = P.line; x.lineWidth = 2.5; x.stroke();\n    x.fillStyle = 'rgba(120,70,40,.5)'; x.beginPath(); x.ellipse(cx, cy + 2, s * 0.72, s * 0.1, 0, 0, Math.PI * 2); x.fill();\n    x.strokeStyle = P.carve; x.lineWidth = 2;\n    for (let i = 0; i < 5; i++) { x.beginPath(); x.arc(cx - s * 0.5 + i * s * 0.25, cy + s * 0.32, 7, Math.PI, 0); x.stroke(); }\n  },\n  comp(x, cx, cy, s, P) { // 一根竹竿挑兩盞燈\n    x.strokeStyle = P.line; x.lineWidth = 4; x.beginPath(); x.moveTo(cx - s, cy - s * 0.85); x.lineTo(cx + s, cy - s * 0.95); x.stroke();\n    [-0.45, 0.45].forEach((d, i) => {\n      const lx = cx + d * s, ly = cy + s * 0.05 + i * 6;\n      x.lineWidth = 1.5; x.beginPath(); x.moveTo(lx, cy - s * 0.88 - i * 4); x.lineTo(lx, ly - s * 0.52); x.stroke();\n      x.fillStyle = P.line; x.fillRect(lx - 14, ly - s * 0.56, 28, 9); x.fillRect(lx - 14, ly + s * 0.47, 28, 9);\n      x.fillStyle = '#a8202b'; x.beginPath(); x.ellipse(lx, ly, s * 0.36, s * 0.5, 0, 0, Math.PI * 2); x.fill();\n      x.strokeStyle = P.line; x.lineWidth = 2.5; x.stroke();\n      x.lineWidth = 1.4; for (let k = -2; k <= 2; k++) { x.beginPath(); x.ellipse(lx, ly, Math.abs(k) * s * 0.09 + 0.5, s * 0.5, 0, 0, Math.PI * 2); x.stroke(); }\n      tassel(x, lx, ly + s * 0.56, 26, P.line);\n    });\n  },\n  listen(x, cx, cy, s, P) { // 月下靜水\n    x.fillStyle = P.line; x.beginPath(); x.arc(cx, cy - s * 0.35, s * 0.55, 0, Math.PI * 2); x.fill();\n    x.fillStyle = P.base; x.beginPath(); x.arc(cx + s * 0.22, cy - s * 0.48, s * 0.5, 0, Math.PI * 2); x.fill();\n    x.strokeStyle = P.line;\n    for (let i = 0; i < 4; i++) { x.lineWidth = 3 - i * 0.5; x.beginPath(); x.ellipse(cx, cy + s * 0.62, s * (0.25 + i * 0.22), s * (0.06 + i * 0.05), 0, 0, Math.PI * 2); x.stroke(); }\n    x.fillStyle = '#a8202b'; x.beginPath(); x.arc(cx - s * 0.75, cy + s * 0.15, 5, 0, Math.PI * 2); x.fill();\n  },\n  labor(x, cx, cy, s, P) { // 燈骨與竹篾\n    x.strokeStyle = P.line; x.lineWidth = 3.5;\n    x.beginPath(); x.ellipse(cx, cy, s * 0.62, s * 0.85, 0, 0, Math.PI * 2); x.stroke();\n    x.lineWidth = 2; for (let k = 1; k <= 3; k++) { x.beginPath(); x.ellipse(cx, cy, s * 0.62 * (1 - k * 0.27), s * 0.85, 0, 0, Math.PI * 2); x.stroke(); }\n    [-0.5, 0, 0.5].forEach(d => { x.beginPath(); x.ellipse(cx, cy + d * s * 0.85, s * 0.62 * Math.sqrt(1 - d * d), s * 0.08, 0, 0, Math.PI * 2); x.stroke(); });\n    x.fillStyle = '#a8202b'; x.globalAlpha = 0.85; x.beginPath(); x.moveTo(cx, cy - s * 0.85); x.bezierCurveTo(cx + s * 0.5, cy - s * 0.7, cx + s * 0.62, cy - s * 0.2, cx + s * 0.6, cy + s * 0.05); x.lineTo(cx, cy + s * 0.05); x.closePath(); x.fill(); x.globalAlpha = 1;\n    x.fillStyle = P.line; x.fillRect(cx - 16, cy - s * 0.98, 32, 10); x.fillRect(cx - 16, cy + s * 0.86, 32, 10);\n  },\n};\n// 小卡只放四樣：族色、牌名與金、「接 → X」、背面牌名。字要在手牌這個大小就讀得清\nfunction clothLines(x, line, r) {\n  x.globalAlpha = 0.07; x.strokeStyle = line; x.lineWidth = 0.6;\n  for (let i = 0; i < CH; i += 3) { x.beginPath(); x.moveTo(0, i + r()); x.lineTo(CW, i + r()); x.stroke(); }\n  for (let i = 0; i < CW; i += 3) { x.beginPath(); x.moveTo(i + r(), 0); x.lineTo(i + r(), CH); x.stroke(); }\n  x.globalAlpha = 1;\n}\nfunction chip(x, cx, cy, rad, f, fg) {\n  x.fillStyle = FCOL[f]; x.beginPath(); x.arc(cx, cy, rad, 0, Math.PI * 2); x.fill();\n  x.strokeStyle = fg; x.lineWidth = 2.5; x.stroke();\n  x.fillStyle = f === 'fight' ? '#1c1719' : '#f4ecdc'; x.font = `${Math.round(rad * 1.3)}px \"Ma Shan Zheng\", serif`; x.textAlign = 'center'; x.textBaseline = 'middle';\n  x.fillText(FAM[f].n, cx, cy + 2);\n}\n// 家常牌的正面：不上台，只寫背面是什麼\nfunction drawGiftFace(x, t) {\n  const tp = T[t], h = FAM[tp.f].home, r = rng(hash(t + 'g'));\n  const paper = !!artImg(`cards/paper_0${1 + (hash(t) % 4)}.png`);\n  rr(x, 0, 0, CW, CH, 16); x.fillStyle = '#d9cdb8'; x.fill();\n  if (!paper) { x.save(); rr(x, 0, 0, CW, CH, 16); x.clip(); clothLines(x, '#4a3f3a', r); x.restore(); }\n  if (!borderArt(x, 'home', '#a8202b')) { x.strokeStyle = '#a8202b'; x.lineWidth = 4; notch(x, 14, 14, CW - 28, CH - 28, 20); x.stroke(); }\n  // v1.6：家常牌的插圖（熱湯、同桌、舊信、剪紙）印在牌名和「不上台」之間\n  if (!drawDuo(x, `cards/art_${t}`, 60, 194, 180, 112, '#1c1719', '#a8202b')) { x.globalAlpha = 0.3; EMBLEM[h](x, CW / 2 - 4, 240, 52, { base: '#d9cdb8', line: '#1c1719', carve: '#d9cdb8', hi: '#a8202b' }); x.globalAlpha = 1; }\n  x.fillStyle = '#1c1719'; x.textAlign = 'center'; x.textBaseline = 'alphabetic';\n  x.font = '30px \"Noto Serif SC\", serif'; x.fillText('家常', CW / 2, 76);\n  x.font = '86px \"Ma Shan Zheng\", serif'; x.fillText(tp.n, CW / 2, 178);\n  x.fillStyle = '#a8202b'; x.font = '34px \"Ma Shan Zheng\", serif'; x.fillText('不上台', CW / 2, 340);\n  x.fillStyle = 'rgba(28,23,25,.82)'; x.fillRect(28, 374, CW - 56, 46);\n  x.fillStyle = '#f4ecdc'; x.font = '32px \"Ma Shan Zheng\", serif'; x.textBaseline = 'middle'; x.fillText(`背 ${HOME[h].n}`, CW / 2, 398);\n  paperOver(x, t);\n}\nconst kwOf = tp => (tp.wild ? '百搭' : tp.heavy ? '重彩' : tp.fin ? `压轴+${tp.fin}` : tp.clean ? '素·不上妆' : tp.boost ? '托·连击×2' : '');\n// 這張牌後面接哪一族；百搭後面什麼都接得上\nconst nextN = tp => (tp.wild ? '任意' : FAM[tp.next].n);\nfunction drawStageFace(x, t) {\n  if (T[t].home) { drawGiftFace(x, t); return; }\n  const tp = T[t], f = tp.f, r = rng(hash(t)), fg = f === 'fight' ? '#1c1719' : '#f4ecdc', P = { base: FCOL[f], line: f === 'speak' ? '#0d0a0b' : '#1c1416', carve: '#efe2c8', hi: fg };\n  const paper = !!artImg(`cards/paper_0${1 + (hash(t) % 4)}.png`);\n  rr(x, 0, 0, CW, CH, 16); x.fillStyle = FCOL[f]; x.fill();\n  x.save(); rr(x, 0, 0, CW, CH, 16); x.clip();\n  // v1.6：有紙紋就不畫布紋；四周壓暗也減輕，像印在紙上\n  if (!paper) clothLines(x, fg, r);\n  const vg = x.createRadialGradient(CW / 2, CH / 2, CH * 0.25, CW / 2, CH / 2, CH * 0.72); vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, `rgba(10,3,5,${paper ? 0.24 : 0.45})`); x.fillStyle = vg; x.fillRect(0, 0, CW, CH);\n  x.restore();\n  // 借來的牌：金邊\n  if (!borderArt(x, 'stage', tp.blank ? '#f2d48a' : fg)) { x.strokeStyle = tp.blank ? '#f2d48a' : fg; x.lineWidth = tp.blank ? 6 : 2.5; notch(x, 14, 14, CW - 28, CH - 28, 20); x.stroke(); }\n  // v1.6：插圖印在牌名底下、「接 →」上面；有關鍵詞或「借」字時往下讓\n  const ib = kwOf(tp) ? [44, 231, 212, 64] : tp.blank ? [44, 221, 212, 72] : [40, 190, 220, 102];\n  if (!drawDuo(x, `cards/art_${t}`, ...ib, fg, accentOn(f))) { x.globalAlpha = 0.34; EMBLEM[f](x, CW / 2 - 4, 232, 46, P); x.globalAlpha = 1; }\n  // 族與金\n  chip(x, 62, 64, 32, f, fg);\n  x.fillStyle = fg; x.font = '30px \"Ma Shan Zheng\", serif'; x.textAlign = 'right'; x.textBaseline = 'alphabetic'; x.fillText('金', CW - 76, 80);\n  x.font = '66px \"Ma Shan Zheng\", serif'; x.textAlign = 'left'; x.fillText(String(tp.g), CW - 72, 88);\n  // 牌名\n  x.textAlign = 'center'; x.font = `${tp.n.length > 1 ? 74 : 96}px \"Ma Shan Zheng\", serif`; x.fillText(tp.n, CW / 2, 182);\n  if (tp.blank) { x.font = '28px \"Noto Serif SC\", serif'; x.fillText('借', CW / 2, 216); }\n  // 後台的牌：一個詞說它強在哪\n  if (kwOf(tp)) {\n    x.font = '30px \"Ma Shan Zheng\", serif'; const kw = kwOf(tp), w = x.measureText(kw).width + 26;\n    x.fillStyle = f === 'fight' ? '#1c1719' : '#f2d48a'; x.fillRect(CW / 2 - w / 2, 196, w, 36);\n    x.fillStyle = f === 'fight' ? '#f2d48a' : '#1c1719'; x.textBaseline = 'middle'; x.fillText(kw, CW / 2, 215); x.textBaseline = 'alphabetic';\n  }\n  // 接 → X\n  x.font = '44px \"Ma Shan Zheng\", serif'; x.textAlign = 'left'; x.fillText('接', 56, 340);\n  x.lineWidth = 5; x.strokeStyle = fg; x.beginPath(); x.moveTo(108, 325); x.lineTo(170, 325); x.lineTo(156, 313); x.moveTo(170, 325); x.lineTo(156, 337); x.stroke();\n  if (tp.wild) { x.font = '40px \"Ma Shan Zheng\", serif'; x.textAlign = 'center'; x.fillText('任意', 222, 340); } else chip(x, 214, 324, 36, tp.next, fg);\n  // 背面牌名\n  x.fillStyle = 'rgba(12,8,10,.5)'; x.fillRect(28, 374, CW - 56, 46);\n  x.fillStyle = '#f4ecdc'; x.font = '32px \"Ma Shan Zheng\", serif'; x.textAlign = 'center'; x.textBaseline = 'middle';\n  x.fillText(tp.blank ? '背 空白' : `背 ${HOME[FAM[f].home].n}`, CW / 2, 398);\n  paperOver(x, t);\n}\nfunction drawHomeFace(x, t, over) {\n  const tp = T[t], f = tp.f, h = FAM[f].home, r = rng(hash(t + 'h')), line = '#1c1719', P = { base: '#ebe2d3', line, carve: '#ebe2d3', hi: '#a8202b' };\n  const paper = !!artImg(`cards/paper_0${1 + (hash(t + 'h') % 4)}.png`);\n  rr(x, 0, 0, CW, CH, 16); x.fillStyle = tp.blank ? '#f4f0e8' : '#ebe2d3'; x.fill();\n  x.save(); rr(x, 0, 0, CW, CH, 16); x.clip();\n  if (!paper) clothLines(x, line, r);\n  if (!tp.blank) for (let i = 0; i < 6; i++) { const X = r() * CW, Y = r() * CH, Rd = 60 + r() * 120, g = x.createRadialGradient(X, Y, 0, X, Y, Rd); g.addColorStop(0, `rgba(60,52,54,${(0.05 + r() * 0.12) * (paper ? 0.5 : 1)})`); g.addColorStop(1, 'rgba(60,52,54,0)'); x.fillStyle = g; x.fillRect(0, 0, CW, CH); }\n  x.restore();\n  if (!borderArt(x, 'home', line)) { x.strokeStyle = line; x.lineWidth = 2.5; notch(x, 14, 14, CW - 28, CH - 28, 20); x.stroke(); }\n  x.fillStyle = line; x.textAlign = 'center'; x.textBaseline = 'alphabetic';\n  if (tp.blank) {\n    // 借來的牌：家裡面是空白，不貼插圖\n    x.globalAlpha = 0.25; x.font = '74px \"Ma Shan Zheng\", serif'; x.fillText('空白', CW / 2, 190); x.globalAlpha = 1;\n    x.font = '38px \"Ma Shan Zheng\", serif'; x.fillText('灯不涨', CW / 2, 340);\n  } else {\n    x.font = '74px \"Ma Shan Zheng\", serif'; x.fillText(HOME[h].n, CW / 2, 112);\n    // v1.6：家裡面的插圖（倾听、陪伴、照顾、共劳）；家常牌用它自己的那一張\n    if (!drawDuo(x, tp.home ? `cards/art_${t}` : `cards/art_home_${h}`, 44, 130, 212, 170, line, '#a8202b')) EMBLEM[h](x, CW / 2 - 4, 216, 58, P);\n    x.fillStyle = '#a8202b'; x.font = '42px \"Ma Shan Zheng\", serif'; x.fillText(tp.home ? `${HOME[h].look} 算两张` : `${HOME[h].look} 记一张`, CW / 2, 348);\n  }\n  x.fillStyle = 'rgba(28,23,25,.82)'; x.fillRect(28, 374, CW - 56, 46);\n  x.fillStyle = '#f4ecdc'; x.font = '32px \"Ma Shan Zheng\", serif'; x.textBaseline = 'middle'; x.fillText(`面 ${tp.n}`, CW / 2, 398);\n  // 第三幕：台上面的字蓋住家裡面\n  if (over) {\n    x.save(); x.translate(CW / 2, 200); x.rotate(-0.16); x.globalAlpha = 0.92; x.fillStyle = FCOL[f]; x.font = `${tp.n.length > 1 ? 112 : 150}px \"Ma Shan Zheng\", serif`; x.textBaseline = 'middle'; x.fillText(tp.n, 0, 0); x.restore();\n  }\n  paperOver(x, t + 'h');\n}\nfunction drawCard(t, side, over) {\n  const c = document.createElement('canvas'); c.width = CW * 2; c.height = CH * 2;\n  const x = c.getContext('2d'); x.scale(2, 2);\n  if (side === 'home') drawHomeFace(x, t, over); else drawStageFace(x, t);\n  return c;\n}\nconst cardCache = {};\nfunction cardArt(t, side = 'stage', over = false) {\n  const k = `${t}|${side}|${over ? 1 : 0}`;\n  if (!cardCache[k]) { const c = drawCard(t, side, over); cardCache[k] = { c, url: c.toDataURL('image/png') }; }\n  return cardCache[k];\n}\n// 看牌的文字：每面最多三行，每行不超過 14 字（第八節）\nfunction stageLines(t) {\n  const tp = T[t];\n  if (tp.home) return ['家常牌，不上台。', '推给她，或拿来卸妆。'];\n  const kw = tp.wild ? '百搭：接谁都算接上，也能起手。' : tp.heavy ? '重彩：留两层油彩。' : tp.fin ? `压轴：第 4 张起打，再 +${tp.fin} 金。` : tp.clean ? '素：不上妆，脸上不添层。' : tp.boost ? '托：接上时，连击的金翻倍。' : '接上上一张，连击 +1。';\n  return [`打出得 ${tp.g} 金。`, kw, tp.wild ? '下一张打哪一族都接得上。' : `下一张请打：${FAM[tp.next].n}。`];\n}\nfunction homeLines(t) {\n  const tp = T[t], look = HOME[FAM[tp.f].home].look;\n  if (tp.blank) return ['背面是空白。', '推出去，灯不涨。'];\n  if (tp.home) return [`她「${look}」时：算两张，灯 +3。`, '有没擦的油彩，这张被染。'];\n  return [`她「${look}」时：记一张，灯 +2。`, '不对路灯不涨；被染留一道痕。'];\n}\n\n// ── 臉（鏡子、手邊小像、3D 頭上的貼圖共用）──────────────\nconst ZONES = [\n  [[-0.42, -0.06, 0.36, 0.3], [0.42, -0.06, 0.36, 0.3]],\n  [[-0.52, 0.28, 0.3, 0.3], [0.52, 0.28, 0.3, 0.3]],\n  [[0, -0.6, 0.55, 0.22]],\n  [[0, 0.06, 0.15, 0.48]],\n  [[0, 0.74, 0.58, 0.28]],\n  [[0, 0.02, 0.95, 1.15]],\n];\nfunction eye(x, ex, ey, r, d, mode, painted) {\n  const outer = ex + d * r, inner = ex - d * r;\n  x.strokeStyle = '#140f13'; x.fillStyle = '#140f13'; x.lineCap = 'round';\n  if (mode === 'closed' || mode === 'down') {\n    x.lineWidth = r * 0.3; x.beginPath(); x.moveTo(inner, ey); x.quadraticCurveTo(ex, ey + r * (mode === 'down' ? 0.5 : 0.3), outer, ey - r * 0.08); x.stroke();\n    if (mode === 'down') { x.lineWidth = r * 0.1; for (let i = 0; i < 4; i++) { const px = inner + (outer - inner) * (0.3 + i * 0.18), py = ey + r * 0.32; x.beginPath(); x.moveTo(px, py); x.lineTo(px + d * r * 0.05, py + r * 0.22); x.stroke(); } }\n    return;\n  }\n  if (painted) {\n    x.fillStyle = '#f7f1ea'; x.beginPath(); x.ellipse(ex, ey - r * 0.08, r * 1.15, r * 0.62, 0, 0, Math.PI * 2); x.fill();\n    x.fillStyle = '#140f13'; x.lineWidth = r * 0.26; x.beginPath(); x.moveTo(outer, ey - r * 0.12); x.lineTo(ex + d * r * 1.55, ey - r * 0.6); x.stroke();\n  }\n  x.lineWidth = r * 0.26; x.beginPath(); x.moveTo(inner, ey); x.quadraticCurveTo(ex, ey - r * 0.62, outer, ey - r * 0.12); x.quadraticCurveTo(ex, ey + r * 0.45, inner, ey); x.stroke();\n  x.beginPath(); x.arc(ex + d * r * 0.05, ey - r * 0.1, r * 0.36, 0, Math.PI * 2); x.fill();\n  x.fillStyle = '#f7f1ea'; x.beginPath(); x.arc(ex + d * r * 0.12, ey - r * 0.2, r * 0.08, 0, Math.PI * 2); x.fill();\n  x.fillStyle = '#140f13'; x.beginPath(); x.moveTo(outer, ey - r * 0.12); x.lineTo(ex + d * r * 1.3, ey - r * 0.38); x.stroke();\n}\nfunction paintFace(x, cx, cy, s, o) {\n  const L = o.layers || [], painted = L.length > 0;\n  L.forEach((ly, i) => {\n    const z = ZONES[Math.min(i, ZONES.length - 1)], top = i === L.length - 1;\n    x.globalAlpha = top ? 0.85 : 0.5; x.fillStyle = FCOL[ly.f];\n    z.forEach(([dx, dy, rx, ry]) => { x.beginPath(); x.ellipse(cx + dx * s, cy + dy * s, rx * s, ry * s, 0, 0, Math.PI * 2); x.fill(); });\n  });\n  x.globalAlpha = 1;\n  if (!painted) { x.fillStyle = 'rgba(214,120,128,.22)'; [-1, 1].forEach(d => { x.beginPath(); x.ellipse(cx + d * s * 0.5, cy + s * 0.28, s * 0.22, s * 0.14, 0, 0, Math.PI * 2); x.fill(); }); }\n  x.strokeStyle = '#140f13'; x.lineCap = 'round'; x.lineWidth = s * (painted ? 0.075 : 0.05);\n  [-1, 1].forEach(d => { x.beginPath(); x.moveTo(cx + d * s * 0.17, cy - s * 0.27); x.quadraticCurveTo(cx + d * s * 0.42, cy - s * (painted ? 0.5 : 0.41), cx + d * s * 0.68, cy - s * (painted ? 0.54 : 0.31)); x.stroke(); });\n  [-1, 1].forEach(d => eye(x, cx + d * s * 0.4, cy - s * 0.06, s * 0.2, d, o.eyes || 'open', painted));\n  x.lineWidth = s * 0.02; x.strokeStyle = '#6a5a5c'; x.beginPath(); x.moveTo(cx + s * 0.03, cy + s * 0.06); x.lineTo(cx - s * 0.03, cy + s * 0.33); x.quadraticCurveTo(cx, cy + s * 0.37, cx + s * 0.06, cy + s * 0.34); x.stroke();\n  const my = cy + s * 0.6, mw = s * 0.2;\n  x.fillStyle = painted ? '#4e0a10' : '#b3202b';\n  x.beginPath(); x.moveTo(cx - mw, my); x.quadraticCurveTo(cx - mw * 0.5, my - s * 0.08, cx, my - s * 0.03); x.quadraticCurveTo(cx + mw * 0.5, my - s * 0.08, cx + mw, my);\n  x.quadraticCurveTo(cx, my + s * (o.smile ? 0.12 : 0.09), cx - mw, my); x.fill();\n  if (o.smile) { x.strokeStyle = '#7a3a3e'; x.lineWidth = s * 0.012; [-1, 1].forEach(d => { x.beginPath(); x.moveTo(cx + d * mw, my); x.lineTo(cx + d * mw * 1.25, my - s * 0.04); x.stroke(); }); }\n  if (o.who === 'wife') { x.fillStyle = '#b3202b'; x.beginPath(); x.moveTo(cx, cy - s * 0.58); x.quadraticCurveTo(cx + s * 0.05, cy - s * 0.5, cx, cy - s * 0.44); x.quadraticCurveTo(cx - s * 0.05, cy - s * 0.5, cx, cy - s * 0.58); x.fill(); }\n}\n// 鏡中與手邊的小像：髮、臉、台上臉\nfunction drawPortrait(cv, o) {\n  const x = cv.getContext('2d'), W = cv.width, H = cv.height, cx = W / 2, cy = H * 0.55, s = W * 0.3;\n  x.clearRect(0, 0, W, H);\n  if (o.bg) { const g = x.createRadialGradient(cx, cy, 0, cx, cy, W * 0.6); g.addColorStop(0, o.bg[0]); g.addColorStop(1, o.bg[1]); x.fillStyle = g; x.fillRect(0, 0, W, H); }\n  x.fillStyle = '#151115'; x.beginPath(); x.ellipse(cx, cy - s * 0.15, s * 1.15, s * 1.4, 0, 0, Math.PI * 2); x.fill();\n  x.beginPath(); x.arc(cx, cy - s * 1.45, s * 0.42, 0, Math.PI * 2); x.fill();\n  x.save(); x.beginPath(); x.ellipse(cx, cy, s * 0.92, s * 1.18, 0, 0, Math.PI * 2); x.clip();\n  x.fillStyle = '#f2e8de'; x.fillRect(0, 0, W, H);\n  paintFace(x, cx, cy, s, o);\n  // 底色：最常演的那一族的顏色，淡淡地留在眼窩、兩頰、額上，卸不掉\n  if (o.base) {\n    x.fillStyle = FCOL[o.baseF] || '#a8243a';\n    ZONES.slice(0, Math.min(5, 1 + Math.floor(o.base / 2))).forEach((z, i) => { x.globalAlpha = Math.min(0.5, 0.12 + o.base * 0.035) * (i ? 0.8 : 1); z.forEach(([dx, dy, rx, ry]) => { x.beginPath(); x.ellipse(cx + dx * s, cy + dy * s, rx * s, ry * s, 0, 0, Math.PI * 2); x.fill(); }); });\n    x.globalAlpha = 1;\n  }\n  x.restore();\n  x.fillStyle = '#151115'; x.beginPath(); x.ellipse(cx, cy - s * 1.0, s * 0.98, s * 0.42, 0, Math.PI, Math.PI * 2); x.fill();\n  x.strokeStyle = '#151115'; x.lineWidth = Math.max(1.5, W / 120); x.beginPath(); x.ellipse(cx, cy, s * 0.92, s * 1.18, 0, 0, Math.PI * 2); x.stroke();\n}\n// 3D 頭上的貼圖：球面會把字拉寬，先橫向壓回去\nfunction drawSphereFace(cv, o) {\n  const x = cv.getContext('2d'), W = cv.width;\n  x.fillStyle = '#f2e8de'; x.fillRect(0, 0, W, W);\n  x.save(); x.translate(W / 2, 0); x.scale(0.74, 1); x.translate(-W / 2, 0);\n  paintFace(x, W / 2, W * 0.47, W * 0.3, o);\n  x.restore();\n}\n\n/* ──────────────── 3D 共用 ──────────────── */\nfunction canvasTex(w, h, draw) { const c = document.createElement('canvas'); c.width = w; c.height = h; draw(c.getContext('2d'), w, h); const t = new THREE.CanvasTexture(c); t.anisotropy = 4; return t; }\nconst toon = (color, map, side) => new THREE.MeshToonMaterial({ color, map: map || null, gradientMap: grad, side: side || THREE.FrontSide });\nfunction outline(w) {\n  return new THREE.ShaderMaterial({ uniforms: { w: { value: w } }, side: THREE.BackSide,\n    vertexShader: 'uniform float w; void main(){ vec3 p = position + normal * w; gl_Position = projectionMatrix * modelViewMatrix * vec4(p, 1.0); }',\n    fragmentShader: 'void main(){ gl_FragColor = vec4(0.07, 0.055, 0.06, 1.0); }' });\n}\nfunction inked(mesh, w = 0.007) { mesh.add(new THREE.Mesh(mesh.geometry, outline(w))); return mesh; }\nconst box = (w, h, d, m) => new THREE.Mesh(new THREE.BoxGeometry(w, h, d), m);\nconst plane = (w, h, m) => new THREE.Mesh(new THREE.PlaneGeometry(w, h), m);\nfunction softDot() {\n  const c = document.createElement('canvas'); c.width = c.height = 64; const x = c.getContext('2d');\n  const g = x.createRadialGradient(32, 32, 0, 32, 32, 32); g.addColorStop(0, 'rgba(255,255,255,1)'); g.addColorStop(1, 'rgba(255,255,255,0)'); x.fillStyle = g; x.fillRect(0, 0, 64, 64);\n  return new THREE.CanvasTexture(c);\n}\nfunction washTex(w, h, base, ink, seed, extra) {\n  return canvasTex(w, h, (x) => {\n    x.fillStyle = base; x.fillRect(0, 0, w, h);\n    const r = rng(seed);\n    for (let i = 0; i < 26; i++) { const X = r() * w, Y = r() * h, R = (0.08 + r() * 0.3) * w, g = x.createRadialGradient(X, Y, 0, X, Y, R); g.addColorStop(0, `rgba(${ink},${0.05 + r() * 0.16})`); g.addColorStop(1, `rgba(${ink},0)`); x.fillStyle = g; x.fillRect(0, 0, w, h); }\n    if (extra) extra(x, w, h, r);\n  });\n}\nfunction robeTex(o) {\n  return canvasTex(512, 512, (x, w, h) => {\n    x.fillStyle = o.robe; x.fillRect(0, 0, w, h);\n    const r = rng(o.seed);\n    for (let i = 0; i < 34; i++) {\n      const px = r() * w, py = r() * h * 0.9, rad = 10 + r() * 18;\n      x.strokeStyle = o.pat; x.globalAlpha = 0.45; x.lineWidth = 1.4;\n      for (let k = 0; k < 5; k++) { const a = k * Math.PI * 2 / 5; x.beginPath(); x.ellipse(px + Math.cos(a) * rad * 0.5, py + Math.sin(a) * rad * 0.5, rad * 0.45, rad * 0.28, a, 0, Math.PI * 2); x.stroke(); }\n      if (o.petal) { x.fillStyle = o.petal; x.globalAlpha = 0.35; x.beginPath(); x.arc(px, py, rad * 0.35, 0, Math.PI * 2); x.fill(); }\n    }\n    x.globalAlpha = 1; x.fillStyle = o.hem; x.fillRect(0, h * 0.94, w, h * 0.06); x.fillRect(0, 0, w, h * 0.03);\n  });\n}\nconst POSES = {\n  idle: { pitch: 0, yaw: 0, lean: 0, aL: [0.12, -0.14], aR: [0.12, 0.14] },\n  seat: { pitch: 0.05, yaw: 0, lean: 0.04, aL: [-0.85, -0.12], aR: [-0.85, 0.12] },\n  sing: { pitch: -0.24, lean: -0.05, aL: [-0.5, -1.15], aR: [-0.5, 1.15] },\n  speak: { pitch: 0.02, lean: 0.06, aR: [-1.35, 0.3] },\n  act: { pitch: -0.08, aL: [-0.95, -0.55], aR: [-0.25, 1.75] },\n  fight: { pitch: 0.06, lean: 0.24, aL: [-1.5, -0.25], aR: [-1.65, 0.25] },\n  bow: { pitch: 0.35, lean: 0.26, aL: [-0.6, -0.1], aR: [-0.6, 0.1] },\n  reach: { pitch: 0.14, lean: 0.12, aR: [-1.45, -0.08] },\n  up: { pitch: -0.14, lean: 0.03 },\n  down: { pitch: 0.42, lean: 0.02 },\n  none: { pitch: 0.07 },\n  lean: { pitch: 0.04, lean: 0.14, aL: [-0.5, -0.2], aR: [-0.5, 0.2] },\n};\nfunction makeFigure(o) {\n  const root = new THREE.Group(), body = new THREE.Group(); root.add(body);\n  const map = robeTex(o), robeM = toon(0xffffff, map), sleeveM = toon(0xffffff, map, THREE.DoubleSide);\n  const prof = [[0.36, 0], [0.31, 0.2], [0.25, 0.5], [0.2, 0.78], [0.175, 0.97], [0.19, 1.12], [0.18, 1.26], [0.13, 1.35], [0.07, 1.4], [0.02, 1.42]].map(([a, b]) => new THREE.Vector2(a, b));\n  body.add(inked(new THREE.Mesh(new THREE.LatheGeometry(prof, 36), robeM), 0.008));\n  const sash = new THREE.Mesh(new THREE.CylinderGeometry(0.183, 0.18, 0.07, 32, 1, true), toon(o.sash, null, THREE.DoubleSide)); sash.position.y = 0.97; body.add(sash);\n  const ribbons = [];\n  if (o.ribbons) [-0.06, 0.05].forEach(dx => { const rb = new THREE.Mesh(new THREE.PlaneGeometry(0.028, 0.62), toon(o.sash, null, THREE.DoubleSide)); rb.position.set(dx, 0.64, 0.19); body.add(rb); ribbons.push(rb); });\n  const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.048, 0.12, 16), toon(SKIN)); neck.position.y = 1.45; body.add(neck);\n  const head = new THREE.Group(); head.position.y = 1.55; body.add(head);\n  const sc = V(0.9, 1.1, 0.96), hair = toon(0x151115);\n  const skull = new THREE.Mesh(new THREE.SphereGeometry(0.105, 32, 24), toon(SKIN)); skull.scale.copy(sc); head.add(inked(skull, 0.005));\n  const faceCv = document.createElement('canvas'); faceCv.width = faceCv.height = 512;\n  const faceTex = new THREE.CanvasTexture(faceCv);\n  const face = new THREE.Mesh(new THREE.SphereGeometry(0.1063, 32, 24, Math.PI * 0.08, Math.PI * 0.84, Math.PI * 0.18, Math.PI * 0.62), toon(0xffffff, faceTex)); face.scale.copy(sc); head.add(face);\n  const back = new THREE.Mesh(new THREE.SphereGeometry(0.113, 32, 20, Math.PI, Math.PI, 0, Math.PI * 0.8), hair); back.scale.copy(sc); head.add(inked(back, 0.005));\n  const cap = new THREE.Mesh(new THREE.SphereGeometry(0.1125, 32, 10, 0, Math.PI * 2, 0, Math.PI * (o.headdress ? 0.29 : 0.33)), hair); cap.scale.copy(sc); head.add(cap);\n  const bun = new THREE.Mesh(new THREE.SphereGeometry(0.064, 20, 16), hair); bun.position.set(0, 0.125, -0.05); head.add(inked(bun, 0.005));\n  const longHair = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.05, 0.5, 14, 1, true), toon(0x151115, null, THREE.DoubleSide)); longHair.position.set(0, -0.22, -0.07); head.add(longHair);\n  if (o.pin) {\n    const pin = new THREE.Mesh(new THREE.CylinderGeometry(0.004, 0.004, 0.22, 6), toon(0xb8913f)); pin.rotation.z = 1.2; pin.position.set(0, 0.13, -0.05); head.add(pin);\n    [-0.02, 0.02].forEach(dx => { const rb = new THREE.Mesh(new THREE.PlaneGeometry(0.018, 0.55), toon(0xa8202b, null, THREE.DoubleSide)); rb.position.set(0.07 + dx, -0.12, -0.04); head.add(rb); ribbons.push(rb); });\n  }\n  if (o.headdress) {\n    const pearl = toon(0xf4efe6), ruby = toon(0xb3202b);\n    for (let i = 0; i < 17; i++) { const a = Math.PI * (0.05 + i * 0.9 / 16); const p = new THREE.Mesh(new THREE.SphereGeometry(i % 4 === 0 ? 0.016 : 0.011, 10, 8), i % 4 === 0 ? ruby : pearl); p.position.set(-Math.cos(a) * 0.11, 0.075 + Math.sin(a) * 0.035, Math.sin(a) * 0.075); head.add(p); }\n    const jewel = new THREE.Mesh(new THREE.SphereGeometry(0.02, 12, 10), ruby); jewel.position.set(0, 0.105, 0.085); head.add(jewel);\n    [-1, 1].forEach(d => { for (let k = 0; k < 5; k++) { const p = new THREE.Mesh(new THREE.SphereGeometry(0.008, 8, 6), pearl); p.position.set(d * 0.105, 0.02 - k * 0.032, 0.02); head.add(p); } });\n  }\n  const arms = [-1, 1].map(side => {\n    const sh = new THREE.Group(); sh.position.set(0.165 * side, 1.31, 0); body.add(sh);\n    const len = 0.52, sg = new THREE.CylinderGeometry(0.048, o.cuff, len, 18, 1, true); sg.translate(0, -len / 2, 0);\n    sh.add(inked(new THREE.Mesh(sg, sleeveM), 0.005));\n    const hand = new THREE.Mesh(new THREE.SphereGeometry(0.028, 12, 10), toon(SKIN)); hand.scale.set(0.8, 1.25, 0.6); hand.position.y = -len + 0.01; sh.add(hand);\n    let ws = null;\n    if (o.waterSleeve) {\n      const g = new THREE.PlaneGeometry(0.15, 0.85, 1, 14); g.translate(0, -0.42, 0);\n      const m = new THREE.Mesh(g, toon(0xf3ede3, null, THREE.DoubleSide)); m.position.y = -len; sh.add(m);\n      ws = { m, base: Float32Array.from(g.attributes.position.array) };\n    }\n    return { sh, ws, side };\n  });\n  const st = { pitch: 0, yaw: 0, lean: 0, aL: [0.12, -0.14], aR: [0.12, 0.14] };\n  const tg = { ...st, aL: [...st.aL], aR: [...st.aR] };\n  let blinkAt = 2 + Math.random() * 3, blinkEnd = 0, resetTimer = null;\n  const fig = {\n    root, head, base: 'idle', expr: { eyes: 'open', smile: false }, layers: [], who: o.who,\n    pose(name) {\n      const B = POSES[this.base], P = POSES[name] || {};\n      tg.pitch = P.pitch ?? B.pitch ?? 0; tg.yaw = P.yaw ?? B.yaw ?? 0; tg.lean = P.lean ?? B.lean ?? 0;\n      tg.aL = [...(P.aL || B.aL || POSES.idle.aL)]; tg.aR = [...(P.aR || B.aR || POSES.idle.aR)];\n    },\n    turn(yaw) { tg.yaw = yaw; },\n    redraw() { drawSphereFace(faceCv, { who: o.who, layers: this.layers, eyes: blinkEnd > 0 ? 'closed' : this.expr.eyes, smile: this.expr.smile }); faceTex.needsUpdate = true; },\n    setLayers(L) { this.layers = L.map(l => ({ f: l.f })); this.redraw(); },\n    perform(f) { this.pose(f); clearTimeout(resetTimer); resetTimer = setTimeout(() => this.pose('idle'), 1200); },\n    react(k) {\n      this.expr = k === 'up' ? { eyes: 'open', smile: true } : k === 'down' ? { eyes: 'down', smile: false } : { eyes: 'open', smile: false };\n      this.pose(k === 'up' ? 'up' : k === 'down' ? 'down' : 'none'); this.redraw();\n      clearTimeout(resetTimer);\n      resetTimer = setTimeout(() => { this.expr = { eyes: 'open', smile: false }; this.pose(this.base); this.redraw(); }, 2400);\n    },\n    update(dt, t) {\n      const k = 1 - Math.exp(-dt * 6);\n      st.pitch += (tg.pitch - st.pitch) * k; st.yaw += (tg.yaw - st.yaw) * k; st.lean += (tg.lean - st.lean) * k;\n      for (let i = 0; i < 2; i++) { st.aL[i] += (tg.aL[i] - st.aL[i]) * k; st.aR[i] += (tg.aR[i] - st.aR[i]) * k; }\n      head.rotation.x = st.pitch + Math.sin(t * 1.3) * 0.015; head.rotation.y = st.yaw * 0.25;\n      root.rotation.y = st.yaw; body.rotation.x = st.lean; body.position.y = Math.sin(t * 1.6) * 0.004;\n      arms[0].sh.rotation.set(st.aL[0], 0, st.aL[1] + Math.sin(t * 1.1) * 0.02);\n      arms[1].sh.rotation.set(st.aR[0], 0, st.aR[1] - Math.sin(t * 1.1) * 0.02);\n      arms.forEach(a => {\n        if (!a.ws) return;\n        const p = a.ws.m.geometry.attributes.position, b = a.ws.base;\n        for (let i = 0; i < p.count; i++) { const y = b[i * 3 + 1]; p.setZ(i, b[i * 3 + 2] + Math.sin(t * 3 + y * 7 + a.side) * 0.09 * -y); p.setX(i, b[i * 3] + Math.sin(t * 2 + y