 goldG = new THREE.Group(); goldG.position.set(0.98, TOP, 0.42); g.add(goldG);\n1796\t  lights.c1 = candle(g, -0.42, TOP, -0.92); lights.c2 = candle(g, 0.98, TOP, 0.05);\n1797\t  lights.hemi = new THREE.HemisphereLight(0xf3e4d0, 0x241812, 0.7); g.add(lights.hemi);\n1798\t  lights.key = new THREE.DirectionalLight(0xfff1dc, 0.5); lights.key.position.set(-2, 4, 3); g.add(lights.key);\n1799\t}\n1800\t// 鏡頭：全桌、戲台、門口（她起身伸手過來）、對面、夜裡的鏡子\n1801\tconst VIEWS = {\n1802\t  table: { pos: [0, 2.2, 2.72], look: [0, 0.62, -0.42] },\n1803\t  stage: { pos: [0, 2.62, 0.9], look: [0, 0.74, -0.08] },\n1804\t  door: { pos: [0.2, 1.72, 2.05], look: [0.2, 0.84, -0.65] },\n1805\t  home: { pos: [0, 1.66, 1.5], look: [0.1, 0.72, -1.15] },\n1806\t  night: { pos: [0.42, 1.78, 2.05], look: [0.42, 0.72, -0.28] },\n1807\t  mirror: { pos: [1.02, 1.26, 1.06], look: [1.3, 1.14, -0.02] },\n1808\t  lamp: { pos: [0.98, 1.42, 0.22], look: [0.5, 0.98, -0.98] },\n1809\t};\n1810\tconst MOODS = {\n1811\t  day: { hemi: 0.75, key: 0.55, spot: 0.5, c: 1.0, bg: 0x241a14 },\n1812\t  stage: { hemi: 0.34, key: 0.2, spot: 2.6, c: 0.6, bg: 0x0d0a0c },\n1813\t  door: { hemi: 0.3, key: 0.18, spot: 0, c: 0.9, bg: 0x0a0a10 },\n1814\t  home: { hemi: 0.52, key: 0.3, spot: 0, c: 1.4, bg: 0x1a1210 },\n1815\t  night: { hemi: 0.13, key: 0.05, spot: 0, c: 1.5, bg: 0x070506 },\n1816\t};\n1817\tfunction focus(v, mood) {\n1818\t  if (!glOK) return;\n1819\t  const fit = camera.aspect < 0.8 ? 1.72 : camera.aspect < 1.25 ? 1.32 : 1;\n1820\t  const d = VIEWS[v], l = V(...d.look), p = V(...d.pos).sub(l).multiplyScalar(fit).add(l);\n1821\t  camTo = { p, l };\n1822\t  if (!camPos) { camPos = p.clone(); camAim = l.clone(); }\n1823\t  if (mood) moodTo = MOODS[mood];\n1824\t}\n1825\tfunction initGL() {\n1826\t  if (!glOK) return;\n1827\t  try { renderer = new THREE.WebGLRenderer({ canvas: $('#gl'), antialias: true }); } catch (e) { glOK = false; return; }\n1828\t  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n1829\t  renderer.setSize(innerWidth, innerHeight);\n1830\t  scene = new THREE.Scene();\n1831\t  camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.03, 40); scene.add(camera);\n1832\t  clock = new THREE.Clock();\n1833\t  const d = new Uint8Array([70, 70, 70, 150, 150, 150, 220, 220, 220, 255, 255, 255]);\n1834\t  grad = new THREE.DataTexture(d, 4, 1, THREE.RGBFormat); grad.minFilter = grad.magFilter = THREE.NearestFilter; grad.generateMipmaps = false; grad.needsUpdate = true;\n1835\t  backTex = new THREE.CanvasTexture(drawBack());\n1836\t  buildTable();\n1837\t  const tw = plane(0.5, 0.36, new THREE.MeshLambertMaterial({ map: canvasTex(256, 180, (x, w, h) => { x.fillStyle = '#f4efe6'; x.fillRect(0, 0, w, h); x.strokeStyle = '#cfc6b8'; x.lineWidth = 4; for (let i = 0; i < 6; i++) { x.beginPath(); x.moveTo(0, 20 + i * 28); x.quadraticCurveTo(w / 2, 10 + i * 28, w, 24 + i * 28); x.stroke(); } }), side: THREE.DoubleSide, transparent: true }));\n1838\t  towel = tw; towel.visible = false; camera.add(towel);\n1839\t  addEventListener('resize', () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); renderSmear(); });\n1840\t  addEventListener('pointermove', e => { pointer.x = e.clientX / innerWidth - 0.5; pointer.y = e.clientY / innerHeight - 0.5; });\n1841\t  requestAnimationFrame(loop);\n1842\t}\n1843\tfunction tween(dur, fn) {\n1844\t  if (!glOK || calm()) { fn(1); return Promise.resolve(); }\n1845\t  // 分頁在背景時畫面不更新：動畫不能卡住流程，時間到了就直接跳到結尾\n1846\t  return new Promise(res => {\n1847\t    const w = { t: 0, dur: dur / 1000, fn, res };\n1848\t    tweens.push(w);\n1849\t    setTimeout(() => { const i = tweens.indexOf(w); if (i >= 0) { tweens.splice(i, 1); fn(1); res(); } }, dur + 500);\n1850\t  });\n1851\t}\n1852\tconst ease = e => (e < 0.5 ? 2 * e * e : 1 - Math.pow(-2 * e + 2, 2) / 2);\n1853\tfunction loop() {\n1854\t  requestAnimationFrame(loop);\n1855\t  // 補間動畫按真實時間走：幀率低時不能跟著變慢，否則流程會等很久\n1856\t  const raw = clock.getDelta(), dt = Math.min(raw, 0.05), t = clock.elapsedTime;\n1857\t  for (let i = tweens.length - 1; i >= 0; i--) { const w = tweens[i]; w.t += Math.min(raw, 0.25); const k = Math.min(1, w.t / w.dur); w.fn(ease(k)); if (k >= 1) { tweens.splice(i, 1); w.res(); } }\n1858\t  if (camTo) {\n1859\t    const k = calm() ? 1 : 1 - Math.exp(-Math.min(raw, 0.25) * 2.6);\n1860\t    camPos.lerp(camTo.p, k); camAim.lerp(camTo.l, k);\n1861\t    camera.position.set(camPos.x + pointer.x * 0.1, camPos.y + Math.sin(t * 0.7) * 0.006 - pointer.y * 0.05, camPos.z);\n1862\t    camera.lookAt(camAim);\n1863\t  }\n1864\t  if (moodTo) {\n1865\t    const k = 1 - Math.exp(-Math.min(raw, 0.25) * 2.2);\n1866\t    lights.hemi.intensity += (moodTo.hemi - lights.hemi.intensity) * k;\n1867\t    lights.key.intensity += (moodTo.key - lights.key.intensity) * k;\n1868\t    lights.spot.intensity += (moodTo.spot + (moodTo === MOODS.stage ? stageHeat : 0) - lights.spot.intensity) * k;\n1869\t    [lights.c1, lights.c2].forEach(c => { c.base = moodTo.c; });\n1870\t    if (!scene.background) scene.background = new THREE.Color(moodTo.bg);\n1871\t    scene.background.lerp(new THREE.Color(moodTo.bg), k);\n1872\t  }\n1873\t  wife?.update(dt, t); actor?.update(dt, t);\n1874\t  if (crowdG && crowdG.visible) {\n1875\t    crowdTick(t);\n1876\t    swayKick *= Math.exp(-dt * 1.6); lanternKick *= Math.exp(-dt * 3);\n1877\t    stageCurtains.forEach((c, i) => { c.rotation.y = Math.sin(t * 3.2 + i * 2) * 0.12 * swayKick; c.rotation.z = Math.sin(t * 2.1 + i) * 0.03 * swayKick; });\n1878\t    lanterns.forEach((m, i) => { const k = 1 + lanternKick * (0.35 + 0.15 * Math.sin(t * 9 + i)); m.scale.set(k, 1.25 * k, k); });\n1879\t  }\n1880\t  [lights.c1, lights.c2].forEach(c => { if (c && c.base !== undefined) { c.fl.scale.y = 0.11 + Math.sin(t * 11) * 0.008; c.L.intensity = c.base * (0.92 + Math.sin(t * 13) * 0.05 + Math.sin(t * 7.3) * 0.03); } });\n1881\t  renderer.render(scene, camera);\n1882\t}\n1883\t// 桌面跟著狀態走：金堆、燈紙、痕、布、油彩漬、她的座位\n1884\tfunction updateTable() {\n1885\t  if (!glOK || !S) return;\n1886\t  const act = actOf(S.day), n = S.lit || S.litAlone ? 12 : Math.min(12, Math.round(S.lamp * 12 / R.lampFull));\n1887\t  lampPatches.forEach((p, i) => { p.visible = i < n; });\n1888\t  lampScars.forEach((m, i) => { m.visible = i < S.scars; });\n1889\t  lampLight.intensity = S.lit || S.litAlone ? 1.7 : 0;\n1890\t  stainM.opacity = [0, 0.8, 1][act] * Math.min(1, 0.75 + S.base * 0.1);\n1891\t  const z = SEAT_Z[act];\n1892\t  stool.position.set(0, 0, z - 0.02);\n1893\t  const empty = seatEmpty(S) || !!S.left;\n1894\t  wife.root.visible = !empty;\n1895\t  if (!empty) wife.root.position.set(0, -0.32, z);\n1896\t  // 晾繩上的布、木匣裡的布\n1897\t  while (clothG.children.length) clothG.remove(clothG.children[0]);\n1898\t  S.rope.slice(-24).forEach((e, i) => {\n1899\t    const m = plane(0.13, 0.19, new THREE.MeshBasicMaterial({ color: new THREE.Color(FCOL[e.f]).lerp(new THREE.Color(0xe6ddcf), 0.25), side: THREE.DoubleSide }));\n1900\t    m.position.set(-1.6 + i * 0.14, TOP + 0.16, 0.78); m.rotation.z = (i % 2 ? 1 : -1) * 0.05; clothG.add(m);\n1901\t  });\n1902\t  while (chestG.children.length) chestG.remove(chestG.children[0]);\n1903\t  S.chest.slice(-14).forEach((e, i) => { const m = box(0.3, 0.008, 0.2, new THREE.MeshLambertMaterial({ color: FCOL[e.f] })); m.position.y = i * 0.008; m.rotation.y = (i % 3 - 1) * 0.08; chestG.add(m); });\n1904\t  // 金箔堆\n1905\t  const coins = Math.min(44, Math.round(S.gold / 4));\n1906\t  while (goldG.children.length > coins) goldG.remove(goldG.children[goldG.children.length - 1]);\n1907\t  const r = rng(61 + goldG.children.length);\n1908\t  while (goldG.children.length < coins) { const i = goldG.children.length, m = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.008, 12), new THREE.MeshLambertMaterial({ color: 0xd9b25a, emissive: 0x3a2a08 })); m.position.set((r() - 0.5) * 0.2, 0.005 + i * 0.0035, (r() - 0.5) * 0.14); goldG.add(m); }\n1909\t  updateMirror();\n1910\t  updateLanterns();\n1911\t  setBoxStack();\n1912\t}\n1913\tfunction updateMirror() {\n1914\t  if (!glOK || !S) return;\n1915\t  drawPortrait(mirrorCv, { who: 'you', layers: S.T.layers, base: S.baseSeen ? S.base : 0, baseF: topFams()[0], bg: ['#8d9396', '#3b4044'] });\n1916\t  mirrorTex.needsUpdate = true;\n1917\t}\n1918\tfunction updateLanterns() {\n1919\t  if (!glOK || !S) return;\n1920\t  lanterns.forEach((m, i) => { const p = S.T.plays[i]; m.material.color.setHex(p ? (p.broke ? 0x7a3a2a : 0xff6a3c) : 0x4a1414); });\n1921\t}\n1922\tfunction setBoxStack() {\n1923\t  if (!glOK || !S) return;\n1924\t  while (boxStack.children.length) boxStack.remove(boxStack.children[0]);\n1925\t  const n = S.T.box.filter(id => !S.T.used[id]).length, m = new THREE.MeshLambertMaterial({ map: backTex });\n1926\t  for (let i = 0; i < n; i++) { const c = new THREE.Mesh(new THREE.BoxGeometry(0.29, 0.005, 0.19), [m, m, m, m, m, m]); c.position.set((i % 2) * 0.004, -0.05 + i * 0.006, 0); c.rotation.y = (i % 3 - 1) * 0.03; boxStack.add(c); }\n1927\t}\n1928\tfunction clear3DCards() { played3D.forEach(m => m.parent && m.parent.remove(m)); played3D = []; }\n1929\tfunction cardSpot(where, n) {\n1930\t  return where === 'stage' ? V(-0.54 + n * 0.27, TOP + 0.118, 0.04) : V(-0.34 + n * 0.34, TOP + 0.008, -0.72);\n1931\t}\n1932\tasync function spawnCard(t, side, pos) {\n1933\t  if (!glOK) return;\n1934\t  const m = cardMesh(t, side, side === 'stage' ? 1.4 : 1.3);\n1935\t  m.rotation.x = -Math.PI / 2; m.rotation.z = (Math.random() - 0.5) * (side === 'stage' ? 0.08 : 0.18); m.position.copy(pos); m.position.y += 0.25; scene.add(m); played3D.push(m);\n1936\t  const y0 = m.position.y;\n1937\t  await tween(300, k => { m.position.y = y0 - 0.25 * k; });\n1938\t}\n1939\tasync function towelSwipe(color) {\n1940\t  if (!glOK) { await wait(300); return; }\n1941\t  towel.visible = true; towel.material.color = new THREE.Color(0xffffff).lerp(new THREE.Color(color), 0.35);\n1942\t  await tween(620, k => { towel.position.set(-0.55 + 1.1 * k, 0.05 - Math.sin(k * Math.PI) * 0.1, -0.42); towel.rotation.z = -0.4 + 0.8 * k; });\n1943\t  towel.visible = false;\n1944\t}\n1945\t\n1946\t// 她的樣子：畫面為主，放大（滑過、聚焦或點開）才附文字\n1947\tconst LOOK_ICON = {\n1948\t  等: '<svg viewBox=\"0 0 24 24\"><path d=\"M2.5 12.5h8.5c0 3.2-1.9 5.3-4.25 5.3S2.5 15.7 2.5 12.5zM13 12.5h8.5c0 3.2-1.9 5.3-4.25 5.3S13 15.7 13 12.5z\" fill=\"currentColor\"/><path d=\"M15 10.5l4.5-7M17 10.5l4.5-7\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M4 20.5h16\" stroke=\"currentColor\" stroke-width=\"1\"/></svg>',\n1949\t  累: '<svg viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"9\" r=\"4.3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" transform=\"rotate(18 11 9)\"/><path d=\"M8.6 9.8q1 .7 2 0M11.8 10.6q1 .7 2 0\" stroke=\"currentColor\" fill=\"none\" stroke-width=\"1.1\"/><path d=\"M4 22c1-4.5 3.6-7.2 7.4-7.2S18 17.5 19 22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M16.5 3.2h3.2l-3.2 3.2h3.2\" stroke=\"currentColor\" fill=\"none\" stroke-width=\"1\"/></svg>',\n1950\t  忙: '<svg viewBox=\"0 0 24 24\"><ellipse cx=\"12\" cy=\"13.2\" rx=\"7\" ry=\"8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 5.2v16M7.4 6.8c-2 3.6-2 9.4 0 12.9M16.6 6.8c2 3.6 2 9.4 0 12.9M5 13.2h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\"/><rect x=\"9\" y=\"2\" width=\"6\" height=\"2.6\" fill=\"currentColor\"/></svg>',\n1951\t  想说: '<svg viewBox=\"0 0 24 24\"><path d=\"M3.5 4.5h17v11H10l-5 4.2v-4.2H3.5z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/><circle cx=\"8.5\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/><circle cx=\"15.5\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/></svg>',\n1952\t};\n1953\t\n1954\t// ── 教學小框：連擊、接口、被染第一次出現時解釋（第八節）；要玩家動手的步驟，只放行框裡的東西 ──\n1955\tconst TUT_KEY = 'dise-v15-tut';\n1956\tconst tutPref = () => { try { return localStorage.getItem(TUT_KEY) !== '0'; } catch (e) { return true; } };\n1957\tconst setTutPref = on => { try { localStorage.setItem(TUT_KEY, on ? '1' : '0'); } catch (e) { /* 存不了就算了 */ } };\n1958\tconst handOf = t => { const id = S.T.box.find(x => cardOf(S, x).t === t && !S.T.used[x]); return id === undefined ? null : document.querySelector(`.hc[data-id=\"${id}\"]`); };\n1959\tconst famOfLook = look => Object.keys(FAM).find(f => FAM[f].home === LOOK_HOME[look]);\n1960\t// 她要的：「累」照顧 ×2 + 「忙」共勞 ×1\n1961\tconst recipeTx = nd => nd.items.map(x => `「${x.look}」${HOME[LOOK_HOME[x.look]].n} ×${x.n}`).join(' + ');\n1962\tconst recipeShort = nd => nd.items.map(x => `${x.look}·${HOME[LOOK_HOME[x.look]].n}×${x.n}`).join(' + ');"}]},"parent_tool_use_id":null,"session_id":"5e9394c0-ca93-4be2-9c50-fc1d55a10765","uuid":"d193aaa2-1ec2-4659-90cb-c6228de0d754","timestamp":"2026-11-12T04:28:13.508Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.5/index.html","content":"}\n/* ──────────────── 一張桌子 ──────────────── */\n// 中央小戲台、左妝匣、右鏡子、下晾繩、對面阿檀。鏡頭在桌上移動，規則的變化都擺在桌面上\nconst TOP = 0.74;\nconst SEAT_Z = [-1.62, -1.92, -2.2];\nlet glOK = !!window.THREE, renderer, scene, camera, clock, grad, tweens = [], wife = null, actor = null, towel = null, backTex = null;\nlet mirrorCv = null, mirrorTex = null, boxStack = null, clothG = null, chestG = null, goldG = null, stainM = null, stool = null;\nlet lampPatches = [], lampScars = [], lampLight = null, lanterns = [], played3D = [], lights = {}, cards3D = {}, crowd = [], crowdG = null, stageHeat = 0, stageCurtains = [], swayKick = 0, lanternKick = 0;\nlet pointer = { x: 0, y: 0 }, camTo = null, camPos = null, camAim = null, moodTo = null;\nconst V = (a, b, c) => new THREE.Vector3(a, b, c);\nPOSES.work = { pitch: 0.28, lean: 0.08, aL: [-1.05, -0.32], aR: [-1.05, 0.32] };\nfunction cardMesh(t, side, k = 1) {\n  const key = `${t}|${side}`;\n  if (!cards3D[key]) cards3D[key] = new THREE.CanvasTexture(cardArt(t, side).c);\n  const edge = new THREE.MeshLambertMaterial({ color: 0x2a1a1c });\n  const front = new THREE.MeshLambertMaterial({ map: cards3D[key] }), back = new THREE.MeshLambertMaterial({ map: backTex });\n  return new THREE.Mesh(new THREE.BoxGeometry(0.15 * k, 0.225 * k, 0.003), [edge, edge, edge, edge, front, back]);\n}\nfunction drawBack() {\n  const c = document.createElement('canvas'); c.width = CW; c.height = CH;\n  const x = c.getContext('2d');\n  rr(x, 0, 0, CW, CH, 16); x.fillStyle = '#120e11'; x.fill();\n  x.strokeStyle = '#a8202b'; x.lineWidth = 3; notch(x, 14, 14, CW - 28, CH - 28, 20); x.stroke();\n  x.fillStyle = '#7d1219'; x.beginPath(); x.arc(CW / 2, CH / 2, 96, 0, Math.PI * 2); x.fill();\n  x.fillStyle = '#efe2c8'; x.font = '60px \"Ma Shan Zheng\", serif'; x.textAlign = 'center'; x.textBaseline = 'middle'; x.fillText('底', CW / 2, CH / 2 + 3);\n  return c;\n}\nfunction latticeTex() {\n  return canvasTex(1024, 512, (x, w, h) => {\n    x.fillStyle = '#2a1c15'; x.fillRect(0, 0, w, h);\n    x.fillStyle = '#c9b48c'; x.fillRect(w * 0.27, h * 0.1, w * 0.46, h * 0.62);\n    x.strokeStyle = '#1e130d'; x.lineWidth = 10; x.strokeRect(w * 0.27, h * 0.1, w * 0.46, h * 0.62);\n    x.lineWidth = 5;\n    for (let i = 1; i < 8; i++) { x.beginPath(); x.moveTo(w * 0.27 + i * w * 0.46 / 8, h * 0.1); x.lineTo(w * 0.27 + i * w * 0.46 / 8, h * 0.72); x.stroke(); }\n    for (let i = 1; i < 5; i++) { x.beginPath(); x.moveTo(w * 0.27, h * 0.1 + i * h * 0.62 / 5); x.lineTo(w * 0.73, h * 0.1 + i * h * 0.62 / 5); x.stroke(); }\n  });\n}\nfunction woodTex() {\n  return canvasTex(1024, 720, (x, w, h) => {\n    x.fillStyle = '#3d2015'; x.fillRect(0, 0, w, h);\n    const r = rng(77);\n    for (let i = 0; i < 260; i++) { x.strokeStyle = `rgba(${r() < 0.5 ? '20,9,5' : '96,56,34'},${0.08 + r() * 0.16})`; x.lineWidth = 1 + r() * 2.4; const y0 = r() * h; x.beginPath(); x.moveTo(0, y0); x.bezierCurveTo(w * 0.3, y0 + r() * 16 - 8, w * 0.7, y0 + r() * 16 - 8, w, y0 + r() * 12 - 6); x.stroke(); }\n  });\n}\n// 油彩漬：從桌邊往裡爬，第二幕起才看得見\nfunction stainTex() {\n  return canvasTex(1024, 720, (x, w, h) => {\n    x.clearRect(0, 0, w, h);\n    const r = rng(19), cols = ['168,36,58', '143,99,56', '184,145,63', '43,36,39'];\n    for (let i = 0; i < 90; i++) {\n      const side = Math.floor(r() * 4), m = 0.03 + r() * 0.14;\n      const X = side === 0 ? m * w : side === 1 ? (1 - m) * w : r() * w, Y = side === 2 ? m * h : side === 3 ? (1 - m) * h : r() * h, Rd = 18 + r() * 62, c = cols[Math.floor(r() * 4)];\n      const g = x.createRadialGradient(X, Y, 0, X, Y, Rd); g.addColorStop(0, `rgba(${c},.85)`); g.addColorStop(0.7, `rgba(${c},.4)`); g.addColorStop(1, `rgba(${c},0)`);\n      x.fillStyle = g; x.beginPath(); x.ellipse(X, Y, Rd, Rd * (0.5 + r() * 0.6), r() * 3, 0, Math.PI * 2); x.fill();\n    }\n  });\n}\nfunction buildMiniStage(g) {\n  const s = new THREE.Group(); s.position.set(0, TOP, -0.2); g.add(s);\n  const boards = canvasTex(512, 256, (x, w, h) => { x.fillStyle = '#6d4427'; x.fillRect(0, 0, w, h); x.strokeStyle = 'rgba(0,0,0,.4)'; x.lineWidth = 2; for (let i = 0; i < w; i += 40) { x.beginPath(); x.moveTo(i, 0); x.lineTo(i, h); x.stroke(); } });\n  const plat = box(1.5, 0.11, 0.82, toon(0xffffff, boards)); plat.position.y = 0.055; s.add(inked(plat, 0.006));\n  // 中間不擋：看得見對面的阿檀，只有兩邊的幕和一根掛燈的竿\n  const cL = curtain(0.42, 0.72, 0xa01d24, 1), cR = curtain(0.42, 0.72, 0xa01d24, 3);\n  cL.position.set(-0.68, 0.47, -0.3); cR.position.set(0.68, 0.47, -0.3); s.add(cL, cR);\n  stageCurtains = [cL, cR];\n  const rod = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 1.5, 8), toon(0x2a1a14)); rod.rotation.z = Math.PI / 2; rod.position.set(0, 0.86, -0.3); s.add(rod);\n  lanterns = [-0.48, -0.24, 0, 0.24, 0.48].map(dx => {\n    const m = new THREE.Mesh(new THREE.SphereGeometry(0.038, 14, 10), new THREE.MeshBasicMaterial({ color: 0x4a1414 })); m.scale.y = 1.25; m.position.set(dx, 0.8, -0.3); s.add(m);\n    return m;\n  });\n  actor = makeFigure({ who: 'actor', robe: '#f3ede3', pat: '#5d7a62', petal: '#d99aa4', hem: '#a8202b', sash: 0xa8202b, cuff: 0.13, seed: 9, waterSleeve: true, headdress: true });\n  actor.root.scale.setScalar(0.34); actor.root.position.set(0, 0.11, -0.12); s.add(actor.root);\n  const spot = new THREE.SpotLight(0xffe0b0, 0, 5, 0.5, 0.6, 1.2); spot.position.set(0, 2.4, 0.9); spot.target.position.set(0, 0.2, -0.1); s.add(spot, spot.target);\n  lights.spot = spot;\n}\n// 觀眾：一排黑色剪紙背景板，立在戲台前面；打出牌時一起起伏，接錯了往下沉\nfunction silhouetteCv(seed) {\n  const c = document.createElement('canvas'); c.width = 256; c.height = 320;\n  const x = c.getContext('2d'), r = rng(seed), kind = seed % 5, hw = 50 + r() * 6;\n  const shape = (fill, grow) => {\n    x.save(); x.translate(128, 320); x.scale(1 + grow, 1 + grow); x.translate(-128, -320); x.fillStyle = fill; x.strokeStyle = fill;\n  // 肩膀\n  x.beginPath(); x.moveTo(10, 320); x.bezierCurveTo(14, 238, 60, 206, 128, 204); x.bezierCurveTo(196, 206, 242, 238, 246, 320); x.closePath(); x.fill();\n  // 脖子與頭\n  x.fillRect(108, 168, 40, 44);\n  x.beginPath(); x.ellipse(128, 126, hw, 58, 0, 0, Math.PI * 2); x.fill();\n  // 帽子、髮髻、斗笠、辮子、花\n  if (kind === 0) { x.beginPath(); x.ellipse(128, 82, 52, 30, 0, Math.PI, 0); x.fill(); x.beginPath(); x.arc(128, 50, 9, 0, Math.PI * 2); x.fill(); }\n  if (kind === 1) { x.beginPath(); x.ellipse(128, 64, 34, 26, 0, 0, Math.PI * 2); x.fill(); x.fillRect(150, 52, 44, 5); }\n  if (kind === 2) { x.beginPath(); x.moveTo(36, 96); x.lineTo(128, 36); x.lineTo(220, 96); x.closePath(); x.fill(); }\n  if (kind === 3) { x.lineWidth = 12; x.beginPath(); x.moveTo(170, 150); x.quadraticCurveTo(206, 220, 194, 300); x.stroke(); }\n  if (kind === 4) { for (let i = 0; i < 5; i++) { const a = i * Math.PI * 2 / 5; x.beginPath(); x.ellipse(92 + Math.cos(a) * 14, 70 + Math.sin(a) * 14, 10, 6, a, 0, Math.PI * 2); x.fill(); } }\n    x.restore();\n  };\n  // 先一層紅紙稍大一點，再一層黑紙：剪紙的紅邊\n  shape('#b3202c', 0.045); shape('#0b0809', 0);\n  // 剪紙的鏤空：一圈小窗花\n  x.globalCompositeOperation = 'destination-out';\n  for (let i = 0; i < 7; i++) { const a = Math.PI * (0.15 + i * 0.12); x.beginPath(); x.ellipse(128 + Math.cos(a) * 92, 300 - Math.sin(a) * 70, 7, 3.5, a, 0, Math.PI * 2); x.fill(); }\n  x.beginPath(); x.moveTo(118, 262); x.lineTo(128, 248); x.lineTo(138, 262); x.lineTo(128, 276); x.closePath(); x.fill();\n  return c;\n}\n// 前排九個（會說話），後排八個小一點，兩邊各一個靠著台\nconst CROWD_AT = [[-1.02, 0.34, 1.05], [-0.8, 0.5, 1.2], [-0.56, 0.4, 0.95], [-0.3, 0.6, 1.1], [-0.02, 0.5, 1.0], [0.27, 0.6, 1.15], [0.55, 0.4, 0.95], [0.8, 0.52, 1.2], [1.03, 0.34, 1.05],\n  [-0.92, 0.25, 0.8], [-0.68, 0.27, 0.78], [-0.42, 0.28, 0.82], [-0.16, 0.3, 0.76], [0.14, 0.3, 0.8], [0.4, 0.28, 0.78], [0.66, 0.27, 0.82], [0.92, 0.25, 0.8],\n  [-1.22, 0.05, 0.9], [1.22, 0.05, 0.9]];\nfunction buildCrowd(g) {\n  crowdG = new THREE.Group(); crowdG.visible = false; g.add(crowdG);\n  crowd = CROWD_AT.map(([x0, z0, k], i) => {\n    const tex = new THREE.CanvasTexture(silhouetteCv(31 + i * 7)), w = 0.22 * k, h = 0.275 * k;\n    const m = new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshBasicMaterial({ map: tex, transparent: true, alphaTest: 0.4, side: THREE.DoubleSide }));\n    // 往後仰，正面朝著俯看的鏡頭\n    m.rotation.x = -0.62; m.position.set(x0, TOP + h * 0.42, z0); crowdG.add(m);\n    return { m, y0: m.position.y, h, kick: null, phase: i * 1.7, front: i < 9, side: x0 < -0.4 ? 'L' : x0 > 0.4 ? 'R' : 'C' };\n  });\n}\n// 一起起伏：up 叫好往上跳，down 嘘聲往下沉\nfunction crowdKick(kind) {\n  const now = clock ? clock.elapsedTime : 0;\n  crowd.forEach((c, i) => { c.kick = { t0: now + (i % 3) * 0.06 + Math.random() * 0.12, amp: kind === 'down' ? -0.05 : kind === 'big' ? 0.07 : 0.04 }; });\n}\nfunction crowdTick(t) {\n  crowd.forEach(c => {\n    let y = Math.sin(t * 0.9 + c.phase) * 0.004;\n    if (c.kick) {\n      const k = (t - c.kick.t0) / 0.9;\n      if (k > 1) c.kick = null; else if (k > 0) y += c.kick.amp * Math.sin(k * Math.PI) * (c.kick.amp > 0 ? Math.abs(Math.sin(k * Math.PI * 2)) + 0.4 : 1);\n    }\n    c.m.position.y