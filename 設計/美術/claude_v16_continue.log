.position.set(0, 0.13, -0.05); head.add(pin);\n    [-0.02, 0.02].forEach(dx => { const rb = new THREE.Mesh(new THREE.PlaneGeometry(0.018, 0.55), toon(0xa8202b, null, THREE.DoubleSide)); rb.position.set(0.07 + dx, -0.12, -0.04); head.add(rb); ribbons.push(rb); });\n  }\n  if (o.headdress) {\n    const pearl = toon(0xf4efe6), ruby = toon(0xb3202b);\n    for (let i = 0; i < 17; i++) { const a = Math.PI * (0.05 + i * 0.9 / 16); const p = new THREE.Mesh(new THREE.SphereGeometry(i % 4 === 0 ? 0.016 : 0.011, 10, 8), i % 4 === 0 ? ruby : pearl); p.position.set(-Math.cos(a) * 0.11, 0.075 + Math.sin(a) * 0.035, Math.sin(a) * 0.075); head.add(p); }\n    const jewel = new THREE.Mesh(new THREE.SphereGeometry(0.02, 12, 10), ruby); jewel.position.set(0, 0.105, 0.085); head.add(jewel);\n    [-1, 1].forEach(d => { for (let k = 0; k < 5; k++) { const p = new THREE.Mesh(new THREE.SphereGeometry(0.008, 8, 6), pearl); p.position.set(d * 0.105, 0.02 - k * 0.032, 0.02); head.add(p); } });\n  }\n  const arms = [-1, 1].map(side => {\n    const sh = new THREE.Group(); sh.position.set(0.165 * side, 1.31, 0); body.add(sh);\n    const len = 0.52, sg = new THREE.CylinderGeometry(0.048, o.cuff, len, 18, 1, true); sg.translate(0, -len / 2, 0);\n    sh.add(inked(new THREE.Mesh(sg, sleeveM), 0.005));\n    const hand = new THREE.Mesh(new THREE.SphereGeometry(0.028, 12, 10), toon(SKIN)); hand.scale.set(0.8, 1.25, 0.6); hand.position.y = -len + 0.01; sh.add(hand);\n    let ws = null;\n    if (o.waterSleeve) {\n      const g = new THREE.PlaneGeometry(0.15, 0.85, 1, 14); g.translate(0, -0.42, 0);\n      const m = new THREE.Mesh(g, toon(0xf3ede3, null, THREE.DoubleSide)); m.position.y = -len; sh.add(m);\n      ws = { m, base: Float32Array.from(g.attributes.position.array) };\n    }\n    return { sh, ws, side };\n  });\n  const st = { pitch: 0, yaw: 0, lean: 0, aL: [0.12, -0.14], aR: [0.12, 0.14] };\n  const tg = { ...st, aL: [...st.aL], aR: [...st.aR] };\n  let blinkAt = 2 + Math.random() * 3, blinkEnd = 0, resetTimer = null;\n  const fig = {\n    root, head, base: 'idle', expr: { eyes: 'open', smile: false }, layers: [], who: o.who,\n    pose(name) {\n      const B = POSES[this.base], P = POSES[name] || {};\n      tg.pitch = P.pitch ?? B.pitch ?? 0; tg.yaw = P.yaw ?? B.yaw ?? 0; tg.lean = P.lean ?? B.lean ?? 0;\n      tg.aL = [...(P.aL || B.aL || POSES.idle.aL)]; tg.aR = [...(P.aR || B.aR || POSES.idle.aR)];\n    },\n    turn(yaw) { tg.yaw = yaw; },\n    redraw() { drawSphereFace(faceCv, { who: o.who, layers: this.layers, eyes: blinkEnd > 0 ? 'closed' : this.expr.eyes, smile: this.expr.smile }); faceTex.needsUpdate = true; },\n    setLayers(L) { this.layers = L.map(l => ({ f: l.f })); this.redraw(); },\n    perform(f) { this.pose(f); clearTimeout(resetTimer); resetTimer = setTimeout(() => this.pose('idle'), 1200); },\n    react(k) {\n      this.expr = k === 'up' ? { eyes: 'open', smile: true } : k === 'down' ? { eyes: 'down', smile: false } : { eyes: 'open', smile: false };\n      this.pose(k === 'up' ? 'up' : k === 'down' ? 'down' : 'none'); this.redraw();\n      clearTimeout(resetTimer);\n      resetTimer = setTimeout(() => { this.expr = { eyes: 'open', smile: false }; this.pose(this.base); this.redraw(); }, 2400);\n    },\n    update(dt, t) {\n      const k = 1 - Math.exp(-dt * 6);\n      st.pitch += (tg.pitch - st.pitch) * k; st.yaw += (tg.yaw - st.yaw) * k; st.lean += (tg.lean - st.lean) * k;\n      for (let i = 0; i < 2; i++) { st.aL[i] += (tg.aL[i] - st.aL[i]) * k; st.aR[i] += (tg.aR[i] - st.aR[i]) * k; }\n      head.rotation.x = st.pitch + Math.sin(t * 1.3) * 0.015; head.rotation.y = st.yaw * 0.25;\n      root.rotation.y = st.yaw; body.rotation.x = st.lean; body.position.y = Math.sin(t * 1.6) * 0.004;\n      arms[0].sh.rotation.set(st.aL[0], 0, st.aL[1] + Math.sin(t * 1.1) * 0.02);\n      arms[1].sh.rotation.set(st.aR[0], 0, st.aR[1] - Math.sin(t * 1.1) * 0.02);\n      arms.forEach(a => {\n        if (!a.ws) return;\n        const p = a.ws.m.geometry.attrib