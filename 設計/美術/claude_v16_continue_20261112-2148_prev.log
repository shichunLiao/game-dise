i { width: 7px; height: 7px; }\n498\t  .need .lookb { width: 36px; height: 36px; }\n499\t  .need .nr { font-size: 16px; white-space: nowrap; gap: 4px; }\n500\t  .need .nr .lkn { display: none; }\n501\t  .need .nt small { font-size: 11px; }\n502\t  .wb .exam { font-size: 10px; max-width: 9.5em; margin-left: auto; line-height: 1.3; }\n503\t  .plate .d { font-size: 17px; }\n504\t  .plate .g b { font-size: 17px; }\n505\t  /* 手機：家那一塊壓成一條，放在上面那排底下 */\n506\t  .leftcol { bottom: auto; left: 8px; width: auto; max-width: calc(100vw - 16px); flex-direction: row; align-items: stretch; gap: 4px; }\n507\t  .homep { display: flex; align-items: center; gap: 10px; padding: 3px 8px; }\n508\t  .homep .hh { display: none; }\n509\t  .homep .hl { gap: 4px; }\n510\t  .homep .hrow { margin-top: 0; }\n511\t  .tool.bookb { width: auto; }\n512\t  .wb ol { min-width: 0; margin: 1px 0; }\n513\t  .wb li:not(.me) { display: none; }\n514\t  .wb li { font-size: 12px; padding: 0 4px; }\n515\t  .wb .wbh { font-size: 11px; }\n516\t  .tools .tool { padding: 4px 8px; }\n517\t  .homep .hl .lampsvg { width: 28px; height: 28px; }\n518\t  .homep .hl b { font-size: 20px; }\n519\t  .homep .hl small { display: none; }\n520\t  .homep .hrow em { display: none; }\n521\t  .homep .outs i { width: 9px; height: 9px; }\n522\t  .tool.bookb small { display: none; }\n523\t  .slot { height: 28px; font-size: 12px; }\n524\t  .pl { width: 42px; height: 38px; font-size: 14px; }\n525\t  /* 手機：上面那一排放不下三樣，中間那塊（連擊、情報、她的需要）折到第二行 */\n526\t  .top { flex-wrap: wrap; row-gap: 4px; }\n527\t  .topmid { order: 3; flex-basis: 100%; }\n528\t  .lk { width: 8px; }\n529\t  .hand.on { min-height: 128px; }\n530\t  .hc { width: 72px; height: 108px; margin: 0 -4px; }\n531\t  .hc .stain { width: 24px; height: 24px; }\n532\t  .spread { padding: 6px; gap: 6px; }\n533\t  .sub .tx { font-size: 19px; }\n534\t  .sub .gain { font-size: 12px; }\n535\t  .opt { font-size: 20px; }\n536\t  .talk { padding-bottom: 38px; }\n537\t  .title-in { grid-template-columns: minmax(0, 1fr); gap: 18px; margin-left: 0; }\n538\t  .vb { flex-direction: row; justify-content: center; padding: 14px; }\n539\t  .vb .t { writing-mode: horizontal-tb; font-size: 54px; }\n540\t  .vb .s { writing-mode: horizontal-tb; letter-spacing: .2em; }\n541\t  .intro { font-size: 20px; }\n542\t  .title { align-items: flex-start; background: rgba(12, 9, 11, .8); }\n543\t  #peek { gap: 6px; }\n544\t  #peek figure { width: calc((100vw - 38px) / 2); padding: 5px 5px 7px; }\n545\t  #peek img { width: 70%; margin: 0 auto; }\n546\t  #peek figcaption { font-size: 12px; }\n547\t}\n548\t</style>\n549\t\n550\t<canvas id=\"gl\" aria-hidden=\"true\"></canvas>\n551\t<canvas id=\"smear\" aria-hidden=\"true\"></canvas>\n552\t<div id=\"vig\" aria-hidden=\"true\"></div>\n553\t<div id=\"grain\" aria-hidden=\"true\"></div>\n554\t<canvas id=\"stagefx\" aria-hidden=\"true\"></canvas>\n555\t<div id=\"combo\" aria-hidden=\"true\"></div>\n556\t<div class=\"hud\" id=\"hud\" hidden>\n557\t  <div class=\"top\">\n558\t    <div class=\"plate\" id=\"plate\"></div>\n559\t    <div class=\"topmid\" id=\"topmid\"></div>\n560\t    <div class=\"side\"><div class=\"tools\"><button class=\"tool\" data-act=\"music\" id=\"musicBtn\" aria-pressed=\"false\">乐</button><button class=\"tool\" data-act=\"rules\">规矩</button></div><div id=\"wboard\"></div></div>\n561\t  </div>\n562\t  <div class=\"leftcol\" id=\"leftcol\"><div class=\"homep\" id=\"homep\"></div><button class=\"tool bookb\" data-act=\"book\" id=\"bookBtn\">图鉴</button></div>\n563\t  <div class=\"mid\" id=\"mid\"></div>\n564\t  <div class=\"talk\"><div id=\"sub\"></div><div class=\"choices\" id=\"choices\"></div></div>\n565\t  <div class=\"hand\" id=\"hand\"></div>\n566\t  <div class=\"hand-label\" id=\"handLabel\"></div>\n567\t</div>\n568\t<div id=\"title\" class=\"title\" hidden></div>\n569\t<div id=\"watch\" class=\"watch\" hidden></div>\n570\t<div id=\"wipe\" class=\"lastwipe\" hidden></div>\n571\t<div id=\"ink\" aria-hidden=\"true\"></div>\n572\t<div id=\"fx\" aria-hidden=\"true\"></div>\n573\t<div id=\"talkb\" aria-live=\"polite\"></div>\n574\t<div id=\"dice\" hidden></div>\n575\t<div id=\"lampfb\" hidden aria-live=\"polite\"></div>\n576\t<div id=\"coach\" hidden></div>\n577\t<div id=\"peek\" hidden aria-hidden=\"true\"></div>\n578\t<div id=\"tip\" hidden role=\"tooltip\"></div>\n579\t<div id=\"anchors\" aria-hidden=\"true\"></div>\n580\t<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><filter id=\"rough\"><feTurbulence type=\"fractalNoise\" baseFrequency=\".02\" numOctaves=\"3\" seed=\"7\"/><feDisplacementMap in=\"SourceGraphic\" scale=\"70\"/></filter></svg>\n581\t\n582\t<script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n583\t<script>\n584\t/* ENGINE START */"}]},"parent_tool_use_id":null,"session_id":"6a86d5cc-dadd-48d8-88f6-40a0a537648f","uuid":"20f11062-9475-47b2-9164-326e1297eb3f","timestamp":"2026-11-12T13:26:43.444Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.6/index.html","content":".bookd figure { margin: 0; text-align: center; font-size: 12px; color: #5a5156; }\n.bookd figure img { width: 140px; display: block; border-radius: 6px; margin-bottom: 3px; }\n.bookd .bt { flex: 1; min-width: 220px; }\n.bookd h3 { font-family: var(--display); font-weight: 400; font-size: 30px; margin: 0; }\n.bookd h3 small { display: block; font-family: var(--body); font-size: 12px; color: #5a5156; }\n.bookr { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; }\n.bookr li { background: #e0d5c2; padding: 8px 10px; }\n.bookr li.own { box-shadow: inset 0 0 0 2px var(--gold); }\n.bookr b { font-family: var(--display); font-weight: 400; font-size: 20px; margin-right: 6px; }\n.bookr small { color: #5a5156; }\n.bookr p { margin: 4px 0 0; font-size: 13px; }\n.bookr .lore { color: #5a5156; }\n.bookt { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; }\n.bookt dt { font-family: var(--display); font-size: 18px; color: var(--red); }\n.bookt dd { margin: 0; font-size: 14px; }\n.panel .fired { color: var(--red-2); font-family: var(--display); font-size: 22px; }\n.mirrorc { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin: 6px 0; }\n.mirrorc figure { margin: 0; text-align: center; font-size: 12px; color: #5a5156; }\n.mirrorc img { width: 86px; display: block; margin-bottom: 4px; }\n\n/* 最後一次卸妝 */\n.lastwipe { position: fixed; inset: 0; z-index: 26; background: rgba(7, 5, 6, .9); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 16px; }\n.lastwipe .face { position: relative; width: min(340px, 78vw, 54vh); aspect-ratio: 4 / 5; }\n.lastwipe canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n.lastwipe #paint { touch-action: none; cursor: grab; }\n.lastwipe .tx { font-family: var(--display); font-size: 24px; line-height: 1.5; text-align: center; max-width: 24em; }\n.lastwipe .tx2 { font-size: 14px; color: var(--paper-2); text-align: center; max-width: 30em; letter-spacing: .04em; }\n.lastwipe .after { font-family: var(--display); font-size: 22px; line-height: 1.6; color: var(--paper); text-align: center; max-width: 24em; animation: rise 1.4s ease both; }\n\n/* 看牌：放大兩面，每面最多三行 */\n#peek { position: fixed; z-index: 35; pointer-events: none; display: flex; gap: 10px; filter: drop-shadow(0 14px 30px rgba(0, 0, 0, .7)); animation: peekIn .14s ease-out both; }\n#peek figure { margin: 0; width: 196px; background: var(--ink-2); border: 1px solid rgba(184, 145, 63, .45); padding: 8px 8px 10px; opacity: .78; }\n#peek figure.on { opacity: 1; border-color: var(--gold); border-top: 4px solid var(--red); }\n#peek img { width: 100%; aspect-ratio: 2 / 3; display: block; border-radius: 8px; }\n#peek figcaption { margin-top: 7px; font-size: 14px; line-height: 1.55; color: var(--paper); }\n#peek figcaption b { display: block; font-size: 12px; letter-spacing: .2em; color: var(--gold); font-weight: 400; }\n@keyframes peekIn { from { opacity: 0; transform: translateY(6px); } }\n\n/* 教學小框：遮罩挖洞框住要看的東西 */\n#coach { position: fixed; inset: 0; z-index: 34; pointer-events: none; }\n#coach .dim { position: absolute; inset: 0; background: rgba(8, 6, 7, .62); }\n#coach .shield { position: absolute; inset: 0; pointer-events: auto; }\n#coach .ring { position: absolute; border: 2px solid var(--gold); border-radius: 8px; box-shadow: 0 0 0 4px rgba(184, 145, 63, .22), 0 0 26px rgba(216, 67, 76, .55); animation: coachPulse 1.6s ease-in-out infinite; }\n#coach .ring[data-tap]::after { content: attr(data-tap); position: absolute; left: 50%; bottom: calc(100% + 8px); transform: translateX(-50%); background: var(--red); color: var(--paper); font-size: 13px; letter-spacing: .2em; padding: 2px 10px; white-space: nowrap; }\n@keyframes coachPulse { 50% { box-shadow: 0 0 0 9px rgba(184, 145, 63, .1), 0 0 38px rgba(216, 67, 76, .75); } }\n#coach .cbox { position: absolute; pointer-events: auto; width: min(330px, calc(100vw - 32px)); max-height: 60vh; overflow: auto; background: var(--ink-2); color: var(--paper); border: 1px solid rgba(184, 145, 63, .7); border-top: 4px solid var(--red); padding: 10px 14px 10px; box-shadow: 0 16px 44px rgba(0, 0, 0, .65); animation: rise .3s ease both; }\n#coach .cbox h4 { font-family: var(--display); font-weight: 400; font-size: 23px; line-height: 1.3; margin: 0 0 3px; }\n#coach .cbox .tx { font-size: 15px; line-height: 1.7; }\n#coach .cbox .tx b { color: #e8cf8f; }\n#coach .cbox .rule { margin: 8px 0 2px; padding: 2px 0 2px 10px; border-left: 3px solid var(--red); font-family: var(--display); font-size: 19px; line-height: 1.4; color: #f2d48a; }\n#coach .fc { width: 22px; height: 22px; font-size: 15px; vertical-align: -4px; margin: 0 2px; }\n#coach .cbox .row { display: flex; align-items: center; gap: 10px; margin-top: 8px; }\n#coach .cbox .do { font-size: 14px; color: #e8cf8f; letter-spacing: .1em; }\n#coach .cbox .skip { margin-left: auto; background: none; border: none; color: var(--paper-2); font-size: 12px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; min-height: 38px; padding: 0 4px; }\n#coach .arrow { position: absolute; width: 14px; height: 14px; background: var(--ink-2); transform: rotate(45deg); }\n#coach .arrow.up { top: -9px; background: var(--red); }\n#coach .arrow.down { bottom: -8px; border-right: 1px solid rgba(184, 145, 63, .7); border-bottom: 1px solid rgba(184, 145, 63, .7); }\n/* 做的步驟：不壓暗整個畫面，只一句話貼在要點的東西旁邊 */\n#coach.doing .dim { background: rgba(8, 6, 7, .38); }\n#coach.doing .cbox { width: auto; max-width: min(300px, calc(100vw - 32px)); padding: 8px 12px 6px; border-top-width: 3px; }\n#coach.doing .cbox .tx { font-family: var(--display); font-size: 19px; line-height: 1.45; }\n#coach.doing .cbox .row { margin-top: 2px; }\n#coach.doing .cbox .do { display: none; }\n#coach .cbox .step { position: absolute; right: 10px; top: 7px; font-size: 11px; letter-spacing: .1em; color: var(--paper-2); }\n/* 一張牌兩面：台上面翻過來就是家裡面 */\n.flip { display: flex; justify-content: center; margin: 6px 0 4px; perspective: 700px; }\n.flip .fl { position: relative; width: 92px; height: 138px; transform-style: preserve-3d; animation: flip 3.6s ease-in-out infinite; }\n.flip img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 6px; backface-visibility: hidden; box-shadow: 0 6px 14px rgba(0, 0, 0, .5); }\n.flip img.b { transform: rotateY(180deg); }\n.flip .cap { align-self: center; margin-left: 12px; font-size: 13px; line-height: 1.8; color: var(--paper-2); }\n.flip .cap b { color: #f2d48a; font-weight: 400; font-family: var(--display); font-size: 16px; }\n@keyframes flip { 0%, 30% { transform: rotateY(0); } 50%, 80% { transform: rotateY(180deg); } 100% { transform: rotateY(360deg); } }\n/* 小提示：不擋、不用按，貼在新出現的東西旁邊，一次只有一枚 */\n#nudge { position: fixed; z-index: 33; max-width: min(280px, calc(100vw - 24px)); background: rgba(22, 17, 20, .96); color: var(--paper); border-left: 3px solid #f2d48a; padding: 6px 26px 7px 10px; font-size: 14px; line-height: 1.55; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); animation: rise .3s ease both; cursor: pointer; }\n#nudge b { color: #f2d48a; font-weight: 400; font-family: var(--display); font-size: 16px; display: block; }\n#nudge .x { position: absolute; right: 6px; top: 3px; color: var(--paper-2); font-size: 14px; }\n#nudge.out { opacity: 0; transition: opacity .4s ease; }\n\n/* 早上選牌：妝匣的手牌、字幕都縮小，把高度讓給桌上攤開的牌 */\n.hud[data-v=\"morning\"] .hand.on { min-height: 118px; padding-top: 10px; }\n.hud[data-v=\"morning\"] .hc { width: 72px; height: 108px; margin: 0 -2px; }\n.hud[data-v=\"morning\"] .talk { gap: 2px; padding-bottom: 2px; }\n.hud[data-v=\"morning\"] .sub .tx { font-size: 18px; line-height: 1.35; }\n.hud[data-v=\"morning\"] .sub .gain { font-size: 12px; }\n.hud[data-v=\"morning\"] .opt { font-size: 21px; min-height: 40px; }\n.hud[data-v=\"morning\"] .choices { min-height: 40px; }\n.spc .ct { min-width: 28px; height: 28px; font-size: 15px; }\n/* v0.7：她的需要、情報、觀眾的話、後台、水牌小牌 */\nmark.k { background: none; color: #f2d48a; border-bottom: 2px solid rgba(242, 212, 138, .75); padding: 0 1px; }\n.sub mark.k { color: #f6dc96; }\n.panel mark.k, .bub mark.k { color: var(--red); border-bottom-color: rgba(168, 32, 43, .6); }\n.bub.intel mark.k { color: #ffe39a; border-bottom-color: #ffe39a; }\n.itag { display: inline-flex; align-items: center; gap: 6px; font-family: var(--body); font-size: 13px; letter-spacing: .08em; color: #1c1719; background: #f2d48a; padding: 1px 9px; margin-top: 4px; text-shadow: none; }\n.itag b { font-weight: 700; }\n.itag.ev { background: var(--red-2); color: var(--paper); }\n/* 情報簿：記下她（觀眾、玉樓、更夫）說過的需要 */\n.intel { pointer-events: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 6px; max-width: min(640px, 100%); }\n.intel .ic { display: inline-flex; align-items: center; gap: 5px; background: rgba(18, 14, 17, .78); border: 1px solid rgba(242, 212, 138, .7); padding: 1px 8px 1px 4px; font-size: 13px; color: var(--paper); white-space: nowrap; }\n.intel .ic.now { border-color: #f2d48a; box-shadow: 0 0 0 1px #f2d48a inset, 0 0 12px rgba(242, 212, 138, .35); }\n.intel .ic .d { color: #f2d48a; font-size: 12px; letter-spacing: .1em; }\n.intel .ic svg { width: 18px; height: 18px; }\n.intel .ic b { font-weight: 400; color: #f2d48a; }\n.intel .lbl { font-size: 11px; letter-spacing: .3em; color: #1c1719; background: #f2d48a; padding: 1px 6px; align-self: center; }\n/* 傍晚：她今晚的需要與推了幾張 */\n.need { pointer-events: auto; display: flex; align-items: center; gap: 10px; background: rgba(18, 14, 17, .72); border: 1px solid rgba(242, 212, 138, .6); padding: 4px 12px 4px 6px; }\n.need .lookb { width: 52px; height: 52px; }\n.need .nt { font-family: var(--display); font-size: 22px; line-height: 1.2; }\n.need .nt small { display: block; font-family: var(--body); font-size: 12px; color: var(--paper-2); }\n.need .nr { display: flex; align-items: center; gap: 6px; font-size: 19px; line-height: 1.3; }\n.need .nr svg { width: 22px; height: 22px; }\n.need .nr .lkn { font-style: normal; font-size: .72em; color: var(--paper-2); }\n.need .nr .hn { font-weight: 400; color: #f2d48a; }\n.need .nr.ok span:first-of-type { color: #f2d48a; }\n.pips { display: flex; gap: 5px; }\n.pips i { width: 16px; height: 16px; border-radius: 50%; border: 2px solid #f2d48a; }\n.pips i.on { background: #f2d48a; box-shadow: 0 0 10px rgba(242, 212, 138, .8); }\n.need.done { border-color: #f2d48a; box-shadow: 0 0 18px rgba(242, 212, 138, .35); }\n/* 傍晚的焦點就是她要什麼：放大 */\n.need { padding: 6px 18px 6px 8px; }\n.need .nr { font-size: 26px; }\n.need .nr svg { width: 28px; height: 28px; }\n.need .nr .hn { font-size: 1.15em; }\n.need .nt small { font-size: 13px; }\n/* 右上：水牌小牌 */\n.side { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }\n.wb { pointer-events: auto; text-align: right; background: linear-gradient(180deg, #e9dcc4, #d8c8aa); color: var(--ink); border: 1px solid #1d120b; padding: 4px 10px 5px; min-width: 128px; cursor: pointer; font-size: 12px; line-height: 1.45; box-shadow: 0 6px 16px rgba(0, 0, 0, .5); }\n.wb b { font-family: var(--display); font-weight: 400; font-size: 20px; color: var(--red); }\n.wb .gap { display: block; color: #5a5156; }\n.wb .wbh { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 12px; letter-spacing: .1em; }\n.wb ol { list-style: none; margin: 3px 0 2px; padding: 0; min-width: 150px; }\n.wb li { display: flex; justify-content: space-between; gap: 10px; padding: 1px 6px; font-size: 13px; text-align: left; font-variant-numeric: tabular-nums; }\n.wb li .n { color: #5a5156; margin-right: 4px; }\n.wb li.me { background: var(--red); color: var(--paper); font-weight: 700; }\n.wb li.me .n { color: #f2d48a; }\n.wb li.fail { border-top: 1px dashed var(--red); }\n.wb .dif { font-size: 11px; color: #5a5156; display: block; text-align: right; }\n\n/* 觀眾的話：對白框貼著剪紙頭頂 */\n#talkb { position: fixed; inset: 0; pointer-events: none; z-index: 31; }\n.bub { position: absolute; width: max-content; max-width: min(250px, 42vw); background: var(--paper); color: var(--ink); font-family: var(--display); font-size: 18px; line-height: 1.4; padding: 6px 12px 7px; border-radius: 12px; box-shadow: 0 8px 22px rgba(0, 0, 0, .55); transform: translate(-50%, -100%); animation: bubIn .28s cubic-bezier(.2, 1.4, .4, 1) both; }\n.bub::after { content: \"\"; position: absolute; left: var(--ax, 50%); bottom: -9px; width: 16px; height: 16px; background: inherit; transform: translateX(-50%) rotate(45deg); border-radius: 3px; }\n.bub.out { animation: bubOut .35s ease both; }\n.bub .tg { display: block; font-family: var(--body); font-size: 11px; letter-spacing: .3em; margin-bottom: 1px; }\n.bub.intel { background: #1c1417; color: var(--paper); border: 2px solid #f2d48a; box-shadow: 0 0 0 4px rgba(242, 212, 138, .2), 0 0 28px rgba(242, 212, 138, .55), 0 10px 26px rgba(0, 0, 0, .6); font-size: 19px; max-width: min(300px, 46vw); }\n.bub.intel::after { background: #f2d48a; }\n.bub.intel .tg { color: #f2d48a; }\n.bub.ev { background: #f3e6e2; border: 2px solid var(--red-2); }\n.bub.ev .tg { color: var(--red); }\n.bub.boo { background: #3a2a2c; color: #f0d6d6; }\n@keyframes bubIn { from { opacity: 0; transform: translate(-50%, -80%) scale(.7); } to { opacity: 1; transform: translate(-50%, -100%); } }\n@keyframes bubOut { to { opacity: 0; transform: translate(-50%, -115%); } }\n/* 後台 */\n.shop { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 8px; }\n.offer { background: #e0d5c2; padding: 8px; display: flex; flex-direction: column; gap: 6px; align-items: center; text-align: center; }\n.offer img { width: 96px; height: 144px; border-radius: 6px; box-shadow: 0 4px 10px rgba(0, 0, 0, .35); }\n.offer .kw { font-size: 12px; color: #3b3337; line-height: 1.5; min-height: 3em; }\n.offer .pr { font-family: var(--display); font-size: 20px; color: var(--red); }\n.offer.sold { opacity: .5; }\n.offer .pv { font-size: 13px; color: var(--red); min-height: 2.6em; }\n.offer .pv b { font-size: 16px; }\n.offer.isrel { background: #ead9b8; box-shadow: inset 0 0 0 2px #b8913f; }\n.relic { width: 96px; height: 144px; display: flex; align-items: center; justify-content: center; font-family: var(--display); font-size: 64px; color: #f2d48a; background: radial-gradient(circle at 50% 42%, #7d1219 0 38%, #3d0a0e 39% 41%, #1c1417 42%); border: 3px double #b8913f; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, .35); }\n.relics { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 3px; max-width: 150px; }\n.relics .rel { pointer-events: auto; font-family: var(--display); font-size: 15px; color: #f2d48a; background: #5e0f15; border: 1px solid #b8913f; padding: 1px 6px; cursor: help; min-height: 28px; }\n.relics .rel:hover, .relics .rel:focus-visible { background: #7a1620; outline: none; box-shadow: 0 0 0 2px #f2d48a; }\n#tip { position: fixed; z-index: 70; max-width: 280px; background: #1c1719; color: var(--paper); border: 1px solid var(--gold); padding: 8px 11px 9px; font-size: 13px; line-height: 1.55; pointer-events: none; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); }\n#tip b { display: block; font-family: var(--display); font-weight: 400; font-size: 18px; color: #f2d48a; margin-bottom: 2px; }\n.term { font-style: normal; border-bottom: 1px dashed currentColor; cursor: help; pointer-events: auto; }\n#anchors div { position: fixed; pointer-events: none; }\n.purse { display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; color: #3b3337; }\n.purse b { font-family: var(--display); font-weight: 400; font-size: 22px; color: var(--red); margin-left: 4px; }\n.tips li { font-size: 14px; }\n@media (max-width: 760px) {\n  .bub { font-size: 15px; max-width: 46vw; }\n  .hud[data-v=\"morning\"] .hc { width: 54px; height: 81px; margin: 0 -2px; }\n  .hud[data-v=\"morning\"] .hand.on { min-height: 92px; }\n  /* 早上手牌就是妝匣，窄螢幕上不再疊一排小格子 */\n  .bub.intel { font-size: 15px; max-width: 62vw; }\n  .need .nt { font-size: 17px; }\n  .need { gap: 6px; padding: 3px 8px 3px 4px; }\n  .wb { min-width: 0; padding: 3px 7px; }\n  .wb b { font-size: 16px; }\n  .intel .ic { font-size: 12px; }\n  .need .nt { font-size: 18px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .fleck { display: none; }\n  .sub, .watch .w, .watch .w2, .stamp, #peek, #coach .ring, #coach .cbox, .nx, .bub, .bub.intel, #combo .cb, #combo .cs, .gainf { animation: none; }\n  #ink.on { transition-duration: .01s; }\n}\n@media (max-width: 760px) {\n  .plate { min-width: 92px; padding: 5px 8px 6px; }\n  .plate .lm { gap: 1px; margin-top: 3px; padding-top: 3px; }\n  .plate .lm .k2 { flex-direction: column; gap: 1px; align-items: center; }\n  .plate .lm b { font-size: 15px; }\n  .outs { gap: 2px; }\n  .outs i { width: 7px; height: 7px; }\n  .need .lookb { width: 36px; height: 36px; }\n  .need .nr { font-size: 16px; white-space: nowrap; gap: 4px; }\n  .need .nr .lkn { display: none; }\n  .need .nt small { font-size: 11px; }\n  .wb .exam { font-size: 10px; max-width: 9.5em; margin-left: auto; line-height: 1.3; }\n  .plate .d { font-size: 17px; }\n  .plate .g b { font-size: 17px; }\n  /* 手機：家那一塊壓成一條，放在上面那排底下 */\n  .leftcol { bottom: auto; left: 8px; width: auto; max-width: calc(100vw - 16px); flex-direction: row; align-items: stretch; gap: 4px; }\n  .homep { display: flex; align-items: center; gap: 10px; padding: 3px 8px; }\n  .homep .hh { display: none; }\n  .homep .hl { gap: 4px; }\n  .homep .hrow { margin-top: 0; }\n  .tool.bookb { width: auto; }\n  .wb ol { min-width: 0; margin: 1px 0; }\n  .wb li:not(.me) { display: none; }\n  .wb li { font-size: 12px; padding: 0 4px; }\n  .wb .wbh { font-size: 11px; }\n  .tools .tool { padding: 4px 8px; }\n  .homep .hl .lampsvg { width: 28px; height: 28px; }\n  .homep .hl b { font-size: 20px; }\n  .homep .hl small { display: none; }\n  .homep .hrow em { display: none; }\n  .homep .outs i { width: 9px; height: 9px; }\n  .tool.bookb small { display: none; }\n  .slot { height: 28px; font-size: 12px; }\n  .pl { width: 42px; height: 38px; font-size: 14px; }\n  /* 手機：上面那一排放不下三樣，中間那塊（連擊、情報、她的需要）折到第二行 */\n  .top { flex-wrap: wrap; row-gap: 4px; }\n  .topmid { order: 3; flex-basis: 100%; }\n  .lk { width: 8px; }\n  .hand.on { min-height: 128px; }\n  .hc { width: 72px; height: 108px; margin: 0 -4px; }\n  .hc .stain { width: 24px; height: 24px; }\n  .spread { padding: 6px; gap: 6px; }\n  .sub .tx { font-size: 19px; }\n  .sub .gain { font-size: 12px; }\n  .opt { font-size: 20px; }\n  .talk { padding-bottom: 38px; }\n  .title-in { grid-template-columns: minmax(0, 1fr); gap: 18px; margin-left: 0; }\n  .vb { flex-direction: row; justify-content: center; padding: 14px; }\n  .vb .t { writing-mode: horizontal-tb; font-size: 54px; }\n  .vb .s { writing-mode: horizontal-tb; letter-spacing: .2em; }\n  .intro { font-size: 20px; }\n  .title { align-items: flex-start; background: rgba(12, 9, 11, .8); }\n  #peek { gap: 6px; }\n  #peek figure { width: calc((100vw - 38px) / 2); padding: 5px 5px 7px; }\n  #peek img { width: 70%; margin: 0 auto; }\n  #peek figcaption { font-size: 12px; }\n}\n</style>\n\n<canvas id=\"gl\" aria-hidden=\"true\"></canvas>\n<canvas id=\"smear\" aria-hidden=\"true\"></canvas>\n<div id=\"vig\" aria-hidden=\"true\"></div>\n<div id=\"grain\" aria-hidden=\"true\"></div>\n<canvas id=\"stagefx\" aria-hidden=\"true\"></canvas>\n<div id=\"combo\" aria-hidden=\"true\"></div>\n<div class=\"hud\" id=\"hud\" hidden>\n  <div class=\"top\">\n    <div class=\"plate\" id=\"plate\"></div>\n    <div class=\"topmid\" id=\"topmid\"></div>\n    <div class=\"side\"><div class=\"tools\"><button class=\"tool\" data-act=\"music\" id=\"musicBtn\" aria-pressed=\"false\">乐</button><button class=\"tool\" data-act=\"rules\">规矩</button></div><div id=\"wboard\"></div></div>\n  </div>\n  <div class=\"leftcol\" id=\"leftcol\"><div class=\"homep\" id=\"homep\"></div><button class=\"tool bookb\" data-act=\"book\" id=\"bookBtn\">图鉴</button></div>\n  <div class=\"mid\" id=\"mid\"></div>\n  <div class=\"talk\"><div id=\"sub\"></div><div class=\"choices\" id=\"choices\"></div></div>\n  <div class=\"hand\" id=\"hand\"></div>\n  <div class=\"hand-label\" id=\"handLabel\"></div>\n</div>\n<div id=\"title\" class=\"title\" hidden></div>\n<div id=\"watch\" class=\"watch\" hidden></div>\n<div id=\"wipe\" class=\"lastwipe\" hidden></div>\n<div id=\"ink\" aria-hidden=\"true\"></div>\n<div id=\"fx\" aria-hidden=\"true\"></div>\n<div id=\"talkb\" aria-live=\"polite\"></div>\n<div id=\"dice\" hidden></div>\n<div id=\"lampfb\" hidden aria-live=\"polite\"></div>\n<div id=\"coach\" hidden></div>\n<div id=\"peek\" hidden aria-hidden=\"true\"></div>\n<div id=\"tip\" hidden role=\"tooltip\"></div>\n<div id=\"anchors\" aria-hidden=\"true\"></div>\n<svg width=\"0\" height=\"0\" 