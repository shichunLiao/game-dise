orientation: portrait) {","+  .hud { padding-top: max(6px, env(safe-area-inset-top, 0px)); padding-left: max(8px, env(safe-area-inset-left, 0px)); padding-right: max(8px, env(safe-area-inset-right, 0px)); }","+  .top { gap: 6px; row-gap: 4px; align-items: stretch; }","+  .plate { display: flex; align-items: center; gap: 8px; min-width: 0; padding: 3px 9px; }","+  .plate .d { font-size: 17px; white-space: nowrap; }","+  .plate .st { margin-top: 0; font-size: 11px; letter-spacing: 0; gap: 3px; white-space: nowrap; }","+  .plate .st[hidden] { display: none; }","+  .plate .st .fc { width: 22px; height: 22px; font-size: 14px; }","+  .plate .g { margin-top: 0; font-size: 11px; white-space: nowrap; }","+  .plate .g b { font-size: 16px; margin-left: 2px; }","+  .side { flex: 1; min-width: 0; display: flex; flex-direction: row-reverse; align-items: stretch; gap: 6px; }","+  .side .tools { flex: none; align-items: stretch; }","+  .side .tools .tool { min-height: 30px; padding: 2px 7px; }","+  #wboard { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: stretch; gap: 3px; }","+  .wb { width: 100%; padding: 2px 7px 3px; line-height: 1.25; text-align: left; }","+  .wb .wbh { gap: 4px; }","+  .wb .wbh b { font-size: 15px; }","+  .wb ol { display: none; }","+  .wb .dif { display: inline; text-align: left; font-size: 11px; }","+  .wb .exam { display: block; max-width: none; margin-left: 0; font-size: 10px; line-height: 1.2; }","+  .wb .wbh > span { white-space: nowrap; }","+  .relics { max-width: none; justify-content: flex-end; }","+  .topmid { gap: 3px; }","+  .goal { font-size: 19px; padding: 1px 12px; gap: 6px; }","+  .goal .fc { width: 26px; height: 26px; font-size: 15px; }","+  .intel { gap: 3px 4px; }","+  .intel .ic { font-size: 11px; padding: 0 5px 0 3px; gap: 3px; }","+  .intel .ic .d { font-size: 11px; letter-spacing: 0; }","+  .intel .ic svg, .intel .ic .lki { width: 14px; height: 14px; }","+  .intel .lbl { font-size: 10px; letter-spacing: .15em;