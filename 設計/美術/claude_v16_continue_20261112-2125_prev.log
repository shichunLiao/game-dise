0.11 + Math.sin(t * 11) * 0.008; c.L.intensity = c.base * (0.92 + Math.sin(t * 13) * 0.05 + Math.sin(t * 7.3) * 0.03); } });\n  renderer.render(scene, camera);\n}\n// 桌面跟著狀態走：金堆、燈紙、痕、布、油彩漬、她的座位\nfunction updateTable() {\n  if (!glOK || !S) return;\n  const act = actOf(S.day), n = S.lit || S.litAlone ? 12 : Math.min(12, Math.round(S.lamp * 12 / R.lampFull));\n  lampPatches.forEach((p, i) => { p.visible = i < n; });\n  lampScars.forEach((m, i) => { m.visible = i < S.scars; });\n  lampLight.intensity = S.lit || S.litAlone ? 1.7 : 0;\n  stainM.opacity = [0, 0.8, 1][act] * Math.min(1, 0.75 + S.base * 0.1);\n  const z = SEAT_Z[act];\n  stool.position.set(0, 0, z - 0.02);\n  const empty = seatEmpty(S) || !!S.left;\n  wife.root.visible = !empty;\n  if (!empty) wife.root.position.set(0, -0.32, z);\n  // 晾繩上的布、木匣裡的布\n  while (clothG.children.length) clothG.remove(clothG.children[0]);\n  S.rope.slice(-24).forEach((e, i) => {\n    const m = plane(0.13, 0.19, new THREE.MeshBasicMaterial({ color: new THREE.Color(FCOL[e.f]).lerp(new THREE.Color(0xe6ddcf), 0.25), side: THREE.DoubleSide }));\n    m.position.set(-1.6 + i * 0.14, TOP + 0.16, 0.78); m.rotation.z = (i % 2 ? 1 : -1) * 0.05; clothG.add(m);\n  });\n  while (chestG.children.length) chestG.remove(chestG.children[0]);\n  S.chest.slice(-14).forEach((e, i) => { const m = box(0.3, 0.008, 0.2, new THREE.MeshLambertMaterial({ color: FCOL[e.f] })); m.position.y = i * 0.008; m.rotation.y = (i % 3 - 1) * 0.08; chestG.add(m); });\n  // 金箔堆\n  const coins = Math.min(44, Math.round(S.gold / 4));\n  while (goldG.children.length > coins) goldG.remove(goldG.children[goldG.children.length - 1]);\n  const r = rng(61 + goldG.children.length);\n  while (goldG.children.length < coins) { const i = goldG.children.length, m = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.008, 12), new THREE.MeshLambertMaterial({ color: 0xd9b25a, emissive: 0x3a2a08 })); m.position.set((r() - 0.5) * 0.2, 0.005 + i * 0.0035, (r() - 0.5) * 0.14); goldG.add