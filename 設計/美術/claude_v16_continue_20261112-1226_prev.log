er-top: 1px dashed var(--red); }\n435\t.wb .dif { font-size: 11px; color: #5a5156; display: block; text-align: right; }\n436\t\n437\t/* 觀眾的話：對白框貼著剪紙頭頂 */\n438\t#talkb { position: fixed; inset: 0; pointer-events: none; z-index: 31; }\n439\t.bub { position: absolute; width: max-content; max-width: min(250px, 42vw); background: var(--paper); color: var(--ink); font-family: var(--display); font-size: 18px; line-height: 1.4; padding: 6px 12px 7px; border-radius: 12px; box-shadow: 0 8px 22px rgba(0, 0, 0, .55); transform: translate(-50%, -100%); animation: bubIn .28s cubic-bezier(.2, 1.4, .4, 1) both; }\n440\t.bub::after { content: \"\"; position: absolute; left: var(--ax, 50%); bottom: -9px; width: 16px; height: 16px; background: inherit; transform: translateX(-50%) rotate(45deg); border-radius: 3px; }\n441\t.bub.out { animation: bubOut .35s ease both; }\n442\t.bub .tg { display: block; font-family: var(--body); font-size: 11px; letter-spacing: .3em; margin-bottom: 1px; }\n443\t.bub.intel { background: #1c1417; color: var(--paper); border: 2px solid #f2d48a; box-shadow: 0 0 0 4px rgba(242, 212, 138, .2), 0 0 28px rgba(242, 212, 138, .55), 0 10px 26px rgba(0, 0, 0, .6); font-size: 19px; max-width: min(300px, 46vw); }\n444\t.bub.intel::after { background: #f2d48a; }\n445\t.bub.intel .tg { color: #f2d48a; }\n446\t.bub.ev { background: #f3e6e2; border: 2px solid var(--red-2); }\n447\t.bub.ev .tg { color: var(--red); }\n448\t.bub.boo { background: #3a2a2c; color: #f0d6d6; }\n449\t@keyframes bubIn { from { opacity: 0; transform: translate(-50%, -80%) scale(.7); } to { opacity: 1; transform: translate(-50%, -100%); } }\n450\t@keyframes bubOut { to { opacity: 0; transform: translate(-50%, -115%); } }\n451\t/* 後台 */\n452\t.shop { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 8px; }\n453\t.offer { background: #e0d5c2; padding: 8px; display: flex; flex-direction: column; gap: 6px; align-items: center; text-align: center; }\n454\t.offer img { width: 96px; height: 144px; border-radius: 6px; box-shadow: 0 4px 10px rgba(0, 0, 0, .35); }\n455\t.offer .kw { font-size: 12px; color: #3b3337; line-height: 1.5; min-height: 3em; }\n456\t.offer .pr { font-family: var(--display); font-size: 20px; color: var(--red); }\n457\t.offer.sold { opacity: .5; }\n458\t.offer .pv { font-size: 13px; color: var(--red); min-height: 2.6em; }\n459\t.offer .pv b { font-size: 16px; }\n460\t.offer.isrel { background: #ead9b8; box-shadow: inset 0 0 0 2px #b8913f; }\n461\t.relic { width: 96px; height: 144px; display: flex; align-items: center; justify-content: center; font-family: var(--display); font-size: 64px; color: #f2d48a; background: radial-gradient(circle at 50% 42%, #7d1219 0 38%, #3d0a0e 39% 41%, #1c1417 42%); border: 3px double #b8913f; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, .35); }\n462\t.relics { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 3px; max-width: 150px; }\n463\t.relics .rel { pointer-events: auto; font-family: var(--display); font-size: 15px; color: #f2d48a; background: #5e0f15; border: 1px solid #b8913f; padding: 1px 6px; cursor: help; min-height: 28px; }\n464\t.relics .rel:hover, .relics .rel:focus-visible { background: #7a1620; outline: none; box-shadow: 0 0 0 2px #f2d48a; }\n465\t#tip { position: fixed; z-index: 70; max-width: 280px; background: #1c1719; color: var(--paper); border: 1px solid var(--gold); padding: 8px 11px 9px; font-size: 13px; line-height: 1.55; pointer-events: none; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); }\n466\t#tip b { display: block; font-family: var(--display); font-weight: 400; font-size: 18px; color: #f2d48a; margin-bottom: 2px; }\n467\t.term { font-style: normal; border-bottom: 1px dashed currentColor; cursor: help; pointer-events: auto; }\n468\t#anchors div { position: fixed; pointer-events: none; }\n469\t.purse { display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; color: #3b3337; }\n470\t.purse b { font-family: var(--displ