lyphs), document.fonts.load('16px \"Noto Serif SC\"', glyphs)]), wait(3500)]); } catch (e) { /* 字體載不到就用後備字體 */ }\n3638\t  initGL();\n3639\t  saved = load();\n3640\t  if (glOK) {\n3641\t    focus('table', 'night');\n3642\t    wife.base = 'work'; wife.pose('work'); wife.root.position.set(0, -0.32, SEAT_Z[0]); stool.position.set(0, 0, SEAT_Z[0] - 0.02);\n3643\t    actor.root.visible = false;\n3644\t    drawPortrait(mirrorCv, { who: 'you', layers: [], bg: ['#8d9396', '#3b4044'] }); mirrorTex.needsUpdate = true;\n3645\t  }\n3646\t  refresh();\n3647\t})();\n3648\t</script>"}]},"parent_tool_use_id":null,"session_id":"5e9394c0-ca93-4be2-9c50-fc1d55a10765","uuid":"b51271a5-c49e-4d20-bf0a-6ebde120038f","timestamp":"2026-11-12T04:28:26.135Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.5/index.html","content":"  S = newGame(name, ((Date.now() % 2147483647) ^ Math.floor(Math.random() * 2147483647)) >>> 0);\n  S.tut = { off: !tutPref(), seen: {} };\n  saved = null; panel = null; coach.lesson = null;\n  $('#watch').hidden = true;\n  toDay();\n}\nfunction continueGame() {\n  S = saved; saved = null; panel = null; lookOpen = false;\n  S.tut = S.tut || { off: true, seen: {} };\n  coach.lesson = null;\n  view = S.phase; sheet = view === 'board' ? { k: 'board' } : view === 'reveal' ? { k: 'r_board' } : null;\n  placeScene();\n  if (view === 'watch') showWatch();\n  if (view === 'lastwipe') showWipe();\n  say('', `第 ${S.day} 天，接着来。`);\n  refresh();\n}\nconst onDepart = () => run(async () => {\n  depart(S);\n  if (S.phase === 'evening') { await ink(() => { view = 'evening'; placeScene(); }); say('', seatEmpty(S) ? '灯坊里只有你。灯骨搁在桌上。' : '她抬头看见你，没问你怎么没去。她把灯骨推过来。'); return; }\n  stageHeat = 0;\n  await ink(() => { view = 'stage'; placeScene(); actor?.setLayers([]); actor?.pose('idle'); });\n  say('班主', `起手${FAM[starterOf(S)].n}。${S.T.stageMax < R.stageMax ? '今天只有四张。' : ''}`);\n  const k = S.events[S.day];\n  if (k && EV_BUB[k]) setTimeout(() => bubble(EV_BUB[k], 'ev'), 700);\n  // 一上台，台下就有人聊她今晚的事\n  setTimeout(() => { if (view === 'stage' && !S.T.ended) crowdIntel(); }, 1500);\n});\n// 台下聊起她今晚的事：第 1 天在第二張之後，其餘天在第一張之後\nfunction crowdIntel() {\n  const t = S.T;\n  // 第 1 天傍晚是自動的，台下不聊她\n  if (S.day === 1 || t.heard || seatEmpty(S) || S.choice === 'stage' || S.choice === 'lamp') return;\n  if (!hearCrowd(S)) return;\n  const nd = needOf(S);\n  setTimeout(() => {\n    const html = `${CROWD_TX[nd.look]}${nd.items[1] ? `还有人说，${CROWD_B[nd.items[1].look]}` : ''}`;\n    bubble(`${html}<div><span class=\"itag\">今晚她要：${recipeShort(nd)}</span></div>`, 'intel');\n    refresh();\n  }, 650);\n}\nconst onStage = id => run(async () => {\n  const name = tOf(S, id).n, f = fOf(S, id);\n  await fly(id, 'stage');\n  const p = playStage(S, id);\n  if (!p) return;\n  if (actor) { actor.perform(f); actor.setLayers(S.T.layers); }\n  sfx(p.broke ? 'boo' : 'cheer');\n  const tp = tOf(S, id), t = S.T;\n  // 台下：起伏、說話；聚光燈跟著連擊亮起來\n  crowdKick(p.broke ? 'down' : t.chain >= 3 ? 'big' : 'up');\n  stageHeat = p.broke ? 0 : Math.min(2.4, (t.chain - 1) * 0.6);\n  if (glOK && p.broke) { lights.spot.color.setHex(0xff6a5a); setTimeout(() => lights.spot.color.setHex(0xffe0b0), 600); }\n  const pool = p.broke ? CROWD.broke : p.seeped ? CROWD.seep : p.fin ? CROWD.fin : tp.wild && (p.hit || p.open || t.plays.length === 1) ? CROWD.wild : tp.boost && p.hit ? CROWD.boost : tp.clean ? CROWD.clean : tp.heavy ? CROWD.heavy : tp.blank ? CROWD.blank : p.open ? CROWD.open : t.chain >= 3 ? CROWD.big : CROWD.hit;\n  // 第一天只在第一張和接錯時開口；教學框開著也不插嘴\n  if ((S.day > 1 || p.broke || t.plays.length === 1) && !coachOn()) bubble(esc(pick(pool)), p.broke ? 'boo' : 'n');\n  comboFx(p);\n  if (p.broke) say('', p.grudge ? '台下一声低低的嘘，跟着你下了台。' : '台下一声低低的嘘。', p.grudge ? '接错了 · 怨气 +1' : '接错了');\n  else if (p.seeped) say('', '这一层没挂住，直接渗了进去。', p.extra ? `连击 +${p.extra} 金` : '');\n  else if (p.open) sayN(`开得正 +${p.open} 金`);\n  else if (t.plays.length === 1 && tp.wild) sayN('百搭起手');\n  else sayN(`连击 ×${t.chain} · 多 ${p.extra} 金${tp.boost ? '（托）' : ''}${p.fin ? ` · 压轴 +${p.fin}` : ''}${tp.heavy ? ' · 两层' : ''}${tp.clean ? ' · 不上妆' : ''}`);\n  crowdIntel();\n});\nconst onEndStage = () => run(async () => {\n  endStage(S);\n  const t = S.T;\n  if (t.die !== null) await showDice({ label: '连击到 3：掷到 4 以上，金 ×1.5', v: t.die, ok: t.perfect, result: t.perfect ? '完美' : '没中，不扣金' });\n  if (t.gold) { burst(t.gold * 2); sfx('cheer'); crowdKick('big'); }\n  if (t.perfect) { stamp('完美'); bubble(esc(pick(CROWD.perfect)), 'n'); spawn('foil', 140); spawn('ribbon', 8); [0, 300, 600, 900].forEach(d => setTimeout(() => spawn('fw', 70, { x: innerWidth * (0.15 + Math.random() * 0.7), y: innerHeight * (0.1 + Math.random() * 0.25) }), d)); }\n  stageHeat = t.perfect ? 2.4 : 0.6;\n  actor?.pose('bow');\n  const who = S.choice === 'cover' ? `这 ${t.gold} 金，记在小凤名下。` : S.choice === 'stage' ? `元宵，金 ×2：${t.gold} 金。` : '';\n  say('班主', t.plays.length ? (who || `散戏。${t.gold} 金。`) : '今天你没有上台。');\n});\nconst onToDoor = () => run(async () => {\n  parts.length = 0;\n  if (S.phase === 'night') {\n    await ink(() => { view = 'night'; placeScene(); say('', ''); });\n    say('', '元宵的灯笼从窗外过去。你没有回家。', S.T.layers.length ? '剩下的牌还能卸。' : '');\n    return;\n  }\n  await ink(() => { view = 'door'; placeScene(); say('', ''); });\n  if (glOK && S.scars <= R.wipeScarMax && S.T.layers.length && !seatEmpty(S)) wife.pose('reach');\n  if (!S.T.layers.length) say('', '脸是干净的。');\n  else if (S.scars <= R.wipeScarMax) say('阿檀', '回来啦。擦一擦？');\n  else say('', '她坐着，没有起身。');\n});\nconst onWipe = () => run(async () => {\n  if (!canWipe(S)) return;\n  const n = Math.min(R.wipeLayers, S.T.layers.length), cols = S.T.layers.slice(-n).reverse().map(l => FCOL[l.f]);\n  if (glOK) { wife.pose('reach'); await wait(200); }\n  for (const c of cols) await towelSwipe(c);\n  wipe(S); renderSmear(); sfx('cloth');\n  say('阿檀', n === 2 ? '她替你擦掉两层，把毛巾叠起来，收进木匣。' : '她替你擦掉一层，把毛巾收进木匣。', '今晚她只听得下 1 张');\n  if (glOK) wife.pose(wife.base);\n});\nconst restTx = () => (S.T.layers.length ? `还剩 ${S.T.layers.length} 层。` : '脸上干净了。');\nconst onClean = id => run(async () => {\n  const name = tOf(S, id).n;\n  await fly(id, 'cloth');\n  selfClean(S, id); renderSmear(); sfx('cloth');\n  say('', `「${name}」成了一块布，挂上晾绳。${restTx()}`);\n});\nconst onEnter = () => run(async () => {\n  enterHome(S);\n  const t = S.T;\n  if (t.auto) {\n    await ink(() => { view = 'night'; placeScene(); say('', ''); });\n    say('', '她把饭留在桌上，灯又糊了一片。', '灯 +1');\n    await wait(2200);\n    if (t.forecast) { sayH('阿檀', foreTx(t.forecast), intelTag(t.forecast)); refresh(); }\n    // 不自動天亮：玩家看完、想好了，自己點「睡吧」\n    return;\n  }\n  if (t.emptySeat) {\n    await ink(() => { view = 'night'; placeScene(); say('', ''); });\n    say('', '对面的椅子空着。灯不再糊了。', t.layers.length ? '剩下的牌还能卸。' : '');\n    return;\n  }\n  await ink(() => { view = 'evening'; lookOpen = false; placeScene(); say('', ''); });\n  const nd = S.T.need;\n  sayH('阿檀', LOOK_TX[nd.look] + (nd.items[1] ? `“${ALSO_TX[nd.items[1].look]}”` : ''), S.T.dye ? `前 ${S.T.dye} 张会被染` : '');\n});\nconst onHome = id => run(async () => {\n  await fly(id, 'home');\n  const r = playHome(S, id);\n  if (!r) return;\n  if (r.dyed) {\n    wife?.react('down');\n    const txt = r.blank ? '她翻过来看。背面什么也没有。' : HOME[r.h].hurt;\n    say(`${r.name} · 被染`, txt, r.scar ? '灯上留了一道痕' : '这一道不算数');\n  } else if (r.blank) {\n    wife?.react('none');\n    say('空白', '她翻过来看。背面什么也没有。', '灯不涨');\n  } else {\n    wife?.react(r.match ? 'up' : 'none');\n    const nd = S.T.need;\n    say(`${r.name}${r.match ? ' · 对路' : ''}`, r.match ? (r.gift ? '她认出这是她给你的，眼睛亮了一下。' : pick(['她抬眼看你，手上慢了一下。', '她笑了一下，把灯骨转过来给你看。'])) : '她接过去，点点头。可这不是她今晚要的。', `${r.gain ? `灯 +${r.gain}` : '灯不涨'}${r.count === 2 ? ' · 算两张' : ''}`);\n  }\n  updateTable();\n  if (S.T.pushed.length >= S.T.homeCap && S.T.homeCap === R.homeAfterWipe) { await wait(1500); say('', '她累了，只听得下这一张。'); }\n});\n// 燈：十五片紙，每片 2 點；糊滿 30 才算美滿\nconst LSEG = 15, LANG = 360 / LSEG;\nfunction lampSVG(lamp, mark = {}) {\n  const cx = 75, cy = 75, r = 62, seg = [];\n  for (let i = 0; i < LSEG; i++) {\n    const a0 = (-90 + i * LANG) * Math.PI / 180, a1 = (-90 + (i + 1) * LANG) * Math.PI / 180, fill = clamp(lamp - i * 2, 0, 2) / 2;\n    seg.push(`<path class=\"sg ${mark[i] || ''}\" d=\"M${cx} ${cy}L${(cx + r * Math.cos(a0)).toFixed(1)} ${(cy + r * Math.sin(a0)).toFixed(1)}A${r} ${r} 0 0 1 ${(cx + r * Math.cos(a1)).toFixed(1)} ${(cy + r * Math.sin(a1)).toFixed(1)}Z\" fill=\"${fill ? '#c42433' : '#241d1f'}\" opacity=\"${fill && fill < 1 ? 0.55 : 1}\" stroke=\"#b89a5a\" stroke-width=\"1.5\"/>`);\n  }\n  return `<svg class=\"lampsvg\" viewBox=\"0 0 150 150\" aria-hidden=\"true\">${seg.join('')}<circle cx=\"${cx}\" cy=\"${cy}\" r=\"13\" fill=\"#1c1719\" stroke=\"#b89a5a\"/>${lamp >= R.lampFull ? `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r + 4}\" fill=\"none\" stroke=\"#f2d48a\" stroke-width=\"2.5\"/>` : ''}</svg>`;\n}\n// 這幾片紙在兩個燈數之間變了\nconst segsBetween = (a, b) => { const m = {}; for (let i = 0; i < LSEG; i++) if (clamp(a - i * 2, 0, 2) !== clamp(b - i * 2, 0, 2)) m[i] = 1; return m; };\n// 吃完飯當場：燈亮了還是熄了一截，熄了第幾回，還剩幾回她就走\nasync function lampFeedback(t) {\n  const el = $('#lampfb'), now = S.lamp;\n  const from = t.met ? now - t.lampGain : now + t.lampOut;\n  const head = t.met ? `<div class=\"big\">她的需要，满足了</div>` : `<div class=\"big\">灯熄了一截</div>`;\n  const rows = t.met\n    ? `<div class=\"row\">今晚灯 <b>+${t.lampGain}</b>　现在 <b>${now}</b>/${R.lampFull}　（糊满才算美满）</div>${t.gift ? `<div class=\"row\">两晚都对上：她送你一张「${T[t.gift].n}」</div>` : ''}`\n    : `<div class=\"row\">灯 <b>${from}</b> → <b>${now}</b>　熄 ${outsHTML(true)} <b>${S.outs}</b>/${R.brokenOuts}</div><div class=\"warn\">${S.outs >= R.brokenOuts ? '熄满五回了。' : `她今晚要的是 ${recipeShort(t.need)}。再熄 ${R.brokenOuts - S.outs} 回，她就走了。${S.outs === 1 ? '熄过了，这一季到不了美满。' : ''}`}</div>`;\n  el.innerHTML = `<div class=\"lf ${t.met ? '' : 'bad'}\">${head}<div class=\"lp\">${lampSVG(from)}</div>${rows}<button class=\"btn go small lfok\">${t.met ? '好' : '知道了'}</button></div>`;\n  el.hidden = false;\n  sfx(t.met ? 'lit' : 'out');\n  // 看清楚了再點掉：不自動消失\n  const ok = el.querySelector('.lfok'), done = new Promise(res => ok.addEventListener('click', e => { e.stopPropagation(); res(); }, { once: true }));\n  ok.focus({ preventScroll: true });\n  const ch = segsBetween(from, now);\n  if (calm()) el.querySelector('.lp').innerHTML = lampSVG(now);\n  else {\n    await Promise.race([wait(650), done]);\n    if (t.met) el.querySelector('.lp').innerHTML = lampSVG(now, Object.fromEntries(Object.keys(ch).map(i => [i, 'lighting'])));\n    else { el.querySelectorAll('.sg').forEach((p, i) => { if (ch[i]) p.classList.add('dying'); }); await Promise.race([wait(1150), done]); el.querySelector('.lp').innerHTML = lampSVG(now); }\n  }\n  await done;\n  el.hidden = true; el.innerHTML = '';\n}\n// 3D 的燈：熄掉的幾片閃幾下滅了，燈光一暗；亮的時候燈光暖一下\nfunction lamp3D(from, to) {\n  if (!glOK || calm()) return;\n  const nf = Math.min(12, Math.round(from * 12 / R.lampFull)), nt = Math.min(12, Math.round(to * 12 / R.lampFull)), lit = !!(S.lit || S.litAlone);\n  if (to < from) {\n    const fade = lampPatches.slice(nt, nf);\n    let k = 0;\n    const iv = setInterval(() => { k += 1; fade.forEach(p => { p.visible = k % 2 === 0; }); if (k >= 8) { clearInterval(iv); fade.forEach(p => { p.visible = false; }); } }, 150);\n    lampLight.color.setHex(0xff4a32);\n    tween(1300, e => { lampLight.intensity = lit ? 1.7 : 1.3 * (1 - e); }).then(() => lampLight.color.setHex(0xff7a4a));\n  } else tween(1600, e => { lampLight.intensity = lit ? 1.7 : 1.5 * Math.sin(e * Math.PI); });\n}\n// 她走了：痕到 4，或燈熄滿 5 回\nconst LEAVE_TX = { outs: '“灯熄了五回。我一个人，糊不动了。”', scars: '“灯上划了四道。补不回来了。”' };\nasync function herLeaving() {\n  const why = S.outs >= R.brokenOuts ? 'outs' : 'scars';\n  if (glOK) { focus('home', 'night'); wife.react('down'); }\n  say('阿檀', LEAVE_TX[why]);\n  await wait(2800);\n  if (glOK) wife.root.visible = false;\n  sfx('cloth');\n  say('', '她把灯搁在桌上，起身走了。门开着，没关。');\n  banner('她走了', '这一季，到这里为止', 'bad slow');\n  await wait(3200);\n  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n  say('', '屋里只剩你一个人。', '天亮以后，最后一次卸妆。');\n}\nconst onEndEvening = () => run(async () => {\n  const lamp0 = S.lamp;\n  endEvening(S);\n  const t = S.T, look = t.need.look;\n  // 先看她的需要：滿足了，或燈熄一截。當場就看到燈\n  if (t.met) {\n    wife?.react('up');\n    sayH('阿檀', esc(MET_TX[look]), t.gift ? `<span class=\"itag\">她送你一张家常牌「${T[t.gift].n}」：对上她的需要，一张算两张</span>` : '她今晚的需要，满足了');\n  } else {\n    wife?.react('down');\n    sayH('', `${esc(OUT_TX[look])}灯${K('熄了一截')}。`, `没推够（${recipeShort(t.need)}）：灯 −${t.lampOut}，熄了第 ${S.outs} 回`);\n  }\n  if (glOK) focus('lamp', 'home');\n  updateTable(); renderPlate(); lamp3D(lamp0, S.lamp);\n  await lampFeedback(t);\n  if (glOK) focus('home', 'home');\n  if (S.left) { await herLeaving(); return; }\n  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n  const base = t.layers.length ? `镜子里还有 ${t.layers.length} 层，睡一觉就渗进底色。` : '';\n  // 一段的最後一晚：她說起往後兩天\n  if (t.forecast) sayH('阿檀', foreTx(t.forecast), intelTag(t.forecast) + (base ? `<br>${esc(base)}` : ''));\n  else say('', t.layers.length ? `夜里，${base}` : '夜里，镜子里的脸是干净的。');\n});\nconst onLight = () => run(async () => {\n  lightLamp(S);\n  updateTable();\n  if (glOK) focus('home', 'home');\n  say('', S.scars >= R.seatScar ? '你一个人把灯点上了。' : '她把火递给你。你们一起把灯点上了。');\n  await wait(2600);\n  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n  say('', '外面的戏开锣了。你没有去。');\n});\nfunction showWatch() {\n  const w = $('#watch'), l = S.T.watch || { tx: '', hint: '' }; w.hidden = false;\n  sfx('knock');\n  w.innerHTML = `<div class=\"knock\">梆　梆　梆</div><div class=\"w\">${esc(l.tx)}</div>${l.hint ? `<div class=\"w2\">${esc(l.hint)}</div>` : ''}<button class=\"opt\" data-act=\"dawn\">天亮</button>`;\n}\nconst onSleep = () => run(async () => {\n  sleep(S);\n  // 第二幕末：鏡子第一次映出底色，說清楚第三幕會怎樣\n  if (S.day === 7 && !S.left) {\n    if (glOK) { focus('mirror', 'night'); updateMirror(); }\n    say('', '');\n    sheet = { k: 'mirror' };\n    return;\n  }\n  view = 'watch';\n  showWatch();\n});\nconst onMirrorOk = () => { sheet = null; view = 'watch'; showWatch(); refresh(); };\nconst onDawn = () => run(async () => {\n  $('#watch').hidden = true;\n  dawn(S);\n  if (S.phase === 'board') { view = 'board'; sheet = { k: 'board' }; placeScene(); say('', ''); return; }\n  if (S.phase === 'lastwipe') { view = 'lastwipe'; placeScene(); say('', ''); showWipe(); return; }\n  toDay();\n});\nconst onNextAct = () => run(async () => {\n  nextAct(S);\n  // 沒過考核：摘牌，回家最後一次卸妝\n  if (S.phase === 'lastwipe') { sheet = null; await ink(() => { view = 'lastwipe'; placeScene(); say('', ''); }); showWipe(); return; }\n  toDay();\n});\n// ── 最後一次卸妝：她在，就是她替你擦；她走了、座位空了、你沒回家，就是你一個人對著鏡子 ──\nconst lastAlone = () => !!S.left || seatEmpty(S) || S.choice === 'stage' || wifeOf(S) === 2;\nfunction lastIntro(alone) {\n  if (S.left) return '门开着，屋里只有你。你对着镜子，卸今天的妆。';\n  if (S.fired) return alone ? '牌子摘下来了。你对着镜子，卸最后一次妆。' : '牌子摘下来了。这是最后一次卸妆。她拧了一条热毛巾：“我来。”';\n  if (alone && S.choice === 'stage' && !seatEmpty(S) && wifeOf(S) !== 2) return '散了戏回到家，灯是她一个人点的，她已经睡了。你对着镜子，自己卸。';\n  if (alone) return '对面的椅子空着。你对着镜子，自己卸。';\n  return '元宵过了。她拧了一条热毛巾：“最后一回，我替你卸干净。”';\n}\nfunction lastAfter(alone) {\n  const f = FAM[topFams()[0]].n, b = S.base;\n  if (!b) return alone ? '擦干净了。镜子里，是你自己的脸。' : '擦干净了。毛巾上全是红，你脸上什么也没留下。她把这块毛巾叠好，放进木匣，最上面。';\n  if (b < 4) return alone ? `擦到最后，镜子里还有一层淡淡的「${f}」色，擦不掉了。屋里没有人跟你说一句“就这样吧”。` : `擦到最后，还有一层淡淡的「${f}」色，擦不掉了。她停下手：“就这样吧，也是你。”`;\n  return alone ? `擦了很久，镜子里那张脸还是戏里的「${f}」。你分不清，哪一层是自己。` : `毛巾换了三条，那层「${f}」的颜色还在。她看了你很久，把毛巾放下了。`;\n}\nfunction showWipe() {\n  const el = $('#wipe'), alone = lastAlone(), fams = topFams().filter(f => S.played[f] > 0);\n  const use = fams.length ? fams.slice(0, 3) : ['sing'];\n  el.hidden = false; el.dataset.done = '';\n  el.innerHTML = `<div class=\"tx\">${esc(lastIntro(alone))}</div><div class=\"face\"><canvas id=\"clean\" width=\"400\"