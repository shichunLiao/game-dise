orning' && S.day >= 2, tx: () => `<b>水牌</b>你和同门按卖座排名。第 3 天散戏后垫底，就被摘牌。` },\n  book: { at: () => $('#bookBtn'), when: () => view === 'morning' && S.day >= 2 && S.tut.seen.board, tx: () => '<b>图鉴</b>看不懂的牌和词，都在这里。' },\n  crowd: { at: () => $('.bub.intel'), when: () => view === 'stage', tx: () => '<b>台下的话</b>金框那句说的是她今晚要什么，会记在上面那一排。' },\n  wipe: { at: () => $('[data-act=\"wipe\"]'), when: () => view === 'door', tx: () => `<b>让她擦</b>一次擦 ${R.wipeLayers} 层，不耗牌；但今晚她只听得下 1 张。` },\n  stakes: { at: () => $('#homep'), when: () => view === 'night' && S.day >= 2 && !$('#lampfb:not([hidden])'), tx: () => `<b>她会走</b>灯熄满 ${R.brokenOuts} 回，或痕到 ${R.brokenScar} 道。` },\n  shop: { at: () => $('[data-act=\"shop\"]'), when: () => view === 'morning', tx: () => '<b>后台</b>孙师父卖牌和物件。花的就是卖座，名次会掉；越早买越划算。' },\n  wild: { at: () => $('.hc[data-wild].play'), when: () => view === 'stage', tx: () => '<b>百搭</b>前后都接得上，还能起手。链要断的时候用它。' },\n  grudge: { at: () => $('.nowline'), when: () => view === 'stage' && S.T.grudge > 0, tx: () => '<b>怨气</b>接错了，嘘声跟你回家：今晚多染一张牌。' },\n  gift: { at: () => $('.spread .spc[data-t^=\"home_\"]') || $('.spread'), when: () => view === 'morning' && S.gifts.length > 0 && !lockedBox(S), tx: () => '<b>家常牌</b>她送的，不上台。对上她的需要，一张算两张。' },\n};\nconst coach = { lesson: null, i: 0, shown: '' };\nfunction lessonNow() {\n  if (panel || sheet) return null;\n  const d = S.day, t = S.T;\n  if (view === 'stage') {\n    if (d !== 1) return null;\n    if (t.ended) return null;\n    return !t.plays.length ? 'open' : t.plays.length === 1 ? 'chain' : t.plays.length < 4 && !t.plays.some(p => p.broke) ? 'chain2' : t.plays.length >= 4 ? 'end' : null;\n  }\n  if (d === 1 && view === 'door' && t.layers.length) return 'door';\n  if (d === 1 && view === 'night') return 'home';\n  if (d === 2 && view === 'evening' && t.pushed.length === 0) return 'need';\n  if (view === 'morning' && !lockedBox(S) && d === 3) return 'pick';\n  if (view === 'morning' && d === 2) return 'intel';\n  return null;\n}\nfunction coachStart(k) { coach.lesson = k; coach.i = 0; coach.shown = ''; coach.view = view; }\nfunction coachNext() {\n  if (!coach.lesson) return;\n  coach.i += 1;\n  if (coach.i < LESSONS[coach.lesson].length) return;\n  S.tut.seen[coach.lesson] = true;\n  coach.lesson = null;\n  if ([...Object.keys(LESSONS), ...Object.keys(NUDGES)].every(k => S.tut.seen[k])) setTutPref(false);\n}\nfunction coachSkip() { S.tut.off = true; coach.lesson = null; setTutPref(false); nudgeHide(true); }\n// 狀態一變就看一次：要玩家做的事做到了就往下；這個時段還沒教過就開始教\nfunction coachTick() {\n  if (busy || !S || view === 'title' || !S.tut) return;\n  for (let n = 0; n < 4; n++) {\n    if (coach.lesson) {\n      // 換了場景：這一課就算教完了，不跟著帶過去\n      if (view !== coach.view) { S.tut.seen[coach.lesson] = true; coach.lesson = null; continue; }\n      const st = LESSONS[coach.lesson][coach.i];\n      if (!st.until || !st.until()) return;\n      coachNext();\n    } else {\n      const k = lessonNow();\n      if (!k || S.tut.off || S.tut.seen[k]) return nudgeTick();\n      coachStart(k);\n    }\n  }\n}\nfunction coachRender(geom = false) {\n  const el = $('#coach'), on = !!S && !!coach.lesson && !busy && view !== 'title' && panel !== 'rules';\n  $('#hud').inert = false;\n  if (!on) { el.hidden = true; return; }\n  const steps = LESSONS[coach.lesson], st = steps[coach.i], key = `${coach.lesson}:${coach.i}`;\n  const els = st.at ? st.at().filter(x => x && x.getClientRects().length) : [];\n  const act = !!st.until && els.length > 0 && !(st.read && st.read());\n  if (coach.shown !== key && st.on) st.on();\n  if (coach.shown !== key && els[0] && !els[0].closest('#anchors')) els[0].scrollIntoView({ block: 'nearest', inline: 'center' });\n  let r = null;\n  els.forEach(x => { const b = x.getBoundingClientRect(); r = r ? { l: Math.min(r.l, b.left), t: Math.min(r.t, b.top), r: Math.max(r.r, b.right), b: Math.max(r.b, b.bottom) } : { l: b.left, t: b.top, r: b.right, b: b.bottom }; });\n  const W = innerWidth, H = innerHeight, pad = act ? 5 : 8;\n  if (r