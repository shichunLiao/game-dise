{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"Exit code 1\n// 用法：node drive.js <url> <outprefix> <stepsFile.js> [w] [h]\n// stepsFile 匯出一個陣列：每步 { js?: string|fn, click?: selector, wait?: ms, shot?: name }\nconst { chromium } = require('/tmp/dise-qa/node_modules/playwright-core');\n(async () => {\n  const [url, prefix, stepsFile, w = '1440', h = '900'] = process.argv.slice(2);\n  const steps = require(stepsFile);\n  const browser = await chromium.launch({ executablePath: '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', headless: true, args: ['--use-angle=metal', '--ignore-gpu-blocklist'] });\n  const ctx = await browser.newContext({ viewport: { width: +w, height: +h }, deviceScaleFactor: 1 });\n  const page = await ctx.newPage();\n  const logs = [];\n  page.on('console', m => { if (m.type() !== 'log' || /ART|v16/.test(m.text())) logs.push(`[${m.type()}] ${m.text()}`); });\n  page.on('pageerror', e => logs.push(`[pageerror] ${e.message}`));\n  page.on('requestfailed', r => logs.push(`[reqfail] ${decodeURI(r.url())} ${r.failure()?.errorText}`));\n  page.on('response', r => { if (r.status() >= 400 && !/favicon/.test(r.url())) logs.push(`[http ${r.status()}] ${decodeURI(r.url())}`); });\n  await page.goto(url, { waitUntil: 'load' });\n  await page.waitForTimeout(+(process.env.BOOT || 4500));\n  for (const s of steps) {\n    try {\n      if (s.js) { const r = await page.evaluate(s.js); if (r !== undefined) console.log('eval:', typeof r === 'string' ? r.slice(0, 3000) : JSON.stringify(r).slice(0, 3000)); }\n      if (s.click) await page.click(s.click, { timeout: 4000 });\n      if (s.wait) await page.waitForTimeout(s.wait);\n      if (s.shot) { await page.screenshot({ path: `${prefix}${s.shot}.png` }); console.log('shot', `${prefix}${s.shot}.png`); }\n    } catch (e) { console.log('step error', JSON.stringify(s).slice(0, 120), e.message.split('\\n')[0]); }\n  }\n  console.log(logs.join('\\n'));\n  await browser.close();\