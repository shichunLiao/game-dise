26, hw, 58, 0, 0, Math.PI * 2); x.fill();\n  // 帽子、髮髻、斗笠、辮子、花\n  if (kind === 0) { x.beginPath(); x.ellipse(128, 82, 52, 30, 0, Math.PI, 0); x.fill(); x.beginPath(); x.arc(128, 50, 9, 0, Math.PI * 2); x.fill(); }\n  if (kind === 1) { x.beginPath(); x.ellipse(128, 64, 34, 26, 0, 0, Math.PI * 2); x.fill(); x.fillRect(150, 52, 44, 5); }\n  if (kind === 2) { x.beginPath(); x.moveTo(36, 96); x.lineTo(128, 36); x.lineTo(220, 96); x.closePath(); x.fill(); }\n  if (kind === 3) { x.lineWidth = 12; x.beginPath(); x.moveTo(170, 150); x.quadraticCurveTo(206, 220, 194, 300); x.stroke(); }\n  if (kind === 4) { for (let i = 0; i < 5; i++) { const a = i * Math.PI * 2 / 5; x.beginPath(); x.ellipse(92 + Math.cos(a) * 14, 70 + Math.sin(a) * 14, 10, 6, a, 0, Math.PI * 2); x.fill(); } }\n    x.restore();\n  };\n  // 先一層紅紙稍大一點，再一層黑紙：剪紙的紅邊\n  shape('#b3202c', 0.045); shape('#0b0809', 0);\n  // 剪紙的鏤空：一圈小窗花\n  x.globalCompositeOperation = 'destination-out';\n  for (let i = 0; i < 7; i++) { const a = Math.PI * (0.15 + i * 0.12); x.beginPath(); x.ellipse(128 + Math.cos(a) * 92, 300 - Math.sin(a) * 70, 7, 3.5, a, 0, Math.PI * 2); x.fill(); }\n  x.beginPath(); x.moveTo(118, 262); x.lineTo(128, 248); x.lineTo(138, 262); x.lineTo(128, 276); x.closePath(); x.fill();\n  return c;\n}\n// 前排九個（會說話），後排八個小一點，兩邊各一個靠著台\nconst CROWD_AT = [[-1.02, 0.34, 1.05], [-0.8, 0.5, 1.2], [-0.56, 0.4, 0.95], [-0.3, 0.6, 1.1], [-0.02, 0.5, 1.0], [0.27, 0.6, 1.15], [0.55, 0.4, 0.95], [0.8, 0.52, 1.2], [1.03, 0.34, 1.05],\n  [-0.92, 0.25, 0.8], [-0.68, 0.27, 0.78], [-0.42, 0.28, 0.82], [-0.16, 0.3, 0.76], [0.14, 0.3, 0.8], [0.4, 0.28, 0.78], [0.66, 0.27, 0.82], [0.92, 0.25, 0.8],\n  [-1.22, 0.05, 0.9], [1.22, 0.05, 0.9]];\n// v1.6：剪紙觀眾圖（純黑剪影）→ 加紅紙邊：只沿外輪廓（從邊上灌水分出外面），鏤空保持透明；底邊切齊不留邊\nconst CROWD_PAD = 8, CROWD_RIM = 5, crowdTex = {};\nfunction crowdCv(im) {\n  const P = CROWD_PAD, iw = Math.round(im.width / 2), ih = Math.round(im.height / 2), W = iw + P * 2, H = ih + P, N = W * H;\n  const c = document.createElement('canvas'); c.width = W; c.height = H;\n  const x = c.getContext('2d'); x.imageSmoothingQuality = 'high'; x.drawImage(im, P, P, iw, ih);\n  const img = x.getImageData(0, 0, W, H), d = img.data, out = new Uint8Array(N), q = new Int32Array(N);\n  let qh = 0, qt = 0;\n  const push = i => { if (!out[i] && d[i * 4 + 3] < 128) { out[i] = 1; q[qt++] = i; } };\n  for (let X = 0; X < W; X++) { push(X); push((H - 1) * W + X); }\n  for (let y = 0; y < H; y++) { push(y * W); push(y * W + W - 1); }\n  while (qh < qt) { const i = q[qh++], X = i % W; if (X > 0) push(i - 1); if (X < W - 1) push(i + 1); if (i >= W) push(i - W); if (i < N - W) push(i + W); }\n  // 外面每一點到剪影的距離（兩趟倒角），近的染成紅紙\n  const dist = new Float32Array(N);\n  for (let i = 0; i < N; i++) dist[i] = out[i] ? 1e6 : 0;\n  for (let y = 0; y < H; y++) for (let X = 0; X < W; X++) {\n    const i = y * W + X; if (!dist[i]) continue; let m = dist[i];\n    if (X > 0) m = Math.min(m, dist[i - 1] + 1);\n    if (y > 0) { m = Math.min(m, dist[i - W] + 1); if (X > 0) m = Math.min(m, dist[i - W - 1] + 1.414); if (X < W - 1) m = Math.min(m, dist[i - W + 1] + 1.414); }\n    dist[i] = m;\n  }\n  for (let y = H - 1; y >= 0; y--) for (let X = W - 1; X >= 0; X--) {\n    const i = y * W + X; if (!dist[i]) continue; let m = dist[i];\n    if (X < W - 1) m = Math.min(m, dist[i + 1] + 1);\n    if (y < H - 1) { m = Math.min(m, dist[i + W] + 1); if (X < W - 1) m = Math.min(m, dist[i + W + 1] + 1.414); if (X > 0) m = Math.min(m, dist[i + W - 1] + 1.414); }\n    dist[i] = m;\n  }\n  for (let i = 0; i < N; i++) {\n    if (!out[i]) continue;\n    const a = Math.max(0, Math.min(1, CROWD_RIM + 0.5 - dist[i]));\n    if (!a) continue;\n    const k = i * 4, a0 = d[k + 3] / 255;\n    d[k] = Math.round(0xb3 * (1 - a0) + d[k] * a0); d[k + 1] = Math.round(0x20 * (1 - a0) + d[k + 1] * a0); d[k + 2] = Math.round(0x2c * (1 - a0) + d[k + 2] * a0);\n    d[k + 3] = Math.round(255 * Math.max(a, a0));\n  }\n  x.putImageData(img, 0, 0);\n  return c;\n}\nfunction crowdTexOf(