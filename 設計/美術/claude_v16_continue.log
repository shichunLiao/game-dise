ch + Math.sin(t * 1.3) * 0.015; head.rotation.y = st.yaw * 0.25;\n      root.rotation.y = st.yaw; body.rotation.x = st.lean; body.position.y = Math.sin(t * 1.6) * 0.004;\n      arms[0].sh.rotation.set(st.aL[0], 0, st.aL[1] + Math.sin(t * 1.1) * 0.02);\n      arms[1].sh.rotation.set(st.aR[0], 0, st.aR[1] - Math.sin(t * 1.1) * 0.02);\n      arms.forEach(a => {\n        if (!a.ws) return;\n        const p = a.ws.m.geometry.attributes.position, b = a.ws.base;\n        for (let i = 0; i < p.count; i++) { const y = b[i * 3 + 1]; p.setZ(i, b[i * 3 + 2] + Math.sin(t * 3 + y * 7 + a.side) * 0.09 * -y); p.setX(i, b[i * 3] + Math.sin(t * 2 + y * 5) * 0.03 * -y); }\n        p.needsUpdate = true;\n      });\n      ribbons.forEach((rb, i) => { rb.rotation.x = Math.sin(t * 1.4 + i) * 0.08; rb.rotation.z = Math.sin(t * 0.9 + i * 2) * 0.05; });\n      if (o.who === 'wife' && root.visible) {\n        if (blinkEnd > 0 && t > blinkEnd) { blinkEnd = 0; this.redraw(); }\n        else if (blinkEnd === 0 && t > blinkAt) { if (this.expr.eyes === 'open' && !calm()) { blinkEnd = t + 0.13; this.redraw(); } blinkAt = t + 2.5 + Math.random() * 3; }\n      }\n    },\n  };\n  fig.pose('idle'); fig.redraw();\n  return fig;\n}\nfunction candle(g, x0, y0, z0) {\n  const c = new THREE.Mesh(new THREE.CylinderGeometry(0.022, 0.025, 0.14, 12), toon(0xefe6d6)); c.position.set(x0, y0 + 0.07, z0); g.add(inked(c, 0.004));\n  const fl = new THREE.Sprite(new THREE.SpriteMaterial({ map: softDot(), color: 0xffb35a, blending: THREE.AdditiveBlending, depthWrite: false })); fl.scale.set(0.07, 0.11, 1); fl.position.set(x0, y0 + 0.17, z0); g.add(fl);\n  const L = new THREE.PointLight(0xffb066, 1.1, 3.2, 2); L.position.set(x0, y0 + 0.25, z0); g.add(L);\n  return { fl, L };\n}\nfunction curtain(w, h, color, seed) {\n  const geo = new THREE.PlaneGeometry(w, h, 36, 1), p = geo.attributes.position;\n  for (let i = 0; i < p.count; i++) p.setZ(i, Math.sin(p.getX(i) * 9 + seed) * 0.07 + Math.sin(p.getX(i) * 23) * 0.02);\n  g