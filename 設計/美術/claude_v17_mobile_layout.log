教學框要指著它\\nfunction anchor(name, at, w = 150, h = 150) {\\n  let el = document.getElementById(`anc-${name}`);\\n  if (!el) { el = document.createElement('div'); el.id = `anc-${name}`; $('#anchors').appendChild(el); }\\n  if (!glOK) { el.style.display = 'none'; return null; }\\n  const v = at.clone().project(camera);\\n  if (v.z > 1 || Math.abs(v.x) > 0.95 || Math.abs(v.y) > 0.95) { el.style.display = 'none'; return null; }\\n  const x = (v.x + 1) / 2 * innerWidth, y = (1 - v.y) / 2 * innerHeight;\\n  Object.assign(el.style, { display: 'block', left: `${x - w / 2}px`, top: `${y - h / 2}px`, width: `${w}px`, height: `${h}px` });\\n  // v1.7：連擊 3 起紙屑從兩側台口灑下；滿堂紅（×4）再多一陣、金箔彩綢更滿，台下的熱度拉高\\n  if (n >= 3) { spawn('petal', 70 + (n - 3) * 60); const b = COMBO_TX[Math.min(n, 5)]; banner(b[0], b[1], n >= 4 ? 'big' : ''); stageHeat = Math.max(stageHeat, 0.8 + (n - 3) * 0.6); bubble(esc(pick(n >= 4 ? CROWD.hot : CROWD.big)), 'n'); }\\n  if (n >= 4) { spawn('foil', 130); spawn('ribbon', 10); [260, 620].forEach(d => setTimeout(() => { spawn('petal', 90); spawn('foil', 50); }, d)); burst(40); if (glOK && camPos) camPos.lerp(camAim, 0.08); }\\n  if (n >= 5) [0, 350, 700].forEach(d => setTimeout(() => spawn('fw', 60, { x: innerWidth * (0.2 + Math.random() * 0.6), y: innerHeight * (0.12 + Math.random() * 0.2) }), d));\\n}\\nasync function run(fn) { if (busy) return; busy = true; refresh(); try { await fn(); } finally { busy = false; refresh(); } }\\n\\n// ── 一天 ──\\n// 依目前時段擺桌面（開局、接著玩都走這裡）\\nfunction placeScene() {\\n  if (view !== 'stage') { clearBubs(); stageHeat = 0; }\\n  if (!glOK) return;\\n  const lk = lookNow(S);\\n  const v = { morning: ['table', 'day'], stage: ['stage', 'stage'], door: ['door', 'door'], evening: ['home', 'home'], night: ['night', 'night'], watch: ['night', 'night'], board: ['table', 'day'], lastwipe: ['mirror', 'night'], reveal: ['home', 'home'] }[view] || ['table', 'day'];\\n  focus(v[0], v[1]);\\n  const base = lk && (view === 'evening' || view === 'morning')