ics.push('bangu'); ['changqiang', 'bai', 'shenduan'].forEach(t => E.playStage(Z, take(Z, t))); E.endStage(Z); return Z; };\\n  const d0 = drum(false), d1 = drum(true);\\n  ok(d1.T.drumGold === 3 && d1.T.gold - d0.T.gold === 3, `班鼓：連擊 3 收場 +3 金（${d0.T.gold} → ${d1.T.gold}）`);\\n  const fen = has => { const Z = E.newGame('测', 47); if (has) Z.relics.push('xiangfen'); ['changqiang', 'bai', 'shenduan', 'liangxiang'].forEach(t => E.playStage(Z, take(Z, t))); E.endStage(Z); E.wipe(Z); Z.phase = 'night'; E.sleep(Z); return Z.base; };\\n  ok(fen(false) === 2 && fen(true) === 1, '香粉：擦過的那晚，滲進底色少 1');\\n  const fen0 = (() => { const Z = E.newGame('测', 48); Z.relics.push('xiangfen'); ['changqiang', 'bai'].forEach(t => E.playStage(Z, take(Z, t))); E.endStage(Z); Z.phase = 'night'; E.sleep(Z); return Z.base; })();\\n  ok(fen0 === 2, '香粉：沒用保底擦臉就沒效');\\n  // 有代價的牌\\n  const Cy = E.newGame('测', 49); Cy.day = 5; E.beginDay(Cy); Cy.phase = 'stage';\\n  const addC = t => { const c = { id: Cy.nid++, t }; Cy.deck.push(c); Cy.T.box.push(c.id); return c.id; };\\n  Cy.T.box = [];\\n  const st0 = Object.keys(E.T).find(k => E.T[k].f === E.starterOf(Cy) && !E.T[k].home && !E.T[k].blank && !E.T[k].price);\\n  E.playStage(Cy, addC(st0));\\n  const pY = E.playStage(Cy, addC('shuaya'));\\n  ok(pY.riled && Cy.T.grudge >= 1, '耍牙：打出記一點怨氣');\\n  E.playStage(Cy, addC('shuaifa'));\\n  ok(Cy.T.homeCap === 2, '甩髮：今晚少推一張');\\n\\n  // 第 1 天傍晚自動\\\"\\\"\\\")\\nrep(\\\"const RV = { qinshi: 3.6, gujing: 3, cha: 2.2, lian: 1.8, jin: 1.2, you: 0, luo: 0.6 };\\\", \\\"const RV = { qinshi: 3.6, gujing: 3, cha: 2.2, lian: 1.8, jin: 1.2, you: 0, luo: 0.6, bangu: 2.2, xiangfen: 0.3, zhezi: 0.5 };\\\")\\nrep(\\\"const RV = { qinshi: 3.5, gujing: 3, cha: 2.5, lian: 2, jin: 1.6, you: o.shop === 'stage' ? 0 : 1.5, luo: 0.8 };\\\", \\\"const RV = { qinshi: 3.5, gujing: 3, cha: 2.5, lian: 2, jin: 1.6, you: o.shop === 'stage' ? 0 : 1.5, luo: 0.8, bangu: 2.4, xiangfen: 0.5, zhezi: 0.8 };\\\")\\nopen(p,'w',encoding='utf8').wri