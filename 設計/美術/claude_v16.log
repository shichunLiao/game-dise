ntinue;\n2124\t    nudgeShow(k);\n2125\t    return;\n2126\t  }\n2127\t}\n2128\tfunction nudgeShow(k) {\n2129\t  nudge.k = k;\n2130\t  S.tut.seen[k] = true;\n2131\t  let el = $('#nudge');\n2132\t  if (!el) { el = document.createElement('div'); el.id = 'nudge'; el.setAttribute('role', 'note'); document.body.appendChild(el); el.addEventListener('click', () => nudgeHide()); }\n2133\t  el.className = '';\n2134\t  el.hidden = false;\n2135\t  el.innerHTML = `${NUDGES[k].tx()}<span class=\"x\" aria-hidden=\"true\">×</span>`;\n2136\t  nudgePlace();\n2137\t  clearTimeout(nudge.timer);\n2138\t  nudge.timer = setTimeout(() => nudgeHide(), 9000);\n2139\t}\n2140\tfunction nudgeHide(now = false) {\n2141\t  const el = $('#nudge');\n2142\t  clearTimeout(nudge.timer);\n2143\t  nudge.k = null;\n2144\t  if (!el) return;\n2145\t  if (now) { el.hidden = true; return; }\n2146\t  el.classList.add('out');\n2147\t  setTimeout(() => { if (!nudge.k) el.hidden = true; nudgeTick(); }, 420);\n2148\t}\n2149\t// 貼在目標旁邊：下面空就放下面，不然放上面；目標不見了就收\n2150\tfunction nudgePlace() {\n2151\t  const el = $('#nudge');\n2152\t  if (!el || el.hidden || !nudge.k) return;\n2153\t  const n = NUDGES[nudge.k], tg = n.at();\n2154\t  if (!tg || !tg.getClientRects().length || !n.when() || coach.lesson || panel || sheet) { nudgeHide(true); return; }\n2155\t  const r = tg.getBoundingClientRect(), w = el.offsetWidth, h = el.offsetHeight;\n2156\t  const below = innerHeight - r.bottom > h + 16;\n2157\t  const top = below ? r.bottom + 8 : r.top - h - 8;\n2158\t  const left = clamp((r.left + r.right) / 2 - w / 2, 12, innerWidth - w - 12);\n2159\t  Object.assign(el.style, { left: `${left}px`, top: `${clamp(top, 8, innerHeight - h - 8)}px` });\n2160\t}\n2161\tsetInterval(() => { if (nudge.k) nudgePlace(); else if (!coach.lesson) nudgeTick(); }, 400);\n2162\taddEventListener('resize', () => { if (coach.lesson) coachRender(); });\n2163\t// 指著 3D 東西的步驟：鏡頭在動，框跟著挪\n2164\t// 只在鏡頭真的挪了位置時重畫，免得說明框一直重播淡入\n2165\tlet followSig = '';\n2166\tset