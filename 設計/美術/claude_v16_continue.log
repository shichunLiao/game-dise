 (let j = 0; j < N; j++) {\n    const s0 = j / N * L, s1 = (j + 1) / N * L;\n    if (s0 > len) break;\n    const xa = p.side < 0 ? s0 : W - s0, xb = p.side < 0 ? s1 : W - s1, ya = yAt(s0), yb = yAt(s1);\n    fxx.save(); fxx.translate(xa, ya); fxx.rotate(Math.atan2(yb - ya, xb - xa));\n    fxx.drawImage(img, bx + bw * j / N, by, bw / N, bh, 0, -th / 2, Math.hypot(xb - xa, yb - ya) + 1.5, th);\n    fxx.restore();\n  }\n}\nfunction fxSize() {\n  const d = Math.min(devicePixelRatio || 1, 2);\n  if (fxc.width !== Math.round(innerWidth * d) || fxc.height !== Math.round(innerHeight * d)) { fxc.width = Math.round(innerWidth * d); fxc.height = Math.round(innerHeight * d); }\n  fxx.setTransform(d, 0, 0, d, 0, 0);\n}\nfunction spawn(kind, n, o = {}) {\n  if (calm()) return;\n  if (view !== 'stage' && ['fw', 'foil', 'ribbon', 'petal'].includes(kind)) return;\n  fxSize();\n  const W = innerWidth, H = innerHeight;\n  for (let i = 0; i < n; i++) {\n    const p = { kind, t: 0, rot: Math.random() * 6.28, vr: (Math.random() - 0.5) * 9, col: pick(FXCOL[kind] || FXCOL.petal) };\n    if (kind === 'petal' || kind === 'foil') { p.x = Math.random() * W; p.y = -20 - Math.random() * H * 0.5; p.vx = (Math.random() - 0.5) * 70; p.vy = (kind === 'foil' ? 190 : 110) + Math.random() * 100; p.s = kind === 'foil' ? 5 + Math.random() * 7 : 7 + Math.random() * 9; p.life = 3.6; p.sw = Math.random() * 6.28; }\n    else if (kind === 'spark' || kind === 'fw') { const a = Math.random() * 6.28, v = (kind === 'fw' ? 180 : 120) + Math.random() * (kind === 'fw' ? 280 : 220); p.x = o.x; p.y = o.y; p.vx = Math.cos(a) * v; p.vy = Math.sin(a) * v - 70; p.s = 2 + Math.random() * 3; p.life = 0.7 + Math.random() * 0.6; }\n    else if (kind === 'ink') { const a = Math.random() * 6.28, v = 70 + Math.random() * 280; p.x = o.x; p.y = o.y; p.vx = Math.cos(a) * v; p.vy = Math.sin(a) * v - 90; p.s = 3 + Math.random() * 8; p.life = 0.9 + Math.random() * 0.5; }\n    else if (kind === 'ribbon') { p.side = i % 2 ? 1 : -1; p.y0 = H * (0.12 + Math.random() * 0.4); p.life = 2; p.ph = Math.random() * 6.28; p.col = i % 3 === 2 ? '#f2d48a' : '#c8283a'; p.w = 6 + Math.random() * 5; }\n    // 燒紙：燈熄、倒彩時從那裡飄下來，慢慢落\n    else if (kind === 'burnt') { p.x = o.x + (Math.random() - 0.5) * (o.w || 80); p.y = o.y + (Math.random() - 0.5) * 30; p.vx = (Math.random() - 0.5) * 60; p.vy = -40 + Math.random() * 50; p.s = 8 + Math.random() * 8; p.life = 2.2 + Math.random() * 0.9; p.sw = Math.random() * 6.28; p.vr *= 0.4; }\n    if (FX_ATLAS[kind]) p.spr = fxSprite(FX_ATLAS[kind], Math.floor(Math.random() * 16));\n    parts.push(p);\n  }\n  if (!fxOn) { fxOn = true; fxLast = performance.now(); requestAnimationFrame(fxLoop); }\n}\nfunction fxLoop(now) {\n  const dt = Math.min(0.05, (now - fxLast) / 1000), W = innerWidth;\n  fxLast = now;\n  fxx.clearRect(0, 0, W, innerHeight);\n  parts = parts.filter(p => (p.t += dt) < p.life);\n  for (const p of parts) {\n    fxx.globalAlpha = Math.min(1, (p.life - p.t) / 0.45);\n    if (p.kind === 'ribbon') {\n      const k = Math.min(1, p.t / (p.life * 0.55)), len = W * 0.55 * k, rb = fxRibbon(p.col);\n      if (rb) { drawRibbon(rb, p, len, W); continue; }\n      fxx.strokeStyle = p.col; fxx.lineWidth = p.w; fxx.lineCap = 'round'; fxx.beginPath();\n      for (let s0 = 0; s0 <= len; s0 += 12) { const x = p.side < 0 ? s0 : W - s0, y = p.y0 + Math.sin(s0 * 0.018 + p.ph + p.t * 7) * 34 - s0 * 0.12; if (s0) fxx.lineTo(x, y); else fxx.moveTo(x, y); }\n      fxx.stroke(); continue;\n    }\n    const grav = p.kind === 'petal' || p.kind === 'foil' ? 0 : p.kind === 'burnt' ? 80 : 520;\n    p.vy += grav * dt; p.x += (p.vx + (p.sw !== undefined ? Math.sin(p.t * 3 + p.sw) * 40 : 0)) * dt; p.y += p.vy * dt; p.rot += p.vr * dt;\n    fxx.save(); fxx.translate(p.x, p.y); fxx.rotate(p.rot); fxx.fillStyle = p.col;\n    if (p.spr) {\n      // 紙屑、燒紙翻面（壓扁再張開）；金箔閃一閃\n      const d = p.s * (p.kind === 'ink' ? 3.4 : 2.7);\n      if (p.kind === 'petal' || p.kind === 'burnt') fxx.scale(1, Math.max(0.18, Math.abs(Math.cos(p.t * 4 + p.sw))));\n      if (p.kind === 'foil') fxx.globalAlpha *= 0.65 + 0.35 * Math.abs(Math.sin(p.t * 9 + p.sw));\n      fxx.drawImage(p.spr, -d / 2, -d / 2, d, d);\n    }\n    else if (p.kind === 'petal') { fxx.beginPath(); fxx.ellipse(0, 0, p.s, Math.max(0.5, p.s * 0.5 * Math.abs(Math.cos(p.t * 4 + p.sw))), 0, 0, 6.28); fxx.fill(); }\n    else if (p.kind === 'foil') { fxx.globalAlpha *= 0.6 + 0.4 * Math.abs(Math.sin(p.t * 9 + p.sw)); fxx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.7); }\n    else { fxx.beginPath(); fxx.arc(0, 0, p.s, 0, 6.28); fxx.fill(); }\n    fxx.restore();\n  }\n  fxx.globalAlpha = 1;\n  if (parts.length) requestAnimationFrame(fxLoop); else { fxOn = false; fxx.clearRect(0, 0, W, innerHeight); }\n}\n// 打出去那張牌在螢幕上的位置\nfunction cardScreen(i) {\n  if (!glOK) return { x: innerWidth / 2, y: innerHeight * 0.42 };\n  const v = cardSpot('stage', i).project(camera);\n  return { x: (v.x + 1) / 2 * innerWidth, y: (1 - v.y) / 2 * innerHeight };\n}\nfunction banner(tx, sub, cls = '') {\n  if (calm()) return;\n  $('#combo').innerHTML = `<div class=\"cb ${cls}\">${esc(tx)}</div>${sub ? `<div class=\"cs\">${esc(sub)}</div>` : ''}`;\n}\nfunction gainFloat(at, tx, bad) {\n  if (calm()) return;\n  const el = document.createElement('div'); el.className = `gainf ${bad ? 'bad' : ''}`; el.textContent = tx;\n  el.style.left = `${at.x}px`; el.style.top = `${at.y}px`; document.body.appendChild(el); setTimeout(() => el.remove(), 1300);\n}\n// 連擊越長，台上越熱鬧：火星 → 紙屑、幕晃、大字 → 金箔、彩綢、鏡頭推近 → 煙花\nconst COMBO_TX = { 3: ['好！', '连击 ×3'], 4: ['满堂红', '连击 ×4'], 5: ['绝了', '五连'] };\nfunction comboFx(p) {\n  const n = S.T.chain, at = cardScreen(S.T.plays.length - 1);\n  gainFloat(at, `+${p.g + p.extra + p.open + p.fin}`, p.broke);\n  if (p.broke) {\n    spawn('ink', 30, at); spawn('burnt', 7, at);\n    banner('倒彩', p.grudge ? '怨气 +1：今晚多染一张' : p.saved ? '小锣一响，这回不记怨气' : '连击归零', 'bad');\n    if (glOK) $('#gl').animate([{ filter: 'saturate(.15) brightness(.6)' }, { filter: 'none' }], { duration: 750, easing: 'ease-out' });\n    return;\n  }\n  spawn('spark', 10 + n * 8, at);\n  lanternKick = Math.min(1.6, 0.35 * n);\n  if (n >= 2) swayKick = Math.max(swayKick, 0.35 * n);\n  if (n >= 3) { spawn('petal', 40 + (n - 3) * 35); const b = COMBO_TX[Math.min(n, 5)]; banner(b[0], b[1], n >= 4 ? 'big' : ''); }\n  if (n >= 4) { spawn('foil', 80); spawn('ribbon', 6); if (glOK && camPos) camPos.lerp(camAim, 0.08); }\n  if (n >= 5) [0, 350, 700].forEach(d => setTimeout(() => spawn('fw', 60, { x: innerWidth * (0.2 + Math.random() * 0.6), y: innerHeight * (0.12 + Math.random() * 0.2) }), d));\n}\nasync function run(fn) { if (busy) return; busy = true; refresh(); try { await fn(); } finally { busy = false; refresh(); } }\n\n// ── 一天 ──\n// 依目前時段擺桌面（開局、接著玩都走這裡）\nfunction placeScene() {\n  if (view !== 'stage') { clearBubs(); stageHeat = 0; }\n  if (!glOK) return;\n  const lk = lookNow(S);\n  const v = { morning: ['table', 'day'], stage: ['stage', 'stage'], door: ['door', 'door'], evening: ['home', 'home'], night: ['night', 'night'], watch: ['night', 'night'], board: ['table', 'day'], lastwipe: ['mirror', 'night'], reveal: ['home', 'home'] }[view] || ['table', 'day'];\n  focus(v[0], v[1]);\n  const base = lk && (view === 'evening' || view === 'morning') && (view === 'evening' || actOf(S.day) === 0) ? LOOK_POSE[lk] : 'work';\n  wife.base = base;\n  // 第一幕她對你笑\n  wife.expr = { eyes: 'open', smile: actOf(S.day) === 0 };\n  wife.pose(base); wife.turn(0); wife.redraw();\n  actor.root.visible = view === 'stage';\n  crowdG.visible = view === 'stage';\n  if (view === 'stage') { actor.setLayers(S.T.layers); crowdDress(S.day); }\n  artScene(view);\n}\nfunction toDay() {\n  sheet = null; lookOpen = false;\n  view = S.phase;\n  clear3DCards();\n  placeScene();\n  if (glOK) actor.setLayers([]);\n  const st = starterOf(S), ev = eventOf(S), k = S.events[S.day];\n  if (view === 'stage') say('班主', DAY_TX[S.day - 1]);\n  else if (ev) sayH(ev.who, EV_TX[k](), esc(DAY_TX[S.day - 1]));\n  else say('', DAY_TX[S.day - 1]);\n  refresh();\n}\nfunction startGame(name) {\n  S = newGame(name, ((Date.now() % 2147483647) ^ Math.floor(Math.random() * 2147483647)) >>> 0);\n  S.tut = { off: !tutPref(), seen: {} };\n  saved = null; panel = null; coach.lesson = null;\n  $('#watch').hidden = true;\n  toDay();\n}\nfunction continueGame() {\n  S = saved; saved = null; panel = null; lookOpen = false;\n  S.tut = S.tut || { off: true, seen: {} };\n  coach.lesson = null;\n  view = S.phase; sheet = view === 'board' ? { k: 'board' } : view === 'reveal' ? { k: 'r_board' } : null;\n  placeScene();\n  if (view === 'watch') showWatch();\n  if (view === 'lastwipe') showWipe();\n  say('', `第 ${S.day} 天，接着来。`);\n  refresh();\n}\nconst onDepart = () => run(async () => {\n  depart(S);\n  if (S.phase === 'evening') { await ink(() => { view = 'evening'; placeScene(); }); say('', seatEmpty(S) ? '灯坊里只有你。灯骨搁在桌上。' : '她抬头看见你，没问你怎么没去。她把灯骨推过来。'); return; }\n  stageHeat = 0;\n  await ink(() => { view = 'stage'; placeScene(); actor?.setLayers([]); actor?.pose('idle'); });\n  say('班主', `起手${FAM[starterOf(S)].n}。${S.T.stageMax < R.stageMax ? '今天只有四张。' : ''}`);\n  const k = S.events[S.day];\n  if (k && EV_BUB[k]) setTimeout(() => bubble(EV_BUB[k], 'ev'), 700);\n  // 一上台，台下就有人聊她今晚的事\n  setTimeout(() => { if (view === 'stage' && !S.T.ended) crowdIntel(); }, 1500);\n});\n// 台下聊起她今晚的事：第 1 天在第二張之後，其餘天在第一張之後\nfunction crowdIntel() {\n  const t = S.T;\n  // 第 1 天傍晚是自動的，台下不聊她\n  if (S.day === 1 || t.heard || seatEmpty(S) || S.choice === 'stage' || S.choice === 'lamp') return;\n  if (!hearCrowd(S)) return;\n  const nd = needOf(S);\n  setTimeout(() => {\n    const html = `${CROWD_TX[nd.look]}${nd.items[1] ? `还有人说，${CROWD_B[nd.items[1].look]}` : ''}`;\n    bubble(`${html}<div><span class=\"itag\">今晚她要：${recipeShort(nd)}</span></div>`, 'intel');\n    refresh();\n  }, 650);\n}\nconst onStage = id => run(async () => {\n  const name = tOf(S, id).n, f = fOf(S, id);\n  await fly(id, 'stage');\n  const p = playStage(S, id);\n  if (!p) return;\n  if (actor) { actor.perform(f); actor.setLayers(S.T.layers); }\n  sfx(p.broke ? 'boo' : 'cheer');\n  const tp = tOf(S, id), t = S.T;\n  // 台下：起伏、說話；聚光燈跟著連擊亮起來\n  crowdKick(p.broke ? 'down' : t.chain >= 3 ? 'big' : 'up');\n  stageHeat = p.broke ? 0 : Math.min(2.4, (t.chain - 1) * 0.6);\n  if (glOK && p.broke) { lights.spot.color.setHex(0xff6a5a); setTimeout(() => lights.spot.color.setHex(0xffe0b0), 600); }\n  const pool = p.broke ? CROWD.broke : p.seeped ? CROWD.seep : p.fin ? CROWD.fin : tp.wild && (p.hit || p.open || t.plays.length === 1) ? CROWD.wild : tp.boost && p.hit ? CROWD.boost : tp.clean ? CROWD.clean : tp.heavy ? CROWD.heavy : tp.blank ? CROWD.blank : p.open ? CROWD.open : t.chain >= 3 ? CROWD.big : CROWD.hit;\n  // 第一天只在第一張和接錯時開口；教學框開著也不插嘴\n  if ((S.day > 1 || p.broke || t.plays.length === 1) && !coachOn()) bubble(esc(pick(pool)), p.broke ? 'boo' : 'n');\n  comboFx(p);\n  if (p.broke) say('', p.grudge ? '台下一声低低的嘘，跟着你下了台。' : '台下一声低低的嘘。', p.grudge ? '接错了 · 怨气 +1' : '接错了');\n  else if (p.seeped) say('', '这一层没挂住，直接渗了进去。', p.extra ? `连击 +${p.extra} 金` : '');\n  else if (p.open) sayN(`开得正 +${p.open} 金`);\n  else if (t.plays.length === 1 && tp.wild) sayN('百搭起手');\n  else sayN(`连击 ×${t.chain} · 多 ${p.extra} 金${tp.boost ? '（托）' : ''}${p.fin ? ` · 压轴 +${p.fin}` : ''}${tp.heavy ? ' · 两层' : ''}${tp.clean ? ' · 不上妆' : ''}`);\n  crowdIntel();\n});\nconst onEndStage = () => run(async () => {\n  endStage(S);\n  const t = S.T;\n  if (t.die !== null) await showDice({ label: '连击到 3：掷到 4 以上，金 ×1.5', v: t.die, ok: t.perfect, result: t.perfect ? '完美' : '没中，不扣金' });\n  if (t.gold) { burst(t.gold * 2); sfx('cheer'); crowdKick('big'); }\n  if (t.perfect) { stamp('完美'); bubble(esc(pick(CROWD.perfect)), 'n'); spawn('foil', 140); spawn('ribbon', 8); [0, 300, 600, 900].forEach(d => setTimeout(() => spawn('fw', 70, { x: innerWidth * (0.15 + Math.random() * 0.7), y: innerHeight * (0.1 + Math.random() * 0.25) }), d)); }\n  stageHeat = t.perfect ? 2.4 : 0.6;\n  actor?.pose('bow');\n  const who = S.choice === 'cover' ? `这 ${t.gold} 金，记在小凤名下。` : S.choice === 'stage' ? `元宵，金 ×2：${t.gold} 金。` : '';\n  say('班主', t.plays.length ? (who || `散戏。${t.gold} 金。`) : '今天你没有上台。');\n});\nconst onToDoor = () => run(async () => {\n  parts.length = 0;\n  if (S.phase === 'night') {\n    await ink(() => { view = 'night'; placeScene(); say('', ''); });\n    say('', '元宵的灯笼从窗外过去。你没有回家。', S.T.layers.length ? '剩下的牌还能卸。' : '');\n    return;\n  }\n  await ink(() => { view = 'door'; placeScene(); say('', ''); });\n  if (glOK && S.scars <= R.wipeScarMax && S.T.layers.length && !seatEmpty(S)) wife.pose('reach');\n  if (!S.T.layers.length) say('', '脸是干净的。');\n  else if (S.scars <= R.wipeScarMax) say('阿檀', '回来啦。擦一擦？');\n  else say('', '她坐着，没有起身。');\n});\nconst onWipe = () => run(async () => {\n  if (!canWipe(S)) return;\n  const n = Math.min(R.wipeLayers, S.T.layers.length), cols = S.T.layers.slice(-n).reverse().map(l => FCOL[l.f]);\n  if (glOK) { wife.pose('reach'); await wait(200); }\n  for (const c of cols) await towelSwipe(c);\n  wipe(S); renderSmear(); sfx('cloth');\n  say('阿檀', n === 2 ? '她替你擦掉两层，把毛巾叠起来，收进木匣。' : '她替你擦掉一层，把毛巾收进木匣。', '今晚她只听得下 1 张');\n  if (glOK) wife.pose(wife.base);\n});\nconst restTx = () => (S.T.layers.length ? `还剩 ${S.T.layers.length} 层。` : '脸上干净了。');\nconst onClean = id => run(async () => {\n  const name = tOf(S, id).n;\n  await fly(id, 'cloth');\n  selfClean(S, id); renderSmear(); sfx('cloth');\n  say('', `「${name}」成了一块布，挂上晾绳。${restTx()}`);\n});\nconst onEnter = () => run(async () => {\n  enterHome(S);\n  const t = S.T;\n  if (t.auto) {\n    await ink(() => { view = 'night'; placeScene(); say('', ''); });\n    say('', '她把饭留在桌上，灯又糊了一片。', '灯 +1');\n    await wait(2200);\n    if (t.forecast) { sayH('阿檀', foreTx(t.forecast), intelTag(t.forecast)); refresh(); }\n    // 不自動天亮：玩家看完、想好了，自己點「睡吧」\n    return;\n  }\n  if (t.emptySeat) {\n    await ink(() => { view = 'night'; placeScene(); say('', ''); });\n    say('', '对面的椅子空着。灯不再糊了。', t.layers.length ? '剩下的牌还能卸。' : '');\n    return;\n  }\n  await ink(() => { view = 'evening'; lookOpen = false; placeScene(); say('', ''); });\n  const nd = S.T.need;\n  sayH('阿檀', LOOK_TX[nd.look] + (nd.items[1] ? `“${ALSO_TX[nd.items[1].look]}”` : ''), S.T.dye ? `前 ${S.T.dye} 张会被染` : '');\n});\nconst onHome = id => run(async () => {\n  await fly(id, 'home');\n  const r = playHome(S, id);\n  if (!r) return;\n  if (r.dyed) {\n    wife?.react('down');\n    const txt = r.blank ? '她翻过来看。背面什么也没有。' : HOME[r.h].hurt;\n    say(`${r.name} · 被染`, txt, r.scar ? '灯上留了一道痕' : '这一道不算数');\n  } else if (r.blank) {\n    wife?.react('none');\n    say('空白', '她翻过来看。背面什么也没有。', '灯不涨');\n  } else {\n    wife?.react(r.match ? 'up' : 'none');\n    const nd = S.T.need;\n    say(`${r.name}${r.match ? ' · 对路' : ''}`, r.match ? (r.gift ? '她认出这是她给你的，眼睛亮了一下。' : pick(['她抬眼看你，手上慢了一下。', '她笑了一下，把灯骨转过来给你看。'])) : '她接过去，点点头。可这不是她今晚要的。', `${r.gain ? `灯 +${r.gain}` : '灯不涨'}${r.count === 2 ? ' · 算两张' : ''}`);\n  }\n  updateTable();\n  if (S.T.pushed.length >= S.T.homeCap && S.T.homeCap === R.homeAfterWipe) { await wait(1500); say('', '她累了，只听得下这一张。'); }\n});\n// 燈：十五片紙，每片 2 點；糊滿 30 才算美滿\nconst LSEG = 15, LANG = 360 / LSEG;\nfunction lampSVG(lamp, mark = {}) {\n  const cx = 75, cy = 75, r = 62, seg = [];\n  for (let i = 0; i < LSEG; i++) {\n    const a0 = (-90 + i * LANG) * Math.PI / 180, a1 = (-90 + (i + 1) * LANG) * Math.PI / 180, fill = clamp(lamp - i * 2, 0, 2) / 2;\n    seg.push(`<path class=\"sg ${mark[i] || ''}\" d=\"M${cx} ${cy}L${(cx + r * Math.cos(a0)).toFixed(1)} ${(cy + r * Math.sin(a0)).toFixed(1)}A${r} ${r} 0 0 1 ${(cx + r * Math.cos(a1)).toFixed(1)} ${(cy + r * Math.sin(a1)).toFixed(1)}Z\" fill=\"${fill ? '#c42433' : '#241d1f'}\" opacity=\"${fill && fill < 1 ? 0.55 : 1}\" stroke=\"#b89a5a\" stroke-width=\"1.5\"/>`);\n  }\n  return `<svg class=\"lampsvg\" viewBox=\"0 0 150 150\" aria-hidden=\"true\">${seg.join('')}<circle cx=\"${cx}\" cy=\"${cy}\" r=\"13\" fill=\"#1c1719\" stroke=\"#b89a5a\"/>${lamp >= R.lampFull ? `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r + 4}\" fill=\"none\" stroke=\"#f2d48a\" stroke-width=\"2.5\"/>` : ''}</svg>`;\n}\n// 這幾片紙在兩個燈數之間變了\nconst segsBetween = (a, b) => { const m = {}; for (let i = 0; i < LSEG; i++) if (clamp(a - i * 2, 0, 2) !== clamp(b - i * 2, 0, 2)) m[i] = 1; return m; };\n// 吃完飯當場：燈亮了還是熄了一截，熄了第幾回，還剩幾回她就走\nasync function lampFeedback(t) {\n  const el = $('#lampfb'), now = S.lamp;\n  const from = t.met ? now - t.lampGain : now + t.lampOut;\n  const head = t.met ? `<div class=\"big\">她的需要，满足了</div>` : `<div class=\"big\">灯熄了一截</div>`;\n  const rows = t.met\n    ? `<div class=\"row\">今晚灯 <b>+${t.lampGain}</b>　现在 <b>${now}</b>/${R.lampFull}　（糊满才算美满）</div>${t.gift ? `<div class=\"row\">两晚都对上：她送你一张「${T[t.gift].n}」</div>` : ''}`\n    : `<div class=\"row\">灯 <b>${from}</b> → <b>${now}</b>　熄 ${outsHTML(true)} <b>${S.outs}</b>/${R.brokenOuts}</div><div class=\"warn\">${S.outs >= R.brokenOuts ? '熄满五回了。' : `她今晚要的是 ${recipeShort(t.need)}。再熄 ${R.brokenOuts - S.outs} 回，她就走了。${S.outs === 1 ? '熄过了，这一季到不了美满。' : ''}`}</div>`;\n  el.innerHTML = `<div class=\"lf ${t.met ? '' : 'bad'}\">${head}<div class=\"lp\">${lampSVG(from)}</div>${rows}<button class=\"btn go small lfok\">${t.met ? '好' : '知道了'}</button></div>`;\n  el.hidden = false;\n  sfx(t.met ? 'lit' : 'out');\n  // 看清楚了再點掉：不自動消失\n  const ok = el.querySelector('.lfok'), done = new Promise(res => ok.addEventListener('click', e => { e.stopPropagation(); res(); }, { once: true }));\n  ok.focus({ preventScroll: true });\n  const ch = segsBetween(from, now);\n  if (calm()) el.querySelector('.lp').innerHTML = lampSVG(now);\n  else {\n    await Promise.race([wait(650), done]);\n    if (t.met) el.querySelector('.lp').innerHTML = lampSVG(now, Object.fromEntries(Object.keys(ch).map(i => [i, 'lighting'])));\n    else { el.querySelectorAll('.sg').forEach((p, i) => { if (ch[i]) p.classList.add('dying'); }); await Promise.race([wait(1150), done]); el.querySelector('.lp').innerHTML = lampSVG(now); }\n  }\n  await done;\n  el.hidden = true; el.innerHTML = '';\n}\n// 3D 的燈：熄掉的幾片閃幾下滅了，燈光一暗；亮的時候燈光暖一下\nfunction lamp3D(from, to) {\n  if (!glOK || calm()) return;\n  const nf = Math.min(12, Math.round(from * 12 / R.lampFull)), nt = Math.min(12, Math.round(to * 12 / R.lampFull)), lit = !!(S.lit || S.litAlone);\n  if (to < from) {\n    const fade = lampPatches.slice(nt, nf);\n    let k = 0;\n    const iv = setInterval(() => { k += 1; fade.forEach(p => { p.visible = k % 2 === 0; }); if (k >= 8) { clearInterval(iv); fade.forEach(p => { p.visible = false; }); } }, 150);\n    lampLight.color.setHex(0xff4a32);\n    // v1.6：熄掉的燈紙燒成碎片，從燈那裡飄下來\n    [350, 850].forEach(d => setTimeout(() => { const v = lampLight.position.clone().project(camera); spawn('burnt', 5, { x: (v.x + 1) / 2 * innerWidth, y: (1 - v.y) / 2 * innerHeight, w: 90 }); }, d));\n    tween(1300, e => { lampLight.intensity = lit ? 1.7 : 1.3 * (1 - e); }).then(() => lampLight.color.setHex(0xff7a4a));\n  } else tween(1600, e => { lampLight.intensity = lit ? 1.7 : 1.5 * Math.sin(e * Math.PI); });\n}\n// 她走了：痕到 4，或燈熄滿 5 回\nconst LEAVE_TX = { outs: '“灯熄了五回。我一个人，糊不动了。”', scars: '“灯上划了四道。补不回来了。”' };\nasync function herLeaving() {\n  const why = S.outs >= R.brokenOuts ? 'outs' : 'scars';\n  if (glOK) { focus('home', 'night'); wife.react('down'); }\n  say('阿檀', LEAVE_TX[why]);\n  await wait(2800);\n  if (glOK) wife.root.visible = false;\n  sfx('cloth');\n  say('', '她把灯搁在桌上，起身走了。门开着，没关。');\n  banner('她走了', '这一季，到这里为止', 'bad slow');\n  await wait(3200);\n  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n  say('', '屋里只剩你一个人。', '天亮以后，最后一次卸妆。');\n}\nconst onEndEvening = () => run(async () => {\n  const lamp0 = S.lamp;\n  endEvening(S);\n  const t = S.T, look = t.need.look;\n  // 先看她的需要：滿足了，或燈熄一截。當場就看到燈\n  if (t.met) {\n    wife?.react('up');\n    sayH('阿檀', esc(MET_TX[look]), t.gift ? `<span class=\"itag\">她送你一张家常牌「${T[t.gift].n}」：对上她的需要，一张算两张</span>` : '她今晚的需要，满足了');\n  } else {\n    wife?.reac