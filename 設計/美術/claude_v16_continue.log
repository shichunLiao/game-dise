== 4) { for (let i = 0; i < 5; i++) { const a = i * Math.PI * 2 / 5; x.beginPath(); x.ellipse(92 + Math.cos(a) * 14, 70 + Math.sin(a) * 14, 10, 6, a, 0, Math.PI * 2); x.fill(); } }\n    x.restore();\n  };\n  // 先一層紅紙稍大一點，再一層黑紙：剪紙的紅邊\n  shape('#b3202c', 0.045); shape('#0b0809', 0);\n  // 剪紙的鏤空：一圈小窗花\n  x.globalCompositeOperation = 'destination-out';\n  for (let i = 0; i < 7; i++) { const a = Math.PI * (0.15 + i * 0.12); x.beginPath(); x.ellipse(128 + Math.cos(a) * 92, 300 - Math.sin(a) * 70, 7, 3.5, a, 0, Math.PI * 2); x.fill(); }\n  x.beginPath(); x.moveTo(118, 262); x.lineTo(128, 248); x.lineTo(138, 262); x.lineTo(128, 276); x.closePath(); x.fill();\n  return c;\n}\n// 前排九個（會說話），後排八個小一點，兩邊各一個靠著台\nconst CROWD_AT = [[-1.02, 0.34, 1.05], [-0.8, 0.5, 1.2], [-0.56, 0.4, 0.95], [-0.3, 0.6, 1.1], [-0.02, 0.5, 1.0], [0.27, 0.6, 1.15], [0.55, 0.4, 0.95], [0.8, 0.52, 1.2], [1.03, 0.34, 1.05],\n  [-0.92, 0.25, 0.8], [-0.68, 0.27, 0.78], [-0.42, 0.28, 0.82], [-0.16, 0.3, 0.76], [0.14, 0.3, 0.8], [0.4, 0.28, 0.78], [0.66, 0.27, 0.82], [0.92, 0.25, 0.8],\n  [-1.22, 0.05, 0.9], [1.22, 0.05, 0.9]];\n// v1.6：剪紙觀眾圖（純黑剪影）→ 加紅紙邊：只沿外輪廓（從邊上灌水分出外面），鏤空保持透明；底邊切齊不留邊\nconst CROWD_PAD = 8, CROWD_RIM = 5, crowdTex = {};\nfunction crowdCv(im) {\n  const P = CROWD_PAD, iw = Math.round(im.width / 2), ih = Math.round(im.height / 2), W = iw + P * 2, H = ih + P, N = W * H;\n  const c = document.createElement('canvas'); c.width = W; c.height = H;\n  const x = c.getContext('2d'); x.imageSmoothingQuality = 'high'; x.drawImage(im, P, P, iw, ih);\n  const img = x.getImageData(0, 0, W, H), d = img.data, out = new Uint8Array(N), q = new Int32Array(N);\n  let qh = 0, qt = 0;\n  const push = i => { if (!out[i] && d[i * 4 + 3] < 128) { out[i] = 1; q[qt++] = i; } };\n  for (let X = 0; X < W; X++) { push(X); push((H - 1) * W + X); }\n  for (let y = 0; y < H; y++) { push(y * W); push(y * W + W - 1); }\n  while (qh < qt) { const i = q[qh++], X = i % W; if (X > 0) push(i - 1); if (X < W - 1) push(i + 1); if (i >= W) push(i - W); if (i < N - W) push(i + W); }\n  // 外面每一點到剪影的距離（兩趟倒角），近的染成紅紙\n  const dist = new Float32Array(N);\n  for (let i = 0; i < N; i++) dist[i] = out[i] ? 1e6 : 0;\n  for (let y = 0; y < H; y++) for (let X = 0; X < W; X++) {\n    const i = y * W + X; if (!dist[i]) continue; let m = dist[i];\n    if (X > 0) m = Math.min(m, dist[i - 1] + 1);\n    if (y > 0) { m = Math.min(m, dist[i - W] + 1); if (X > 0) m = Math.min(m, dist[i - W - 1] + 1.414); if (X < W - 1) m = Math.min(m, dist[i - W + 1] + 1.414); }\n    dist[i] = m;\n  }\n  for (let y = H - 1; y >= 0; y--) for (let X = W - 1; X >= 0; X--) {\n    const i = y * W + X; if (!dist[i]) continue; let m = dist[i];\n    if (X < W - 1) m = Math.min(m, dist[i + 1] + 1);\n    if (y < H - 1) { m = Math.min(m, dist[i + W] + 1); if (X < W - 1) m = Math.min(m, dist[i + W + 1] + 1.414); if (X > 0) m = Math.min(m, dist[i + W - 1] + 1.414); }\n    dist[i] = m;\n  }\n  for (let i = 0; i < N; i++) {\n    if (!out[i]) continue;\n    const a = Math.max(0, Math.min(1, CROWD_RIM + 0.5 - dist[i]));\n    if (!a) continue;\n    const k = i * 4, a0 = d[k + 3] / 255;\n    d[k] = Math.round(0xb3 * (1 - a0) + d[k] * a0); d[k + 1] = Math.round(0x20 * (1 - a0) + d[k + 1] * a0); d[k + 2] = Math.round(0x2c * (1 - a0) + d[k + 2] * a0);\n    d[k + 3] = Math.round(255 * Math.max(a, a0));\n  }\n  x.putImageData(img, 0, 0);\n  return c;\n}\nfunction crowdTexOf(p) {\n  if (crowdTex[p]) return crowdTex[p];\n  const im = artImg(p);\n  if (!im) return null;\n  const t = new THREE.CanvasTexture(crowdCv(im)); t.anisotropy = 4;\n  return (crowdTex[p] = t);\n}\nconst CROWD_DIR = [0, Math.cos(0.62), -Math.sin(0.62)];\n// 前排九格：叫好組 b01–b04、倒彩組 b05–b08 交錯，正中一格輪換 a；中排六格、兩側兩格輪換 a；後排八格是遠處小影 c01–c08\nconst CROWD_MID = [[-0.68, 0.38, 0.9], [-0.42, 0.45, 0.92], [-0.15, 0.39, 0.9], [0.12, 0.45, 0.92], [0.41, 0.39, 0.9], [0.69, 0.45, 0.92]];\nconst CROWD_FRONT_B = [1, 5, 2, 6, 0, 7, 3, 8, 4];\nconst crowdA = () => crowd.filter(c => c.kind === 'a');\nfunction buildCrowdArt(g) {\n  const two = n => String(n).padStart(2, '0');\n  const slots = [...CROWD_AT.map((at, i) => [at, i < 9 ? (CROWD_FRONT_B[i] ? `b${two(CROWD_FRONT_B[i])}` : 'a') : i < 17 ? `c${two(i - 8)}` : 'a']), ...CROWD_MID.map(at => [at, 'a'])];\n  const geo = {};\n  crowd = slots.map(([[x0, z0, k], who], i) => {\n    const kind = who[0], hf = 0.275 * k, w = 0.22 * k * (256 + CROWD_PAD * 2) / 256, h = hf * (320 + CROWD_PAD) / 320;\n    const idle = kind === 'a' ? null : crowdTexOf(kind === 'b' ? `crowd/${who}_idle.png` : `crowd/${who}.png`);\n    if (kind !== 'a' && !idle) return null;\n    const gk = `${w.toFixed(4)}|${h.toFixed(4)}`, gg = geo[gk] || (geo[gk] = new THREE.PlaneGeometry(w, h).translate(0, h / 2, 0));\n    const mat = new THREE.MeshBasicMaterial({ map: idle, transparent: true, alphaTest: 0.4, side: THREE.DoubleSide });\n    const sh = new THREE.Mesh(gg, new THREE.MeshBasicMaterial({ map: idle, color: 0x000000, transparent: true, opacity: 0.5, depthWrite: false }));\n    sh.position.set(w * 0.07, -hf * 0.03, -0.022); sh.renderOrder = -1;\n    const piv = new THREE.Group(); piv.position.set(x0, TOP + 0.013 * hf, z0 + 0.29 * hf); piv.rotation.x = -0.62;\n    piv.add(sh, new THREE.Mesh(gg, mat)); crowdG.add(piv);\n    const c = { m: piv, mat, sh, y0: piv.position.y, h: hf, hf, headK: kind === 'c' ? 0.42 : 0.86, kick: null, phase: i * 1.7, front: i < 9, side: x0 < -0.4 ? 'L' : x0 > 0.4 ? 'R' : 'C', kind, who };\n    if (kind === 'b') { c.idle = idle; c.act = crowdTexOf(`crowd/${who}_act.png`) || idle; c.grp = +who.slice(1) <= 4 ? 'cheer' : 'boo'; c.actFrom = 0; c.actTo = 0; }\n    return c;\n  });\n  // 有一格的圖載不到：這一格退回 v1.5 的剪影\n  crowd = crowd.map((c, i) => c || crowdFallback(slots[i][0], i));\n  crowdDress(1);\n}\n// a 組十六張，每天換一批人坐（中間、中排、兩側共九格）\nfunction crowdDress(day) {\n  if (!ART.on) return;\n  const two = n => String(n).padStart(2, '0');\n  crowdA().forEach((c, j) => {\n    const tex = crowdTexOf(`crowd/a${two(1 + ((day - 1) * 9 + j) % 16)}.png`) || c.mat.map;\n    if (tex && c.mat.map !== tex) { c.mat.map = tex; c.sh.material.map = tex; c.mat.needsUpdate = true; c.sh.material.needsUpdate = true; }\n    c.m.visible = !!c.mat.map;\n  });\n}\nfunction crowdFallback([x0, z0, k], i) {\n  const tex = new THREE.CanvasTexture(silhouetteCv(31 + i * 7)), w = 0.22 * k, h = 0.275 * k;\n  const m = new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshBasicMaterial({ map: tex, transparent: true, alphaTest: 0.4, side: THREE.DoubleSide }));\n  m.rotation.x = -0.62; m.position.set(x0, TOP + h * 0.42, z0); crowdG.add(m);\n  return { m, y0: m.position.y, h, kick: null, phase: i * 1.7, front: i < 9, side: x0 < -0.4 ? 'L' : x0 > 0.4 ? 'R' : 'C' };\n}\nfunction buildCrowd(g) {\n  crowdG = new THREE.Group(); crowdG.visible = false; g.add(crowdG);\n  if (ART.on && artImg('crowd/a01.png')) { buildCrowdArt(g); return; }\n  crowd = CROWD_AT.map(([x0, z0, k], i) => {\n    const tex = new THREE.CanvasTexture(silhouetteCv(31 + i * 7)), w = 0.22 * k, h = 0.275 * k;\n    const m = new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshBasicMaterial({ map: tex, transparent: true, alphaTest: 0.4, side: THREE.DoubleSide }));\n    // 往後仰，正面朝著俯看的鏡頭\n    m.rotation.x = -0.62; m.position.set(x0, TOP + h * 0.42, z0); crowdG.add(m);\n    return { m, y0: m.position.y, h, kick: null, phase: i * 1.7, front: i < 9, side: x0 < -0.4 ? 'L' : x0 > 0.4 ? 'R' : 'C' };\n  });\n}\n// 一起起伏：up 叫好往上跳，down 嘘聲往下沉\nfunction crowdKick(kind) {\n  const now = clock ? clock.elapsedTime : 0;\n  crowd.forEach((c, i) => {\n    c.kick = { t0: now + (i % 3) * 0.06 + Math.random() * 0.12, amp: kind === 'down' ? -0.05 : kind === 'big' ? 0.07 : 0.04 };\n    // v1.6：動作對換一張紙——叫好時叫好組舉手，倒彩時倒彩組擺手、捂耳、扭頭、扔瓜子殼\n    if (c.act && (kind === 'down') === (c.grp === 'boo')) { c.actFrom = c.kick.t0 + 0.05; c.actTo = c.actFrom + (kind === 'big' ? 1.7 : 1.15); }\n  });\n}\nfunction crowdTick(t) {\n  crowd.forEach(c => {\n    let y = Math.sin(t * 0.9 + c.phase) * 0.004;\n    if (c.kick) {\n      const k = (t - c.kick.t0) / 0.9;\n      if (k > 1) c.kick = null; else if (k > 0) y += c.kick.amp * Math.sin(k * Math.PI) * (c.kick.amp > 0 ? Math.abs(Math.sin(k * Math.PI * 2)) + 0.4 : 1);\n    }\n    c.m.position.y = c.y0 + y;\n    if (c.act) { const tex = t >= c.actFrom && t < c.actTo ? c.act : c.idle; if (c.mat.map !== tex) { c.mat.map = tex; c.sh.material.map = tex; } }\n  });\n}\n// 觀眾頭頂在螢幕上的位置：對白框貼著它\nfunction crowdHead(i) {\n  if (!glOK || !crowd[i]) return null;\n  const c = crowd[i];\n  if (c.hf) { const v = c.m.position.clone(), k = c.hf * c.headK; v.y += CROWD_DIR[1] * k; v.z += CROWD_DIR[2] * k; v.project(camera); return { x: (v.x + 1) / 2 * innerWidth, y: (1 - v.y) / 2 * innerHeight }; }\n  const v = c.m.position.clone(); v.y += c.h * 0.4; v.z -= c.h * 0.25;\n  v.project(camera);\n  return { x: (v.x + 1) / 2 * innerWidth, y: (1 - v.y) / 2 * innerHeight };\n}\nfunction buildBox(g) {\n  const lacR = toon(0x7d1219), goldM = toon(0xb8913f), b = new THREE.Group();\n  b.position.set(-1.32, TOP, 0.12); b.rotation.y = 0.32; b.scale.setScalar(1.55); g.add(b);\n  const base = box(0.36, 0.13, 0.25, lacR); base.position.y = 0.065; b.add(inked(base, 0.005));\n  [[0, 0.125, 0.37, 0.012], [0, -0.125, 0.37, 0.012], [0.18, 0, 0.012, 0.25], [-0.18, 0, 0.012, 0.25]].forEach(([dx, dz, w, d]) => { const m = box(w, 0.014, d, goldM); m.position.set(dx, 0.132, dz); b.add(m); });\n  const lid = new THREE.Group(); lid.position.set(0, 0.135, -0.125); b.add(lid);\n  const lidM = box(0.36, 0.035, 0.25, lacR); lidM.position.set(0, 0.0175, 0.125); lid.add(inked(lidM, 0.005)); lid.rotation.x = -1.95;\n  boxStack = new THREE.Group(); boxStack.position.set(0, 0.135, 0); b.add(boxStack);\n}\nfunction buildMirror(g) {\n  const m = new THREE.Group(); m.position.set(1.32, TOP, -0.02); m.rotation.y = -0.34; g.add(m);\n  mirrorCv = document.createElement('canvas'); mirrorCv.width = mirrorCv.height = 320; mirrorTex = new THREE.CanvasTexture(mirrorCv);\n  const face = new THREE.Mesh(new THREE.CircleGeometry(0.31, 48), new THREE.MeshLambertMaterial({ map: mirrorTex, emissive: 0x333333 })); face.position.y = 0.46; m.add(face);\n  const rim = new THREE.Mesh(new THREE.TorusGeometry(0.32, 0.026, 10, 48), toon(0xb8913f)); rim.position.y = 0.46; m.add(inked(rim, 0.004));\n  const stand = box(0.05, 0.16, 0.05, toon(0xb8913f)); stand.position.set(0, 0.08, -0.02); m.add(stand);\n  const foot = box(0.26, 0.02, 0.14, toon(0x7a5a24)); foot.position.set(0, 0.01, -0.02); m.add(foot);\n}\nfunction buildRope(g) {\n  const z = 0.78, y = TOP + 0.26;\n  [-1.72, 1.72].forEach(x0 => { const p = box(0.03, 0.26, 0.03, toon(0x2a1a14)); p.position.set(x0, TOP + 0.13, z); g.add(p); });\n  const line = new THREE.Mesh(new THREE.CylinderGeometry(0.004, 0.004, 3.44, 6), toon(0x8b7f6a)); line.rotation.z = Math.PI / 2; line.position.set(0, y, z); g.add(line);\n  clothG = new THREE.Group(); g.add(clothG);\n}\nfunction buildSeat(g) {\n  // 阿檀的座位、燈骨、木匣\n  stool = new THREE.Group(); g.add(stool);\n  const seat = box(0.56, 0.05, 0.42, toon(0x2a1a14)); seat.position.y = 0.44; stool.add(inked(seat, 0.005));\n  const backR = box(0.56, 0.62, 0.04, toon(0x2a1a14)); backR.position.set(0, 0.76, -0.22); stool.add(inked(backR, 0.005));\n  wife = makeFigure({ who: 'wife', robe: '#d6d1ca', pat: '#7a7478', hem: '#3a3236', sash: 0xa8202b, cuff: 0.11, seed: 5, ribbons: true, pin: true });\n  g.add(wife.root);\n  const lamp = new THREE.Group(); lamp.position.set(0.74, TOP + 0.3, -0.98); lamp.scale.setScalar(1.45); g.add(lamp);\n  const bamboo = toon(0xb89a5a);\n  [-0.16, -0.08, 0, 0.08, 0.16].forEach(y => { const rr0 = 0.14 * Math.sqrt(1 - (y / 0.2) ** 2); const ring = new THREE.Mesh(new THREE.TorusGeometry(rr0, 0.004, 6, 32), bamboo); ring.rotation.x = Math.PI / 2; ring.position.y = y; lamp.add(ring); });\n  for (let i = 0; i < 8; i++) { const rib = new THREE.Mesh(new THREE.TorusGeometry(0.2, 0.0035, 6, 24, Math.PI), bamboo); rib.scale.x = 0.7; rib.rotation.set(0, i * Math.PI / 8, Math.PI / 2); lamp.add(rib); }\n  lampPatches = [];\n  for (let i = 0; i < 12; i++) { const a = i * Math.PI / 6; const p = new THREE.Mesh(new THREE.SphereGeometry(0.142, 10, 8, a, Math.PI / 6, Math.PI * 0.18, Math.PI * 0.64), new THREE.MeshLambertMaterial({ color: 0xb3202b, emissive: 0x3a0606, transparent: true, opacity: 0.88, side: THREE.DoubleSide })); p.visible = false; lamp.add(p); lampPatches.push(p); }\n  // 痕：燈上一道一道劃開的黑線，永久\n  lampScars = [];\n  for (let i = 0; i < 6; i++) { const m = new THREE.Mesh(new THREE.BoxGeometry(0.012, 0.2, 0.012), new THREE.MeshBasicMaterial({ color: 0x0a0506 })); const a = 0.5 + i * 0.75; m.position.set(Math.sin(a) * 0.145, (i % 3 - 1) * 0.03, Math.cos(a) * 0.145); m.rotation.set(0.3, a, 0.5 - (i % 2) * 1); m.visible = false; lamp.add(m); lampScars.push(m); }\n  lampLight = new THREE.PointLight(0xff7a4a, 0, 3.5, 2); lampLight.position.copy(lamp.position); g.add(lampLight);\n  const wood = toon(0x4d3220), chest = new THREE.Group(); chest.position.set(-0.86, TOP, -0.92); chest.rotation.y = 0.2; g.add(chest);\n  const cb = box(0.4, 0.13, 0.28, wood); cb.position.y = 0.065; chest.add(inked(cb, 0.005));\n  const cl = box(0.4, 0.03, 0.28, toon(0x5b3c27)); cl.position.set(0, 0.145, -0.1); cl.rotation.x = -0.6; chest.add(inked(cl, 0.004)); chestLid = cl;\n  chestG = new THREE.Group(); chestG.position.set(0, 0.13, 0); chest.add(chestG);\n}\nfunction buildTable() {\n  const g = new THREE.Group(); scene.add(g);\n  const wall = plane(9, 4.5, new THREE.MeshLambertMaterial({ map: latticeTex() })); wall.position.set(0, 2.1, -3.1); g.add(wall);\n  const floor = plane(12, 12, toon(0x1c130e)); floor.rotation.x = -Math.PI / 2; g.add(floor);\n  const top = box(3.7, 0.08, 2.6, toon(0xffffff, woodTex())); top.position.set(0, TOP - 0.04, -0.15); g.add(inked(top, 0.008));\n  [[-1.75, 0.98], [1.75, 0.98], [-1.75, -1.28], [1.75, -1.28]].forEach(([a, b]) => { const l = box(0.1, TOP - 0.08, 0.1, toon(0x20130c)); l.position.set(a, (TOP - 0.08) / 2, b); g.add(l); });\n  stainM = new THREE.MeshBasicMaterial({ map: stainTex(), transparent: true, opacity: 0, depthWrite: false });\n  const st = plane(3.7, 2.6, stainM); st.rotation.x = -Math.PI / 2; st.position.set(0, TOP + 0.002, -0.15); g.add(st);\n  buildMiniStage(g); buildBox(g); buildMirror(g); buildRope(g); buildSeat(g); buildCrowd(g);\n  goldG = new THREE.Group(); goldG.position.set(0.98, TOP, 0.42); g.add(goldG);\n  lights.c1 = candle(g, -0.42, TOP, -0.92); lights.c2 = candle(g, 0.98, TOP, 0.05);\n  lights.hemi = new THREE.HemisphereLight(0xf3e4d0, 0x241812, 0.7); g.add(lights.hemi);\n  lights.key = new THREE.DirectionalLight(0xfff1dc, 0.5); lights.key.position.set(-2, 4, 3); g.add(lights.key);\n  buildDeco(g);\n}\n// ── v1.6 裝飾：守舊背幕、台毯、窗花、臉譜剪紙、燈紙紋樣、木匣蓋的如意雲頭 ──\n// 都是印在布、紙上的平面紋樣，跟著場景的光（不像觀眾紙片那樣不吃光）；哪一張圖沒載到，那一樣就維持 v1.5 的樣子\nlet deco = null;\nfunction artTex(p, prep) {\n  const im = artImg(p);\n  if (!im) return null;\n  let src = im;\n  if (prep) { const c = document.createElement('canvas'); c.width = im.width; c.height = im.height; prep(c.getContext('2d'), im, c); src = c; }\n  const t = new THREE.Texture(src); t.needsUpdate = true; t.anisotropy = 4;\n  return t;\n}\n// 臉譜剪紙裱在一張宣紙上再貼牆：墨黑的那兩張貼在深色牆上才看得見\nfunction mountPaper(x, im, c) {\n  const W = c.width, H = c.height, r = rng(hash(im.src.slice(-40)));\n  x.fillStyle = '#e6dccb'; x.beginPath();\n  // 手裁的紙邊：四邊各抖幾下\n  const pts = [], m = 14, j = () => (r() - 0.5) * 7;\n  for (let i = 0; i <= 8; i++) pts.push([m + (W - 2 * m) * i / 8 + j(), m + j()]);\n  for (let i = 1; i <= 8; i++) pts.push([W - m + j(), m + (H - 2 * m) * i / 8 + j()]);\n  for (let i = 7; i >= 0; i--) pts.push([m + (W - 2 * m) * i / 8 + j(), H - m + j()]);\n  for (let i = 7; i >= 1; i--) pts.push([m + j(), m + (H - 2 * m) * i / 8 + j()]);\n  pts.forEach(([X, Y], i) => (i ? x.lineTo(X, Y) : x.moveTo(X, Y))); x.closePath(); x.fill();\n  const pp = artImg('cards/paper_02.png');\n  if (pp) { x.save(); x.clip(); x.globalCompositeOperation = 'overlay'; x.drawImage(pp, 0, 0, W, H); x.restore(); }\n  x.strokeStyle = 'rgba(168,32,43,.55)'; x.lineWidth = 3; x.strokeRect(m + 16, m + 16, W - 2 * m - 32, H - 2 * m - 32);\n  const s = 0.78; x.drawImage(im, W * (1 - s) / 2, H * (1 - s) / 2, W * s, H * s);\n}\nfunction buildDeco(g) {\n  if (!ART.on) return;\n  deco = { stage: [], n: 0 };\n  const flat = (map, o) => new THREE.MeshLambertMaterial(Object.assign({ map, transparent: true, alphaTest: 0.35, side: THREE.DoubleSide }, o || {}));\n  // 守舊：小戲台後面那幅背幕，往後仰一點對著戲台鏡頭；只在台上出現（別的鏡頭要看得見對面的阿檀）\n  const sj = artTex('deco/shoujiu.png');\n  if (sj) {\n    const w = 1.2, h = w / 1.5, m = new THREE.Mesh(new THREE.PlaneGeometry(w, h).translate(0, h / 2, 0), new THREE.MeshLambertMaterial({ map: sj, color: 0x8c8484 }));\n    m.position.set(0, TOP + 0.108, -0.62); m.rotation.x = -0.36; m.visible = false; g.add(m); deco.stage.push(m); deco.n += 1;\n  }\n  // 台毯：暗朱紅的團花回紋，平鋪在台板上，四邊留一圈木板\n  const cp = artTex('deco/carpet.png');\n  if (cp) {\n    cp.wrapS = cp.wrapT = THREE.RepeatWrapping; cp.repeat.set(2.5, 1.35);\n    const m = new THREE.Mesh(new THREE.PlaneGeometry(1.42, 0.76), new THREE.MeshLambertMaterial({ map: cp, color: 0x6e6466 })); m.rotation.x = -Math.PI / 2; m.position.set(0, TOP + 0.1115, -0.2); g.add(m); deco.n += 1;\n  }\n  // 窗花：後牆格窗的窗紙上，如意、蝙蝠、牡丹、燈籠各一（灯坊、門口、夜裡的鏡頭看得見）\n  [[1, -1.81, 1.4], [2, -1.29, 1.96], [3, 1.29, 1.96], [4, 1.81, 1.4]].forEach(([n, x0, y0]) => {\n    const t = artTex(`deco/chuanghua_0${n}.png`);\n    if (!t) return;\n    const m = new THREE.Mesh(new THREE.PlaneGeometry(0.42, 0.42), flat(t, { emissive: 0x220406 })); m.position.set(x0, y0, -3.085); g.add(m); deco.n += 1;\n  });\n  // 臉譜剪紙：裱在宣紙上，貼在格窗兩邊的牆上\n  [[1, -2.5, 1.6, 0.05], [2, -2.98, 1.52, -0.04], [3, 2.5, 1.6, -0.05], [4, 2.98, 1.52, 0.04]].forEach(([n, x0, y0, rz]) => {\n    const t = artTex(`deco/lianpu_0${n}.png`, mountPaper);\n    if (!t) return;\n    const m = new THREE.Mesh(new THREE.PlaneGeometry(0.4, 0.5), flat(t, { alphaTest: 0.1, emissive: 0x141010 })); m.position.set(x0, y0, -3.085); m.rotation.z = rz; g.add(m); deco.n += 1;\n  });\n  // 燈紙：那盞燈的每一片紅紙上印極淡的墨線小團花（原圖很淡，疊幾次才看得出）\n  const lp = artImg('deco/lampaper.png');\n  if (lp && lampPatches.length) {\n    const c = document.createElement('canvas'); c.width = 128; c.height = 512;\n    const x = c.getContext('2d'); x.fillStyle = '#b3202b'; x.fillRect(0, 0, 128, 512);\n    for (let k = 0; k < 4; k++) for (let i = 0; i < 4; i++) x.drawImage(lp, 0, i * 128, 128, 128);\n    const t = new THREE.CanvasTexture(c);\n    lampPatches.forEach(p => { p.material.map = t; p.material.color.setHex(0xffffff); p.material.needsUpdate = true; });\n    deco.n += 1;\n  }\n  // 痕：燈上的劃痕換成界面那一道墨劃痕（v1.5 是黑色細條）\n  const sc = artTex('ui/scar_mark.png');\n  if (sc && lampScars.length) {\n    const geo = new THREE.PlaneGeometry(0.06, 0.18), mat = new THREE.MeshBasicMaterial({ map: sc, transparent: true, alphaTest: 0.3, side: THREE.DoubleSide });\n    lampScars.forEach(m => { m.geometry = geo; m.material = mat; m.rotation.z *= 0.4; });\n    deco.n += 1;\n  }\n  // 木匣蓋：如意雲頭，染赭金，貼在蓋子外面\n  const cl = artTint('deco/chest_lid.png', '#b8913f', 512);\n  if (cl && chestLid) {\n    const m = new THREE.Mesh(new THREE.PlaneGeometry(0.34, 0.34), new THREE.MeshLambertMaterial({ map: new THREE.CanvasTexture(cl), transparent: true, alphaTest: 0.3 }));\n    m.rotation.x = -Math.PI / 2; m.position.y = 0.0158; chestLid.add(m); deco.n += 1;\n  }\n}\n// 換鏡頭時：守舊只在戲台上出現\nfunction artScene(v) {\n  if (!deco) return;\n  deco.stage.forEach(m => { m.visible = v === 'stage'; });\n}\n// 鏡頭：全桌、戲台、門口（她起身伸手過來）、對面、夜裡的鏡子\nconst VIEWS = {\n  table: { pos: [0, 2.2, 2.72], look: [0, 0.62, -0.42] },\n  stage: { pos: [0, 2.62, 0.9], look: [0, 0.74, -0.08] },\n  door: { pos: [0.2, 1.72, 2.05], look: [0.2, 0.84, -0.65] },\n  home: { pos: [0, 1.66, 1.5], look: [0.1, 0.72, -1.15] },\n  night: { pos: [0.42, 1.78, 2.05], look: [0.42, 0.72, -0.28] },\n  mirror: { pos: [1.02, 1.26, 1.06], look: [1.3, 1.14, -0.02] },\n  lamp: { pos: [0.98, 1.42, 0.22], look: [0.5, 0.98, -0.98] },\n};\nconst MOODS = {\n  day: { hemi: 0.75, key: 0.55, spot: 0.5, c: 1.0, bg: 0x241a14 },\n  stage: { hemi: 0.34, key: 0.2, spot: 2.6, c: 0.6, bg: 0x0d0a0c },\n  door: { hemi: 0.3, key: 0.18, spot: 0, c: 0.9, bg: 0x0a0a10 },\n  home: { hemi: 0.52, key: 0.3, spot: 0, c: 1.4, bg: 0x1a1210 },\n  night: { hemi: 0.13, key: 0.05, spot: 0, c: 1.5, bg: 0x070506 },\n};\nfunction focus(v, mood) {\n  if (!glOK) return;\n  const fit = camera.aspect < 0.8 ? 1.72 : camera.aspect < 1.25 ? 1.32 : 1;\n  const d = VIEWS[v], l = V(...d.look), p = V(...d.pos).sub(l).multiplyScalar(fit).add(l);\n  camTo = { p, l };\n  if (!camPos) { camPos = p.clone(); camAim = l.clone(); }\n  if (mood) moodTo = MOODS[mood];\n}\nfunction initGL() {\n  if (!glOK) return;\n  try { renderer = new THREE.WebGLRenderer({ canvas: $('#gl'), antialias: true }); } catch (e) { glOK = false; return; }\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n  renderer.setSize(innerWidth, innerHeight);\n  scene = new THREE.Scene();\n  camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.03, 40); scene.add(camera);\n  clock = new THREE.Clock();\n  const d = new Uint8Array([70, 70, 70, 150, 150, 150, 220, 220, 220, 255, 255, 255]);\n  grad = new THREE.DataTexture(d, 4, 1, THREE.RGBFormat); grad.minFilter = grad.magFilter = THREE.NearestFilter; grad.generateMipmaps = false; grad.needsUpdate = true;\n  backTex = new THREE.CanvasTexture(drawBack());\n  buildTable();\n  const tw = plane(0.5, 0.36, new THREE.MeshLambertMaterial({ map: canvasTex(256, 180, (x, w, h) => { x.fillStyle = '#f4efe6'; x.fillRect(0, 0, w, h); x.strokeStyle = '#cfc6b8'; x.lineWidth = 4; for (let i = 0; i < 6; i++) { x.beginPath(); x.moveTo(0, 20 + i * 28); x.quadraticCurveTo(w / 2, 10 + i * 28, w, 24 + i * 28); x.stroke(); } }), side: THREE.DoubleSide, transparent: true }));\n  towel = tw; towel.visible = false; camera.add(towel);\n  addEventListener('resize', () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); renderSmear(); });\n  addEventListener('pointermove', e => { pointer.x = e.clientX / innerWidth - 0.5; pointer.y = e.clientY / innerHeight - 0.5; });\n  requestAnimationFrame(loop);\n}\nfunction tween(dur, fn) {\n  if (!glOK || calm()) { fn(1); return Promise.resolve(); }\n  // 分頁在背景時畫面不更新：動畫不能卡住流程，時間到了就直接跳到結尾\n  return new Promise(res => {\n    const w = { t: 0, dur: dur / 1000, fn, res };\n    tweens.push(w);\n    setTimeout(() => { const i = tweens.indexOf(w); if (i >= 0) { tweens.splice(i, 1); fn(1); res(); } }, dur + 500);\n  });\n}\nconst ease = e => (e < 0.5 ? 2 * e * e : 1 - Math.pow(-2 * e + 2, 2) / 2);\nfunction loop() {\n  requestAnimationFrame(loop);\n  // 補間動畫按真實時間走：幀率低時不能跟著變慢，否則流程會等很久\n  const raw = clock.getDelta(), dt = Math.min(raw, 0.05), t = clock.elapsedTime;\n  for (let i = tweens.length - 1; i >= 0; i--) { const w = tweens[i]; w.t += Math.min(raw, 0.25); const k = Math.min(1, w.t / w.dur); w.fn(ease(k)); if (k >= 1) { tweens.splice(i, 1); w.res(); } }\n  if (camTo) {\n    const k = calm() ? 1 : 1 - Math.exp(-Math.min(raw, 0.25) * 2.6);\n    camPos.lerp(camTo.p, k); camAim.lerp(camTo.l, k);\n    camera.position.set(camPos.x + pointer.x * 0.1, camPos.y + Math.sin(t * 0.7) * 0.006 - pointer.y * 0.05, camPos.z);\n    camera.lookAt(camAim);\n  }\n  if (moodTo) {\n    const k = 1 - Math.exp(-Math.min(raw, 0.25) * 2.2);\n    lights.hemi.intensity += (moodTo.hemi - lights.hemi.intensity) * k;\n    lights.key.intensity += (moodTo.key - lights.key.intensity) * k;\n    lights.spot.intensity += (moodTo.spot + (moodTo === MOODS.stage ? stageHeat : 0) - lights.spot.intensity) * k;\n    [lights.c1, lights.c2].forEach(c => { c.base = moodTo.c; });\n    if (!scene.background) scene.background = new THREE.Color(moodTo.bg);\n    scene.background.lerp(new THREE.Color(moodTo.bg), k);\n  }\n  wife?.update(dt, t); actor?.update(dt, t);\n  if (crowdG && crowdG.visible) {\n    crowdTick(t);\n    // v1.6：紙片不吃燈光，只隨台上的熱度在 85%–100% 之間亮暗\n    if (crowd[0] && crowd[0].mat) { const k = clamp(0.86 + stageHeat * 0.06, 0.85, 1); crowd.forEach(c => { if (c.mat) c.mat.color.setScalar(k); }); }\n    swayKick *= Math.exp(-dt * 1.6); lanternKick *= Math.exp(-dt * 3);\n    stageCurtains.forEach((c, i) => { c.rotation.y = Math.sin(t * 3.2 + i * 2) * 0.12 * swayKick; c.rotation.z = Math.sin(t * 2.1 + i) * 0.03 * swayKick; });\n    lanterns.forEach((m, i) => { const k = 1 + lanternKick * (0.35 + 0.15 * Math.sin(t * 9 + i)); m.scale.set(k, 1.25 * k, k); });\n  }\n  [lights.c1, lights.c2].forEach(c => { if (c && c.base !== undefined) { c.fl.scale.y = 0.11 + Math.sin(t * 11) * 0.008; c.L.intensity = c.base * (0.92 + Math.sin(t * 13) * 0.05 + Math.sin(t * 7.3) * 0.03); } });\n  renderer.render(scene, camera);\n}\n// 桌面跟著狀態走：金堆、燈紙、痕、布、油彩漬、她的座位\nfunction updateTable() {\n  if (!glOK || !S) return;\n  const act = actOf(S.day), n = S.lit || S.litAlone ? 12 : Math.min(12, Math.round(S.lamp * 12 / R.lampFull));\n  lampPatches.forEach((p, i) => { p.visible = i < n; });\n  lampScars.forEach((m, i) => { m.visible = i < S.scars; });\n  lampLight.intensity = S.lit || S.litAlone ? 1.7 : 0;\n  stainM.opacity = [0, 0.8, 1][act] * Math.min(1, 0.75 + S.base * 0.1);\n  const z = SEAT_Z[act];\n  stool.position.set(0, 0, z - 0.02);\n  const empty = seatEmpty(S) || !!S.left;\n  wife.root.visible = !empty;\n  if (!empty) wife.root.position.set(0, -0.32, z);\n  // 晾繩上的布、木匣裡的布\n  while (clothG.children.length) clothG.remove(clothG.children[0]);\n  S.rope.slice(-24).forEach((e, i) => {\n    const m = plane(0.13, 0.19, new THREE.MeshBasicMaterial({ color: new THREE.Color(FCOL[e.f]).lerp(new THREE.Color(0xe6ddcf), 0.25), side: THREE.DoubleSide }));\n    m.position.set(-1.6 + i * 0.14, TOP + 0.16, 0.78); m.rotation.z = (i % 2 ? 1 : -1) * 0.05; clothG.add(m);\n  });\n  while (chestG.children.length) chestG.remove(chestG.children[0]);\n  S.chest.slice(-14).forEach((e, i) => { const m = box(0.3, 0.008, 0.2, new THREE.MeshLambertMaterial({ color: FCOL[e.f] })); m.position.y = i * 0.008; m.rotation.y = (i % 3 - 1) * 0.08; chestG.add(m); });\n  // 金箔堆\n  const coins = Math.min(44, Math.round(S.gold / 4));\n  while (goldG.children.length > coins) goldG.remove(goldG.children[goldG.children.length - 1]);\n  const r = rng(61 + goldG.children.length);\n  while (goldG.children.length < coins) { const i = goldG.children.length, m = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.008, 12), new THREE.MeshLambertMaterial({ color: 0xd9b25a, emissive: 0x3a2a08 })); m.position.set((r() - 0.5) * 0.2, 0.005 + i * 0.0035, (r() - 0.5) * 0.14); goldG.add(m); }\n  updateMirror();\n  updateLanterns();\n  setBoxStack();\n}\nfunction updateMirror() {\n  if (!glOK || !S) return;\n  drawPortrait(mirrorCv, { who: 'you', layers: S.T.layers, base: S.baseSeen ? S.base : 0, baseF: topFams()[0], bg: ['#8d9396', '#3b4044'] });\n  mirrorTex.needsUpdate = true;\n}\nfunction updateLanterns() {\n  if (!glOK || !S) return;\n  lanterns.forEach((m, i) => { const p = S.T.plays[i]; m.material.color.setHex(p ? (p.broke ? 0x7a3a2a : 0xff6a3c) : 0x4a1414); });\n}\nfunction setBoxStack() {\n  if (!glOK || !S) return;\n  while (boxStack.children.length) boxStack.remove(boxStack.children[0]);\n  const n = S.T.box.filter(id => !S.T.used[id]).length, m = new THREE.MeshLambertMaterial({ map: backTex });\n  for (let i = 0; i < n; i++) { const c = new THREE.Mesh(new THREE.BoxGeometry(0.29, 0.005, 0.19), [m, m, m, m, m, m]); c.position.set((i % 2) * 0.004, -0.05 + i * 0.006, 0); c.rotation.y = (i % 3 - 1) * 0.03; boxStack.add(c); }\n}\nfunction clear3DCards() { played3D.forEach(m => m.parent && m.parent.remove(m)); played3D = []; }\nfunction cardSpot(where, n) {\n  return where === 'stage' ? V(-0.54 + n * 0.27, TOP + 0.118, 0.04) : V(-0.34 + n * 0.34, TOP + 0.008, -0.72);\n}\nasync function spawnCard(t, side, pos) {\n  if (!glOK) return;\n  const m = cardMesh(t, side, side === 'stage' ? 1.4 : 1.3);\n  m.rotation.x = -Math.PI / 2; m.rotation.z = (Math.random() - 0.5) * (side === 'stage' ? 0.08 : 0.18); m.position.copy(pos); m.position.y += 0.25; scene.add(m); played3D.push(m);\n  const y0 = m.position.y;\n  await tween(300, k => { m.position.y = y0 - 0.25 * k; });\n}\nasync function towelSwipe(color) {\n  if (!glOK) { await wait(300); return; }\n  towel.visible = true; towel.material.color = new THREE.Color(0xffffff).lerp(new THREE.Color(color), 0.35);\n  await tween(620, k => { towel.position.set(-0.55 + 1.1 * k, 0.05 - Math.sin(k * Math.PI) * 0.1, -0.42); towel.rotation.z = -0.4 + 0.8 * k; });\n  towel.visible = false;\n}\n\n// 她的樣子：畫面為主，放大（滑過、聚焦或點開）才附文字\nconst LOOK_ICON = {\n  等: '<svg viewBox=\"0 0 24 24\"><path d=\"M2.5 12.5h8.5c0 3.2-1.9 5.3-4.25 5.3S2.5 15.7 2.5 12.5zM13 12.5h8.5c0 3.2-1.9 5.3-4.25 5.3S13 15.7 13 12.5z\" fill=\"currentColor\"/><path d=\"M15 10.5l4.5-7M17 10.5l4.5-7\" stroke=\"currentColor\" stroke-width=\"1.2\"/><path d=\"M4 20.5h16\" stroke=\"currentColor\" stroke-width=\"1\"/></svg>',\n  累: '<svg viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"9\" r=\"4.3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" transform=\"rotate(18 11 9)\"/><path d=\"M8.6 9.8q1 .7 2 0M11.8 10.6q1 .7 2 0\" stroke=\"currentColor\" fill=\"none\" stroke-width=\"1.1\"/><path d=\"M4 22c1-4.5 3.6-7.2 7.4-7.2S18 17.5 19 22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M16.5 3.2h3.2l-3.2 3.2h3.2\" stroke=\"currentColor\" fill=\"none\" stroke-width=\"1\"/></svg>',\n  忙: '<svg viewBox=\"0 0 24 24\"><ellipse cx=\"12\" cy=\"13.2\" rx=\"7\" ry=\"8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 5.2v16M7.4 6.8c-2 3.6-2 9.4 0 12.9M16.6 6.8c2 3.6 2 9.4 0 12.9M5 13.2h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\"/><rect x=\"9\" y=\"2\" width=\"6\" height=\"2.6\" fill=\"currentColor\"/></svg>',\n  想说: '<svg viewBox=\"0 0 24 24\"><path d=\"M3.5 4.5h17v11H10l-5 4.2v-4.2H3.5z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/><circle cx=\"8.5\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/><circle cx=\"15.5\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/></svg>',\n};\n\n// ── 教學小框：連擊、接口、被染第一次出現時解釋（第八節）；要玩家動手的步驟，只放行框裡的東西 ──\nconst TUT_KEY = 'dise-v15-tut';\nconst tutPref = () => { try { return localStorage.getItem(TUT_KEY) !== '0'; } catch (e) { return true; } };\nconst setTutPref = on => { try { localStorage.setItem(TUT_KEY, on ? '1' : '0'); } catch (e) { /* 存不了就算了 */ } };\nconst handOf = t => { const id = S.T.box.find(x => cardOf(S, x).t === t && !S.T.used[x]); return id === undefined ? null : document.querySelector(`.hc[data-id=\"${id}\"]`); };\nconst famOfLook = look => Object.keys(FAM).find(f => FAM[f].home === LOOK_HOME[look]);\n// 她要的：「累」照顧 ×2 + 「忙」共勞 ×1\nconst recipeTx = nd => nd.items.map(x => `「${x.look}」${HOME[LOOK_HOME[x.look]].n} ×${x.n}`).join(' + ');\nconst recipeShort = nd => nd.items.map(x => `${x.look}·${HOME[LOOK_HOME[x.look]].n}×${x.n}`).join(' + ');\nconst needTx = (nd = needOf(S)) => `要 ${nd.items.map(x => `<b>${HOME[LOOK_HOME[x.look]].n}</b>×${x.n}（${fc(famOfLook(x.look))}牌的背面）`).join(' + ')}`;\n// 3D 裡的東西在螢幕上的位置：教學框要指著它\nfunction anchor(name, at, w = 150, h = 150) {\n  let el = document.getElementById(`anc-${name}`);\n  if (!el) { el = document.createElement('div'); el.id = `anc-${name}`; $('#anchors').appendChild(el); }\n  if (!glOK) { el.style.display = 'none'; return null; }\n  const v = at.clone().project(camera);\n  if (v.z > 1 || Math.abs(v.x) > 0.95 || Math.abs(v.y) > 0.95) { el.style.display = 'none'; return null; }\n  const x = (v.x + 1) / 2 * innerWidth, y = (1 - v.y) / 2 * innerHeight;\n  Object.assign(el.style, { display: 'block', left: `${x - w / 2}px`, top: `${y - h / 2}px`, width: `${w}px`, height: `${h}px` });\n  return el;\n}\n// v1.5 教學：第 1 天手把手（做對了就往下，不用按「知道了」）；只看不做的步驟只留四處；其餘改成不擋畫面的小提示（NUDGES）\nconst handCards = () => Array.from(document.querySelectorAll('#hand .hc'));\nconst firstPlayed = () => { const p = S.T.plays[0]; return p ? cardOf(S, p.id).t : 'changqiang'; };\nconst LESSONS = {\n  open: [\n    { at: () => [handOf('changqiang')], until: () => S.T.plays.length > 0, text: () => `金框的牌能打。第一张要打木牌上的起手${fc('sing')}：点「长腔」。`, tap: '点这张' },\n  ],\n  chain: [\n    { at: () => [handOf('bai')], until: () => S.T.plays.length > 1, text: () => `长腔写着「接 → ${fc('speak')}」。下一张打${fc('speak')}，就接上了，多拿金。点「白」。`, tap: '点这张' },\n  ],\n  chain2: [\n    { at: handCards, place: 'left', until: () => S.T.plays.length >= 4 || S.T.ended, text: () => '金框的牌都接得上。照「接」再打两张。' },\n  ],\n  end: [\n    { at: () => [$('[data-act=\"endstage\"]')], until: () => S.T.ended, text: () => '四张了，脸上也有四层油彩。见好就收：点收场。', tap: '点收场' },\n  ],\n  door: [\n    { at: () => [glOK ? anchor('mirror', new THREE.Vector3(1.32, TOP + 0.46, -0.02), 200, 200) : $('#topmid')], follow: true, title: '你的脸', text: () => '台上打几张，脸上就有几层油彩。', rule: '进门前卸掉；没卸的，会染到推给她的牌' },\n    { at: handCards, place: 'left', until: () => !S.T.layers.length || view !== 'door', text: () => '点一张牌弃掉，卸一层。卸干净再进门。' },\n  ],\n  home: [\n    { title: '一张牌，两面', vis: () => `<div class=\"flip\"><div class=\"fl\"><img src=\"${cardArt(firstPlayed(), 'stage').url}\" alt=\"\"><img class=\"b\" src=\"${cardArt(firstPlayed(), 'home').url}\" alt=\"\"></div><div class=\"cap\">台上面：<b>${T[firstPlayed()].n}</b><br>家里面：<b>${HOME[FAM[T[firstPlayed()].f].home].n}</b></div></div>`, text: () => '台上打掉、卸妆弃掉的牌，今晚就没了。', rule: '留在手里的，回家翻过来推给她' },\n    { at: () => [$('#homep')], title: '她的灯', text: () => '往后每晚她要一样东西，推对了，灯亮一片。', rule: '没满足她，灯熄一截' },\n  ],\n  intel: [\n    { at: () => [$('.intel')], title: '今晚她要', text: () => `今晚她${needTx()}。`, rule: '印着「家」的牌，留着别打上台' },\n  ],\n  need: [\n    { at: handCards, place: 'left', title: '被染', read: () => !S.T.box.some(id => !S.T.used[id] && canHome(S, id) && isMatch(S, id) && !willDye(S, id)) && !S.T.box.some(id => !S.T.used[id] && canHome(S, id) && !isMatch(S, id)), until: () => gotOf(S.T) >= S.T.need.k || S.T.pushed.length >= S.T.homeCap, text: () => { const n = HOME[LOOK_HOME[S.T.need.items[0].look]].n, spare = S.T.box.some(id => !S.T.used[id] && canHome(S, id) && !isMatch(S, id)); return !S.T.dye ? `点金框的「${n}」，推给她。` : spare ? `牌角红的会被染：先推一张不要紧的，再推她要的「${n}」。` : `脸没卸干净，牌角红的会被染：推了，灯上留一道痕。下回卸干净再进门。`; } },\n  ],\n  pick: [\n    { at: () => [$('.spread')], title: '自己装妆匣', text: () => '上面是你的卡组：点一张，放进妆匣（下面一排）；点下面的，拿回去。', rule: '起手那一族一定要带；印着「家」的是她今晚要的' },\n  ],\n};\n// 小提示：不擋畫面、不用按；每條只出一次，同一時刻只有一條\nconst NUDGES = {\n  board: { at: () => $('#wboard'), when: () => view === 'morning' && S.day >= 2, tx: () => `<b>水牌</b>你和同门按卖座排名。第 3 天散戏后垫底，就被摘牌。` },\n  book: { at: () => $('#bookBtn'), when: () => view === 'morning' && S.day >= 2 && S.tut.seen.board, tx: () => '<b>图鉴</b>看不懂的牌和词，都在这里。' },\n  crowd: { at: () => $('.bub.intel'), when: () => view === 'stage', tx: () => '<b>台下的话</b>金框那句说的是她今晚要什么，会记在上面那一排。' },\n  wipe: { at: () => $('[data-act=\"wipe\"]'), when: () => view === 'door', tx: () => `<b>让她擦</b>一次擦 ${R.wipeLayers} 层，不耗牌；但今晚她只听得下 1 张。` },\n  stakes: { at: () => $('#homep'), when: () => view === 'night' && S.day >= 2 && !$('#lampfb:not([hidden])'), tx: () => `<b>她会走</b>灯熄满 ${R.brokenOuts} 回，或痕到 ${R.brokenScar} 道。` },\n  shop: { at: () => $('[data-act=\"shop\"]'), when: () => view === 'morning', tx: () => '<b>后台</b>孙师父卖牌和物件。花的就是卖座，名次会掉；越早买越划算。' },\n  wild: { at: () => $('.hc[data-wild].play'), when: () => view === 'stage', tx: () => '<b>百搭</b>前后都接得上，还能起手。链要断的时候用它。' },\n  grudge: { at: () => $('.nowline'), when: () => view === 'stage' && S.T.grudge > 0, tx: () => '<b>怨气</b>接错了，嘘声跟你回家：今晚多染一张牌。' },\n  gift: { at: () => $('.spread .spc[data-t^=\"home_\"]') || $('.spread'), when: () => view === 'morning' && S.gifts.length > 0 && !lockedBox(S), tx: () => '<b>家常牌</b>她送的，不上台。对上她的需要，一张算两张。' },\n};\nconst coach = { lesson: null, i: 0, shown: '' };\nfunction lessonNow() {\n  if (panel || sheet) return null;\n  const d = S.day, t = S.T;\n  if (view === 'stage') {\n    if (d !== 1) return null;\n    if (t.ended) return null;\n    return !t.plays.length ? 'open' : t.plays.length === 1 ? 'chain' : t.plays.length < 4 && !t.plays.some(p => p.broke) ? 'chain2' : t.plays.length >= 4 ? 'end' : null;\n  }\n  if (d === 1 && view === 'door' && t.layers.length) return 'door';\n  if (d === 1 && view === 'night') return 'home';\n  if (d === 2 && view === 'evening' && t.pushed.length === 0) return 'need';\n  if (view === 'morning' && !lockedBox(S) && d === 3) return 'pick';\n  if (view === 'morning' && d === 2) return 'intel';\n  return null;\n}\nfunction coachStart(k) { coach.lesson = k; coach.i = 0; coach.shown = ''; coach.view = view; }\nfunction coachNext() {\n  if (!coach.lesson) return;\n  coach.i += 1;\n  if (coach.i < LESSONS[coach.lesson].length) return;\n  S.tut.seen[coach.lesson] = true;\n  coach.lesson = null;\n  if ([...Object.keys(LESSONS), ...Object.keys(NUDGES)].every(k => S.tut.seen[k])) setTutPref(false);\n}\nfunction coachSkip() { S.tut.off = true; coach.lesson = null; setTutPref(false); nudgeHide(true); }\n// 狀態一變就看一次：要玩家做的事做到了就往下；這個時段還沒教過就開始教\nfunction coachTick() {\n  if (busy || !S || view === 'title' || !S.tut) return;\n  for (let n = 0; n < 4; n++) {\n    if (coach.lesson) {\n      // 換了場景：這一課就算教完了，不跟著帶過去\n      if (view !== coach.view) { S.tut.seen[coach.lesson] = true; coach.lesson = null; continue; }\n      const st = LESSONS[coach.lesson][coach.i];\n      if (!st.until || !st.until()) return;\n      coachNext();\n    } else {\n      const k = lessonNow();\n      if (!k || S.tut.off || S.tut.seen[k]) return nudgeTick();\n      coachStart(k);\n    }\n  }\n}\nfunction coachRender(geom = false) {\n  const el = $('#coach'), on = !!S && !!coach.lesson && !busy && view !== 'title' && panel !== 'rules';\n  $('#hud').inert = false;\n  if (!on) { el.hidden = true; return; }\n  const steps = LESSONS[coach.lesson], st = steps[coach.i], key = `${coach.lesson}:${coach.i}`;\n  const els = st.at ? st.at().filter(x => x && x.getClientRects().length) : [];\n  const act = !!st.until && els.length > 0 && !(st.read && st.read());\n  if (coach.shown !== key && st.on) st.on();\n  if (coach.shown !== key && els[0] && !els[0].closest('#anchors')) els[0].scrollIntoView({ block: 'nearest', inline: 'center' });\n  let r = null;\n  els.forEach(x => { const b = x.getBoundingClientRect(); r = r ? { l: Math.min(r.l, b.left), t: Math.min(r.t, b.top), r: Math.max(r.r, b.right), b: Math.max(r.b, b.bottom) } : { l: b.left, t: b.top, r: b.right, b: b.bottom }; });\n  const W = innerWidth, H = innerHeight, pad = act ? 5 : 8;\n  if (r) r = { l: Math.max(4, r.l - pad), t: Math.max(4, r.t - pad), r: Math.min(W - 4, r.r + pad), b: Math.min(H - 4, r.b + pad) };\n  el.hidden = false;\n  hidePeek();\n  const doing = act ? `<span class=\"do\">${esc(st.tap || '点亮起来的地方')}</span>` : `<button class=\"btn go small\" data-act=\"coachnext\">${coach.i < steps.length - 1 ? '下一句' : '好'}</button>`;\n  el.classList.toggle('doing', act);\n  // 只挪位置（鏡頭在動）：不重建，免得說明框重播淡入\n  const keep = geom && coach.shown === key && el.querySelector('.cbox') && !!el.querySelector('.ring') === !!r;\n  if (!keep) el.innerHTML = `<div class=\"dim\"></div><div class=\"shield\"></div>${r ? `<div class=\"ring\" ${act && st.tap ? `data-tap=\"${esc(st.tap)}\"` : ''}></div>` : ''}\n    <div class=\"cbox\" role=\"dialog\" aria-label=\"${esc(st.title || '教学')}\" aria-describedby=\"coachX\">${steps.length > 1 && !act ? `<span class=\"step\">${coach.i + 1}/${steps.length}</span>` : ''}${st.title && !act ? `<h4 id=\"coachT\">${st.title}</h4>` : ''}${st.vis ? st.vis() : ''}<div class=\"tx\" id=\"coachX\">${termify(st.text())}</div>${st.rule ? `<p class=\"rule\">${termify(typeof st.rule === 'function' ? st.rule() : st.rule)}</p>` : ''}\n      <div class=\"row\">${doing}<button class=\"skip\" data-act=\"coachskip\">不用教了</button></div><i class=\"arrow\" aria-hidden=\"true\"></i></div>`;\n  const path = `path(evenodd, 'M0 0H${W}V${H}H0Z${r ? `M${r.l} ${r.t}H${r.r}V${r.b}H${r.l}Z` : ''}')`;\n  el.querySelector('.dim').style.clipPath = path;\n  el.querySelector('.shield').style.clipPath = act ? path : 'none';\n  if (r) Object.assign(el.querySelector('.ring').style, { left: `${r.l}px`, top: `${r.t}px`, width: `${r.r - r.l}px`, height: `${r.b - r.t}px` });\n  // 說明框放在洞上下空間大的一邊，箭頭指著洞\n  const box2 = el.querySelector('.cbox'), bw = box2.offsetWidth, bh = box2.offsetHeight, ar = box2.querySelector('.arrow');\n  let left = (W - bw) / 2, top = (H - bh) / 2;\n  if (r) {\n    const below = H - r.b >= r.t, side = st.place === 'left' && r.l - bw - 24 > 0;\n    // 洞上方掛著「點這裡」的小籤，說明框放上面時要讓開它\n    top = below ? r.b + 16 : r.t - (act ? 46 : 16) - bh;\n    left = (r.l + r.r) / 2 - bw / 2;\n    if (side) { left = r.l - bw - 18; top = (r.t + r.b) / 2 - bh / 2; }\n    top = clamp(top, 12, H - bh - 12); left = clamp(left, 16, W - bw - 16);\n    ar.hidden = side || (top < r.b && top + bh > r.t);\n    ar.className = `arrow ${below ? 'up' : 'down'}`;\n    ar.style.left = `${clamp((r.l + r.r) / 2 - left - 7, 14, bw - 28)}px`;\n  } else ar.hidden = true;\n  Object.assign(box2.style, { left: `${left}px`, top: `${top}px` });\n  // 只看不做的步驟：底下的介面暫時不能操作，焦點放在「知道了」\n  $('#hud').inert = !act;\n  if (coach.shown !== key) {\n    coach.shown = key;\n    const f = act ? els.find(x => x.matches('button')) : box2.querySelector('.btn.go');\n    f?.focus({ preventScroll: true });\n  }\n}\nfunction coachUpdate() { coachTick(); coachRender(); nudgePlace(); }\n// ── 小提示 ──\nconst nudge = { k: null, until: 0, timer: 0 };\nfunction nudgeTick() {\n  if (!S || !S.tut || S.tut.off || busy || panel || sheet || view === 'title') return;\n  if (nudge.k) return;\n  for (const k of Object.keys(NUDGES)) {\n    const n = NUDGES[k];\n    if (S.tut.seen[k] || !n.when()) continue;\n    const el = n.at();\n    if (!el || !el.getClientRects().length) continue;\n    nudgeShow(k);\n    return;\n  }\n}\nfunction nudgeShow(k) {\n  nudge.k = k;\n  S.tut.seen[k] = true;\n  let el = $('#nudge');\n  if (!el) { el = document.createElement('div'); el.id = 'nudge'; el.setAttribute('role', 'note'); document.body.appendChild(el); el.addEventListener('click', () => nudgeHide()); }\n  el.className = '';\n  el.hidden = false;\n  el.innerHTML = `${NUDGES[k].tx()}<span class=\"x\" aria-hidden=\"true\">×</span>`;\n  nudgePlace();\n  clearTimeout(nudge.timer);\n  nudge.timer = setTimeout(() => nudgeHide(), 9000);\n}\nfunction nudgeHide(now = false) {\n  const el = $('#nudge');\n  clearTimeout(nudge.timer);\n  nudge.k = null;\n  if (!el) return;\n  if (now) { el.hidden = true; return; }\n  el.classList.add('out');\n  setTimeout(() => { if (!nudge.k) el.hidden = true; nudgeTick(); }, 420);\n}\n// 貼在目標旁邊：下面空就放下面，不然放上面；目標不見了就收\nfunction nudgePlace() {\n  const el = $('#nudge');\n  if (!el || el.hidden || !nudge.k) return;\n  const n = NUDGES[nudge.k], tg = n.at();\n  if (!tg || !tg.getClientRects().length || !n.when() || coach.lesson || panel || sheet) { nudgeHide(true); return; }\n  const r = tg.getBoundingClientRect(), w = el.offsetWidth, h = el.offsetHeight;\n  const below = innerHeight - r.bottom > h + 16;\n  const top = below ? r.bottom + 8 : r.top - h - 8;\n  const left = clamp((r.left + r.right) / 2 - w / 2, 12, innerWidth - w - 12);\n  Object.assign(el.style, { left: `${left}px`, top: `${clamp(top, 8, innerHeight - h - 8)}px` });\n}\nsetInterval(() => { if (nudge.k) nudgePlace(); else if (!coach.lesson) nudgeTick(); }, 400);\naddEventListener('resize', () => { if (coach.lesson) coachRender(); });\n// 指著 3D 東西的步驟：鏡頭在動，框跟著挪\n// 只在鏡頭真的挪了位置時重畫，免得說明框一直重播淡入\nlet followSig = '';\nsetInterval(() => {\n  const st = coach.lesson && !busy ? LESSONS[coach.lesson][coach.i] : null;\n  if (!st || (!st.follow && !st.until)) { followSig = ''; return; }\n  const sig = (st.at ? st.at() : []).filter(Boolean).map(x => { const b = x.getBoundingClientRect(); return `${Math.round(b.left / 3)},${Math.round(b.top / 3)},${Math.round(b.width / 3)}`; }).join('|');\n  if (sig !== 