t s = size ? size / Math.max(im.width, im.height) : 1, w = Math.round(im.width * s), h = Math.round(im.height * s);","+  const c = document.createElement('canvas'); c.width = w; c.height = h;","+  const x = c.getContext('2d'); x.imageSmoothingQuality = 'high'; x.drawImage(im, 0, 0, w, h);","+  x.globalCompositeOperation = 'source-in'; x.fillStyle = col; x.fillRect(0, 0, w, h);","+  return (ART.tint[k] = c);","+}","+// 圖裡有東西的那一塊（0–1），插圖按這一塊縮放置中，每張看起來一樣大","+function artBox(key, paths) {","+  if (ART.box[key]) return ART.box[key];","+  const N = 160, c = document.createElement('canvas'); c.width = c.height = N;","+  const x = c.getContext('2d');","+  paths.forEach(p => { const im = artImg(p); if (im) x.drawImage(im, 0, 0, N, N); });","+  const d = x.getImageData(0, 0, N, N).data;","+  let x0 = N, y0 = N, x1 = -1, y1 = -1;","+  for (let y = 0; y < N; y++) for (let X = 0; X < N; X++) if (d[(y * N + X) * 4 + 3] > 24) { if (X < x0) x0 = X; if (X > x1) x1 = X; if (y < y0) y0 = y; if (y > y1) y1 = y; }","+  return (ART.box[key] = x1 < 0 ? [0, 0, 1, 1] : [x0 / N, y0 / N, (x1 + 1) / N, (y1 + 1) / N]);","+}","+// 雙層插圖（卡面、物件）：line 染 lineCol、accent 染 accCol，主體縮進 (X, Y, W, H) 置中","+function drawDuo(x, base, X, Y, W, H, lineCol, accCol, res = 512) {","+  const L = `${base}_line.png`, A = `${base}_accent.png`;","+  if (!artImg(L)) return false;","+  const b = artBox(base, [L, A]), bw = b[2] - b[0], bh = b[3] - b[1], s = Math.min(W / bw, H / bh);","+  const ox = X + W / 2 - (b[0] + bw / 2) * s, oy = Y + H / 2 - (b[1] + bh / 2) * s;","+  x.drawImage(artTint(L, lineCol, res), ox, oy, s, s);","+  if (artImg(A)) x.drawImage(artTint(A, accCol, res), ox, oy, s, s);","+  return true;","+}","+// 卡紙：50% 灰的紙紋用「疊加」蓋在整張卡上，依牌輪換四張","+function paperOver(x, t, alpha = 1) {","+  const p = artImg(`cards/paper_0${1 + (hash(t) % 4)}.png`);","+  if (!p) return false;","+  x.save(); rr(x, 0, 0, CW, CH, 16); x.clip();","+  x.globalCompositeOperation = 'overlay'; x.globalAlpha = alpha; x.drawImage(p, 0, 0, CW, CH);","+  x.restore();","+  return true;","+}","+// 邊框：純黑紋樣染成要的顏色；位置與 v1.5 的缺角框一樣（邊距 14）","+function borderArt(x, which, col) {","+  const p = `cards/border_${which}.png`;","+  if (!artImg(p)) return false;","+  x.drawImage(artTint(p, col), 0, 0, CW, CH);","+  return true;","+}","+// 卡面插圖的點題色：紅底的唱族牌上朱紅看不見，改用深一截的胭脂","+const accentOn = f => (f === 'sing' ? '#4e0a10' : '#a8202b');"," function rng(a) {","   return () => { a |= 0; a = (a + 0x6D2B79F5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };"," }"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_012x9uCmtriEKBBkpRMv7Y8i","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
