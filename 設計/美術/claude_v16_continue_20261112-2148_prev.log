{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WupWdexjQVXXp7A5WiGXFU","type":"tool_result","content":"3176\tfunction renderHand() {\n3177\t  const h = $('#hand'), lb = $('#handLabel');\n3178\t  const show = ['morning', 'stage', 'door', 'evening', 'night'].includes(view) && !panel && !sheet && !(view === 'stage' && S.T.ended) && S.choice !== 'lamp';\n3179\t  h.classList.toggle('on', show);\n3180\t  if (!show) { h.innerHTML = ''; lb.innerHTML = ''; return; }\n3181\t  const t = S.T, side = view === 'evening' ? 'home' : 'stage', ids = t.box.filter(id => !t.used[id]);\n3182\t  const covered = view === 'evening' ? coveredFams(S) : [];\n3183\t  const can = id => {\n3184\t    if (busy) return false;\n3185\t    if (view === 'stage') return canStage(S, id);\n3186\t    if (view === 'evening') return canHome(S, id);\n3187\t    if (view === 'door' || view === 'night') return canClean(S, id);\n3188\t    return view === 'morning' && !lockedBox(S);\n3189\t  };\n3190\t  const hot = id => {\n3191\t    if (busy) return false;\n3192\t    if (view === 'stage') return canStage(S, id) && (!S.T.plays.length || fits(S, id)) && !keepHint(id);\n3193\t    if (view === 'evening') return canHome(S, id) && isMatch(S, id) && lack(S, lookOfCard(S, id)) > 0 && !willDye(S, id);\n3194\t    return false;\n3195\t  };\n3196\t  const n = ids.length, mid = (n - 1) / 2;\n3197\t  h.innerHTML = ids.map((id, i) => {\n3198\t    const c = cardOf(S, id), ok = can(id), tp = T[c.t];\n3199\t    const rot = (i - mid) * Math.min(2.6, 24 / Math.max(n, 1)), lift = Math.abs(i - mid) * 1.3;\n3200\t    const label = tp.home ? `${tp.n}，家常牌，不上台，背面${HOME[FAM[tp.f].home].n}` : `${tp.n}，${FAM[tp.f].n}，金 ${tp.g}，接${nextN(tp)}${kwOf(tp) ? `，${kwOf(tp)}` : ''}，背面${tp.blank ? '空白' : HOME[FAM[tp.f].home].n}`;\n3201\t    const dim = !ok && view !== 'morning';\n3202\t    const home = ['morning', 'stage', 'door'].includes(view) && keepHint(id);\n3203\t    return `<button class=\"hc ${ok ? 'play' : ''} ${hot(id) ? 'hot' : ''} ${dim ? 'off' : ''} ${home ? 'want' : ''}\" data-id=\"${id}\" ${tp.wild ? 'data-wild=\"1\"' : ''} style=\"transform:translateY(${lift}px) rotate(${rot}deg)\" ${ok ? `data-act=\"card\" data-arg=\"${id}\"` : 'disabled'} aria-label=\"${esc(label)}${home ? '，她今晚要的' : ''}\"><img src=\"${cardArt(c.t, side, covered.includes(tp.f) && !tp.home).url}\" alt=\"\">${view === 'evening' && canHome(S, id) && willDye(S, id) ? '<span class=\"stain\"></span>' : ''}${home ? '<span class=\"wtag\" aria-hidden=\"true\">家</span>' : ''}</button>`;\n3204\t  }).join('');\n3205\t  const tx = {\n3206\t    morning: lockedBox(S) ? '' : t.box.length ? '妆匣里的 · 点一张拿回去' : '妆匣是空的',\n3207\t    stage: ids.some(keepHint) ? '金框的能打 · 印着「家」的留着回家' : '',\n3208\t    door: t.layers.length ? '点一张牌卸一层' : '',\n3209\t    evening: t.pushed.length >= t.homeCap ? '她听不下了' : '点牌推给她',\n3210\t    night: t.layers.length ? '点一张牌卸一层' : '',\n3211\t  }[view];\n3212\t  // 裝匣的兩個按鈕跟著妝匣\n3213\t  const tools = view === 'morning' && !lockedBox(S) ? `<button class=\"mini\" data-act=\"yesterday\" ${S.lastBox ? '' : 'disabled'}>照昨天装</button><button class=\"mini\" data-act=\"clear\" ${t.box.length ? '' : 'disabled'}>全拿出来</button>` : '';\n3214\t  lb.innerHTML = `${tx ? `<span class=\"hlb\">${esc(tx)}</span>` : ''}${tools}`;\n3215\t}\n3216\t// 第一人稱時，臉上沒卸的台上臉化成螢幕四邊的油彩\n3217\tfunction renderSmear() {\n3218\t  const cv = $('#smear'), w = innerWidth, h = innerHeight;\n3219\t  if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; }\n3220\t  const x = cv.getContext('2d'); x.clearRect(0, 0, w, h);\n3221\t  if (!S || !['door', 'evening', 'night'].includes(view)) return;\n3222\t  const m = Math.min(w, h);\n3223\t  S.T.layers.forEach((ly, i) => {\n3224\t    const r = rng(101 + i * 977), col = hexRgb(FCOL[ly.f]);\n3225\t    for (let k = 0; k < 7; k++) {\n3226\t      const side = Math.floor(r() * 4); let px, py;\n3227\t      if (side === 0) { px = r() * w; py = -h * 0.04 + r() * h * 0.1; } else if (side === 1) { px = r() * w; py = h * 1.02 - r() * h * 0.08; } else if (side === 2) { px = -w * 0.02 + r() * w * 0.07; py = r() * h; } else { px = w * 1.02 - r() * w * 0.07; py = r() * h; }\n3228\t      const rad = (0.1 + r() * 0.14) * m, g = x.createRadialGradient(px, py, 0, px, py, rad);\n3229\t      g.addColorStop(0, `rgba(${col},.55)`); g.addColorStop(0.55, `rgba(${col},.22)`); g.addColorStop(1, `rgba(${col},0)`);\n3230\t      x.fillStyle = g; x.beginPath(); x.arc(px, py, rad, 0, Math.PI * 2); x.fill();\n3231\t    }\n3232\t  });\n3233\t}\n3234\tasync function ink(fn) {\n3235\t  const el = $('#ink');\n3236\t  if (calm()) { fn(); return; }\n3237\t  el.className = ''; void el.offsetWidth; el.className = 'on';\n3238\t  await wait(600); fn(); refresh(); await wait(100);\n3239\t  el.className = 'off'; await wait(460); el.className = '';\n3240\t}\n3241\tasync function fly(id, where) {\n3242\t  const el = document.querySelector(`.hc[data-id=\"${id}\"]`), t = cardOf(S, id).t, side = where === 'home' ? 'home' : 'stage';\n3243\t  const target = !glOK ? null : where === 'stage' ? cardSpot('stage', S.T.plays.length) : where === 'home' ? cardSpot('home', S.T.pushed.length) : null;\n3244\t  if (el && !calm()) {\n3245\t    const r = el.getBoundingClientRect(), ghost = new Image();\n3246\t    ghost.src = cardArt(t, side).url; ghost.className = 'ghost'; Object.assign(ghost.style, { left: r.left + 'px', top: r.top + 'px', width: r.width + 'px', height: r.height + 'px' });\n3247\t    document.body.appendChild(ghost); el.style.visibility = 'hidden';\n3248\t    let tx = innerWidth / 2, ty = innerHeight * 0.45;\n3249\t    if (glOK && target) { const v = target.clone().project(camera); tx = (v.x + 1) / 2 * innerWidth; ty = (1 - v.y) / 2 * innerHeight; }\n3250\t    if (!target && where === 'cloth') ty = innerHeight + 80;\n3251\t    const anim = ghost.animate([{ transform: 'none', opacity: 1 }, { transform: `translate(${tx - r.left - r.width / 2}px, ${ty - r.top - r.height / 2}px) scale(${target ? 0.32 : 0.5}) rotate(${where === 'cloth' ? 40 : 8}deg)`, opacity: where === 'cloth' ? 0 : 0.95 }], { duration: 400, easing: 'cubic-bezier(.3,.7,.3,1)' });\n3252\t    await Promise.race([anim.finished.catch(() => {}), wait(700)]);\n3253\t    ghost.remove();\n3254\t  }\n3255\t  if (target) spawnCard(t, side, target);\n3256\t}\n3257\tfunction burst(n) {\n3258\t  if (calm()) return;\n3259\t  const fx = $('#fx');\n3260\t  for (let i = 0; i < Math.min(n, 44); i++) {\n3261\t    const f = document.createElement('span'); f.className = 'fleck';\n3262\t    f.style.left = `${8 + Math.random() * 84}vw`; f.style.animationDelay = `${Math.random() * 0.5}s`; f.style.background = Math.random() < 0.3 ? '#efe2c2' : '#b8913f';\n3263\t    fx.appendChild(f); setTimeout(() => f.remove(), 2600);\n3264\t  }\n3265\t}\n3266\tfunction stamp(text) { const s = document.createElement('div'); s.className = 'stamp'; s.textContent = text; document.body.appendChild(s); setTimeout(() => s.remove(), 1800); }\n3267\tconst PIPS = { 1: [4], 2: [0, 8], 3: [0, 4, 8], 4: [0, 2, 6, 8], 5: [0, 2, 4, 6, 8], 6: [0, 2, 3, 5, 6, 8] };\n3268\tconst dieHTML = (v, cls = '') => `<span class=\"die ${cls} ${v === 1 || v === 4 ? 'red' : ''}\" aria-hidden=\"true\">${Array.from({ length: 9 }, (_, i) => `<i class=\"${PIPS[v].includes(i) ? 'on' : ''}\"></i>`).join('')}</span>`;\n3269\tasync function showDice(o) {\n3270\t  const el = $('#dice');\n3271\t  el.hidden = false;\n3272\t  el.innerHTML = `<div class=\"dbox\" role=\"status\"><span class=\"lb\">${esc(o.label)}</span><span class=\"dslot\">${dieHTML(1)}</span><span class=\"res\"></span></div>`;\n3273\t  const slot = el.querySelector('.dslot'), res = el.querySelector('.res');\n3274\t  if (!calm()) for (let i = 0; i < 8; i++) { slot.innerHTML = dieHTML(1 + Math.floor(Math.random() * 6), 'spin'); await wait(65); }\n3275\t  slot.innerHTML = dieHTML(o.v, 'land');\n3276\t  res.className = `res ${o.ok ? 'ok' : 'bad'}`;\n3277\t  res.textContent = `${o.v}　${o.result}`;\n3278\t  await wait(calm() ? 900 : 1300);\n3279\t  el.hidden = true;\n3280\t}\n3281\t// ── 觀眾的話：對白框貼在剪紙頭頂；情報金框、同門紅框，說完就散 ──\n3282\tlet bubs = [];\n3283\tconst SPEAK = { L: [0, 1, 2], R: [6, 7, 8], C: [3, 5] };\n3284\tfunction bubble(html, kind = 'n', o = {}) {\n3285\t  if (view !== 'stage') return null;\n3286\t  if (kind === 'n' && (coach.lesson || nudge.k)) return null;\n3287\t  const busyI = bubs.map(b => b.i);\n3288\t  let pool = (kind === 'intel' || kind === 'ev' ? [...SPEAK.L, ...SPEAK.R] : [...SPEAK.L, ...SPEAK.R, ...SPEAK.C]).filter(i => !busyI.includes(i));\n3289\t  if (o.side) pool = pool.filter(i => SPEAK[o.side].includes(i));\n3290\t  // 情報與同門的話，各佔一邊，不擋戲台中間\n3291\t  if (kind === 'intel' && bubs.some(b => b.kind === 'ev')) pool = pool.filter(i => SPEAK[bubs.find(b => b.kind === 'ev').i <= 2 ? 'R' : 'L'].includes(i));\n3292\t  const i = pool.length ? pool[Math.floor(Math.random() * pool.length)] : 0;\n3293\t  const el = document.createElement('div');\n3294\t  el.className = `bub ${kind}`;\n3295\t  el.innerHTML = `${kind === 'intel' ? '<span class=\"tg\">情报 · 台下</span>' : kind === 'ev' ? '<span class=\"tg\">同门的事</span>' : ''}${html}`;\n3296\t  $('#talkb').appendChild(el);\n3297\t  const b = { el, i, kind, until: performance.now() + (kind === 'intel' ? 14000 : kind === 'ev' ? 5500 : 2600) };\n3298\t  // 同一個人換一句：舊的先收\n3299\t  bubs.filter(x => x.kind === 'n' && kind === 'n').slice(0, -1).forEach(x => { x.until = 0; });\n3300\t  bubs.push(b);\n3301\t  placeBub(b);\n3302\t  return b;\n3303\t}\n3304\tfunction placeBub(b) {\n3305\t  const h = crowdHead(b.i) || { x: innerWidth * (b.i <= 2 ? 0.16 : b.i >= 6 ? 0.84 : 0.5), y: innerHeight * 0.66 };\n3306\t  const w = b.el.offsetWidth, ht = b.el.offsetHeight;\n3307\t  const x = clamp(h.x, w / 2 + 8, innerWidth - w / 2 - 8), y = clamp(h.y - 8, ht + 8, innerHeight - 8);\n3308\t  b.el.style.left = `${x}px`; b.el.style.top = `${y}px`;\n3309\t  b.el.style.setProperty('--ax', `${clamp(h.x - (x - w / 2), 16, w - 16)}px`);\n3310\t}\n3311\tfunction bubTick() {\n3312\t  const now = performance.now();\n3313\t  bubs = bubs.filter(b => {\n3314\t    if (now < b.until || (b.kind === 'intel' && coach.lesson === 'crowd')) { placeBub(b); return true; }\n3315\t    b.el.classList.add('out'); setTimeout(() => b.el.remove(), 360);\n3316\t    return false;\n3317\t  });\n3318\t}\n3319\tsetInterval(bubTick, 120);\n3320\tfunction clearBubs() { bubs.forEach(b => b.el.remove()); bubs = []; }\n3321\t// 台下閒聊：沒人說話的時候，隔一陣有人開口；同門的事、戲台的事\n3322\tconst CHATTER = [`金宝今儿${K('嗓子')}不错。`, `月仙在侧幕${K('盯着你')}呢。`, `魏老板说，元宵要${K('定新头牌')}。`, '后排的，往前挤挤。', '今儿的灯笼是新换的。', `玉楼那张嘴，${K('什么都知道')}。`, '这出戏，我看过三回了。', `小凤的${K('嗓子')}，不知好了没有。`];\n3323\tconst chat = { day: 0, n: 0 };\n3324\tconst chatMax = () => (S.day === 1 ? 2 : !S.tut.off && S.day <= 2 ? 3 : 6);\n3325\tsetInterval(() => {\n3326\t  if (view !== 'stage' || busy || !S || S.T.ended || bubs.length >= 2 || document.hidden || coachOn() || panel) return;\n3327\t  if (chat.day !== S.day) { chat.day = S.day; chat.n = 0; }\n3328\t  if (chat.n >= chatMax()) return;\n3329\t  chat.n += 1;\n3330\t  bubble(pick(CHATTER), 'n', { side: Math.random() < 0.5 ? 'L' : 'R' });\n3331\t}, 7000);\n3332\t\n3333\t// ── 台上的特效：紙屑、金箔、彩綢、墨點、煙花（畫在 3D 上面、字的下面）──\n3334\tconst fxc = $('#stagefx'), fxx = fxc.getContext('2d');\n3335\tlet parts = [], fxOn = false, fxLast = 0;\n3336\tconst FXCOL = { petal: ['#c8283a', '#e0475a', '#f2d48a', '#efe2c8', '#a8202b'], foil: ['#f6dc96', '#e8c46a', '#fff3cf'], spark: ['#ffe9a8', '#f2d48a', '#fff'], ink: ['#120e11', '#2b2427', '#3a0a0e'], fw: ['#ffe9a8', '#ff8a6a', '#f2d48a', '#ffd0dc', '#fff'] };\n3337\tfunction fxSize() {\n3338\t  const d = Math.min(devicePixelRatio || 1, 2);\n3339\t  if (fxc.width !== Math.round(innerWidth * d) || fxc.height !== Math.round(innerHeight * d)) { fxc.width = Math.round(innerWidth * d); fxc.height = Math.round(innerHeight * d); }\n3340\t  fxx.setTransform(d, 0, 0, d, 0, 0);\n3341\t}\n3342\tfunction spawn(kind, n, o = {}) {\n3343\t  if (calm()) return;\n3344\t  if (view !== 'stage' && ['fw', 'foil', 'ribbon', 'petal'].includes(kind)) return;\n3345\t  fxSize();\n3346\t  const W = innerWidth, H = innerHeight;\n3347\t  for (let i = 0; i < n; i++) {\n3348\t    const p = { kind, t: 0, rot: Math.random() * 6.28, vr: (Math.random() - 0.5) * 9, col: pick(FXCOL[kind] || FXCOL.petal) };\n3349\t    if (kind === 'petal' || kind === 'foil') { p.x = Math.random() * W; p.y = -20 - Math.random() * H * 0.5; p.vx = (Math.random() - 0.5) * 70; p.vy = (kind === 'foil' ? 190 : 110) + Math.random() * 100; p.s = kind === 'foil' ? 5 + Math.random() * 7 : 7 + Math.random() * 9; p.life = 3.6; p.sw = Math.random() * 6.28; }\n3350\t    else if (kind === 'spark' || kind === 'fw') { const a = Math.random() * 6.28, v = (kind === 'fw' ? 180 : 120) + Math.random() * (kind === 'fw' ? 280 : 220); p.x = o.x; p.y = o.y; p.vx = Math.cos(a) * v; p.vy = Math.sin(a) * v - 70; p.s = 2 + Math.random() * 3; p.life = 0.7 + Math.random() * 0.6; }\n3351\t    else if (kind === 'ink') { const a = Math.random() * 6.28, v = 70 + Math.random() * 280; p.x = o.x; p.y = o.y; p.vx = Math.cos(a) * v; p.vy = Math.sin(a) * v - 90; p.s = 3 + Math.random() * 8; p.life = 0.9 + Math.random() * 0.5; }\n3352\t    else if (kind === 'ribbon') { p.side = i % 2 ? 1 : -1; p.y0 = H * (0.12 + Math.random() * 0.4); p.life = 2; p.ph = Math.random() * 6.28; p.col = i % 3 === 2 ? '#f2d48a' : '#c8283a'; p.w = 6 + Math.random() * 5; }\n3353\t    parts.push(p);\n3354\t  }\n3355\t  if (!fxOn) { fxOn = true; fxLast = performance.now(); requestAnimationFrame(fxLoop); }\n3356\t}\n3357\tfunction fxLoop(now) {\n3358\t  const dt = Math.min(0.05, (now - fxLast) / 1000), W = innerWidth;\n3359\t  fxLast = now;\n3360\t  fxx.clearRect(0, 0, W, innerHeight);\n3361\t  parts = parts.filter(p => (p.t += dt) < p.life);\n3362\t  for (const p of parts) {\n3363\t    fxx.globalAlpha = Math.min(1, (p.life - p.t) / 0.45);\n3364\t    if (p.kind === 'ribbon') {\n3365\t      const k = Math.min(1, p.t / (p.life * 0.55)), len = W * 0.55 * k;\n3366\t      fxx.strokeStyle = p.col; fxx.lineWidth = p.w; fxx.lineCap = 'round'; fxx.beginPath();\n3367\t      for (let s0 = 0; s0 <= len; s0 += 12) { const x = p.side < 0 ? s0 : W - s0, y = p.y0 + Math.sin(s0 * 0.018 + p.ph + p.t * 7) * 34 - s0 * 0.12; if (s0) fxx.lineTo(x, y); else fxx.moveTo(x, y); }\n3368\t      fxx.stroke(); continue;\n3369\t    }\n3370\t    const grav = p.kind === 'petal' || p.kind === 'foil' ? 0 : 520;\n3371\t    p.vy += grav * dt; p.x += (p.vx + (p.sw !== undefined ? Math.sin(p.t * 3 + p.sw) * 40 : 0)) * dt; p.y += p.vy * dt; p.rot += p.vr * dt;\n3372\t    fxx.save(); fxx.translate(p.x, p.y); fxx.rotate(p.rot); fxx.fillStyle = p.col;\n3373\t    if (p.kind === 'petal') { fxx.beginPath(); fxx.ellipse(0, 0, p.s, Math.max(0.5, p.s * 0.5 * Math.abs(Math.cos(p.t * 4 + p.sw))), 0, 0, 6.28); fxx.fill(); }\n3374\t    else if (p.kind === 'foil') { fxx.globalAlpha *= 0.6 + 0.4 * Math.abs(Math.sin(p.t * 9 + p.sw)); fxx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.7); }\n3375\t    else { fxx.beginPath(); fxx.arc(0, 0, p.s, 0, 6.28); fxx.fill(); }\n3376\t    fxx.restore();\n3377\t  }\n3378\t  fxx.globalAlpha = 1;\n3379\t  if (parts.length) requestAnimationFrame(fxLoop); else { fxOn = false; fxx.clearRect(0, 0, W, innerHeight); }\n3380\t}\n3381\t// 打出去那張牌在螢幕上的位置\n3382\tfunction cardScreen(i) {\n3383\t  if (!glOK) return { x: innerWidth / 2, y: innerHeight * 0.42 };\n3384\t  const v = cardSpot('stage', i).project(camera);\n3385\t  return { x: (v.x + 1) / 2 * innerWidth, y: (1 - v.y) / 2 * innerHeight };\n3386\t}\n3387\tfunction banner(tx, sub, cls = '') {\n3388\t  if (calm()) return;\n3389\t  $('#combo').innerHTML = `<div class=\"cb ${cls}\">${esc(tx)}</div>${sub ? `<div class=\"cs\">${esc(sub)}</div>` : ''}`;\n3390\t}\n3391\tfunction gainFloat(at, tx, bad) {\n3392\t  if (calm()) return;\n3393\t  const el = document.createElement('div'); el.className = `gainf ${bad ? 'bad' : ''}`; el.textContent = tx;\n3394\t  el.style.left = `${at.x}px`; el.style.top = `${at.y}px`; document.body.appendChild(el); setTimeout(() => el.remove(), 1300);\n3395\t}\n3396\t// 連擊越長，台上越熱鬧：火星 → 紙屑、幕晃、大字 → 金箔、彩綢、鏡頭推近 → 煙花\n3397\tconst COMBO_TX = { 3: ['好！', '连击 ×3'], 4: ['满堂红', '连击 ×4'], 5: ['绝了', '五连'] };\n3398\tfunction comboFx(p) {\n3399\t  const n = S.T.chain, at = cardScreen(S.T.plays.length - 1);\n3400\t  gainFloat(at, `+${p.g + p.extra + p.open + p.fin}`, p.broke);\n3401\t  if (p.broke) {\n3402\t    spawn('ink', 30, at);\n3403\t    banner('倒彩', p.grudge ? '怨气 +1：今晚多染一张' : p.saved ? '小锣一响，这回不记怨气' : '连击归零', 'bad');\n3404\t    if (glOK) $('#gl').animate([{ filter: 'saturate(.15) brightness(.6)' }, { filter: 'none' }], { duration: 750, easing: 'ease-out' });\n3405\t    return;\n3406\t  }\n3407\t  spawn('spark', 10 + n * 8, at);\n3408\t  lanternKick = Math.min(1.6, 0.35 * n);\n3409\t  if (n >= 2) swayKick = Math.max(swayKick, 0.35 * n);\n3410\t  if (n >= 3) { spawn('petal', 40 + (n - 3) * 35); const b = COMBO_TX[Math.min(n, 5)]; banner(b[0], b[1], n >= 4 ? 'big' : ''); }\n3411\t  if (n >= 4) { spawn('foil', 80); spawn('ribbon', 6); if (glOK && camPos) camPos.lerp(camAim, 0.08); }\n3412\t  if (n >= 5) [0, 350, 700].forEach(d => setTimeout(() => spawn('fw', 60, { x: innerWidth * (0.2 + Math.random() * 0.6), y: innerHeight * (0.12 + Math.random() * 0.2) }), d));\n3413\t}\n3414\tasync function run(fn) { if (busy) return; busy = true; refresh(); try { await fn(); } finally { busy = false; refresh(); } }\n3415\t\n3416\t// ── 一天 ──\n3417\t// 依目前時段擺桌面（開局、接著玩都走這裡）\n3418\tfunction placeScene() {\n3419\t  if (view !== 'stage') { clearBubs(); stageHeat = 0; }\n3420\t  if (!glOK) return;"}]},"parent_tool_use_id":null,"session_id":"6a86d5cc-dadd-48d8-88f6-40a0a537648f","uuid":"745cee57-0f93-4e80-afa2-07bb043297a5","timestamp":"2026-11-12T13:30:37.299Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.6/index.html","content":"function renderHand() {\n  const h = $('#hand'), lb = $('#handLabel');\n  const show = ['morning', 'stage', 'door', 'evening', 'night'].includes(view) && !panel && !sheet && !(view === 'stage' && S.T.ended) && S.choice !== 'lamp';\n  h.classList.toggle('on', show);\n  if (!show) { h.innerHTML = ''; lb.innerHTML = ''; return; }\n  const t = S.T, side = view === 'evening' ? 'home' : 'stage', ids = t.box.filter(id => !t.used[id]);\n  const covered = view === 'evening' ? coveredFams(S) : [];\n  const can = id => {\n    if (busy) return false;\n    if (view === 'stage') return canStage(S, id);\n    if (view === 'evening') return canHome(S, id);\n    if (view === 'door' || view === 'night') return canClean(S, id);\n    return view === 'morning' && !lockedBox(S);\n  };\n  const hot = id => {\n    if (busy) return false;\n    if (view === 'stage') return canStage(S, id) && (!S.T.plays.length || fits(S, id)) && !keepHint(id);\n    if (view === 'evening') return canHome(S, id) && isMatch(S, id) && lack(S, lookOfCard(S, id)) > 0 && !willDye(S, id);\n    return false;\n  };\n  const n = ids.length, mid = (n - 1) / 2;\n  h.innerHTML = ids.map((id, i) => {\n    const c = cardOf(S, id), ok = can(id), tp = T[c.t];\n    const rot = (i - mid) * Math.min(2.6, 24 / Math.max(n, 1)), lift = Math.abs(i - mid) * 1.3;\n    const label = tp.home ? `${tp.n}，家常牌，不上台，背面${HOME[FAM[tp.f].home].n}` : `${tp.n}，${FAM[tp.f].n}，金 ${tp.g}，接${nextN(tp)}${kwOf(tp) ? `，${kwOf(tp)}` : ''}，背面${tp.blank ? '空白' : HOME[FAM[tp.f].home].n}`;\n    const dim = !ok && view !== 'morning';\n    const home = ['morning', 'stage', 'door'].includes(view) && keepHint(id);\n    return `<button class=\"hc ${ok ? 'play' : ''} ${hot(id) ? 'hot' : ''} ${dim ? 'off' : ''} ${home ? 'want' : ''}\" data-id=\"${id}\" ${tp.wild ? 'data-wild=\"1\"' : ''} style=\"transform:translateY(${lift}px) rotate(${rot}deg)\" ${ok ? `data-act=\"card\" data-arg=\"${id}\"` : 'disabled'} aria-label=\"${esc(label)}${home ? '，她今晚要的' : ''}\"><img src=\"${cardArt(c.t, side, covered.includes(tp.f) && !tp.home).url}\" alt=\"\">${view === 'evening' && canHome(S, id) && willDye(S, id) ? '<span class=\"stain\"></span>' : ''}${home ? '<span class=\"wtag\" aria-hidden=\"true\">家</span>' : ''}</button>`;\n  }).join('');\n  const tx = {\n    morning: lockedBox(S) ? '' : t.box.length ? '妆匣里的 · 点一张拿回去' : '妆匣是空的',\n    stage: ids.some(keepHint) ? '金框的能打 · 印着「家」的留着回家' : '',\n    door: t.layers.length ? '点一张牌卸一层' : '',\n    evening: t.pushed.length >= t.homeCap ? '她听不下了' : '点牌推给她',\n    night: t.layers.length ? '点一张牌卸一层' : '',\n  }[view];\n  // 裝匣的兩個按鈕跟著妝匣\n  const tools = view === 'morning' && !lockedBox(S) ? `<button class=\"mini\" data-act=\"yesterday\" ${S.lastBox ? '' : 'disabled'}>照昨天装</button><button class=\"mini\" data-act=\"clear\" ${t.box.length ? '' : 'disabled'}>全拿出来</button>` : '';\n  lb.innerHTML = `${tx ? `<span class=\"hlb\">${esc(tx)}</span>` : ''}${tools}`;\n}\n// 第一人稱時，臉上沒卸的台上臉化成螢幕四邊的油彩\nfunction renderSmear() {\n  const cv = $('#smear'), w = innerWidth, h = innerHeight;\n  if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; }\n  const x = cv.getContext('2d'); x.clearRect(0, 0, w, h);\n  if (!S || !['door', 'evening', 'night'].includes(view)) return;\n  const m = Math.min(w, h);\n  S.T.layers.forEach((ly, i) => {\n    const r = rng(101 + i * 977), col = hexRgb(FCOL[ly.f]);\n    for (let k = 0; k < 7; k++) {\n      const side = Math.floor(r() * 4); let px, py;\n      if (side === 0) { px = r() * w; py = -h * 0.04 + r() * h * 0.1; } else if (side === 1) { px = r() * w; py = h * 1.02 - r() * h * 0.08; } else if (side === 2) { px = -w * 0.02 + r() * w * 0.07; py = r() * h; } else { px = w * 1.02 - r() * w * 0.07; py = r() * h; }\n      const rad = (0.1 + r() * 0.14) * m, g = x.createRadialGradient(px, py, 0, px, py, rad);\n      g.addColorStop(0, `rgba(${col},.55)`); g.addColorStop(0.55, `rgba(${col},.22)`); g.addColorStop(1, `rgba(${col},0)`);\n      x.fillStyle = g; x.beginPath(); x.arc(px, py, rad, 0, Math.PI * 2); x.fill();\n    }\n  });\n}\nasync function ink(fn) {\n  const el = $('#ink');\n  if (calm()) { fn(); return; }\n  el.className = ''; void el.offsetWidth; el.className = 'on';\n  await wait(600); fn(); refresh(); await wait(100);\n  el.className = 'off'; await wait(460); el.className = '';\n}\nasync function fly(id, where) {\n  const el = document.querySelector(`.hc[data-id=\"${id}\"]`), t = cardOf(S, id).t, side = where === 'home' ? 'home' : 'stage';\n  const target = !glOK ? null : where === 'stage' ? cardSpot('stage', S.T.plays.length) : where === 'home' ? cardSpot('home', S.T.pushed.length) : null;\n  if (el && !calm()) {\n    const r = el.getBoundingClientRect(), ghost = new Image();\n    ghost.src = cardArt(t, side).url; ghost.className = 'ghost'; Object.assign(ghost.style, { left: r.left + 'px', top: r.top + 'px', width: r.width + 'px', height: r.height + 'px' });\n    document.body.appendChild(ghost); el.style.visibility = 'hidden';\n    let tx = innerWidth / 2, ty = innerHeight * 0.45;\n    if (glOK && target) { const v = target.clone().project(camera); tx = (v.x + 1) / 2 * innerWidth; ty = (1 - v.y) / 2 * innerHeight; }\n    if (!target && where === 'cloth') ty = innerHeight + 80;\n    const anim = ghost.animate([{ transform: 'none', opacity: 1 }, { transform: `translate(${tx - r.left - r.width / 2}px, ${ty - r.top - r.height / 2}px) scale(${target ? 0.32 : 0.5}) rotate(${where === 'cloth' ? 40 : 8}deg)`, opacity: where === 'cloth' ? 0 : 0.95 }], { duration: 400, easing: 'cubic-bezier(.3,.7,.3,1)' });\n    await Promise.race([anim.finished.catch(() => {}), wait(700)]);\n    ghost.remove();\n  }\n  if (target) spawnCard(t, side, target);\n}\nfunction burst(n) {\n  if (calm()) return;\n  const fx = $('#fx');\n  for (let i = 0; i < Math.min(n, 44); i++) {\n    const f = document.createElement('span'); f.className = 'fleck';\n    f.style.left = `${8 + Math.random() * 84}vw`; f.style.animationDelay = `${Math.random() * 0.5}s`; f.style.background = Math.random() < 0.3 ? '#efe2c2' : '#b8913f';\n    fx.appendChild(f); setTimeout(() => f.remove(), 2600);\n  }\n}\nfunction stamp(text) { const s = document.createElement('div'); s.className = 'stamp'; s.textContent = text; document.body.appendChild(s); setTimeout(() => s.remove(), 1800); }\nconst PIPS = { 1: [4], 2: [0, 8], 3: [0, 4, 8], 4: [0, 2, 6, 8], 5: [0, 2, 4, 6, 8], 6: [0, 2, 3, 5, 6, 8] };\nconst dieHTML = (v, cls = '') => `<span class=\"die ${cls} ${v === 1 || v === 4 ? 'red' : ''}\" aria-hidden=\"true\">${Array.from({ length: 9 }, (_, i) => `<i class=\"${PIPS[v].includes(i) ? 'on' : ''}\"></i>`).join('')}</span>`;\nasync function showDice(o) {\n  const el = $('#dice');\n  el.hidden = false;\n  el.innerHTML = `<div class=\"dbox\" role=\"status\"><span class=\"lb\">${esc(o.label)}</span><span class=\"dslot\">${dieHTML(1)}</span><span class=\"res\"></span></div>`;\n  const slot = el.querySelector('.dslot'), res = el.querySelector('.res');\n  if (!calm()) for (let i = 0; i < 8; i++) { slot.innerHTML = dieHTML(1 + Math.floor(Math.random() * 6), 'spin'); await wait(65); }\n  slot.innerHTML = dieHTML(o.v, 'land');\n  res.className = `res ${o.ok ? 'ok' : 'bad'}`;\n  res.textContent = `${o.v}　${o.result}`;\n  await wait(calm() ? 900 : 1300);\n  el.hidden = true;\n}\n// ── 觀眾的話：對白框貼在剪紙頭頂；情報金框、同門紅框，說完就散 ──\nlet bubs = [];\nconst SPEAK = { L: [0, 1, 2], R: [6, 7, 8], C: [3, 5] };\nfunction bubble(html, kind = 'n', o = {}) {\n  if (view !== 'stage') return null;\n  if (kind === 'n' && (coach.lesson || nudge.k)) return null;\n  const busyI = bubs.map(b => b.i);\n  let pool = (kind === 'intel' || kind === 'ev' ? [...SPEAK.L, ...SPEAK.R] : [...SPEAK.L, ...SPEAK.R, ...SPEAK.C]).filter(i => !busyI.includes(i));\n  if (o.side) pool = pool.filter(i => SPEAK[o.side].includes(i));\n  // 情報與同門的話，各佔一邊，不擋戲台中間\n  if (kind === 'intel' && bubs.some(b => b.kind === 'ev')) pool = pool.filter(i => SPEAK[bubs.find(b => b.kind === 'ev').i <= 2 ? 'R' : 'L'].includes(i));\n  const i = pool.length ? pool[Math.floor(Math.random() * pool.length)] : 0;\n  const el = document.createElement('div');\n  el.className = `bub ${kind}`;\n  el.innerHTML = `${kind === 'intel' ? '<span class=\"tg\">情报 · 台下</span>' : kind === 'ev' ? '<span class=\"tg\">同门的事</span>' : ''}${html}`;\n  $('#talkb').appendChild(el);\n  const b = { el, i, kind, until: performance.now() + (kind === 'intel' ? 14000 : kind === 'ev' ? 5500 : 2600) };\n  // 同一個人換一句：舊的先收\n  bubs.filter(x => x.kind === 'n' && kind === 'n').slice(0, -1).forEach(x => { x.until = 0; });\n  bubs.push(b);\n  placeBub(b);\n  return b;\n}\nfunction placeBub(b) {\n  const h = crowdHead(b.i) || { x: innerWidth * (b.i <= 2 ? 0.16 : b.i >= 6 ? 0.84 : 0.5), y: innerHeight * 0.66 };\n  const w = b.el.offsetWidth, ht = b.el.offsetHeight;\n  const x = clamp(h.x, w / 2 + 8, innerWidth - w / 2 - 8), y = clamp(h.y - 8, ht + 8, innerHeight - 8);\n  b.el.style.left = `${x}px`; b.el.style.top = `${y}px`;\n  b.el.style.setProperty('--ax', `${clamp(h.x - (x - w / 2), 16, w - 16)}px`);\n}\nfunction bubTick() {\n  const now = performance.now();\n  bubs = bubs.filter(b => {\n    if (now < b.until || (b.kind === 'intel' && coach.lesson === 'crowd')) { placeBub(b); return true; }\n    b.el.classList.add('out'); setTimeout(() => b.el.remove(), 360);\n    return false;\n  });\n}\nsetInterval(bubTick, 120);\nfunction clearBubs() { bubs.forEach(b => b.el.remove()); bubs = []; }\n// 台下閒聊：沒人說話的時候，隔一陣有人開口；同門的事、戲台的事\nconst CHATTER = [`金宝今儿${K('嗓子')}不错。`, `月仙在侧幕${K('盯着你')}呢。`, `魏老板说，元宵要${K('定新头牌')}。`, '后排的，往前挤挤。', '今儿的灯笼是新换的。', `玉楼那张嘴，${K('什么都知道')}。`, '这出戏，我看过三回了。', `小凤的${K('嗓子')}，不知好了没有。`];\nconst chat = { day: 0, n: 0 };\nconst chatMax = () => (S.day === 1 ? 2 : !S.tut.off && S.day <= 2 ? 3 : 6);\nsetInterval(() => {\n  if (view !== 'stage' || busy || !S || S.T.ended || bubs.length >= 2 || document.hidden || coachOn() || panel) return;\n  if (chat.day !== S.day) { chat.day = S.day; chat.n = 0; }\n  if (chat.n >= chatMax()) return;\n  chat.n += 1;\n  bubble(pick(CHATTER), 'n', { side: Math.random() < 0.5 ? 'L' : 'R' });\n}, 7000);\n\n// ── 台上的特效：紙屑、金箔、彩綢、墨點、煙花（畫在 3D 上面、字的下面）──\nconst fxc = $('#stagefx'), fxx = fxc.getContext('2d');\nlet parts = [], fxOn = false, fxLast = 0;\nconst FXCOL = { petal: ['#c8283a', '#e0475a', '#f2d48a', '#efe2c8', '#a8202b'], foil: ['#f6dc96', '#e8c46a', '#fff3cf'], spark: ['#ffe9a8', '#f2d48a', '#fff'], ink: ['#120e11', '#2b2427', '#3a0a0e'], fw: ['#ffe9a8', '#ff8a6a', '#f2d48a', '#ffd0dc', '#fff'] };\nfunction fxSize() {\n  const d = Math.min(devicePixelRatio || 1, 2);\n  if (fxc.width !== Math.round(innerWidth * d) || fxc.height !== Math.round(innerHeight * d)) { fxc.width = Math.round(innerWidth * d); fxc.height = Math.round(innerHeight * d); }\n  fxx.setTransform(d, 0, 0, d, 0, 0);\n}\nfunction spawn(kind, n, o = {}) {\n  if (calm()) return;\n  if (view !== 'stage' && ['fw', 'foil', 'ribbon', 'petal'].includes(kind)) return;\n  fxSize();\n  const W = innerWidth, H = innerHeight;\n  for (let i = 0; i < n; i++) {\n    const p = { kind, t: 0, rot: Math.random() * 6.28, vr: (Math.random() - 0.5) * 9, col: pick(FXCOL[kind] || FXCOL.petal) };\n    if (kind === 'petal' || kind === 'foil') { p.x = Math.random() * W; p.y = -20 - Math.random() * H * 0.5; p.vx = (Math.random() - 0.5) * 70; p.vy = (kind === 'foil' ? 190 : 110) + Math.random() * 100; p.s = kind === 'foil' ? 5 + Math.random() * 7 : 7 + Math.random() * 9; p.life = 3.6; p.sw = Math.random() * 6.28; }\n    else if (kind === 'spark' || kind === 'fw') { const a = Math.random() * 6.28, v = (kind === 'fw' ? 180 : 120) + Math.random() * (kind === 'fw' ? 280 : 220); p.x = o.x; p.y = o.y; p.vx = Math.cos(a) * v; p.vy = Math.sin(a) * v - 70; p.s = 2 + Math.random() * 3; p.life = 0.7 + Math.random() * 0.6; }\n    else if (kind === 'ink') { const a = Math.random() * 6.28, v = 70 + Math.random() * 280; p.x = o.x; p.y = o.y; p.vx = Math.cos(a) * v; p.vy = Math.sin(a) * v - 90; p.s = 3 + Math.random() * 8; p.life = 0.9 + Math.random() * 0.5; }\n    else if (kind === 'ribbon') { p.side = i % 2 ? 1 : -1; p.y0 = H * (0.12 + Math.random() * 0.4); p.life = 2; p.ph = Math.random() * 6.28; p.col = i % 3 === 2 ? '#f2d48a' : '#c8283a'; p.w = 6 + Math.random() * 5; }\n    parts.push(p);\n  }\n  if (!fxOn) { fxOn = true; fxLast = performance.now(); requestAnimationFrame(fxLoop); }\n}\nfunction fxLoop(now) {\n  const dt = Math.min(0.05, (now - fxLast) / 1000), W = innerWidth;\n  fxLast = now;\n  fxx.clearRect(0, 0, W, innerHeight);\n  parts = parts.filter(p => (p.t += dt) < p.life);\n  for (const p of parts) {\n    fxx.globalAlpha = Math.min(1, (p.life - p.t) / 0.45);\n    if (p.kind === 'ribbon') {\n      const k = Math.min(1, p.t / (p.life * 0.55)), len = W * 0.55 * k;\n      fxx.strokeStyle = p.col; fxx.lineWidth = p.w; fxx.lineCap = 'round'; fxx.beginPath();\n      for (let s0 = 0; s0 <= len; s0 += 12) { const x = p.side < 0 ? s0 : W - s0, y = p.y0 + Math.sin(s0 * 0.018 + p.ph + p.t * 7) * 34 - s0 * 0.12; if (s0) fxx.lineTo(x, y); else fxx.moveTo(x, y); }\n      fxx.stroke(); continue;\n    }\n    const grav = p.kind === 'petal' || p.kind === 'foil' ? 0 : 520;\n    p.vy += grav * dt; p.x += (p.vx + (p.sw !== undefined ? Math.sin(p.t * 3 + p.sw) * 40 : 0)) * dt; p.y += p.vy * dt; p.rot += p.vr * dt;\n    fxx.save(); fxx.translate(p.x, p.y); fxx.rotate(p.rot); fxx.fillStyle = p.col;\n    if (p.kind === 'petal') { fxx.beginPath(); fxx.ellipse(0, 0, p.s, Math.max(0.5, p.s * 0.5 * Math.abs(Math.cos(p.t * 4 + p.sw))), 0, 0, 6.28); fxx.fill(); }\n    else if (p.kind === 'foil') { fxx.globalAlpha *= 0.6 + 0.4 * Math.abs(Math.sin(p.t * 9 + p.sw)); fxx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.7); }\n    else { fxx.beginPath(); fxx.arc(0, 0, p.s, 0, 6.28); fxx.fill(); }\n    fxx.restore();\n  }\n  fxx.globalAlpha = 1;\n  if (parts.length) requestAnimationFrame(fxLoop); else { fxOn = false; fxx.clearRect(0, 0, W, innerHeight); }\n}\n// 打出去那張牌在螢幕上的位置\nfunction cardScreen(i) {\n  if (!glOK) return { x: innerWidth / 2, y: innerHeight * 0.42 };\n  const v = cardSpot('stage', i).project(camera);\n  return { x: (v.x + 1) / 2 * innerWidth, y: (1 - v.y) / 2 * innerHeight };\n}\nfunction banner(tx, sub, cls = '') {\n  if (calm()) return;\n  $('#combo').innerHTML = `<div class=\"cb ${cls}\">${esc(tx)}</div>${sub ? `<div class=\"cs\">${esc(sub)}</div>` : ''}`;\n}\nfunction gainFloat(at, tx, bad) {\n  if (calm()) return;\n  const el = document.createElement('div'); el.className = `gainf ${bad ? 'bad' : ''}`; el.textContent = tx;\n  el.style.left = `${at.x}px`; el.style.top = `${at.y}px`; document.body.appendChild(el); setTimeout(() => el.remove(), 1300);\n}\n// 連擊越長，台上越熱鬧：火星 → 紙屑、幕晃、大字 → 金箔、彩綢、鏡頭推近 → 煙花\nconst COMBO_TX = { 3: ['好！', '连击 ×3'], 4: ['满堂红', '连击 ×4'], 5: ['绝了', '五连'] };\nfunction comboFx(p) {\n  const n = S.T.chain, at = cardScreen(S.T.plays.length - 1);\n  gainFloat(at, `+${p.g + p.extra + p.open + p.fin}`, p.broke);\n  if (p.broke) {\n    spawn('ink', 30, at);\n    banner('倒彩', p.grudge ? '怨气 +1：今晚多染一张' : p.saved ? '小锣一响，这回不记怨气' : '连击归零', 'bad');\n    if (glOK) $('#gl').animate([{ filter: 'saturate(.15) brightness(.6)' }, { filter: 'none' }], { duration: 750, easing: 'ease-out' });\n    return;\n  }\n  spawn('spark', 10 + n * 8, at);\n  lanternKick = Math.min(1.6, 0.35 * n);\n  if (n >= 2) swayKick = Math.max(swayKick, 0.35 * n);\n  if (n >= 3) { spawn('petal', 40 + (n - 3) * 35); const b = COMBO_TX[Math.min(n, 5)]; banner(b[0], b[1], n >= 4 ? 'big' : ''); }\n  if (n >= 4) { spawn('foil', 80); spawn('ribbon', 6); if (glOK && camPos) camPos.lerp(camAim, 0.08); }\n  if (n >= 5) [0, 350, 700].forEach(d => setTimeout(() => spawn('fw', 60, { x: innerWidth * (0.2 + Math.random() * 0.6), y: innerHeight * (0.12 + Math.random() * 0.2) }), d));\n}\nasync function run(fn) { if (busy) return; busy = true; refresh(); try { await fn(); } finally { busy = false; refresh(); } }\n\n// ── 一天 ──\n// 依目前時段擺桌面（開局、接著玩都走這裡）\nfunction placeScene() {\n  if (view !== 'stage') { clearBubs(); stageHeat = 0; }\n  if (!glOK) return;","numLines":245,"startLine":3176,"totalLi