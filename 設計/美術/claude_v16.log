{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0124tri8ogderv8BD4qxxW1e","type":"tool_result","content":"2754\t  const cells = kinds.map(k => {\n2755\t    const free = S.deck.filter(c => c.t === k && !t.box.includes(c.id)), can = free.length > 0;\n2756\t    const nk = needKind(k);\n2757\t    return `<button class=\"spc ${nk && can ? 'want' : ''}\" data-act=\"pick\" data-arg=\"${k}\" data-t=\"${k}\" ${can ? '' : 'disabled'} aria-label=\"${T[k].n}，还有 ${free.length} 张${nk ? '，背面是她今晚要的' : ''}\"><img src=\"${cardArt(k, 'stage').url}\" alt=\"\"><span class=\"ct\">${free.length}</span>${nk && can ? '<span class=\"wtag\" aria-hidden=\"true\">家</span>' : ''}</button>`;\n2758\t  }).join('');\n2759\t  const shop = t.offers.length ? `<button class=\"mini\" data-act=\"shop\" style=\"border-color:#f2d48a;color:#f2d48a\">后台 · 孙师父（花卖座，名次会掉）</button>` : '';\n2760\t  return `<div class=\"spread\"><div class=\"sph\">卡组 · 点一张放进妆匣</div>${cells}${shop ? `<div class=\"tools2\">${shop}</div>` : ''}</div>`;\n2761\t}\n2762\t// 攤開的牌照桌上的空位排：在這塊空位裡把牌放到最大，放不下一列就折行\n2763\tfunction fitSpread() {\n2764\t  const sp = $('#mid .spread');\n2765\t  if (!sp) return;\n2766\t  const n = sp.querySelectorAll('.spc').length, mid = $('#mid').getBoundingClientRect(), cs = getComputedStyle(sp);\n2767\t  const padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight), padY = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);\n2768\t  const gx = parseFloat(cs.columnGap) || 10, gy = parseFloat(cs.rowGap) || 8, tools = (sp.querySelector('.tools2')?.offsetHeight || 32) + gy + (sp.querySelector('.sph')?.offsetHeight || 0) + gy;\n2769\t  // 可用的空位：寬螢幕夾在左邊木牌、妝匣和右邊水牌之間，從情報底下開始；窄螢幕在木牌底下、整個寬度\n2770\t  const R = el => (el && !el.hidden && el.getClientRects().length ? el.getBoundingClientRect() : null);\n2771\t  const plate = R($('#plate')), tray = R($('#leftcol')), side = R(document.querySelector('.side')), tm = R($('#topmid'));\n2772\t  const wide = innerWidth >= 760;\n2773\t  let topY, gut;\n2774\t  if (wide) {\n2775\t    gut = Math.max(plate ? plate.right : 0, tray && tray.top < mid.bottom ? tray.right : 0, side ? innerWidth - side.left : 0) + 12;\n2776\t    topY = (tm && tm.height > 4 ? tm.bottom : plate ? plate.top : mid.top) + 8;\n2777\t  } else {\n2778\t    gut = 8;\n2779\t    topY = Math.max(plate ? plate.bottom : 0, side ? side.bottom : 0, tm ? tm.bottom : 0) + 8;\n2780\t  }\n2781\t  topY = Math.min(topY, mid.top);\n2782\t  const W = innerWidth - 2 * gut - padX - 2, H = mid.bottom - topY - padY - tools - 6;\n2783\t  let best = { h: 0, cols: 4, rows: 99 };\n2784\t  for (let cols = 1; cols <= n; cols++) {\n2785\t    const rows = Math.ceil(n / cols);\n2786\t    const h = Math.min(210, (H - (rows - 1) * gy) / rows, (W - (cols - 1) * gx) / cols * 1.5);\n2787\t    // 牌已經到最大了，就排成行數少的；行數一樣，取每行少的（排得勻）\n2788\t    if (h > best.h + 0.5 || (h >= 209.5 && best.h >= 209.5 && rows < best.rows)) best = { h, cols, rows };\n2789\t  }\n2790\t  const h = Math.max(84, Math.floor(best.h));\n2791\t  sp.style.top = `${topY - mid.top}px`;\n2792\t  sp.style.maxHeight = `${mid.bottom - topY}px`;\n2793\t  sp.style.setProperty('--cols', best.cols);\n2794\t  sp.style.setProperty('--chh', `${h}px`);\n2795\t  sp.style.setProperty('--cw', `${Math.round(h / 1.5)}px`);\n2796\t}\n2797\taddEventListener('resize', () => { if (view === 'morning') fitSpread(); });\n2798\t// 試排：用卡組裡這些牌，今天起手打四張，最好的一條鏈能拿多少金（不算擲骰）\n2799\tfunction bestLineGold(types, n = 4) {\n2800\t  const start = starterOf(S);\n2801\t  if (!start) return 0;\n2802\t  const cnt = {}; types.forEach(t => { cnt[t] = (cnt[t] || 0) + 1; });\n2803\t  let best = 0;\n2804\t  const walk = (k, want, g) => {\n2805\t    if (k === n) { best = Math.max(best, g); return; }\n2806\t    for (const t of Object.keys(cnt)) {\n2807\t      const tp = T[t];\n2808\t      if (!cnt[t] || tp.home || (k === 0 ? !(tp.f === want || tp.wild) : !(tp.wild || want === '*' || tp.f === want))) continue;\n2809\t      const add = tp.g + (k === 0 ? R.openGold + (has(S, 'gujing') ? 3 : 0) : (R.chainGold[Math.min(k + 1, R.stageMax)] + (has(S, 'qinshi') ? 1 : 0)) * (tp.boost ? 2 : 1)) + (tp.fin && k >= 3 ? tp.fin : 0);\n2810\t      cnt[t] -= 1; walk(k + 1, tp.wild ? '*' : tp.next, g + add); cnt[t] += 1;\n2811\t    }\n2812\t    best = Math.max(best, g);\n2813\t  };\n2814\t  walk(0, start, 0);\n2815\t  return best;\n2816\t}\n2817\t// 還剩幾場戲（今天這場也算）\n2818\tconst daysLeft = () => R.days - S.day + 1;\n2819\t// 幾天回本：每天多拿 d 金，價錢 p\n2820\tconst payback = (d, p) => { const n = Math.ceil(p / d), left = daysLeft(); return n <= left ? `约 ${n} 天回本（还剩 ${left} 场）` : `<span class=\"bad\">还剩 ${left} 场，回不了本</span>`; };\n2821\tfunction previewTx(k) {\n2822\t  const p = priceOf(k);\n2823\t  if (RELICS[k]) {\n2824\t    if (k === 'qinshi') return `四张链每天约 +3 金；${payback(3, p)}`;\n2825\t    if (k === 'gujing') return `每天开得正 +3 金；${payback(3, p)}`;\n2826\t    if (k === 'cha') return '完美的机会从一半变成三分之二：一场多三四金';\n2827\t    if (k === 'lian') return '多一格：多带一张回家，或多一张卸妆';\n2828\t    if (k === 'jin') return '她擦一次 3 层：上四张，只要再弃一张';\n2829\t    if (k === 'you') return '灭灯只熄 1（熄过一回，就到不了美满）';\n2830\t    if (k === 'luo') return '每天接错一次不伤她';\n2831\t    return '';\n2832\t  }\n2833\t  const deck = S.deck.map(c => c.t), base = bestLineGold(deck), more = bestLineGold([...deck, k]);\n2834\t  const d = more - base;\n2835\t  const tp = T[k], why = tp.wild ? '断了的链靠它接回来' : tp.clean ? '脸上少一层，省一张卸妆的牌' : '';\n2836\t  return d > 0 ? `放进今天的四张链：<b>+${d} 金</b>${tp.heavy ? '，多一层油彩' : tp.clean ? '，还少一层油彩' : ''}；起手天天换，${payback(Math.max(1, d / 2), p)}` : why ? `今天的链用不上它；${why}` : `今天起手${FAM[starterOf(S)]?.n || ''}用不上，换个日子再看`;\n2837\t}\n2838\t// 買了以後掉到第幾：照現在的水牌算\n2839\tfunction afterBuy(k) {\n2840\t  const p = priceOf(k), r0 = rankOf(S);\n2841\t  S.gold -= p; const r1 = rankOf(S); S.gold += p;\n2842\t  const ne = nextExam(S), risk = ne && r1 >= ne.fail;\n2843\t  return `买了：卖座 ${S.gold} → ${S.gold - p}，水牌第 ${r0} → <b class=\"${r1 > r0 ? 'bad' : ''}\">${r1}</b>${risk ? `<br><span class=\"bad\">第 ${ne.day} 天考核${examTx(ne)}，小心</span>` : ''}`;\n2844\t}\n2845\t// 後台：孫師父每天兩張牌、一樣物件\n2846\tfunction shopPanel() {\n2847\t  const t = S.T;\n2848\t  const cells = t.offers.map(k => {\n2849\t    const sold = t.sold.includes(k) || S.relics.includes(k), can = canBuy(S, k), rel = RELICS[k];\n2850\t    const pic = rel ? `<div class=\"relic\" aria-hidden=\"true\">${rel.n[0]}</div>` : `<img src=\"${cardArt(k, 'stage').url}\" alt=\"${T[k].n}\" data-t=\"${k}\" class=\"spc\" style=\"width:96px;height:144px\">`;\n2851\t    const kw = rel ? `<b>物件 · ${rel.n}</b><br>${rel.tx}<br>买一次，整季都有用。` : `${stageLines(k).join('<br>')}<br>背面 ${HOME[FAM[T[k].f].home].n}`;\n2852\t    return `<div class=\"offer ${sold ? 'sold' : ''} ${rel ? 'isrel' : ''}\">${pic}\n2853\t      <div class=\"kw\">${kw}</div><div class=\"pv\">${previewTx(k)}</div><div class=\"pr\">${priceOf(k)} 金</div>${sold ? '' : `<div class=\"pv ab\">${afterBuy(k)}</div>`}\n2854\t      <button class=\"btn small ${can ? 'go' : ''}\" data-act=\"buy\" data-arg=\"${k}\" ${can ? '' : 'disabled'}>${sold ? '买下了' : can ? '买' : '钱不够'}</button></div>`;\n2855\t  }).join('');\n2856\t  return `<div class=\"panel shopp\"><h2>后台 · 孙师父<button class=\"btn small\" style=\"float:right\" data-act=\"close\">回桌上</button></h2>\n2857\t    <p class=\"note\">“这几张，是我年轻时候的看家本事。拿去，别糟践了。”</p>\n2858\t    <div class=\"purse\"><span>卖座<b>${S.gold}</b></span><span>水牌第<b>${rankOf(S)}</b></span><span>还剩 <b>${daysLeft()}</b> 场</span></div>\n2859\t    <p class=\"note\">只有一种金：花的就是卖座，买了水牌马上往下掉，要靠往后几天多挣回来。买下的牌进卡组，以后每天都能装；物件买一次整季都在。明天孙师父换一批。</p>\n2860\t    ${S.relics.length ? `<p class=\"note\">你已经有：${S.relics.map(r => RELICS[r].n).join('、')}</p>` : ''}\n2861\t    <div class=\"shop\">${cells}</div></div>`;\n2862\t}\n2863\tfunction waterPanel() {\n2864\t  const ev = eventOf(S), k = S.events[S.day];\n2865\t  return `<div class=\"panel\"><h2>水牌<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2>\n2866\t    <p class=\"note\">记到第 ${boardDay(S)} 天。每天散戏后，加上当天挣的卖座。</p>${boardHTML()}\n2867\t    ${ev ? `<p class=\"note\">今天：${EV_TX[k]()}</p>` : ''}</div>`;\n2868\t}\n2869\tfunction rulesPanel() {\n2870\t  const P = S.played;\n2871\t  return `<div class=\"panel rules\"><h2>规矩<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2>\n2872\t    <h4>内账（试玩用）</h4><div class=\"ledger\"><span>卖座 ${S.gold}</span><span>花掉 ${S.spent}</span><span>灯 ${S.lamp}</span><span>痕 ${S.scars}</span><span>灭灯 ${S.outs}</span><span>底色 ${S.base}</span><span>满足 ${S.met.join('/')}</span><span>小凤 +${S.fengGold}</span><span>唱 ${P.sing} 念 ${P.speak}</span><span>做 ${P.act} 打 ${P.fight}</span><span>水牌第 ${rankOf(S)}</span></div>\n2873\t    <h4>技巧</h4><ul class=\"tips\">${TIPS.map(r => `<li>${r}</li>`).join('')}</ul>\n2874\t    <h4>待你确认：可以开关</h4><ul>\n2875\t      <li>「开得正」+1 金：<button class=\"btn small\" data-act=\"opt\" data-arg=\"open\" aria-pressed=\"${S.opt.open}\">${S.opt.open ? '保留' : '不要'}</button></li>\n2876\t    </ul>\n2877\t    <h4>待你确认：还没定</h4><ul>${PENDING.map(r => `<li>${r}</li>`).join('')}</ul>\n2878\t    <h4>规矩</h4><ol>${RULES.map(r => `<li>${termify(r)}</li>`).join('')}</ol>\n2879\t    <h4>设定没写死、原型自拟的</h4><ul>${ASSUME.map(r => `<li>${r}</li>`).join('')}</ul>\n2880\t    <div class=\"acts\"><button class=\"btn\" data-act=\"mute\">${muted ? '开声音' : '关声音'}</button><button class=\"btn\" data-act=\"again\">重开一局</button></div></div>`;\n2881\t}\n2882\tfunction boardHTML() {\n2883\t  return `<ol class=\"board\">${boardOf(S).map((r, i) => `<li class=\"${r.me ? 'me' : ''}\"><span>${i + 1}. ${esc(r.n)}</span><span>${r.g}</span></li>`).join('')}</ol>`;\n2884\t}\n2885\tfunction sheetPanel() {\n2886\t  const k = sheet.k;\n2887\t  if (k === 'board') {\n2888\t    const a = actOf(S.day), ex = examOf(S);\n2889\t    return `<div class=\"panel\"><h2>水牌 · 考核</h2><p class=\"note\">第${'一二三'[a]}幕${ACT_N[a]}，到这里。魏老板看水牌定去留：${examTx(ex)}，排到第 ${ex.fail} 名${ex.fail < R.ranks ? '或更后' : ''}就摘牌。</p>${boardHTML()}\n2890\t      ${ex.pass ? `<p>你排第 ${ex.rank}，留下了。${a === 0 ? `第 7 天还有一次：${examTx(nextExam({ day: 4 }))}。` : ''}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"nextact\">第${'一二三'[a + 1]}幕</button></div>`\n2891\t    : `<p class=\"fired\">你排第 ${ex.rank}。魏老板把你的牌子摘了下来。</p><p class=\"note\">这一季到这里为止。回家，最后一次卸妆。</p><div class=\"acts\"><button class=\"btn go\" data-act=\"nextact\">摘牌，回家</button></div>`}</div>`;\n2892\t  }\n2893\t  if (k === 'mirror') return mirrorPanel();\n2894\t  if (k === 'r_board') {\n2895\t    const rk = rankOf(S);\n2896\t    const tx = S.fired ? `第 ${S.fired} 天的考核，你排第 ${rk}。魏老板把你的牌子摘了下来。` : S.left ? `她走的那天，是第 ${S.left} 天。水牌上，你排第 ${rk}。` : rk === R.ranks ? '你的名字被摘了下来。' : rk === 1 ? '最上面那块牌子，写的是你。' : '';\n2897\t    return `<div class=\"panel\"><h2>水牌</h2>${boardHTML()}<p class=\"note\">${tx}${S.choice === 'cover' ? '小凤的名字还挂着。' : ''}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"rstep\" data-arg=\"r_home\">回家</button></div></div>`;\n2898\t  }\n2899\t  if (k === 'r_home') {\n2900\t    const seat = seatEmpty(S) || wifeOf(S) === 2;\n2901\t    const tx = S.left ? `灯坊对面的椅子空着。那盏灯搁在桌上：糊了 ${Math.min(LSEG, Math.floor(S.lamp / 2))} 片纸（糊满要 ${LSEG} 片），熄过 ${S.outs} 回，划了 ${S.scars} 道。没糊完。`\n2902\t      : S.fired ? (wifeOf(S) === 0 ? '你素着脸回家，比平时早。她愣了一下，把灯骨推过来：“正好，帮我糊完。”' : '你回家比平时早。她没问，给你盛了饭。灯上有几处熄过。')\n2903\t      : S.lit ? `灯亮着，${seat ? '是你自己点的。对面的椅子空着。' : '你们一起点的。'}${S.lamp < R.happyLamp ? '有几处熄过，补不回来了。' : ''}` : S.litAlone ? '你回来时，灯已经亮了。是她一个人点的。' : seat ? '对面的椅子空着。灯没有点。' : '灯还搁在桌上，没有点。她抬头看了你一下。';\n2904\t    return `<div class=\"panel\"><h2>回家</h2><p>${tx}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"rstep\" data-arg=\"r_chest\">打开木匣</button></div></div>`;\n2905\t  }\n2906\t  if (k === 'r_chest') {\n2907\t    const days = Array.from({ length: endDay(S) }, (_, i) => { const L = S.chest.filter(c => c.day === i + 1); return `<div>第 ${i + 1} 天<div class=\"cl\">${L.map(c => `<i style=\"background:${FCOL[c.f]}\"></i>`).join('') || ''}</div></div>`; }).join('');\n2908\t    return `<div class=\"panel\"><h2>木匣</h2><p class=\"note\">${S.chest.some(c => !c.last) ? `她替你擦过 ${S.chest.filter(c => !c.last).length} 层。每一块布都叠着，按日子放好。${S.chest.some(c => c.last) ? '最上面那一块，是最后一回。' : ''}` : S.chest.length ? '木匣里只有一块布，是最后一回。在那之前，她一次也没替你擦过。' : '木匣是空的。她一次也没替你擦过。'}</p><div class=\"book\">${days}</div><div class=\"acts\"><button class=\"btn go\" data-act=\"rfinal\">合上</button></div></div>`;\n2909\t  }\n2910\t  return '';\n2911\t}\n2912\t// 第二幕末的鏡子：台上演得最多的那一族，已經滲進臉裡；第三幕起，那一族推給她就帶著台上的字\n2913\tconst topFams = () => (S ? Object.keys(S.played).sort((a, b) => S.played[b] - S.played[a]) : ['sing']);\n2914\tfunction mirrorPanel() {\n2915\t  const [f1, f2] = topFams(), h1 = HOME[FAM[f1].home], card = BASIC.find(t => T[t].f === f1), over = S.base >= R.overBase[0];\n2916\t  const pics = (a, b) => `<div class=\"mirrorc\"><figure><img src=\"${cardArt(card, 'home').url}\" alt=\"\">${a}</figure><figure><img src=\"${cardArt(card, 'home', true).url}\" alt=\"\">${b}</figure></div>`;\n2917\t  const body = over\n2918\t    ? `<p>你对着镜子卸完妆。脸上还有一层${fc(f1)}的颜色——不是今天的油彩，是这几天一层层渗进去的，怎么擦都在。</p>${pics('你想给她的', '她听见的')}\n2919\t       <p>明天起（第三幕），你推给她的「${h1.n}」会带着台上的字。她听见的不是你，是戏：这一族推出去就算被染，灯上留一道痕。${S.base >= R.overBase[1] ? `底色已经到 ${R.overBase[1]}，${fc(f2)}那一族也一样。` : `底色到 ${R.overBase[1]}，演得第二多的那一族也会这样。`}</p>`\n2920\t    : `<p>你对着镜子卸完妆。镜子里，是你自己的脸。</p>${pics('现在', `底色到 ${R.overBase[0]} 以后`)}\n2921\t       <p>这几天你演得最多的是${fc(f1)}（${S.played[f1]} 张）。每晚没卸掉的油彩，睡一觉就渗进脸里，变成底色。第三幕里，底色到 ${R.overBase[0]}，你推给她的「${h1.n}」就会带着台上的字——推出去，就算被染。</p>`;\n2922\t  return `<div class=\"panel\"><h2>镜子</h2>${body}<p class=\"note\">现在底色 ${S.base}。底色只会多，不会少；每 2 点，妆匣少一格。</p><div class=\"acts\"><button class=\"btn go\" data-act=\"mirrorok\">睡吧</button></div></div>`;\n2923\t}\n2924\tfunction renderChoices() {\n2925\t  const opts = [], t = S.T;\n2926\t  const o = (label, act, sub, disabled, arg, pri) => opts.push(`<button class=\"opt ${pri ? 'pri' : ''}\" data-act=\"${act}\" ${arg !== undefined ? `data-arg=\"${arg}\"` : ''} ${disabled ? 'disabled' : ''}>${label}${sub ? `<small>${sub}</small>` : ''}</button>`);\n2927\t  if (busy || panel === 'rules' || sheet) { $('#choices').innerHTML = ''; return; }\n2928\t  const n = t.layers.length;\n2929\t  if (view === 'morning') {\n2930\t    const st = starterOf(S), yes = canDepart(S);\n2931\t    if (S.day !== R.days || S.choice) o(S.choice === 'lamp' ? '回家' : '出门', 'depart', yes ? (S.choice === 'lamp' ? '今天不上台' : '') : `还没带${st ? FAM[st].n : ''}`, !yes, undefined, yes);\n2932\t  }\n2933\t  if (view === 'stage') {\n2934\t    const stuck = !t.box.some(id => !t.used[id] && canStage(S, id) && (!t.plays.length || fits(S, id)));\n2935\t    if (t.ended) o(S.choice === 'stage' ? '散戏' : '回家', 'todoor', '', false, undefined, true);\n2936\t    else o('收场', 'endstage', t.plays.length ? `脸上 ${n} 层` : '今天不上台', false, undefined, t.plays.length >= t.stageMax || (t.plays.length > 0 && stuck));\n2937\t  }\n2938\t  if (view === 'door') {\n2939\t    if (S.day > 1 && S.scars <= R.wipeScarMax && canWipe(S)) o('让她擦', 'wipe', `${Math.min(R.wipeLayers, n)} 层 · 今晚只推 1 张`);\n2940\t    const dye = S.day === 1 ? 0 : dyeOf(S);\n2941\t    o(S.day === 1 ? '回去歇了' : '进门', 'enter', dye ? `前 ${dye} 张会被染` : '', false, undefined, !n || S.day === 1);\n2942\t  }\n2943\t  if (view === 'evening') {\n2944\t    if (S.choice === 'lamp') o('点灯', 'light', seatEmpty(S) ? '你一个人' : '她把火递给你', false, undefined, true);\n2945\t    else {\n2946\t      const ok = t.need.items.every(x => (t.got[x.look] || 0) >= x.n), full = t.pushed.length >= t.homeCap || !t.box.some(id => !t.used[id] && canHome(S, id));\n2947\t      o('吃完了', 'endeve', ok ? '' : '不够：灯会熄一截', false, undefined, ok || full);\n2948\t    }\n2949\t  }\n2950\t  if (view === 'night') o('睡吧', 'sleep', '', false, undefined, true);\n2951\t  $('#choices').innerHTML = opts.join('');\n2952\t}\n2953\tfunction renderHand() {\n2954\t  const h = $('#hand'), lb = $('#handLabel');\n2955\t  const show = ['morning', 'stage', 'door', 'evening', 'night'].includes(view) && !panel && !sheet && !(view === 'stage' && S.T.ended) && S.choice !== 'lamp';\n2956\t  h.classList.toggle('on', show);\n2957\t  if (!show) { h.innerHTML = ''; lb.innerHTML = ''; return; }\n2958\t  const t = S.T, side = view === 'evening' ? 'home' : 'stage', ids = t.box.filter(id => !t.used[id]);\n2959\t  const covered = view === 'evening' ? coveredFams(S) : [];\n2960\t  const can = id => {\n2961\t    if (busy) return false;\n2962\t    if (view === 'stage') return canStage(S, id);\n2963\t    if (view === 'evening') return canHome(S, id);\n2964\t    if (view === 'door' || view === 'night') return canClean(S, id);\n2965\t    return view === 'morning' && !lockedBox(S);\n2966\t  };\n2967\t  const hot = id => {\n2968\t    if (busy) return false;\n2969\t    if (view === 'stage') return canStage(S, id) && (!S.T.plays.length || fits(S, id)) && !keepHint(id);\n2970\t    if (view === 'evening') return canHome(S, id) && isMatch(S, id) && lack(S, lookOfCard(S, id)) > 0 && !willDye(S, id);\n2971\t    return false;\n2972\t  };\n2973\t  const n = ids.length, mid = (n - 1) / 2;\n2974\t  h.innerHTML = ids.map((id, i) => {\n2975\t    const c = cardOf(S, id), ok = can(id), tp = T[c.t];\n2976\t    const rot = (i - mid) * Math.min(2.6, 24 / Math.max(n, 1)), lift = Math.abs(i - mid) * 1.3;\n2977\t    const label = tp.home ? `${tp.n}，家常牌，不上台，背面${HOME[FAM[tp.f].home].n}` : `${tp.n}，${FAM[tp.f].n}，金 ${tp.g}，接${nextN(tp)}${kwOf(tp) ? `，${kwOf(tp)}` : ''}，背面${tp.blank ? '空白' : HOME[FAM[tp.f].home].n}`;\n2978\t    const dim = !ok && view !== 'morning';\n2979\t    const home = ['morning', 'stage', 'door'].includes(view) && keepHint(id);\n2980\t    return `<button class=\"hc ${ok ? 'play' : ''} ${hot(id) ? 'hot' : ''} ${dim ? 'off' : ''} ${home ? 'want' : ''}\" data-id=\"${id}\" ${tp.wild ? 'data-wild=\"1\"' : ''} style=\"transform:translateY(${lift}px) rotate(${rot}deg)\" ${ok ? `data-act=\"card\" data-arg=\"${id}\"` : 'disabled'} aria-label=\"${esc(label)}${home ? '，她今晚要的' : ''}\"><img src=\"${cardArt(c.t, side, covered.includes(tp.f) && !tp.home).url}\" alt=\"\">${view === 'evening' && canHome(S, id) && willDye(S, id) ? '<span class=\"stain\"></span>' : ''}${home ? '<span class=\"wtag\" aria-hidden=\"true\">家</span>' : ''}</button>`;\n2981\t  }).join('');\n2982\t  const tx = {\n2983\t    morning: lockedBox(S) ? '' : t.box.length ? '妆匣里的 · 点一张拿回去' : '妆匣是空的',\n2984\t    stage: ids.some(keepHint) ? '金框的能打 · 印着「家」的留着回家' : '',\n2985\t    door: t.layers.length ? '点一张牌卸一层' : '',\n2986\t    evening: t.pushed.length >= t.homeCap ? '她听不下了' : '点牌推给她',\n2987\t    night: t.layers.length ? '点一张牌卸一层' : '',\n2988\t  }[view];\n2989\t  // 裝匣的兩個按鈕跟著妝匣\n2990\t  const tools = view === 'morning' && !lockedBox(S) ? `<button class=\"mini\" data-act=\"yesterday\" ${S.lastBox ? '' : 'disabled'}>照昨天装</button><button class=\"mini\" data-act=\"clear\" ${t.box.length ? '' : 'disabled'}>全拿出来</button>` : '';\n2991\t  lb.innerHTML = `${tx ? `<span class=\"hlb\">${esc(tx)}</span>` : ''}${tools}`;\n2992\t}\n2993\t// 第一人稱時，臉上沒卸的台上臉化成螢幕四邊的油彩\n2994\tfunction renderSmear() {\n2995\t  const cv = $('#smear'), w = innerWidth, h = innerHeight;\n2996\t  if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; }\n2997\t  const x = cv.getContext('2d'); x.clearRect(0, 0, w, h);\n2998\t  if (!S || !['door', 'evening', 'night'].includes(view)) return;\n2999\t  const m = Math.min(w, h);\n3000\t  S.T.layers.forEach((ly, i) => {\n3001\t    const r = rng(101 + i * 977), col = hexRgb(FCOL[ly.f]);\n3002\t    for (let k = 0; k < 7; k++) {\n3003\t      const side = Math.floor(r() * 4); let px, py;\n3004\t      if (side === 0) { px = r() * w; py = -h * 0.04 + r() * h * 0.1; } else if (side === 1) { px = r() * w; py = h * 1.02 - r() * h * 0.08; } else if (side === 2) { px = -w * 0.02 + r() * w * 0.07; py = r() * h; } else { px = w * 1.02 - r() * w * 0.07; py = r() * h; }\n3005\t      const rad = (0.1 + r() * 0.14) * m, g = x.createRadialGradient(px, py, 0, px, py, rad);\n3006\t      g.addColorStop(0, `rgba(${col},.55)`); g.addColorStop(0.55, `rgba(${col},.22)`); g.addColorStop(1, `rgba(${col},0)`);\n3007\t      x.fillStyle = g; x.beginPath(); x.arc(px, py, rad, 0, Math.PI * 2); x.fill();\n3008\t    }\n3009\t  });\n3010\t}\n3011\tasync function ink(fn) {\n3012\t  const el = $('#ink');\n3013\t  if (calm()) { fn(); return; }\n3014\t  el.className = ''; void el.offsetWidth; el.className = 'on';\n3015\t  await wait(600); fn(); refresh(); await wait(100);\n3016\t  el.className = 'off'; await wait(460); el.className = '';\n3017\t}\n3018\tasync function fly(id, where) {\n3019\t  const el = document.querySelector(`.hc[data-id=\"${id}\"]`), t = cardOf(S, id).t, side = where === 'home' ? 'home' : 'stage';\n3020\t  const target = !glOK ? null : where === 'stage' ? cardSpot('stage', S.T.plays.length) : where === 'home' ? cardSpot('home', S.T.pushed.length) : null;\n3021\t  if (el && !calm()) {\n3022\t    const r = el.getBoundingClientRect(), ghost = new Image();\n3023\t    ghost.src = cardArt(t, side).url; ghost.className = 'ghost'; Object.assign(ghost.style, { left: r.left + 'px', top: r.top + 'px', width: r.width + 'px', height: r.height + 'px' });\n3024\t    document.body.appendChild(ghost); el.style.visibility = 'hidden';\n3025\t    let tx = innerWidth / 2, ty = innerHeight * 0.45;\n3026\t    if (glOK && target) { const v = target.clone().project(camera); tx = (v.x + 1) / 2 * innerWidth; ty = (1 - v.y) / 2 * innerHeight; }\n3027\t    if (!target && where === 'cloth') ty = innerHeight + 80;\n3028\t    const anim = ghost.animate([{ transform: 'none', opacity: 1 }, { transform: `translate(${tx - r.left - r.width / 2}px, ${ty - r.top - r.height / 2}px) scale(${target ? 0.32 : 0.5}) rotate(${where === 'cloth' ? 40 : 8}deg)`, opacity: where === 'cloth' ? 0 : 0.95 }], { duration: 400, easing: 'cubic-bezier(.3,.7,.3,1)' });\n3029\t    await Promise.race([anim.finished.catch(() => {}), wait(700)]);\n3030\t    ghost.remove();\n3031\t  }\n3032\t  if (target) spawnCard(t, side, target);\n3033\t}\n3034\tfunction burst(n) {\n3035\t  if (calm()) return;\n3036\t  const fx = $('#fx');\n3037\t  for (let i = 0; i < Math.min(n, 44); i++) {\n3038\t    const f = document.createElement('span'); f.className = 'fleck';\n3039\t    f.style.left = `${8 + Math.random() * 84}vw`; f.style.animationDelay = `${Math.random() * 0.5}s`; f.style.background = Math.random() < 0.3 ? '#efe2c2' : '#b8913f';\n3040\t    fx.appendChild(f); setTimeout(() => f.remove(), 2600);\n3041\t  }\n3042\t}\n3043\tfunction stamp(text) { const s = document.createElement('div'); s.className = 'stamp'; s.textContent = text; document.body.appendChild(s); setTimeout(() => s.remove(), 1800); }\n3044\tconst PIPS = { 1: [4], 2: [0, 8], 3: [0, 4, 8], 4: [0, 2, 6, 8], 5: [0, 2, 4, 6, 8], 6: [0, 2, 3, 5, 6, 8] };\n3045\tconst dieHTML = (v, cls = '') => `<span class=\"die ${cls} ${v === 1 || v === 4 ? 'red' : ''}\" aria-hidden=\"true\">${Array.from({ length: 9 }, (_, i) => `<i class=\"${PIPS[v].includes(i) ? 'on' : ''}\"></i>`).join('')}</span>`;\n3046\tasync function showDice(o) {\n3047\t  const el = $('#dice');\n3048\t  el.hidden = false;\n3049\t  el.innerHTML = `<div class=\"dbox\" role=\"status\"><span class=\"lb\">${esc(o.label)}</span><span class=\"dslot\">${dieHTML(1)}</span><span class=\"res\"></span></div>`;\n3050\t  const slot = el.querySelector('.dslot'), res = el.querySelector('.res');\n3051\t  if (!calm()) for (let i = 0; i < 8; i++) { slot.innerHTML = dieHTML(1 + Math.floor(Math.random() * 6), 'spin'); await wait(65); }\n3052\t  slot.innerHTML = dieHTML(o.v, 'land');\n3053\t  res.className = `res ${o.ok ? 'ok' : 'bad'}`;"}]},"parent_tool_use_id":null,"session_id":"add261a2-b4a2-4526-9481-41d3d4ec4689","uuid":"96cb774b-a788-4616-81a8-6aa7e0e816b1","timestamp":"2026-11-11T08:01:00.473Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.5/index.html","content":"  const cells = kinds.map(k => {\n    const free = S.deck.filter(c => c.t === k && !t.box.includes(c.id)), can = free.length > 0;\n    const nk = needKind(k);\n    return `<button class=\"spc ${nk && can ? 'want' : ''}\" data-act=\"pick\" data-arg=\"${k}\" data-t=\"${k}\" ${can ? '' : 'disabled'} aria-label=\"${T[k].n}，还有 ${free.length} 张${nk ? '，背面是她今晚要的' : ''}\"><img src=\"${cardArt(k, 'stage').url}\" alt=\"\"><span class=\"ct\">${free.length}</span>${nk && can ? '<span class=\"wtag\" aria-hidden=\"true\">家</span>' : ''}</button>`;\n  }).join('');\n  const shop = t.offers.length ? `<button class=\"mini\" data-act=\"shop\" style=\"border-color:#f2d48a;color:#f2d48a\">后台 · 孙师父（花卖座，名次会掉）</button>` : '';\n  return `<div class=\"spread\"><div class=\"sph\">卡组 · 点一张放进妆匣</div>${cells}${shop ? `<div class=\"tools2\">${shop}</div>` : ''}</div>`;\n}\n// 攤開的牌照桌上的空位排：在這塊空位裡把牌放到最大，放不下一列就折行\nfunction fitSpread() {\n  const sp = $('#mid .spread');\n  if (!sp) return;\n  const n = sp.querySelectorAll('.spc').length, mid = $('#mid').getBoundingClientRect(), cs = getComputedStyle(sp);\n  const padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight), padY = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);\n  const gx = parseFloat(cs.columnGap) || 10, gy = parseFloat(cs.rowGap) || 8, tools = (sp.querySelector('.tools2')?.offsetHeight || 32) + gy + (sp.querySelector('.sph')?.offsetHeight || 0) + gy;\n  // 可用的空位：寬螢幕夾在左邊木牌、妝匣和右邊水牌之間，從情報底下開始；窄螢幕在木牌底下、整個寬度\n  const R = el => (el && !el.hidden && el.getClientRects().length ? el.getBoundingClientRect() : null);\n  const plate = R($('#plate')), tray = R($('#leftcol')), side = R(document.querySelector('.side')), tm = R($('#topmid'));\n  const wide = innerWidth >= 760;\n  let topY, gut;\n  if (wide) {\n    gut = Math.max(plate ? plate.right : 0, tray && tray.top < mid.bottom ? tray.right : 0, side ? innerWidth - side.left : 0) + 12;\n    topY = (tm && tm.height > 4 ? tm.bottom : plate ? plate.top : mid.top) + 8;\n  } else {\n    gut = 8;\n    topY = Math.max(plate ? plate.bottom : 0, side ? side.bottom : 0, tm ? tm.bottom : 0) + 8;\n  }\n  topY = Math.min(topY, mid.top);\n  const W = innerWidth - 2 * gut - padX - 2, H = mid.bottom - topY - padY - tools - 6;\n  let best = { h: 0, cols: 4, rows: 99 };\n  for (let cols = 1; cols <= n; cols++) {\n    const rows = Math.ceil(n / cols);\n    const h = Math.min(210, (H - (rows - 1) * gy) / rows, (W - (cols - 1) * gx) / cols * 1.5);\n    // 牌已經到最大了，就排成行數少的；行數一樣，取每行少的（排得勻）\n    if (h > best.h + 0.5 || (h >= 209.5 && best.h >= 209.5 && rows < best.rows)) best = { h, cols, rows };\n  }\n  const h = Math.max(84, Math.floor(best.h));\n  sp.style.top = `${topY - mid.top}px`;\n  sp.style.maxHeight = `${mid.bottom - topY}px`;\n  sp.style.setProperty('--cols', best.cols);\n  sp.style.setProperty('--chh', `${h}px`);\n  sp.style.setProperty('--cw', `${Math.round(h / 1.5)}px`);\n}\naddEventListener('resize', () => { if (view === 'morning') fitSpread(); });\n// 試排：用卡組裡這些牌，今天起手打四張，最好的一條鏈能拿多少金（不算擲骰）\nfunction bestLineGold(types, n = 4) {\n  const start = starterOf(S);\n  if (!start) return 0;\n  const cnt = {}; types.forEach(t => { cnt[t] = (cnt[t] || 0) + 1; });\n  let best = 0;\n  const walk = (k, want, g) => {\n    if (k === n) { best = Math.max(best, g); return; }\n    for (const t of Object.keys(cnt)) {\n      const tp = T[t];\n      if (!cnt[t] || tp.home || (k === 0 ? !(tp.f === want || tp.wild) : !(tp.wild || want === '*' || tp.f === want))) continue;\n      const add = tp.g + (k === 0 ? R.openGold + (has(S, 'gujing') ? 3 : 0) : (R.chainGold[Math.min(k + 1, R.stageMax)] + (has(S, 'qinshi') ? 1 : 0)) * (tp.boost ? 2 : 1)) + (tp.fin && k >= 3 ? tp.fin : 0);\n      cnt[t] -= 1; walk(k + 1, tp.wild ? '*' : tp.next, g + add); cnt[t] += 1;\n    }\n    best = Math.max(best, g);\n  };\n  walk(0, start, 0);\n  return best;\n}\n// 還剩幾場戲（今天這場也算）\nconst daysLeft = () => R.days - S.day + 1;\n// 幾天回本：每天多拿 d 金，價錢 p\nconst payback = (d, p) => { const n = Math.ceil(p / d), left = daysLeft(); return n <= left ? `约 ${n} 天回本（还剩 ${left} 场）` : `<span class=\"bad\">还剩 ${left} 场，回不了本</span>`; };\nfunction previewTx(k) {\n  const p = priceOf(k);\n  if (RELICS[k]) {\n    if (k === 'qinshi') return `四张链每天约 +3 金；${payback(3, p)}`;\n    if (k === 'gujing') return `每天开得正 +3 金；${payback(3, p)}`;\n    if (k === 'cha') return '完美的机会从一半变成三分之二：一场多三四金';\n    if (k === 'lian') return '多一格：多带一张回家，或多一张卸妆';\n    if (k === 'jin') return '她擦一次 3 层：上四张，只要再弃一张';\n    if (k === 'you') return '灭灯只熄 1（熄过一回，就到不了美满）';\n    if (k === 'luo') return '每天接错一次不伤她';\n    return '';\n  }\n  const deck = S.deck.map(c => c.t), base = bestLineGold(deck), more = bestLineGold([...deck, k]);\n  const d = more - base;\n  const tp = T[k], why = tp.wild ? '断了的链靠它接回来' : tp.clean ? '脸上少一层，省一张卸妆的牌' : '';\n  return d > 0 ? `放进今天的四张链：<b>+${d} 金</b>${tp.heavy ? '，多一层油彩' : tp.clean ? '，还少一层油彩' : ''}；起手天天换，${payback(Math.max(1, d / 2), p)}` : why ? `今天的链用不上它；${why}` : `今天起手${FAM[starterOf(S)]?.n || ''}用不上，换个日子再看`;\n}\n// 買了以後掉到第幾：照現在的水牌算\nfunction afterBuy(k) {\n  const p = priceOf(k), r0 = rankOf(S);\n  S.gold -= p; const r1 = rankOf(S); S.gold += p;\n  const ne = nextExam(S), risk = ne && r1 >= ne.fail;\n  return `买了：卖座 ${S.gold} → ${S.gold - p}，水牌第 ${r0} → <b class=\"${r1 > r0 ? 'bad' : ''}\">${r1}</b>${risk ? `<br><span class=\"bad\">第 ${ne.day} 天考核${examTx(ne)}，小心</span>` : ''}`;\n}\n// 後台：孫師父每天兩張牌、一樣物件\nfunction shopPanel() {\n  const t = S.T;\n  const cells = t.offers.map(k => {\n    const sold = t.sold.includes(k) || S.relics.includes(k), can = canBuy(S, k), rel = RELICS[k];\n    const pic = rel ? `<div class=\"relic\" aria-hidden=\"true\">${rel.n[0]}</div>` : `<img src=\"${cardArt(k, 'stage').url}\" alt=\"${T[k].n}\" data-t=\"${k}\" class=\"spc\" style=\"width:96px;height:144px\">`;\n    const kw = rel ? `<b>物件 · ${rel.n}</b><br>${rel.tx}<br>买一次，整季都有用。` : `${stageLines(k).join('<br>')}<br>背面 ${HOME[FAM[T[k].f].home].n}`;\n    return `<div class=\"offer ${sold ? 'sold' : ''} ${rel ? 'isrel' : ''}\">${pic}\n      <div class=\"kw\">${kw}</div><div class=\"pv\">${previewTx(k)}</div><div class=\"pr\">${priceOf(k)} 金</div>${sold ? '' : `<div class=\"pv ab\">${afterBuy(k)}</div>`}\n      <button class=\"btn small ${can ? 'go' : ''}\" data-act=\"buy\" data-arg=\"${k}\" ${can ? '' : 'disabled'}>${sold ? '买下了' : can ? '买' : '钱不够'}</button></div>`;\n  }).join('');\n  return `<div class=\"panel shopp\"><h2>后台 · 孙师父<button class=\"btn small\" style=\"float:right\" data-act=\"close\">回桌上</button></h2>\n    <p class=\"note\">“这几张，是我年轻时候的看家本事。拿去，别糟践了。”</p>\n    <div class=\"purse\"><span>卖座<b>${S.gold}</b></span><span>水牌第<b>${rankOf(S)}</b></span><span>还剩 <b>${daysLeft()}</b> 场</span></div>\n    <p class=\"note\">只有一种金：花的就是卖座，买了水牌马上往下掉，要靠往后几天多挣回来。买下的牌进卡组，以后每天都能装；物件买一次整季都在。明天孙师父换一批。</p>\n    ${S.relics.length ? `<p class=\"note\">你已经有：${S.relics.map(r => RELICS[r].n).join('、')}</p>` : ''}\n    <div class=\"shop\">${cells}</div></div>`;\n}\nfunction waterPanel() {\n  const ev = eventOf(S), k = S.events[S.day];\n  return `<div class=\"panel\"><h2>水牌<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2>\n    <p class=\"note\">记到第 ${boardDay(S)} 天。每天散戏后，加上当天挣的卖座。</p>${boardHTML()}\n    ${ev ? `<p class=\"note\">今天：${EV_TX[k]()}</p>` : ''}</div>`;\n}\nfunction rulesPanel() {\n  const P = S.played;\n  return `<div class=\"panel rules\"><h2>规矩<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2>\n    <h4>内账（试玩用）</h4><div class=\"ledger\"><span>卖座 ${S.gold}</span><span>花掉 ${S.spent}</span><span>灯 ${S.lamp}</span><span>痕 ${S.scars}</span><span>灭灯 ${S.outs}</span><span>底色 ${S.base}</span><span>满足 ${S.met.join('/')}</span><span>小凤 +${S.fengGold}</span><span>唱 ${P.sing} 念 ${P.speak}</span><span>做 ${P.act} 打 ${P.fight}</span><span>水牌第 ${rankOf(S)}</span></div>\n    <h4>技巧</h4><ul class=\"tips\">${TIPS.map(r => `<li>${r}</li>`).join('')}</ul>\n    <h4>待你确认：可以开关</h4><ul>\n      <li>「开得正」+1 金：<button class=\"btn small\" data-act=\"opt\" data-arg=\"open\" aria-pressed=\"${S.opt.open}\">${S.opt.open ? '保留' : '不要'}</button></li>\n    </ul>\n    <h4>待你确认：还没定</h4><ul>${PENDING.map(r => `<li>${r}</li>`).join('')}</ul>\n    <h4>规矩</h4><ol>${RULES.map(r => `<li>${termify(r)}</li>`).join('')}</ol>\n    <h4>设定没写死、原型自拟的</h4><ul>${ASSUME.map(r => `<li>${r}</li>`).join('')}</ul>\n    <div class=\"acts\"><button class=\"btn\" data-act=\"mute\">${muted ? '开声音' : '关声音'}</button><button class=\"btn\" data-act=\"again\">重开一局</button></div></div>`;\n}\nfunction boardHTML() {\n  return `<ol class=\"board\">${boardOf(S).map((r, i) => `<li class=\"${r.me ? 'me' : ''}\"><span>${i + 1}. ${esc(r.n)}</span><span>${r.g}</span></li>`).join('')}</ol>`;\n}\nfunction sheetPanel() {\n  const k = sheet.k;\n  if (k === 'board') {\n    const a = actOf(S.day), ex = examOf(S);\n    return `<div class=\"panel\"><h2>水牌 · 考核</h2><p class=\"note\">第${'一二三'[a]}幕${ACT_N[a]}，到这里。魏老板看水牌定去留：${examTx(ex)}，排到第 ${ex.fail} 名${ex.fail < R.ranks ? '或更后' : ''}就摘牌。</p>${boardHTML()}\n      ${ex.pass ? `<p>你排第 ${ex.rank}，留下了。${a === 0 ? `第 7 天还有一次：${examTx(nextExam({ day: 4 }))}。` : ''}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"nextact\">第${'一二三'[a + 1]}幕</button></div>`\n    : `<p class=\"fired\">你排第 ${ex.rank}。魏老板把你的牌子摘了下来。</p><p class=\"note\">这一季到这里为止。回家，最后一次卸妆。</p><div class=\"acts\"><button class=\"btn go\" data-act=\"nextact\">摘牌，回家</button></div>`}</div>`;\n  }\n  if (k === 'mirror') return mirrorPanel();\n  if (k === 'r_board') {\n    const rk = rankOf(S);\n    const tx = S.fired ? `第 ${S.fired} 天的考核，你排第 ${rk}。魏老板把你的牌子摘了下来。` : S.left ? `她走的那天，是第 ${S.left} 天。水牌上，你排第 ${rk}。` : rk === R.ranks ? '你的名字被摘了下来。' : rk === 1 ? '最上面那块牌子，写的是你。' : '';\n    return `<div class=\"panel\"><h2>水牌</h2>${boardHTML()}<p class=\"note\">${tx}${S.choice === 'cover' ? '小凤的名字还挂着。' : ''}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"rstep\" data-arg=\"r_home\">回家</button></div></div>`;\n  }\n  if (k === 'r_home') {\n    const seat = seatEmpty(S) || wifeOf(S) === 2;\n    const tx = S.left ? `灯坊对面的椅子空着。那盏灯搁在桌上：糊了 ${Math.min(LSEG, Math.floor(S.lamp / 2))} 片纸（糊满要 ${LSEG} 片），熄过 ${S.outs} 回，划了 ${S.scars} 道。没糊完。`\n      : S.fired ? (wifeOf(S) === 0 ? '你素着脸回家，比平时早。她愣了一下，把灯骨推过来：“正好，帮我糊完。”' : '你回家比平时早。她没问，给你盛了饭。灯上有几处熄过。')\n      : S.lit ? `灯亮着，${seat ? '是你自己点的。对面的椅子空着。' : '你们一起点的。'}${S.lamp < R.happyLamp ? '有几处熄过，补不回来了。' : ''}` : S.litAlone ? '你回来时，灯已经亮了。是她一个人点的。' : seat ? '对面的椅子空着。灯没有点。' : '灯还搁在桌上，没有点。她抬头看了你一下。';\n    return `<div class=\"panel\"><h2>回家</h2><p>${tx}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"rstep\" data-arg=\"r_chest\">打开木匣</button></div></div>`;\n  }\n  if (k === 'r_chest') {\n    const days = Array.from({ length: endDay(S) }, (_, i) => { const L = S.chest.filter(c => c.day === i + 1); return `<div>第 ${i + 1} 天<div class=\"cl\">${L.map(c => `<i style=\"background:${FCOL[c.f]}\"></i>`).join('') || ''}</div></div>`; }).join('');\n    return `<div class=\"panel\"><h2>木匣</h2><p class=\"note\">${S.chest.some(c => !c.last) ? `她替你擦过 ${S.chest.filter(c => !c.last).length} 层。每一块布都叠着，按日子放好。${S.chest.some(c => c.last) ? '最上面那一块，是最后一回。' : ''}` : S.chest.length ? '木匣里只有一块布，是最后一回。在那之前，她一次也没替你擦过。' : '木匣是空的。她一次也没替你擦过。'}</p><div class=\"book\">${days}</div><div class=\"acts\"><button class=\"btn go\" data-act=\"rfinal\">合上</button></div></div>`;\n  }\n  return '';\n}\n// 第二幕末的鏡子：台上演得最多的那一族，已經滲進臉裡；第三幕起，那一族推給她就帶著台上的字\nconst topFams = () => (S ? Object.keys(S.played).sort((a, b) => S.played[b] - S.played[a]) : ['sing']);\nfunction mirrorPanel() {\n  const [f1, f2] = topFams(), h1 = HOME[FAM[f1].home], card = BASIC.find(t => T[t].f === f1), over = S.base >= R.overBase[0];\n  const pics = (a, b) => `<div class=\"mirrorc\"><figure><img src=\"${cardArt(card, 'home').url}\" alt=\"\">${a}</figure><figure><img src=\"${cardArt(card, 'home', true).url}\" alt=\"\">${b}</figure></div>`;\n  const body = over\n    ? `<p>你对着镜子卸完妆。脸上还有一层${fc(f1)}的颜色——不是今天的油彩，是这几天一层层渗进去的，怎么擦都在。</p>${pics('你想给她的', '她听见的')}\n       <p>明天起（第三幕），你推给她的「${h1.n}」会带着台上的字。她听见的不是你，是戏：这一族推出去就算被染，灯上留一道痕。${S.base >= R.overBase[1] ? `底色已经到 ${R.overBase[1]}，${fc(f2)}那一族也一样。` : `底色到 ${R.overBase[1]}，演得第二多的那一族也会这样。`}</p>`\n    : `<p>你对着镜子卸完妆。镜子里，是你自己的脸。</p>${pics('现在', `底色到 ${R.overBase[0]} 以后`)}\n       <p>这几天你演得最多的是${fc(f1)}（${S.played[f1]} 张）。每晚没卸掉的油彩，睡一觉就渗进脸里，变成底色。第三幕里，底色到 ${R.overBase[0]}，你推给她的「${h1.n}」就会带着台上的字——推出去，就算被染。</p>`;\n  return `<div class=\"panel\"><h2>镜子</h2>${body}<p class=\"note\">现在底色 ${S.base}。底色只会多，不会少；每 2 点，妆匣少一格。</p><div class=\"acts\"><button class=\"btn go\" data-act=\"mirrorok\">睡吧</button></div></div>`;\n}\nfunction renderChoices() {\n  const opts = [], t = S.T;\n  const o = (label, act, sub, disabled, arg, pri) => opts.push(`<button class=\"opt ${pri ? 'pri' : ''}\" data-act=\"${act}\" ${arg !== undefined ? `data-arg=\"${arg}\"` : ''} ${disabled ? 'disabled' : ''}>${label}${sub ? `<small>${sub}</small>` : ''}</button>`);\n  if (busy || panel === 'rules' || sheet) { $('#choices').innerHTML = ''; return; }\n  const n = t.layers.length;\n  if (view === 'morning') {\n    const st = starterOf(S), yes = canDepart(S);\n    if (S.day !== R.days || S.choice) o(S.choice === 'lamp' ? '回家' : '出门', 'depart', yes ? (S.choice === 'lamp' ? '今天不上台' : '') : `还没带${st ? FAM[st].n : ''}`, !yes, undefined, yes);\n  }\n  if (view === 'stage') {\n    const stuck = !t.box.some(id => !t.used[id] && canStage(S, id) && (!t.plays.length || fits(S, id)));\n    if (t.ended) o(S.choice === 'stage' ? '散戏' : '回家', 'todoor', '', false, undefined, true);\n    else o('收场', 'endstage', t.plays.length ? `脸上 ${n} 层` : '今天不上台', false, undefined, t.plays.length >= t.stageMax || (t.plays.length > 0 && stuck));\n  }\n  if (view === 'door') {\n    if (S.day > 1 && S.scars <= R.wipeScarMax && canWipe(S)) o('让她擦', 'wipe', `${Math.min(R.wipeLayers, n)} 层 · 今晚只推 1 张`);\n    const dye = S.day === 1 ? 0 : dyeOf(S);\n    o(S.day === 1 ? '回去歇了' : '进门', 'enter', dye ? `前 ${dye} 张会被染` : '', false, undefined, !n || S.day === 1);\n  }\n  if (view === 'evening') {\n    if (S.choice === 'lamp') o('点灯', 'light', seatEmpty(S) ? '你一个人' : '她把火递给你', false, undefined, true);\n    else {\n      const ok = t.need.items.every(x => (t.got[x.look] || 0) >= x.n), full = t.pushed.length >= t.homeCap || !t.box.some(id => !t.used[id] && canHome(S, id));\n      o('吃完了', 'endeve', ok ? '' : '不够：灯会熄一截', false, undefined, ok || full);\n    }\n  }\n  if (view === 'night') o('睡吧', 'sleep', '', false, undefined, true);\n  $('#choices').innerHTML = opts.join('');\n}\nfunction renderHand() {\n  const h = $('#hand'), lb = $('#handLabel');\n  const show = ['morning', 'stage', 'door', 'evening', 'night'].includes(view) && !panel && !sheet && !(view === 'stage' && S.T.ended) && S.choice !== 'lamp';\n  h.classList.toggle('on', show);\n  if (!show) { h.innerHTML = ''; lb.innerHTML = ''; return; }\n  const t = S.T, side = view === 'evening' ? 'home' : 'stage', ids = t.box.filter(id => !t.used[id]);\n  const covered = view === 'evening' ? coveredFams(S) : [];\n  const can = id => {\n    if (busy) return false;\n    if (view === 'stage') return canStage(S, id);\n    if (view === 'evening') return canHome(S, id);\n    if (view === 'door' || view === 'night') return canClean(S, id);\n    return view === 'morning' && !lockedBox(S);\n  };\n  const hot = id => {\n    if (busy) return false;\n    if (view === 'stage') return canStage(S, id) && (!S.T.plays.length || fits(S, id)) && !keepHint(id);\n    if (view === 'evening') return canHome(S, id) && isMatch(S, id) && lack(S, lookOfCard(S, id)) > 0 && !willDye(S, id);\n    return false;\n  };\n  const n = ids.length, mid = (n - 1) / 2;\n  h.innerHTML = ids.map((id, i) => {\n    const c = cardOf(S, id), ok = can(id), tp = T[c.t];\n    const rot = (i - mid) * Math.min(2.6, 24 / Math.max(n, 1)), lift = Math.abs(i - mid) * 1.3;\n    const label = tp.home ? `${tp.n}，家常牌，不上台，背面${HOME[FAM[tp.f].home].n}` : `${tp.n}，${FAM[tp.f].n}，金 ${tp.g}，接${nextN(tp)}${kwOf(tp) ? `，${kwOf(tp)}` : ''}，背面${tp.blank ? '空白' : HOME[FAM[tp.f].home].n}`;\n    const dim = !ok && view !== 'morning';\n    const home = ['morning', 'stage', 'door'].includes(view) && keepHint(id);\n    return `<button class=\"hc ${ok ? 'play' : ''} ${hot(id) ? 'hot' : ''} ${dim ? 'off' : ''} ${home ? 'want' : ''}\" data-id=\"${id}\" ${tp.wild ? 'data-wild=\"1\"' : ''} style=\"transform:translateY(${lift}px) rotate(${rot}deg)\" ${ok ? `data-act=\"card\" data-arg=\"${id}\"` : 'disabled'} aria-label=\"${esc(label)}${home ? '，她今晚要的' : ''}\"><img src=\"${cardArt(c.t, side, covered.includes(tp.f) && !tp.home).url}\" alt=\"\">${view === 'evening' && canHome(S, id) && willDye(S, id) ? '<span class=\"stain\"></span>' : ''}${home ? '<span class=\"wtag\" aria-hidden=\"true\">家</span>' : ''}</button>`;\n  }).join('');\n  const tx = {\n    morning: lockedBox(S) ? '' : t.box.length ? '妆匣里的 · 点一张拿回去' : '妆匣是空的',\n    stage: ids.some(keepHint) ? '金框的能打 · 印着「家」的留着回家' : '',\n    door: t.layers.length ? '点一张牌卸一层' : '',\n    evening: t.pushed.length >= t.homeCap ? '她听不下了' : '点牌推给她',\n    night: t.layers.length ? '点一张牌卸一层' : '',\n  }[view];\n  // 裝匣的兩個按鈕跟著妝匣\n  const tools = view === 'morning' && !lockedBox(S) ? `<button class=\"mini\" data-act=\"yesterday\" ${S.lastBox ? '' : 'disabled'}>照昨天装</button><button class=\"mini\" data-act=\"clear\" ${t.box.length ? '' : 'disabled'}>全拿出来</button>` : '';\n  lb.innerHTML = `${tx ? `<span class=\"hlb\">${esc(tx)}</span>` : ''}${tools}`;\n}\n// 第一人稱時，臉上沒卸的台上臉化成螢幕四邊的油彩\nfunction renderSmear() {\n  const cv = $('#smear'), w = innerWidth, h = innerHeight;\n  if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; }\n  const x = cv.getContext('2d'); x.clearRect(0, 0, w, h);\n  if (!S || !['door', 'evening', 'night'].includes(view)) return;\n  const m = Math.min(w, h);\n  S.T.layers.forEach((ly, i) => {\n    const r = rng(101 + i * 977), col = hexRgb(FCOL[ly.f]);\n    for (let k = 0; k < 7; k++) {\n      const side = Math.floor(r() * 4); let px, py;\n      if (side === 0) { px = r() * w; py = -h * 0.04 + r() * h * 0.1; } else if (side === 1) { px = r() * w; py = h * 1.02 - r() * h * 0.08; } else if (side === 2) { px = -w * 0.02 + r() * w * 0.07; py = r() * h; } else { px = w * 1.02 - r() * w * 0.07; py = r() * h; }\n      const rad = (0.1 + r() * 0.14) * m, g = x.createRadialGradient(px, py, 0, px, py, rad);\n      g.addColorStop(0, `rgba(${col},.55)`); g.addColorStop(0.55, `rgba(${col},.22)`); g.addColorStop(1, `rgba(${col},0)`);\n      x.fillStyle = g; x.beginPath(); x.arc(px, py, rad, 0, Math.PI * 2); x.fill();\n    }\n  });\n}\nasync function ink(fn) {\n  const el = $('#ink');\n  if (calm()) { fn(); return; }\n  el.className = ''; void el.offsetWidth; el.className = 'on';\n  await wait(600); fn(); refresh(); await wait(100);\n  el.className = 'off'; await wait(460); el.className = '';\n}\nasync function fly(id, where) {\n  const el = document.querySelector(`.hc[data-id=\"${id}\"]`), t = cardOf(S, id).t, side = where === 'home' ? 'home' : 'stage';\n  const target = !glOK ? null : where === 'stage' ? cardSpot('stage', S.T.plays.length) : where === 'home' ? cardSpot('home', S.T.pushed.length) : null;\n  if (el && !calm()) {\n    const r = el.getBoundingClientRect(), ghost = new Image();\n    ghost.src = cardArt(t, side).url; ghost.className = 'ghost'; Object.assign(ghost.style, { left: r.left + 'px', top: r.top + 'px', width: r.width + 'px', height: r.height + 'px' });\n    document.body.appendChild(ghost); el.style.visibility = 'hidden';\n    let tx = innerWidth / 2, ty = innerHeight * 0.45;\n    if (glOK && target) { const v = target.clone().project(camera); tx = (v.x + 1) / 2 * innerWidth; ty = (1 - v.y) / 2 * innerHeight; }\n    if (!target && where === 'cloth') ty = innerHeight + 80;\n    const anim = ghost.animate([{ transform: 'none', opacity: 1 }, { transform: `translate(${tx - r.left - r.width / 2}px, ${ty - r.top - r.height / 2}px) scale(${target ? 0.32 : 0.5}) rotate(${where === 'cloth' ? 40 : 8}deg)`, opacity: where === 'cloth' ? 0 : 0.95 }], { duration: 400, easing: 'cubic-bezier(.3,.7,.3,1)' });\n    await Promise.race([anim.finished.catch(() => {}), wait(700)]);\n    ghost.remove();\n  }\n  if (target) spawnCard(t, side, target);\n}\nfunction burst(n) {\n  if (calm()) return;\n  const fx = $('#fx');\n  for (let i = 0; i < Math.min(n, 44); i++) {\n    const f = document.createElement('span'); f.className = 'fleck';\n    f.style.left = `${8 + Math.random() * 84}vw`; f.style.animationDelay = `${Math.random() * 0.5}s`; f.style.background = Math.random() < 0.3 ? '#efe2c2' : '#b8913f';\n    fx.appendChild(f); setTimeout(() => f.remove(), 2600);\n  }\n}\nfunction stamp(text) { const s = document.createElement('div'); s.className = 'stamp'; s.textContent = text; document.body.appendChild(s); setTimeout(() => s.remove(), 1800); }\nconst PIPS = { 1: [4], 2: [0, 8], 3: [0, 4, 8], 4: [0, 2, 6, 8], 5: [0, 2, 4, 6, 8], 6: [0, 2, 3, 5, 6, 8] };\nconst dieHTML = (v, cls = '') => `<span class=\"die ${cls} ${v === 1 || v === 4 ? 'red' : ''}\" aria-hidden=\"true\">${Array.from({ length: 9 }, (_, i) => `<i class=\"${PIPS[v].includes(i) ? 'on' : ''}\"></i>`).join('')}</span>`;\nasync function showDice(o) {\n  const el = $('#dice');\n  el.hidden = false;\n  el.innerHTML = `<div class=\"dbox\" role=\"status\"><span class=\"lb\">${esc(o.label)}</span><span class=\"dslot\">${dieHTML(1)}</span><span class=\"res\"></span></div>`;\n  const slot = el.querySelector('.dslot'), res = el.querySelector('.res');\n  if (!calm()) for (let i = 0; i < 8; i++) { slot.innerHTML = dieHTML(1 + Math.floor(Math.random() * 6), 'spin'); await wait(65); }\n  slot.innerHTML = dieHTML(o.v, 'land');\n  res.className = `res ${o.ok ? 'ok' : 'bad'}`;","numLines":300,"startLine":2754,"totalLines":3649}},"tool_result_meta":[{"id":"toolu_0124tri8ogderv8BD4qxxW1e","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
