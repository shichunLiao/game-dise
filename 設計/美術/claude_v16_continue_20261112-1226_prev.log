x rgba(242, 212, 138, .7); animation: cbIn 1.5s cubic-bezier(.2, 1.4, .4, 1) both; white-space: nowrap; }\n35\t#combo .cb.big { color: #fff1c8; font-size: clamp(56px, 10vw, 124px); text-shadow: 0 0 2px #3a0a0e, 0 5px 0 #a8202b, 0 0 46px rgba(255, 200, 120, .95); }\n36\t#combo .cb.bad { color: #c9c0c2; text-shadow: 0 3px 0 #1c1719, 0 0 18px rgba(0, 0, 0, .8); font-size: clamp(36px, 6vw, 70px); }\n37\t#combo .cb.slow, #combo .cb.slow + .cs { animation-duration: 3.6s; }\n38\t#combo .cs { font-family: var(--body); font-size: 16px; letter-spacing: .3em; color: #f2d48a; text-shadow: 0 2px 6px #000; animation: cbIn 1.5s ease both; }\n39\t@keyframes cbIn { 0% { opacity: 0; transform: scale(2.2) rotate(-6deg); filter: blur(6px); } 14% { opacity: 1; transform: scale(.94) rotate(-2deg); filter: none; } 22% { transform: scale(1) rotate(-2deg); } 78% { opacity: 1; } 100% { opacity: 0; transform: translateY(-24px) rotate(-2deg); } }\n40\t.gainf { position: fixed; z-index: 30; pointer-events: none; font-family: var(--display); font-size: 34px; color: #f6dc96; text-shadow: 0 2px 0 #7d1219, 0 0 14px rgba(242, 212, 138, .8); transform: translate(-50%, -50%); animation: gainUp 1.2s ease-out both; }\n41\t.gainf.bad { color: #d8c6c8; text-shadow: 0 2px 0 #1c1719; }\n42\t@keyframes gainUp { from { opacity: 0; transform: translate(-50%, -20%) scale(.6); } 20% { opacity: 1; transform: translate(-50%, -60%) scale(1.15); } to { opacity: 0; transform: translate(-50%, -190%) scale(1); } }\n43\t.bub.intel { animation: bubIn .28s cubic-bezier(.2, 1.4, .4, 1) both, intelGlow 1.6s ease-in-out .3s infinite; }\n44\t@keyframes intelGlow { 50% { box-shadow: 0 0 0 7px rgba(242, 212, 138, .28), 0 0 40px rgba(242, 212, 138, .85), 0 10px 26px rgba(0, 0, 0, .6); } }\n45\t#gl { display: block; }\n46\t#smear, #vig, #grain { pointer-events: none; }\n47\t#vig { background: radial-gradient(ellipse at 50% 42%, transparent 55%, rgba(8, 6, 7, .72) 100%); }\n48\t#grain { opacity: .18; mix-blend-mode: overlay; backg