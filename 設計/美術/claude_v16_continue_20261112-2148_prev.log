, typeof r === 'string' ? r.slice(0, 3000) : JSON.stringify(r).slice(0, 3000)); }\n      if (s.click) await page.click(s.click, { timeout: 4000 });\n      if (s.wait) await page.waitForTimeout(s.wait);\n      if (s.shot) { await page.screenshot({ path: `${prefix}${s.shot}.png` }); console.log('shot', `${prefix}${s.shot}.png`); }\n    } catch (e) { console.log('step error', JSON.stringify(s).slice(0, 120), e.message.split('\\n')[0]); }\n  }\n  console.log(logs.join('\\n'));\n  await browser.close();\n})().catch(e => { console.error(e); process.exit(1); });\nEOF\ncat > /private/tmp/v16qa/flow1.js <<'EOF'\n// 第 1 天：台上 → 門口 → 灯坊（她的需要、燈芯）→ 燈回饋 → 夜 → 更夫頁 → 第 2 天早上\nmodule.exports = [\n  { js: \"localStorage.setItem('dise-v15-tut','0'); localStorage.removeItem('dise-v13'); (() => { startGame('小满'); return S.phase; })()\", wait: 3000 },\n  { until: \"view === 'door'\", gap: 900 },\n  { wait: 1500, shot: 'door' },\n  { until: \"view === 'evening'\", gap: 900 },\n  { wait: 2000, shot: 'evening' },\n  { until: \"!document.querySelector('#lampfb').hidden\", gap: 900 },\n  { wait: 1800, shot: 'lampfb' },\n  { until: \"view === 'watch'\", gap: 900 },\n  { wait: 1500, shot: 'watch' },\n  { until: \"view === 'morning'\", gap: 900 },\n  { wait: 2500, shot: 'morning2' },\n  { js: \"(() => { panel = 'water'; refresh(); return 1; })()\", wait: 800, shot: 'water' },\n  { js: \"(() => { panel = 'book'; bookTab = 'relics'; S.relics = ['qinshi', 'cha', 'luo']; refresh(); return 1; })()\", wait: 800, shot: 'bookrel' },\n  { js: \"(() => { panel = 'shop'; S.T.offers = ['manban', 'qinshi', 'you']; S.gold = 30; refresh(); return 1; })()\", wait: 800, shot: 'shop' },\n  { js: \"(() => { panel = null; refresh(); say('孙师父', '“琴师，你留着。”', '卖座 −12'); stamp('完美'); return 1; })()\", wait: 350, shot: 'stamp' },\n];\nEOF\ncd /private/tmp/v16qa && BOOT=4500 node drive2.js \"http://127.0.0.1:8716/%E5%8E%9F%E5%9E%8B/v1.6/index.html\" /private/tmp/v16qa/s/f1_ /private/tmp/v16qa/flow1.js 1440 900 2>&1 | tail