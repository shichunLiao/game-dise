n { width: calc(var(--hw) * .33); height: calc(var(--hw) * .33); }","+/* 疊得緊時，「家」和染角挪到每張露出來的那一條上；最右（最上面）那張、滑鼠指著抬起來的那張照舊 */","+.hud .hand.fit .hc:not(:last-child):not(.play:hover) .wtag { left: min(50%, calc(var(--hv) / 2)); }","+.hud .hand.fit .hc:not(:last-child):not(.play:hover) .stain { right: auto; left: calc(var(--hv) - var(--hw) * .33); border-top-right-radius: 0; }","+/* 窄到每張露不到三成（正常尺寸碰不到）：改成從最左一張排起、可以橫捲，捲軸看得見 */","+.hud .hand.scroll { overflow-x: auto; overflow-y: hidden; justify-content: flex-start; padding-bottom: 18px; scrollbar-width: thin; scrollbar-color: rgba(242, 212, 138, .6) transparent; }","+.hud .hand.scroll::-webkit-scrollbar { display: block; height: 4px; }","+.hud .hand.scroll::-webkit-scrollbar-thumb { background: rgba(242, 212, 138, .6); }","+.hud .hand.scroll .hc:first-child { margin-left: auto; }","+.hud .hand.scroll .hc:last-child { margin-right: auto; }","+/* 手機：手牌那一排用到螢幕兩邊（離邊 4px） */","+@media (max-width: 760px) { .hand { margin-inline: -12px; } }","+/* 矮螢幕（手機橫放、很矮的視窗）：字幕往上疊，不再把手牌擠出畫面下緣；手牌用手機的尺寸 */","+.talk { min-height: 0; justify-content: flex-end; }","+@media (max-height: 560px) {","+  .hand.on { min-height: 124px; padding-top: 10px; }","+  .hc { width: 72px; height: 108px; margin: 0 -4px; }","+  .hc .stain { width: 24px; height: 24px; }","+  .hud[data-v=\"morning\"] .hand.on { min-height: 92px; }","+  .hud[data-v=\"morning\"] .hc { width: 54px; height: 81px; margin: 0 -2px; }","+}"," </style>"," "," <canvas id=\"gl\" aria-hidden=\"true\"></canvas>"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01D7aFtLEnZFsVybQ1BC6Nns","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
