th d=\"M4 20.5h16\" stroke=\"currentColor\" stroke-width=\"1\"/></svg>',\n  累: '<svg viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"9\" r=\"4.3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" transform=\"rotate(18 11 9)\"/><path d=\"M8.6 9.8q1 .7 2 0M11.8 10.6q1 .7 2 0\" stroke=\"currentColor\" fill=\"none\" stroke-width=\"1.1\"/><path d=\"M4 22c1-4.5 3.6-7.2 7.4-7.2S18 17.5 19 22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M16.5 3.2h3.2l-3.2 3.2h3.2\" stroke=\"currentColor\" fill=\"none\" stroke-width=\"1\"/></svg>',\n  忙: '<svg viewBox=\"0 0 24 24\"><ellipse cx=\"12\" cy=\"13.2\" rx=\"7\" ry=\"8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 5.2v16M7.4 6.8c-2 3.6-2 9.4 0 12.9M16.6 6.8c2 3.6 2 9.4 0 12.9M5 13.2h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\"/><rect x=\"9\" y=\"2\" width=\"6\" height=\"2.6\" fill=\"currentColor\"/></svg>',\n  想说: '<svg viewBox=\"0 0 24 24\"><path d=\"M3.5 4.5h17v11H10l-5 4.2v-4.2H3.5z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/><circle cx=\"8.5\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/><circle cx=\"15.5\" cy=\"10\" r=\"1.1\" fill=\"currentColor\"/></svg>',\n};\n\n// ── 教學小框：連擊、接口、被染第一次出現時解釋（第八節）；要玩家動手的步驟，只放行框裡的東西 ──\nconst TUT_KEY = 'dise-v15-tut';\nconst tutPref = () => { try { return localStorage.getItem(TUT_KEY) !== '0'; } catch (e) { return true; } };\nconst setTutPref = on => { try { localStorage.setItem(TUT_KEY, on ? '1' : '0'); } catch (e) { /* 存不了就算了 */ } };\nconst handOf = t => { const id = S.T.box.find(x => cardOf(S, x).t === t && !S.T.used[x]); return id === undefined ? null : document.querySelector(`.hc[data-id=\"${id}\"]`); };\nconst famOfLook = look => Object.keys(FAM).find(f => FAM[f].home === LOOK_HOME[look]);\n// 她要的：「累」照顧 ×2 + 「忙」共勞 ×1\nconst recipeTx = nd => nd.items.map(x => `「${x.look}」${HOME[LOOK_HOME[x.look]].n} ×${x.n}`).join(' + ');\nconst recipeShort = nd => nd.items.map(x => `${x.look}·${HOME[LOOK_HOME[x.look]].n}×${x.n}`).join(' + ');\nconst needTx = (nd = needOf(S)) => `要 ${nd.items.map(x => `<b>${HOME[LOOK_HOME[x.look]].n}</b>×${x.n}（${fc(famOfLook(x.look))}牌的背面）`).join(' + ')}`;\n// 3D 裡的東西在螢幕上的位置：教學框要指著它\nfunction anchor(name, at, w = 150, h = 150) {\n  let el = document.getElementById(`anc-${name}`);\n  if (!el) { el = document.createElement('div'); el.id = `anc-${name}`; $('#anchors').appendChild(el); }\n  if (!glOK) { el.style.display = 'none'; return null; }\n  const v = at.clone().project(camera);\n  if (v.z > 1 || Math.abs(v.x) > 0.95 || Math.abs(v.y) > 0.95) { el.style.display = 'none'; return null; }\n  const x = (v.x + 1) / 2 * innerWidth, y = (1 - v.y) / 2 * innerHeight;\n  Object.assign(el.style, { display: 'block', left: `${x - w / 2}px`, top: `${y - h / 2}px`, width: `${w}px`, height: `${h}px` });\n  return el;\n}\n// v1.5 教學：第 1 天手把手（做對了就往下，不用按「知道了」）；只看不做的步驟只留四處；其餘改成不擋畫面的小提示（NUDGES）\nconst handCards = () => Array.from(document.querySelectorAll('#hand .hc'));\nconst firstPlayed = () => { const p = S.T.plays[0]; return p ? cardOf(S, p.id).t : 'changqiang'; };\nconst LESSONS = {\n  open: [\n    { at: () => [handOf('changqiang')], until: () => S.T.plays.length > 0, text: () => `金框的牌能打。第一张要打木牌上的起手${fc('sing')}：点「长腔」。`, tap: '点这张' },\n  ],\n  chain: [\n    { at: () => [handOf('bai')], until: () => S.T.plays.length > 1, text: () => `长腔写着「接 → ${fc('speak')}」。下一张打${fc('speak')}，就接上了，多拿金。点「白」。`, tap: '点这张' },\n  ],\n  chain2: [\n    { at: handCards, place: 'left', until: () => S.T.plays.length >= 4 || S.T.ended, text: () => '金框的牌都接得上。照「接」再打两张。' },\n  ],\n  end: [\n    { at: () => [$('[data-act=\"endstage\"]')], until: () => S.T.ended, text: () => '四张了，脸上也有四层油彩。见好就收：点收场。', tap: '点收场' },\n  ],\n  door: [\n    { at: () => [glOK ? anchor('mirror', new THREE.Vector3(1.32, TOP + 0.46, -0.02), 200, 200) : $('#topmid')], follow: true, title: '你的脸', text: () => '台上打几张，脸上就有几层油彩。', rule: '进门前卸掉；没卸的，会染到推给她的牌' },\n    { at: handCards, place: 'left', until: () => !S.T.layers.length || view !== 'door', text: () => '点一张牌弃掉，卸一层。卸干净再进门。' },\n  ],\n  home: [\n    { title: '一张牌，两面', vis: () => `<div class=\"flip\"><div class=\"fl\"><img src=\"${cardArt(firstPlayed(), 'stage').url}\" alt=\"\"><img class=\"b\" src=\"${cardArt(firstPlayed(), 'home').url}\" alt=\"\"></div><div class=\"cap\">台上面：<b>${T[firstPlayed()].n}</b><br>家里面：<b>${HOME[FAM[T[firstPlayed()].f].home].n}</b></div></div>`, text: () => '台上打掉、卸妆弃掉的牌，今晚就没了。', rule: '留在手里的，回家翻过来推给她' },\n    { at: () => [$('#homep')], title: '她的灯', text: () => '往后每晚她要一样东西，推对了，灯亮一片。', rule: '没满足她，灯熄一截' },\n  ],\n  intel: [\n    { at: () => [$('.intel')], title: '今晚她要', text: () => `今晚她${needTx()}。`, rule: '印着「家」的牌，留着别打上台' },\n  ],\n  need: [\n    { at: handCards, place: 'left', title: '被染', read: () => !S.T.box.some(id => !S.T.used[id] && canHome(S, id) && isMatch(S, id) && !willDye(S, id)) && !S.T.box.some(id => !S.T.used[id] && canHome(S, id) && !isMatch(S, id)), until: () => gotOf(S.T) >= S.T.need.k || S.T.pushed.length >= S.T.homeCap, text: () => { const n = HOME[LOOK_HOME[S.T.need.items[0].look]].n, spare = S.T.box.some(id => !S.T.used[id] && canHome(S, id) && !isMatch(S, id)); return !S.T.dye ? `点金框的「${n}」，推给她。` : spare ? `牌角红的会被染：先推一张不要紧的，再推她要的「${n}」。` : `脸没卸干净，牌角红的会被染：推了，灯上留一道痕。下回卸干净再进门。`; } },\n  ],\n  pick: [\n    { at: () => [$('.spread')], title: '自己装妆匣', text: () => '上面是你的卡组：点一张，放进妆匣（下面一排）；点下面的，拿回去。', rule: '起手那一族一定要带；印着「家」的是她今晚要的' },\n  ],\n};\n// 小提示：不擋畫面、不用按；每條只出一次，同一時刻只有一條\nconst NUDGES = {\n  board: { at: () => $('#wboard'), when: () => view === 'morning' && S.day >= 2, tx: () => `<b>水牌</b>你和同门按卖座排名。第 3 天散戏后垫底，就被摘牌。` },\n  book: { at: () => $('#bookBtn'), when: () => view === 'morning' && S.day >= 2 && S.tut.seen.board, tx: () => '<b>图鉴</b>看不懂的牌和词，都在这里。' },\n  crowd: { at: () => $('.bub.intel'), when: () => view === 'stage', tx: () => '<b>台下的话</b>金框那句说的是她今晚要什么，会记在上面那一排。' },\n  wipe: { at: () => $('[data-act=\"wipe\"]'), when: () => view === 'door', tx: () => `<b>让她擦</b>一次擦 ${R.wipeLayers} 层，不耗牌；但今晚她只听得下 1 张。` },\n  stakes: { at: () => $('#homep'), when: () => view === 'night' && S.day >= 2 && !$('#lampfb:not([hidden])'), tx: () => `<b>她会走</b>灯熄满 ${R.brokenOuts} 回，或痕到 ${R.brokenScar} 道。` },\n  shop: { at: () => $('[data-act=\"shop\"]'), when: () => view === 'morning', tx: () => '<b>后台</b>孙师父卖牌和物件。花的就是卖座，名次会掉；越早买越划算。' },\n  wild: { at: () => $('.hc[data-wild].play'), when: () => view === 'stage', tx: () => '<b>百搭</b>前后都接得上，还能起手。链要断的时候用它。' },\n  grudge: { at: () => $('.nowline'), when: () => view === 'stage' && S.T.grudge > 0, tx: () => '<b>怨气</b>接错了，嘘声跟你回家：今晚多染一张牌。' },\n  gift: { at: () => $('.spread .spc[data-t^=\"home_\"]') || $('.spread'), when: () => view === 'morning' && S.gifts.length > 0 && !lockedBox(S), tx: () => '<b>家常牌</b>她送的，不上台。对上她的需要，一张算两张。' },\n};\nconst coach = { lesson: null, i: 0, shown: '' };\nfunction lessonNow() {\n  if (panel || sheet) return null;\n  const d = S.day, t = S.T;\n  if (view === 'stage') {\n    if (d !== 1) return null;\n    if (t.ended) return null;\n    return !t.plays.length ? 'open' : t.plays.length === 1 ? 'chain' : t.plays.length < 4 && !t.plays.some(p => p.broke) ? 'chain2' : t.plays.length >= 4 ? 'end' : null;\n  }\n  if (d === 1 && view === 'door' && t.layers.length) return 'door';\n  if (d === 1 && view === 'night') return 'home';\n  if (d === 2 && view === 'evening' && t.pushed.length === 0) return 'need';\n  if (view === 'morning' && !lockedBox(S) && d === 3) return 'pick';\n  if (view === 'morning' && d === 2) return 'intel';\n  return null;\n}\nfunction coachStart(k) { coach.lesson = k; coach.i = 0; coach.shown = ''; coach.view = view; }\nfunction coachNext() {\n  if (!coach.lesson) return;\n  coach.i += 1;\n  if (coach.i < LESSONS[coach.lesson].length) return;\n  S.tut.seen[coach.lesson] = true;\n  coach.lesson = null;\n  if ([...Object.keys(LESSONS), ...Object.keys(NUDGES)].every(k => S.tut.seen[k])) setTutPref(false);\n}\nfunction coachSkip() { S.tut.off = true; coach.lesson = null; setTutPref(false); nudgeHide(true); }\n// 狀態一變就看一次：要玩家做的事做到了就往下；這個時段還沒教過就開始教\nfunction coachTick() {\n  if (busy || !S || view === 'title' || !S.tut) return;\n  for (let n = 0; n < 4; n++) {\n    if (coach.lesson) {\n      // 換了場景：這一課就算教完了，不跟著帶過去\n      if (view !== coach.view) { S.tut.seen[coach.lesson] = true; coach.lesson = null; continue; }\n      const st = LESSONS[coach.lesson][coach.i];\n      if (!st.until || !st.until()) return;\n      coachNext();\n    } else {\n      const k = lessonNow();\n      if (!k || S.tut.off || S.tut.seen[k]) return nudgeTick();\n      coachStart(k);\n    }\n  }\n}\nfunction coachRender(geom = false) {\n  const el = $('#coach'), on = !!S && !!coach.lesson && !busy && view !== 'title' && panel !== 'rules';\n  $('#hud').inert = false;\n  if (!on) { el.hidden = true; return; }\n  const steps = LESSONS[coach.lesson], st = steps[coach.i], key = `${coach.lesson}:${coach.i}`;\n  const els = st.at ? st.at().filter(x => x && x.getClientRects().length) : [];\n  const act = !!st.until && els.length > 0 && !(st.read && st.read());\n  if (coach.shown !== key && st.on) st.on();\n  if (coach.shown !== key && els[0] && !els[0].closest('#anchors')) els[0].scrollIntoView({ block: 'nearest', inline: 'center' });\n  let r = null;\n  els.forEach(x => { const b = x.getBoundingClientRect(); r = r ? { l: Math.min(r.l, b.left), t: Math.min(r.t, b.top), r: Math.max(r.r, b.right), b: Math.max(r.b, b.bottom) } : { l: b.left, t: b.top, r: b.right, b: b.bottom }; });\n  const W = innerWidth, H = innerHeight, pad = act ? 5 : 8;\n  if (r) r = { l: Math.max(4, r.l - pad), t: Math.max(4, r.t - pad), r: Math.min(W - 4, r.r + pad), b: Math.min(H - 4, r.b + pad) };\n  el.hidden = false;\n  hidePeek();\n  const doing = act ? `<span class=\"do\">${esc(st.tap || '点亮起来的地方')}</span>` : `<button class=\"btn go small\" data-act=\"coachnext\">${coach.i < steps.length - 1 ? '下一句' : '好'}</button>`;\n  el.classList.toggle('doing', act);\n  // 只挪位置（鏡頭在動）：不重建，免得說明框重播淡入\n  const keep = geom && coach.shown === key && el.querySelector('.cbox') && !!el.querySelector('.ring') === !!r;\n  if (!keep) el.innerHTML = `<div class=\"dim\"></div><div class=\"shield\"></div>${r ? `<div class=\"ring\" ${act && st.tap ? `data-tap=\"${esc(st.tap)}\"` : ''}></div>` : ''}\n    <div class=\"cbox\" role=\"dialog\" aria-label=\"${esc(st.title || '教学')}\" aria-describedby=\"coachX\">${steps.length > 1 && !act ? `<span class=\"step\">${coach.i + 1}/${steps.length}</span>` : ''}${st.title && !act ? `<h4 id=\"coachT\">${st.title}</h4>` : ''}${st.vis ? st.vis() : ''}<div class=\"tx\" id=\"coachX\">${termify(st.text())}</div>${st.rule ? `<p class=\"rule\">${termify(typeof st.rule === 'function' ? st.rule() : st.rule)}</p>` : ''}\n      <div class=\"row\">${doing}<button class=\"skip\" data-act=\"coachskip\">不用教了</button></div><i class=\"arrow\" aria-hidden=\"true\"></i></div>`;\n  const path = `path(evenodd, 'M0 0H${W}V${H}H0Z${r ? `M${r.l} ${r.t}H${r.r}V${r.b}H${r.l}Z` : ''}')`;\n  el.querySelector('.dim').style.clipPath = path;\n  el.querySelector('.shield').style.clipPath = act ? path : 'none';\n  if (r) Object.assign(el.querySelector('.ring').style, { left: `${r.l}px`, top: `${r.t}px`, width: `${r.r - r.l}px`, height: `${r.b - r.t}px` });\n  // 說明框放在洞上下空間大的一邊，箭頭指著洞\n  const box2 = el.querySelector('.cbox'), bw = box2.offsetWidth, bh = box2.offsetHeight, ar = box2.querySelector('.arrow');\n  let left = (W - bw) / 2, top = (H - bh) / 2;\n  if (r) {\n    const below = H - r.b >= r.t, side = st.place === 'left' && r.l - bw - 24 > 0;\n    // 洞上方掛著「點這裡」的小籤，說明框放上面時要讓開它\n    top = below ? r.b + 16 : r.t - (act ? 46 : 16) - bh;\n    left = (r.l + r.r) / 2 - bw / 2;\n    if (side) { left = r.l - bw - 18; top = (r.t + r.b) / 2 - bh / 2; }\n    top = clamp(top, 12, H - bh - 12); left = clamp(left, 16, W - bw - 16);\n    ar.hidden = side || (top < r.b && top + bh > r.t);\n    ar.className = `arrow