ter-events: auto; }\n63\t.tool { white-space: nowrap; background: rgba(18, 14, 17, .6); border: 1px solid rgba(236, 227, 212, .35); color: var(--paper); padding: 3px 10px; font-size: 12px; cursor: pointer; min-height: 30px; }\n64\t\n65\t/* 妝匣：10 個格子，異常出現在這裡 */\n66\t/* 左欄：家（燈、熄、痕）和圖鑑 */\n67\t.leftcol { position: absolute; left: max(16px, env(safe-area-inset-left, 0px)); top: 158px; width: 156px; display: flex; flex-direction: column; gap: 8px; pointer-events: auto; }\n68\t.homep { background: linear-gradient(180deg, #efe6d6, #dccfb6); color: var(--ink); border: 1px solid #1d120b; box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .35), 0 6px 18px rgba(0, 0, 0, .55); padding: 5px 9px 8px; }\n69\t.homep[hidden] { display: none; }\n70\t.homep .hh { display: flex; justify-content: space-between; align-items: baseline; font-size: 11px; letter-spacing: .25em; color: #8a2a2a; border-bottom: 1px solid rgba(28, 23, 25, .2); padding-bottom: 2px; margin-bottom: 4px; }\n71\t.homep .hh span:last-child { letter-spacing: .05em; color: #5a5156; }\n72\t.homep .hl { display: flex; align-items: center; gap: 8px; }\n73\t.homep .hl .lampsvg { width: 58px; height: 58px; flex: none; }\n74\t.homep .hl b { font-family: var(--display); font-weight: 400; font-size: 32px; line-height: 1; color: var(--red); }\n75\t.homep .hl small { display: block; font-size: 11px; color: #5a5156; line-height: 1.35; }\n76\t.homep .hrow { display: flex; align-items: center; gap: 6px; margin-top: 5px; font-size: 12px; }\n77\t.homep .hrow .k { font-family: var(--display); font-size: 17px; width: 1.1em; }\n78\t.homep .hrow em { font-style: normal; font-size: 11px; color: #5a5156; margin-left: auto; white-space: nowrap; }\n79\t.homep .hrow.hot em { color: var(--red); font-weight: 700; }\n80\t.homep .outs { gap: 3px; }\n81\t.homep .outs i { width: 12px; height: 12px; border-color: #6a5f62; }\n82\t.homep .scars { gap: 5px; }\n83\t.homep .scars i { width: 4px; height: 16px; background: rgba(28, 23, 25, .16); }\n84\t.homep .scars i.on { background: var(--red); }\n85\t.hud[data-v=\"morning\"] .homep:not(.warn), .hud[data-v=\"stage\"] .homep:not(.warn), .hud[data-v=\"door\"] .wb, .hud[data-v=\"evening\"] .wb, .hud[data-v=\"night\"] .wb, .hud[data-v=\"evening\"] .relics, .hud[data-v=\"night\"] .relics { opacity: .5; transition: opacity .2s; }\n86\t.hud .homep:hover, .hud .wb:hover, .hud .wb:focus-visible, .hud .relics:hover { opacity: 1; }\n87\t.homep.warn { box-shadow: 0 0 0 2px var(--red), 0 0 20px rgba(200, 40, 58, .55), 0 6px 18px rgba(0, 0, 0, .55); animation: warnP 1.8s ease-in-out infinite; }\n88\t@keyframes warnP { 50% { box-shadow: 0 0 0 2px var(--red), 0 0 6px rgba(200, 40, 58, .3), 0 6px 18px rgba(0, 0, 0, .55); } }\n89\t.tool.bookb { width: 100%; text-align: left; display: flex; justify-content: space-between; align-items: center; }\n90\t.tool.bookb small { font-size: 11px; color: var(--paper-2); }\n91\t.tools { display: flex; gap: 6px; justify-content: flex-end; }\n92\t\n93\t.mid { flex: 1; min-height: 0; position: relative; }\n94\t/* 白天：這一場出過的牌與連擊 */\n95\t.chain { pointer-events: none; display: flex; flex-direction: column; align-items: center; gap: 3px; }\n96\t.played { display: flex; align-items: center; gap: 2px; }\n97\t.pl { width: 56px; height: 42px; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1; font-family: var(--display); font-size: 16px; color: var(--paper); border: 1px solid rgba(236, 227, 212, .35); }\n98\t.pl small { font-family: var(--body); font-size: 11px; color: #f4dfa8; font-variant-numeric: tabular-nums; }\n99\t.pl.no { background: rgba(18, 14, 17, .45); border-style: dashed; }\n100\t.lk { width: 12px; text-align: center; font-size: 12px; color: var(--gold); }\n101\t.lk.x { color: var(--red-2); }\n102\t.nowline { display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 2px 18px; background: rgba(14, 10, 12, .72); font-family: var(--display); font-size: 24px; color: #f2d48a; text-shadow: 0 1px 4px #000; }\n103\t.nowline .fc { width: 32px; height: 32px; font-size: 18px; }\n104\t.nowline small { font-family: var(--body); font-size: 12px; color: var(--paper-2); }\n105\t.nowline b { font-family: var(--display); font-weight: 400; font-size: 20px; color: var(--gold); }\n106\t.nowline .bad { color: var(--red-2); }\n107\t.nx { animation: nxflash .9s ease-in-out infinite; }\n108\t@keyframes nxflash { 50% { box-shadow: 0 0 0 5px rgba(236, 227, 212, .28), 0 0 14px rgba(236, 227, 212, .6); } }\n109\t/* 她的樣子：畫面為主，放大（滑過、聚焦或點開）才附文字 */\n110\t.lookb { pointer-events: auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: rgba(18, 14, 17, .62); border: 1px solid rgba(236, 227, 212, .35); border-radius: 50%; width: 58px; height: 58px; color: var(--paper); cursor: zoom-in; transition: width .2s ease, height .2s ease; }\n111\t.lookb svg { width: 32px; height: 32px; }\n112\t.lookb .lb { display: none; font-family: var(--display); font-size: 16px; line-height: 1; }\n113\t.lookb:hover, .lookb:focus-visible, .lookb[aria-expanded=\"true\"] { width: 80px; height: 80px; }\n114\t.lookb:hover .lb, .lookb:focus-visible .lb, .lookb[aria-expanded=\"true\"] .lb { display: block; }\n115\t\n116\t/* 早上：桌上攤開的卡組，點一張放進妝匣 */\n117\t.spread { pointer-events: auto; position: absolute; left: 50%; top: 2px; transform: translateX(-50%); display: grid; grid-template-columns: repeat(var(--cols, 4), auto); gap: 8px 10px; background: rgba(18, 14, 17, .72); border: 1px solid rgba(236, 227, 212, .22); padding: 10px 12px; max-height: 100%; overflow: auto; }\n118\t.spc { position: relative; width: var(--cw, 84px); height: var(--chh, 126px); border: none; background: none; padding: 0; cursor: pointer; transition: transform .15s ease; }\n119\t.spc img { width: 100%; height: 100%; display: block; border-radius: 6px; }\n120\t.spread .sph { grid-column: 1 / -1; font-size: 12px; letter-spacing: .2em; color: var(--paper-2); margin: -2px 0 2px; }\n121\t.spc:hover:not(:disabled), .spc:focus-visible { transform: translateY(-4px); }\n122\t.spc:disabled { cursor: default; filter: brightness(.42) saturate(.5); }\n123\t.spc .ct { position: absolute; right: -5px; top: -5px; min-width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--ink); border: 1px solid var(--gold); font-size: 13px; font-variant-numeric: tabular-nums; }\n124\t.tools2 { grid-column: 1 / -1; display: flex; gap: 8px; justify-content: center; }\n125\t.mini { border: 1px solid rgba(236, 227, 212, .45); background: transparent; color: var(--paper); font-size: 12px; padding: 3px 10px; min-height: 32px; cursor: pointer; }\n126\t.mini:disabled { opacity: .35; cursor: not-allowed; }\n127\t.yuan { pointer-events: auto; position: absolute; left: 50%; top: 2px; transform: translateX(-50%); width: min(620px, 100%); background: rgba(18, 14, 17, .78); border: 1px solid rgba(184, 145, 63, .6); padding: 10px 12px; }\n128\t.yuan h3 { font-family: var(--display); font-weight: 400; font-size: 24px; margin: 0 0 8px; text-align: center; }\n129\t.yuan .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }\n130\t.yn { border: 1px solid rgba(236, 227, 212, .45); background: transparent; color: var(--paper); text-align: left; padding: 8px 10px; cursor: pointer; font-family: var(--display); font-size: 20px; line-height: 1.3; }\n131\t.yn small { display: block; font-family: var(--body); font-size: 12px; color: var(--paper-2); }\n132\t.yn[aria-pressed=\"true\"] { background: var(--red); border-color: var(--red); }\n133\t\n134\t/* 紙：水牌、規矩 */\n135\t.panel { pointer-events: auto; position: absolute; left: 50%; top: 4px; transform: translateX(-50%); width: min(520px, 100%); max-height: calc(100% - 8px); overflow: auto; background: var(--paper); color: var(--ink); padding: 14px 18px 16px; border-top: 6px solid var(--red); box-shadow: 0 12px 40px rgba(0, 0, 0, .55); }\n136\t.panel h2 { font-family: var(--display); font-weight: 400; font-size: 30px; margin: 0 0 6px; letter-spacing: .08em; }\n137\t.panel h4 { font-family: var(--display); font-weight: 400; font-size: 20px; margin: 14px 0 4px; }\n138\t.panel .note { font-size: 13px; color: #5a5156; margin-top: 8px; }\n139\t.panel .acts { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }\n140\t.panel ol, .panel ul { padding-left: 1.3em; margin: 0; font-size: 14px; }\n141\t.panel li + li { margin-top: 4px; }\n142\t.panel.rules { width: min(620px, 100%); }\n143\t.panel.shopp { width: min(700px, 100%); }\n144\t.board { list-style: none; padding: 0; margin: 4px 0 0; }\n145\t.board li { display: flex; justify-content: space-between; padding: 5px 2px; border-bottom: 1px solid #d3c7b4; font-size: 15px; font-variant-numeric: tabular-nums; }\n146\t.board li.me { color: var(--red); font-weight: 700; }\n147\t.board li.feng { color: #5a5156; }\n148\t.book { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 6px; }\n149\t.book > div { background: #e0d5c2; padding: 5px 6px; min-height: 58px; font-size: 12px; color: #5a5156; }\n150\t.cl { display: flex; gap: 3px; flex-wrap: wrap; margin-top: 3px; }\n151\t.cl i { width: 16px; height: 20px; display: block; clip-path: polygon(0 0, 100% 0, 92% 100%, 50% 88%, 8% 100%); }\n152\t.ledger { display: grid; grid-template-columns: repeat(auto-fit, minmax(92px, 1fr)); gap: 4px 12px; background: #e0d5c2; padding: 8px 10px; font-size: 13px; font-variant-numeric: tabular-nums; }\n153\t.btn { border: 1px solid var(--ink); background: var(--paper); color: var(--ink); padding: 8px 14px; cursor: pointer; min-height: 44px; }\n154\t.btn.go { background: var(--red); border-color: var(--red); color: var(--paper); }\n155\t.btn.small { min-height: 34px; padding: 3px 10px; font-size: 13px; }\n156\t.btn:focus-visible, .opt:focus-visible, .hc:focus-visible, .tool:focus-visible, .mini:focus-visible, .spc:focus-visible, .yn:focus-visible, .lookb:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }\n157\t\n158\t/* 字幕與選項 */\n159\t.talk { pointer-events: none; display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 0 4px 6px; }\n160\t/* 三級字：一級「現在做什麼」金色大字（上方 .goal、主按鈕）；二級故事米白中字（字幕）；三級說明灰色小字（.gain、小籤） */\n161\t.sub { max-width: min(42em, 100%); text-align: center; text-shadow: 0 1px 3px rgba(0, 0, 0, .9); animation: rise .5s ease both; background: linear-gradient(90deg, transparent, rgba(14, 10, 12, .82) 14%, rgba(14, 10, 12, .82) 86%, transparent); padding: 6px 56px 8px; }\n162\t.sub.n { background: none; padding: 0; }\n163\t.sub .who { display: inline-block; font-size: 12px; letter-spacing: .3em; background: var(--red); color: var(--paper); padding: 1px 8px 0; margin-bottom: 4px; text-shadow: none; }\n164\t.sub .tx { font-family: var(--display); font-size: 20px; line-height: 1.5; color: var(--paper); }\n165\t.sub .gain { display: inline-block; font-size: 13px; color: var(--paper-2); margin-top: 4px; padding: 1px 10px; background: rgba(14, 10, 12, .7); border: 1px solid rgba(236, 227, 212, .2); }\n166\t.goal { pointer-events: none; display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; font-family: var(--display); font-size: 26px; line-height: 1.3; color: #f2d48a; background: rgba(14, 10, 12, .72); padding: 2px 18px; text-shadow: 0 1px 4px #000; }\n167\t.goal b { font-weight: 400; font-size: 1.15em; color: #fff3cf; }\n168\t.goal small { font-family: var(--body); font-size: 12px; color: var(--paper-2); letter-spacing: .05em; }\n169\t.goal .fc { width: 32px; height: 32px; font-size: 18px; }\n170\t.popin { animation: popin .9s cubic-bezier(.2, 1.4, .4, 1) both; }\n171\t@keyframes popin { 0% { transform: scale(.6); opacity: 0; } 60% { transform: scale(1.06); opacity: 1; box-shadow: 0 0 0 3px #f2d48a, 0 0 30px rgba(242, 212, 138, .7); } 100% { transform: none; } }\n172\t.tool.bookb[hidden] { display: none; }\n173\t@keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }\n174\t.choices { pointer-events: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 2px 22px; min-height: 44px; }\n175\t.opt { background: rgba(14, 10, 12, .7); border: 1px solid rgba(236, 227, 212, .14); cursor: pointer; padding: 4px 14px 4px 10px; min-height: 44px; text-align: left; font-family: var(--display); font-size: 19px; color: var(--paper); text-shadow: 0 2px 8px rgba(0, 0, 0, .95); position: relative; }\n176\t.opt::before { content: \"—\"; margin-right: 8px; color: var(--red-2); }\n177\t.opt small { font-family: var(--body); font-size: 12px; color: var(--paper-2); margin-left: 8px; }\n178\t.opt:hover::after, .opt:focus-visible::after { content: \"\"; position: absolute; left: 30px; right: 0; bottom: 4px; height: 3px; background: var(--red-2); border-radius: 2px; }\n179\t.opt:disabled { opacity: .35; cursor: not-allowed; }\n180\t/* 主按鈕：這一步最該按的那個，朱紅實底、大字 */\n181\t.opt.pri { background: var(--red); border-color: #e0475a; font-size: 25px; padding: 5px 20px 5px 16px; box-shadow: 0 6px 18px rgba(0, 0, 0, .5), 0 0 0 1px rgba(242, 212, 138, .35) inset; }\n182\t.opt.pri::before { content: none; }\n183\t.opt.pri small { color: #f4d9d9; }\n184\t.opt.pri:hover::after, .opt.pri:focus-visible::after { background: #f2d48a; left: 16px; }\n185\t\n186\t/* 手牌：字要在這個大小就讀得清 */\n187\t.hand { pointer-events: auto; display: flex; justify-content: center; align-items: flex-end; overflow-x: auto; overflow-y: visible; padding: 16px 8px 2px; min-height: 0; scrollbar-width: none; }\n188\t.hand::-webkit-scrollbar { display: none; }\n189\t.hand.on { min-height: 178px; }\n190\t.hc { flex: none; border: none; background: none; padding: 0; width: 104px; height: 156px; margin: 0 -6px; position: relative; cursor: default; transition: transform .16s ease, filter .16s ease; transform-origin: 50% 120%; }\n191\t.hc img { width: 100%; height: 100%; display: block; border-radius: 7px; box-shadow: 0 6px 16px rgba(0, 0, 0, .6); }\n192\t.hc img, .spc img { -webkit-touch-callout: none; user-select: none; -webkit-user-select: none; }\n193\t.hc.play { cursor: pointer; }\n194\t.hc.play:hover, .hc.play:focus-visible { transform: translateY(-14px) rotate(0deg) !important; z-index: 5; }\n195\t/* 金框＝現在能打、該推的牌；她今晚要的牌不改樣子，只在頂上蓋一枚朱印「家」 */\n196\t.hc.hot img { box-shadow: 0 0 0 3px #f2d48a, 0 0 22px rgba(242, 212, 138, .85); }\n197\t.hc.off { filter: brightness(.48) saturate(.5); }\n198\t/* 背面是她今晚要的：牌的形狀、大小都不動，只加一圈金邊，頂上一枚「今晚要」（手牌、攤開的牌一個樣子） */\n199\t.wtag { position: absolute; left: 50%; top: -10px; z-index: 2; width: 26px; height: 26px; transform: translateX(-50%) rotate(-6deg); background: var(--red); color: #f6ecd9; font-family: var(--display); font-size: 17px; line-height: 26px; text-align: center; border-radius: 3px; box-shadow: inset 0 0 0 2px var(--red), inset 0 0 0 3px rgba(246, 236, 217, .75), 0 2px 6px rgba(0, 0, 0, .55); pointer-events: none; }\n200\t/* 牌角一小塊紅：這張推出去會被染 */\n201\t.hc .stain { position: absolute; right: 0; top: 0; width: 34px; height: 34px; border-top-right-radius: 7px; background: linear-gradient(225deg, #c21f2c 0 48%, transparent 50%); }\n202\t.hand-label { pointer-events: none; display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13px; letter-spacing: .15em; color: var(--paper); min-height: 22px; }\n203\t.hand-label .hlb { background: rgba(14, 10, 12, .72); padding: 2px 12px; }\n204\t.hand-label .mini { pointer-events: auto; }\n205\t.ghost { position: fixed; z-index: 40; pointer-events: none; border-radius: 7px; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); }\n206\t\n207\t/* 開場 */\n208\t.title { position: fixed; inset: 0; display: flex; align-items: center; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 24px; background: linear-gradient(90deg, rgba(12, 9, 11, .88) 0%, rgba(12, 9, 11, .55) 55%, rgba(12, 9, 11, .1) 100%); overflow: auto; }\n209\t.title-in { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 32px; align-items: start; max-width: 860px; margin-left: clamp(0px, 6vw, 80px); }\n210\t.vb { background: var(--red); color: var(--paper); font-family: var(--display); padding: 26px 18px; display: flex; flex-direction: column; align-items: center; gap: 18px; box-shadow: 0 0 0 3px var(--ink), 0 0 0 4px var(--red); }\n211\t.vb .t { writing-mode: vertical-rl; font-size: 88px; line-height: 1; letter-spacing: .12em; }\n212\t.vb .s { writing-mode: vertical-rl; font-size: 15px; letter-spacing: .4em; }\n213\t.intro { font-family: var(--display); font-size: 25px; line-height: 1.75; max-width: 24em; }\n214\t.lede { margin-top: 10px; color: var(--paper-2); max-width: 38em; }\n215\t.form { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-end; }\n216\t.field label { display: block; font-size: 12px; letter-spacing: .2em; color: var(--paper-2); margin-bottom: 6px; }\n217\t.field input { font: inherit; font-size: 18px; padding: 7px 12px; border: 1px solid var(--paper-2); background: rgba(236, 227, 212, .08); color: var(--paper); width: 8em; }\n218\t.title .go { font-size: 17px; }\n219\t.title .hint { margin-top: 12px; font-size: 12px; color: var(--paper-2); }\n220\t.title .tg { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 14px; color: var(--paper-2); cursor: pointer; }\n221\t.title .tg input { width: 18px; height: 18px; accent-color: var(--red); }\n222\t\n223\t/* 墨染轉場、更夫、印 */\n224\t#ink { position: fixed; inset: -10%; background: #0b0809; pointer-events: none; opacity: 0; clip-path: circle(0% at 50% 58%); filter: url(#rough); z-index: 30; }\n225\t#ink.on { opacity: 1; clip-path: circle(80% at 50% 58%); transition: clip-path .55s cubic-bezier(.6, 0, .4, 1); }\n226\t#ink.off { opacity: 0; transition: opacity .45s ease; clip-path: circle(80% at 50% 58%); }\n227\t.watch { position: fixed; inset: 0; z-index: 25; background: #070506; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 22px; padding: 24px; }\n228\t.watch .w { writing-mode: vertical-rl; font-family: var(--display); font-size: clamp(28px, 5.4vh, 42px); line-height: 1.5; letter-spacing: .14em; color: var(--paper); max-height: 62vh; animation: rise 1.2s ease both; }\n229\t.watch .w2 { color: var(--wash); font-size: 15px; letter-spacing: .2em; text-align: center; animation: rise 2s ease both; }\n230\t.watch .knock { font-size: 12px; letter-spacing: .5em; color: var(--wash); }\n231\t.watch .end { font-family: var(--display); font-size: clamp(44px, 9vh, 72px); color: var(--red-2); letter-spacing: .2em; }\n232\t.watch .sum { font-size: 13px; color: var(--wash); text-align: center; max-width: 34em; }\n233\t.watch .acts { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }\n234\t.stamp { position: fixed; left: 50%; top: 34%; z-index: 35; transform: translate(-50%, -50%) rotate(-8deg); font-family: var(--display); font-size: 46px; color: var(--red-2); border: 5px solid var(--red-2); padding: 4px 22px; letter-spacing: .2em; pointer-events: none; animation: stampin .5s cubic-bezier(.2, 1.6, .4, 1) both; text-shadow: 0 0 12px rgba(0, 0, 0, .6); }\n235\t@keyframes stampin { from { transform: translate(-50%, -50%) rotate(-8deg) scale(2.2); opacity: 0; } to { transform: translate(-50%, -50%) rotate(-8deg) scale(1); opacity: 1; } }\n236\t#fx { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 32; }\n237\t.fleck { position: absolute; top: -14px; width: 10px; height: 8px; background: var(--gold); animation: fall 1.8s ease-in forwards; }\n238\t@keyframes fall { to { transform: translateY(105vh) rotate(560deg); opacity: .1; } }\n239\t\n240\t/* 骰子 */\n241\t#dice { position: fixed; inset: 0; z-index: 36; display: flex; align-items: center; justify-content: center; pointer-events: none; }\n242\t#dice .dbox { background: rgba(18, 14, 17, .92); border: 1px solid var(--gold); padding: 16px 24px 14px; display: flex; flex-direction: column; align-items: center; gap: 10px; box-shadow: 0 12px 40px rgba(0, 0, 0, .6); min-width: 220px; max-width: calc(100vw - 32px); text-align: center; }\n243\t#dice .lb { font-size: 13px; letter-spacing: .12em; color: var(--paper-2); }\n244\t#dice .res { font-family: var(--display); font-size: 26px; min-height: 1.3em; }\n245\t#dice .res.ok { color: var(--gold); }\n246\t#dice .res.bad { color: var(--red-2); }\n247\t.die { display: inline-grid; width: 66px; height: 66px; background: #f4efe6; border-radius: 12px; grid-template: repeat(3, 1fr) / repeat(3, 1fr); padding: 9px; box-shadow: inset 0 -4px 0 #c9bca6, 0 4px 14px rgba(0, 0, 0, .5); }\n248\t.die i { width: 11px; height: 11px; border-radius: 50%; background: var(--ink); place-self: center; visibility: hidden; }\n249\t.die i.on { visibility: visible; }\n250\t.die.red i.on { background: var(--red); }\n251\t.die.spin { transform: rotate(18deg) translateY(-6px); }\n252\t.die.land { animation: land .35s cubic-bezier(.2, 1.6, .4, 1) both; }\n253\t@keyframes land { from { transform: scale(1.4) rotate(-20deg); } to { transform: none; } }\n254\t\n255\t/* 燈：吃完飯當場看到亮了還是熄了 */\n256\t#lampfb { position: fixed; inset: 0; z-index: 27; display: flex; align-items: flex-start; justify-content: center; pointer-events: none; padding: 11vh 16px 16px; }\n257\t#lampfb[hidden] { display: none; }\n258\t@media (min-width: 760px) { #lampfb { justify-content: flex-start; padding-left: max(7vw, 190px); } }\n259\t#lampfb .lf { background: rgba(14, 10, 12, .93); border: 1px solid var(--gold); padding: 16px 24px 14px; display: flex; flex-direction: column; align-items: center; gap: 6px; box-shadow: 0 14px 40px rgba(0, 0, 0, .65); max-width: min(420px, calc(100vw - 32px)); text-align: center; animation: peekIn .25s ease-out both; }\n260\t#lampfb .lf.bad { border-color: #8a4a4e; }\n261\t#lampfb .big { font-family: var(--display); font-size: clamp(30px, 5vw, 44px); line-height: 1.1; color: var(--gold); letter-spacing: .12em; }\n262\t#lampfb .lf.bad .big { color: #e6d4d6; }\n263\t#lampfb .row { font-size: 15px; color: var(--paper-2); letter-spacing: .04em; }\n264\t#lampfb .row b { font-family: var(--display); font-weight: 400; font-size: 22px; color: var(--paper); margin: 0 2px; }\n265\t#lampfb .warn { color: #ff9a8a; font-size: 14px; letter-spacing: .06em; }\n266\t#lampfb .lfok { pointer-events: auto; margin-top: 6px; min-width: 96px; }\n267\t.lampsvg { width: 150px; height: 150px; }\n268\t.lampsvg .sg { transition: fill .5s, opacity .5s; }\n269\t.lampsvg .sg.dying { animation: dying .22s steps(2) 5; }\n270\t.lampsvg .sg.lighting { animation: lighting .9s ease both; }\n271\t@keyframes dying { 50% { fill: #ffb070; } }\n272\t@keyframes lighting { from { fill: #ffe9a8; } }\n273\t.outs { display: inline-flex; gap: 3px; vertical-align: middle; }\n274\t.outs i { width: 9px; height: 9px; border-radius: 50%; border: 1px solid #c9b08c; display: inline-block; }\n275\t.outs i.on { background: #e8483e; border-color: #ff8a7a; box-shadow: 0 0 6px rgba(255, 90, 70, .7); }\n276\t.outs i.new { animation: outPop 1s ease both; }\n277\t@keyframes outPop { 0% { transform: scale(2.4); background: #ffb070; } 100% { transform: none; } }\n278\t.scars { display: inline-flex; gap: 4px; vertical-align: middle; }\n279\t.scars i { width: 3px; height: 12px; background: rgba(236, 200, 150, .25); display: inline-block; transform: rotate(14deg); }\n280\t.scars i.on { background: #ff8a7a; }\n281\t.plate .lm { margin-top: 6px; padding-top: 5px; border-top: 1px solid rgba(236, 200, 150, .2); font-size: 12px; color: #e0c98f; display: flex; flex-direction: column; gap: 3px; align-items: center; }\n282\t.plate .lm b { font-family: var(--display); font-weight: 400; font-size: 17px; }\n283\t.plate .lm .k { display: flex; align-items: center; gap: 4px; }\n284\t.plate .lm .k2 { display: flex; gap: 8px; }\n285\t.plate .lm .k.hot { color: #ff9a8a; }\n286\t.wb .exam { display: block; color: #5a5156; font-size: 11px; }\n287\t.wb .exam.bad { color: var(--red); font-weight: 700; }\n288\t.offer .bad, .shopp .bad { color: var(--red); font-weight: 700; }\n289\t.offer .ab { border-top: 1px dashed rgba(28, 23, 25, .25); padding-top: 4px; color: var(--ink); min-height: 0; }\n290\t.panel.tujian { width: min(860px, 100%); }\n291\t.panel .tabs { display: flex; gap: 6px; margin-bottom: 8px; }\n292\t.bookg { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; margin-bottom: 6px; }\n293\t.bc { border: none; background: none; padding: 0; cursor: pointer; text-align: center; font-size: 12px; color: var(--ink); }\n294\t.bc img { width: 100%; display: block; border-radius: 5px; box-shadow: 0 3px 8px rgba(0, 0, 0, .35); margin-bottom: 2px; }\n295\t.bc.un img { filter: grayscale(.9) brightness(.7); }\n296\t.bc.un span { color: #8d8487; }\n297\t.bc:hover img, .bc:focus-visible img { box-shadow: 0 0 0 3px var(--gold), 0 3px 8px rgba(0, 0, 0, .35); }\n298\t.bookd { display: flex; gap: 16px; flex-wrap: wrap; }\n299\t.bookd .faces { display: flex; gap: 8px; }\n300\t.bookd figure { margin: 0; text-align: center; font-size: 12px; color: #5a5156; }\n301\t.bookd figure img { width: 140px; display: block; border-radius: 6px; margin-bottom: 3px; }\n302\t.bookd .bt { flex: 1; min-width: 220px; }\n303\t.bookd h3 { font-family: var(--display); font-weight: 400; font-size: 30px; margin: 0; }\n304\t.bookd h3 small { display: block; font-family: var(--body); font-size: 12px; color: #5a5156; }\n305\t.bookr { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; }\n306\t.bookr li { background: #e0d5c2; padding: 8px 10px; }\n307\t.bookr li.own { box-shadow: inset 0 0 0 2px var(--gold); }\n308\t.bookr b { font-family: var(--display); font-weight: 400; font-size: 20px; margin-right: 6px; }\n309\t.bookr small { color: #5a5156; }\n310\t.bookr p { margin: 4px 0 0; font-size: 13px; }\n311\t.bookr .lore { color: #5a5156; }\n312\t.bookt { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; }\n313\t.bookt dt { font-family: var(--display); font-size: 18px; color: var(--red); }\n314\t.bookt dd { margin: 0; font-size: 14px; }\n315\t.panel .fired { color: var(--red-2); font-family: var(--display); font-size: 22px; }\n316\t.mirrorc { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin: 6px 0; }\n317\t.mirrorc figure { margin: 0; text-align: center; font-size: 12px; color: #5a5156; }\n318\t.mirrorc img { width: 86px; display: block; margin-bottom: 4px; }\n319\t\n320\t/* 最後一次卸妝 */\n321\t.lastwipe { position: fixed; inset: 0; z-index: 26; background: rgba(7, 5, 6, .9); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 16px; }\n322\t.lastwipe .face { position: relative; width: min(340px, 78vw, 54vh); aspect-ratio: 4 / 5; }\n323\t.lastwipe canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n324\t.lastwipe #paint { touch-action: none; cursor: grab; }\n325\t.lastwipe .tx { font-family: var(--display); font-size: 24px; line-height: 1.5; text-align: center; max-width: 24em; }\n326\t.lastwipe .tx2 { font-size: 14px; color: var(--paper-2); text-align: center; max-width: 30em; letter-spacing: .04em; }\n327\t.lastwipe .after { font-family: var(--display); font-size: 22px; line-height: 1.6; color: var(--paper); text-align: center; max-width: 24em; animation: rise 1.4s ease both; }\n328\t\n329\t/* 看牌：放大兩面，每面最多三行 */\n330\t#peek { position: fixed; z-index: 35; pointer-events: none; display: flex; gap: 10px; filter: drop-shadow(0 14px 30px rgba(0, 0, 0, .7)); animation: peekIn .14s ease-out both; }\n331\t#peek figure { margin: 0; width: 196px; background: var(--ink-2); border: 1px solid rgba(184, 145, 63, .45); padding: 8px 8px 10px; opacity: .78; }\n332\t#peek figure.on { opacity: 1; border-color: var(--gold); border-top: 4px solid var(--red); }\n333\t#peek img { width: 100%; aspect-ratio: 2 / 3; display: block; border-radius: 8px; }\n334\t#peek figcaption { margin-top: 7px; font-size: 14px; line-height: 1.55; color: var(--paper); }\n335\t#peek figcaption b { display: block; font-size: 12px; letter-spacing: .2em; color: var(--gold); font-weight: 400; }\n336\t@keyframes peekIn { from { opacity: 0; transform: translateY(6px); } }\n337\t\n338\t/* 教學小框：遮罩挖洞框住要看的東西 */\n339\t#coach { position: fixed; inset: 0; z-index: 34; pointer-events: none; }\n340\t#coach .dim { position: absolute; inset: 0; background: rgba(8, 6, 7, .62); }\n341\t#coach .shield { position: absolute; inset: 0; pointer-events: auto; }\n342\t#coach .ring { position: absolute; border: 2px solid var(--gold); border-radius: 8px; box-shadow: 0 0 0 4px rgba(184, 145, 63, .22), 0 0 26px rgba(216, 67, 76, .55); animation: coachPulse 1.6s ease-in-out infinite; }\n343\t#coach .ring[data-tap]::after { content: attr(data-tap); position: absolute; left: 50%; bottom: calc(100% + 8px); transform: translateX(-50%); background: var(--red); color: var(--paper); font-size: 13px; letter-spacing: .2em; padding: 2px 10px; white-space: nowrap; }\n344\t@keyframes coachPulse { 50% { box-shadow: 0 0 0 9px rgba(184, 145, 63, .1), 0 0 38px rgba(216, 67, 76, .75); } }\n345\t#coach .cbox { position: absolute; pointer-events: auto; width: min(330px, calc(100vw - 32px)); max-height: 60vh; overflow: auto; background: var(--ink-2); color: var(--paper); border: 1px solid rgba(184, 145, 63, .7); border-top: 4px solid var(--red); padding: 10px 14px 10px; box-shadow: 0 16px 44px rgba(0, 0, 0, .65); animation: rise .3s ease both; }\n346\t#coach .cbox h4 { font-family: var(--display); font-weight: 400; font-size: 23px; line-height: 1.3; margin: 0 0 3px; }\n347\t#coach .cbox .tx { font-size: 15px; line-height: 1.7; }\n348\t#coach .cbox .tx b { color: #e8cf8f; }\n349\t#coach .cbox .rule { margin: 8px 0 2px; padding: 2px 0 2px 10px; border-left: 3px solid var(--red); font-family: var(--display); font-size: 19px; line-height: 1.4; color: #f2d48a; }\n350\t#coach .fc { width: 22px; height: 22px; font-size: 15px; vertical-align: -4px; margin: 0 2px; }\n351\t#coach .cbox .row { display: flex; align-items: center; gap: 10px; margin-top: 8px; }\n352\t#coach .cbox .do { font-size: 14px; color: #e8cf8f; letter-spacing: .1em; }\n353\t#coach .cbox .skip { margin-left: auto; background: none; border: none; color: var(--paper-2); font-size: 12px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; min-height: 38px; padding: 0 4px; }\n354\t#coach .arrow { position: absolute; width: 14px; height: 14px; background: var(--ink-2); transform: rotate(45deg); }\n355\t#coach .arrow.up { top: -9px; background: var(--red); }\n356\t#coach .arrow.down { bottom: -8px; border-right: 1px solid rgba(184, 145, 63, .7); border-bottom: 1px solid rgba(184, 145, 63, .7); }\n357\t/* 做的步驟：不壓暗整個畫面，只一句話貼在要點的東西旁邊 */\n358\t#coach.doing .dim { background: rgba(8, 6, 7, .38); }\n359\t#coach.doing .cbox { width: auto; max-width: min(300px, calc(100vw - 32px)); padding: 8px 12px 6px; border-top-width: 3px; }\n360\t#coach.doing .cbox .tx { font-family: var(--display); font-size: 19px; line-height: 1.45; }\n361\t#coach.doing .cbox .row { margin-top: 2px; }\n362\t#coach.doing .cbox .do { display: none; }\n363\t#coach .cbox .step { position: absolute; right: 10px; top: 7px; font-size: 11px; letter-spacing: .1em; color: var(--paper-2); }\n364\t/* 一張牌兩面：台上面翻過來就是家裡面 */\n365\t.flip { display: flex; justify-content: center; margin: 6px 0 4px; perspective: 700px; }\n366\t.flip .fl { position: relative; width: 92px; height: 138px; transform-style: preserve-3d; animation: flip 3.6s ease-in-out infinite; }\n367\t.flip img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 6px; backface-visibility: hidden; box-shadow: 0 6px 14px rgba(0, 0, 0, .5); }\n368\t.flip img.b { transform: rotateY(180deg); }\n369\t.flip .cap { align-self: center; margin-left: 12px; font-size: 13px; line-height: 1.8; color: var(--paper-2); }\n370\t.flip .cap b { color: #f2d48a; font-weight: 400; font-family: var(--display); font-size: 16px; }\n371\t@keyframes flip { 0%, 30% { transform: rotateY(0); } 50%, 80% { transform: rotateY(180deg); } 100% { transform: rotateY(360deg); } }\n372\t/* 小提示：不擋、不用按，貼在新出現的東西旁邊，一次只有一枚 */\n373\t#nudge { position: fixed; z-index: 33; max-width: min(280px, calc(100vw - 24px)); background: rgba(22, 17, 20, .96); color: var(--paper); border-left: 3px solid #f2d48a; padding: 6px 26px 7px 10px; font-size: 14px; line-height: 1.55; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); animation: rise .3s ease both; cursor: pointer; }\n374\t#nudge b { color: #f2d48a; font-weight: 400; font-family: var(--display); font-size: 16px; display: block; }\n375\t#nudge .x { position: absolute; right: 6px; top: 3px; color: var(--paper-2); font-size: 14px; }\n376\t#nudge.out { opacity: 0; transition: opacity .4s ease; }\n377\t\n378\t/* 早上選牌：妝匣的手牌、字幕都縮小，把高度讓給桌上攤開的牌 */\n379\t.hud[data-v=\"morning\"] .hand.on { min-height: 118px; padding-top: 10px; }\n380\t.hud[data-v=\"morning\"] .hc { width: 72px; height: 108px; margin: 0 -2px; }\n381\t.hud[data-v=\"morning\"] .talk { gap: 2px; padding-bottom: 2px; }\n382\t.hud[data-v=\"morning\"] .sub .tx { font-size: 18px; line-height: 1.35; }\n383\t.hud[data-v=\"morning\"] .sub .gain { font-size: 12px; }\n384\t.hud[data-v=\"morning\"] .opt { font-size: 21px; min-height: 40px; }\n385\t.hud[data-v=\"morning\"] .choices { min-height: 40px; }\n386\t.spc .ct { min-width: 28px; height: 28px; font-size: 15px; }\n387\t/* v0.7：她的需要、情報、觀眾的話、後台、水牌小牌 */\n388\tmark.k { background: none; color: #f2d48a; border-bottom: 2px solid rgba(242, 212, 138, .75); padding: 0 1px; }\n389\t.sub mark.k { color: #f6dc96; }\n390\t.panel mark.k, .bub mark.k { color: var(--red); border-bottom-color: rgba(168, 32, 43, .6); }\n391\t.bub.intel mark.k { color: #ffe39a; border-bottom-color: #ffe39a; }\n392\t.itag { display: inline-flex; align-items: center; gap: 6px; font-family: var(--body); font-size: 13px; letter-spacing: .08em; color: #1c1719; background: #f2d48a; padding: 1px 9px; margin-top: 4px; text-shadow: none; }\n393\t.itag b { font-weight: 700; }\n394\t.itag.ev { background: var(--red-2); color: var(--paper); }\n395\t/* 情報簿：記下她（觀眾、玉樓、更夫）說過的需要 */\n396\t.intel { pointer-events: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 6px; max-width: min(640px, 100%); }\n397\t.intel .ic { display: inline-flex; align-items: center; gap: 5px; background: rgba(18, 14, 17, .78); border: 1px solid rgba(242, 212, 138, .7); padding: 1px 8px 1px 4px; font-size: 13px; color: var(--paper); white-space: nowrap; }\n398\t.intel .ic.now { border-color: #f2d48a; box-shadow: 0 0 0 1px #f2d48a inset, 0 0 12px rgba(242, 212, 138, .35); }\n399\t.intel .ic .d { color: #f2d48a; font-size: 12px; letter-spacing: .1em; }\n400\t.intel .ic svg { width: 18px; height: 18px; }\n401\t.intel .ic b { font-weight: 400; color: #f2d48a; }\n402\t.intel .lbl { font-size: 11px; letter-spacing: .3em; color: #1c1719; background: #f2d48a; padding: 1px 6px; align-self: center; }\n403\t/* 傍晚：她今晚的需要與推了幾張 */\n404\t.need { pointer-events: auto; display: flex; align-items: center; gap: 10px; background: rgba(18, 14, 17, .72); border: 1px solid rgba(242, 212, 138, .6); padding: 4px 12px 4px 6px; }\n405\t.need .lookb { width: 52px; height: 52px; }\n406\t.need .nt { font-family: var(--display); font-size: 22px; line-height: 1.2; }\n407\t.need .nt small { display: block; font-family: var(--body); font-size: 12px; color: var(--paper-2); }\n408\t.need .nr { display: flex; align-items: center; gap: 6px; font-size: 19px; line-height: 1.3; }\n409\t.need .nr svg { width: 22px; height: 22px; }\n410\t.need .nr .lkn { font-style: normal; font-size: .72em; color: var(--paper-2); }\n411\t.need .nr .hn { font-weight: 400; color: #f2d48a; }\n412\t.need .nr.ok span:first-of-type { color: #f2d48a; }\n413\t.pips { display: flex; gap: 5px; }\n414\t.pips i { width: 16px; height: 16px; border-radius: 50%; border: 2px solid #f2d48a; }\n415\t.pips i.on { background: #f2d48a; box-shadow: 0 0 10px rgba(242, 212, 138, .8); }\n416\t.need.done { border-color: #f2d48a; box-shadow: 0 0 18px rgba(242, 212, 138, .35); }\n417\t/* 傍晚的焦點就是她要什麼：放大 */\n418\t.need { padding: 6px 18px 6px 8px; }\n419\t.need .nr { font-size: 26px; }\n420\t.need .nr svg { width: 28px; height: 28px; }\n421\t.need .nr .hn { font-size: 1.15em; }\n422\t.need .nt small { font-size: 13px; }\n423\t/* 右上：水牌小牌 */\n424\t.side { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }\n425\t.wb { pointer-events: auto; text-align: right; background: linear-gradient(180deg, #e9dcc4, #d8c8aa); color: var(--ink); border: 1px solid #1d120b; padding: 4px 10px 5px; min-width: 128px; cursor: pointer; font-size: 12px; line-height: 1.45; box-shadow: 0 6px 16px rgba(0, 0, 0, .5); }\n426\t.wb b { font-family: var(--display); font-weight: 400; font-size: 20px; color: var(--red); }\n427\t.wb .gap { display: block; color: #5a5156; }\n428\t.wb .wbh { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 12px; letter-spacing: .1em; }\n429\t.wb ol { list-style: none; margin: 3px 0 2px; padding: 0; min-width: 150px; }\n430\t.wb li { display: flex; justify-content: space-between; gap: 10px; padding: 1px 6px; font-size: 13px; text-align: left; font-variant-numeric: tabular-nums; }\n431\t.wb li .n { color: #5a5156; margin-right: 4px; }\n432\t.wb li.me { background: var(--red); color: var(--paper); font-weight: 700; }\n433\t.wb li.me .n { color: #f2d48a; }\n434\t.wb li.fail { border-top: 1px dashed var(--red); }\n435\t.wb .dif { font-size: 11px; color: #5a5156; display: block; text-align: right; }\n436\t\n437\t/* 觀眾的話：對白框貼著剪紙頭頂 */\n438\t#talkb { position: fixed; inset: 0; pointer-events: none; z-index: 31; }\n439\t.bub { position: absolute; width: max-content; max-width: min(250px, 42vw); background: var(--paper); color: var(--ink); font-family: var(--display); font-size: 18px; line-height: 1.4; padding: 6px 12px 7px; border-radius: 12px; box-shadow: 0 8px 22px rgba(0, 0, 0, .55); transform: translate(-50%, -100%); animation: bubIn .28s cubic-bezier(.2, 1.4, .4, 1) both; }\n440\t.bub::after { content: \"\"; position: absolute; left: var(--ax, 50%); bottom: -9px; width: 16px; height: 16px; background: inherit; transform: translateX(-50%) rotate(45deg); border-radius: 3px; }\n441\t.bub.out { animation: bubOut .35s ease both; }\n442\t.bub .tg { display: block; font-family: var(--body); font-size: 11px; letter-spacing: .3em; margin-bottom: 1px; }\n443\t.bub.intel { background: #1c1417; color: var(--paper); border: 2px solid #f2d48a; box-shadow: 0 0 0 4px rgba(242, 212, 138, .2), 0 0 28px rgba(242, 212, 138, .55), 0 10px 26px rgba(0, 0, 0, .6); font-size: 19px; max-width: min(300px, 46vw); }\n444\t.bub.intel::after { background: #f2d48a; }\n445\t.bub.intel .tg { color: #f2d48a; }\n446\t.bub.ev { background: #f3e6e2; border: 2px solid var(--red-2); }\n447\t.bub.ev .tg { color: var(--red); }\n448\t.bub.boo { background: #3a2a2c; color: #f0d6d6; }\n449\t@keyframes bubIn { from { opacity: 0; transform: translate(-50%, -80%) scale(.7); } to { opacity: 1; transform: translate(-50%, -100%); } }\n450\t@keyframes bubOut { to { opacity: 0; transform: translate(-50%, -115%); } }\n451\t/* 後台 */\n452\t.shop { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 8px; }\n453\t.offer { background: #e0d5c2; padding: 8px; display: flex; flex-direction: column; gap: 6px; align-items: center; text-align: center; }\n454\t.offer img { width: 96px; height: 144px; border-radius: 6px; box-shadow: 0 4px 10px rgba(0, 0, 0, .35); }\n455\t.offer .kw { font-size: 12px; color: #3b3337; line-height: 1.5; min-height: 3em; }\n456\t.offer .pr { font-family: var(--display); font-size: 20px; color: var(--red); }\n457\t.offer.sold { opacity: .5; }\n458\t.offer .pv { font-size: 13px; color: var(--red); min-height: 2.6em; }\n459\t.offer .pv b { font-size: 16px; }\n460\t.offer.isrel { background: #ead9b8; box-shadow: inset 0 0 0 2px #b8913f; }\n461\t.relic { width: 96px; height: 144px; display: flex; align-items: center; justify-content: center; font-family: var(--display); font-size: 64px; color: #f2d48a; background: radial-gradient(circle at 50% 42%, #7d1219 0 38%, #3d0a0e 39% 41%, #1c1417 42%); border: 3px double #b8913f; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, .35); }\n462\t.relics { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 3px; max-width: 150px; }\n463\t.relics .rel { pointer-events: auto; font-family: var(--display); font-size: 15px; color: #f2d48a; background: #5e0f15; border: 1px solid #b8913f; padding: 1px 6px; cursor: help; min-height: 28px; }\n464\t.relics .rel:hover, .relics .rel:focus-visible { background: #7a1620; outline: none; box-shadow: 0 0 0 2px #f2d48a; }\n465\t#tip { position: fixed; z-index: 70; max-width: 280px; background: #1c1719; color: var(--paper); border: 1px solid var(--gold); padding: 8px 11px 9px; font-size: 13px; line-height: 1.55; pointer-events: none; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); }\n466\t#tip b { display: block; font-family: var(--display); font-weight: 400; font-size: 18px; color: #f2d48a; margin-bottom: 2px; }\n467\t.term { font-style: normal; border-bottom: 1px dashed currentColor; cursor: help; pointer-events: auto; }\n468\t#anchors div { position: fixed; pointer-events: none; }\n469\t.purse { display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; color: #3b3337; }\n470\t.purse b { font-family: var(--display); font-weight: 400; font-size: 22px; color: var(--red); margin-left: 4px; }\n471\t.tips li { font-size: 14px; }\n472\t@media (max-width: 760px) {\n473\t  .bub { font-size: 15px; max-width: 46vw; }\n474\t  .hud[data-v=\"morning\"] .hc { width: 54px; height: 81px; margin: 0 -2px; }\n475\t  .hud[data-v=\"morning\"] .hand.on { min-height: 92px; }\n476\t  /* 早上手牌就是妝匣，窄螢幕上不再疊一排小格子 */\n477\t  .bub.intel { font-size: 15px; max-width: 62vw; }\n478\t  .need .nt { font-size: 17px; }\n479\t  .need { gap: 6px; padding: 3px 8px 3px 4px; }\n480\t  .wb { min-width: 0; padding: 3px 7px; }\n481\t  .wb b { font-size: 16px; }\n482\t  .intel .ic { font-size: 12px; }\n483\t  .need .nt { font-size: 18px; }\n484\t}\n485\t\n486\t@media (prefers-reduced-motion: reduce) {\n487\t  .fleck { display: none; }\n488\t  .sub, .watch .w, .watch .w2, .stamp, #peek, #coach .ring, #coach .cbox, .nx, .bub, .bub.intel, #combo .cb, #combo .cs, .gainf { animation: none; }\n489\t  #ink.on { transition-duration: .01s; }\n490\t}\n491\t@media (max-width: 760px) {\n492\t  .plate { min-width: 92px; padding: 5px 8px 6px; }\n493\t  .plate .lm { gap: 1px; margin-top: 3px; padding-top: 3px; }\n494\t  .plate .lm .k2 { flex-direction: column; gap: 1px; align-items: center; }\n495\t  .plate .lm b { font-size: 15px; }\n496\t  .outs { gap: 2px; }\n497\t  .outs i { width: 7px; height: 7px; }\n498\t  .need .lookb { width: 36px; height: 36px; }\n499\t  .need .nr { font-size: 16px; white-space: nowrap; gap: 4px; }\n500\t  .need .nr .lkn { display: none; }\n501\t  .need .nt small { font-size: 11px; }\n502\t  .wb .exam { font-size: 10px; max-width: 9.5em; margin-left: auto; line-height: 1.3; }\n503\t  .plate .d { font-size: 17px; }\n504\t  .plate .g b { font-size: 17px; }\n505\t  /* 手機：家那一塊壓成一條，放在上面那排底下 */\n506\t  .leftcol { bottom: auto; left: 8px; width: auto; max-width: calc(100vw - 16px); flex-direction: row; align-items: stretch; gap: 4px; }\n507\t  .homep { display: flex; align-items: center; gap: 10px; padding: 3px 8px; }\n508\t  .homep .hh { display: none; }\n509\t  .homep .hl { gap: 4px; }\n510\t  .homep .hrow { margin-top: 0; }\n511\t  .tool.bookb { width: auto; }\n512\t  .wb ol { min-width: 0; margin: 1px 0; }\n513\t  .wb li:not(.me) { display: none; }\n514\t  .wb li { font-size: 12px; padding: 0 4px; }\n515\t  .wb .wbh { font-size: 11px; }\n516\t  .tools .tool { padding: 4px 8px; }\n517\t  .homep .hl .lampsvg { width: 28px; height: 28px; }\n518\t  .homep .hl b { font-size: 20px; }\n519\t  .homep .hl small { display: none; }\n520\t  .homep .hrow em { display: none; }\n521\t  .homep .outs i { width: 9px; height: 9px; }\n522\t  .tool.bookb small { display: none; }\n523\t  .slot { height: 28px; font-size: 12px; }\n524\t  .pl { width: 42px; height: 38px; font-size: 14px; }\n525\t  /* 手機：上面那一排放不下三樣，中間那塊（連擊、情報、她的需要）折到第二行 */\n526\t  .top { flex-wrap: wrap; row-gap: 4px; }\n527\t  .topmid { order: 3; flex-basis: 100%; }\n528\t  .lk { width: 8px; }\n529\t  .hand.on { min-height: 128px; }\n530\t  .hc { width: 72px; height: 108px; margin: 0 -4px; }\n531\t  .hc .stain { width: 24px; height: 24px; }\n532\t  .spread { padding: 6px; gap: 6px; }\n533\t  .sub .tx { font-size: 19px; }\n534\t  .sub .gain { font-size: 12px; }\n535\t  .opt { font-size: 20px; }\n536\t  .talk { padding-bottom: 38px; }\n537\t  .title-in { grid-template-columns: minmax(0, 1fr); gap: 18px; margin-left: 0; }\n538\t  .vb { flex-direction: row; justify-content: center; padding: 14px; }\n539\t  .vb .t { writing-mode: horizontal-tb; font-size: 54px; }\n540\t  .vb .s { writing-mode: horizontal-tb; letter-spacing: .2em; }\n541\t  .intro { font-size: 20px; }\n542\t  .title { align-items: flex-start; background: rgba(12, 9, 11, .8); }\n543\t  #peek { gap: 6px; }\n544\t  #peek figure { width: calc((100vw - 38px) / 2); padding: 5px 5px 7px; }\n545\t  #peek img { width: 70%; margin: 0 auto; }\n546\t  #peek figcaption { font-size: 12px; }\n547\t}\n548\t</style>\n549\t\n550\t<canvas id=\"gl\" aria-hidden=\"true\"></canvas>\n551\t<canvas id=\"smear\" aria-hidden=\"true\"></canvas>\n552\t<div id=\"vig\" aria-hidden=\"true\"></div>\n553\t<div id=\"grain\" aria-hidden=\"true\"></div>\n554\t<canvas id=\"stagefx\" aria-hidden=\"true\"></canvas>\n555\t<div id=\"combo\" aria-hidden=\"true\"></div>\n556\t<div class=\"hud\" id=\"hud\" hidden>\n557\t  <div class=\"top\">\n558\t    <div class=\"plate\" id=\"plate\"></div>\n559\t    <div class=\"topmid\" id=\"topmid\"></div>\n560\t    <div class=\"side\"><div class=\"tools\"><button class=\"tool\" data-act=\"music\" id=\"musicBtn\" aria-pressed=\"false\">乐</button><button class=\"tool\" data-act=\"rules\">规矩</button></div><div id=\"wboard\"></div></div>\n561\t  </div>\n562\t  <div class=\"leftcol\" id=\"leftcol\"><div class=\"homep\" id=\"homep\"></div><button class=\"tool bookb\" data-act=\"book\" id=\"bookBtn\">图鉴</button></div>\n563\t  <div class=\"mid\" id=\"mid\"></div>\n564\t  <div class=\"talk\"><div id=\"sub\"></div><div class=\"choices\" id=\"choices\"></div></div>\n565\t  <div class=\"hand\" id=\"hand\"></div>\n566\t  <div class=\"hand-label\" id=\"handLabel\"></div>\n567\t</div>\n568\t<div id=\"title\" class=\"title\" hidden></div>\n569\t<div id=\"watch\" class=\"watch\" hidden></div>\n570\t<div id=\"wipe\" class=\"lastwipe\" hidden></div>\n571\t<div id=\"ink\" aria-hidden=\"true\"></div>\n572\t<div id=\"fx\" aria-hidden=\"true\"></div>\n573\t<div id=\"talkb\" aria-live=\"polite\"></div>\n574\t<div id=\"dice\" hidden></div>\n575\t<div id=\"lampfb\" hidden aria-live=\"polite\"></div>\n576\t<div id=\"coach\" hidden></div>\n577\t<div id=\"peek\" hidden aria-hidden=\"true\"></div>\n578\t<div id=\"tip\" hidden role=\"tooltip\"></div>\n579\t<div id=\"anchors\" aria-hidden=\"true\"></div>\n580\t<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><filter id=\"rough\"><feTurbulence type=\"fractalNoise\" baseFrequency=\".02\" numOctaves=\"3\" seed=\"7\"/><feDisplacementMap in=\"SourceGraphic\" scale=\"70\"/></filter></svg>\n581\t\n582\t<script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>"}]},"parent_tool_use_id":null,"session_id":"5e9394c0-ca93-4be2-9c50-fc1d55a10765","uuid":"759f9b72-fbd2-4873-9055-5764a4de2224","timestamp":"2026-11-12T04:28:16.736Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.5/index.html","content":"<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>底色·戏城 多样版</title>\n<meta name=\"claude:viewport-fit-sides\" content=\"cover\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;700&display=swap\">\n<style>\n/* 版面：一張 3D 的戲班桌子墊底，牌和字用 2D 浮在上面。沒有血條：金、燈、痕、底色都擺在桌上看。 */\n:root {\n  color-scheme: dark;\n  --ink: #120e11;\n  --ink-2: #1a1417;\n  --paper: #ece3d4;\n  --paper-2: #d6cab6;\n  --wash: #8d8487;\n  --red: #a8202b;\n  --red-2: #d8434c;\n  --gold: #b8913f;\n  --wood: #4a2f1e;\n  --display: \"Ma Shan Zheng\", \"Kaiti SC\", \"STKaiti\", \"KaiTi\", serif;\n  --body: \"Noto Serif SC\", \"Songti SC\", \"SimSun\", serif;\n}\n* { box-sizing: border-box; }\n[hidden] { display: none !important; }\nhtml, body { height: 100%; }\nbody { margin: 0; background: var(--ink); color: var(--paper); font-family: var(--body); font-size: 15px; line-height: 1.6; overflow: hidden; -webkit-tap-highlight-color: transparent; }\nbutton { font: inherit; color: inherit; }\np { margin: 0; }\n#gl, #smear, #vig, #grain, #stagefx { position: fixed; inset: 0; width: 100%; height: 100%; }\n#stagefx { pointer-events: none; }\n/* 連擊的大字：墨書蓋上來，一會兒就散 */\n#combo { position: fixed; left: 50%; top: 30%; transform: translate(-50%, -50%); pointer-events: none; z-index: 29; text-align: center; }\n#combo .cb { font-family: var(--display); font-size: clamp(44px, 8vw, 96px); line-height: 1; letter-spacing: .12em; color: #f6dc96; text-shadow: 0 0 2px #3a0a0e, 0 4px 0 #7d1219, 0 0 30px rgba(242, 212, 138, .7); animation: cbIn 1.5s cubic-bezier(.2, 1.4, .4, 1) both; white-space: nowrap; }\n#combo .cb.big { color: #fff1c8; font-size: clamp(56px, 10vw, 124px); text-shadow: 0 0 2px #3a0a0e, 0 5px 0 #a8202b, 0 0 46px rgba(255, 200, 120, .95); }\n#combo .cb.bad { color: #c9c0c2; text-shadow: 0 3px 0 #1c1719, 0 0 18px rgba(0, 0, 0, .8); font-size: clamp(36px, 6vw, 70px); }\n#combo .cb.slow, #combo .cb.slow + .cs { animation-duration: 3.6s; }\n#combo .cs { font-family: var(--body); font-size: 16px; letter-spacing: .3em; color: #f2d48a; text-shadow: 0 2px 6px #000; animation: cbIn 1.5s ease both; }\n@keyframes cbIn { 0% { opacity: 0; transform: scale(2.2) rotate(-6deg); filter: blur(6px); } 14% { opacity: 1; transform: scale(.94) rotate(-2deg); filter: none; } 22% { transform: scale(1) rotate(-2deg); } 78% { opacity: 1; } 100% { opacity: 0; transform: translateY(-24px) rotate(-2deg); } }\n.gainf { position: fixed; z-index: 30; pointer-events: none; font-family: var(--display); font-size: 34px; color: #f6dc96; text-shadow: 0 2px 0 #7d1219, 0 0 14px rgba(242, 212, 138, .8); transform: translate(-50%, -50%); animation: gainUp 1.2s ease-out both; }\n.gainf.bad { color: #d8c6c8; text-shadow: 0 2px 0 #1c1719; }\n@keyframes gainUp { from { opacity: 0; transform: translate(-50%, -20%) scale(.6); } 20% { opacity: 1; transform: translate(-50%, -60%) scale(1.15); } to { opacity: 0; transform: translate(-50%, -190%) scale(1); } }\n.bub.intel { animation: bubIn .28s cubic-bezier(.2, 1.4, .4, 1) both, intelGlow 1.6s ease-in-out .3s infinite; }\n@keyframes intelGlow { 50% { box-shadow: 0 0 0 7px rgba(242, 212, 138, .28), 0 0 40px rgba(242, 212, 138, .85), 0 10px 26px rgba(0, 0, 0, .6); } }\n#gl { display: block; }\n#smear, #vig, #grain { pointer-events: none; }\n#vig { background: radial-gradient(ellipse at 50% 42%, transparent 55%, rgba(8, 6, 7, .72) 100%); }\n#grain { opacity: .18; mix-blend-mode: overlay; background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .55  0 0 0 0 .5  0 0 0 0 .45  0 0 0 1 0'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>\"); }\n\n/* 浮層 */\n.hud { position: fixed; inset: 0; pointer-events: none; display: flex; flex-direction: column; padding-block: max(12px, env(safe-area-inset-top, 0px)) max(8px, env(safe-area-inset-bottom, 0px)); padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }\n.top { display: flex; align-items: flex-start; gap: 12px; }\n/* 木牌：第幾天、起手族、金箔 */\n.plate { flex: none; min-width: 112px; background: linear-gradient(180deg, #5c3b25, #3d2717); border: 1px solid #1d120b; box-shadow: inset 0 0 0 2px rgba(236, 200, 150, .14), 0 6px 18px rgba(0, 0, 0, .55); padding: 7px 12px 8px; color: #f0e2c8; text-align: center; }\n.plate .d { font-family: var(--display); font-size: 21px; line-height: 1.15; }\n.plate .a { font-size: 11px; letter-spacing: .25em; color: #c9b08c; }\n.plate .st { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 4px; font-size: 12px; letter-spacing: .1em; }\n.plate .g { margin-top: 4px; font-size: 12px; color: #e0c98f; font-variant-numeric: tabular-nums; }\n.plate .g b { font-family: var(--display); font-weight: 400; font-size: 20px; margin-left: 4px; }\n.fc { font-style: normal; display: inline-flex; width: 26px; height: 26px; border-radius: 50%; align-items: center; justify-content: center; font-family: var(--display); font-size: 17px; line-height: 1; color: var(--paper); border: 1px solid rgba(236, 227, 212, .75); flex: none; }\n.topmid { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 4px; }\n.side { flex: none; pointer-events: auto; }\n.tool { white-space: nowrap; background: rgba(18, 14, 17, .6); border: 1px solid rgba(236, 227, 212, .35); color: var(--paper); padding: 3px 10px; font-size: 12px; cursor: pointer; min-height: 30px; }\n\n/* 妝匣：10 個格子，異常出現在這裡 */\n/* 左欄：家（燈、熄、痕）和圖鑑 */\n.leftcol { position: absolute; left: max(16px, env(safe-area-inset-left, 0px)); top: 158px; width: 156px; display: flex; flex-direction: column; gap: 8px; pointer-events: auto; }\n.homep { background: linear-gradient(180deg, #efe6d6, #dccfb6); color: var(--ink); border: 1px solid #1d120b; box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .35), 0 6px 18px rgba(0, 0, 0, .55); padding: 5px 9px 8px; }\n.homep[hidden] { display: none; }\n.homep .hh { display: flex; justify-content: space-between; align-items: baseline; font-size: 11px; letter-spacing: .25em; color: #8a2a2a; border-bottom: 1px solid rgba(28, 23, 25, .2); padding-bottom: 2px; margin-bottom: 4px; }\n.homep .hh span:last-child { letter-spacing: .05em; color: #5a5156; }\n.homep .hl { display: flex; align-items: center; gap: 8px; }\n.homep .hl .lampsvg { width: 58px; height: 58px; flex: none; }\n.homep .hl b { font-family: var(--display); font-weight: 400; font-size: 32px; line-height: 1; color: var(--red); }\n.homep .hl small { display: block; font-size: 11px; color: #5a5156; line-height: 1.35; }\n.homep .hrow { display: flex; align-items: center; gap: 6px; margin-top: 5px; font-size: 12px; }\n.homep .hrow .k { font-family: var(--display); font-size: 17px; width: 1.1em; }\n.homep .hrow em { font-style: normal; font-size: 11px; color: #5a5156; margin-left: auto; white-space: nowrap; }\n.homep .hrow.hot em { color: var(--red); font-weight: 700; }\n.homep .outs { gap: 3px; }\n.homep .outs i { width: 12px; height: 12px; border-color: #6a5f62; }\n.homep .scars { gap: 5px; }\n.homep .scars i { width: 4px; height: 16px; background: rgba(28, 23, 25, .16); }\n.homep .scars i.on { background: var(--red); }\n.hud[data-v=\"morning\"] .homep:not(.warn), .hud[data-v=\"stage\"] .homep:not(.warn), .hud[data-v=\"door\"] .wb, .hud[data-v=\"evening\"] .wb, .hud[data-v=\"night\"] .wb, .hud[data-v=\"evening\"] .relics, .hud[data-v=\"night\"] .relics { opacity: .5; transition: opacity .2s; }\n.hud .homep:hover, .hud .wb:hover, .hud .wb:focus-visible, .hud .relics:hover { opacity: 1; }\n.homep.warn { box-shadow: 0 0 0 2px var(--red), 0 0 20px rgba(200, 40, 58, .55), 0 6px 18px rgba(0, 0, 0, .55); animation: warnP 1.8s ease-in-out infinite; }\n@keyframes warnP { 50% { box-shadow: 0 0 0 2px var(--red), 0 0 6px rgba(200, 40, 58, .3), 0 6px 18px rgba(0, 0, 0, .55); } }\n.tool.bookb { width: 100%; text-align: left; display: flex; justify-content: space-between; align-items: center; }\n.tool.bookb small { font-size: 11px; color: var(--paper-2); }\n.tools { display: flex; gap: 6px; justify-content: flex-end; }\n\n.mid { flex: 1; min-height: 0; position: relative; }\n/* 白天：這一場出過的牌與連擊 */\n.chain { pointer-events: none; display: flex; flex-direction: column; align-items: center; gap: 3px; }\n.played { display: flex; align-items: center; gap: 2px; }\n.pl { width: 56px; height: 42px; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1; font-family: var(--display); font-size: 16px; color: var(--paper); border: 1px solid rgba(236, 227, 212, .35); }\n.pl small { font-family: var(--body); font-size: 11px; color: #f4dfa8; font-variant-numeric: tabular-nums; }\n.pl.no { background: rgba(18, 14, 17, .45); border-style: dashed; }\n.lk { width: 12px; text-align: center; font-size: 12px; color: var(--gold); }\n.lk.x { color: var(--red-2); }\n.nowline { display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 2px 18px; background: rgba(14, 10, 12, .72); font-family: var(--display); font-size: 24px; color: #f2d48a; text-shadow: 0 1px 4px #000; }\n.nowline .fc { width: 32px; height: 32px; font-size: 18px; }\n.nowline small { font-family: var(--body); font-size: 12px; color: var(--paper-2); }\n.nowline b { font-family: var(--display); font-weight: 400; font-size: 20px; color: var(--gold); }\n.nowline .bad { color: var(--red-2); }\n.nx { animation: nxflash .9s ease-in-out infinite; }\n@keyframes nxflash { 50% { box-shadow: 0 0 0 5px rgba(236, 227, 212, .28), 0 0 14px rgba(236, 227, 212, .6); } }\n/* 她的樣子：畫面為主，放大（滑過、聚焦或點開）才附文字 */\n.lookb { pointer-events: auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: rgba(18, 14, 17, .62); border: 1px solid rgba(236, 227, 212, .35); border-radius: 50%; width: 58px; height: 58px; color: var(--paper); cursor: zoom-in; transition: width .2s ease, height .2s ease; }\n.lookb svg { width: 32px; height: 32px; }\n.lookb .lb { display: none; font-family: var(--display); font-size: 16px; line-height: 1; }\n.lookb:hover, .lookb:focus-visible, .lookb[aria-expanded=\"true\"] { width: 80px; height: 80px; }\n.lookb:hover .lb, .lookb:focus-visible .lb, .lookb[aria-expanded=\"true\"] .lb { display: block; }\n\n/* 早上：桌上攤開的卡組，點一張放進妝匣 */\n.spread { pointer-events: auto; position: absolute; left: 50%; top: 2px; transform: translateX(-50%); display: grid; grid-template-columns: repeat(var(--cols, 4), auto); gap: 8px 10px; background: rgba(18, 14, 17, .72); border: 1px solid rgba(236, 227, 212, .22); padding: 10px 12px; max-height: 100%; overflow: auto; }\n.spc { position: relative; width: var(--cw, 84px); height: var(--chh, 126px); border: none; background: none; padding: 0; cursor: pointer; transition: transform .15s ease; }\n.spc img { width: 100%; height: 100%; display: block; border-radius: 6px; }\n.spread .sph { grid-column: 1 / -1; font-size: 12px; letter-spacing: .2em; color: var(--paper-2); margin: -2px 0 2px; }\n.spc:hover:not(:disabled), .spc:focus-visible { transform: translateY(-4px); }\n.spc:disabled { cursor: default; filter: brightness(.42) saturate(.5); }\n.spc .ct { position: absolute; right: -5px; top: -5px; min-width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--ink); border: 1px solid var(--gold); font-size: 13px; font-variant-numeric: tabular-nums; }\n.tools2 { grid-column: 1 / -1; display: flex; gap: 8px; justify-content: center; }\n.mini { border: 1px solid rgba(236, 227, 212, .45); background: transparent; color: var(--paper); font-size: 12px; padding: 3px 10px; min-height: 32px; cursor: pointer; }\n.mini:disabled { opacity: .35; cursor: not-allowed; }\n.yuan { pointer-events: auto; position: absolute; left: 50%; top: 2px; transform: translateX(-50%); width: min(620px, 100%); background: rgba(18, 14, 17, .78); border: 1px solid rgba(184, 145, 63, .6); padding: 10px 12px; }\n.yuan h3 { font-family: var(--display); font-weight: 400; font-size: 24px; margin: 0 0 8px; text-align: center; }\n.yuan .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }\n.yn { border: 1px solid rgba(236, 227, 212, .45); background: transparent; color: var(--paper); text-align: left; padding: 8px 10px; cursor: pointer; font-family: var(--display); font-size: 20px; line-height: 1.3; }\n.yn small { display: block; font-family: var(--body); font-size: 12px; color: var(--paper-2); }\n.yn[aria-pressed=\"true\"] { background: var(--red); border-color: var(--red); }\n\n/* 紙：水牌、規矩 */\n.panel { pointer-events: auto; position: absolute; left: 50%; top: 4px; transform: translateX(-50%); width: min(520px, 100%); max-height: calc(100% - 8px); overflow: auto; background: var(--paper); color: var(--ink); padding: 14px 18px 16px; border-top: 6px solid var(--red); box-shadow: 0 12px 40px rgba(0, 0, 0, .55); }\n.panel h2 { font-family: var(--display); font-weight: 400; font-size: 30px; margin: 0 0 6px; letter-spacing: .08em; }\n.panel h4 { font-family: var(--display); font-weight: 400; font-size: 20px; margin: 14px 0 4px; }\n.panel .note { font-size: 13px; color: #5a5156; margin-top: 8px; }\n.panel .acts { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }\n.panel ol, .panel ul { padding-left: 1.3em; margin: 0; font-size: 14px; }\n.panel li + li { margin-top: 4px; }\n.panel.rules { width: min(620px, 100%); }\n.panel.shopp { width: min(700px, 100%); }\n.board { list-style: none; padding: 0; margin: 4px 0 0; }\n.board li { display: flex; justify-content: space-between; padding: 5px 2px; border-bottom: 1px solid #d3c7b4; font-size: 15px; font-variant-numeric: tabular-nums; }\n.board li.me { color: var(--red); font-weight: 700; }\n.board li.feng { color: #5a5156; }\n.book { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 6px; }\n.book > div { background: #e0d5c2; padding: 5px 6px; min-height: 58px; font-size: 12px; color: #5a5156; }\n.cl { display: flex; gap: 3px; flex-wrap: wrap; margin-top: 3px; }\n.cl i { width: 16px; height: 20px; display: block; clip-path: polygon(0 0, 100% 0, 92% 100%, 50% 88%, 8% 100%); }\n.ledger { display: grid; grid-template-columns: repeat(auto-fit, minmax(92px, 1fr)); gap: 4px 12px; background: #e0d5c2; padding: 8px 10px; font-size: 13px; font-variant-numeric: tabular-nums; }\n.btn { border: 1px solid var(--ink); background: var(--paper); color: var(--ink); padding: 8px 14px; cursor: pointer; min-height: 44px; }\n.btn.go { background: var(--red); border-color: var(--red); color: var(--paper); }\n.btn.small { min-height: 34px; padding: 3px 10px; font-size: 13px; }\n.btn:focus-visible, .opt:focus-visible, .hc:focus-visible, .tool:focus-visible, .mini:focus-visible, .spc:focus-visible, .yn:focus-visible, .lookb:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }\n\n/* 字幕與選項 */\n.talk { pointer-events: none; display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 0 4px 6px; }\n/* 三級字：一級「現在做什麼」金色大字（上方 .goal、主按鈕）；二級故事米白中字（字幕）；三級說明灰色小字（.gain、小籤） */\n.sub { max-width: min(42em, 100%); text-align: center; text-shadow: 0 1px 3px rgba(0, 0, 0, .9); animation: rise .5s ease both; background: linear-gradient(90deg, transparent, rgba(14, 10, 12, .82) 14%, rgba(14, 10, 12, .82) 86%, transparent); padding: 6px 56px 8px; }\n.sub.n { background: none; padding: 0; }\n.sub .who { display: inline-block; font-size: 12px; letter-spacing: .3em; background: var(--red); color: var(--paper); padding: 1px 8px 0; margin-bottom: 4px; text-shadow: none; }\n.sub .tx { font-family: var(--display); font-size: 20px; line-height: 1.5; color: var(--paper); }\n.sub .gain { display: inline-block; font-size: 13px; color: var(--paper-2); margin-top: 4px; padding: 1px 10px; background: rgba(14, 10, 12, .7); border: 1px solid rgba(236, 227, 212, .2); }\n.goal { pointer-events: none; display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; font-family: var(--display); font-size: 26px; line-height: 1.3; color: #f2d48a; background: rgba(14, 10, 12, .72); padding: 2px 18px; text-shadow: 0 1px 4px #000; }\n.goal b { font-weight: 400; font-size: 1.15em; color: #fff3cf; }\n.goal small { font-family: var(--body); font-size: 12px; color: var(--paper-2); letter-spacing: .05em; }\n.goal .fc { width: 32px; height: 32px; font-size: 18px; }\n.popin { animation: popin .9s cubic-bezier(.2, 1.4, .4, 1) both; }\n@keyframes popin { 0% { transform: scale(.6); opacity: 0; } 60% { transform: scale(1.06); opacity: 1; box-shadow: 0 0 0 3px #f2d48a, 0 0 30px rgba(242, 212, 138, .7); } 100% { transform: none; } }\n.tool.bookb[hidden] { display: none; }\n@keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }\n.choices { pointer-events: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 2px 22px; min-height: 44px; }\n.opt { background: rgba(14, 10, 12, .7); border: 1px solid rgba(236, 227, 212, .14); cursor: pointer; padding: 4px 14px 4px 10px; min-height: 44px; text-align: left; font-family: var(--display); font-size: 19px; color: var(--paper); text-shadow: 0 2px 8px rgba(0, 0, 0, .95); position: relative; }\n.opt::before { content: \"—\"; margin-right: 8px; color: var(--red-2); }\n.opt small { font-family: var(--body); font-size: 12px; color: var(--paper-2); margin-left: 8px; }\n.opt:hover::after, .opt:focus-visible::after { content: \"\"; position: absolute; left: 30px; right: 0; bottom: 4px; height: 3px; background: var(--red-2); border-radius: 2px; }\n.opt:disabled { opacity: .35; cursor: not-allowed; }\n/* 主按鈕：這一步最該按的那個，朱紅實底、大字 */\n.opt.pri { background: var(--red); border-color: #e0475a; font-size: 25px; padding: 5px 20px 5px 16px; box-shadow: 0 6px 18px rgba(0, 0, 0, .5), 0 0 0 1px rgba(242, 212, 138, .35) inset; }\n.opt.pri::before { content: none; }\n.opt.pri small { color: #f4d9d9; }\n.opt.pri:hover::after, .opt.pri:focus-visible::after { background: #f2d48a; left: 16px; }\n\n/* 手牌：字要在這個大小就讀得清 */\n.hand { pointer-events: auto; display: flex; justify-content: center; align-items: flex-end; overflow-x: auto; overflow-y: visible; padding: 16px 8px 2px; min-height: 0; scrollbar-width: none; }\n.hand::-webkit-scrollbar { display: none; }\n.hand.on { min-height: 178px; }\n.hc { flex: none; border: none; background: none; padding: 0; width: 104px; height: 156px; margin: 0 -6px; position: relative; cursor: default; transition: transform .16s ease, filter .16s ease; transform-origin: 50% 120%; }\n.hc img { width: 100%; height: 100%; display: block; border-radius: 7px; box-shadow: 0 6px 16px rgba(0, 0, 0, .6); }\n.hc img, .spc img { -webkit-touch-callout: none; user-select: none; -webkit-user-select: none; }\n.hc.play { cursor: pointer; }\n.hc.play:hover, .hc.play:focus-visible { transform: translateY(-14px) rotate(0deg) !important; z-index: 5; }\n/* 金框＝現在能打、該推的牌；她今晚要的牌不改樣子，只在頂上蓋一枚朱印「家」 */\n.hc.hot img { box-shadow: 0 0 0 3px #f2d48a, 0 0 22px rgba(242, 212, 138, .85); }\n.hc.off { filter: brightness(.48) saturate(.5); }\n/* 背面是她今晚要的：牌的形狀、大小都不動，只加一圈金邊，頂上一枚「今晚要」（手牌、攤開的牌一個樣子） */\n.wtag { position: absolute; left: 50%; top: -10px; z-index: 2; width: 26px; height: 26px; transform: translateX(-50%) rotate(-6deg); background: var(--red); color: #f6ecd9; font-family: var(--display); font-size: 17px; line-height: 26px; text-align: center; border-radius: 3px; box-shadow: inset 0 0 0 2px var(--red), inset 0 0 0 3px rgba(246, 236, 217, .75), 0 2px 6px rgba(0, 0, 0, .55); pointer-events: none; }\n/* 牌角一小塊紅：這張推出去會被染 */\n.hc .stain { position: absolute; right: 0; top: 0; width: 34px; height: 34px; border-top-right-radius: 7px; background: linear-gradient(225deg, #c21f2c 0 48%, transparent 50%); }\n.hand-label { pointer-events: none; display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13px; letter-spacing: .15em; color: var(--paper); min-height: 22px; }\n.hand-label .hlb { background: rgba(14, 10, 12, .72); padding: 2px 12px; }\n.hand-label .mini { pointer-events: auto; }\n.ghost { position: fixed; z-index: 40; pointer-events: none; border-radius: 7px; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); }\n\n/* 開場 */\n.title { position: fixed; inset: 0; display: flex; align-items: center; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 24px; background: linear-gradient(90deg, rgba(12, 9, 11, .88) 0%, rgba(12, 9, 11, .55) 55%, rgba(12, 9, 11, .1) 100%); overflow: auto; }\n.title-in { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 32px; align-items: start; max-width: 860px; margin-left: clamp(0px, 6vw, 80px); }\n.vb { background: var(--red); color: var(--paper); font-family: var(--display); padding: 26px 18px; display: flex; flex-direction: column; align-items: center; gap: 18px; box-shadow: 0 0 0 3px var(--ink), 0 0 0 4px var(--red); }\n.vb .t { writing-mode: vertical-rl; font-size: 88px; line-height: 1; letter-spacing: .12em; }\n.vb .s { writing-mode: vertical-rl; font-size: 15px; letter-spacing: .4em; }\n.intro { font-family: var(--display); font-size: 25px; line-height: 1.75; max-width: 24em; }\n.lede { margin-top: 10px; color: var(--paper-2); max-width: 38em; }\n.form { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-end; }\n.field label { display: block; font-size: 12px; letter-spacing: .2em; color: var(--paper-2); margin-bottom: 6px; }\n.field input { font: inherit; font-size: 18px; padding: 7px 12px; border: 1px solid var(--paper-2); background: rgba(236, 227, 212, .08); color: var(--paper); width: 8em; }\n.title .go { font-size: 17px; }\n.title .hint { margin-top: 12px; font-size: 12px; color: var(--paper-2); }\n.title .tg { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 14px; color: var(--paper-2); cursor: pointer; }\n.title .tg input { width: 18px; height: 18px; accent-color: var(--red); }\n\n/* 墨染轉場、更夫、印 */\n#ink { position: fixed; inset: -10%; background: #0b0809; pointer-events: none; opacity: 0; clip-path: circle(0% at 50% 58%); filter: url(#rough); z-index: 30; }\n#ink.on { opacity: 1; clip-path: circle(80% at 50% 58%); transition: clip-path .55s cubic-bezier(.6, 0, .4, 1); }\n#ink.off { opacity: 0; transition: opacity .45s ease; clip-path: circle(80% at 50% 58%); }\n.watch { position: fixed; inset: 0; z-index: 25; background: #070506; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 22px; padding: 24px; }\n.watch .w { writing-mode: vertical-rl; font-family: var(--display); font-size: clamp(28px, 5.4vh, 42px); line-height: 1.5; letter-spacing: .14em; color: var(--paper); max-height: 62vh; animation: rise 1.2s ease both; }\n.watch .w2 { color: var(--wash); font-size: 15px; letter-spacing: .2em; text-align: center; animation: rise 2s ease both; }\n.watch .knock { font-size: 12px; letter-spacing: .5em; color: var(--wash); }\n.watch .end { font-family: var(--display); font-size: clamp(44px, 9vh, 72px); color: var(--red-2); letter-spacing: .2em; }\n.watch .sum { font-size: 13px; color: var(--wash); text-align: center; max-width: 34em; }\n.watch .acts { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }\n.stamp { position: fixed; left: 50%; top: 34%; z-index: 35; transform: translate(-50%, -50%) rotate(-8deg); font-family: var(--display); font-size: 46px; color: var(--red-2); border: 5px solid var(--red-2); padding: 4px 22px; letter-spacing: .2em; pointer-events: none; animation: stampin .5s cubic-bezier(.2, 1.6, .4, 1) both; text-shadow: 0 0 12px rgba(0, 0, 0, .6); }\n@keyframes stampin { from { transform: translate(-50%, -50%) rotate(-8deg) scale(2.2); opacity: 0; } to { transform: translate(-50%, -50%) rotate(-8deg) scale(1); opacity: 1; } }\n#fx { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 32; }\n.fleck { position: absolute; top: -14px; width: 10px; height: 8px; background: var(--gold); animation: fall 1.8s ease-in forwards; }\n@keyframes fall { to { transform: translateY(105vh) rotate(560deg); opacity: .1; } }\n\n/* 骰子 */\n#dice { position: fixed; inset: 0; z-index: 36; display: flex; align-items: center; justify-content: center; pointer-events: none; }\n#dice .dbox { background: rgba(18, 14, 17, .92); border: 1px solid var(--gold); padding: 16px 24px 14px; display: flex; flex-direction: column; align-items: center; gap: 10px; box-shadow: 0 12px 40px rgba(0, 0, 0, .6); min-width: 220px; max-width: calc(100vw - 32px); text-align: center; }\n#dice .lb { font-size: 13px; letter-spacing: .12em; color: var(--paper-2); }\n#dice .res { font-family: var(--display); font-size: 26px; min-height: 1.3em; }\n#dice .res.ok { color: var(--gold); }\n#dice .res.bad { color: var(--red-2); }\n.die { display: inline-grid; width: 66px; height: 66px; background: #f4efe6; border-radius: 12px; grid-template: repeat(3, 1fr) / repeat(3, 1fr); padding: 9px; box-shadow: inset 0 -4px 0 #c9bca6, 0 4px 14px rgba(0, 0, 0, .5); }\n.die i { width: 11px; height: 11px; border-radius: 50%; background: var(--ink); place-self: center; visibility: hidden; }\n.die i.on { visibility: visible; }\n.die.red i.on { background: var(--red); }\n.die.spin { transform: rotate(18deg) translateY(-6px); }\n.die.land { animation: land .35s cubic-bezier(.2, 1.6, .4, 1) both; }\n@keyframes land { from { transform: scale(1.4) rotate(-20deg); } to { transform: none; } }\n\n/* 燈：吃完飯當場看到亮了還是熄了 */\n#lampfb { position: fixed; inset: 0; z-index: 27; display: flex; align-items: flex-start; justify-content: center; pointer-events: none; padding: 11vh 16px 16px; }\n#lampfb[hidden] { display: none; }\n@media (min-width: 760px) { #lampfb { justify-content: flex-start; padding-left: max(7vw, 190px); } }\n#lampfb .lf { background: rgba(14, 10, 12, .93); border: 1px solid var(--gold); padding: 16px 24px 14px; display: flex; flex-direction: column; align-items: center; gap: 6px; box-shadow: 0 14px 40px rgba(0, 0, 0, .65); max-width: min(420px, calc(100vw - 32px)); text-align: center; animation: peekIn .25s ease-out both; }\n#lampfb .lf.bad { border-color: #8a4a4e; }\n#lampfb .big { font-family: var(--display); font-size: clamp(30px, 5vw, 44px); line-height: 1.1; color: var(--gold); letter-spacing: .12em; }\n#lampfb .lf.bad .big { color: #e6d4d6; }\n#lampfb .row { font-size: 15px; color: var(--paper-2); letter-spacing: .04em; }\n#lampfb .row b { font-family: var(--display); font-weight: 400; font-size: 22px; color: var(--paper); margin: 0 2px; }\n#lampfb .warn { color: #ff9a8a; font-size: 14px; letter-spacing: .06em; }\n#lampfb .lfok { pointer-events: auto; margin-top: 6px; min-width: 96px; }\n.lampsvg { width: 150px; height: 150px; }\n.lampsvg .sg { transition: fill .5s, opacity .5s; }\n.lampsvg .sg.dying { animation: dying .22s steps(2) 5; }\n.lampsvg .sg.lighting { animation: lighting .9s ease both; }\n@keyframes dying { 50% { fill: #ffb070; } }\n@keyframes lighting { from { fill: #ffe9a8; } }\n.outs { display: inline-flex; gap: 3px; vertical-align: middle; }\n.outs i { width: 9px; height: 9px; border-radius: 50%; border: 1px solid #c9b08c; display: inline-block; }\n.outs i.on { background: #e8483e; border-color: #ff8a7a; box-shadow: 0 0 6px rgba(255, 90, 70, .7); }\n.outs i.new { animation: outPop 1s ease both; }\n@keyframes outPop { 0% { transform: scale(2.4); background: #ffb070; } 100% { transform: none; } }\n.scars { display: inline-flex; gap: 4px; vertical-align: middle; }\n.scars i { width: 3px; height: 12px; background: rgba(236, 200, 150, .25); display: inline-block; transform: rotate(14deg); }\n.scars i.on { background: #ff8a7a; }\n.plate .lm { margin-top: 6px; padding-top: 5px; border-top: 1px solid rgba(236, 200, 150, .2); font-size: 12px; color: #e0c98f; display: flex; flex-direction: column; gap: 3px; align-items: center; }\n.plate .lm b { font-family: var(--display); font-weight: 400; font-size: 17px; }\n.plate .lm .k { display: flex; align-items: center; gap: 4px; }\n.plate .lm .k2 { display: flex; gap: 8px; }\n.plate .lm .k.hot { color: #ff9a8a; }\n.wb .exam { display: block; color: #5a5156; font-size: 11px; }\n.wb .exam.bad { color: var(--red); font-weight: 700; }\n.offer .bad, .shopp .bad { color: var(--red); font-weight: 700; }\n.offer .ab { border-top: 1px dashed rgba(28, 23, 25, .25); padding-top: 4px; color: var(--ink); min-height: 0; }\n.panel.tujian { width: min(860px, 100%); }\n.panel .tabs { display: flex; gap: 6px; margin-bottom: 8px; }\n.bookg { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; margin-bottom: 6px; }\n.bc { border: none; background: none; padding: 0; cursor: pointer; text-align: center; font-size: 12px; color: var(--ink); }\n.bc img { width: 100%; display: block; border-radius: 5px; box-shadow: 0 3px 8px rgba(0, 0, 0, .35); margin-bottom: 2px; }\n.bc.un img { filter: grayscale(.9) brightness(.7); }\n.bc.un span { color: #8d8487; }\n.bc:hover img, .bc:focus-visible img { box-shadow: 0 0 0 3px var(--gold), 0 3px 8px rgba(0, 0, 0, .35); }\n.bookd { display: flex; gap: 16px; flex-wrap: wrap; }\n.bookd .faces { display: flex; gap: 8px; }\n.bookd figure { margin: 0; text-align: center; font-size: 12px; color: #5a5156; }\n.bookd figure img { width: 140px; display: block; border-radius: 6px; margin-bottom: 3px; }\n.bookd .bt { flex: 1; min-width: 220px; }\n.bookd h3 { font-family: var(--display); font-weight: 400; font-size: 30px; margin: 0; }\n.bookd h3 small { display: block; font-family: var(--body); font-size: 12px; color: #5a5156; }\n.bookr { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; }\n.bookr li { background: #e0d5c2; padding: 8px 10px; }\n.bookr li.own { box-shadow: inset 0 0 0 2px var(--gold); }\n.bookr b { font-family: var(--display); font-weight: 400; font-size: 20px; margin-right: 6px; }\n.bookr small { color: #5a5156; }\n.bookr p { margin: 4px 0 0; font-size: 13px; }\n.bookr .lore { color: #5a5156; }\n.bookt { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; }\n.bookt dt { font-family: var(--display); font-size: 18px; color: var(--red); }\n.bookt dd { margin: 0; font-size: 14px; }\n.panel .fired { color: var(--red-2); font-family: var(--display); font-size: 22px; }\n.mirrorc { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin: 6px 0; }\n.mirrorc figure { margin: 0; text-align: center; font-size: 12px; color: #5a5156; }\n.mirrorc img { width: 86px; display: block; margin-bottom: 4px; }\n\n/* 最後一次卸妝 */\n.lastwipe { position: fixed; inset: 0; z-index: 26; background: rgba(7, 5, 6, .9); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 16px; }\n.lastwipe .face { position: relative; width: min(340px, 78vw, 54vh); aspect-ratio: 4 / 5; }\n.lastwipe canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n.lastwipe #paint { touch-action: none; cursor: grab; }\n.lastwipe .tx { font-family: var(--display); font-size: 24px; line-height: 1.5; text-align: center; max-width: 24em; }\n.lastwipe .tx2 { font-size: 14px; color: var(--paper-2); text-align: center; max-width: 30em; letter-spacing: .04em; }\n.lastwipe .after { font-family: var(--display); font-size: 22px; line-height: 1.6; color: var(--paper); text-align: center; max-width: 24em; animation: rise 1.4s ease both; }\n\n/* 看牌：放大兩面，每面最多三行 */\n#peek { position: fixed; z-index: 35; pointer-events: none; display: flex; gap: 10px; filter: drop-shadow(0 14px 30px rgba(0, 0, 0, .7)); animation: peekIn .14s ease-out both; }\n#peek figure { margin: 0; width: 196px; background: var(--ink-2); border: 1px solid rgba(184, 145, 63, .45); padding: 8px 8px 10px; opacity: .78; }\n#peek figure.on { opacity: 1; border-color: var(--gold); border-top: 4px solid var(--red); }\n#peek img { width: 100%; aspect-ratio: 2 / 3; display: block; border-radius: 8px; }\n#peek figcaption { margin-top: 7px; font-size: 14px; line-height: 1.55; color: var(--paper); }\n#peek figcaption b { display: block; font-size: 12px; letter-spacing: .2em; color: var(--gold); font-weight: 400; }\n@keyframes peekIn { from { opacity: 0; transform: translateY(6px); } }\n\n/* 教學小框：遮罩挖洞框住要看的東西 */\n#coach { position: fixed; inset: 0; z-index: 34; pointer-events: none; }\n#coach .dim { position: absolute; inset: 0; background: rgba(8, 6, 7, .62); }\n#coach .shield { position: absolute; inset: 0; pointer-events: auto; }\n#coach .ring { position: absolute; border: 2px solid var(--gold); border-radius: 8px; box-shadow: 0 0 0 4px rgba(184, 145, 63, .22), 0 0 26px rgba(216, 67, 76, .55); animation: coachPulse 1.6s ease-in-out infinite; }\n#coach .ring[data-tap]::after { content: attr(data-tap); position: absolute; left: 50%; bottom: calc(100% + 8px); transform: translateX(-50%); background: var(--red); color: var(--paper); font-size: 13px; letter-spacing: .2em; padding: 2px 10px; white-space: nowrap; }\n@keyframes coachPulse { 50% { box-shadow: 0 0 0 9px rgba(184, 145, 63, .1), 0 0 38px rgba(216, 67, 76, .75); } }\n#coach .cbox { position: absolute; pointer-events: auto; width: min(330px, calc(100vw - 32px)); max-height: 60vh; overflow: auto; background: var(--ink-2); color: var(--paper); border: 1px solid rgba(184, 145, 63, .7); border-top: 4px solid var(--red); padding: 10px 14px 10px; box-shadow: 0 16px 44px rgba(0, 0, 0, .65); animation: rise .3s ease both; }\n#coach .cbox h4 { font-family: var(--display); font-weight: 400; font-size: 23px; line-height: 1.3; margin: 0 0 3px; }\n#coach .cbox .tx { font-size: 15px; line-height: 1.7; }\n#coach .cbox .tx b { color: #e8cf8f; }\n#coach .cbox .rule { margin: 8px 0 2px; padding: 2px 0 2px 10px; border-left: 3px solid var(--red); font-family: var(--display); font-size: 19px; line-height: 1.4; color: #f2d48a; }\n#coach .fc { width: 22px; height: 22px; font-size: 15px; vertical-align: -4px; margin: 0 2px; }\n#coach .cbox .row { display: flex; align-items: center; gap: 10px; margin-top: 8px; }\n#coach .cbox .do { font-size: 14px; color: #e8cf8f; letter-spacing: .1em; }\n#coach .cbox .skip { margin-left: auto; background: none; border: none; color: var(--paper-2); font-size: 12px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; min-height: 38px; padding: 0 4px; }\n#coach .arrow { position: absolute; width: 14px; height: 14px; background: var(--ink-2); transform: rotate(45deg); }\n#coach .arrow.up { top: -9px; background: var(--red); }\n#coach .arrow.down { bottom: -8px; border-right: 1px solid rgba(184, 145, 63, .7); border-bottom: 1px solid rgba(184, 145, 63, .7); }\n/* 做的步驟：不壓暗整個畫面，只一句話貼在要點的東西旁邊 */\n#coach.doing .dim { background: rgba(8, 6, 7, .38); }\n#coach.doing .cbox { width: auto; max-width: min(300px, calc(100vw - 32px)); padding: 8px 12px 6px; border-top-width: 3px; }\n#coach.doing .cbox .tx { font-family: var(--display); font-size: 19px; line-height: 1.45; }\n#coach.doing .cbox .row { margin-top: 2px; }\n#coach.doing .cbox .do { display: none; }\n#coach .cbox .step { position: absolute; right: 10px; top: 7px; font-size: 11px; letter-spacing: .1em; color: var(--paper-2); }\n/* 一張牌兩面：台上面翻過來就是家裡面 */\n.flip { display: flex; justify-content: center; margin: 6px 0 4px; perspective: 700px; }\n.flip .fl { position: relative; width: 92px; height: 138px; transform-style: preserve-3d; animation: flip 3.6s ease-in-out infinite; }\n.flip img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 6px; backface-visibility: hidden; box-shadow: 0 6px 14px rgba(0, 0, 0, .5); }\n.flip img.b { transform: rotateY(180deg); }\n.flip .cap { align-self: center; margin-left: 12px; font-size: 13px; line-height: 1.8; color: var(--paper-2); }\n.flip .cap b { color: #f2d48a; font-weight: 400; font-family: var(--display); font-size: 16px; }\n@keyframes flip { 0%, 30% { transform: rotateY(0); } 50%, 80% { transform: rotateY(180deg); } 100% { transform: rotateY(360deg); } }\n/* 小提示：不擋、不用按，貼在新出現的東西旁邊，一次只有一枚 */\n#nudge { position: fixed; z-index: 33; max-width: min(280px, calc(100vw - 24px)); background: rgba(22, 17, 20, .96); color: var(--paper); border-left: 3px solid #f2d48a; padding: 6px 26px 7px 10px; font-size: 14px; line-height: 1.55; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); animation: rise .3s ease both; cursor: pointer; }\n#nudge b { color: #f2d48a; font-weight: 400; font-family: var(--display); font-size: 16px; display: block; }\n#nudge .x { position: absolute; right: 6px; top: 3px; color: var(--paper-2); font-size: 14px; }\n#nudge.out { opacity: 0; transition: opacity .4s ease; }\n\n/* 早上選牌：妝匣的手牌、字幕都縮小，把高度讓給桌上攤開的牌 */\n.hud[data-v=\"morning\"] .hand.on { min-height: 118px; padding-top: 10px; }\n.hud[data-v=\"morning\"] .hc { width: 72px; height: 108px; margin: 0 -2px; }\n.hud[data-v=\"morning\"] .talk { gap: 2px; padding-bottom: 2px; }\n.hud[data-v=\"morning\"] .sub .tx { font-size: 18px; line-height: 1.35; }\n.hud[data-v=\"morning\"] .sub .gain { font-size: 12px; }\n.hud[data-v=\"morning\"] .opt { font-size: 21px; min-height: 40px; }\n.hud[data-v=\"morning\"] .choices { min-height: 40px; }\n.spc .ct { min-width: 28px; height: 28px; font-size: 15px; }\n/* v0.7：她的需要、情報、觀眾的話、後台、水牌小牌 */\nmark.k { background: none; color: #f2d48a; border-bottom: 2px solid rgba(242, 212, 138, .75); padding: 0 1px; }\n.sub mark.k { color: #f6dc96; }\n.panel mark.k, .bub mark.k { color: var(--red); border-bottom-color: rgba(168, 32, 43, .6); }\n.bub.intel mark.k { color: #ffe39a; border-bottom-color: #ffe39a; }\n.itag { display: inline-flex; align-items: center; gap: 6px; font-family: var(--body); font-size: 13px; letter-spacing: .08em; color: #1c1719; background: #f2d48a; padding: 1px 9px; margin-top: 4px; text-shadow: none; }\n.itag b { font-weight: 700; }\n.itag.ev { background: var(--red-2); color: var(--paper); }\n/* 情報簿：記下她（觀眾、玉樓、更夫）說過的需要 */\n.intel { pointer-events: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 6px; max-width: min(640px, 100%); }\n.intel .ic { display: inline-flex; align-items: center; gap: 5px; background: rgba(18, 14, 17, .78); border: 1px solid rgba(242, 212, 138, .7); padding: 1px 8px 1px 4px; font-size: 13px; color: var(--paper); white-space: nowrap; }\n.intel .ic.now { border-color: #f2d48a; box-shadow: 0 0 0 1px #f2d48a inset, 0 0 12px rgba(242, 212, 138, .35); }\n.intel .ic .d { color: #f2d48a; font-size: 12px; letter-spacing: .1em; }\n.intel .ic svg { width: 18px; height: 18px; }\n.intel .ic b { font-weight: 400; color: #f2d48a; }\n.intel .lbl { font-size: 11px; letter-spacing: .3em; color: #1c1719; background: #f2d48a; padding: 1px 6px; align-self: center; }\n/* 傍晚：她今晚的需要與推了幾張 */\n.need { pointer-events: auto; display: flex; align-items: center; gap: 10px; background: rgba(18, 14, 17, .72); border: 1px solid rgba(242, 212, 138, .6); padding: 4px 12px 4px 6px; }\n.need .lookb { width: 52px; height: 52px; }\n.need .nt { font-family: var(--display); font-size: 22px; line-height: 1.2; }\n.need .nt small { display: block; font-family: var(--body); font-size: 12px; color: var(--paper-2); }\n.need .nr { display: flex; align-items: center; gap: 6px; font-size: 19px; line-height: 1.3; }\n.need .nr svg { width: 22px; height: 22px; }\n.need .nr .lkn { font-style: normal; font-size: .72em; color: var(--paper-2); }\n.need .nr .hn { font-weight: 400; color: #f2d48a; }\n.need .nr.ok span:first-of-type { color: #f2d48a; }\n.pips { display: flex; gap: 5px; }\n.pips i { width: 16px; height: 16px; border-radius: 50%; border: 2px solid #f2d48a; }\n.pips i.on { background: #f2d48a; box-shadow: 0 0 10px rgba(242, 212, 138, .8); }\n.need.done { border-color: #f2d48a; box-shadow: 0 0 18px rgba(242, 212, 138, .35); }\n/* 傍晚的焦點就是她要什麼：放大 */\n.need { padding: 6px 18px 6px 8px; }\n.need .nr { font-size: 26px; }\n.need .nr svg { width: 28px; height: 28px; }\n.need .nr .hn { font-size: 1.15em; }\n.need .nt small { font-size: 13px; }\n/* 右上：水牌小牌 */\n.side { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }\n.wb { pointer-events: auto; text-align: right; background: linear-gradient(180deg, #e9dcc4, #d8c8aa); color: var(--ink); border: 1px solid #1d120b; padding: 4px 10px 5px; min-width: 128px; cursor: pointer; font-size: 12px; line-height: 1.45; box-shadow: 0 6px 16px rgba(0, 0, 0, .5); }\n.wb b { font-family: var(--display); font-weight: 400; font-size: 20px; color: var(--red); }\n.wb .gap { display: block; color: #5a5156; }\n.wb .wbh { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 12px; letter-spacing: .1em; }\n.wb ol { list-style: none; margin: 3px 0 2px; padding: 0; min-width: 150px; }\n.wb li { display: flex; justify-content: space-between; gap: 10px; padding: 1px 6px; font-size: 13px; text-align: left; font-variant-numeric: tabular-nums; }\n.wb li .n { color: #5a5156; margin-right: 4px; }\n.wb li.me { background: var(--red); color: var(--paper); font-weight: 700; }\n.wb li.me .n { color: #f2d48a; }\n.wb li.fail { border-top: 1px dashed var(--red); }\n.wb .dif { font-size: 11px; color: #5a5156; display: block; text-align: right; }\n\n/* 觀眾的話：對白框貼著剪紙頭頂 */\n#talkb { position: fixed; inset: 0; pointer-events: none; z-index: 31; }\n.bub { position: absolute; width: max-content; max-width: min(250px, 42vw); background: var(--paper); color: var(--ink); font-family: var(--display); font-size: 18px; line-height: 1.4; padding: 6px 12px 7px; border-radius: 12px; box-shadow: 0 8px 22px rgba(0, 0, 0, .55); transform: translate(-50%, -100%); animation: bubIn .28s cubic-bezier(.2, 1.4, .4, 1) both; }\n.bub::after { content: \"\"; position: absolute; left: var(--ax, 50%); bottom: -9px; width: 16px; height: 16px; background: inherit; transform: translateX(-50%) rotate(45deg); border-radius: 3px; }\n.bub.out { animation: bubOut .35s ease both; }\n.bub .tg { display: block; font-family: var(--body); font-size: 11px; letter-spacing: .3em; margin-bottom: 1px; }\n.bub.intel { background: #1c1417; color: var(--paper); border: 2px solid #f2d48a; box-shadow: 0 0 0 4px rgba(242, 212, 138, .2), 0 0 28px rgba(242, 212, 138, .55), 0 10px 26px rgba(0, 0, 0, .6); font-size: 19px; max-width: min(300px, 46vw); }\n.bub.intel::after { background: #f2d48a; }\n.bub.intel .tg { color: #f2d48a; }\n.bub.ev { background: #f3e6e2; border: 2px solid var(--red-2); }\n.bub.ev .tg { color: var(--red); }\n.bub.boo { background: #3a2a2c; color: #f0d6d6; }\n@keyframes bubIn { from { opacity: 0; transform: translate(-50%, -80%) scale(.7); } to { opacity: 1; transform: translate(-50%, -100%); } }\n@keyframes bubOut { to { opacity: 0; transform: translate(-50%, -115%); } }\n/* 後台 */\n.shop { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 8px; }\n.offer { background: #e0d5c2; padding: 8px; display: flex; flex-direction: column; gap: 6px; align-items: center; text-align: center; }\n.offer img { width: 96px; height: 144px; border-radius: 6px; box-shadow: 0 4px 10px rgba(0, 0, 0, .35); }\n.offer .kw { font-size: 12px; color: #3b3337; line-height: 1.5; min-height: 3em; }\n.offer .pr { font-family: var(--display); font-size: 20px; color: var(--red); }\n.offer.sold { opacity: .5; }\n.offer .pv { font-size: 13px; color: var(--red); min-height: 2.6em; }\n.offer .pv b { font-size: 16px; }\n.offer.isrel { background: #ead9b8; box-shadow: inset 0 0 0 2px #b8913f; }\n.relic { width: 96px; height: 144px; display: flex; align-items: center; justify-content: center; font-family: var(--display); font-size: 64px; color: #f2d48a; background: radial-gradient(circle at 50% 42%, #7d1219 0 38%, #3d0a0e 39% 41%, #1c1417 42%); border: 3px double #b8913f; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, .35); }\n.relics { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 3px; max-width: 150px; }\n.relics .rel { pointer-events: auto; font-family: var(--display); font-size: 15px; color: #f2d48a; background: #5e0f15; border: 1px solid #b8913f; padding: 1px 6px; cursor: help; min-height: 28px; }\n.relics .rel:hover, .relics .rel:focus-visible { background: #7a1620; outline: none; box-shadow: 0 0 0 2px #f2d48a; }\n#tip { position: fixed; z-index: 70; max-width: 280px; background: #1c1719; color: var(--paper); border: 1px solid var(--gold); padding: 8px 11px 9px; font-size: 13px; line-height: 1.55; pointer-events: none; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); }\n#tip b { display: block; font-family: var(--display); font-weight: 400; font-size: 18px; color: #f2d48a; margin-bottom: 2px; }\n.term { font-style: normal; border-bottom: 1px dashed currentColor; cursor: help; pointer-events: auto; }\n#anchors div { position: fixed; pointer-events: none; }\n.purse { display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; color: #3b3337; }\n.purse b { font-family: var(--display); font-weight: 400; font-size: 22px; color: var(--red); margin-left: 4px; }\n.tips li { font-size: 14px; }\n@media (max-width: 760px) {\n  .bub { font-size: 15px; max-width: 46vw; }\n  .hud[data-v=\"morning\"] .hc { width: 54px; height: 81px; margin: 0 -2px; }\n  .hud[data-v=\"morning\"] .hand.on { min-height: 92px; }\n  /* 早上手牌就是妝匣，窄螢幕上不再疊一排小格子 */\n  .bub.intel { font-size: 15px; max-width: 62vw; }\n  .need .nt { font-size: 17px; }\n  .need { gap: 6px; padding: 3px 8px 3px 4px; }\n  .wb { min-width: 0; padding: 3px 7px; }\n  .wb b { font-size: 16px; }\n  .intel .ic { font-size: 12px; }\n  .need .nt { font-size: 18px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .fleck { display: none; }\n  .s