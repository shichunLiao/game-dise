":983,"oldLines":13,"newStart":1017,"newLines":14,"lines":[" }"," "," // ── 門口 ──","-const canWipe = S => S.phase === 'door' && !S.T.wiped && S.T.layers.length > 0 && S.scars <= R.wipeScarMax;","+// v1.7：保底擦臉整季 2 次（S.wipes 是還剩幾次），一晚一次；擦完今晚照樣能推滿","+const canWipe = S => S.phase === 'door' && !S.T.wiped && S.T.layers.length > 0 && (S.wipes ?? 0) > 0;"," function wipe(S) {","   if (!canWipe(S)) return 0;","   const t = S.T, n = Math.min(R.wipeLayers + (has(S, 'jin') ? 1 : 0), t.layers.length);","   for (let i = 0; i < n; i++) S.chest.push({ day: S.day, f: t.layers.pop().f });","   t.wiped = n;","-  t.homeCap = R.homeAfterWipe;","+  S.wipes -= 1;","   return n;"," }"," const canClean = (S, id) => (S.phase === 'door' || S.phase === 'night') && S.T.layers.length > 0 && S.T.box.includes(id) && !S.T.used[id];"]},{"oldStart":1105,"oldLines":14,"newStart":1140,"newLines":16,"lines":["   const t = S.T;","   // 座位空了、或沒回家：需要沒人接，燈也不糊；下一段的事由更夫說","   if (!t.judged && !t.auto && t.emptySeat) { t.judged = true; forecast(S, 'watch'); }","-  t.nightBase = t.layers.length;","-  S.base += t.layers.length;","+  // 香粉：用了保底擦臉的那晚，滲進底色的少 1","+  t.fenSaved = t.wiped && has(S, 'xiangfen') && t.layers.length ? 1 : 0;","+  t.nightBase = t.layers.length - t.fenSaved;","+  S.base += t.nightBase;","   t.layers = [];","   t.wasted = t.box.filter(id => !t.used[id]).length;","   if (S.day === 7 || S.left) S.baseSeen = true;","   t.watch = watchLine(S);","   S.log.push({ day: S.day, cap: t.cap, starter: starterOf(S), stage: t.plays.length, maxChain: t.maxChain, die: t.die, perfect: t.perfect, gold: t.gold,","-    wiped: t.wiped, pushed: t.pushed.length, look: lookNow(S), need: t.need.k, pat: t.need.pat, got: Object.values(t.got).reduce((a, v) => a + v, 0), met: t.met, lampOut: t.lampOut, grudge: t.grudge, lampGain: t.lampGain,","+    wiped: t.wiped, wipes: S.wipes, refreshed: t.refreshed, drumGold: t.drumGold, fenSaved: t.fenSaved, pushed: t.pushed.length, look: lookNow(S), need: t.need.k, pat: t.need.pa