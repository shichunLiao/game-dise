ata-tap=\"${esc(st.tap)}\"` : ''}></div>` : ''}\n    <div class=\"cbox\" role=\"dialog\" aria-label=\"${esc(st.title || '教学')}\" aria-describedby=\"coachX\">${steps.length > 1 && !act ? `<span class=\"step\">${coach.i + 1}/${steps.length}</span>` : ''}${st.title && !act ? `<h4 id=\"coachT\">${st.title}</h4>` : ''}${st.vis ? st.vis() : ''}<div class=\"tx\" id=\"coachX\">${termify(st.text())}</div>${st.rule ? `<p class=\"rule\">${termify(typeof st.rule === 'function' ? st.rule() : st.rule)}</p>` : ''}\n      <div class=\"row\">${doing}<button class=\"skip\" data-act=\"coachskip\">不用教了</button></div><i class=\"arrow\" aria-hidden=\"true\"></i></div>`;\n  const path = `path(evenodd, 'M0 0H${W}V${H}H0Z${r ? `M${r.l} ${r.t}H${r.r}V${r.b}H${r.l}Z` : ''}')`;\n  el.querySelector('.dim').style.clipPath = path;\n  el.querySelector('.shield').style.clipPath = act ? path : 'none';\n  if (r) Object.assign(el.querySelector('.ring').style, { left: `${r.l}px`, top: `${r.t}px`, width: `${r.r - r.l}px`, height: `${r.b - r.t}px` });\n  // 說明框放在洞上下空間大的一邊，箭頭指著洞\n  const box2 = el.querySelector('.cbox'), bw = box2.offsetWidth, bh = box2.offsetHeight, ar = box2.querySelector('.arrow');\n  let left = (W - bw) / 2, top = (H - bh) / 2;\n  if (r) {\n    const below = H - r.b >= r.t, side = st.place === 'left' && r.l - bw - 24 > 0;\n    // 洞上方掛著「點這裡」的小籤，說明框放上面時要讓開它\n    top = below ? r.b + 16 : r.t - (act ? 46 : 16) - bh;\n    left = (r.l + r.r) / 2 - bw / 2;\n    if (side) { left = r.l - bw - 18; top = (r.t + r.b) / 2 - bh / 2; }\n    top = clamp(top, 12, H - bh - 12); left = clamp(left, 16, W - bw - 16);\n    ar.hidden = side || (top < r.b && top + bh > r.t);\n    ar.className = `arrow ${below ? 'up' : 'down'}`;\n    ar.style.left = `${clamp((r.l + r.r) / 2 - left - 7, 14, bw - 28)}px`;\n  } else ar.hidden = true;\n  Object.assign(box2.style, { left: `${left}px`, top: `${top}px` });\n  // 只看不做的步驟：底下的介面暫時不能操作，焦點放在「知道了」\n  $('#hud').inert = !act;\n  if (coach.shown !== key) {\n    coach.shown =