rowd[0] && crowd[0].mat) { const k = clamp(0.86 + stageHeat * 0.06, 0.85, 1); crowd.forEach(c => { if (c.mat) c.mat.color.setScalar(k); }); }\n    swayKick *= Math.exp(-dt * 1.6); lanternKick *= Math.exp(-dt * 3);\n    stageCurtains.forEach((c, i) => { c.rotation.y = Math.sin(t * 3.2 + i * 2) * 0.12 * swayKick; c.rotation.z = Math.sin(t * 2.1 + i) * 0.03 * swayKick; });\n    lanterns.forEach((m, i) => { const k = 1 + lanternKick * (0.35 + 0.15 * Math.sin(t * 9 + i)); m.scale.set(k, 1.25 * k, k); });\n  }\n  [lights.c1, lights.c2].forEach(c => { if (c && c.base !== undefined) { c.fl.scale.y = 0.11 + Math.sin(t * 11) * 0.008; c.L.intensity = c.base * (0.92 + Math.sin(t * 13) * 0.05 + Math.sin(t * 7.3) * 0.03); } });","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_011QUF5CAb6H3SXoND7HFPLN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
