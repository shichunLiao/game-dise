lector('.dim').style.clipPath = path;\n  el.querySelector('.shield').style.clipPath = act ? path : 'none';\n  if (r) Object.assign(el.querySelector('.ring').style, { left: `${r.l}px`, top: `${r.t}px`, width: `${r.r - r.l}px`, height: `${r.b - r.t}px` });\n  // 說明框放在洞上下空間大的一邊，箭頭指著洞\n  const box2 = el.querySelector('.cbox'), bw = box2.offsetWidth, bh = box2.offsetHeight, ar = box2.querySelector('.arrow');\n  let left = (W - bw) / 2, top = (H - bh) / 2;\n  if (r) {\n    const below = H - r.b >= r.t, side = st.place === 'left' && r.l - bw - 24 > 0;\n    // 洞上方掛著「點這裡」的小籤，說明框放上面時要讓開它\n    top = below ? r.b + 16 : r.t - (act ? 46 : 16) - bh;\n    left = (r.l + r.r) / 2 - bw / 2;\n    if (side) { left = r.l - bw - 18; top = (r.t + r.b) / 2 - bh / 2; }\n    top = clamp(top, 12, H - bh - 12); left = clamp(left, 16, W - bw - 16);\n    ar.hidden = side || (top < r.b && top + bh > r.t);\n    ar.className = `arrow ${below ? 'up' : 'down'}`;\n    ar.style.left = `${clamp((r.l + r.r) / 2 - left - 7, 14, bw - 28)}px`;\n  } else ar.hidden = true;\n  Object.assign(box2.style, { left: `${left}px`, top: `${top}px` });\n  // 只看不做的步驟：底下的介面暫時不能操作，焦點放在「知道了」\n  $('#hud').inert = !act;\n  if (coach.shown !== key) {\n    coach.shown = key;\n    const f = act ? els.find(x => x.matches('button')) : box2.querySelector('.btn.go');\n    f?.focus({ preventScroll: true });\n  }\n}\nfunction coachUpdate() { coachTick(); coachRender(); nudgePlace(); }\n// ── 小提示 ──\nconst nudge = { k: null, until: 0, timer: 0 };\nfunction nudgeTick() {\n  if (!S || !S.tut || S.tut.off || busy || panel || sheet || view === 'title') return;\n  if (nudge.k) return;\n  for (const k of Object.keys(NUDGES)) {\n    const n = NUDGES[k];\n    if (S.tut.seen[k] || !n.when()) continue;\n    const el = n.at();\n    if (!el || !el.getClientRects().length) continue;\n    nudgeShow(k);\n    return;\n  }\n}\nfunction nudgeShow(k) {\n  nudge.k = k;\n  S.tut.seen[k] = true;\n  let el = $('#nudge');\n  if (!el) { el = document.createElement('div'); el.id = 'nudge'; el.setAttribute('role', 'note'); document.body.appendChild(el); el.addEventListener('click', () => nudgeHide()); }\n  el.className = '';\n  el.hidden = false;\n  el.innerHTML = `${NUDGES[k].tx()}<span class=\"x\" aria-hidden=\"true\">×</span>`;\n  nudgePlace();\n  clearTimeout(nudge.timer);\n  nudge.timer = setTimeout(() => nudgeHide(), 9000);\n}\nfunction nudgeHide(now = false) {\n  const el = $('#nudge');\n  clearTimeout(nudge.timer);\n  nudge.k = null;\n  if (!el) return;\n  if (now) { el.hidden = true; return; }\n  el.classList.add('out');\n  setTimeout(() => { if (!nudge.k) el.hidden = true; nudgeTick(); }, 420);\n}\n// 貼在目標旁邊：下面空就放下面，不然放上面；目標不見了就收\nfunction nudgePlace() {\n  const el = $('#nudge');\n  if (!el || el.hidden || !nudge.k) return;\n  const n = NUDGES[nudge.k], tg = n.at();\n  if (!tg || !tg.getClientRects().length || !n.when() || coach.lesson || panel || sheet) { nudgeHide(true); return; }\n  const r = tg.getBoundingClientRect(), w = el.offsetWidth, h = el.offsetHeight;\n  const below = innerHeight - r.bottom > h + 16;\n  const top = below ? r.bottom + 8 : r.top - h - 8;\n  const left = clamp((r.left + r.right) / 2 - w / 2, 12, innerWidth - w - 12);\n  Object.assign(el.style, { left: `${left}px`, top: `${clamp(top, 8, innerHeight - h - 8)}px` });\n}\nsetInterval(() => { if (nudge.k) nudgePlace(); else if (!coach.lesson) nudgeTick(); }, 400);\naddEventListener('resize', () => { if (coach.lesson) coachRender(); });\n// 指著 3D 東西的步驟：鏡頭在動，框跟著挪\n// 只在鏡頭真的挪了位置時重畫，免得說明框一直重播淡入\nlet followSig = '';\nsetInterval(() => {\n  const st = coach.lesson && !busy ? LESSONS[coach.lesson][coach.i] : null;\n  if (!st || (!st.follow && !st.until)) { followSig = ''; return; }\n  const sig = (st.at ? st.at() : []).filter(Boolean).map(x => { const b = x.getBoundingClientRect(); return `${Math.round(b.left / 3)},${Math.round(b.top / 3)},${Math.round(b.width / 3)}`; }).join('|');\n  if (sig !== followSig) { followSig = sig; coachRender(true); }\n}, 200);\n\n// ── 看牌：滑到牌上（手機長按）放大兩面，每面最多三行 ──\nlet peekAt = null, peekXY = null, peekHold = null, peekEat = false;\nfunction peekHTML(t) {\n  const front = view !== 'evening';\n  const covered = view === 'evening' && coveredFams(S).includes(T[t].f);\n  const fig = (side, on, name, lines, over) => `<figure class=\"${on ? 'on' : ''}\"><img src=\"${cardArt(t, side, over).url}\" alt=\"\"><figcaption><b>${name}</b>${lines.join('<br>')}</figcaption></figure>`;\n  return fig('stage', front, '台上面', stageLines(t)) + fig('home', !front, '家里面', covered ? ['台上的字盖住了。', '推出去，就算被染。'] : homeLines(t), covered);\n}\n// 教學小框還在畫面上時不放大牌：先讀完教學，再看牌\nconst coachOn = () => !$('#coach').hidden;\nfunction showPeek(el) {\n  if (!S || view === 'title' || coachOn()) return;\n  const id = el.dataset.id !== undefined ? Number(el.dataset.id) : null, t = id !== null ? cardOf(S, id)?.t : el.dataset.t;\n  if (!t || !T[t]) return;\n  const p = $('#peek');\n  peekAt = el;\n  p.innerHTML = peekHTML(t);\n  p.hidden = false;\n  const a = el.getBoundingClientRect(), W = innerWidth, H = innerHeight, pw = p.offsetWidth, ph = p.offsetHeight;\n  let left = a.left + a.width / 2 - pw / 2, top = a.top - 24 - ph;\n  // 桌上攤開的牌：放在右邊，放不下就放左邊\n  if (!el.classList.contains('hc')) { left = a.right + 12; top = a.top + a.height / 2 - ph / 2; if (left + pw > W - 16) left = a.left - 12 - pw; }\n  p.style.left = `${clamp(left, 16, Math.max(16, W - pw - 16))}px`;\n  p.style.top = `${clamp(top, 8, Math.max(8, H - ph - 8))}px`;\n}\nfunction hidePeek() { peekAt = null; $('#peek').hidden = true; }\nconst peekEl = x => x?.closest?.('.hc, .spc');\n// 手牌每次重畫，舊的牌就換成新元素：滑鼠還停在牌上的話，換到新元素上接著看\nfunction peekSync() {\n  if (!peekAt || peekAt.isConnected) return;\n  hidePeek();\n  const el = !busy && peekXY ? peekEl(document.elementFromPoint(...peekXY)) : null;\n  if (el) showPeek(el);\n}\ndocument.addEventListener('pointermove', e => { if (e.pointerType !== 'touch') peekXY = [e.clientX, e.clientY]; }, { passive: true });\ndocument.addEventLi