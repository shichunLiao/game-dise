}</svg>`;\n}\n// 這幾片紙在兩個燈數之間變了\nconst segsBetween = (a, b) => { const m = {}; for (let i = 0; i < LSEG; i++) if (clamp(a - i * 2, 0, 2) !== clamp(b - i * 2, 0, 2)) m[i] = 1; return m; };\n// 吃完飯當場：燈亮了還是熄了一截，熄了第幾回，還剩幾回她就走\nasync function lampFeedback(t) {\n  const el = $('#lampfb'), now = S.lamp;\n  const from = t.met ? now - t.lampGain : now + t.lampOut;\n  const head = t.met ? `<div class=\"big\">她的需要，满足了</div>` : `<div class=\"big\">灯熄了一截</div>`;\n  const rows = t.met\n    ? `<div class=\"row\">今晚灯 <b>+${t.lampGain}</b>　现在 <b>${now}</b>/${R.lampFull}　（糊满才算美满）</div>${t.gift ? `<div class=\"row\">两晚都对上：她送你一张「${T[t.gift].n}」</div>` : ''}`\n    : `<div class=\"row\">灯 <b>${from}</b> → <b>${now}</b>　熄 ${outsHTML(true)} <b>${S.outs}</b>/${R.brokenOuts}</div><div class=\"warn\">${S.outs >= R.brokenOuts ? '熄满五回了。' : `她今晚要的是 ${recipeShort(t.need)}。再熄 ${R.brokenOuts - S.outs} 回，她就走了。${S.outs === 1 ? '熄过了，这一季到不了美满。' : ''}`}</div>`;\n  el.innerHTML = `<div class=\"lf ${t.met ? '' : 'bad'}\">${head}<div class=\"lp\">${lampSVG(from)}</div>${rows}<button class=\"btn go small lfok\">${t.met ? '好' : '知道了'}</button></div>`;\n  el.hidden = false;\n  sfx(t.met ? 'lit' : 'out');\n  // 看清楚了再點掉：不自動消失\n  const ok = el.querySelector('.lfok'), done = new Promise(res => ok.addEventListener('click', e => { e.stopPropagation(); res(); }, { once: true }));\n  ok.focus({ preventScroll: true });\n  const ch = segsBetween(from, now);\n  if (calm()) el.querySelector('.lp').innerHTML = lampSVG(now);\n  else {\n    await Promise.race([wait(650), done]);\n    if (t.met) el.querySelector('.lp').innerHTML = lampSVG(now, Object.fromEntries(Object.keys(ch).map(i => [i, 'lighting'])));\n    else { el.querySelectorAll('.sg').forEach((p, i) => { if (ch[i]) p.classList.add('dying'); }); await Promise.race([wait(1150), done]); el.querySelector('.lp').innerHTML = lampSVG(now); }\n  }\n  await done;\n  el.hidden = true; el.innerHTML = '';\n}\n// 3D 的燈：熄掉的幾片閃幾下滅了，燈光一暗；亮的時候燈光暖一下\nfunction lamp3D(from, to) {\n  if