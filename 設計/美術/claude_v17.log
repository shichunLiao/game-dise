= 1, '最後一次用掉');\\n  D2.T.wiped = 0;\\n  ok(!E.canWipe(D2), '次數用完就不能再擦');\\n\\\"\\\"\\\")\\nrep(\\\"\\\"\\\"  // 第 1 天傍晚自動\\\"\\\"\\\", \\\"\\\"\\\"  // v1.7 後台刷新：一天一次、花 3 金、換一批\\n  const Rf = E.newGame('测', 41); Rf.day = 3; E.beginDay(Rf); Rf.gold = 10;\\n  const o0 = Rf.T.offers.slice();\\n  ok(E.canRefresh(Rf) && E.refreshShop(Rf) && Rf.gold === 7 && Rf.T.refreshed, '刷新：花 3 金');\\n  ok(Rf.T.offers.length === o0.length && Rf.T.offers.some(k => !o0.includes(k)), `刷新換了一批：${o0} → ${Rf.T.offers}`);\\n  ok(!E.canRefresh(Rf) && /已经/.test(E.refreshWhy(Rf)), '一天只能刷新一次，說明已刷新');\\n  const Rg = E.newGame('测', 42); Rg.day = 3; E.beginDay(Rg); Rg.gold = 2;\\n  ok(!E.refreshShop(Rg) && Rg.gold === 2 && /换不起/.test(E.refreshWhy(Rg)), '錢不夠不能刷新，說明原因');\\n  ok(!E.canRefresh(E.newGame('测', 43)), '第 1 天沒有後台，不能刷新');\\n  // v1.7 新物件\\n  const rel2 = (k, seed, fn) => { const Z = E.newGame('测', seed); Z.relics.push(k); Z.day = 5; E.beginDay(Z); Z.phase = 'stage'; Z.T.box = Z.deck.map(c => c.id).slice(0, 16); return fn(Z); };\\n  ok(rel2('zhezi', 44, Z => Z.T.offers.filter(k => !E.RELICS[k]).length) === 3, '手抄折子：每天多看一張牌');\\n  const Zb = E.newGame('测', 45); Zb.day = 3; E.beginDay(Zb); Zb.gold = 50; Zb.T.offers = ['manban', 'daoban', 'zhezi'];\\n  E.buy(Zb, 'zhezi');\\n  ok(Zb.T.offers.filter(k => !E.RELICS[k]).length === 3, '手抄折子：買下當天就多一張');\\n  const drum = has => { const Z = E.newGame('测', 46); if (has) Z.relics.push('bangu'); ['changqiang', 'bai', 'shenduan'].forEach(t => E.playStage(Z, take(Z, t))); E.endStage(Z); return Z; };\\n  const d0 = drum(false), d1 = drum(true);\\n  ok(d1.T.drumGold === 3 && d1.T.gold - d0.T.gold === 3, `班鼓：連擊 3 收場 +3 金（${d0.T.gold} → ${d1.T.gold}）`);\\n  const fen = has => { const Z = E.newGame('测', 47); if (has) Z.relics.push('xiangfen'); ['changqiang', 'bai', 'shenduan', 'liangxiang'].forEach(t => E.playStage(Z, take(Z, t))); E.endStage(Z); E.wipe(Z); Z.phase = 'night'; E.sleep(Z); return Z.base; };\\n  ok(fen(false) === 2 && fen(true) === 1, '香粉：擦過的那晚，滲進底色少