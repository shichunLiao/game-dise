')?.focus({ preventScroll: true });\n}\nconst finishLast = () => run(async () => {\n  if (S.phase !== 'lastwipe') return;\n  // 她替你擦的最後一塊布，疊在木匣最上面\n  if (!lastAlone()) S.chest.push({ day: S.day, f: topFams()[0], last: true });\n  finishWipe(S);\n  $('#wipe').hidden = true; $('#wipe').innerHTML = '';\n  view = 'reveal'; sheet = { k: 'r_board' };\n  S.T.layers = [];\n  placeScene();\n  say('', '');\n});\n// 提前結束的結局：她走的那天、摘牌那天\nconst ENDING_EARLY = {\n  头牌: '她走的那天，水牌最上面写的是你。你回到家，门开着，那盏灯没糊完，灯上全是划痕。',\n  戏散: '她走了。你的名字还挂在水牌中间，没人来问。后面的戏，你没有再上。',\n  更夫: '她走了，牌子也摘了。春天，城里多了一个不上妆的更夫。你接过梆子，第一声敲在自家门口。',\n  卸尽: '考核那天，你的牌子被摘了下来。回到家，她什么也没问，把灯递到你手里。往后，你不用再上妆了。',\n  素脸: '摘牌那天，你素着脸回家。她没说什么，给你盛了饭。灯上熄过的几处，还暗着。',\n};\nfunction showFinal() {\n  const e = endingOf(S), w = $('#watch'), kind = ['美满', '守住', '破裂'][wifeOf(S)];\n  sheet = null; w.hidden = false; sfx('knock');\n  const early = !!(S.left || S.fired), tx = early && ENDING_EARLY[e] ? ENDING_EARLY[e] : ENDING_TX[e];\n  w.innerHTML = `<div class=\"knock\">梆　梆　梆</div><div class=\"w\">${esc(S.name)}。</div><div class=\"w2\" style=\"max-width:32em\">${esc(tx)}</div><div class=\"end\">${e}</div>\n    <div class=\"sum\">${early ? `这一季在第 ${endDay(S)} 天${S.left ? '她走了' : '摘了牌'}，提前结束 · ` : ''}卖座 ${S.gold} · 水牌第 ${rankOf(S)} · 妻子${kind} · 灯 ${S.lamp}（熄过 ${S.outs} 回）· 痕 ${S.scars} · 底色 ${S.base} · 满足 ${S.log.filter(x => x.met).length} 晚${S.choice ? ` · 元宵${{ stage: '上台', lamp: '回家点灯', cover: '替小凤代演' }[S.choice]}` : ''}</div>\n    <div class=\"acts\"><button class=\"btn go\" data-act=\"again\">再来一季</button><button class=\"btn\" data-act=\"home\">回到开场</button></div>`;\n}\n\n$('#title').addEventListener('input', e => { if (e.target.id === 'nm') draftName = e.target.value; });\ndocument.addEventListener('click', e => {\n  wakeAudio();\n  const b = e.target.closest('[data-act]');\n  if (!b || b.disabled) return;\n  const a = b.dataset.act, arg = b.dataset.arg, id = Number(arg);\n  switch (a) {\n    case 'start': setTutPref(!!$('#tutChk')?.checked); startGame((draftName.trim() || '小满').slice(0, 6)); return;\n    case 'cont': continueGame(); return;\n    case 'coachnext': coachNext(); break;\n    case 'coachskip': coachSkip(); break;\n    case 'rules': panel = panel === 'rules' ? null : 'rules'; break;\n    case 'close': panel = null; break;\n    case 'opt': S.opt[arg] = !S.opt[arg]; break;\n    case 'mute': muted = !muted; break;\n    case 'music': musicOn = !musicOn; try { localStorage.setItem(MUSIC_KEY, musicOn ? '1' : '0'); } catch (err) { /* 存不了就算了 */ } break;\n    case 'book': panel = panel === 'book' ? null : 'book'; bookSel = null; break;\n    case 'booktab': bookTab = arg; bookSel = null; break;\n    case 'booksel': bookSel = arg || null; break;\n    case 'yuan': choose(S, arg); say('', { stage: '你把戏服抖开。', lamp: '你把戏服叠起来，放回箱子。', cover: '你接过小凤托人送来的头面。' }[arg]); break;\n    case 'pick': { const c = S.deck.find(x => x.t === arg && !S.T.box.includes(x.id)); if (c) { if (S.T.box.length >= S.T.cap) S.T.box.pop(); toggleBox(S, c.id); } break; }\n    case 'yesterday': boxYesterday(S); break;\n    case 'shop': panel = 'shop'; break;\n    case 'water': panel = panel === 'water' ? null : 'water'; break;\n    case 'buy': { const c = buy(S, arg); if (c) { sfx('cheer'); if (c.relic) say('孙师父', `“${RELICS[arg].n}，你留着。”`, `卖座 −${RELICS[arg].price}，水牌第 ${rankOf(S)}：${RELICS[arg].tx}`); else say('孙师父', `“「${T[arg].n}」，拿去。”`, `卖座 −${T[arg].price}，水牌第 ${rankOf(S)}；这张进了卡组`); } break; }\n    case 'clear': clearBox(S); break;\n    case 'depart': onDepart(); return;\n    case 'endstage': onEndStage(); return;\n    case 'todoor': onToDoor(); return;\n    case 'wipe': onWipe(); return;\n    case 'enter': onEnter(); return;\n    case 'look': lookOpen = !lookOpen; break;\n    case 'endeve': onEndEvening(); return;\n    case 'light': onLight(); return;\n    case 'sleep': onSleep(); return;\n    case 'dawn': onDawn(); return;\n    case 'nextact': onNextAct(); return;\n    case 'wipekey': window.__wipeKey?.(); return;\n    case 'lastd