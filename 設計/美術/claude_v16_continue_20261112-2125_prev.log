; coach.i = 0; coach.shown = ''; coach.view = view; }\nfunction coachNext() {\n  if (!coach.lesson) return;\n  coach.i += 1;\n  if (coach.i < LESSONS[coach.lesson].length) return;\n  S.tut.seen[coach.lesson] = true;\n  coach.lesson = null;\n  if ([...Object.keys(LESSONS), ...Object.keys(NUDGES)].every(k => S.tut.seen[k])) setTutPref(false);\n}\nfunction coachSkip() { S.tut.off = true; coach.lesson = null; setTutPref(false); nudgeHide(true); }\n// 狀態一變就看一次：要玩家做的事做到了就往下；這個時段還沒教過就開始教\nfunction coachTick() {\n  if (busy || !S || view === 'title' || !S.tut) return;\n  for (let n = 0; n < 4; n++) {\n    if (coach.lesson) {\n      // 換了場景：這一課就算教完了，不跟著帶過去\n      if (view !== coach.view) { S.tut.seen[coach.lesson] = true; coach.lesson = null; continue; }\n      const st = LESSONS[coach.lesson][coach.i];\n      if (!st.until || !st.until()) return;\n      coachNext();\n    } else {\n      const k = lessonNow();\n      if (!k || S.tut.off || S.tut.seen[k]) return nudgeTick();\n      coachStart(k);\n    }\n  }\n}\nfunction coachRender(geom = false) {\n  const el = $('#coach'), on = !!S && !!coach.lesson && !busy && view !== 'title' && panel !== 'rules';\n  $('#hud').inert = false;\n  if (!on) { el.hidden = true; return; }\n  const steps = LESSONS[coach.lesson], st = steps[coach.i], key = `${coach.lesson}:${coach.i}`;\n  const els = st.at ? st.at().filter(x => x && x.getClientRects().length) : [];\n  const act = !!st.until && els.length > 0 && !(st.read && st.read());\n  if (coach.shown !== key && st.on) st.on();\n  if (coach.shown !== key && els[0] && !els[0].closest('#anchors')) els[0].scrollIntoView({ block: 'nearest', inline: 'center' });\n  let r = null;\n  els.forEach(x => { const b = x.getBoundingClientRect(); r = r ? { l: Math.min(r.l, b.left), t: Math.min(r.t, b.top), r: Math.max(r.r, b.right), b: Math.max(r.b, b.bottom) } : { l: b.left, t: b.top, r: b.right, b: b.bottom }; });\n  const W = innerWidth, H = innerHeight, pad = act ? 5 : 8;\n  if (r) r = { l: Math.max(4, r.l - pad), t: Math.max(4, r.t - pad), r: Math.min(W - 4, r.r + pad), b: Math.min(H - 4, r.b + pad) };\n  el.hidden = false;\n  hidePeek();\n  const doing = act ? `<span class=\"do\">${esc(st.tap || '点亮起来的地方')}</span>` : `<button class=\"btn go small\" data-act=\"coachnext\">${coach.i < steps.length - 1 ? '下一句' : '好'}</button>`;\n  el.classList.toggle('doing', act);\n  // 只挪位置（鏡頭在動）：不重建，免得說明框重播淡入\n  const keep = geom && coach.shown === key && el.querySelector('.cbox') && !!el.querySelector('.ring') === !!r;\n  if (!keep) el.innerHTML = `<div class=\"dim\"></div><div class=\"shield\"></div>${r ? `<div class=\"ring\" ${act && st.tap ? `data-tap=\"${esc(st.tap)}\"` : ''}></div>` : ''}\n    <div class=\"cbox\" role=\"dialog\" aria-label=\"${esc(st.title || '教学')}\" aria-describedby=\"coachX\">${steps.length > 1 && !act ? `<span class=\"step\">${coach.i + 1}/${steps.length}</span>` : ''}${st.title && !act ? `<h4 id=\"coachT\">${st.title}</h4>` : ''}${st.vis ? st.vis() : ''}<div class=\"tx\" id=\"coachX\">${termify(st.text())}</div>${st.rule ? `<p class=\"rule\">${termify(typeof st.rule === 'function' ? st.rule() : st.rule)}</p>` : ''}\n      <div class=\"row\">${doing}<button class=\"skip\" data-act=\"coachskip\">不用教了</button></div><i class=\"arrow\" aria-hidden=\"true\"></i></div>`;\n  const path = `path(evenodd, 'M0 0H${W}V${H}H0Z${r ? `M${r.l} ${r.t}H${r.r}V${r.b}H${r.l}Z` : ''}')`;\n  el.querySelector('.dim').style.clipPath = path;\n  el.querySelector('.shield').style.clipPath = act ? path : 'none';\n  if (r) Object.assign(el.querySelector('.ring').style, { left: `${r.l}px`, top: `${r.t}px`, width: `${r.r - r.l}px`, height: `${r.b - r.t}px` });\n  // 說明框放在洞上下空間大的一邊，箭頭指著洞\n  const box2 = el.querySelector('.cbox'), bw = box2.offsetWidth, bh = box2.offsetHeight, ar = box2.querySelector('.arrow');\n  let left = (W - bw) / 2, top = (H - bh) / 2;\n  if (r) {\n    const below = H - r.b >= r.t, side = st.place === 'left' && r.l - bw - 24 > 0;\n    // 洞上方掛著「點這裡」的小籤，說明框放上面時要讓開它