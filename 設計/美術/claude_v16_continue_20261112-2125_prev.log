ne && S.choice === 'stage' && !seatEmpty(S) && wifeOf(S) !== 2) return '散了戏回到家，灯是她一个人点的，她已经睡了。你对着镜子，自己卸。';\n3498\t  if (alone) return '对面的椅子空着。你对着镜子，自己卸。';\n3499\t  return '元宵过了。她拧了一条热毛巾：“最后一回，我替你卸干净。”';\n3500\t}\n3501\tfunction lastAfter(alone) {\n3502\t  const f = FAM[topFams()[0]].n, b = S.base;\n3503\t  if (!b) return alone ? '擦干净了。镜子里，是你自己的脸。' : '擦干净了。毛巾上全是红，你脸上什么也没留下。她把这块毛巾叠好，放进木匣，最上面。';\n3504\t  if (b < 4) return alone ? `擦到最后，镜子里还有一层淡淡的「${f}」色，擦不掉了。屋里没有人跟你说一句“就这样吧”。` : `擦到最后，还有一层淡淡的「${f}」色，擦不掉了。她停下手：“就这样吧，也是你。”`;\n3505\t  return alone ? `擦了很久，镜子里那张脸还是戏里的「${f}」。你分不清，哪一层是自己。` : `毛巾换了三条，那层「${f}」的颜色还在。她看了你很久，把毛巾放下了。`;\n3506\t}\n3507\tfunction showWipe() {\n3508\t  const el = $('#wipe'), alone = lastAlone(), fams = topFams().filter(f => S.played[f] > 0);\n3509\t  const use = fams.length ? fams.slice(0, 3) : ['sing'];\n3510\t  el.hidden = false; el.dataset.done = '';\n3511\t  el.innerHTML = `<div class=\"tx\">${esc(lastIntro(alone))}</div><div class=\"face\"><canvas id=\"clean\" width=\"400\" height=\"500\"></canvas><canvas id=\"paint\" width=\"400\" height=\"500\" aria-label=\"脸上的油彩，拖动来卸掉\"></canvas></div>\n3512\t    <div class=\"tx2\">${alone ? '在脸上拖动，把油彩擦掉。' : '在脸上拖动：让她一层一层替你擦掉。'}</div><button class=\"opt\" data-act=\"wipekey\">${alone ? '擦一下' : '让她擦一下'}<small>也可以直接在脸上拖</small></button>`;\n3513\t  drawPortrait($('#clean'), { who: 'you', layers: [], base: S.base, baseF: topFams()[0], bg: ['#8d9396', '#3b4044'] });\n3514\t  const cv = $('#paint'), x = cv.getContext('2d');\n3515\t  drawPortrait(cv, { who: 'you', layers: Array.from({ length: 6 }, (_, i) => ({ f: use[i % use.length] })), base: S.base, baseF: topFams()[0] });\n3516\t  x.globalCompositeOperation = 'destination-in'; x.beginPath(); x.ellipse(200, 275, 110, 141, 0, 0, Math.PI * 2); x.fill();\n3517\t  x.globalCompositeOperation = 'destination-out';\n3518\t  let down = false, last = null;\n3519\t  const brush = (a, b) => { x.lineCap = 'round'; x.lineWidth = 62; x.beginPath(); x.moveTo(a[0], a[1]); x.lineTo