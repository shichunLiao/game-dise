{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SitVJ37VUQHddafwjbnLPv","type":"tool_result","content":"1962\tconst recipeShort = nd => nd.items.map(x => `${x.look}·${HOME[LOOK_HOME[x.look]].n}×${x.n}`).join(' + ');\n1963\tconst needTx = (nd = needOf(S)) => `要 ${nd.items.map(x => `<b>${HOME[LOOK_HOME[x.look]].n}</b>×${x.n}（${fc(famOfLook(x.look))}牌的背面）`).join(' + ')}`;\n1964\t// 3D 裡的東西在螢幕上的位置：教學框要指著它\n1965\tfunction anchor(name, at, w = 150, h = 150) {\n1966\t  let el = document.getElementById(`anc-${name}`);\n1967\t  if (!el) { el = document.createElement('div'); el.id = `anc-${name}`; $('#anchors').appendChild(el); }\n1968\t  if (!glOK) { el.style.display = 'none'; return null; }\n1969\t  const v = at.clone().project(camera);\n1970\t  if (v.z > 1 || Math.abs(v.x) > 0.95 || Math.abs(v.y) > 0.95) { el.style.display = 'none'; return null; }\n1971\t  const x = (v.x + 1) / 2 * innerWidth, y = (1 - v.y) / 2 * innerHeight;\n1972\t  Object.assign(el.style, { display: 'block', left: `${x - w / 2}px`, top: `${y - h / 2}px`, width: `${w}px`, height: `${h}px` });\n1973\t  return el;\n1974\t}\n1975\t// v1.5 教學：第 1 天手把手（做對了就往下，不用按「知道了」）；只看不做的步驟只留四處；其餘改成不擋畫面的小提示（NUDGES）\n1976\tconst handCards = () => Array.from(document.querySelectorAll('#hand .hc'));\n1977\tconst firstPlayed = () => { const p = S.T.plays[0]; return p ? cardOf(S, p.id).t : 'changqiang'; };\n1978\tconst LESSONS = {\n1979\t  open: [\n1980\t    { at: () => [handOf('changqiang')], until: () => S.T.plays.length > 0, text: () => `金框的牌能打。第一张要打木牌上的起手${fc('sing')}：点「长腔」。`, tap: '点这张' },\n1981\t  ],\n1982\t  chain: [\n1983\t    { at: () => [handOf('bai')], until: () => S.T.plays.length > 1, text: () => `长腔写着「接 → ${fc('speak')}」。下一张打${fc('speak')}，就接上了，多拿金。点「白」。`, tap: '点这张' },\n1984\t  ],\n1985\t  chain2: [\n1986\t    { at: handCards, place: 'left', until: () => S.T.plays.length >= 4 || S.T.ended, text: () => '金框的牌都接得上。照「接」再打两张。' },\n1987\t  ],\n1988\t  end: [\n1989\t    { at: () => [$('[data-act=\"endstage\"]')], until: () => S.T.ended, text: () => '四张了，脸上也有四层油彩。见好就收：点收场。', tap: '点收场' },\n1990\t  ],\n1991\t  door: [\n1992\t    { at: () => [glOK ? anchor('mirror', new THREE.Vector3(1.32, TOP + 0.46, -0.02), 200, 200) : $('#topmid')], follow: true, title: '你的脸', text: () => '台上打几张，脸上就有几层油彩。', rule: '进门前卸掉；没卸的，会染到推给她的牌' },\n1993\t    { at: handCards, place: 'left', until: () => !S.T.layers.length || view !== 'door', text: () => '点一张牌弃掉，卸一层。卸干净再进门。' },\n1994\t  ],\n1995\t  home: [\n1996\t    { title: '一张牌，两面', vis: () => `<div class=\"flip\"><div class=\"fl\"><img src=\"${cardArt(firstPlayed(), 'stage').url}\" alt=\"\"><img class=\"b\" src=\"${cardArt(firstPlayed(), 'home').url}\" alt=\"\"></div><div class=\"cap\">台上面：<b>${T[firstPlayed()].n}</b><br>家里面：<b>${HOME[FAM[T[firstPlayed()].f].home].n}</b></div></div>`, text: () => '台上打掉、卸妆弃掉的牌，今晚就没了。', rule: '留在手里的，回家翻过来推给她' },\n1997\t    { at: () => [$('#homep')], title: '她的灯', text: () => '往后每晚她要一样东西，推对了，灯亮一片。', rule: '没满足她，灯熄一截' },\n1998\t  ],\n1999\t  intel: [\n2000\t    { at: () => [$('.intel')], title: '今晚她要', text: () => `今晚她${needTx()}。`, rule: '印着「家」的牌，留着别打上台' },\n2001\t  ],\n2002\t  need: [\n2003\t    { at: handCards, place: 'left', title: '被染', read: () => !S.T.box.some(id => !S.T.used[id] && canHome(S, id) && isMatch(S, id) && !willDye(S, id)) && !S.T.box.some(id => !S.T.used[id] && canHome(S, id) && !isMatch(S, id)), until: () => gotOf(S.T) >= S.T.need.k || S.T.pushed.length >= S.T.homeCap, text: () => { const n = HOME[LOOK_HOME[S.T.need.items[0].look]].n, spare = S.T.box.some(id => !S.T.used[id] && canHome(S, id) && !isMatch(S, id)); return !S.T.dye ? `点金框的「${n}」，推给她。` : spare ? `牌角红的会被染：先推一张不要紧的，再推她要的「${n}」。` : `脸没卸干净，牌角红的会被染：推了，灯上留一道痕。下回卸干净再进门。`; } },\n2004\t  ],\n2005\t  pick: [\n2006\t    { at: () => [$('.spread')], title: '自己装妆匣', text: () => '上面是你的卡组：点一张，放进妆匣（下面一排）；点下面的，拿回去。', rule: '起手那一族一定要带；印着「家」的是她今晚要的' },\n2007\t  ],\n2008\t};\n2009\t// 小提示：不擋畫面、不用按；每條只出一次，同一時刻只有一條\n2010\tconst NUDGES = {\n2011\t  board: { at: () => $('#wboard'), when: () => view === 'morning' && S.day >= 2, tx: () => `<b>水牌</b>你和同门按卖座排名。第 3 天散戏后垫底，就被摘牌。` },\n2012\t  book: { at: () => $('#bookBtn'), when: () => view === 'morning' && S.day >= 2 && S.tut.seen.board, tx: () => '<b>图鉴</b>看不懂的牌和词，都在这里。' },\n2013\t  crowd: { at: () => $('.bub.intel'), when: () => view === 'stage', tx: () => '<b>台下的话</b>金框那句说的是她今晚要什么，会记在上面那一排。' },\n2014\t  wipe: { at: () => $('[data-act=\"wipe\"]'), when: () => view === 'door', tx: () => `<b>让她擦</b>一次擦 ${R.wipeLayers} 层，不耗牌；但今晚她只听得下 1 张。` },\n2015\t  stakes: { at: () => $('#homep'), when: () => view === 'night' && S.day >= 2 && !$('#lampfb:not([hidden])'), tx: () => `<b>她会走</b>灯熄满 ${R.brokenOuts} 回，或痕到 ${R.brokenScar} 道。` },\n2016\t  shop: { at: () => $('[data-act=\"shop\"]'), when: () => view === 'morning', tx: () => '<b>后台</b>孙师父卖牌和物件。花的就是卖座，名次会掉；越早买越划算。' },\n2017\t  wild: { at: () => $('.hc[data-wild].play'), when: () => view === 'stage', tx: () => '<b>百搭</b>前后都接得上，还能起手。链要断的时候用它。' },\n2018\t  grudge: { at: () => $('.nowline'), when: () => view === 'stage' && S.T.grudge > 0, tx: () => '<b>怨气</b>接错了，嘘声跟你回家：今晚多染一张牌。' },\n2019\t  gift: { at: () => $('.spread .spc[data-t^=\"home_\"]') || $('.spread'), when: () => view === 'morning' && S.gifts.length > 0 && !lockedBox(S), tx: () => '<b>家常牌</b>她送的，不上台。对上她的需要，一张算两张。' },\n2020\t};\n2021\tconst coach = { lesson: null, i: 0, shown: '' };\n2022\tfunction lessonNow() {\n2023\t  if (panel || sheet) return null;\n2024\t  const d = S.day, t = S.T;\n2025\t  if (view === 'stage') {\n2026\t    if (d !== 1) return null;\n2027\t    if (t.ended) return null;\n2028\t    return !t.plays.length ? 'open' : t.plays.length === 1 ? 'chain' : t.plays.length < 4 && !t.plays.some(p => p.broke) ? 'chain2' : t.plays.length >= 4 ? 'end' : null;\n2029\t  }\n2030\t  if (d === 1 && view === 'door' && t.layers.length) return 'door';\n2031\t  if (d === 1 && view === 'night') return 'home';\n2032\t  if (d === 2 && view === 'evening' && t.pushed.length === 0) return 'need';\n2033\t  if (view === 'morning' && !lockedBox(S) && d === 3) return 'pick';\n2034\t  if (view === 'morning' && d === 2) return 'intel';\n2035\t  return null;\n2036\t}\n2037\tfunction coachStart(k) { coach.lesson = k; coach.i = 0; coach.shown = ''; coach.view = view; }\n2038\tfunction coachNext() {\n2039\t  if (!coach.lesson) return;\n2040\t  coach.i += 1;\n2041\t  if (coach.i < LESSONS[coach.lesson].length) return;\n2042\t  S.tut.seen[coach.lesson] = true;\n2043\t  coach.lesson = null;\n2044\t  if ([...Object.keys(LESSONS), ...Object.keys(NUDGES)].every(k => S.tut.seen[k])) setTutPref(false);\n2045\t}\n2046\tfunction coachSkip() { S.tut.off = true; coach.lesson = null; setTutPref(false); nudgeHide(true); }\n2047\t// 狀態一變就看一次：要玩家做的事做到了就往下；這個時段還沒教過就開始教\n2048\tfunction coachTick() {\n2049\t  if (busy || !S || view === 'title' || !S.tut) return;\n2050\t  for (let n = 0; n < 4; n++) {\n2051\t    if (coach.lesson) {\n2052\t      // 換了場景：這一課就算教完了，不跟著帶過去\n2053\t      if (view !== coach.view) { S.tut.seen[coach.lesson] = true; coach.lesson = null; continue; }\n2054\t      const st = LESSONS[coach.lesson][coach.i];\n2055\t      if (!st.until || !st.until()) return;\n2056\t      coachNext();\n2057\t    } else {\n2058\t      const k = lessonNow();\n2059\t      if (!k || S.tut.off || S.tut.seen[k]) return nudgeTick();\n2060\t      coachStart(k);\n2061\t    }\n2062\t  }\n2063\t}\n2064\tfunction coachRender(geom = false) {\n2065\t  const el = $('#coach'), on = !!S && !!coach.lesson && !busy && view !== 'title' && panel !== 'rules';\n2066\t  $('#hud').inert = false;\n2067\t  if (!on) { el.hidden = true; return; }\n2068\t  const steps = LESSONS[coach.lesson], st = steps[coach.i], key = `${coach.lesson}:${coach.i}`;\n2069\t  const els = st.at ? st.at().filter(x => x && x.getClientRects().length) : [];\n2070\t  const act = !!st.until && els.length > 0 && !(st.read && st.read());\n2071\t  if (coach.shown !== key && st.on) st.on();\n2072\t  if (coach.shown !== key && els[0] && !els[0].closest('#anchors')) els[0].scrollIntoView({ block: 'nearest', inline: 'center' });\n2073\t  let r = null;\n2074\t  els.forEach(x => { const b = x.getBoundingClientRect(); r = r ? { l: Math.min(r.l, b.left), t: Math.min(r.t, b.top), r: Math.max(r.r, b.right), b: Math.max(r.b, b.bottom) } : { l: b.left, t: b.top, r: b.right, b: b.bottom }; });\n2075\t  const W = innerWidth, H = innerHeight, pad = act ? 5 : 8;\n2076\t  if (r) r = { l: Math.max(4, r.l - pad), t: Math.max(4, r.t - pad), r: Math.min(W - 4, r.r + pad), b: Math.min(H - 4, r.b + pad) };\n2077\t  el.hidden = false;\n2078\t  hidePeek();\n2079\t  const doing = act ? `<span class=\"do\">${esc(st.tap || '点亮起来的地方')}</span>` : `<button class=\"btn go small\" data-act=\"coachnext\">${coach.i < steps.length - 1 ? '下一句' : '好'}</button>`;\n2080\t  el.classList.toggle('doing', act);\n2081\t  // 只挪位置（鏡頭在動）：不重建，免得說明框重播淡入\n2082\t  const keep = geom && coach.shown === key && el.querySelector('.cbox') && !!el.querySelector('.ring') === !!r;\n2083\t  if (!keep) el.innerHTML = `<div class=\"dim\"></div><div class=\"shield\"></div>${r ? `<div class=\"ring\" ${act && st.tap ? `data-tap=\"${esc(st.tap)}\"` : ''}></div>` : ''}\n2084\t    <div class=\"cbox\" role=\"dialog\" aria-label=\"${esc(st.title || '教学')}\" aria-describedby=\"coachX\">${steps.length > 1 && !act ? `<span class=\"step\">${coach.i + 1}/${steps.length}</span>` : ''}${st.title && !act ? `<h4 id=\"coachT\">${st.title}</h4>` : ''}${st.vis ? st.vis() : ''}<div class=\"tx\" id=\"coachX\">${termify(st.text())}</div>${st.rule ? `<p class=\"rule\">${termify(typeof st.rule === 'function' ? st.rule() : st.rule)}</p>` : ''}\n2085\t      <div class=\"row\">${doing}<button class=\"skip\" data-act=\"coachskip\">不用教了</button></div><i class=\"arrow\" aria-hidden=\"true\"></i></div>`;\n2086\t  const path = `path(evenodd, 'M0 0H${W}V${H}H0Z${r ? `M${r.l} ${r.t}H${r.r}V${r.b}H${r.l}Z` : ''}')`;\n2087\t  el.querySelector('.dim').style.clipPath = path;\n