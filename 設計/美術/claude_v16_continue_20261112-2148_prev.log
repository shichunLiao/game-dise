-items: center; }","+.sunq .pt { width: 64px; height: 96px; flex: none; box-shadow: 0 0 0 1px #1c1719, 0 4px 10px rgba(0, 0, 0, .35); }","+/* 紙：米白紙頁的毛邊（九宮格），標題下一筆朱紅；深色紙給燈的回饋、骰子 */","+html.a-paper .panel { background: none; border: 0 solid transparent; border-image: var(--ui-paper) 128 fill / 24px / 10px stretch; box-shadow: none; filter: drop-shadow(0 12px 24px rgba(0, 0, 0, .55)); padding: 18px 22px 20px; }","+html.a-brush .panel h2 { padding-bottom: 8px; background: var(--ui-brush) 0 100% / min(280px, 72%) 14px no-repeat; }","+html.a-paperdk #lampfb .lf, html.a-paperdk #dice .dbox { background: none; border: 0 solid transparent; border-image: var(--ui-paper-dk) 150 fill / 26px / 12px stretch; box-shadow: none; filter: drop-shadow(0 14px 28px rgba(0, 0, 0, .75)); }","+/* 印：「家」、「完美」用方印底（白文）；結局字壓在圓印上 */","+html.a-seal .wtag { background: var(--ui-seal) center / 100% 100% no-repeat; border-radius: 0; box-shadow: none; filter: drop-shadow(0 2px 3px rgba(0, 0, 0, .6)); color: #f6ecd9; }","+html.a-seal .stamp { background: var(--ui-seal) center / 100% 100% no-repeat; border: 0; color: #f6ecd9; padding: 14px 30px 16px; text-shadow: none; filter: drop-shadow(0 6px 14px rgba(0, 0, 0, .6)); }","+html.a-sealr .watch .end { display: flex; align-items: center; justify-content: center; width: 2.6em; height: 2.6em; padding-left: .2em; background: var(--ui-seal-r) center / 100% 100% no-repeat; color: #f6ecd9; letter-spacing: .2em; line-height: 1.1; text-align: center; font-size: clamp(30px, 6vh, 50px); filter: drop-shadow(0 6px 16px rgba(0, 0, 0, .7)); }","+/* 熄：五根燈芯，熄過一回就換成熄掉的那根；深色框裡的燈芯換成紙色 */","+html.a-wick .outs i, html.a-wick .homep .outs i { width: 10px; height: 18px; border: 0; border-radius: 0; background: var(--ui-wick) 50% 48% / auto 250% no-repeat; box-shadow: none; }","+html.a-wick .outs i.on, html.a-wick .homep .outs i.on { background-image: var(--ui-wick-out); box-shadow: none; }","+html.a-wick #lampfb .outs i { background-image: var(--ui-wick-l); }","+html.a-wick #lampfb .outs i.on { background-image: var(--ui-wick-out-l); }","+html.a-wick .outs i.new { animation: wickOut 1.1s ease both; }","+@keyframes wickOut { 0% { transform: scale(2.2); filter: drop-shadow(0 0 6px #ffb070); } 100% { transform: none; filter: none; } }","+/* 痕：一道墨劃痕；還沒有的那幾道淡淡的 */","+html.a-scar .scars i, html.a-scar .homep .scars i { width: 8px; height: 22px; background: var(--ui-scar) 50% 50% / 100% auto no-repeat; transform: none; opacity: .16; }","+html.a-scar .scars i.on, html.a-scar .homep .scars i.on { background-color: transparent; opacity: 1; }","+html.a-scar .homep .hrow.hot .scars i.on { filter: drop-shadow(0 0 3px rgba(200, 40, 58, .9)); }","+/* 散戲的金箔：圖集裡隨機一片 */","+html.a-gold .fleck { width: 18px; height: 18px; background: var(--fx-gold) 0 0 / 400% 400% no-repeat; }","+/* 更夫報更：夜空、遠山城牆、屋脊戲樓、近處屋簷燈籠、月亮（字放在中間的空白裡） */","+html.a-night .watch { background: linear-gradient(180deg, #07070b 0%, #0e0f17 42%, #22232f 78%, #2c2c38 100%); }","+.watch .nite { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }","+.watch .nite img { position: absolute; left: 50%; width: max(100%, 1100px); height: auto; transform: translateX(-50%); }","+.watch .nite .n1 { bottom: 0; opacity: .5; animation: nDrift 26s ease-in-out infinite alternate; }","+.watch .nite .n2 { bottom: -2px; animation: nDrift 19s ease-in-out infinite alternate-reverse; }","+.watch .nite .n3 { top: 0; width: max(108%, 1180px); animation: nDrift 14s ease-in-out infinite alternate; }","+.watch .nite .mn { left: auto; right: 15%; top: 8vh; width: clamp(80px, 15vh, 150px); transform: none; opacity: .92; filter: drop-shadow(0 0 22px rgba(236, 227, 212, .35)); }","+.watch > :not(.nite) { position: relative; z-index: 1; }","+@keyframes nDrift { from { transform: translateX(calc(-50% - 8px)); } to { transform: translateX(calc(-50% + 8px)); } }","+@media (prefers-reduced-motion: reduce) { .watch .nite img { animation: none; } }","+@media (max-width: 760px) { .watch .nite .mn { right: 8%; top: 