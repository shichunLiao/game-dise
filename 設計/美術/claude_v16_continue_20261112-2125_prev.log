:97,"lines":[" const CROWD_AT = [[-1.02, 0.34, 1.05], [-0.8, 0.5, 1.2], [-0.56, 0.4, 0.95], [-0.3, 0.6, 1.1], [-0.02, 0.5, 1.0], [0.27, 0.6, 1.15], [0.55, 0.4, 0.95], [0.8, 0.52, 1.2], [1.03, 0.34, 1.05],","   [-0.92, 0.25, 0.8], [-0.68, 0.27, 0.78], [-0.42, 0.28, 0.82], [-0.16, 0.3, 0.76], [0.14, 0.3, 0.8], [0.4, 0.28, 0.78], [0.66, 0.27, 0.82], [0.92, 0.25, 0.8],","   [-1.22, 0.05, 0.9], [1.22, 0.05, 0.9]];","+// v1.6：剪紙觀眾圖（純黑剪影）→ 加紅紙邊：只沿外輪廓（從邊上灌水分出外面），鏤空保持透明；底邊切齊不留邊","+const CROWD_PAD = 8, CROWD_RIM = 5, crowdTex = {};","+function crowdCv(im) {","+  const P = CROWD_PAD, iw = Math.round(im.width / 2), ih = Math.round(im.height / 2), W = iw + P * 2, H = ih + P, N = W * H;","+  const c = document.createElement('canvas'); c.width = W; c.height = H;","+  const x = c.getContext('2d'); x.imageSmoothingQuality = 'high'; x.drawImage(im, P, P, iw, ih);","+  const img = x.getImageData(0, 0, W, H), d = img.data, out = new Uint8Array(N), q = new Int32Array(N);","+  let qh = 0, qt = 0;","+  const push = i => { if (!out[i] && d[i * 4 + 3] < 128) { out[i] = 1; q[qt++] = i; } };","+  for (let X = 0; X < W; X++) { push(X); push((H - 1) * W + X); }","+  for (let y = 0; y < H; y++) { push(y * W); push(y * W + W - 1); }","+  while (qh < qt) { const i = q[qh++], X = i % W; if (X > 0) push(i - 1); if (X < W - 1) push(i + 1); if (i >= W) push(i - W); if (i < N - W) push(i + W); }","+  // 外面每一點到剪影的距離（兩趟倒角），近的染成紅紙","+  const dist = new Float32Array(N);","+  for (let i = 0; i < N; i++) dist[i] = out[i] ? 1e6 : 0;","+  for (let y = 0; y < H; y++) for (let X = 0; X < W; X++) {","+    const i = y * W + X; if (!dist[i]) continue; let m = dist[i];","+    if (X > 0) m = Math.min(m, dist[i - 1] + 1);","+    if (y > 0) { m = Math.min(m, dist[i - W] + 1); if (X > 0) m = Math.min(m, dist[i - W - 1] + 1.414); if (X < W - 1) m = Math.min(m, dist[i - W + 1] + 1.414); }","+    dist[i] = m;","+  }","+  for (let y = H - 1; y >= 0; y--) for (let X = W - 1; X >= 0; X--) {","+    const i = y * W + X; if (!dist[i]) continue; let m = dist[i];","+    if (X < W - 1) m = Math.min(m, dist[i + 1] + 1);","+    if (y < H - 1) { m = Math.min(m, dist[i + W] + 1); if (X < W - 1) m = Math.min(m, dist[i + W + 1] + 1.414); if (X > 0) m = Math.min(m, dist[i + W - 1] + 1.414); }","+    dist[i] = m;","+  }","+  for (let i = 0; i < N; i++) {","+    if (!out[i]) continue;","+    const a = Math.max(0, Math.min(1, CROWD_RIM + 0.5 - dist[i]));","+    if (!a) continue;","+    const k = i * 4, a0 = d[k + 3] / 255;","+    d[k] = Math.round(0xb3 * (1 - a0) + d[k] * a0); d[k + 1] = Math.round(0x20 * (1 - a0) + d[k + 1] * a0); d[k + 2] = Math.round(0x2c * (1 - a0) + d[k + 2] * a0);","+    d[k + 3] = Math.round(255 * Math.max(a, a0));","+  }","+  x.putImageData(img, 0, 0);","+  return c;","+}","+function crowdTexOf(p) {","+  if (crowdTex[p]) return crowdTex[p];","+  const im = artImg(p);","+  if (!im) return null;","+  const t = new THREE.CanvasTexture(crowdCv(im)); t.anisotropy = 4;","+  return (crowdTex[p] = t);","+}","+const CROWD_DIR = [0, Math.cos(0.62), -Math.sin(0.62)];","+// 前排九格：叫好組 b01–b04、倒彩組 b05–b08 交錯，正中一格輪換 a；中排六格、兩側兩格輪換 a；後排八格是遠處小影 c01–c08","+const CROWD_MID = [[-0.68, 0.38, 0.9], [-0.42, 0.45, 0.92], [-0.15, 0.39, 0.9], [0.12, 0.45, 0.92], [0.41, 0.39, 0.9], [0.69, 0.45, 0.92]];","+const CROWD_FRONT_B = [1, 5, 2, 6, 0, 7, 3, 8, 4];","+const crowdA = () => crowd.filter(c => c.kind === 'a');","+function buildCrowdArt(g) {","+  const two = n => String(n).padStart(2, '0');","+  const slots = [...CROWD_AT.map((at, i) => [at, i < 9 ? (CROWD_FRONT_B[i] ? `b${two(CROWD_FRONT_B[i])}` : 'a') : i < 17 ? `c${two(i - 8)}` : 'a']), ...CROWD_MID.map(at => [at, 'a'])];","+  const geo = {};","+  crowd = slots.map(([[x0, z0, k], who], i) => {","+    const kind = who[0], hf = 0.275 * k, w = 0.22 * k * (256 + CROWD_PAD * 2) / 256, h = hf * (320 + CROWD_PAD) / 320;","+    const idle = kind === 'a' ? null : crowdTexOf(kind === 'b' ? `crowd/${who}_idle.png` : `crowd/${who}.png`);","+    if (kind !== 'a' && !idle) return null;","+    const gk = `${w.toFixed(4)}|${h.toFixed(4)}`, gg = geo[gk] || (geo[gk] = new THREE.PlaneGeometry(w, h).translate(0, h / 2, 0));","+    const mat = new THREE.MeshBasicMaterial({ map: idle, transparent: true, alphaTest: 0.4, side: THREE.DoubleSide });","+    const sh = new THREE.Mesh(gg, new THREE.MeshBasicMaterial({ map: idle, color: 0x000000, transparent: true, opacity: 0.5, depthWrite: false }));","+    sh.position.set(w * 0.07, -hf * 0.03, -0.022); sh.renderOrder = -1;","+    const piv = new THREE.Group(); piv.position.set(x0, TOP + 0.013 * hf, z0 + 0.29 * hf); piv.rotation.x = -0.62;","+    piv.add(sh, new THREE.Mesh(gg, mat)); crowdG.add(piv);","+    const c = { m: piv, mat, sh, y0: piv.position.y, h: hf, hf, headK: kind === 'c' ? 0.42 : 0.86, kick: null, phase: i * 1.7, front: i < 9, side: x0 < -0.4 ? 'L' : x0 > 0.4 ? 'R' : 'C', kind, who };","+    if (kind === 'b') { c.idle = idle; c.act = crowdTexOf(`crowd/${who}_act.png`) || idle; c.grp = +who.slice(1) <= 4 ? 'cheer' : 'boo'; c.actFrom = 0; c.actTo = 0; }","+    return c;","+  });","+  // 有一格的圖載不到：這一格退回 v1.5 的剪影","+  crowd = crowd.map((c, i) => c || crowdFallback(slots[i][0], i));","+  crowdDress(1);","+}","+// a 組十六張，每天換一批人坐（中間、中排、兩側共九格）","+function crowdDress(day) {","+  if (!ART.on) return;","+  const two = n => String(n).padStart(2, '0');","+  crowdA().forEach((c, j) => {","+    const tex = crowdTexOf(`crowd/a${two(1 + ((day - 1) * 9 + j) % 16)}.png`) || c.mat.map;","+    if (tex && c.mat.map !== tex) { c.mat.map = tex; c.sh.material.map = tex; c.mat.needsUpdate = true; c.sh.material.needsUpdate = true; }","+    c.m.visible = !!c.mat.map;","+  });","+}","+function crowdFallback([x0, z0, k], i) {","+  const tex = new THREE.CanvasTexture(silhouetteCv(31 + i * 7)), w = 0.22 * k, h = 0.275 * k;","+  const m = new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshBasicMaterial({ map: tex, transparent: true, alphaTest: 0.4, side: THREE.DoubleSide }));","+  m.rotation.x = -0.62; m.position.set(x0, TOP + h * 0.42, z0); crowdG.add(m);","+  return { m, y0: m.position.y, h, kick: null, phase: i * 1.7, front: i < 9, side: x0 < -0.4 ? 'L' : x0 > 0.4 ? 'R' : 'C' };","+}"," function buildCrowd(g) {","   crowdG = new THREE.Group(); crowdG.visible = false; g.add(crowdG);","+  if (ART.on && artImg('crowd/a01.png')) { buildCrowdArt(g); return; }","   crowd = CROWD_AT.map(([x0, z0, k], i) => {","     const tex = new THREE.CanvasTexture(silhouetteCv(31 + i * 7)), w = 0.22 * k, h = 0.275 * k;","     const m = new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshBasicMaterial({ map: tex, transparent: true, alphaTest: 0.4, side: THREE.DoubleSide }));"]}],"userModified":false,"replaceAll":false,"staleRecovered":true,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01PGcBgxPMXizwB12HChyQsh","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
