 / 2 + 8, innerWidth - w / 2 - 8), y = clamp(h.y - 8, ht + 8, innerHeight - 8);\n3085\t  b.el.style.left = `${x}px`; b.el.style.top = `${y}px`;\n3086\t  b.el.style.setProperty('--ax', `${clamp(h.x - (x - w / 2), 16, w - 16)}px`);\n3087\t}\n3088\tfunction bubTick() {\n3089\t  const now = performance.now();\n3090\t  bubs = bubs.filter(b => {\n3091\t    if (now < b.until || (b.kind === 'intel' && coach.lesson === 'crowd')) { placeBub(b); return true; }\n3092\t    b.el.classList.add('out'); setTimeout(() => b.el.remove(), 360);\n3093\t    return false;\n3094\t  });\n3095\t}\n3096\tsetInterval(bubTick, 120);\n3097\tfunction clearBubs() { bubs.forEach(b => b.el.remove()); bubs = []; }\n3098\t// 台下閒聊：沒人說話的時候，隔一陣有人開口；同門的事、戲台的事\n3099\tconst CHATTER = [`金宝今儿${K('嗓子')}不错。`, `月仙在侧幕${K('盯着你')}呢。`, `魏老板说，元宵要${K('定新头牌')}。`, '后排的，往前挤挤。', '今儿的灯笼是新换的。', `玉楼那张嘴，${K('什么都知道')}。`, '这出戏，我看过三回了。', `小凤的${K('嗓子')}，不知好了没有。`];\n3100\tconst chat = { day: 0, n: 0 };\n3101\tconst chatMax = () => (S.day === 1 ? 2 : !S.tut.off && S.day <= 2 ? 3 : 6);\n3102\tsetInterval(() => {\n3103\t  if (view !== 'stage' || busy || !S || S.T.ended || bubs.length >= 2 || document.hidden || coachOn() || panel) return;\n3104\t  if (chat.day !== S.day) { chat.day = S.day; chat.n = 0; }\n3105\t  if (chat.n >= chatMax()) return;\n3106\t  chat.n += 1;\n3107\t  bubble(pick(CHATTER), 'n', { side: Math.random() < 0.5 ? 'L' : 'R' });\n3108\t}, 7000);\n3109\t\n3110\t// ── 台上的特效：紙屑、金箔、彩綢、墨點、煙花（畫在 3D 上面、字的下面）──\n3111\tconst fxc = $('#stagefx'), fxx = fxc.getContext('2d');\n3112\tlet parts = [], fxOn = false, fxLast = 0;\n3113\tconst FXCOL = { petal: ['#c8283a', '#e0475a', '#f2d48a', '#efe2c8', '#a8202b'], foil: ['#f6dc96', '#e8c46a', '#fff3cf'], spark: ['#ffe9a8', '#f2d48a', '#fff'], ink: ['#120e11', '#2b2427', '#3a0a0e'], fw: ['#ffe9a8', '#ff8a6a', '#f2d48a', '#ffd0dc', '#fff'] };\n3114\tfunction fxSize() {\n3115\t  const d = Math.min(devicePixelRatio || 1, 2);\n3116\t  if (fxc.width !== Math.round(innerWidth * d) || fxc.height !== Math.round(innerHeight * d)) { fxc.width = Math.round(innerWidth * d); fxc.height = Math.round(innerHeight * d); }\n3117\t  fxx.setTransform(d, 0, 0, d, 0, 0);\n3118\t}\n3119\tfunction spawn(kind, n, o = {}) {\n3120\t  if (calm()) return;\n3121\t  if (view !== 'stage' && ['fw', 'foil', 'ribbon', 'petal'].includes(kind)) return;\n3122\t  fxSize();\n3123\t  const W = innerWidth, H = innerHeight;\n3124\t  for (let i = 0; i < n; i++) {\n3125\t    const p = { kind, t: 0, rot: Math.random() * 6.28, vr: (Math.random() - 0.5) * 9, col: pick(FXCOL[kind] || FXCOL.petal) };\n3126\t    if (kind === 'petal' || kind === 'foil') { p.x = Math.random() * W; p.y = -20 - Math.random() * H * 0.5; p.vx = (Math.random() - 0.5) * 70; p.vy = (kind === 'foil' ? 190 : 110) + Math.random() * 100; p.s = kind === 'foil' ? 5 + Math.random() * 7 : 7 + Math.random() * 9; p.life = 3.6; p.sw = Math.random() * 6.28; }\n3127\t    else if (kind === 'spark' || kind === 'fw') { const a = Math.random() * 6.28, v = (kind === 'fw' ? 180 : 120) + Math.random() * (kind === 'fw' ? 280 : 220); p.x = o.x; p.y = o.y; p.vx = Math.cos(a) * v; p.vy = Math.sin(a) * v - 70; p.s = 2 + Math.random() * 3; p.life = 0.7 + Math.random() * 0.6; }\n3128\t    else if (kind === 'ink') { const a = Math.random() * 6.28, v = 70 + Math.random() * 280; p.x = o.x; p.y = o.y; p.vx = Math.cos(a) * v; p.vy = Math.sin(a) * v - 90; p.s = 3 + Math.random() * 8; p.life = 0.9 + Math.random() * 0.5; }\n3129\t    else if (kind === 'ribbon') { p.side = i % 2 ? 1 : -1; p.y0 = H * (0.12 + Math.random() * 0.4); p.life = 2; p.ph = Math.random() * 6.28; p.col = i % 3 === 2 ? '#f2d48a' : '#c8283a'; p.w = 6 + Math.random() * 5; }\n3130\t    parts.push(p);\n3131\t  }\n3132\t  if (!fxOn) { fxOn = true; fxLast = performance.now(); requestAnimationFrame(fxLoop); }\n3133\t}\n3134\tfunction fxLoop(now) {\n3135\t  const dt = Math.min(0.05, (now - fxLast) / 1000), W = innerWidth;\n3136\t  fxLast = now;\n3137\t  fxx.clearRect(0, 0, W, innerHeight);\n3138\t  parts = parts.filter(p => (p.t += dt) < p.life);\n3139\t  for (const p of parts) {\n3140\t    fxx.globalAlpha = Math.min(1, (p.life - p.t) / 0.45);\n3141\t    if (p.kind === 'ribbon') {\n3142\t      const k = Math.min(1, p.t / (p.life * 0.55)), len = W * 0.55 * k;\n3143\t      fxx.strokeStyle = p.col; fxx.lineWidth = p.w; fxx.lineCap = 'round'; fxx.beginPath();\n3144\t      for (let s0 = 0; s0 <= len; s0 += 12) { const x = p.side < 0 ? s0 : W - s0, y = p.y0 + Math.sin(s0 * 0.018 + p.ph + p.t * 7) * 34 - s0 * 0.12; if (s0) fxx.lineTo(x, y); else fxx.moveTo(x, y); }\n3145\t      fxx.stroke(); continue;\n3146\t    }\n3147\t    const grav = p.kind === 'petal' || p.kind === 'foil' ? 0 : 520;\n3148\t    p.vy += grav * dt; p.x += (p.vx + (p.sw !== undefined ? Math.sin(p.t * 3 + p.sw) * 40 : 0)) * dt; p.y += p.vy * dt; p.rot += p.vr * dt;\n3149\t    fxx.save(); fxx.translate(p.x, p.y); fxx.rotate(p.rot); fxx.fillStyle = p.col;\n3150\t    if (p.kind === 'petal') { fxx.beginPath(); fxx.ellipse(0, 0, p.s, Math.max(0.5, p.s * 0.5 * Math.abs(Math.cos(p.t * 4 + p.sw))), 0, 0, 6.28); fxx.fill(); }\n3151\t    else if (p.kind === 'foil') { fxx.globalAlpha *= 0.6 + 0.4 * Math.abs(Math.sin(p.t * 9 + p.sw)); fxx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.7); }\n3152\t    else { fxx.beginPath(); fxx.arc(0, 0, p.s, 0, 6.28); fxx.fill(); }\n3153\t    fxx.restore();\n3154\t  }\n3155\t  fxx.globalAlpha = 1;\n3156\t  if (parts.length) requestAnimationFrame(fxLoop); else { fxOn = false; fxx.clearRect(0, 0, W, innerHeight); }\n3157\t}\n3158\t// 打出去那張牌在螢幕上的位置\n3159\tfunction cardScreen(i) {\n3160\t  if (!glOK) return { x: innerWidth / 2, y: innerHeight * 0.42 };\n3161\t  const v = cardSpot('stage', i).project(camera);\n3162\t  return { x: (v.x + 1) / 2 * innerWidth, y: (1 - v.y) / 2 * innerHeight };\n3163\t}\n3164\tfunction banner(tx, sub, cls = '') {\n3165\t  if (calm()) return;\n3166\t  $('#combo').innerHTML = `<div class=\"cb ${cls}\">${esc(tx)}</div>${sub ? `<div class=\"cs\">${esc(sub)}</div>` : ''}`;\n3167\t}\n3168\tfunction gainFloat(at, tx, bad) {\n3169\t  if (calm()) return;\n3170\t  const el = document.createElement('div'); el.className = `gainf ${bad ? 'bad' : ''}`; el.textContent = tx;\n3171\t  el.style.left = `${at.x}px`; el.style.top = `${at.y}px`; document.body.appendChild(el); setTimeout(() => el.remove(), 1300);\n3172\t}\n3173\t// 連擊越長，台上越熱鬧：火星 → 紙屑、幕晃、大字 → 金箔、彩綢、鏡頭推近 → 煙花\n3174\tconst COMBO_TX = { 3: ['好！', '连击 ×3'], 4: ['满堂红', '连击 ×4'], 5: ['绝了', '五连'] };\n3175\tfunction comboFx(p) {\n3176\t  const n = S.T.chain, at = cardScreen(S.T.plays.length - 1);\n3177\t  gainFloat(at, `+${p.g + p.extra + p.open + p.fin}`, p.broke);\n3178\t  if (p.broke) {\n3179\t    spawn('ink', 30, at);\n3180\t    banner('倒彩', p.grudge ? '怨气 +1：今晚多染一张' : p.saved ? '小锣一响，这回不记怨气' : '连击归零', 'bad');\n3181\t    if (glOK) $('#gl').animate([{ filter: 'saturate(.15) brightness(.6)' }, { filter: 'none' }], { duration: 750, easing: 'ease-out' });\n3182\t    return;\n3183\t  }\n3184\t  spawn('spark', 10 + n * 8, at);\n3185\t  lanternKick = Math.min(1.6, 0.35 * n);\n3186\t  if (n >= 2) swayKick = Math.max(swayKick, 0.35 * n);\n3187\t  if (n >= 3) { spawn('petal', 40 + (n - 3) * 35); const b = COMBO_TX[Math.min(n, 5)]; banner(b[0], b[1], n >= 4 ? 'big' : ''); }\n3188\t  if (n >= 4) { spawn('foil', 80); spawn('ribbon', 6); if (glOK && camPos) camPos.lerp(camAim, 0.08); }\n3189\t  if (n >= 5) [0, 350, 700].forEach(d => setTimeout(() => spawn('fw', 60, { x: innerWidth * (0.2 + Math.random() * 0.6), y: innerHeight * (0.12 + Math.random() * 0.2) }), d));\n3190\t}\n3191\tasync function run(fn) { if (busy) return; busy = true; refresh(); try { await fn(); } finally { busy = false; refresh(); } }\n3192\t\n3193\t// ── 一天 ──\n3194\t// 依目前時段擺桌面（開局、接著玩都走這裡）\n3195\tfunction placeScene() {\n3196\t  if (view !== 'stage') { clearBubs(); stageHeat = 0; }\n3197\t  if (!glOK) return;\n3198\t  const lk = lookNow(S);\n3199\t  const v = { morning: ['table', 'day'], stage: ['stage', 'stage'], d