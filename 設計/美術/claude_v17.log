ang', 'bai', 'kuaiban', 'shenduan', 'shuixiu', 'liangxiang', 'fanshen'];"," const BORROWED = ['jie_kutou', 'jie_guankou', 'jie_dadao'];","-const SHOP = ['manban', 'daoban', 'yunbai', 'shuban', 'woyu', 'tazhuan', 'qiba', 'jijifeng', 'qingchang', 'dingchang', 'tuoqiang', 'tangma'];","+const SHOP = ['manban', 'daoban', 'yunbai', 'shuban', 'woyu', 'tazhuan', 'qiba', 'jijifeng', 'qingchang', 'dingchang', 'tuoqiang', 'tangma', 'shuaya', 'shuaifa'];"," const GIFT = { care: 'tang', comp: 'fan', listen: 'xin', labor: 'zhi' };"," const GIFTS = Object.values(GIFT);"," // 第 1、2 天妝匣是替你裝好的：走得通一條四張鏈，四種家裡面都有"]},{"oldStart":824,"oldLines":7,"newStart":832,"newLines":7,"lines":[" "," function newGame(name, seed) {","   const s0 = (seed >>> 0) || 1;","-  const S = { v: 13, name, seed: s0, seed0: s0, day: 1, phase: 'morning', deck: [], nid: 1,","+  const S = { v: 17, name, wipes: R.wipes, seed: s0, seed0: s0, day: 1, phase: 'morning', deck: [], nid: 1,","     gold: 0, spent: 0, lamp: 0, lit: false, litAlone: false, scars: 0, base: 0, baseSeen: false, fengGold: 0, outs: 0,","     played: { sing: 0, speak: 0, act: 0, fight: 0 }, scarLog: [], rope: [], chest: [], log: [], lines: {}, choice: null, lastBox: null,","     looks: [], recipes: {}, pats: {}, events: {}, known: {}, met: [0, 0, 0, 0], gifts: [], bought: [], relics: [],"]},{"oldStart":862,"oldLines":15,"newStart":870,"newLines":10,"lines":["     stageMax: ev && ev.stageMax ? ev.stageMax : R.stageMax, perfectDie: Math.max(2, (ev && ev.die ? ev.die : R.perfectDie) - (has(S, 'cha') ? 1 : 0)),","     wiped: 0, homeCap: R.homeMax, pushed: [], dye: 0, grudge: 0, lampGain: 0, scarsToday: 0, reacts: [], matched: 0,","     need: needOf(S), got: {}, judged: false, met: null, lampOut: 0, gift: null, forecast: null, heard: false, freeBreak: has(S, 'luo'),","-    offers: [], sold: [], freeClean: 0, seep: 0, nightBase: 0, emptySeat: false, auto: false, watch: null, wasted: 0 };","+    offers: [], sold: [], refreshed: false, drumGold: 0, fenSaved