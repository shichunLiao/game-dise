.sin(p.t * 3 + p.sw) * 40 : 0)) * dt; p.y += p.vy * dt; p.rot += p.vr * dt;\n    fxx.save(); fxx.translate(p.x, p.y); fxx.rotate(p.rot); fxx.fillStyle = p.col;\n    if (p.kind === 'petal') { fxx.beginPath(); fxx.ellipse(0, 0, p.s, Math.max(0.5, p.s * 0.5 * Math.abs(Math.cos(p.t * 4 + p.sw))), 0, 0, 6.28); fxx.fill(); }\n    else if (p.kind === 'foil') { fxx.globalAlpha *= 0.6 + 0.4 * Math.abs(Math.sin(p.t * 9 + p.sw)); fxx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.7); }\n    else { fxx.beginPath(); fxx.arc(0, 0, p.s, 0, 6.28); fxx.fill(); }\n    fxx.restore();\n  }\n  fxx.globalAlpha = 1;\n  if (parts.length) requestAnimationFrame(fxLoop); else { fxOn = false; fxx.clearRect(0, 0, W, innerHeight); }\n}\n// 打出去那張牌在螢幕上的位置\nfunction cardScreen(i) {\n  if (!glOK) return { x: innerWidth / 2, y: innerHeight * 0.42 };\n  const v = cardSpot('stage', i).project(camera);\n  return { x: (v.x + 1) / 2 * innerWidth, y: (1 - v.y) / 2 * innerHeight };\n}\nfunction banner(tx, sub, cls = '') {\n  if (calm()) return;\n  $('#combo').innerHTML = `<div class=\"cb ${cls}\">${esc(tx)}</div>${sub ? `<div class=\"cs\">${esc(sub)}</div>` : ''}`;\n}\nfunction gainFloat(at, tx, bad) {\n  if (calm()) return;\n  const el = document.createElement('div'); el.className = `gainf ${bad ? 'bad' : ''}`; el.textContent = tx;\n  el.style.left = `${at.x}px`; el.style.top = `${at.y}px`; document.body.appendChild(el); setTimeout(() => el.remove(), 1300);\n}\n// 連擊越長，台上越熱鬧：火星 → 紙屑、幕晃、大字 → 金箔、彩綢、鏡頭推近 → 煙花\nconst COMBO_TX = { 3: ['好！', '连击 ×3'], 4: ['满堂红', '连击 ×4'], 5: ['绝了', '五连'] };\nfunction comboFx(p) {\n  const n = S.T.chain, at = cardScreen(S.T.plays.length - 1);\n  gainFloat(at, `+${p.g + p.extra + p.open + p.fin}`, p.broke);\n  if (p.broke) {\n    spawn('ink', 30, at);\n    banner('倒彩', p.grudge ? '怨气 +1：今晚多染一张' : p.saved ? '小锣一响，这回不记怨气' : '连击归零', 'bad');\n    if (glOK) $('#gl').animate([{ filter: 'saturate(.15) brightness(.6)' }, { filter: 'none' }], { duration: 750, easing: 'ease-out' });\n    return;