{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BkUD22MTxaS4zatQ25tipr","type":"tool_result","content":"2455\tfunction sayN(gain) { $('#sub').innerHTML = gain ? `<div class=\"sub n\"><span class=\"gain\">${esc(gain)}</span></div>` : ''; }\n2456\tfunction say(who, tx, gain) {\n2457\t  $('#sub').innerHTML = tx ? `<div class=\"sub\">${who ? `<span class=\"who\">${esc(who)}</span><br>` : ''}<span class=\"tx\">${esc(tx)}</span>${gain ? `<span class=\"gain\">${esc(gain)}</span>` : ''}</div>` : '';\n2458\t}\n2459\t// 帶高亮的字幕：需要、事件的詞會亮起來；gain 可以放情報小籤\n2460\tfunction sayH(who, html, gain) {\n2461\t  $('#sub').innerHTML = html ? `<div class=\"sub\">${who ? `<span class=\"who\">${esc(who)}</span><br>` : ''}<span class=\"tx\">${html}</span>${gain ? `<span class=\"gain\">${gain}</span>` : ''}</div>` : '';\n2462\t}\n2463\tconst fc = f => `<i class=\"fc\" style=\"background:${FCOL[f]};${f === 'fight' ? 'color:#1c1719' : ''}\">${FAM[f].n}</i>`;\n2464\tfunction refresh() {\n2465\t  const on = view !== 'title';\n2466\t  $('#hud').hidden = !on; $('#title').hidden = on;\n2467\t  if (!on) { renderTitle(); $('#coach').hidden = true; hidePeek(); return; }\n2468\t  // 規矩、後台、水牌攤開時，字幕先收起來，紙用整個中間\n2469\t  document.querySelector('.talk').hidden = !!panel;\n2470\t  $('#hud').dataset.v = view;\n2471\t  const mb = $('#musicBtn'); mb.setAttribute('aria-pressed', String(musicOn)); mb.textContent = musicOn ? '乐 开' : '乐 关'; mb.title = musicOn ? '背景音乐：开着（点一下关）' : '背景音乐：关着（点一下开）';\n2472\t  renderPlate(); renderBoardChip(); renderTop(); renderLeft(); renderMid(); renderChoices(); renderHand(); fitSpread(); peekSync(); renderSmear();\n2473\t  updateTable();\n2474\t  coachUpdate();\n2475\t  save();\n2476\t}\n2477\tfunction renderTitle() {\n2478\t  $('#title').innerHTML = `<div class=\"title-in\">\n2479\t    <div class=\"vb\"><div class=\"t\">底色</div><div class=\"s\">戏城 · 三幕</div></div>\n2480\t    <div>\n2481\t      <p class=\"intro\">你坐在戏班的桌前。十天，三幕。白天把牌排上戏台，傍晚把它翻过来，推给对面的阿檀。</p>\n2482\t      <p class=\"lede\">每打一张，脸上多一层油彩。没卸掉的油彩，会染上你推给她的牌，灯上就留一道痕。她每晚有一个需要，推不够，灯就熄一截。听台下的闲话、听她说往后几天的事，照着装匣。去后台买东西，花的就是卖座，名次会掉。灯熄满五回，她就走了；幕末考核垫底，牌子就被摘了——两样都会让这一季提前结束。</p>\n2483\t      <div class=\"form\">\n2484\t        <div class=\"field\"><label for=\"nm\">你的小名</label><input id=\"nm\" maxlength=\"6\" value=\"${esc(draftName)}\" autocomplete=\"off\"></div>\n2485\t        <label class=\"tg\"><input type=\"checkbox\" id=\"tutChk\" ${tutPref() ? 'checked' : ''}>带教学小框</label>\n2486\t        <button class=\"btn go\" data-act=\"start\">开锣</button>\n2487\t        ${saved ? `<button class=\"btn\" data-act=\"cont\">接着玩 · 第 ${saved.day} 天</button>` : ''}\n2488\t      </div>\n2489\t      <p class=\"hint\">${glOK ? '建议戴耳机、在大屏幕上玩。' : '这台设备显示不了 3D，卡牌和剧情照样能玩。'}约 55 分钟。所有数字都是占位，待试玩校准。</p>\n2490\t    </div></div>`;\n2491\t}\n2492\t// ── 詞條：教學、規矩裡的這些詞帶虛線，滑鼠停上去（手機點一下）就有說明 ──\n2493\tconst TERMS = {\n2494\t  卖座: '你唱戏挣的金。水牌按它排名；去后台买东西也花它，买了名次会掉。',\n2495\t  起手: '每天第一张必须打的那一族，写在木牌上。打对了叫「开得正」，多 1 金。',\n2496\t  接口: '每张牌写着「接 → 某一族」。下一张打那一族，就接上了，连击 +1。',\n2497\t  连击: '连着接上的张数。第 2 张起每张多拿金；接错了归零，已拿的金不扣。',\n2498\t  怨气: '第 2 天起，台上接错一次，台下就攒一点怨气。怨气会跟你回家，让你推给她的前几张牌被染。',\n2499\t  油彩: '台上每打一张牌，脸上多一层油彩（重彩两层、素不上妆），最多 4 层，再多就直接渗进底色。回家前要卸。',\n2500\t  底色: '没卸掉的油彩，睡一觉就渗进脸里，变成底色。底色只多不少：每 2 点，妆匣少一格；第三幕起，演得最多的那一族推给她时，会带着台上的字。',\n2501\t  被染: '脸上没卸掉的油彩和怨气，会染上你推给她的前几张牌（牌角有红）。推了被染的牌，灯上留一道痕。',\n2502\t  痕: '推了被染的牌，灯上划一道，永久。痕到 4 道，她就走了；美满要痕不超过 1。',\n2503\t  熄: '她当晚的需要没推够，灯熄一截（−3），记一回熄。熄满 5 回，她就走了；熄过一回，就到不了美满。',\n2504\t  灯: '阿檀糊的灯。推给她对路的牌 +2，家常牌 +3。糊满 30、一回没熄过、痕不超过 1、元宵回家点灯，才是美满。',\n2505\t  情报: '台下的闲话、她自己说的话里，藏着往后几晚她要什么。听到的记在上面那一排。',\n2506\t  考核: '第 3 天散戏后垫底、第 7 天散戏后排倒数两名，牌子就被摘了，这一季提前结束。',\n2507\t  百搭: '接在什么后面都算接上；它后面打哪一族也都接得上，还能起手。',\n2508\t  重彩: '金高，但脸上多一层油彩。',\n2509\t  压轴: '第 4 张起打出，另加金。',\n2510\t  素: '打出不上妆，脸上不添层。',\n2511\t  托: '接上时，这一张的连击金翻倍。',\n2512\t  家常牌: '她送你的牌，不上台。对上她的需要，一张算两张，灯 +3。',\n2513\t  完美: '收场时连击到 3，掷一颗骰，4 以上，这一场的金 ×1.5。',\n2514\t  让她擦: '卸妆的一种：她替你擦，一次 2 层、不耗牌；但这一晚她只听得下 1 张。',\n2515\t};\n2516\t// 自動加虛線的只取這幾個（單字的牌名關鍵詞不自動加，免得「素着脸」也冒虛線）\n2517\tconst AUTO_TERMS = ['卖座', '起手', '接口', '连击', '怨气', '油彩', '底色', '被染', '痕', '熄', '情报', '考核', '家常牌', '完美', '让她擦'];\n2518\tconst TERM_RE = new RegExp(AUTO_TERMS.sort((a, b) => b.length - a.length).join('|'), 'g');\n2519\t// 把一段 HTML 裡第一次出現的詞條包起來（標籤裡面的不動）\n2520\tfunction termify(html) {\n2521\t  const done = new Set();\n2522\t  return html.split(/(<[^>]+>)/).map((seg, i, all) => {\n2523\t    if (seg.startsWith('<') || (i > 0 && /class=\"term\"/.test(all[i - 1]))) return seg;\n2524\t    return seg.replace(TERM_RE, w => (done.has(w) ? w : (done.add(w), `<i class=\"term\" data-term=\"${w}\" tabindex=\"0\">${w}</i>`)));\n2525\t  }).join('');\n2526\t}\n2527\tconst tipEl = () => $('#tip');\n2528\tfunction showTip(el) {\n2529\t  const k = el.dataset.term, raw = k ? [k, TERMS[k]] : (el.dataset.tip || '').split('|');\n2530\t  if (!raw[1]) return;\n2531\t  const t = tipEl();\n2532\t  t.innerHTML = `<b>${esc(raw[0])}</b>${esc(raw[1])}`;\n2533\t  t.hidden = false;\n2534\t  const r = el.getBoundingClientRect(), w = t.offsetWidth, h = t.offsetHeight;\n2535\t  const below = r.bottom + h + 10 < innerHeight;\n2536\t  t.style.left = `${clamp((r.left + r.right) / 2 - w / 2, 8, innerWidth - w - 8)}px`;\n2537\t  t.style.top = `${below ? r.bottom + 8 : r.top - h - 8}px`;\n2538\t}\n2539\tconst hideTip = () => { tipEl().hidden = true; };\n2540\tdocument.addEventListener('pointerover', e => { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); });\n2541\tdocument.addEventListener('focusin', e => { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); });\n2542\tdocument.addEventListener('pointerdown', e => { if (e.pointerType !== 'mouse') { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); } });\n2543\t// 熄過幾回、痕幾道：到了上限，她就走了\n2544\tconst outsHTML = (fresh = false) => `<span class=\"outs\">${Array.from({ length: R.brokenOuts }, (_, i) => `<i class=\"${i < S.outs ? 'on' : ''} ${fresh && i === S.outs - 1 ? 'new' : ''}\"></i>`).join('')}</span>`;\n2545\tconst scarsHTML = () => `<span class=\"scars\">${Array.from({ length: R.brokenScar }, (_, i) => `<i class=\"${i < S.scars ? 'on' : ''}\"></i>`).join('')}</span>`;\n2546\tfunction renderPlate() {\n2547\t  const st = starterOf(S);\n2548\t  const stOn = st && ['morning', 'stage'].includes(view);\n2549\t  $('#plate').innerHTML = `<div class=\"d\">第 ${S.day} 天</div>\n2550\t    <div class=\"st\" ${stOn ? '' : 'hidden'}>起手 ${stOn ? fc(st) : ''}</div><div class=\"g\"><i class=\"term\" data-term=\"卖座\">卖座</i><b>${S.gold}</b></div>`;\n2551\t  // 左欄跟在木牌底下\n2552\t  const lc = $('#leftcol'); lc.style.top = innerWidth > 760 ? `${Math.round($('#plate').getBoundingClientRect().bottom + 8)}px` : '';\n2553\t}\n2554\t// 考核的底線怎麼說\n2555\tconst examTx = ne => (ne.fail === R.ranks ? '别垫底' : `别进倒数${['', '两', '三', '四'][R.ranks - ne.fail] || ''}名`);\n2556\t// 右上的水牌小牌：名次，和上一名差多少；下一次考核\n2557\tfunction renderBoardChip() {\n2558\t  const el = $('#wboard');\n2559\t  if (['board', 'lastwipe', 'reveal', 'watch'].includes(view) || !uiOn.board()) { el.innerHTML = ''; return; }\n2560\t  const b = boardOf(S), i = b.findIndex(r => r.me), up = b[i - 1], dn = b[i + 1];\n2561\t  const gap = boardDay(S) < 1 ? '还没开锣' : up ? `差${esc(up.n)} ${up.g - S.gold + 1}` : dn ? `领先${esc(dn.n)} ${S.gold - dn.g}` : '';\n2562\t  const ne = nextExam(S), bad = ne && i + 1 >= ne.fail && boardDay(S) >= 1;\n2563\t  const ex = ne && (bad || ne.day - S.day <= 1) ? `<span class=\"exam ${bad ? 'bad' : ''}\">${ne.day === S.day ? '今天' : '明天'}散戏后<i class=\"term\" data-term=\"考核\">考核</i>：${examTx(ne)}</span>` : '';\n2564\t  // 主畫面直接看三行：上一名、你、下一名（第一就看下兩名，墊底就看上兩名）\n2565\t  const from = clamp(i - 1, 0, b.length - 3), rows = b.slice(from, from + 3).map((r, k) => `<li class=\"${r.me ? 'me' : ''} ${ne && from + k + 1 === ne.fail ? 'fail' : ''}\"><span><span class=\"n\">${from + k + 1}</span>${r.me ? '你' : esc(r.n)}</span><span>${r.g}</span></li>`).join('');\n2566\t  const fresh = !(S.ui && S.ui.board);\n2567\t  if (!S.ui) S.ui = {};\n2568\t  S.ui.board = true;\n2569\t  el.innerHTML = `<button class=\"wb ${fresh ? 'popin' : ''}\" data-act=\"water\" aria-label=\"水牌第 ${i + 1}，${gap}${ne ? `，第 ${ne.day} 天考核${examTx(ne)}` : ''}。点开看全部\"><span class=\"wbh\"><span>水牌</span><span>第 <b>${i + 1}</b> / ${b.length}</span></span><ol>${rows}</ol><span class=\"dif\">${gap}</span>${ex}</button>${S.relics.length ? `<div class=\"relics\" aria-label=\"物件\">${S.relics.map(r => `<button class=\"rel\" data-tip=\"${esc(RELICS[r].n)}|${esc(RELICS[r].tx)}\" aria-label=\"${esc(RELICS[r].n)}：${esc(RELICS[r].tx)}\">${RELICS[r].n}</button>`).join('')}</div>` : ''}`;\n2570\t}\n2571\t// 情報：聽來的需要，按段排；今晚的那一條亮著\n2572\tfunction intelHTML(onlyNow = false) {\n2573\t  if (seatEmpty(S)) return '';\n2574\t  const items = [];\n2575\t  // 今晚的需要已經過了（夜裡、吃完飯），就從明天記起\n2576\t  for (let d = view === 'night' || S.T.judged ? S.day + 1 : S.day; d < (onlyNow ? S.day + 1 : R.days); d++) if (S.known[d]) items.push({ d, nd: needOf(S, d) });\n2577\t  if (!items.length) return '';\n2578\t  const lab = d => (d === S.day ? '今晚' : d === S.day + 1 ? '明晚' : `第${d}天`);\n2579\t  return `<div class=\"intel\" role=\"note\" aria-label=\"情报\"><span class=\"lbl\">情报</span>${items.map(it => `<span class=\"ic ${it.d === S.day ? 'now' : ''}\"><span class=\"d\">${lab(it.d)}</span>${it.nd.items.map(x => `${lookIcon(x.look)}${x.look} → <b>${HOME[LOOK_HOME[x.look]].n}</b>×${x.n}`).join(' + ')}</span>`).join('')}</div>`;\n2580\t}\n2581\t// 這一種牌的背面是她今晚要的（早上攤開的牌用）\n2582\tconst needKind = k => !!S.known[S.day] && !seatEmpty(S) && S.choice !== 'stage' && S.choice !== 'lamp' && !T[k].blank && needOf(S).items.some(x => x.look === (T[k].home ? HOME[FAM[T[k].f].home].look : HOME[FAM[T[k].f].home].look));\n2583\t// 這張牌的背面是她今晚要的：台上留著、卸妝別弃\n2584\tconst keepHint = id => !!S.known[S.day] && !seatEmpty(S) && S.choice !== 'stage' && S.choice !== 'lamp' && !tOf(S, id).blank && needOf(S).items.some(x => x.look === lookOfCard(S, id));\n2585\tconst gotOf = t => t.need.items.reduce((a, x) => a + Math.min(x.n, t.got[x.look] || 0), 0);\n2586\tfunction renderTop() {\n2587\t  const m = $('#topmid'), t = S.T;\n2588\t  if (view === 'stage') {\n2589\t    const parts = [];\n2590\t    for (let i = 0; i < t.stageMax; i++) {\n2591\t      const p = t.plays[i];\n2592\t      if (i) parts.push(`<span class=\"lk ${p && p.broke ? 'x' : ''}\">${p ? (p.broke ? '✕' : '▸') : ''}</span>`);\n2593\t      parts.push(p ? `<div class=\"pl\" style=\"background:${FCOL[p.f]};${p.f === 'fight' ? 'color:#1c1719' : ''}\">${tOf(S, p.id).n}<small>+${p.g + p.extra + p.open + p.fin}</small></div>` : '<div class=\"pl no\"></div>');\n2594\t    }\n2595\t    const last = t.plays[t.plays.length - 1], nx = nextFam(S);\n2596\t    let line;\n2597\t    if (t.ended) line = `这一场 <b>${t.gold}</b> 金${t.perfect ? ' · 完美' : ''}`;\n2598\t    else if (!last) line = `起手打 ${fc(nx)}`;\n2599\t    else if (t.plays.length >= t.stageMax) line = `${t.stageMax === R.stageMax ? '五' : '四'}张打满了`;\n2600\t    else if (last.broke) line = `<span class=\"bad\">断了</span> 下一张接 ${nx === '*' ? '任意' : fc(nx)}`;\n2601\t    else if (nx === '*') line = `下一张接 <b>任意</b> <small>+${nextBonus(S)} 金</small>`;\n2602\t    else line = `下一张接 <i class=\"fc nx\" style=\"background:${FCOL[nx]};${nx === 'fight' ? 'color:#1c1719' : ''}\">${FAM[nx].n}</i> <small>${t.chain > 1 ? `连击 ×${t.chain} · ` : ''}+${nextBonus(S)} 金</small>`;\n2603\t    if (t.grudge && !t.ended) line += ` <small class=\"bad\">怨气 ${t.grudge}</small>`;\n2604\t    m.innerHTML = `<div class=\"chain\" id=\"chain\"><div class=\"played\">${parts.join('')}</div><div class=\"nowline\">${line}</div></div>${intelHTML(true)}`;\n2605\t    return;\n2606\t  }\n2607\t  if (view === 'evening' && lookNow(S) && S.choice !== 'lamp') {\n2608\t    const nd = t.need, look = lookNow(S), got = gotOf(t), done = got >= nd.k;\n2609\t    const rows = nd.items.map(x => { const g = Math.min(x.n, t.got[x.look] || 0); return `<div class=\"nr ${g >= x.n ? 'ok' : ''}\">${LOOK_ICON[x.look]}<span><i class=\"lkn\">她${x.look} → 要 </i><b class=\"hn\">${HOME[LOOK_HOME[x.look]].n}</b></span><span class=\"pips\">${Array.from({ length: x.n }, (_, i) => `<i class=\"${i < g ? 'on' : ''}\"></i>`).join('')}</span></div>`; }).join('');\n2610\t    m.innerHTML = `<div class=\"need ${done ? 'done' : ''}\" role=\"status\"><button class=\"lookb\" data-act=\"look\" aria-expanded=\"${lookOpen}\" aria-label=\"她今晚的样子：${look}\">${LOOK_ICON[look]}<span class=\"lb\">${look}</span></button>\n2611\t      <div class=\"nt\">${rows}<small>${done ? '都够了。再推对路的，灯 +2' : `还差 ${nd.k - got} 张${nd.items.length > 1 ? '，每一样都要够' : ''}`}</small></div></div>`;\n2612\t    return;\n2613\t  }\n2614\t  // 早上、門口、夜裡：一條金字說這一步要做什麼\n2615\t  const n = t.layers.length;\n2616\t  let goal = '';\n2617\t  if (view === 'morning' && !lockedBox(S) && S.choice !== 'lamp') goal = `装妆匣 <b>${t.box.length}</b>/${t.cap}${starterOf(S) ? ` <small>起手 ${FAM[starterOf(S)].n} 要带</small>` : ''}`;\n2618\t  else if (view === 'morning') goal = '妆匣装好了 <small>出门</small>';\n2619\t  else if (view === 'door') goal = n ? `进门前卸妆 <b>${n}</b> 层 <small>没卸的会染牌</small>` : '脸是干净的 <small>进门</small>';\n2620\t  else if (view === 'night') goal = n ? `睡前还有 <b>${n}</b> 层 <small>过夜就渗进底色</small>` : '夜深了 <small>睡吧</small>';\n2621\t  m.innerHTML = `${goal ? `<div class=\"goal\">${goal}</div>` : ''}${['morning', 'night'].includes(view) ? intelHTML() : ''}`;\n2622\t}\n2623\t// ── 介面分批出現：第 1 天台上只有木牌、連擊、手牌；第一次回家才有「家」；第 2 天早上才有水牌和圖鑑 ──\n2624\tconst uiOn = {\n2625\t  board: () => S.day >= 2,\n2626\t  home: () => S.day >= 2 || ['door', 'evening', 'night'].includes(view),\n2627\t  book: () => S.day >= 2,\n2628\t};\n2629\t// 第一次出現的那一下，彈一下引人看\n2630\tfunction uiReveal(el, k) {\n2631\t  if (!S.ui) S.ui = {};\n2632\t  if (S.ui[k]) return;\n2633\t  S.ui[k] = true;\n2634\t  el.classList.remove('popin'); void el.offsetWidth; el.classList.add('popin');\n2635\t}\n2636\t// 左欄：家（燈、熄、痕，她會不會走），和圖鑑\n2637\tfunction renderLeft() {\n2638\t  const el = $('#leftcol'), hp = $('#homep');\n2639\t  el.hidden = ['board', 'lastwipe', 'reveal', 'watch'].includes(view) || !uiOn.home();\n2640\t  if (el.hidden) return;\n2641\t  uiReveal(hp, 'home');\n2642\t  $('#bookBtn').hidden = !uiOn.book();\n2643\t  if (uiOn.book()) uiReveal($('#bookBtn'), 'book');\n2644\t  const danger = S.outs >= R.brokenOuts - 2 || S.scars >= R.brokenScar - 1;\n2645\t  hp.className = `homep ${danger ? 'warn' : ''}`;\n2646\t  hp.innerHTML = `<div class=\"hh\"><span>家 · 阿檀</span><span>${S.left ? '她走了' : seatEmpty(S) ? '座位空了' : ''}</span></div>\n2647\t    <div class=\"hl\" data-term=\"灯\">${lampSVG(S.lamp)}<div><b>${S.lamp}</b><small>/${R.lampFull}</small></div></div>\n2648\t    <div class=\"hrow ${S.outs >= R.brokenOuts - 2 ? 'hot' : ''}\" data-term=\"熄\"><span class=\"k\">熄</span>${outsHTML()}${S.outs >= R.brokenOuts - 2 ? `<em>再 ${R.brokenOuts - S.outs} 回她走</em>` : ''}</div>\n2649\t    <div class=\"hrow ${S.scars >= R.brokenScar - 1 ? 'hot' : ''}\" data-term=\"痕\"><span class=\"k\">痕</span>${scarsHTML()}${S.scars >= R.brokenScar - 1 ? `<em>再 ${R.brokenScar - S.scars} 道她走</em>` : ''}</div>`;\n2650\t  hp.setAttribute('aria-label', `家：灯 ${S.lamp}，熄过 ${S.outs} 回，痕 ${S.scars} 道；熄满 ${R.brokenOuts} 回或痕到 ${R.brokenScar} 道，她就走`);\n2651\t  if (innerWidth <= 760) el.style.top = `${Math.round(Math.max($('#plate').getBoundingClientRect().bottom, $('#topmid').getBoundingClientRect().bottom) + 6)}px`;\n2652\t  const seen = new Set(S.deck.map(c => c.t)).size;\n2653\t  $('#bookBtn').innerHTML = `图鉴<small>牌 ${seen}/${BOOK_CARDS.length}</small>`;\n2654\t}\n2655\t// ── 圖鑑：每張牌、每樣物件、每個詞；順便講一點戲 ──\n2656\tconst BOOK_CARDS = [...BASIC, ...BORROWED, ...SHOP, ...GIFTS];\n2657\tconst LORE = {\n2658\t  changqiang: '唱腔里拖得很长的一句，一个字能绕好几道弯，最见演员的气口和韵味。',\n2659\t  liangsang: '一开口就把嗓子亮出来，又高又脆。老戏迷讲究「先声夺人」，头一句就定了角儿的分量。',\n2660\t  bai: '念白，「唱念做打」里的「念」。京剧念白分韵白和京白；行里有句老话：「千斤话白四两唱」，念比唱还难。',\n2661\t  kuaiban: '京剧的快板是有板无眼、节奏很快的唱腔板式；曲艺里也有打着竹板说唱的快板。这里取它一气呵成的急劲。',\n2662\t  shenduan: '演员在台上的形体动作，统称身段。手、眼、身、法、步，都在里面。',\n2663\t  shuixiu: '戏服袖口接出的一段白绸。抖、甩、掸、挑、翻，一条袖子能演出喜怒哀乐。',\n2664\t  liangxiang: '一段动作结束时猛地停住，摆出一个定型的姿势，把人物的精神「亮」给观众看。',\n2665\t  fanshen: '身体在竖直的平面上翻转的身段，武生、刀马旦常用；连着翻，叫「串翻身」。',\n2666\t  jie_kutou: '唱腔里表现悲痛的哭腔，常接在唱句后面，一声「喂呀」。',\n2667\t  jie_guankou: '一口气连贯念出的大段词，字字清楚，像不换气似的往外送。相声里最常见，戏曲念白也讲究这股劲。',\n2668\t  jie_dadao: '武戏里的大刀，比如关羽的青龙偃月刀。耍大刀讲究刀花、背刀和下场的架势。',\n2669\t  manban: '京剧板式里最慢的一种，一板三眼，字少腔多，最适合抒情。',\n2670\t  tazhuan: '游戏里把「踏步」和「转身」这两样常见的步法身段合在一起，起了这个名字。',\n2671\t  qiba: '武将出征前整盔、束甲的一套程式动作，表现大将的英武。相传源自明代传奇《千金记》里霸王起兵的一场。',\n2672\t  daoban: '京剧板式，常用在成套唱腔的开头：演员往往先在幕内唱一句导板，再走出来。',\n2673\t  shuban: '合着板眼一句一句数下去的念诵，多由丑角来，诙谐利落。',\n2674\t  jijifeng: '一种锣鼓点子，节奏急促密集，多用在武将上下场、开打和紧张的场面。',\n2675\t  yunbai: '京剧念白的一种，用湖广音、中州韵，抑扬顿挫像在吟诵，多给正派人物用。',\n2676\t  woyu: '旦角身段：身子盘旋着卧下、往后仰。《贵妃醉酒》里杨玉环俯身闻花的卧鱼最有名。',\n2677\t  qingchang: '不化妆、不穿戏服、不做身段，只唱。票友聚在一起，常这样唱。',\n2678\t  dingchang: '角色第一次上场时念的四句诗，交代身份和心境；念完，场子就「定」住了。',\n2679\t  tuoqiang: '琴师用京胡跟着演员的唱腔走，托住、垫住，叫「托腔保调」。好琴师能让角儿唱得更舒服。',\n2680\t  tangma: '表现骑马赶路的一套程式动作。手里一根马鞭，就是一匹马。',\n2681\t  tang: '不是戏。她把汤热了第二回，等你回来。',\n2682\t  fan: '不是戏。两只碗、两双筷子，她摆好了。',\n2683\t  xin: '不是戏。她把你早年写的信翻出来，用红线又扎了一遍。',\n2684\t  zhi: '不是戏。灯糊完了，她剪了一朵花，贴在窗上。',\n2685\t};\n2686\tconst RELIC_LORE = {\n2687\t  qinshi: '京剧乐队里拉京胡的人，是角儿的「另一条嗓子」。',\n2688\t  gujing: '锣鼓点子的口诀，用「仓、才、台、七」这样的字念出来，记熟了才打得齐。',\n2689\t  cha: '唱戏的人护嗓子，常泡一杯胖大海或罗汉果。',\n2690\t  lian: '放胭脂、粉和首饰的小匣子。',\n2691\t  jin: '用旧了、用软了的手巾，卸妆不伤脸。',\n2692\t  you: '点灯用的油。',\n2693\t  luo: '乐队里的小锣，声音清脆，常给旦角、文戏打点子。',\n2694\t};\n2695\tlet bookTab = 'cards', bookSel = null;\n2696\tfunction bookPanel() {\n2697\t  const owned = new Set(S.deck.map(c => c.t));\n2698\t  const tabs = [['cards', '牌'], ['relics', '物件'], ['terms', '词条']].map(([k, n]) => `<button class=\"btn small ${bookTab === k ? 'go' : ''}\" data-act=\"booktab\" data-arg=\"${k}\" aria-pressed=\"${bookTab === k}\">${n}</button>`).join('');\n2699\t  let body = '';\n2700\t  if (bookTab === 'cards') {\n2701\t    if (bookSel) {\n2702\t      const k = bookSel, tp = T[k], kind = tp.home ? '家常牌（她送的）' : BASIC.includes(k) ? '基础牌' : BORROWED.includes(k) ? '借来的牌' : `后台的牌 · ${T[k].price} 金`;\n2703\t      const lines = tp.home ? ['不上台。', `对上她的需要，一张算两张，灯 +3。`] : stageLines(k);\n2704\t      body = `<div class=\"bookd\"><div class=\"faces\"><figure><img src=\"${cardArt(k, 'stage').url}\" alt=\"\">台上面</figure>${tp.home ? '' : `<figure><img src=\"${cardArt(k, 'home').url}\" alt=\"\">家里面</figure>`}</div>\n2705\t        <div class=\"bt\"><h3>${tp.n}<small>${tp.home ? '' : FAM[tp.f].n + ' · '}${kind}${owned.has(k) ? '' : ' · 还没拿到'}</small></h3>\n2706\t        <h4>怎么用</h4><p>${lines.map(esc).join('<br>')}${tp.home ? '' : `<br>背面：${tp.blank ? '空白（借来的牌，推给她灯不涨）' : `${HOME[FAM[tp.f].home].n}（她「${HOME[FAM[tp.f].home].look}」时要的）`}`}</p>\n2707\t        <h4>${tp.home ? '这张牌' : '戏里的讲究'}</h4><p>${esc(LORE[k] || '')}</p>\n2708\t        <button class=\"btn small\" data-act=\"booksel\" data-arg=\"\">回到全部</button></div></div>`;\n2709\t    } else {\n2710\t      const grp = (title, ks) => `<h4>${title}</h4><div class=\"bookg\">${ks.map(k => `<button class=\"bc ${owned.has(k) ? '' : 'un'}\" data-act=\"booksel\" data-arg=\"${k}\" aria-label=\"${T[k].n}${owned.has(k) ? '' : '，还没拿到'}\"><img src=\"${cardArt(k, 'stage').url}\" alt=\"\"><span>${T[k].n}</span></button>`).join('')}</div>`;\n2711\t      body = `<p class=\"note\">点一张看它怎么用、戏里有什么讲究。暗着的是还没拿到的。</p>${grp('基础牌', BASIC)}${grp('借来的牌', BORROWED)}${grp('后台的牌', SHOP)}${grp('家常牌（她送的）', GIFTS)}`;\n2712\t    }\n2713\t  } else if (bookTab === 'relics') {\n2714\t    body = `<ul class=\"bookr\">${RELIC_KEYS.map(k => `<li class=\"${S.relics.includes(k) ? 'own' : ''}\"><b>${RELICS[k].n}</b><small>${RELICS[k].price} 金${S.relics.includes(k) ? ' · 已有' : ''}</small><p>${esc(RELICS[k].tx)}</p><p class=\"lore\">${esc(RELIC_LORE[k])}</p></li>`).join('')}</ul>`;\n2715\t  } else {\n2716\t    body = `<dl class=\"bookt\">${Object.entries(TERMS).map(([k, v]) => `<dt>${k}</dt><dd>${esc(v)}</dd>`).join('')}</dl>`;\n2717\t  }\n2718\t  return `<div class=\"panel tujian\"><h2>图鉴<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2><div class=\"tabs\">${tabs}</div>${body}</div>`;\n2719\t}\n2720\tfunction midHTML() {\n2721\t  if (panel === 'book') return bookPanel();\n2722\t  if (panel === 'rules') return rulesPanel();\n2723\t  if (panel === 'shop') return shopPanel();\n2724\t  if (panel === 'water') return waterPanel();\n2725\t  if (sheet) return sheetPanel();\n2726\t  if (view === 'morning') return morningPanel();\n2727\t  return '';\n2728\t}\n2729\t// 每次點擊都會重畫；同一張紙要留住捲動位置和焦點，不然一按就跳回最上面\n2730\tfunction renderMid() {\n2731\t  const m = $('#mid'), key = `${view}|${panel}|${sheet ? sheet.k : ''}`, old = m.querySelector('.panel, .spread');\n2732\t  const top = old && m.dataset.key === key ? old.scrollTop : 0;\n2733\t  const fe = document.activeElement, fa = fe && m.contains(fe) && fe.dataset.act ? [fe.dataset.act, fe.dataset.arg] : null;\n2734\t  m.innerHTML = midHTML();\n2735\t  m.dataset.key = key;\n2736\t  const nu = m.querySelector('.panel, .spread');\n2737\t  if (nu) nu.scrollTop = top;\n2738\t  if (fa) {\n2739\t    const b = m.querySelector(`[data-act=\"${fa[0]}\"]${fa[1] !== undefined ? `[data-arg=\"${CSS.escape(fa[1])}\"]` : ''}`);\n2740\t    if (b && !b.disabled) b.focus({ preventScroll: true });\n2741\t  }\n2742\t}\n2743\tfunction morningPanel() {\n2744\t  const t = S.T;\n2745\t  if (S.day === R.days && !S.choice) {\n2746\t    return `<div class=\"yuan\"><h3>元宵，三选一</h3><div class=\"pair\">\n2747\t      <button class=\"yn\" data-act=\"yuan\" data-arg=\"stage\">上台<small>起手打 · 金 ×2 · 不回家，灯由她一个人点</small></button>\n2748\t      <button class=\"yn\" data-act=\"yuan\" data-arg=\"lamp\">回家点灯<small>不演 · 灯点亮 · 只有这条路能到美满</small></button>\n2749\t      <button class=\"yn\" data-act=\"yuan\" data-arg=\"cover\">替小凤代演<small>起手唱 · 金记在她名下，她留在水牌上</small></button>\n2750\t    </div></div>`;\n2751\t  }\n2752\t  if (lockedBox(S) || S.choice === 'lamp') return '';\n2753\t  const kinds = [...BASIC, ...BORROWED, ...SHOP, ...GIFTS].filter(k => S.deck.some(c => c.t === k));\n2754\t  const cells = kinds.map(k => {"}]},"parent_tool_use_id":null,"session_id":"add261a2-b4a2-4526-9481-41d3d4ec4689","uuid":"d7220119-0b45-4d9d-b077-5cb384d5d8a3","timestamp":"2026-11-11T08:00:57.902Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.5/index.html","content":"function sayN(gain) { $('#sub').innerHTML = gain ? `<div class=\"sub n\"><span class=\"gain\">${esc(gain)}</span></div>` : ''; }\nfunction say(who, tx, gain) {\n  $('#sub').innerHTML = tx ? `<div class=\"sub\">${who ? `<span class=\"who\">${esc(who)}</span><br>` : ''}<span class=\"tx\">${esc(tx)}</span>${gain ? `<span class=\"gain\">${esc(gain)}</span>` : ''}</div>` : '';\n}\n// 帶高亮的字幕：需要、事件的詞會亮起來；gain 可以放情報小籤\nfunction sayH(who, html, gain) {\n  $('#sub').innerHTML = html ? `<div class=\"sub\">${who ? `<span class=\"who\">${esc(who)}</span><br>` : ''}<span class=\"tx\">${html}</span>${gain ? `<span class=\"gain\">${gain}</span>` : ''}</div>` : '';\n}\nconst fc = f => `<i class=\"fc\" style=\"background:${FCOL[f]};${f === 'fight' ? 'color:#1c1719' : ''}\">${FAM[f].n}</i>`;\nfunction refresh() {\n  const on = view !== 'title';\n  $('#hud').hidden = !on; $('#title').hidden = on;\n  if (!on) { renderTitle(); $('#coach').hidden = true; hidePeek(); return; }\n  // 規矩、後台、水牌攤開時，字幕先收起來，紙用整個中間\n  document.querySelector('.talk').hidden = !!panel;\n  $('#hud').dataset.v = view;\n  const mb = $('#musicBtn'); mb.setAttribute('aria-pressed', String(musicOn)); mb.textContent = musicOn ? '乐 开' : '乐 关'; mb.title = musicOn ? '背景音乐：开着（点一下关）' : '背景音乐：关着（点一下开）';\n  renderPlate(); renderBoardChip(); renderTop(); renderLeft(); renderMid(); renderChoices(); renderHand(); fitSpread(); peekSync(); renderSmear();\n  updateTable();\n  coachUpdate();\n  save();\n}\nfunction renderTitle() {\n  $('#title').innerHTML = `<div class=\"title-in\">\n    <div class=\"vb\"><div class=\"t\">底色</div><div class=\"s\">戏城 · 三幕</div></div>\n    <div>\n      <p class=\"intro\">你坐在戏班的桌前。十天，三幕。白天把牌排上戏台，傍晚把它翻过来，推给对面的阿檀。</p>\n      <p class=\"lede\">每打一张，脸上多一层油彩。没卸掉的油彩，会染上你推给她的牌，灯上就留一道痕。她每晚有一个需要，推不够，灯就熄一截。听台下的闲话、听她说往后几天的事，照着装匣。去后台买东西，花的就是卖座，名次会掉。灯熄满五回，她就走了；幕末考核垫底，牌子就被摘了——两样都会让这一季提前结束。</p>\n      <div class=\"form\">\n        <div class=\"field\"><label for=\"nm\">你的小名</label><input id=\"nm\" maxlength=\"6\" value=\"${esc(draftName)}\" autocomplete=\"off\"></div>\n        <label class=\"tg\"><input type=\"checkbox\" id=\"tutChk\" ${tutPref() ? 'checked' : ''}>带教学小框</label>\n        <button class=\"btn go\" data-act=\"start\">开锣</button>\n        ${saved ? `<button class=\"btn\" data-act=\"cont\">接着玩 · 第 ${saved.day} 天</button>` : ''}\n      </div>\n      <p class=\"hint\">${glOK ? '建议戴耳机、在大屏幕上玩。' : '这台设备显示不了 3D，卡牌和剧情照样能玩。'}约 55 分钟。所有数字都是占位，待试玩校准。</p>\n    </div></div>`;\n}\n// ── 詞條：教學、規矩裡的這些詞帶虛線，滑鼠停上去（手機點一下）就有說明 ──\nconst TERMS = {\n  卖座: '你唱戏挣的金。水牌按它排名；去后台买东西也花它，买了名次会掉。',\n  起手: '每天第一张必须打的那一族，写在木牌上。打对了叫「开得正」，多 1 金。',\n  接口: '每张牌写着「接 → 某一族」。下一张打那一族，就接上了，连击 +1。',\n  连击: '连着接上的张数。第 2 张起每张多拿金；接错了归零，已拿的金不扣。',\n  怨气: '第 2 天起，台上接错一次，台下就攒一点怨气。怨气会跟你回家，让你推给她的前几张牌被染。',\n  油彩: '台上每打一张牌，脸上多一层油彩（重彩两层、素不上妆），最多 4 层，再多就直接渗进底色。回家前要卸。',\n  底色: '没卸掉的油彩，睡一觉就渗进脸里，变成底色。底色只多不少：每 2 点，妆匣少一格；第三幕起，演得最多的那一族推给她时，会带着台上的字。',\n  被染: '脸上没卸掉的油彩和怨气，会染上你推给她的前几张牌（牌角有红）。推了被染的牌，灯上留一道痕。',\n  痕: '推了被染的牌，灯上划一道，永久。痕到 4 道，她就走了；美满要痕不超过 1。',\n  熄: '她当晚的需要没推够，灯熄一截（−3），记一回熄。熄满 5 回，她就走了；熄过一回，就到不了美满。',\n  灯: '阿檀糊的灯。推给她对路的牌 +2，家常牌 +3。糊满 30、一回没熄过、痕不超过 1、元宵回家点灯，才是美满。',\n  情报: '台下的闲话、她自己说的话里，藏着往后几晚她要什么。听到的记在上面那一排。',\n  考核: '第 3 天散戏后垫底、第 7 天散戏后排倒数两名，牌子就被摘了，这一季提前结束。',\n  百搭: '接在什么后面都算接上；它后面打哪一族也都接得上，还能起手。',\n  重彩: '金高，但脸上多一层油彩。',\n  压轴: '第 4 张起打出，另加金。',\n  素: '打出不上妆，脸上不添层。',\n  托: '接上时，这一张的连击金翻倍。',\n  家常牌: '她送你的牌，不上台。对上她的需要，一张算两张，灯 +3。',\n  完美: '收场时连击到 3，掷一颗骰，4 以上，这一场的金 ×1.5。',\n  让她擦: '卸妆的一种：她替你擦，一次 2 层、不耗牌；但这一晚她只听得下 1 张。',\n};\n// 自動加虛線的只取這幾個（單字的牌名關鍵詞不自動加，免得「素着脸」也冒虛線）\nconst AUTO_TERMS = ['卖座', '起手', '接口', '连击', '怨气', '油彩', '底色', '被染', '痕', '熄', '情报', '考核', '家常牌', '完美', '让她擦'];\nconst TERM_RE = new RegExp(AUTO_TERMS.sort((a, b) => b.length - a.length).join('|'), 'g');\n// 把一段 HTML 裡第一次出現的詞條包起來（標籤裡面的不動）\nfunction termify(html) {\n  const done = new Set();\n  return html.split(/(<[^>]+>)/).map((seg, i, all) => {\n    if (seg.startsWith('<') || (i > 0 && /class=\"term\"/.test(all[i - 1]))) return seg;\n    return seg.replace(TERM_RE, w => (done.has(w) ? w : (done.add(w), `<i class=\"term\" data-term=\"${w}\" tabindex=\"0\">${w}</i>`)));\n  }).join('');\n}\nconst tipEl = () => $('#tip');\nfunction showTip(el) {\n  const k = el.dataset.term, raw = k ? [k, TERMS[k]] : (el.dataset.tip || '').split('|');\n  if (!raw[1]) return;\n  const t = tipEl();\n  t.innerHTML = `<b>${esc(raw[0])}</b>${esc(raw[1])}`;\n  t.hidden = false;\n  const r = el.getBoundingClientRect(), w = t.offsetWidth, h = t.offsetHeight;\n  const below = r.bottom + h + 10 < innerHeight;\n  t.style.left = `${clamp((r.left + r.right) / 2 - w / 2, 8, innerWidth - w - 8)}px`;\n  t.style.top = `${below ? r.bottom + 8 : r.top - h - 8}px`;\n}\nconst hideTip = () => { tipEl().hidden = true; };\ndocument.addEventListener('pointerover', e => { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); });\ndocument.addEventListener('focusin', e => { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); });\ndocument.addEventListener('pointerdown', e => { if (e.pointerType !== 'mouse') { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); } });\n// 熄過幾回、痕幾道：到了上限，她就走了\nconst outsHTML = (fresh = false) => `<span class=\"outs\">${Array.from({ length: R.brokenOuts }, (_, i) => `<i class=\"${i < S.outs ? 'on' : ''} ${fresh && i === S.outs - 1 ? 'new' : ''}\"></i>`).join('')}</span>`;\nconst scarsHTML = () => `<span class=\"scars\">${Array.from({ length: R.brokenScar }, (_, i) => `<i class=\"${i < S.scars ? 'on' : ''}\"></i>`).join('')}</span>`;\nfunction renderPlate() {\n  const st = starterOf(S);\n  const stOn = st && ['morning', 'stage'].includes(view);\n  $('#plate').innerHTML = `<div class=\"d\">第 ${S.day} 天</div>\n    <div class=\"st\" ${stOn ? '' : 'hidden'}>起手 ${stOn ? fc(st) : ''}</div><div class=\"g\"><i class=\"term\" data-term=\"卖座\">卖座</i><b>${S.gold}</b></div>`;\n  // 左欄跟在木牌底下\n  const lc = $('#leftcol'); lc.style.top = innerWidth > 760 ? `${Math.round($('#plate').getBoundingClientRect().bottom + 8)}px` : '';\n}\n// 考核的底線怎麼說\nconst examTx = ne => (ne.fail === R.ranks ? '别垫底' : `别进倒数${['', '两', '三', '四'][R.ranks - ne.fail] || ''}名`);\n// 右上的水牌小牌：名次，和上一名差多少；下一次考核\nfunction renderBoardChip() {\n  const el = $('#wboard');\n  if (['board', 'lastwipe', 'reveal', 'watch'].includes(view) || !uiOn.board()) { el.innerHTML = ''; return; }\n  const b = boardOf(S), i = b.findIndex(r => r.me), up = b[i - 1], dn = b[i + 1];\n  const gap = boardDay(S) < 1 ? '还没开锣' : up ? `差${esc(up.n)} ${up.g - S.gold + 1}` : dn ? `领先${esc(dn.n)} ${S.gold - dn.g}` : '';\n  const ne = nextExam(S), bad = ne && i + 1 >= ne.fail && boardDay(S) >= 1;\n  const ex = ne && (bad || ne.day - S.day <= 1) ? `<span class=\"exam ${bad ? 'bad' : ''}\">${ne.day === S.day ? '今天' : '明天'}散戏后<i class=\"term\" data-term=\"考核\">考核</i>：${examTx(ne)}</span>` : '';\n  // 主畫面直接看三行：上一名、你、下一名（第一就看下兩名，墊底就看上兩名）\n  const from = clamp(i - 1, 0, b.length - 3), rows = b.slice(from, from + 3).map((r, k) => `<li class=\"${r.me ? 'me' : ''} ${ne && from + k + 1 === ne.fail ? 'fail' : ''}\"><span><span class=\"n\">${from + k + 1}</span>${r.me ? '你' : esc(r.n)}</span><span>${r.g}</span></li>`).join('');\n  const fresh = !(S.ui && S.ui.board);\n  if (!S.ui) S.ui = {};\n  S.ui.board = true;\n  el.innerHTML = `<button class=\"wb ${fresh ? 'popin' : ''}\" data-act=\"water\" aria-label=\"水牌第 ${i + 1}，${gap}${ne ? `，第 ${ne.day} 天考核${examTx(ne)}` : ''}。点开看全部\"><span class=\"wbh\"><span>水牌</span><span>第 <b>${i + 1}</b> / ${b.length}</span></span><ol>${rows}</ol><span class=\"dif\">${gap}</span>${ex}</button>${S.relics.length ? `<div class=\"relics\" aria-label=\"物件\">${S.relics.map(r => `<button class=\"rel\" data-tip=\"${esc(RELICS[r].n)}|${esc(RELICS[r].tx)}\" aria-label=\"${esc(RELICS[r].n)}：${esc(RELICS[r].tx)}\">${RELICS[r].n}</button>`).join('')}</div>` : ''}`;\n}\n// 情報：聽來的需要，按段排；今晚的那一條亮著\nfunction intelHTML(onlyNow = false) {\n  if (seatEmpty(S)) return '';\n  const items = [];\n  // 今晚的需要已經過了（夜裡、吃完飯），就從明天記起\n  for (let d = view === 'night' || S.T.judged ? S.day + 1 : S.day; d < (onlyNow ? S.day + 1 : R.days); d++) if (S.known[d]) items.push({ d, nd: needOf(S, d) });\n  if (!items.length) return '';\n  const lab = d => (d === S.day ? '今晚' : d === S.day + 1 ? '明晚' : `第${d}天`);\n  return `<div class=\"intel\" role=\"note\" aria-label=\"情报\"><span class=\"lbl\">情报</span>${items.map(it => `<span class=\"ic ${it.d === S.day ? 'now' : ''}\"><span class=\"d\">${lab(it.d)}</span>${it.nd.items.map(x => `${lookIcon(x.look)}${x.look} → <b>${HOME[LOOK_HOME[x.look]].n}</b>×${x.n}`).join(' + ')}</span>`).join('')}</div>`;\n}\n// 這一種牌的背面是她今晚要的（早上攤開的牌用）\nconst needKind = k => !!S.known[S.day] && !seatEmpty(S) && S.choice !== 'stage' && S.choice !== 'lamp' && !T[k].blank && needOf(S).items.some(x => x.look === (T[k].home ? HOME[FAM[T[k].f].home].look : HOME[FAM[T[k].f].home].look));\n// 這張牌的背面是她今晚要的：台上留著、卸妝別弃\nconst keepHint = id => !!S.known[S.day] && !seatEmpty(S) && S.choice !== 'stage' && S.choice !== 'lamp' && !tOf(S, id).blank && needOf(S).items.some(x => x.look === lookOfCard(S, id));\nconst gotOf = t => t.need.items.reduce((a, x) => a + Math.min(x.n, t.got[x.look] || 0), 0);\nfunction renderTop() {\n  const m = $('#topmid'), t = S.T;\n  if (view === 'stage') {\n    const parts = [];\n    for (let i = 0; i < t.stageMax; i++) {\n      const p = t.plays[i];\n      if (i) parts.push(`<span class=\"lk ${p && p.broke ? 'x' : ''}\">${p ? (p.broke ? '✕' : '▸') : ''}</span>`);\n      parts.push(p ? `<div class=\"pl\" style=\"background:${FCOL[p.f]};${p.f === 'fight' ? 'color:#1c1719' : ''}\">${tOf(S, p.id).n}<small>+${p.g + p.extra + p.open + p.fin}</small></div>` : '<div class=\"pl no\"></div>');\n    }\n    const last = t.plays[t.plays.length - 1], nx = nextFam(S);\n    let line;\n    if (t.ended) line = `这一场 <b>${t.gold}</b> 金${t.perfect ? ' · 完美' : ''}`;\n    else if (!last) line = `起手打 ${fc(nx)}`;\n    else if (t.plays.length >= t.stageMax) line = `${t.stageMax === R.stageMax ? '五' : '四'}张打满了`;\n    else if (last.broke) line = `<span class=\"bad\">断了</span> 下一张接 ${nx === '*' ? '任意' : fc(nx)}`;\n    else if (nx === '*') line = `下一张接 <b>任意</b> <small>+${nextBonus(S)} 金</small>`;\n    else line = `下一张接 <i class=\"fc nx\" style=\"background:${FCOL[nx]};${nx === 'fight' ? 'color:#1c1719' : ''}\">${FAM[nx].n}</i> <small>${t.chain > 1 ? `连击 ×${t.chain} · ` : ''}+${nextBonus(S)} 金</small>`;\n    if (t.grudge && !t.ended) line += ` <small class=\"bad\">怨气 ${t.grudge}</small>`;\n    m.innerHTML = `<div class=\"chain\" id=\"chain\"><div class=\"played\">${parts.join('')}</div><div class=\"nowline\">${line}</div></div>${intelHTML(true)}`;\n    return;\n  }\n  if (view === 'evening' && lookNow(S) && S.choice !== 'lamp') {\n    const nd = t.need, look = lookNow(S), got = gotOf(t), done = got >= nd.k;\n    const rows = nd.items.map(x => { const g = Math.min(x.n, t.got[x.look] || 0); return `<div class=\"nr ${g >= x.n ? 'ok' : ''}\">${LOOK_ICON[x.look]}<span><i class=\"lkn\">她${x.look} → 要 </i><b class=\"hn\">${HOME[LOOK_HOME[x.look]].n}</b></span><span class=\"pips\">${Array.from({ length: x.n }, (_, i) => `<i class=\"${i < g ? 'on' : ''}\"></i>`).join('')}</span></div>`; }).join('');\n    m.innerHTML = `<div class=\"need ${done ? 'done' : ''}\" role=\"status\"><button class=\"lookb\" data-act=\"look\" aria-expanded=\"${lookOpen}\" aria-label=\"她今晚的样子：${look}\">${LOOK_ICON[look]}<span class=\"lb\">${look}</span></button>\n      <div class=\"nt\">${rows}<small>${done ? '都够了。再推对路的，灯 +2' : `还差 ${nd.k - got} 张${nd.items.length > 1 ? '，每一样都要够' : ''}`}</small></div></div>`;\n    return;\n  }\n  // 早上、門口、夜裡：一條金字說這一步要做什麼\n  const n = t.layers.length;\n  let goal = '';\n  if (view === 'morning' && !lockedBox(S) && S.choice !== 'lamp') goal = `装妆匣 <b>${t.box.length}</b>/${t.cap}${starterOf(S) ? ` <small>起手 ${FAM[starterOf(S)].n} 要带</small>` : ''}`;\n  else if (view === 'morning') goal = '妆匣装好了 <small>出门</small>';\n  else if (view === 'door') goal = n ? `进门前卸妆 <b>${n}</b> 层 <small>没卸的会染牌</small>` : '脸是干净的 <small>进门</small>';\n  else if (view === 'night') goal = n ? `睡前还有 <b>${n}</b> 层 <small>过夜就渗进底色</small>` : '夜深了 <small>睡吧</small>';\n  m.innerHTML = `${goal ? `<div class=\"goal\">${goal}</div>` : ''}${['morning', 'night'].includes(view) ? intelHTML() : ''}`;\n}\n// ── 介面分批出現：第 1 天台上只有木牌、連擊、手牌；第一次回家才有「家」；第 2 天早上才有水牌和圖鑑 ──\nconst uiOn = {\n  board: () => S.day >= 2,\n  home: () => S.day >= 2 || ['door', 'evening', 'night'].includes(view),\n  book: () => S.day >= 2,\n};\n// 第一次出現的那一下，彈一下引人看\nfunction uiReveal(el, k) {\n  if (!S.ui) S.ui = {};\n  if (S.ui[k]) return;\n  S.ui[k] = true;\n  el.classList.remove('popin'); void el.offsetWidth; el.classList.add('popin');\n}\n// 左欄：家（燈、熄、痕，她會不會走），和圖鑑\nfunction renderLeft() {\n  const el = $('#leftcol'), hp = $('#homep');\n  el.hidden = ['board', 'lastwipe', 'reveal', 'watch'].includes(view) || !uiOn.home();\n  if (el.hidden) return;\n  uiReveal(hp, 'home');\n  $('#bookBtn').hidden = !uiOn.book();\n  if (uiOn.book()) uiReveal($('#bookBtn'), 'book');\n  const danger = S.outs >= R.brokenOuts - 2 || S.scars >= R.brokenScar - 1;\n  hp.className = `homep ${danger ? 'warn' : ''}`;\n  hp.innerHTML = `<div class=\"hh\"><span>家 · 阿檀</span><span>${S.left ? '她走了' : seatEmpty(S) ? '座位空了' : ''}</span></div>\n    <div class=\"hl\" data-term=\"灯\">${lampSVG(S.lamp)}<div><b>${S.lamp}</b><small>/${R.lampFull}</small></div></div>\n    <div class=\"hrow ${S.outs >= R.brokenOuts - 2 ? 'hot' : ''}\" data-term=\"熄\"><span class=\"k\">熄</span>${outsHTML()}${S.outs >= R.brokenOuts - 2 ? `<em>再 ${R.brokenOuts - S.outs} 回她走</em>` : ''}</div>\n    <div class=\"hrow ${S.scars >= R.brokenScar - 1 ? 'hot' : ''}\" data-term=\"痕\"><span class=\"k\">痕</span>${scarsHTML()}${S.scars >= R.brokenScar - 1 ? `<em>再 ${R.brokenScar - S.scars} 道她走</em>` : ''}</div>`;\n  hp.setAttribute('aria-label', `家：灯 ${S.lamp}，熄过 ${S.outs} 回，痕 ${S.scars} 道；熄满 ${R.brokenOuts} 回或痕到 ${R.brokenScar} 道，她就走`);\n  if (innerWidth <= 760) el.style.top = `${Math.round(Math.max($('#plate').getBoundingClientRect().bottom, $('#topmid').getBoundingClientRect().bottom) + 6)}px`;\n  const seen = new Set(S.deck.map(c => c.t)).size;\n  $('#bookBtn').innerHTML = `图鉴<small>牌 ${seen}/${BOOK_CARDS.length}</small>`;\n}\n// ── 圖鑑：每張牌、每樣物件、每個詞；順便講一點戲 ──\nconst BOOK_CARDS = [...BASIC, ...BORROWED, ...SHOP, ...GIFTS];\nconst LORE = {\n  changqiang: '唱腔里拖得很长的一句，一个字能绕好几道弯，最见演员的气口和韵味。',\n  liangsang: '一开口就把嗓子亮出来，又高又脆。老戏迷讲究「先声夺人」，头一句就定了角儿的分量。',\n  bai: '念白，「唱念做打」里的「念」。京剧念白分韵白和京白；行里有句老话：「千斤话白四两唱」，念比唱还难。',\n  kuaiban: '京剧的快板是有板无眼、节奏很快的唱腔板式；曲艺里也有打着竹板说唱的快板。这里取它一气呵成的急劲。',\n  shenduan: '演员在台上的形体动作，统称身段。手、眼、身、法、步，都在里面。',\n  shuixiu: '戏服袖口接出的一段白绸。抖、甩、掸、挑、翻，一条袖子能演出喜怒哀乐。',\n  liangxiang: '一段动作结束时猛地停住，摆出一个定型的姿势，把人物的精神「亮」给观众看。',\n  fanshen: '身体在竖直的平面上翻转的身段，武生、刀马旦常用；连着翻，叫「串翻身」。',\n  jie_kutou: '唱腔里表现悲痛的哭腔，常接在唱句后面，一声「喂呀」。',\n  jie_guankou: '一口气连贯念出的大段词，字字清楚，像不换气似的往外送。相声里最常见，戏曲念白也讲究这股劲。',\n  jie_dadao: '武戏里的大刀，比如关羽的青龙偃月刀。耍大刀讲究刀花、背刀和下场的架势。',\n  manban: '京剧板式里最慢的一种，一板三眼，字少腔多，最适合抒情。',\n  tazhuan: '游戏里把「踏步」和「转身」这两样常见的步法身段合在一起，起了这个名字。',\n  qiba: '武将出征前整盔、束甲的一套程式动作，表现大将的英武。相传源自明代传奇《千金记》里霸王起兵的一场。',\n  daoban: '京剧板式，常用在成套唱腔的开头：演员往往先在幕内唱一句导板，再走出来。',\n  shuban: '合着板眼一句一句数下去的念诵，多由丑角来，诙谐利落。',\n  jijifeng: '一种锣鼓点子，节奏急促密集，多用在武将上下场、开打和紧张的场面。',\n  yunbai: '京剧念白的一种，用湖广音、中州韵，抑扬顿挫像在吟诵，多给正派人物用。',\n  woyu: '旦角身段：身子盘旋着卧下、往后仰。《贵妃醉酒》里杨玉环俯身闻花的卧鱼最有名。',\n  qingchang: '不化妆、不穿戏服、不做身段，只唱。票友聚在一起，常这样唱。',\n  dingchang: '角色第一次上场时念的四句诗，交代身份和心境；念完，场子就「定」住了。',\n  tuoqiang: '琴师用京胡跟着演员的唱腔走，托住、垫住，叫「托腔保调」。好琴师能让角儿唱得更舒服。',\n  tangma: '表现骑马赶路的一套程式动作。手里一根马鞭，就是一匹马。',\n  tang: '不是戏。她把汤热了第二回，等你回来。',\n  fan: '不是戏。两只碗、两双筷子，她摆好了。',\n  xin: '不是戏。她把你早年写的信翻出来，用红线又扎了一遍。',\n  zhi: '不是戏。灯糊完了，她剪了一朵花，贴在窗上。',\n};\nconst RELIC_LORE = {\n  qinshi: '京剧乐队里拉京胡的人，是角儿的「另一条嗓子」。',\n  gujing: '锣鼓点子的口诀，用「仓、才、台、七」这样的字念出来，记熟了才打得齐。',\n  cha: '唱戏的人护嗓子，常泡一杯胖大海或罗汉果。',\n  lian: '放胭脂、粉和首饰的小匣子。',\n  jin: '用旧了、用软了的手巾，卸妆不伤脸。',\n  you: '点灯用的油。',\n  luo: '乐队里的小锣，声音清脆，常给旦角、文戏打点子。',\n};\nlet bookTab = 'cards', bookSel = null;\nfunction bookPanel() {\n  const owned = new Set(S.deck.map(c => c.t));\n  const tabs = [['cards', '牌'], ['relics', '物件'], ['terms', '词条']].map(([k, n]) => `<button class=\"btn small ${bookTab === k ? 'go' : ''}\" data-act=\"booktab\" data-arg=\"${k}\" aria-pressed=\"${bookTab === k}\">${n}</button>`).join('');\n  let body = '';\n  if (bookTab === 'cards') {\n    if (bookSel) {\n      const k = bookSel, tp = T[k], kind = tp.home ? '家常牌（她送的）' : BASIC.includes(k) ? '基础牌' : BORROWED.includes(k) ? '借来的牌' : `后台的牌 · ${T[k].price} 金`;\n      const lines = tp.home ? ['不上台。', `对上她的需要，一张算两张，灯 +3。`] : stageLines(k);\n      body = `<div class=\"bookd\"><div class=\"faces\"><figure><img src=\"${cardArt(k, 'stage').url}\" alt=\"\">台上面</figure>${tp.home ? '' : `<figure><img src=\"${cardArt(k, 'home').url}\" alt=\"\">家里面</figure>`}</div>\n        <div class=\"bt\"><h3>${tp.n}<small>${tp.home ? '' : FAM[tp.f].n + ' · '}${kind}${owned.has(k) ? '' : ' · 还没拿到'}</small></h3>\n        <h4>怎么用</h4><p>${lines.map(esc).join('<br>')}${tp.home ? '' : `<br>背面：${tp.blank ? '空白（借来的牌，推给她灯不涨）' : `${HOME[FAM[tp.f].home].n}（她「${HOME[FAM[tp.f].home].look}」时要的）`}`}</p>\n        <h4>${tp.home ? '这张牌' : '戏里的讲究'}</h4><p>${esc(LORE[k] || '')}</p>\n        <button class=\"btn small\" data-act=\"booksel\" data-arg=\"\">回到全部</button></div></div>`;\n    } else {\n      const grp = (title, ks) => `<h4>${title}</h4><div class=\"bookg\">${ks.map(k => `<button class=\"bc ${owned.has(k) ? '' : 'un'}\" data-act=\"booksel\" data-arg=\"${k}\" aria-label=\"${T[k].n}${owned.has(k) ? '' : '，还没拿到'}\"><img src=\"${cardArt(k, 'stage').url}\" alt=\"\"><span>${T[k].n}</span></button>`).join('')}</div>`;\n      body = `<p class=\"note\">点一张看它怎么用、戏里有什么讲究。暗着的是还没拿到的。</p>${grp('基础牌', BASIC)}${grp('借来的牌', BORROWED)}${grp('后台的牌', SHOP)}${grp('家常牌（她送的）', GIFTS)}`;\n    }\n  } else if (bookTab === 'relics') {\n    body = `<ul class=\"bookr\">${RELIC_KEYS.map(k => `<li class=\"${S.relics.includes(k) ? 'own' : ''}\"><b>${RELICS[k].n}</b><small>${RELICS[k].price} 金${S.relics.includes(k) ? ' · 已有' : ''}</small><p>${esc(RELICS[k].tx)}</p><p class=\"lore\">${esc(RELIC_LORE[k])}</p></li>`).join('')}</ul>`;\n  } else {\n    body = `<dl class=\"bookt\">${Object.entries(TERMS).map(([k, v]) => `<dt>${k}</dt><dd>${esc(v)}</dd>`).join('')}</dl>`;\n  }\n  return `<div class=\"panel tujian\"><h2>图鉴<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2><div class=\"tabs\">${tabs}</div>${body}</div>`;\n}\nfunction midHTML() {\n  if (panel === 'book') return bookPanel();\n  if (panel === 'rules') return rulesPanel();\n  if (panel === 'shop') return shopPanel();\n  if (panel === 'water') return waterPanel();\n  if (sheet) return sheetPanel();\n  if (view === 'morning') return morningPanel();\n  return '';\n}\n// 每次點擊都會重畫；同一張紙要留住捲動位置和焦點，不然一按就跳回最上面\nfunction renderMid() {\n  const m = $('#mid'), key = `${view}|${panel}|${sheet ? sheet.k : ''}`, old = m.querySelector('.panel, .spread');\n  const top = old && m.dataset.key === key ? old.scrollTop : 0;\n  const fe = document.activeElement, fa = fe && m.contains(fe) && fe.dataset.act ? [fe.dataset.act, fe.dataset.arg] : null;\n  m.innerHTML = midHTML();\n  m.dataset.key = key;\n  const nu = m.querySelector('.panel, .spread');\n  if (nu) nu.scrollTop = top;\n  if (fa) {\n    const b = m.querySelector(`[data-act=\"${fa[0]}\"]${fa[1] !== undefined ? `[data-arg=\"${CSS.escape(fa[1])}\"]` : ''}`);\n    if (b && !b.disabled) b.focus({ preventScroll: true });\n  }\n}\nfunction morningPanel() {\n  const t = S.T;\n  if (S.day === R.days && !S.choice) {\n    return `<div class=\"yuan\"><h3>元宵，三选一</h3><div class=\"pair\">\n      <button class=\"yn\" data-act=\"yuan\" data-arg=\"stage\">上台<small>起手打 · 金 ×2 · 不回家，灯由她一个人点</small></button>\n      <button class=\"yn\" data-act=\"yuan\" data-arg=\"lamp\">回家点灯<small>不演 · 灯点亮 · 只有这条路能到美满</small></button>\n      <button class=\"yn\" data-act=\"yuan\" data-arg=\"cover\">替小凤代演<small>起手唱 · 金记在她名下，她留在水牌上</small></button>\n    </div></div>`;\n  }\n  if (lockedBox(S) || S.choice === 'lamp') return '';\n  const kinds = [...BASIC, ...BORROWED, ...SHOP, ...GIFTS].filter(k => S.deck.some(c => c.t === k));\n  const cells = kinds.map(k => {","numLines":300,"startLine":2455,"totalLines":3649}},"tool_result_meta":[{"id":"toolu_01BkUD22MTxaS4zatQ25tipr","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
