 if crop and im.getbbox():im=im.crop(im.getbbox())
 x,y,w,h=box;im=fit(im,w,h);canvas.paste(im,(x+(w-im.width)//2,y+(h-im.height)//2),im if im.mode=='RGBA' else None)
