{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016FH4UmnzSZLQnqiaC487T5","type":"tool_result","content":"3591\tconst LSEG = 15, LANG = 360 / LSEG;\n3592\tfunction lampSVG(lamp, mark = {}) {\n3593\t  const cx = 75, cy = 75, r = 62, seg = [];\n3594\t  for (let i = 0; i < LSEG; i++) {\n3595\t    const a0 = (-90 + i * LANG) * Math.PI / 180, a1 = (-90 + (i + 1) * LANG) * Math.PI / 180, fill = clamp(lamp - i * 2, 0, 2) / 2;\n3596\t    seg.push(`<path class=\"sg ${mark[i] || ''}\" d=\"M${cx} ${cy}L${(cx + r * Math.cos(a0)).toFixed(1)} ${(cy + r * Math.sin(a0)).toFixed(1)}A${r} ${r} 0 0 1 ${(cx + r * Math.cos(a1)).toFixed(1)} ${(cy + r * Math.sin(a1)).toFixed(1)}Z\" fill=\"${fill ? '#c42433' : '#241d1f'}\" opacity=\"${fill && fill < 1 ? 0.55 : 1}\" stroke=\"#b89a5a\" stroke-width=\"1.5\"/>`);\n3597\t  }\n3598\t  return `<svg class=\"lampsvg\" viewBox=\"0 0 150 150\" aria-hidden=\"true\">${seg.join('')}<circle cx=\"${cx}\" cy=\"${cy}\" r=\"13\" fill=\"#1c1719\" stroke=\"#b89a5a\"/>${lamp >= R.lampFull ? `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r + 4}\" fill=\"none\" stroke=\"#f2d48a\" stroke-width=\"2.5\"/>` : ''}</svg>`;\n3599\t}\n3600\t// 這幾片紙在兩個燈數之間變了\n3601\tconst segsBetween = (a, b) => { const m = {}; for (let i = 0; i < LSEG; i++) if (clamp(a - i * 2, 0, 2) !== clamp(b - i * 2, 0, 2)) m[i] = 1; return m; };\n3602\t// 吃完飯當場：燈亮了還是熄了一截，熄了第幾回，還剩幾回她就走\n3603\tasync function lampFeedback(t) {\n3604\t  const el = $('#lampfb'), now = S.lamp;\n3605\t  const from = t.met ? now - t.lampGain : now + t.lampOut;\n3606\t  const head = t.met ? `<div class=\"big\">她的需要，满足了</div>` : `<div class=\"big\">灯熄了一截</div>`;\n3607\t  const rows = t.met\n3608\t    ? `<div class=\"row\">今晚灯 <b>+${t.lampGain}</b>　现在 <b>${now}</b>/${R.lampFull}　（糊满才算美满）</div>${t.gift ? `<div class=\"row\">两晚都对上：她送你一张「${T[t.gift].n}」</div>` : ''}`\n3609\t    : `<div class=\"row\">灯 <b>${from}</b> → <b>${now}</b>　熄 ${outsHTML(true)} <b>${S.outs}</b>/${R.brokenOuts}</div><div class=\"warn\">${S.outs >= R.brokenOuts ? '熄满五回了。' : `她今晚要的是 ${recipeShort(t.need)}。再熄 ${R.brokenOuts - S.outs} 回，她就走了。${S.outs === 1 ? '熄过了，这一季到不了美满。' : ''}`}</div>`;\n3610\t  el.innerHTML = `<div class=\"lf ${t.met ? '' : 'bad'}\">${head}<div class=\"lp\">${lampSVG(from)}</div>${rows}<button class=\"btn go small lfok\">${t.met ? '好' : '知道了'}</button></div>`;\n3611\t  el.hidden = false;\n3612\t  sfx(t.met ? 'lit' : 'out');\n3613\t  // 看清楚了再點掉：不自動消失\n3614\t  const ok = el.querySelector('.lfok'), done = new Promise(res => ok.addEventListener('click', e => { e.stopPropagation(); res(); }, { once: true }));\n3615\t  ok.focus({ preventScroll: true });\n3616\t  const ch = segsBetween(from, now);\n3617\t  if (calm()) el.querySelector('.lp').innerHTML = lampSVG(now);\n3618\t  else {\n3619\t    await Promise.race([wait(650), done]);\n3620\t    if (t.met) el.querySelector('.lp').innerHTML = lampSVG(now, Object.fromEntries(Object.keys(ch).map(i => [i, 'lighting'])));\n3621\t    else { el.querySelectorAll('.sg').forEach((p, i) => { if (ch[i]) p.classList.add('dying'); }); await Promise.race([wait(1150), done]); el.querySelector('.lp').innerHTML = lampSVG(now); }\n3622\t  }\n3623\t  await done;\n3624\t  el.hidden = true; el.innerHTML = '';\n3625\t}\n3626\t// 3D 的燈：熄掉的幾片閃幾下滅了，燈光一暗；亮的時候燈光暖一下\n3627\tfunction lamp3D(from, to) {\n3628\t  if (!glOK || calm()) return;\n3629\t  const nf = Math.min(12, Math.round(from * 12 / R.lampFull)), nt = Math.min(12, Math.round(to * 12 / R.lampFull)), lit = !!(S.lit || S.litAlone);\n3630\t  if (to < from) {\n3631\t    const fade = lampPatches.slice(nt, nf);\n3632\t    let k = 0;\n3633\t    const iv = setInterval(() => { k += 1; fade.forEach(p => { p.visible = k % 2 === 0; }); if (k >= 8) { clearInterval(iv); fade.forEach(p => { p.visible = false; }); } }, 150);\n3634\t    lampLight.color.setHex(0xff4a32);\n3635\t    tween(1300, e => { lampLight.intensity = lit ? 1.7 : 1.3 * (1 - e); }).then(() => lampLight.color.setHex(0xff7a4a));\n3636\t  } else tween(1600, e => { lampLight.intensity = lit ? 1.7 : 1.5 * Math.sin(e * Math.PI); });\n3637\t}\n3638\t// 她走了：痕到 4，或燈熄滿 5 回\n3639\tconst LEAVE_TX = { outs: '“灯熄了五回。我一个人，糊不动了。”', scars: '“灯上划了四道。补不回来了。”' };\n3640\tasync function herLeaving() {\n3641\t  const why = S.outs >= R.brokenOuts ? 'outs' : 'scars';\n3642\t  if (glOK) { focus('home', 'night'); wife.react('down'); }\n3643\t  say('阿檀', LEAVE_TX[why]);\n3644\t  await wait(2800);\n3645\t  if (glOK) wife.root.visible = false;\n3646\t  sfx('cloth');\n3647\t  say('', '她把灯搁在桌上，起身走了。门开着，没关。');\n3648\t  banner('她走了', '这一季，到这里为止', 'bad slow');\n3649\t  await wait(3200);\n3650\t  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n3651\t  say('', '屋里只剩你一个人。', '天亮以后，最后一次卸妆。');\n3652\t}\n3653\tconst onEndEvening = () => run(async () => {\n3654\t  const lamp0 = S.lamp;\n3655\t  endEvening(S);\n3656\t  const t = S.T, look = t.need.look;\n3657\t  // 先看她的需要：滿足了，或燈熄一截。當場就看到燈\n3658\t  if (t.met) {\n3659\t    wife?.react('up');\n3660\t    sayH('阿檀', esc(MET_TX[look]), t.gift ? `<span class=\"itag\">她送你一张家常牌「${T[t.gift].n}」：对上她的需要，一张算两张</span>` : '她今晚的需要，满足了');\n3661\t  } else {\n3662\t    wife?.react('down');\n3663\t    sayH('', `${esc(OUT_TX[look])}灯${K('熄了一截')}。`, `没推够（${recipeShort(t.need)}）：灯 −${t.lampOut}，熄了第 ${S.outs} 回`);\n3664\t  }\n3665\t  if (glOK) focus('lamp', 'home');\n3666\t  updateTable(); renderPlate(); lamp3D(lamp0, S.lamp);\n3667\t  await lampFeedback(t);\n3668\t  if (glOK) focus('home', 'home');\n3669\t  if (S.left) { await herLeaving(); return; }\n3670\t  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n3671\t  const base = t.layers.length ? `镜子里还有 ${t.layers.length} 层，睡一觉就渗进底色。` : '';\n3672\t  // 一段的最後一晚：她說起往後兩天\n3673\t  if (t.forecast) sayH('阿檀', foreTx(t.forecast), intelTag(t.forecast) + (base ? `<br>${esc(base)}` : ''));\n3674\t  else say('', t.layers.length ? `夜里，${base}` : '夜里，镜子里的脸是干净的。');\n3675\t});\n3676\tconst onLight = () => run(async () => {\n3677\t  lightLamp(S);\n3678\t  updateTable();\n3679\t  if (glOK) focus('home', 'home');\n3680\t  say('', S.scars >= R.seatScar ? '你一个人把灯点上了。' : '她把火递给你。你们一起把灯点上了。');\n3681\t  await wait(2600);\n3682\t  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n3683\t  say('', '外面的戏开锣了。你没有去。');\n3684\t});\n3685\tfunction showWatch() {\n3686\t  const w = $('#watch'), l = S.T.watch || { tx: '', hint: '' }; w.hidden = false;\n3687\t  sfx('knock');\n3688\t  w.innerHTML = `<div class=\"knock\">梆　梆　梆</div><div class=\"w\">${esc(l.tx)}</div>${l.hint ? `<div class=\"w2\">${esc(l.hint)}</div>` : ''}<button class=\"opt\" data-act=\"dawn\">天亮</button>`;\n3689\t}\n3690\tconst onSleep = () => run(async () => {\n3691\t  sleep(S);\n3692\t  // 第二幕末：鏡子第一次映出底色，說清楚第三幕會怎樣\n3693\t  if (S.day === 7 && !S.left) {\n3694\t    if (glOK) { focus('mirror', 'night'); updateMirror(); }\n3695\t    say('', '');\n3696\t    sheet = { k: 'mirror' };\n3697\t    return;\n3698\t  }\n3699\t  view = 'watch';\n3700\t  showWatch();\n3701\t});\n3702\tconst onMirrorOk = () => { sheet = null; view = 'watch'; showWatch(); refresh(); };\n3703\tconst onDawn = () => run(async () => {\n3704\t  $('#watch').hidden = true;\n3705\t  dawn(S);\n3706\t  if (S.phase === 'board') { view = 'board'; sheet = { k: 'board' }; placeScene(); say('', ''); return; }\n3707\t  if (S.phase === 'lastwipe') { view = 'lastwipe'; placeScene(); say('', ''); showWipe(); return; }\n3708\t  toDay();\n3709\t});\n3710\tconst onNextAct = () => run(async () => {\n3711\t  nextAct(S);\n3712\t  // 沒過考核：摘牌，回家最後一次卸妝\n3713\t  if (S.phase === 'lastwipe') { sheet = null; await ink(() => { view = 'lastwipe'; placeScene(); say('', ''); }); showWipe(); return; }\n3714\t  toDay();\n3715\t});\n3716\t// ── 最後一次卸妝：她在，就是她替你擦；她走了、座位空了、你沒回家，就是你一個人對著鏡子 ──\n3717\tconst lastAlone = () => !!S.left || seatEmpty(S) || S.choice === 'stage' || wifeOf(S) === 2;\n3718\tfunction lastIntro(alone) {\n3719\t  if (S.left) return '门开着，屋里只有你。你对着镜子，卸今天的妆。';\n3720\t  if (S.fired) return alone ? '牌子摘下来了。你对着镜子，卸最后一次妆。' : '牌子摘下来了。这是最后一次卸妆。她拧了一条热毛巾：“我来。”';\n3721\t  if (alone && S.choice === 'stage' && !seatEmpty(S) && wifeOf(S) !== 2) return '散了戏回到家，灯是她一个人点的，她已经睡了。你对着镜子，自己卸。';\n3722\t  if (alone) return '对面的椅子空着。你对着镜子，自己卸。';\n3723\t  return '元宵过了。她拧了一条热毛巾：“最后一回，我替你卸干净。”';\n3724\t}\n3725\tfunction lastAfter(alone) {\n3726\t  const f = FAM[topFams()[0]].n, b = S.base;\n3727\t  if (!b) return alone ? '擦干净了。镜子里，是你自己的脸。' : '擦干净了。毛巾上全是红，你脸上什么也没留下。她把这块毛巾叠好，放进木匣，最上面。';\n3728\t  if (b < 4) return alone ? `擦到最后，镜子里还有一层淡淡的「${f}」色，擦不掉了。屋里没有人跟你说一句“就这样吧”。` : `擦到最后，还有一层淡淡的「${f}」色，擦不掉了。她停下手：“就这样吧，也是你。”`;\n3729\t  return alone ? `擦了很久，镜子里那张脸还是戏里的「${f}」。你分不清，哪一层是自己。` : `毛巾换了三条，那层「${f}」的颜色还在。她看了你很久，把毛巾放下了。`;\n3730\t}\n3731\tfunction showWipe() {\n3732\t  const el = $('#wipe'), alone = lastAlone(), fams = topFams().filter(f => S.played[f] > 0);\n3733\t  const use = fams.length ? fams.slice(0, 3) : ['sing'];\n3734\t  el.hidden = false; el.dataset.done = '';\n3735\t  el.innerHTML = `<div class=\"tx\">${esc(lastIntro(alone))}</div><div class=\"face\"><canvas id=\"clean\" width=\"400\" height=\"500\"></canvas><canvas id=\"paint\" width=\"400\" height=\"500\" aria-label=\"脸上的油彩，拖动来卸掉\"></canvas></div>\n3736\t    <div class=\"tx2\">${alone ? '在脸上拖动，把油彩擦掉。' : '在脸上拖动：让她一层一层替你擦掉。'}</div><button class=\"opt\" data-act=\"wipekey\">${alone ? '擦一下' : '让她擦一下'}<small>也可以直接在脸上拖</small></button>`;\n3737\t  drawPortrait($('#clean'), { who: 'you', layers: [], base: S.base, baseF: topFams()[0], bg: ['#8d9396', '#3b4044'] });\n3738\t  const cv = $('#paint'), x = cv.getContext('2d');\n3739\t  drawPortrait(cv, { who: 'you', layers: Array.from({ length: 6 }, (_, i) => ({ f: use[i % use.length] })), base: S.base, baseF: topFams()[0] });\n3740\t  x.globalCompositeOperation = 'destination-in'; x.beginPath(); x.ellipse(200, 275, 110, 141, 0, 0, Math.PI * 2); x.fill();\n3741\t  x.globalCompositeOperation = 'destination-out';\n3742\t  let down = false, last = null;\n3743\t  const brush = (a, b) => { x.lineCap = 'round'; x.lineWidth = 62; x.beginPath(); x.moveTo(a[0], a[1]); x.lineTo(b[0], b[1]); x.stroke(); };\n3744\t  const at = e => { const r = cv.getBoundingClientRect(); return [(e.clientX - r.left) * cv.width / r.width, (e.clientY - r.top) * cv.height / r.height]; };\n3745\t  cv.addEventListener('pointerdown', e => { down = true; last = at(e); cv.setPointerCapture(e.pointerId); brush(last, last); });\n3746\t  cv.addEventListener('pointermove', e => { if (!down) return; const p = at(e); brush(last, p); last = p; });\n3747\t  const up = () => { if (down) { down = false; sfx('cloth'); checkWipe(); } };\n3748\t  cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up);\n3749\t  window.__wipeKey = () => { const r = rng(hash(String(Date.now()))); for (let i = 0; i < 3; i++) { const a = [110 + r() * 180, 150 + r() * 250]; brush(a, [a[0] + 90 - r() * 180, a[1] + 50 - r() * 100]); } sfx('cloth'); checkWipe(); };\n3750\t}\n3751\tfunction checkWipe() {\n3752\t  const cv = $('#paint'); if (!cv) return;\n3753\t  const d = cv.getContext('2d').getImageData(0, 0, cv.width, cv.height).data;\n3754\t  let left = 0, all = 0;\n3755\t  for (let y = 134; y < 416; y += 6) for (let X = 90; X < 310; X += 6) {\n3756\t    if (((X - 200) / 110) ** 2 + ((y - 275) / 141) ** 2 > 1) continue;\n3757\t    all += 1;\n3758\t    if (d[(y * cv.width + X) * 4 + 3] > 40) left += 1;\n3759\t  }\n3760\t  if (left / all < 0.28) showAfter();\n3761\t}\n3762\t// 擦完了：油彩散掉，剩下的是底色；說一句這張臉現在是什麼樣子\n3763\tfunction showAfter() {\n3764\t  const el = $('#wipe'), cv = $('#paint');\n3765\t  if (!cv || el.dataset.done) return;\n3766\t  el.dataset.done = '1';\n3767\t  const alone = lastAlone();\n3768\t  cv.style.transition = 'opacity 1.4s'; cv.style.opacity = '0'; cv.style.pointerEvents = 'none';\n3769\t  el.querySelector('.tx2')?.remove(); el.querySelector('[data-act=\"wipekey\"]')?.remove();\n3770\t  el.insertAdjacentHTML('beforeend', `<div class=\"after\">${esc(lastAfter(alone))}</div><div class=\"tx2\">${S.base ? `底色 ${S.base}：