0); x.fillStyle = fill; x.strokeStyle = fill;\n1809\t  // 肩膀\n1810\t  x.beginPath(); x.moveTo(10, 320); x.bezierCurveTo(14, 238, 60, 206, 128, 204); x.bezierCurveTo(196, 206, 242, 238, 246, 320); x.closePath(); x.fill();\n1811\t  // 脖子與頭\n1812\t  x.fillRect(108, 168, 40, 44);\n1813\t  x.beginPath(); x.ellipse(128, 126, hw, 58, 0, 0, Math.PI * 2); x.fill();\n1814\t  // 帽子、髮髻、斗笠、辮子、花\n1815\t  if (kind === 0) { x.beginPath(); x.ellipse(128, 82, 52, 30, 0, Math.PI, 0); x.fill(); x.beginPath(); x.arc(128, 50, 9, 0, Math.PI * 2); x.fill(); }\n1816\t  if (kind === 1) { x.beginPath(); x.ellipse(128, 64, 34, 26, 0, 0, Math.PI * 2); x.fill(); x.fillRect(150, 52, 44, 5); }\n1817\t  if (kind === 2) { x.beginPath(); x.moveTo(36, 96); x.lineTo(128, 36); x.lineTo(220, 96); x.closePath(); x.fill(); }\n1818\t  if (kind === 3) { x.lineWidth = 12; x.beginPath(); x.moveTo(170, 150); x.quadraticCurveTo(206, 220, 194, 300); x.stroke(); }\n1819\t  if (kind === 4) { for (let i = 0; i < 5; i++) { const a = i * Math.PI * 2 / 5; x.beginPath(); x.ellipse(92 + Math.cos(a) * 14, 70 + Math.sin(a) * 14, 10, 6, a, 0, Math.PI * 2); x.fill(); } }\n1820\t    x.restore();\n1821\t  };\n1822\t  // 先一層紅紙稍大一點，再一層黑紙：剪紙的紅邊\n1823\t  shape('#b3202c', 0.045); shape('#0b0809', 0);\n1824\t  // 剪紙的鏤空：一圈小窗花\n1825\t  x.globalCompositeOperation = 'destination-out';\n1826\t  for (let i = 0; i < 7; i++) { const a = Math.PI * (0.15 + i * 0.12); x.beginPath(); x.ellipse(128 + Math.cos(a) * 92, 300 - Math.sin(a) * 70, 7, 3.5, a, 0, Math.PI * 2); x.fill(); }\n1827\t  x.beginPath(); x.moveTo(118, 262); x.lineTo(128, 248); x.lineTo(138, 262); x.lineTo(128, 276); x.closePath(); x.fill();\n1828\t  return c;\n1829\t}\n1830\t// 前排九個（會說話），後排八個小一點，兩邊各一個靠著台\n1831\tconst CROWD_AT = [[-1.02, 0.34, 1.05], [-0.8, 0.5, 1.2], [-0.56, 0.4, 0.95], [-0.3, 0.6, 1.1], [-0.02, 0.5, 1.0], [0.27, 0.6, 1.15], [0.55, 0.4, 0.95], [0.8, 0.52, 1.2], [1.03, 0.34, 1.05],\n1832\t  [-0.92, 0.25, 0.8], [-0.68, 0.27, 0.78], [-0.42, 0.28, 0.82], [-0.16, 0.3