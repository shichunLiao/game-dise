(r.match ? 'up' : 'none');\n3360\t    const nd = S.T.need;\n3361\t    say(`${r.name}${r.match ? ' · 对路' : ''}`, r.match ? (r.gift ? '她认出这是她给你的，眼睛亮了一下。' : pick(['她抬眼看你，手上慢了一下。', '她笑了一下，把灯骨转过来给你看。'])) : '她接过去，点点头。可这不是她今晚要的。', `${r.gain ? `灯 +${r.gain}` : '灯不涨'}${r.count === 2 ? ' · 算两张' : ''}`);\n3362\t  }\n3363\t  updateTable();\n3364\t  if (S.T.pushed.length >= S.T.homeCap && S.T.homeCap === R.homeAfterWipe) { await wait(1500); say('', '她累了，只听得下这一张。'); }\n3365\t});\n3366\t// 燈：十五片紙，每片 2 點；糊滿 30 才算美滿\n3367\tconst LSEG = 15, LANG = 360 / LSEG;\n3368\tfunction lampSVG(lamp, mark = {}) {\n3369\t  const cx = 75, cy = 75, r = 62, seg = [];\n3370\t  for (let i = 0; i < LSEG; i++) {\n3371\t    const a0 = (-90 + i * LANG) * Math.PI / 180, a1 = (-90 + (i + 1) * LANG) * Math.PI / 180, fill = clamp(lamp - i * 2, 0, 2) / 2;\n3372\t    seg.push(`<path class=\"sg ${mark[i] || ''}\" d=\"M${cx} ${cy}L${(cx + r * Math.cos(a0)).toFixed(1)} ${(cy + r * Math.sin(a0)).toFixed(1)}A${r} ${r} 0 0 1 ${(cx + r * Math.cos(a1)).toFixed(1)} ${(cy + r * Math.sin(a1)).toFixed(1)}Z\" fill=\"${fill ? '#c42433' : '#241d1f'}\" opacity=\"${fill && fill < 1 ? 0.55 : 1}\" stroke=\"#b89a5a\" stroke-width=\"1.5\"/>`);\n3373\t  }\n3374\t  return `<svg class=\"lampsvg\" viewBox=\"0 0 150 150\" aria-hidden=\"true\">${seg.join('')}<circle cx=\"${cx}\" cy=\"${cy}\" r=\"13\" fill=\"#1c1719\" stroke=\"#b89a5a\"/>${lamp >= R.lampFull ? `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r + 4}\" fill=\"none\" stroke=\"#f2d48a\" stroke-width=\"2.5\"/>` : ''}</svg>`;\n3375\t}\n3376\t// 這幾片紙在兩個燈數之間變了\n3377\tconst segsBetween = (a, b) => { const m = {}; for (let i = 0; i < LSEG; i++) if (clamp(a - i * 2, 0, 2) !== clamp(b - i * 2, 0, 2)) m[i] = 1; return m; };\n3378\t// 吃完飯當場：燈亮了還是熄了一截，熄了第幾回，還剩幾回她就走\n3379\tasync function lampFeedback(t) {\n3380\t  const el = $('#lampfb'), now = S.lamp;\n3381\t  const from = t.met ? now - t.lampGain : now + t.lampOut;\n3382\t  const head = t.met ? `<div class=\"big\">她的需要，满足了</div>` : `<div class=\"big\">灯熄了一截</div>`;\n3383\t  const rows = t.met\n3384\t    ? `<div class=\"row\">今晚灯 <b>+${t.lampGain}</b>　现在 <b>${now}</b>/${R.lampFull}　（糊满才算美满）</div>${t.gift ? `<div class=\"row\">两晚都对上：她送你一张「${T[t.gift].n}」</div>` : ''}`\n3385\t    : `<div class=\"row\">灯 <b>${from}</b> → <b>${now}</b>　熄 ${outsHTML(true)} <b>${S.outs}</b>/${R.brokenOuts}</div><div class=\"warn\">${S.outs >= R.brokenOuts ? '熄满五回了。' : `她今晚要的是 ${recipeShort(t.need)}。再熄 ${R.brokenOuts - S.outs} 回，她就走了。${S.outs === 1 ? '熄过了，这一季到不了美满。' : ''}`}</div>`;\n3386\t  el.innerHTML = `<div class=\"lf ${t.met ? '' : 'bad'}\">${head}<div class=\"lp\">${lampSVG(from)}</div>${rows}<button class=\"btn go small lfok\">${t.met ? '好' : '知道了'}</button></div>`;\n3387\t  el.hidden = false;\n3388\t  sfx(t.met ? 'lit' : 'out');\n3389\t  // 看清楚了再點掉：不自動消失\n3390\t  const ok = el.querySelector('.lfok'), done = new Promise(res => ok.addEventListener('click', e => { e.stopPropagation(); res(); }, { once: true }));\n3391\t  ok.focus({ preventScroll: true });\n3392\t  const ch = segsBetween(from, now);\n3393\t  if (calm()) el.querySelector('.lp').innerHTML = lampSVG(now);\n3394\t  else {\n3395\t    await Promise.race([wait(650), done]);\n3396\t    if (t.met) el.querySelector('.lp').innerHTML = lampSVG(now, Object.fromEntries(Object.keys(ch).map(i => [i, 'lighting'])));\n3397\t    else { el.querySelectorAll('.sg').forEach((p, i) => { if (ch[i]) p.classList.add('dying'); }); await Promise.race([wait(1150), done]); el.querySelector('.lp').innerHTML = lampSVG(now); }\n3398\t  }\n3399\t  await done;\n3400\t  el.hidden = true; el.innerHTML = '';\n3401\t}\n3402\t// 3D 的燈：熄掉的幾片閃幾下滅了，燈光一暗；亮的時候燈光暖一下\n3403\tfunction lamp3D(from, to) {\n3404\t  if (!glOK || calm()) return;\n3405\t  const nf = Math.min(12, Math.round(from * 12 / R.lampFull)), nt = Math.min(12, Math.round(to * 12 / R.lampFull)), lit = !!(S.lit || S.litAlone);\n3406\t  if (to < from) {\n3407\t    const fade = lampPatches.slice(nt, nf);\n3408\t    let k = 0;\n3409\t    const iv = setInterval(() => { k += 1; fade.forEach(p => { p.visible = k % 2 === 0; }); if (k >= 8) { clearInterval(iv); fade.forEach(p => { p.visible = false; }); } }, 150);\n3410\t    lampLight.color.setHex(0xff4a32);\n3411\t    tween(1300, e => { lampLight.intensity = lit ? 1.7 : 1.3 * (1 - e); }).then(() => lampLight.color.setHex(0xff7a4a));\n3412\t  } else tween(1600, e => { lampLight.intensity = lit ? 1.7 : 1.5 * Math.sin(e * Math.PI); });\n3413\t}\n3414\t// 她走了：痕到 4，或燈熄滿 5 回\n3415\tconst LEAVE_TX = { outs: '“灯熄了五回。我一个人，糊不动了。”', scars: '“灯上划了四道。补不回来了。”' };\n3416\tasync function herLeaving() {\n3417\t  const why = S.outs >= R.brokenOuts ? 'outs' : 'scars';\n3418\t  if (glOK) { focus('home', 'night'); wife.react('down'); }\n3419\t  say('阿檀', LEAVE_TX[why]);\n3420\t  await wait(2800);\n3421\t  if (glOK) wife.root.visible = false;\n3422\t  sfx('cloth');\n3423\t  say('', '她把灯搁在桌上，起身走了。门开着，没关。');\n3424\t  banner('她走了', '这一季，到这里为止', 'bad slow');\n3425\t  await wait(3200);\n3426\t  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n3427\t  say('', '屋里只剩你一个人。', '天亮以后，最后一次卸妆。');\n3428\t}\n3429\tconst onEndEvening = () => run(async () => {\n3430\t  const lamp0 = S.lamp;\n3431\t  endEvening(S);\n3432\t  const t = S.T, look = t.need.look;\n3433\t  // 先看她的需要：滿足了，或燈熄一截。當場就看到燈\n3434\t  if (t.met) {\n3435\t    wife?.react('up');\n3436\t    sayH('阿檀', esc(MET_TX[look]), t.gift ? `<span class=\"itag\">她送你一张家常牌「${T[t.gift].n}」：对上她的需要，一张算两张</span>` : '她今晚的需要，满足了');\n3437\t  } else {\n3438\t    wife?.react('down');\n3439\t    sayH('', `${esc(OUT_TX[look])}灯${K('熄了一截')}。`, `没推够（${recipeShort(t.need)}）：灯 −${t.lampOut}，熄了第 ${S.outs} 回`);\n3440\t  }\n3441\t  if (glOK) focus('lamp', 'home');\n3442\t  updateTable(); renderPlate(); lamp3D(lamp0, S.lamp);\n3443\t  await lampFeedback(t);\n3444\t  if (glOK) focus('home', 'home');\n3445\t  if (S.left) { await herLeaving(); return; }\n3446\t  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n3447\t  const base = t.layers.length ? `镜子里还有 ${t.layers.length} 层，睡一觉就渗进底色。` : '';\n3448\t  // 一段的最後一晚：她說起往後兩天\n3449\t  if (t.forecast) sayH('阿檀', foreTx(t.forecast), intelTag(t.forecast) + (base ? `<br>${esc(base)}` : ''));\n3450\t  else say('', t.layers.length ? `夜里，${base}` : '夜里，镜子里的脸是干净的。');\n3451\t});\n3452\tconst onLight = () => run(async () => {\n3453\t  lightLamp(S);\n3454\t  updateTable();\n3455\t  if (glOK) focus('home', 'home');\n3456\t  say('', S.scars >= R.seatScar ? '你一个人把灯点上了。' : '她把火递给你。你们一起把灯点上了。');\n3457\t  await wait(2600);\n3458\t  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n3459\t  say('', '外面的戏开锣了。你没有去。');\n3460\t});\n3461\tfunction showWatch() {\n3462\t  const w = $('#watch'), l = S.T.watch || { tx: '', hint: '' }; w.hidden = false;\n3463\t  sfx('knock');\n3464\t  w.innerHTML = `<div class=\"knock\">梆　梆　梆</div><div class=\"w\">${esc(l.tx)}</div>${l.hint ? `<div class=\"w2\">${esc(l.hint)}</div>` : ''}<button class=\"opt\" data-act=\"dawn\">天亮</button>`;\n3465\t}\n3466\tconst onSleep = () => run(async () => {\n3467\t  sleep(S);\n3468\t  // 第二幕末：鏡子第一次映出底色，說清楚第三幕會怎樣\n3469\t  if (S.day === 7 && !S.left) {\n3470\t    if (glOK) { focus('mirror', 'night'); updateMirror(); }\n3471\t    say('', '');\n3472\t    sheet = { k: 'mirror' };\n3473\t    return;\n3474\t  }\n3475\t  view = 'watch';\n3476\t  showWatch();\n3477\t});\n3478\tconst onMirrorOk = () => { sheet = null; view = 'watch'; showWatch(); refresh(); };\n3479\tconst onDawn = () => run(async () => {\n3480\t  $('#watch').hidden = true;\n3481\t  dawn(S);\n3482\t  if (S.phase === 'board') { view = 'board'; sheet = { k: 'board' }; placeScene(); say('', ''); return; }\n3483\t  if (S.phase === 'lastwipe') { view = 'lastwipe'; placeScene(); say('', ''); showWipe(); return; }\n3484\t  toDay();\n3485\t});\n3486\tconst onNextAct = () => run(async () => {\n3487\t  nextAct(S);\n3488\t  // 沒過考核：摘牌，回家最後一次卸妝\n3489\t  if (S.phase === 'lastwipe') { sheet = null; await ink(() => { view = 'lastwipe'; placeScene(); say('', ''); }); showWipe(); return; }\n3490\t  toDay();\n3491\t});\n3492\t// ── 最後一次卸妝：她在，就是她替你擦；她走了、座位空了、你沒回家，就是你一個人對著鏡子 ──\n3493\tconst lastAlone = () => !!S.left || seatEmpty(S) || S.choice === 'stage' || wifeOf(S) === 2;\n3494\tfunction lastIntro(alone) {\n3495\t  if (S.left) return '门开着，屋里只有你。你对着镜子，卸今天的妆。';\n3496\t  if (S.fired) return alone ? '牌子摘下来了。你对着镜子，卸最后一次妆。' : '牌子摘下来了。这是最后一次卸妆。她拧了一条热毛巾：“我来。”';\n3497\t  if (alone && S.choice === 'stage' && !seatEmpty(S) && wifeOf(S) !== 2) return '散了戏回到家，灯是她一个人点的，她已经睡了。你对着镜子，自己卸。';\n3498\t  if (alone) return '对面的椅子空着。你对着镜子，自己卸。';\n3499\t  return '元宵过了。她拧了一条热毛巾：“最后一回，我替你卸干净。”';\n3500\t}\n3501\tfunction lastAfter(alone) {\n3502\t  const f = FAM[topFams()[0]].n, b = S.base;\n3503\t  if (!b) return alone ? '擦干净了。镜子里，是你自己的脸。' : '擦干净了。毛巾上全是红，你脸上什么也没留下。她把这块毛巾叠好，放进木匣，最上面。';\n3504\t  if (b < 4) return alone ? `擦到最后，镜子里还有一层淡淡的「${f}」色，擦不掉了。屋里没有人跟你说一句“就这样吧”。` : `擦到最后，还有一层淡淡的「${f}」色，擦不掉了。她停下手：“就这样吧，也是你。”`;\n3505\t  return alone ? `擦了很久，镜子里那张脸还是戏里的「${f}」。你分不清，哪一层是自己。` : `毛巾换了三条，那层「${f}」的颜色还在。她看了你很久，把毛巾放下了。`;\n3506\t}\n3507\tfunction showWipe() {\n3508\t  const el = $('#wipe'), alone = lastAlone(), fams = topFams().filter(f => S.played[f] > 0);\n3509\t  const use = fams.length ? fams.slice(0, 3) : ['sing'];\n3510\t  el.hidden = false; el.dataset.done = '';\n3511\t  el.innerHTML = `<div class=\"tx\">${esc(lastIntro(alone))}</div><div class=\"face\"><canvas id=\"clean\" width=\"400\" height=\"500\"></canvas><canvas id=\"paint\" width=\"400\" height=\"500\" aria-label=\"脸上的油彩，拖动来卸掉\"></canvas></div>\n3512\t    <div class=\"tx2\">${alone ? '在脸上拖动，把油彩擦掉。' : '在脸上拖动：让她一层一层替你擦掉。'}</div><button class=\"opt\" data-act=\"wipekey\">${alone ? '擦一下' : '让她擦一下'}<small>也可以直接在脸上拖</small></button>`;\n3513\t  drawPortrait($('#clean'), { who: 'you', layers: [], base: S.base, baseF: topFams()[0], bg: ['#8d9396', '#3b4044'] });\n3514\t  const cv = $('#paint'), x = cv.getContext('2d');\n3515\t  drawPortrait(cv, { who: 'you', layers: Array.from({ length: 6 }, (_, i) => ({ f: use[i % use.length] })), base: S.base, baseF: topFams()[0] });\n3516\t  x.globalCompositeOperation = 'destination-in'; x.beginPath(); x.ellipse(200, 275, 110, 141, 0, 0, Math.PI * 2); x.fill();\n3517\t  x.globalCompositeOperation = 'destination-out';\n3518\t  let down = false, last = null;\n3519\t  const brush = (a, b) => { x.lineCap = 'round'; x.lineWidth = 62; x.beginPath(); x.moveTo(a[0], a[1]); x.lineTo(b[0], b[1]); x.stroke(); };\n3520\t  const at = e => { const r = cv.getBoundingClientRect(); return [(e.clientX - r.left) * cv.width / r.width, (e.clientY - r.top) * cv.height / r.height]; };\n3521\t  cv.addEventListener('pointerdown', e => { down = true; last = at(e); cv.setPointerCapture(e.pointerId); brush(last, last); });\n3522\t  cv.addEventListener('pointermove', e => { if (!down) return; const p = at(e); brush(last, p); last = p; });\n3523\t  const up = () => { if (down) { down = false; sfx('cloth'); checkWipe(); } };\n3524\t  cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up);\n3525\t  window.__wipeKey = () => { const r = rng(hash(String(Date.now()))); for (let i = 0; i < 3; i++) { const a = [110 + r() * 180, 150 + r() * 250]; brush(a, [a[0] + 90 - r() * 180, a[1] + 50 - r() * 100]); } sfx('cloth'); checkWipe(); };\n3526\t}\n3527\tfunction checkWipe() {\n3528\t  const cv = $('#paint'); if (!cv) return;\n3529\t  const d = cv.getContext('2d').getImageData(0, 0, cv.width, cv.height).data;\n3530\t  let left = 0, all = 0;\n3531\t  for (let y = 134; y < 416; y += 6) for (let X = 90; X < 310; X += 6) {\n3532\t    if (((X - 200) / 110) ** 2 + ((y - 275) / 141) ** 2 > 1) continue;\n3533\t    all += 1;\n3534\t    if (d[(y * cv.width + X) * 4 + 3] > 40) left += 1;\n3535\t  }\n3536\t  if (left / all < 0.28) showAfter();\n3537\t}\n3538\t// 擦完了：油彩散掉，剩下的是底色；說一句這張臉現在是什麼樣子\n3539\tfunction showAfter() {\n3540\t  const el = $('#wipe'), cv = $('#paint');\n3541\t  if (!cv || el.dataset.done) return;\n3542\t  el.dataset.done = '1';\n3543\t  const alone = lastAlone();\n3544\t  cv.style.transition = 'opacity 1.4s'; cv.style.opacity = '0'; cv.style.pointerEvents = 'none';\n3545\t  el.querySelector('.tx2')?.remove(); el.querySelector('[data-act=\"wipekey\"]')?.remove();\n3546\t  el.insertAdjacentHTML('beforeend', `<div class=\"after\">${esc(lastAfter(alone))}</div><div class=\"tx2\">${S.base ? `底色 ${S.base}：这一季没卸掉的油彩，渗进去的，就留下了。` : '这一季的油彩，每一层都卸掉了。'}</div><button class=\"opt\" data-act=\"lastdone\">${alone ? '放下毛巾' : '让她把毛巾收起来'}</button>`);\n3547\t  el.querySelector('[data-act=\"lastdone\"]')?.focus({ preventScroll: true });\n3548\t}\n3549\tconst finishLast = () => run(async () => {\n3550\t  if (S.phase !== 'lastwipe') return;\n3551\t  // 她替你擦的最後一塊布，疊在木匣最上面\n3552\t  if (!lastAlone()) S.chest.push({ day: S.day, f: topFams()[0], last: true });\n3553\t  finishWipe(S);\n3554\t  $('#wipe').hidden = true; $('#wipe').innerHTML = '';\n3555\t  view = 'reveal'; sheet = { k: 'r_board' };\n3556\t  S.T.layers = [];\n3557\t  placeScene();\n3558\t  say('', '');\n3559\t});\n3560\t// 提前結束的結局：她走的那天、摘牌那天\n3561\tconst ENDING_EARLY = {\n3562\t  头牌: '她走的那天，水牌最上面写的是你。你回到家，门开着，那盏灯没糊完，灯上全是划痕。',\n3563\t  戏散: '她走了。你的名字还挂在水牌中间，没人来问。后面的戏，你没有再上。',\n3564\t  更夫: '她走了，牌子也摘了。春天，城里多了一个不上妆的更夫。你接过梆子，第一声敲在自家门口。',\n3565\t  卸尽: '考核那天，你的牌子被摘了下来。回到家，她什么也没问，把灯递到你手里。往后，你不用再上妆了。',\n3566\t  素脸: '摘牌那天，你素着脸回家。她没说什么，给你盛了饭。灯上熄过的几处，还暗着。',\n3567\t};\n3568\tfunction showFinal() {\n3569\t  const e = endingOf(S), w = $('#watch'), kind = ['美满', '守住', '破裂'][wifeOf(S)];\n3570\t  sheet = null; w.hidden = false; sfx('knock');\n3571\t  const early = !!(S.left || S.fired), tx = early && ENDING_EARLY[e] ? ENDING_EARLY[e] : ENDING_TX[e];\n3572\t  w.innerHTML = `<div class=\"knock\">梆　梆　梆</div><div class=\"w\">${esc(S.name)}。</div><div class=\"w2\" style=\"max-width:32em\">${esc(tx)}</div><div class=\"end\">${e}</div>\n3573\t    <div class=\"sum\">${early ? `这一季在第 ${endDay(S)} 天${S.left ? '她走了' : '摘了牌'}，提前结束 · ` : ''}卖座 ${S.gold} · 水牌第 ${rankOf(S)} · 妻子${kind} · 灯 ${S.lamp}（熄过 ${S.outs} 回）· 痕 ${S.scars} · 底色 ${S.base} · 满足 ${S.log.filter(x => x.met).length} 晚${S.choice ? ` · 元宵${{ stage: '上台', lamp: '回家点灯', cover: '替小凤代演' }[S.choice]}` : ''}</div>\n3574\t    <div class=\"acts\"><button class=\"btn go\" data-act=\"again\">再来一季</button><button class=\"btn\" data-act=\"home\">回到开场</button></div>`;\n3575\t}\n3576\t\n3577\t$('#title').addEventListener('input', e => { if (e.target.id === 'nm') draftName = e.target.value; });\n3578\tdocument.addEventListener('click', e => {\n3579\t  wakeAudio();\n3580\t  const b = e.target.closest('[data-act]');\n3581\t  if (!b || b.disabled) return;\n3582\t  const a = b.dataset.act, arg = b.dataset.arg, id = Number(arg);\n3583\t  switch (a) {\n3584\t    case 'start': setTutPref(!!$('#tutChk')?.checked); startGame((draftName.trim() || '小满').slice(0, 6)); return;\n3585\t    case 'cont': continueGame(); return;\n3586\t    case 'coachnext': coachNext(); break;\n3587\t    case 'coachskip': coachSkip(); break;\n3588\t    case 'rules': panel = panel === 'rules' ? null : 'rules'; break;\n3589\t    case 'close': panel = null; break;\n3590\t    case 'opt': S.opt[arg] = !S.opt[arg]; break;\n3591\t    case 'mute': muted = !muted; break;\n3592\t    case 'music': musicOn = !musicOn; try { localStorage.setItem(MUSIC_KEY, musicOn ? '1' : '0'); } catch (err) { /* 存不了就算了 */ } break;\n3593\t    case 'book': panel = panel === 'book' ? null : 'book'; bookSel = null; break;\n3594\t    case 'booktab': bookTab = arg; bookSel = null; break;\n3595\t    case 'booksel': bookSel = arg || null; break;\n3596\t    case 'yuan': choose(S, arg); say('', { stage: '你把戏服抖开。', lamp: '你把戏服叠起来，放回箱子。', cover: '你接过小凤托人送来的头面。' }[arg]); break;\n3597\t    case 'pick': { const c = S.deck.find(x => x.t === arg && !S.T.box.includes(x.id)); if (c) { if (S.T.box.length >= S.T.cap) S.T.box.pop(); toggleBox(S, c.id); } break; }\n3598\t    case 'yesterday': boxYesterday(S); break;\n3599\t    case 'shop': panel = 'shop'; break;\n3600\t    case 'water': panel = panel === 'water' ? null : 'water'; break;\n3601\t    case 'buy': { const c = buy(S, arg); if (c) { sfx('cheer'); if (c.relic) say('孙师父', `“${RELICS[arg].n}，你留着。”`, `卖座 −${RELICS[arg].price}，水牌第 ${rankOf(S)}：${RELICS[arg].tx}`); else say('孙师父', `“「${T[arg].n}」，拿去。”`, `卖座 −${T[arg].price}，水牌第 ${rankOf(S)}；这张进了卡组`); } break; }\n3602\t    case 'clear': clearBox(S); break;\n3603\t    case 'depart': onDepart(); return;\n3604\t    case 'endstage': onEndStage(); return;\n3605\t    case 'todoor': onToDoor(); return;\n3606\t    case 'wipe': onWipe(); return;\n3607\t    case 'enter': onEnter(); return;\n3608\t    case 'look': lookOpen = !lookOpen; break;\n3609\t    case 'endeve': onEndEvening(); return;\n3610\t    case 'light': onLight(); return;\n3611\t    case 'sleep': onSleep(); return;\n3612\t    case 'dawn': onDawn(); return;\n3613\t    case 'nextact': onNextAct(); return;\n3614\t    case 'wipekey': window.__wipeKey?.(); return;\n3615\t    case 'lastdone': finishLast(); return;\n3616\t    case 'mirrorok': onMirrorOk(); return;\n3617\t    case 'rstep': sheet = { k: arg }; if (arg === 'r_home') { focus('home', 'home'); } if (arg === 'r_chest') focus('table', 'home'); break;\n3618\t    case 'rfinal': showFinal(); break;\n3619\t    case 'again': $('#watch').hidden = true; startGame(S.name); return;\n3620\t    case 'home': $('#watch').hidden = true; saved = load(); S = null; view = 'title'; sheet = null; panel = null; coach.lesson = null; clearBubs(); if (glOK) focus('table', 'night'); refresh(); return;\n3621\t    case 'card':\n3622\t      if (view === 'morning') { toggleBox(S, id); break; }\n3623\t      if (view === 'stage') { onStage(id); return; }\n3624\t      if (view === 'evening') { onHome(id); return; }\n3625\t      if (view === 'door' || view === 'night') { onClean(id); return; }\n3626\t      break;\n3627\t  }\n3628\t  refresh();\n3629\t});\n3630\tdocument.addEventListener('keydown', e => { if (e.key === 'Escape' && panel) { panel = null; refresh(); } });\n3631\t\n3632\t// 測試用：在主控台裡看規則與流程\n3633\twindow.__dise = { R, T, newGame, endingOf, boardOf, get S() { return S; }, get view() { return view; } };\n3634\t\n3635\t(async function boot() {\n3636\t  const glyphs = Object.values(T).map(t => t.n).join('') + Object.values(HOME).map(h => h.n + h.look).join('') + '底色戏城金接背面空白借灯唱念做打起手第天';\n3637\t  try { await Promise.race([Promise.all([document.fonts.load('40px \"Ma Shan Zheng\"', glyphs), document.fonts.load('16px \"Noto Serif SC\"', glyphs)]), wait(3500)]); } catch (e) { /* 字體載不到就用後備字體 */ }\n3638\t  initGL();\n3639\t  saved = load();\n3640\t  if (glOK) {\n3641\t    focus('table', 'night');\n3642\t    wife.base = 'work'; wife.pose('work'); wife.root.position.set(0, -0.32, SEAT_Z[0]); stool.position.set(0, 0, SEAT_Z[0] - 0.02);\n3643\t    actor.root.visible = false;\n3644\t    drawPortrait(mirrorCv, { who: 'you', layers: [], bg: ['#8d9396', '#3b4044'] }); mirrorTex.needsUpdate = true;\n3645\t  }\n3646\t  refresh();\n3647\t})();\n3648\t</script>\n3649\t"}]},"parent_tool_use_id":null,"session_id":"737d43d7-3217-4b6e-a07b-b68e7bdbe8c6","uuid":"a565bb42-889e-442d-86ff-ae44a092c3c5","timestamp":"2026-11-11T14:40:08.857Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.6/index.html","content":"  view = S.phase;\n  clear3DCards();\n  placeScene();\n  if (glOK) actor.setLayers([]);\n  const st = starterOf(S), ev = eventOf(S), k = S.events[S.day];\n  if (view === 'stage') say('班主', DAY_TX[S.day - 1]);\n  else if (ev) sayH(ev.who, EV_TX[k](), esc(DAY_TX[S.day - 1]));\n  else say('', DAY_TX[S.day - 1]);\n  refresh();\n}\nfunction startGame(name) {\n  S = newGame(name, ((Date.now() % 2147483647) ^ Math.floor(Math.random() * 2147483647)) >>> 0);\n  S.tut = { off: !tutPref(), seen: {} };\n  saved = null; panel = null; coach.lesson = null;\n  $('#watch').hidden = true;\n  toDay();\n}\nfunction continueGame() {\n  S = saved; saved = null; panel = null; lookOpen = false;\n  S.tut = S.tut || { off: true, seen: {} };\n  coach.lesson = null;\n  view = S.phase; sheet = view === 'board' ? { k: 'board' } : view === 'reveal' ? { k: 'r_board' } : null;\n  placeScene();\n  if (view === 'watch') showWatch();\n  if (view === 'lastwipe') showWipe();\n  say('', `第 ${S.day} 天，接着来。`);\n  refresh();\n}\nconst onDepart = () => run(async () => {\n  depart(S);\n  if (S.phase === 'evening') { await ink(() => { view = 'evening'; placeScene(); }); say('', seatEmpty(S) ? '灯坊里只有你。灯骨搁在桌上。' : '她抬头看见你，没问你怎么没去。她把灯骨推过来。'); return; }\n  stageHeat = 0;\n  await ink(() => { view = 'stage'; placeScene(); actor?.setLayers([]); actor?.pose('idle'); });\n  say('班主', `起手${FAM[starterOf(S)].n}。${S.T.stageMax < R.stageMax ? '今天只有四张。' : ''}`);\n  const k = S.events[S.day];\n  if (k && EV_BUB[k]) setTimeout(() => bubble(EV_BUB[k], 'ev'), 700);\n  // 一上台，台下就有人聊她今晚的事\n  setTimeout(() => { if (view === 'stage' && !S.T.ended) crowdIntel(); }, 1500);\n});\n// 台下聊起她今晚的事：第 1 天在第二張之後，其餘天在第一張之後\nfunction crowdIntel() {\n  const t = S.T;\n  // 第 1 天傍晚是自動的，台下不聊她\n  if (S.day === 1 || t.heard || seatEmpty(S) || S.choice === 'stage' || S.choice === 'lamp') return;\n  if (!hearCrowd(S)) return;\n  const nd = needOf(S);\n  setTimeout(() => {\n    const html = `${CROWD_TX[nd.look]}${nd.items[1] ? `还有人说，${CROWD_B[nd.items[1].look]}` : ''}`;\n    bubble(`${html}<div><span class=\"itag\">今晚她要：${recipeShort(nd)}</span></div>`, 'intel');\n    refresh();\n  }, 650);\n}\nconst onStage = id => run(async () => {\n  const name = tOf(S, id).n, f = fOf(S, id);\n  await fly(id, 'stage');\n  const p = playStage(S, id);\n  if (!p) return;\n  if (actor) { actor.perform(f); actor.setLayers(S.T.layers); }\n  sfx(p.broke ? 'boo' : 'cheer');\n  const tp = tOf(S, id), t = S.T;\n  // 台下：起伏、說話；聚光燈跟著連擊亮起來\n  crowdKick(p.broke ? 'down' : t.chain >= 3 ? 'big' : 'up');\n  stageHeat = p.broke ? 0 : Math.min(2.4, (t.chain - 1) * 0.6);\n  if (glOK && p.broke) { lights.spot.color.setHex(0xff6a5a); setTimeout(() => lights.spot.color.setHex(0xffe0b0), 600); }\n  const pool = p.broke ? CROWD.broke : p.seeped ? CROWD.seep : p.fin ? CROWD.fin : tp.wild && (p.hit || p.open || t.plays.length === 1) ? CROWD.wild : tp.boost && p.hit ? CROWD.boost : tp.clean ? CROWD.clean : tp.heavy ? CROWD.heavy : tp.blank ? CROWD.blank : p.open ? CROWD.open : t.chain >= 3 ? CROWD.big : CROWD.hit;\n  // 第一天只在第一張和接錯時開口；教學框開著也不插嘴\n  if ((S.day > 1 || p.broke || t.plays.length === 1) && !coachOn()) bubble(esc(pick(pool)), p.broke ? 'boo' : 'n');\n  comboFx(p);\n  if (p.broke) say('', p.grudge ? '台下一声低低的嘘，跟着你下了台。' : '台下一声低低的嘘。', p.grudge ? '接错了 · 怨气 +1' : '接错了');\n  else if (p.seeped) say('', '这一层没挂住，直接渗了进去。', p.extra ? `连击 +${p.extra} 金` : '');\n  else if (p.open) sayN(`开得正 +${p.open} 金`);\n  else if (t.plays.length === 1 && tp.wild) sayN('百搭起手');\n  else sayN(`连击 ×${t.chain} · 多 ${p.extra} 金${tp.boost ? '（托）' : ''}${p.fin ? ` · 压轴 +${p.fin}` : ''}${tp.heavy ? ' · 两层' : ''}${tp.clean ? ' · 不上妆' : ''}`);\n  crowdIntel();\n});\nconst onEndStage = () => run(async () => {\n  endStage(S);\n  const t = S.T;\n  if (t.die !== null) await showDice({ label: '连击到 3：掷到 4 以上，金 ×1.5', v: t.die, ok: t.perfect, result: t.perfect ? '完美' : '没中，不扣金' });\n  if (t.gold) { burst(t.gold * 2); sfx('cheer'); crowdKick('big'); }\n  if (t.perfect) { stamp('完美'); bubble(esc(pick(CROWD.perfect)), 'n'); spawn('foil', 140); spawn('ribbon', 8); [0, 300, 600, 900].forEach(d => setTimeout(() => spawn('fw', 70, { x: innerWidth * (0.15 + Math.random() * 0.7), y: innerHeight * (0.1 + Math.random() * 0.25) }), d)); }\n  stageHeat = t.perfect ? 2.4 : 0.6;\n  actor?.pose('bow');\n  const who = S.choice === 'cover' ? `这 ${t.gold} 金，记在小凤名下。` : S.choice === 'stage' ? `元宵，金 ×2：${t.gold} 金。` : '';\n  say('班主', t.plays.length ? (who || `散戏。${t.gold} 金。`) : '今天你没有上台。');\n});\nconst onToDoor = () => run(async () => {\n  parts.length = 0;\n  if (S.phase === 'night') {\n    await ink(() => { view = 'night'; placeScene(); say('', ''); });\n    say('', '元宵的灯笼从窗外过去。你没有回家。', S.T.layers.length ? '剩下的牌还能卸。' : '');\n    return;\n  }\n  await ink(() => { view = 'door'; placeScene(); say('', ''); });\n  if (glOK && S.scars <= R.wipeScarMax && S.T.layers.length && !seatEmpty(S)) wife.pose('reach');\n  if (!S.T.layers.length) say('', '脸是干净的。');\n  else if (S.scars <= R.wipeScarMax) say('阿檀', '回来啦。擦一擦？');\n  else say('', '她坐着，没有起身。');\n});\nconst onWipe = () => run(async () => {\n  if (!canWipe(S)) return;\n  const n = Math.min(R.wipeLayers, S.T.layers.length), cols = S.T.layers.slice(-n).reverse().map(l => FCOL[l.f]);\n  if (glOK) { wife.pose('reach'); await wait(200); }\n  for (const c of cols) await towelSwipe(c);\n  wipe(S); renderSmear(); sfx('cloth');\n  say('阿檀', n === 2 ? '她替你擦掉两层，把毛巾叠起来，收进木匣。' : '她替你擦掉一层，把毛巾收进木匣。', '今晚她只听得下 1 张');\n  if (glOK) wife.pose(wife.base);\n});\nconst restTx = () => (S.T.layers.length ? `还剩 ${S.T.layers.length} 层。` : '脸上干净了。');\nconst onClean = id => run(async () => {\n  const name = tOf(S, id).n;\n  await fly(id, 'cloth');\n  selfClean(S, id); renderSmear(); sfx('cloth');\n  say('', `「${name}」成了一块布，挂上晾绳。${restTx()}`);\n});\nconst onEnter = () => run(async () => {\n  enterHome(S);\n  const t = S.T;\n  if (t.auto) {\n    await ink(() => { view = 'night'; placeScene(); say('', ''); });\n    say('', '她把饭留在桌上，灯又糊了一片。', '灯 +1');\n    await wait(2200);\n    if (t.forecast) { sayH('阿檀', foreTx(t.forecast), intelTag(t.forecast)); refresh(); }\n    // 不自動天亮：玩家看完、想好了，自己點「睡吧」\n    return;\n  }\n  if (t.emptySeat) {\n    await ink(() => { view = 'night'; placeScene(); say('', ''); });\n    say('', '对面的椅子空着。灯不再糊了。', t.layers.length ? '剩下的牌还能卸。' : '');\n    return;\n  }\n  await ink(() => { view = 'evening'; lookOpen = false; placeScene(); say('', ''); });\n  const nd = S.T.need;\n  sayH('阿檀', LOOK_TX[nd.look] + (nd.items[1] ? `“${ALSO_TX[nd.items[1].look]}”` : ''), S.T.dye ? `前 ${S.T.dye} 张会被染` : '');\n});\nconst onHome = id => run(async () => {\n  await fly(id, 'home');\n  const r = playHome(S, id);\n  if (!r) return;\n  if (r.dyed) {\n    wife?.react('down');\n    const txt = r.blank ? '她翻过来看。背面什么也没有。' : HOME[r.h].hurt;\n    say(`${r.name} · 被染`, txt, r.scar ? '灯上留了一道痕' : '这一道不算数');\n  } else if (r.blank) {\n    wife?.react('none');\n    say('空白', '她翻过来看。背面什么也没有。', '灯不涨');\n  } else {\n    wife?.react(r.match ? 'up' : 'none');\n    const nd = S.T.need;\n    say(`${r.name}${r.match ? ' · 对路' : ''}`, r.match ? (r.gift ? '她认出这是她给你的，眼睛亮了一下。' : pick(['她抬眼看你，手上慢了一下。', '她笑了一下，把灯骨转过来给你看。'])) : '她接过去，点点头。可这不是她今晚要的。', `${r.gain ? `灯 +${r.gain}` : '灯不涨'}${r.count === 2 ? ' · 算两张' : ''}`);\n  }\n  updateTable();\n  if (S.T.pushed.length >= S.T.homeCap && S.T.homeCap === R.homeAfterWipe) { await wait(1500); say('', '她累了，只听得下这一张。'); }\n});\n// 燈：十五片紙，每片 2 點；糊滿 30 才算美滿\nconst LSEG = 15, LANG = 360 / LSEG;\nfunction lampSVG(lamp, mark = {}) {\n  const cx = 75, cy = 75, r = 62, seg = [];\n  for (let i = 0; i < LSEG; i++) {\n    const a0 = (-90 + i * LANG) * Math.PI / 180, a1 = (-90 + (i + 1) * LANG) * Math.PI / 180, fill = clamp(lamp - i * 2, 0, 2) / 2;\n    seg.push(`<path class=\"sg ${mark[i] || ''}\" d=\"M${cx} ${cy}L${(cx + r * Math.cos(a0)).toFixed(1)} ${(cy + r * Math.sin(a0)).toFixed(1)}A${r} ${r} 0 0 1 ${(cx + r * Math.cos(a1)).toFixed(1)} ${(cy + r * Math.sin(a1)).toFixed(1)}Z\" fill=\"${fill ? '#c42433' : '#241d1f'}\" opacity=\"${fill && fill < 1 ? 0.55 : 1}\" stroke=\"#b89a5a\" stroke-width=\"1.5\"/>`);\n  }\n  return `<svg class=\"lampsvg\" viewBox=\"0 0 150 150\" aria-hidden=\"true\">${seg.join('')}<circle cx=\"${cx}\" cy=\"${cy}\" r=\"13\" fill=\"#1c1719\" stroke=\"#b89a5a\"/>${lamp >= R.lampFull ? `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r + 4}\" fill=\"none\" stroke=\"#f2d48a\" stroke-width=\"2.5\"/>` : ''}</svg>`;\n}\n// 這幾片紙在兩個燈數之間變了\nconst segsBetween = (a, b) => { const m = {}; for (let i = 0; i < LSEG; i++) if (clamp(a - i * 2, 0, 2) !== clamp(b - i * 2, 0, 2)) m[i] = 1; return m; };\n// 吃完飯當場：燈亮了還是熄了一截，熄了第幾回，還剩幾回她就走\nasync function lampFeedback(t) {\n  const el = $('#lampfb'), now = S.lamp;\n  const from = t.met ? now - t.lampGain : now + t.lampOut;\n  const head = t.met ? `<div class=\"big\">她的需要，满足了</div>` : `<div class=\"big\">灯熄了一截</div>`;\n  const rows = t.met\n    ? `<div class=\"row\">今晚灯 <b>+${t.lampGain}</b>　现在 <b>${now}</b>/${R.lampFull}　（糊满才算美满）</div>${t.gift ? `<div class=\"row\">两晚都对上：她送你一张「${T[t.gift].n}」</div>` : ''}`\n    : `<div class=\"row\">灯 <b>${from}</b> → <b>${now}</b>　熄 ${outsHTML(true)} <b>${S.outs}</b>/${R.brokenOuts}</div><div class=\"warn\">${S.outs >= R.brokenOuts ? '熄满五回了。' : `她今晚要的是 ${recipeShort(t.need)}。再熄 ${R.brokenOuts - S.outs} 回，她就走了。${S.outs === 1 ? '熄过了，这一季到不了美满。' : ''}`}</div>`;\n  el.innerHTML = `<div class=\"lf ${t.met ? '' : 'bad'}\">${head}<div class=\"lp\">${lampSVG(from)}</div>${rows}<button class=\"btn go small lfok\">${t.met ? '好' : '知道了'}</button></div>`;\n  el.hidden = false;\n  sfx(t.met ? 'lit' : 'out');\n  // 看清楚了再點掉：不自動消失\n  const ok = el.querySelector('.lfok'), done = new Promise(res => ok.addEventListener('click', e => { e.stopPropagation(); res(); }, { once: true }));\n  ok.focus({ preventScroll: true });\n  const ch = segsBetween(from, now);\n  if (calm()) el.querySelector('.lp').innerHTML = lampSVG(now);\n  else {\n    await Promise.race([wait(650), done]);\n    if (t.met) el.querySelector('.lp').innerHTML = lampSVG(now, Object.fromEntries(Object.keys(ch).map(i => [i, 'lighting'])));\n    else { el.querySelectorAll('.sg').forEach((p, i) => { if (ch[i]) p.classList.add('dying'); }); await Promise.race([wait(1150), done]); el.querySelector('.lp').innerHTML = lampSVG(now); }\n  }\n  await done;\n  el.hidden = true; el.innerHTML = '';\n}\n// 3D 的燈：熄掉的幾片閃幾下滅了，燈光一暗；亮的時候燈光暖一下\nfunction lamp3D(from, to) {\n  if (!glOK || calm()) return;\n  const nf = Math.min(12, Math.round(from * 12 / R.lampFull)), nt = Math.min(12, Math.round(to * 12 / R.lampFull)), lit = !!(S.lit || S.litAlone);\n  if (to < from) {\n    const fade = lampPatches.slice(nt, nf);\n    let k = 0;\n    const iv = setInterval(() => { k += 1; fade.forEach(p => { p.visible = k % 2 === 0; }); if (k >= 8) { clearInterval(iv); fade.forEach(p => { p.visible = false; }); } }, 150);\n    lampLight.color.setHex(0xff4a32);\n    tween(1300, e => { lampLight.intensity = lit ? 1.7 : 1.3 * (1 - e); }).then(() => lampLight.color.setHex(0xff7a4a));\n  } else tween(1600, e => { lampLight.intensity = lit ? 1.7 : 1.5 * Math.sin(e * Math.PI); });\n}\n// 她走了：痕到 4，或燈熄滿 5 回\nconst LEAVE_TX = { outs: '“灯熄了五回。我一个人，糊不动了。”', scars: '“灯上划了四道。补不回来了。”' };\nasync function herLeaving() {\n  const why = S.outs >= R.brokenOuts ? 'outs' : 'scars';\n  if (glOK) { focus('home', 'night'); wife.react('down'); }\n  say('阿檀', LEAVE_TX[why]);\n  await wait(2800);\n  if (glOK) wife.root.visible = false;\n  sfx('cloth');\n  say('', '她把灯搁在桌上，起身走了。门开着，没关。');\n  banner('她走了', '这一季，到这里为止', 'bad slow');\n  await wait(3200);\n  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n  say('', '屋里只剩你一个人。', '天亮以后，最后一次卸妆。');\n}\nconst onEndEvening = () => run(async () => {\n  const lamp0 = S.lamp;\n  endEvening(S);\n  const t = S.T, look = t.need.look;\n  // 先看她的需要：滿足了，或燈熄一截。當場就看到燈\n  if (t.met) {\n    wife?.react('up');\n    sayH('阿檀', esc(MET_TX[look]), t.gift ? `<span class=\"itag\">她送你一张家常牌「${T[t.gift].n}」：对上她的需要，一张算两张</span>` : '她今晚的需要，满足了');\n  } else {\n    wife?.react('down');\n    sayH('', `${esc(OUT_TX[look])}灯${K('熄了一截')}。`, `没推够（${recipeShort(t.need)}）：灯 −${t.lampOut}，熄了第 ${S.outs} 回`);\n  }\n  if (glOK) focus('lamp', 'home');\n  updateTable(); renderPlate(); lamp3D(lamp0, S.lamp);\n  await lampFeedback(t);\n  if (glOK) focus('home', 'home');\n  if (S.left) { await herLeaving(); return; }\n  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n  const base = t.layers.length ? `镜子里还有 ${t.layers.length} 层，睡一觉就渗进底色。` : '';\n  // 一段的最後一晚：她說起往後兩天\n  if (t.forecast) sayH('阿檀', foreTx(t.forecast), intelTag(t.forecast) + (base ? `<br>${esc(base)}` : ''));\n  else say('', t.layers.length ? `夜里，${base}` : '夜里，镜子里的脸是干净的。');\n});\nconst onLight = () => run(async () => {\n  lightLamp(S);\n  updateTable();\n  if (glOK) focus('home', 'home');\n  say('', S.scars >= R.seatScar ? '你一个人把灯点上了。' : '她把火递给你。你们一起把灯点上了。');\n  await wait(2600);\n  await ink(() => { view = 'night'; placeScene(); say('', ''); });\n  say('', '外面的戏开锣了。你没有去。');\n});\nfunction showWatch() {\n  const w = $('#watch'), l = S.T.watch || { tx: '', hint: '' }; w.hidden = false;\n  sfx('knock');\n  w.innerHTML = `<div class=\"knock\">梆　梆　梆</div><div class=\"w\">${esc(l.tx)}</div>${l.hint ? `<div class=\"w2\">${esc(l.hint)}</div>` : ''}<button class=\"opt\" data-act=\"dawn\">天亮</button>`;\n}\nconst onSleep = () => run(async () => {\n  sleep(S);\n  // 第二幕末：鏡子第一次映出底色，說清楚第三幕會怎樣\n  if (S.day === 7 && !S.left) {\n    if (glOK) { focus('mirror', 'night'); updateMirror(); }\n    say('', '');\n    sheet = { k: 'mirror' };\n    return;\n  }\n  view = 'watch';\n  showWatch();\n});\nconst onMirrorOk = () => { sheet = null; view = 'watch'; showWatch(); refresh(); };\nconst onDawn = () => run(async () => {\n  $('#watch').hidden = true;\n  dawn(S);\n  if (S.phase === 'board') { view = 'board'; sheet = { k: 'board' }; placeScene(); say('', ''); return; }\n  if (S.phase === 'lastwipe') { view = 'lastwipe'; placeScene(); say('', ''); showWipe(); return; }\n  toDay();\n});\nconst onNextAct = () => run(async () => {\n  nextAct(S);\n  // 沒過考核：摘牌，回家最後一次卸妝\n  if (S.phase === 'lastwipe') { sheet = null; await ink(() => { view = 'lastwipe'; placeScene(); say('', ''); }); showWipe(); return; }\n  toDay();\n});\n// ── 最後一次卸妝：她在，就是她替你擦；她走了、座位空了、你沒回家，就是你一個人對著鏡子 ──\nconst lastAlone = () => !!S.left || seatEmpty(S) || S.choice === 'stage' || wifeOf(S) === 2;\nfunction lastIntro(alone) {\n  if (S.left) return '门开着，屋里只有你。你对着镜子，卸今天的妆。';\n  if (S.fired) return alone ? '牌子摘下来了。你对着镜子，卸最后一次妆。' : '牌子摘下来了。这是最后一次卸妆。她拧了一条热毛巾：“我来。”';\n  if (alone && S.choice === 'stage' && !seatEmpty(S) && wifeOf(S) !== 2) return '散了戏回到家，灯是她一个人点的，她已经睡了。你对着镜子，自己卸。';\n  if (alone) return '对面的椅子空着。你对着镜子，自己卸。';\n  return '元宵过了。她拧了一条热毛巾：“最后一回，我替你卸干净。”';\n}\nfunction lastAfter(alone) {\n  const f = FAM[topFams()[0]].n, b = S.base;\n  if (!b) return alone ? '擦干净了。镜子里，是你自己的脸。' : '擦干净了。毛巾上全是红，你脸上什么也没留下。她把这块毛巾叠好，放进木匣，最上面。';\n  if (b < 4) return alone ? `擦到最后，镜子里还有一层淡淡的「${f}」色，擦不掉了。屋里没有人跟你说一句“就这样吧”。` : `擦到最后，还有一层淡淡的「${f}」色，擦不掉了。她停下手：“就这样吧，也是你。”`;\n  return alone ? `擦了很久，镜子里那张脸还是戏里的「${f}」。你分不清，哪一层是自己。` : `毛巾换了三条，那层「${f}」的颜色还在。她看了你很久，把毛巾放下了。`;\n}\nfunction showWipe() {\n  const el = $('#wipe'), alone = lastAlone(), fams = topFams().filter(f => S.played[f] > 0);\n  const use = fams.length ? fams.slice(0, 3) : ['sing'];\n  el.hidden = false; el.dataset.done = '';\n  el.innerHTML = `<div class=\"tx\">${esc(lastIntro(alone))}</div><div class=\"face\"><canvas id=\"clean\" width=\"400\" height=\"500\"></canvas><canvas id=\"paint\" width=\"400\" height=\"500\" aria-label=\"脸上的油彩，拖动来卸掉\"></canvas></div>\n    <div class=\"tx2\">${alone ? '在脸上拖动，把油彩擦掉。' : '在脸上拖动：让她一层一层替你擦掉。'}</div><button class=\"opt\" data-act=\"wipekey\">${alone ? '擦一下' : '让她擦一下'}<small>也可以直接在脸上拖</small></button>`;\n  drawPortrait($('#clean'), { who: 'you', layers: [], base: S.base, baseF: topFams()[0], bg: ['#8d9396', '#3b4044'] });\n  const cv = $('#paint'), x = cv.getContext('2d');\n  drawPortrait(cv, { who: 'you', layers: Array.from({ length: 6 }, (_, i) => ({ f: use[i % use.length] })), base: S.base, baseF: topFams()[0] });\n  x.globalCompositeOperation = 'destination-in'; x.beginPath(); x.ellipse(200, 275, 110, 141, 0, 0, Math.PI * 2); x.fill();\n  x.globalCompositeOperation = 'destination-out';\n  let down = false, last = null;\n  const brush = (a, b) => { x.lineCap = 'round'; x.lineWidth = 62; x.beginPath(); x.moveTo(a[0], a[1]); x.lineTo(b[0], b[1]); x.stroke(); };\n  const at = e => { const r = cv.getBoundingClientRect(); return [(e.clientX - r.left) * cv.width / r.width, (e.clientY - r.top) * cv.height / r.height]; };\n  cv.addEventListener('pointerdown', e => { down = true; last = at(e); cv.setPointerCapture(e.pointerId); brush(last, last); });\n  cv.addEventListener('pointermove', e => { if (!down) return; const p = at(e); brush(last, p); last = p; });\n  const up = () => { if (down) { down = false; sfx('cloth'); checkWipe(); } };\n  cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up);\n  window.__wipeKey = () => { const r = rng(hash(String(Date.now()))); for (let i = 0; i < 3; i++) { const a = [110 + r() * 180, 150 + r() * 250]; brush(a, [a[0] + 90 - r() * 180, a[1] + 50 - r() * 100]); } sfx('cloth'); checkWipe(); };\n}\nfunction checkWipe() {\n  const cv = $('#paint'); if (!cv) return;\n  const d = cv.getContext('2d').getImageData(0, 0, cv.width, cv.height).data;\n  let left = 0, all = 0;\n  for (let y = 134; y < 416; y += 6) for (let X = 90; X < 310; X += 6) {\n    if (((X - 200) / 110) ** 2 + ((y - 275) / 141) ** 2 > 1) continue;\n    all += 1;\n    if (d[(y * cv.width + X) * 4 + 3] > 40) left += 1;\n  }\n  if (left / all < 0.28) showAfter();\n}\n// 擦完了：油彩散掉，剩下的是底色；說一句這張臉現在是什麼樣子\nfunction showAfter() {\n  const el = $('#wipe'), cv = $('#paint');\n  if (!cv || el.dataset.done) return;\n  el.dataset.done = '1';\n  const alone = lastAlone();\n  cv.style.transition = 'opacity 1.4s'; cv.style.opacity = '0'; cv.style.pointerEvents = 'none';\n  el.querySelector('.tx2')?.remove(); el.querySelector('[data-act=\"wipekey\"]')?.remove();\n  el.insertAdjacentHTML('beforeend', `<div class=\"after\">${esc(lastAfter(alone))}</div><div class=\"tx2\">${S.base ? `底色 ${S.base}：这一季没卸掉的油彩，渗进去的，就留下了。` : '这一季的油彩，每一层都卸掉了。'}</div><button class=\"opt\" data-act=\"lastdone\">${alone ? '放下毛巾' : '让她把毛巾收起来'}</button>`);\n  el.querySelector('[data-act=\"lastdone\"]')?.focus({ preventScroll: true });\n}\nconst finishLast = () => run(async () => {\n  if (S.phase !== 'lastwipe') return;\n  // 她替你擦的最後一塊布，疊在木匣最上面\n  if (!lastAlone()) S.chest.push({ day: S.day, f: topFams()[0], last: true });\n  finishWipe(S);\n  $('#wipe').hidden = true; $('#wipe').innerHTML = '';\n  view = 'reveal'; sheet = { k: 'r_board' };\n  S.T.layers = [];\n  placeScene();\n  say('', '');\n});\n// 提前結束的結局：她走的那天、摘牌那天\nconst ENDING_EARLY = {\n  头牌: '她走的那天，水牌最上面写的是你。你回到家，门开着，那盏灯没糊完，灯上全是划痕。',\n  戏散: '她走了。你的名字还挂在水牌中间，没人来问。后面的戏，你没有再上。',\n  更夫: '她走了，牌子也摘了。春天，城里多了一个不上妆的更夫。你接过梆子，第一声敲在自家门口。',\n  卸尽: '考核那天，你的牌子被摘了下来。回到家，她什么也没问，把灯递到你手里。往后，你不用再上妆了。',\n  素脸: '摘牌那天，你素着脸回家。她没说什么，给你盛了饭。灯上熄过的几处，还暗着。',\n};\nfunction showFinal() {\n  const e = endingOf(S), w = $('#watch'), kind = ['美满', '守住', '破裂'][wifeOf(S)];\n  sheet = null; w.hidden = false; sfx('knock');\n  const early = !!(S.left || S.fired), tx = early && ENDING_EARLY[e] ? ENDING_EARLY[e] : ENDING_TX[e];\n  w.innerHTML = `<div class=\"knock\">梆　梆　梆</div><div class=\"w\">${esc(S.name)}。</div><div class=\"w2\" style=\"max-width:32em\">${esc(tx)}</div><div class=\"end\">${e}</div>\n    <div class=\"sum\">${early ? `这一季在第 ${endDay(S)} 天${S.left ? '她走了' : '摘了牌'}，提前结束 · ` : ''}卖座 ${S.gold} · 水牌第 ${rankOf(S)} · 妻子${kind} · 灯 ${S.lamp}（熄过 ${S.outs} 回）· 痕 ${S.scars} · 底色 ${S.base} · 满足 ${S.log.filter(x => x.met).length} 晚${S.choice ? ` · 元宵${{ stage: '上台', lamp: '回家点灯', cover: '替小凤代演' }[S.choice]}` : ''}</div>\n    <div class=\"acts\"><button class=\"btn go\" data-act=\"again\">再来一季</button><button class=\"btn\" data-act=\"home\">回到开场</button></div>`;\n}\n\n$('#title').addEventListener('input', e => { if (e.target.id === 'nm') draftName = e.target.value; });\ndocument.addEventListener('click', e => {\n  wakeAudio();\n  const b = e.target.closest('[data-act]');\n  if (!b || b.disabled) return;\n  const a = b.dataset.act, arg = b.dataset.arg, id = Number(arg);\n  switch (a) {\n    case 'start': setTutPref(!!$('#tutChk')?.checked); startGame((draftName.trim() || '小满').slice(0, 6)); return;\n    case 'cont': continueGame(); return;\n    case 'coachnext': coachNext(); break;\n    case 'coachskip': coachSkip(); break;\n    case 'rules': panel = panel === 'rules' ? null : 'rules'; break;\n    case 'close': panel = null; break;\n    case 'opt': S.opt[arg] = !S.opt[arg]; break;\n    case 'mute': muted = !muted; break;\n    case 'music': musicOn = !musicOn; try { localStorage.setItem(MUSIC_KEY, musicOn ? '1' : '0'); } catch (err) { /* 存不了就算了 */ } break;\n    case 'book': panel = panel === 'book' ? null : 'book'; bookSel = null; break;\n    case 'booktab': bookTab = arg; bookSel = null; break;\n    case 'booksel': bookSel = arg || null; break;\n    case 'yuan': choose(S, arg); say('', { stage: '你把戏服抖开。', lamp: '你把戏服叠起来，放回箱子。', cover: '你接过小凤托人送来的头面。' }[arg]); break;\n    case 'pick': { const c = S.deck.find(x => x.t === arg && !S.T.box.includes(x.id)); if (c) { if (S.T.box.length >= S.T.cap) S.T.box.pop(); toggleBox(S, c.id); } break; }\n    case 'yesterday': boxYesterday(S); break;\n    case 'shop': panel = 'shop'; break;\n    case 'water': panel = panel === 'water' ? null : 'water'; break;\n    case 'buy': { const c = buy(S, arg); if (c) { sfx('cheer'); if (c.relic) say('孙师父', `“${RELICS[arg].n}，你留着。”`, `卖座 −${RELICS[arg].price}，水牌第 ${rankOf(S)}：${RELICS[arg].tx}`); else say('孙师父', `“「${T[arg].n}」，拿去。”`, `卖座 −${T[arg].price}，水牌第 ${rankOf(S)}；这张进了卡组`); } break; }\n    case 'clear': clearBox(S); break;\n    case 'depart': onDepart(); return;\n    case 'endstage': onEndStage(); return;\n    case 'todoor': onToDoor(); return;\n    case 'wipe': onWipe(); return;\n    case 'enter': onEnter(); return;\n    case 'look': lookOpen = !lookOpen; break;\n    case 'endeve': onEndEvening(); return;\n    case 'light': onLight(); return;\n    case 'sleep': onSleep(); return;\n    case 'dawn': onDawn(); return;\n    case 'nextact': onNextAct(); return;\n    case 'wipekey': window.__wipeKey?.(); return;\n    case 'lastdone': finishLast(); return;\n    case 'mirrorok': onMirrorOk(); return;\n    case 'rstep': sheet = { k: arg }; if (arg === 'r_home') { focus('home', 'home'); } if (arg === 'r_chest') focus('table', 'home'); break;\n    case 'rfinal': showFinal(); break;\n    case 'again': $('#watch').hidden = true; startGame(S.name); return;\n    case 'home': $('#watch').hidden = true; saved = load(); S = null; view = 'title'; sheet = null; panel = null; coach.lesson = null; clearBubs(); if (glOK) focus('table', 'night'); refresh(); return;\n    case 'card':\n      if (view === 'morning') { toggleBox(S, id); break; }\n      if (view === 'stage') { onStage(id); return; }\n      if (view === 'evening') { onHome(id); return; }\n      if (view === 'door' || view === 'night') { onClean(id); return; }\n      break;\n  }\n  refresh();\n});\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape' && panel) { panel = null; refresh(); } });\n\n// 測試用：在主控台裡看規則與流程\nwindow.__dise = { R, T, newGame, endingOf, boardOf, get S() { return S; }, get view() { return view; } };\n\n(async function boot() {\n  const glyphs = Object.values(T).map(t => t.n).join('') + Object.values(HOME).map(h => h.n + h.look).join('') + '底色戏城金接背面空白借灯唱念做打起手第天';\n  try { await Promise.race([Promise.all([document.fonts.load('40px \"Ma Shan Zheng\"', glyphs), document.fonts.load('16px \"Noto Serif SC\"', glyphs)]), wait(3500)]); } catch (e) { /* 字體載不到就用後備字體 */ }\n  initGL();\n  saved = load();\n  if (glOK) {\n    focus('table', 'night');\n    wife.base = 'work'; wife.pose('work'); wife.root.position.set(0, -0.32, SEAT_Z[0]); stool.position.set(0, 0, SEAT_Z[0] - 0.02);\n    actor.root.visible = false;\n    drawPortrait(mirrorCv, { who: 'you', layers: [], bg: ['#8d9396', '#3b4044'] }); mirrorTex.needsUpdate = true;\n  }\n  refresh();\n})();\n</script>\n","numLines":438,"startLine":3212,"totalLines":3649}},"tool_result_meta":[{"id":"toolu_01N6QMwYEFRNjFLc3D4vk2CW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
