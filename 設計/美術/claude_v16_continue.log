dd(g);\n  const wall = plane(9, 4.5, new THREE.MeshLambertMaterial({ map: latticeTex() })); wall.position.set(0, 2.1, -3.1); g.add(wall);\n  const floor = plane(12, 12, toon(0x1c130e)); floor.rotation.x = -Math.PI / 2; g.add(floor);\n  const top = box(3.7, 0.08, 2.6, toon(0xffffff, woodTex())); top.position.set(0, TOP - 0.04, -0.15); g.add(inked(top, 0.008));\n  [[-1.75, 0.98], [1.75, 0.98], [-1.75, -1.28], [1.75, -1.28]].forEach(([a, b]) => { const l = box(0.1, TOP - 0.08, 0.1, toon(0x20130c)); l.position.set(a, (TOP - 0.08) / 2, b); g.add(l); });\n  stainM = new THREE.MeshBasicMaterial({ map: stainTex(), transparent: true, opacity: 0, depthWrite: false });\n  const st = plane(3.7, 2.6, stainM); st.rotation.x = -Math.PI / 2; st.position.set(0, TOP + 0.002, -0.15); g.add(st);\n  buildMiniStage(g); buildBox(g); buildMirror(g); buildRope(g); buildSeat(g); buildCrowd(g);\n  goldG = new THREE.Group(); goldG.position.set(0.98, TOP, 0.42); g.add(goldG);\n  lights.c1 = candle(g, -0.42, TOP, -0.92); lights.c2 = candle(g, 0.98, TOP, 0.05);\n  lights.hemi = new THREE.HemisphereLight(0xf3e4d0, 0x241812, 0.7); g.add(lights.hemi);\n  lights.key = new THREE.DirectionalLight(0xfff1dc, 0.5); lights.key.position.set(-2, 4, 3); g.add(lights.key);\n  buildDeco(g);\n}\n// ── v1.6 裝飾：守舊背幕、台毯、窗花、臉譜剪紙、燈紙紋樣、木匣蓋的如意雲頭 ──\n// 都是印在布、紙上的平面紋樣，跟著場景的光（不像觀眾紙片那樣不吃光）；哪一張圖沒載到，那一樣就維持 v1.5 的樣子\nlet deco = null;\nfunction artTex(p, prep) {\n  const im = artImg(p);\n  if (!im) return null;\n  let src = im;\n  if (prep) { const c = document.createElement('canvas'); c.width = im.width; c.height = im.height; prep(c.getContext('2d'), im, c); src = c; }\n  const t = new THREE.Texture(src); t.needsUpdate = true; t.anisotropy = 4;\n  return t;\n}\n// 臉譜剪紙裱在一張宣紙上再貼牆：墨黑的那兩張貼在深色牆上才看得見\nfunction mountPaper(x, im, c) {\n  const W = c.width, H = c.height, r = rng(hash(im.src.slice(-40)));\n  x.fillStyle = '#e6dccb'; x.beginPath();\n  // 手裁的紙邊：四邊各抖幾下\n  const pts = [], m = 14, j = () => (r() - 0.5) * 7;\n  for (let i = 0; i <= 8; i++) pts.push([m + (W - 2 * m) * i / 8 + j(), m + j()]);\n  for (let i = 1; i <= 8; i++) pts.push([W - m + j(), m + (H - 2 * m) * i / 8 + j()]);\n  for (let i = 7; i >= 0; i--) pts.push([m + (W - 2 * m) * i / 8 + j(), H - m + j()]);\n  for (let i = 7; i >= 1; i--) pts.push([m + j(), m + (H - 2 * m) * i / 8 + j()]);\n  pts.forEach(([X, Y], i) => (i ? x.lineTo(X, Y) : x.moveTo(X, Y))); x.closePath(); x.fill();\n  const pp = artImg('cards/paper_02.png');\n  if (pp) { x.save(); x.clip(); x.globalCompositeOperation = 'overlay'; x.drawImage(pp, 0, 0, W, H); x.restore(); }\n  x.strokeStyle = 'rgba(168,32,43,.55)'; x.lineWidth = 3; x.strokeRect(m + 16, m + 16, W - 2 * m - 32, H - 2 * m - 32);\n  const s = 0.78; x.drawImage(im, W * (1 - s) / 2, H * (1 - s) / 2, W * s, H * s);\n}\nfunction buildDeco(g) {\n  if (!ART.on) return;\n  deco = { stage: [], n: 0 };\n  const flat = (map, o) => new THREE.MeshLambertMaterial(Object.assign({ map, transparent: true, alphaTest: 0.35, side: THREE.DoubleSide }, o || {}));\n  // 守舊：小戲台後面那幅背幕，往後仰一點對著戲台鏡頭；只在台上出現（別的鏡頭要看得見對面的阿檀）\n  const sj = artTex('deco/shoujiu.png');\n  if (sj) {\n    const w = 1.2, h = w / 1.5, m = new THREE.Mesh(new THREE.PlaneGeometry(w, h).translate(0, h / 2, 0), new THREE.MeshLambertMaterial({ map: sj, color: 0x8c8484 }));\n    m.position.set(0, TOP + 0.108, -0.62); m.rotation.x = -0.36; m.visible = false; g.add(m); deco.stage.push(m); deco.n += 1;\n  }\n  // 台毯：暗朱紅的團花回紋，平鋪在台板上，四邊留一圈木板\n  const cp = artTex('deco/carpet.png');\n  if (cp) {\n    cp.wrapS = cp.wrapT = THREE.RepeatWrapping; cp.repeat.set(2.5, 1.35);\n    const m = new THREE.Mesh(new THREE.PlaneGeometry(1.42, 0.76), new THREE.MeshLambertMaterial({ map: cp, color: 0x6e6466 })); m.rotation.x = -Math.PI / 2; m.position.set(0, TOP + 0.1115, -0.2); g.add(m); deco.n += 1;\n  }\n  // 窗花：後牆格窗的窗紙上，如意、蝙蝠、牡丹、燈籠各一（灯坊、門口、夜裡的鏡頭看得見）\n  [[1, -1.81, 1.4], [2, -1.29, 1.96], [3, 1.29, 1.96], [4, 1.81, 1.4]].forEach(([n, x0, y0]) => {\n    const t = artTex(`deco/chua