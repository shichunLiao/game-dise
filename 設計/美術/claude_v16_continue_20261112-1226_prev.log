play: flex; flex-direction: column; gap: 3px; align-items: center; }\n282\t.plate .lm b { font-family: var(--display); font-weight: 400; font-size: 17px; }\n283\t.plate .lm .k { display: flex; align-items: center; gap: 4px; }\n284\t.plate .lm .k2 { display: flex; gap: 8px; }\n285\t.plate .lm .k.hot { color: #ff9a8a; }\n286\t.wb .exam { display: block; color: #5a5156; font-size: 11px; }\n287\t.wb .exam.bad { color: var(--red); font-weight: 700; }\n288\t.offer .bad, .shopp .bad { color: var(--red); font-weight: 700; }\n289\t.offer .ab { border-top: 1px dashed rgba(28, 23, 25, .25); padding-top: 4px; color: var(--ink); min-height: 0; }\n290\t.panel.tujian { width: min(860px, 100%); }\n291\t.panel .tabs { display: flex; gap: 6px; margin-bottom: 8px; }\n292\t.bookg { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; margin-bottom: 6px; }\n293\t.bc { border: none; background: none; padding: 0; cursor: pointer; text-align: center; font-size: 12px; color: var(--ink); }\n294\t.bc img { width: 100%; display: block; border-radius: 5px; box-shadow: 0 3px 8px rgba(0, 0, 0, .35); margin-bottom: 2px; }\n295\t.bc.un img { filter: grayscale(.9) brightness(.7); }\n296\t.bc.un span { color: #8d8487; }\n297\t.bc:hover img, .bc:focus-visible img { box-shadow: 0 0 0 3px var(--gold), 0 3px 8px rgba(0, 0, 0, .35); }\n298\t.bookd { display: flex; gap: 16px; flex-wrap: wrap; }\n299\t.bookd .faces { display: flex; gap: 8px; }\n300\t.bookd figure { margin: 0; text-align: center; font-size: 12px; color: #5a5156; }\n301\t.bookd figure img { width: 140px; display: block; border-radius: 6px; margin-bottom: 3px; }\n302\t.bookd .bt { flex: 1; min-width: 220px; }\n303\t.bookd h3 { font-family: var(--display); font-weight: 400; font-size: 30px; margin: 0; }\n304\t.bookd h3 small { display: block; font-family: var(--body); font-size: 12px; color: #5a5156; }\n305\t.bookr { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; }\n306\t.bookr li { background: #e0d5c2; padding: 8px 10px; }\n307\t.bookr li.own { box-shadow: inset 0 0 0 2px var(--gold); }\n308\t.bookr b { font-family: var(--display); font-weight: 400; font-size: 20px; margin-right: 6px; }\n309\t.bookr small { color: #5a5156; }\n310\t.bookr p { margin: 4px 0 0; font-size: 13px; }\n311\t.bookr .lore { color: #5a5156; }\n312\t.bookt { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; }\n313\t.bookt dt { font-family: var(--display); font-size: 18px; color: var(--red); }\n314\t.bookt dd { margin: 0; font-size: 14px; }\n315\t.panel .fired { color: var(--red-2); font-family: var(--display); font-size: 22px; }\n316\t.mirrorc { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin: 6px 0; }\n317\t.mirrorc figure { margin: 0; text-align: center; font-size: 12px; color: #5a5156; }\n318\t.mirrorc img { width: 86px; display: block; margin-bottom: 4px; }\n319\t\n320\t/* 最後一次卸妝 */\n321\t.lastwipe { position: fixed; inset: 0; z-index: 26; background: rgba(7, 5, 6, .9); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 16px; }\n322\t.lastwipe .face { position: relative; width: min(340px, 78vw, 54vh); aspect-ratio: 4 / 5; }\n323\t.lastwipe canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n324\t.lastwipe #paint { touch-action: none; cursor: grab; }\n325\t.lastwipe .tx { font-family: var(--display); font-size: 24px; line-height: 1.5; text-align: center; max-width: 24em; }\n326\t.lastwipe .tx2 { font-size: 14px; color: var(--paper-2); text-align: center; max-width: 30em; letter-spacing: .04em; }\n327\t.lastwipe .after { font-family: var(--display); font-size: 22px; line-height: 1.6; color: var(--paper); text-align: center; max-width: 24em; animation: rise 1.4s ease both; }\n328\t\n329\t/* 看牌：放大兩面，每面最多三行 */\n330\t#peek { position: fixed; z-index: 35; pointer-events: none; display: flex; gap: 10px; filter: drop-shadow(0 14px 30px rgba(0, 0, 0, .7)); animation: peekIn .14s ease-out both; }\n331\t#peek figure { margin: 0; width: 196px; background: var(--ink-2); border: 1px solid rgba(184, 145, 63, .45); padding: 8px 8px 10px; opacity: .78; }\n332\t#peek figure.on { opacity: 1; border-color: var(--gold); border-top: 4px solid var(--red); }\n333\t#peek img { width: 100%; aspect-ratio: 2 / 3; display: block; border-radius: 8px; }\n334\t#peek figcaption { margin-top: 7px; font-size: 14px; line-height: 1.55; color: var(--paper); }\n335\t#peek figcaption b { display: block; font-size: 12px; letter-spacing: .2em; color: var(--gold); font-weight: 400; }\n336\t@keyframes peekIn { from { opacity: 0; transform: translateY(6px); } }\n337\t\n338\t/* 教學小框：遮罩挖洞框住要看的東西 */\n339\t#coach { position: fixed; inset: 0; z-index: 34; pointer-events: none; }\n340\t#coach .dim { position: absolute; inset: 0; background: rgba(8, 6, 7, .62); }\n341\t#coach .shield { position: absolute; inset: 0; pointer-events: auto; }\n342\t#coach .ring { position: absolute; border: 2px solid var(--gold); border-radius: 8px; box-shadow: 0 0 0 4px rgba(184, 145, 63, .22), 0 0 26px rgba(216, 67, 76, .55); animation: coachPulse 1.6s ease-in-out infinite; }\n343\t#coach .ring[data-tap]::after { content: attr(data-tap); position: absolute; left: 50%; bottom: calc(100% + 8px); transform: translateX(-50%); background: var(--red); color: var(--paper); font-size: 13px; letter-spacing: .2em; padding: 2px 10px; white-space: nowrap; }\n344\t@keyframes coachPulse { 50% { box-shadow: 0 0 0 9px rgba(184, 145, 63, .1), 0 0 38px rgba(216, 67, 76, .75); } }\n345\t#coach .cbox { position: absolute; pointer-events: auto; width: min(330px, calc(100vw - 32px)); max-height: 60vh; overflow: auto; background: var(--ink-2); color: var(--paper); border: 1px solid rgba(184, 145, 63, .7); border-top: 4px solid var(--red); padding: 10px 14px 10px; box-shadow: 0 16px 44px rgba(0, 0, 0, .65); animation: rise .3s ease both; }\n346\t#coach .cbox h4 { font-family: var(--display); font-weight: 400; font-size: 23px; line-height: 1.3; margin: 0 0 3px; }\n347\t#coach .cbox .tx { font-size: 15px; line-height: 1.7; }\n348\t#coach .cbox .tx b { color: #e8cf8f; }\n349\t#coach .cbox .rule { margin: 8px 0 2px; padding: 2px 0 2px 10px; border-left: 3px solid var(--red); font-family: var(--display); font-size: 19px; line-height: 1.4; color: #f2d48a; }\n350\t#coach .fc { width: 22px; height: 22px; font-size: 15px; vertical-align: -4px; margin: 0 2px; }\n351\t#coach .cbox .row { display: flex; align-items: center; gap: 10px; margin-top: 8px; }\n352\t#coach .cbox .do { font-size: 14px; color: #e8cf8f; letter-spacing: .1em; }\n353\t#coach .cbox .skip { margin-left: auto; background: none; border: none; color: var(--paper-2); font-size: 12px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; min-height: 38px; padding: 0 4px; }\n354\t#coach .arrow { position: absolute; width: 14px; height: 14px; background: var(--ink-2); transform: rotate(45deg); }\n355\t#coach .arrow.up { top: -9px; background: var(--red); }\n356\t#coach .arrow.down { bottom: -8px; border-right: 1px solid rgba(184, 145, 63, .7); border-bottom: 1px solid rgba(184, 145, 63, .7); }\n357\t/* 做的步驟：不壓暗整個畫面，只一句話貼在要點的東西旁邊 */\n358\t#coach.doing .dim { background: rgba(8, 6, 7, .38); }\n359\t#coach.doing .cbox { width: auto; max-width: min(300px, calc(100vw - 32px)); padding: 8px 12px 6px; border-top-width: 3px; }\n360\t#coach.doing .cbox .tx { font-family: var(--display); font-size: 19px; line-height: 1.45; }\n361\t#coach.doing .cbox .row { margin-top: 2px; }\n362\t#coach.doing .cbox .do { display: none; }\n363\t#coach .cbox .step { position: absolute; right: 10px; top: 7px; font-size: 11px; letter-spacing: .1em; color: var(--paper-2); }\n364\t/* 一張牌兩面：台上面翻過來就是家裡面 */\n365\t.flip { display: flex; justify-content: center; margin: 6px 0 4px; perspective: 700px; }\n366\t.flip .fl { position: relative; width: 92px; height: 138px; transform-style: preserve-3d; animation: flip 3.6s ease-in-out infinite; }\n367\t.flip img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 6px; backface-visibility: hidden; box-shadow: 0 6px 14px rgba(0, 0, 0, .5); }\n368\t.flip img.b { transform: rotateY(180deg); }\n369\t.flip .cap { align-self: center; margin-left: 12px; font-size: 13px; line-height: 1.8; color: var(--paper-2); }\n370\t.flip .cap b { color: #f2d48a; font-weight: 400; font-family: var(--display); font-size: 16px; }\n371\t@keyframes flip { 0%, 30% { transform: rotateY(0); } 50%, 80% { transform: rotateY(180deg); } 100% { transform: rotateY(360deg); } }\n372\t/* 小提示：不擋、不用按，貼在新出現的東西旁邊，一次只有一枚 */\n373\t#nudge { position: fixed; z-index: 33; max-width: min(280px, calc(100vw - 24px)); background: rgba(22, 17, 20, .96); color: var(--paper); border-left: 3px solid #f2d48a; padding: 6px 26px 7px 10px; font-size: 14px; line-height: 1.55; box-shadow: 0 10px 26px rgba(0, 0, 0, .6); animation: rise .3s ease both; cursor: pointer; }\n374\t#nudge b { color: #f2d48a; font-weight: 400; font-family: var(--display); font-size: 16px; display: block; }\n375\t#nudge .x { position: absolute; right: 6px; top: 3px; color: var(--paper-2); font-size: 14px; }\n376\t#nudge.out { opacity: 0; transition: opacity .4s ease; }\n377\t\n378\t/* 早上選牌：妝匣的手牌、字幕都縮小，把高度讓給桌上攤開的牌 */\n379\t.hud[data-v=\"morning\"] .hand.on { min-height: 118px; padding-top: 10px; }\n380\t.hud[data-v=\"morning\"] .hc { width: 72px; height: 108px; margin: 0 -2px; }\n381\t.hud[data-v=\"morning\"] .talk { gap: 2px; padding-bottom: 2px; }\n382\t.hud[data-v=\"morning\"] .sub .tx { font-size: 18px; line-height: 1.35; }\n383\t.hud[data-v=\"morning\"] .sub .gain { font-size: 12px; }\n384\t.hud[data-v=\"morning\"] .opt { font-size: 21px; min-height: 40px; }\n385\t.hud[data-v=\"morning\"] .choices { min-height: 40px; }\n386\t.spc .ct { min-width: 28px; height: 28px; font-size: 15px; }\n387\t/* v0.7：她的需要、情報、觀眾的話、後台、水牌小牌 */\n388\tmark.k { back