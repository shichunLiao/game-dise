2T04:28:23.031Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.5/index.html","content":"function renderSmear() {\n  const cv = $('#smear'), w = innerWidth, h = innerHeight;\n  if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; }\n  const x = cv.getContext('2d'); x.clearRect(0, 0, w, h);\n  if (!S || !['door', 'evening', 'night'].includes(view)) return;\n  const m = Math.min(w, h);\n  S.T.layers.forEach((ly, i) => {\n    const r = rng(101 + i * 977), col = hexRgb(FCOL[ly.f]);\n    for (let k = 0; k < 7; k++) {\n      const side = Math.floor(r() * 4); let px, py;\n      if (side === 0) { px = r() * w; py = -h * 0.04 + r() * h * 0.1; } else if (side === 1) { px = r() * w; py = h * 1.02 - r() * h * 0.08; } else if (side === 2) { px = -w * 0.02 + r() * w * 0.07; py = r() * h; } else { px = w * 1.02 - r() * w * 0.07; py = r() * h; }\n      const rad = (0.1 + r() * 0.14) * m, g = x.createRadialGradient(px, py, 0, px, py, rad);\n      g.addColorStop(0, `rgba(${col},.55)`); g.addColorStop(0.55, `rgba(${col},.22)`); g.addColorStop(1, `rgba(${col},0)`);\n      x.fillStyle = g; x.beginPath(); x.arc(px, py, rad, 0, Math.PI * 2); x.fill();\n    }\n  });\n}\nasync function ink(fn) {\n  const el = $('#ink');\n  if (calm()) { fn(); return; }\n  el.className = ''; void el.offsetWidth; el.className = 'on';\n  await wait(600); fn(); refresh(); await wait(100);\n  el.className = 'off'; await wait(460); el.className = '';\n}\nasync function fly(id, where) {\n  const el = document.querySelector(`.hc[data-id=\"${id}\"]`), t = cardOf(S, id).t, side = where === 'home' ? 'home' : 'stage';\n  const target = !glOK ? null : where === 'stage' ? cardSpot('stage', S.T.plays.length) : where === 'home' ? cardSpot('home', S.T.pushed.length) : null;\n  if (el && !calm()) {\n    const r = el.getBoundingClientRect(), ghost = new Image();\n    ghost.src = cardArt(t, side).url; ghost.className = 'ghost'; Object.assign(ghost.style, { left: r.left + 'px', top: r.top + 'px', width: r.width + 'px', height: r.height + 'px' });\n    document.body.appendChild(ghost); el.style.visibility = 'hidden';\n    let tx = innerWidth / 2, ty = innerHeight * 0.45;\n    if (glOK && target) { const v = target.clone().project(camera); tx = (v.x + 1) / 2 * innerWidth; ty = (1 - v.y) / 2 * innerHeight; }\n    if (!target && where === 'cloth') ty = innerHeight + 80;\n    const anim = ghost.animate([{ transform: 'none', opacity: 1 }, { transform: `translate(${tx - r.left - r.width / 2}px, ${ty - r.top - r.height / 2}px) scale(${target ? 0.32 : 0.5}) rotate(${where === 'cloth' ? 40 : 8}deg)`, opacity: where === 'cloth' ? 0 : 0.95 }], { duration: 400, easing: 'cubic-bezier(.3,.7,.3,1)' });\n    await Promise.race([anim.finished.catch(() => {}), wait(700)]);\n    ghost.remove();\n  }\n  if (target) spawnCard(t, side, target);\n}\nfunction burst(n) {\n  if (calm()) return;\n  const fx = $('#fx');\n  for (let i = 0; i < Math.min(n, 44); i++) {\n    const f = document.createElement('span'); f.className = 'fleck';\n    f.style.left = `${8 + Math.random() * 84}vw`; f.style.animationDelay = `${Math.random() * 0.5}s`; f.style.background = Math.random() < 0.3 ? '#efe2c2' : '#b8913f';\n    fx.appendChild(f); setTimeout(() => f.remove(), 2600);\n  }\n}\nfunction stamp(text) { const s = document.createElement('div'); s.className = 'stamp'; s.textContent = text; document.body.appendChild(s); setTimeout(() => s.remove(), 1800); }\nconst PIPS = { 1: [4], 2: [0, 8], 3: [0, 4, 8], 4: [0, 2, 6, 8], 5: [0, 2, 4, 6, 8], 6: [0, 2, 3, 5, 6, 8] };\nconst dieHTML = (v, cls = '') => `<span class=\"die ${cls} ${v === 1 || v === 4 ? 'red' : ''}\" aria-hidden=\"true\">${Array.from({ length: 9 }, (_, i) => `<i class=\"${PIPS[v].includes(i) ? 'on' : ''}\"></i>`).join('')}</span>`;\nasync function showDice(o) {\n  const el = $('#dice');\n  el.hidden = false;\n  el.innerHTML = `<div class=\"dbox\" role=\"status\"><span class=\"lb\">${esc(o.label)}</span><span class=\"dslot\">${dieHTML(1)}</span><span class=\"res\"></span></div>`;\n  const slot = el.querySelector('.dslot'), res = el.querySelector('.res');\n  if (!calm()) for (let i = 0; i < 8; i++) { slot.innerHTML = dieHTML(1 + Math.floor(Math.random() * 6), 'spin'); await wait(65); }\n  slot.innerHTML = dieHTML(o.v, 'land');\n  res.className = `res ${o.ok ? 'ok' : 'bad'}`;\n  res.textContent = `${o.v}　${o.result}`;\n  await wait(calm() ? 900 : 1300);\n  el.hidden = true;\n}\n// ── 觀眾的話：對白框貼在剪紙頭頂；情報金框、同門紅框，說完就散 ──\nlet bubs = [];\nconst SPEAK = { L: [0, 1, 2], R: [6, 7, 8], C: [3, 5] };\nfunction bubble(html, kind = 'n', o = {}) {\n  if (view !== 'stage') return null;\n  if (kind === 'n' && (coach.lesson || nudge.k)) return null;\n  const busyI = bubs.map(b => b.i);\n  let pool = (kind === 'intel' || kind === 'ev' ? [...SPEAK.L, ...SPEAK.R] : [...SPEAK.L, ...SPEAK.R, ...SPEAK.C]).filter(i => !busyI.includes(i));\n  if (o.side) pool = pool.filter(i => SPEAK[o.side].includes(i));\n  // 情報與同門的話，各佔一邊，不擋戲台中間\n  if (kind === 'intel' && bubs.some(b => b.kind === 'ev')) pool = pool.filter(i => SPEAK[bubs.find(b => b.kind === 'ev').i <= 2 ? 'R' : 'L'].includes(i));\n  const i = pool.length ? pool[Math.floor(Math.random() * pool.length)] : 0;\n  const el = document.createElement('div');\n  el.className = `bub ${kind}`;\n  el.innerHTML = `${kind === 'intel' ? '<span class=\"tg\">情报 · 台下</span>' : kind === 'ev' ? '<span class=\"tg\">同门的事</span>' : ''}${html}`;\n  $('#talkb').appendChild(el);\n  const b = { el, i, kind, until: performance.now() + (kind === 'intel' ? 14000 : kind === 'ev' ? 5500 : 2600) };\n  // 同一個人換一句：舊的先收\n  bubs.filter(x => x.kind === 'n' && kind === 'n').slice(0, -1).forEach(x => { x.until = 0; });\n  bubs.push(b);\n  placeBub(b);\n  return b;\n}\nfunction placeBub(b) {\n  const h = crowdHead(b.i) || { x: innerWidth * (b.i <= 2 ? 0.16 : b.i >= 6 ? 0.84 : 0.5), y: innerHeight * 0.66 };\n  const w = b.el.offsetWidth, ht = b.el.offsetHeight;\n  const x = clamp(h.x, w / 2 + 8, innerWidth - w / 2 - 8), y = clamp(h.y - 8, ht + 8, innerHeight - 8);\n  b.el.style.left = `${x}px`; b.el.style.top = `${y}px`;\n  b.el.style.setProperty('--ax', `${clamp(h.x - (x - w / 2), 16, w - 16)}px`);\n}\nfunction bubTick() {\n  const now = performance.now();\n  bubs = bubs.filter(b => {\n    if (now < b.until || (b.kind === 'intel' && coach.lesson === 'crowd')) { placeBub(b); return true; }\n    b.el.classList.add('out'); setTimeout(() => b.el.remove(), 360);\n    return false;\n  });\n}\nsetInterval(bubTick, 120);\nfunction clearBubs() { bubs.forEach(b => b.el.remove()); bubs = []; }\n// 台下閒聊：沒人說話的時候，隔一陣有人開口；同門的事、戲台的事\nconst CHATTER = [`金宝今儿${K('嗓子')}不错。`, `月仙在侧幕${K('盯着你')}呢。`, `魏老板说，元宵要${K('定新头牌')}。`, '后排的，往前挤挤。', '今儿的灯笼是新换的。', `玉楼那张嘴，${K('什么都知道')}。`, '这出戏，我看过三回了。', `小凤的${K('嗓子')}，不知好了没有。`];\nconst chat = { day: 0, n: 0 };\nconst chatMax = () => (S.day === 1 ? 2 : !S.tut.off && S.day <= 2 ? 3 : 6);\nsetInterval(() => {\n  if (view !== 'stage' || busy || !S || S.T.ended || bubs.length >= 2 || document.hidden || coachOn() || panel) return;\n  if (chat.day !== S.day) { chat.day = S.day; chat.n = 0; }\n  if (chat.n >= chatMax()) return;\n  chat.n += 1;\n  bubble(pick(CHATTER), 'n', { side: Math.random() < 0.5 ? 'L' : 'R' });\n}, 7000);\n\n// ── 台上的特效：紙屑、金箔、彩綢、墨點、煙花（畫在 3D 上面、字的下面）──\nconst fxc = $('#stagefx'), fxx = fxc.getContext('2d');\nlet parts = [], fxOn = false, fxLast = 0;\nconst FXCOL = { petal: ['#c8283a', '#e0475a', '#f2d48a', '#efe2c8', '#a8202b'], foil: ['#f6dc96', '#e8c46a', '#fff3cf'], spark: ['#ffe9a8', '#f2d48a', '#fff'], ink: ['#120e11', '#2b2427', '#3a0a0e'], fw: ['#ffe9a8', '#ff8a6a', '#f2d48a', '#ffd0dc', '#fff'] };\nfunction fxSize() {\n  const d = Math.min(devicePixelRatio || 1, 2);\n  if (fxc.width !== Math.round(innerWidth * d) || fxc.height !== Math.round(innerHeight * d)) { fxc.width = Math.round(innerWidth * d); fxc.height = Math.round(innerHeight * d); }\n  fxx.setTransform(d, 0, 0, d, 0, 0);\n}\nfunction spawn(kind, n, o = {}) {\n  if (calm()) return;\n  if (view !== 'stage' && ['fw', 'foil', 'ribbon', 'petal'].includes(kind)) return;\n  fxSize();\n  const W = innerWidth, H = innerHeight;\n  for (let i = 0; i < n; i++) {\n    const p = { kind, t: 0, rot: Math.random() * 6.28, vr: (Math.random() - 0.5) * 9, col: pick(FXCOL[kind] || FXCOL.petal) };\n    if (kind === 'petal' || kind === 'foil') { p.x = Math.random() * W; p.y = -20 - Math.random() * H * 0.5; p.vx = (Math.random() - 0.5) * 70; p.vy = (kind === 'foil' ? 190 : 110) + Math.random() * 100; p.s = kind === 'foil' ? 5 + Math.random() * 7 : 7 + Math.random() * 9; p.life = 3.6; p.sw = Math.random() * 6.28; }\n    else if (kind === 'spark' || kind === 'fw') { const a = Math.random() * 6.28, v = (kind === 'fw' ? 180 : 120) + Math.random() * (kind === 'fw' ? 280 : 220); p.x = o.x; p.y = o.y; p.vx = Math.cos(a) * v; p.vy = Math.sin(a) * v - 70; p.s = 2 + Math.random() * 3; p.life = 0.7 + Math.random() * 0.6; }\n    else if (kind === 'ink') { const a = Math.random() * 6.28, v = 70 + Math.random() * 280; p.x = o.x; p.y = o.y; p.vx = Math.cos(a) * v; p.vy = Math.sin(a) * v - 90; p.s = 3 + Math.random() * 8; p.life = 0.9 + Math.random() * 0.5; }\n    else if (kind === 'ribbon') { p.side = i % 2 ? 1 : -1; p.y0 = H * (0.12 + Math.random() * 0.4); p.life = 2; p.ph = Math.random() * 6.28; p.col = i % 3 === 2 ? '#f2d48a' : '#c8283a'; p.w = 6 + Math.random() * 5; }\n    parts.push(p);\n  }\n  if (!fxOn) { fxOn = true; fxLast = performance.now(); requestAnimationFrame(fxLoop); }\n}\nfunction fxLoop(now) {\n  const dt = Math.min(0.05, (now - fxLast) / 1000), W = innerWidth;\n  fxLast = now;\n  fxx.clearRect(0, 0, W, innerHeight);\n  parts = parts.filter(p => (p.t += dt) < p.life);\n  for (const p of parts) {\n    fxx.globalAlpha = Math.min(1, (p.life - p.t) / 0.45);\n    if (p.kind === 'ribbon') {\n      const k = Math.min(1, p.t / (p.life * 0.55)), len = W * 0.55 * k;\n      fxx.strokeStyle = p.col; fxx.lineWidth = p.w; fxx.lineCap = 'round'; fxx.beginPath();\n      for (let s0 = 0; s0 <= len; s0 += 12) { const x = p.side < 0 ? s0 : W - s0, y = p.y0 + Math.sin(s0 * 0.018 + p.ph + p.t * 7) * 34 - s0 * 0.12; if (s0) fxx.lineTo(x, y); else fxx.moveTo(x, y); }\n      fxx.stroke(); continue;\n    }\n    const grav = p.kind === 'petal' || p.kind === 'foil' ? 0 : 520;\n    p.vy += grav * dt; p.x += (p.vx + (p.sw !== undefined ? Math.sin(p.t * 3 + p.sw) * 40 : 0)) * dt; p.y += p.vy * dt; p.rot += p.vr * dt;\n    fxx.save(); fxx.translate(p.x, p.y); fxx.rotate(p.rot); fxx.fillStyle = p.col;\n    if (p.kind === 'petal') { fxx.beginPath(); fxx.ellipse(0, 0, p.s, Math.max(0.5, p.s * 0.5 * Math.abs(Math.cos(p.t * 4 + p.sw))), 0, 0, 6.28); fxx.fill(); }\n    else if (p.kind === 'foil') { fxx.globalAlpha *= 0.6 + 0.4 * Math.abs(Math.sin(p.t * 9 + p.sw)); fxx.fillRect(-p.s / 2, -p.s / 2, p.s, p.s * 0.7); }\n    else { fxx.beginPath(); fxx.arc(0, 0, p.s, 0, 6.28); fxx.fill(); }\n    fxx.restore();\n  }\n  fxx.globalAlpha = 1;\n  if (parts.length) requestAnimationFrame(fxLoop); else { fxOn = false; fxx.clearRect(0, 0, W, innerHeight); }\n}\n// 打出去那張牌在螢幕上的位置\nfunction cardScreen(i) {\n  if (!glOK) return { x: innerWidth / 2, y: innerHeight * 0.42 };\n  const v = cardSpot('stage', i).project(camera);\n  return { x: (v.x + 1) / 2 * innerWidth, y: (1 - v.y) / 2 * innerHeight };\n}\nfunction banner(tx, sub, cls = '') {\n  if (calm()) return;\n  $('#combo').innerHTML = `<div class=\"cb ${cls}\">${esc(tx)}</div>${sub ? `<div class=\"cs\">${esc(sub)}</div>` : ''}`;\n}\nfunction gainFloat(at, tx, bad) {\n  if (calm()) return;\n  const el = document.createElement('div'); el.className = `gainf ${bad ? 'bad' : ''}`; el.textContent = tx;\n  el.style.left = `${at.x}px`; el.style.top = `${at.y}px`; document.body.appendChild(el); setTimeout(() => el.remove(), 1300);\n}\n// 連擊越長，台上越熱鬧：火星 → 紙屑、幕晃、大字 → 金箔、彩綢、鏡頭推近 → 煙花\nconst COMBO_TX = { 3: ['好！', '连击 ×3'], 4: ['满堂红', '连击 ×4'], 5: ['绝了', '五连'] };\nfunction comboFx(p) {\n  const n = S.T.chain, at