{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lb832tWiWxC6r3wLk2HeDN","type":"tool_result","content":"2760\t  t.style.top = `${below ? r.bottom + 8 : r.top - h - 8}px`;\n2761\t}\n2762\tconst hideTip = () => { tipEl().hidden = true; };\n2763\tdocument.addEventListener('pointerover', e => { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); });\n2764\tdocument.addEventListener('focusin', e => { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); });\n2765\tdocument.addEventListener('pointerdown', e => { if (e.pointerType !== 'mouse') { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); } });\n2766\t// 熄過幾回、痕幾道：到了上限，她就走了\n2767\tconst outsHTML = (fresh = false) => `<span class=\"outs\">${Array.from({ length: R.brokenOuts }, (_, i) => `<i class=\"${i < S.outs ? 'on' : ''} ${fresh && i === S.outs - 1 ? 'new' : ''}\"></i>`).join('')}</span>`;\n2768\tconst scarsHTML = () => `<span class=\"scars\">${Array.from({ length: R.brokenScar }, (_, i) => `<i class=\"${i < S.scars ? 'on' : ''}\"></i>`).join('')}</span>`;\n2769\tfunction renderPlate() {\n2770\t  const st = starterOf(S);\n2771\t  const stOn = st && ['morning', 'stage'].includes(view);\n2772\t  $('#plate').innerHTML = `<div class=\"d\">第 ${S.day} 天</div>\n2773\t    <div class=\"st\" ${stOn ? '' : 'hidden'}>起手 ${stOn ? fc(st) : ''}</div><div class=\"g\"><i class=\"term\" data-term=\"卖座\">卖座</i><b>${S.gold}</b></div>`;\n2774\t  // 左欄跟在木牌底下\n2775\t  const lc = $('#leftcol'); lc.style.top = innerWidth > 760 ? `${Math.round($('#plate').getBoundingClientRect().bottom + 8)}px` : '';\n2776\t}\n2777\t// 考核的底線怎麼說\n2778\tconst examTx = ne => (ne.fail === R.ranks ? '别垫底' : `别进倒数${['', '两', '三', '四'][R.ranks - ne.fail] || ''}名`);\n2779\t// 右上的水牌小牌：名次，和上一名差多少；下一次考核\n2780\tfunction renderBoardChip() {\n2781\t  const el = $('#wboard');\n2782\t  if (['board', 'lastwipe', 'reveal', 'watch'].includes(view) || !uiOn.board()) { el.innerHTML = ''; return; }\n2783\t  const b = boardOf(S), i = b.findIndex(r => r.me), up = b[i - 1], dn = b[i + 1];\n2784\t  const gap = boardDay(S) < 1 ? '还没开锣' : up ? `差${esc(up.n)} ${up.g - S.gold + 1}` : dn ? `领先${esc(dn.n)} ${S.gold - dn.g}` : '';\n2785\t  const ne = nextExam(S), bad = ne && i + 1 >= ne.fail && boardDay(S) >= 1;\n2786\t  const ex = ne && (bad || ne.day - S.day <= 1) ? `<span class=\"exam ${bad ? 'bad' : ''}\">${ne.day === S.day ? '今天' : '明天'}散戏后<i class=\"term\" data-term=\"考核\">考核</i>：${examTx(ne)}</span>` : '';\n2787\t  // 主畫面直接看三行：上一名、你、下一名（第一就看下兩名，墊底就看上兩名）\n2788\t  const from = clamp(i - 1, 0, b.length - 3), rows = b.slice(from, from + 3).map((r, k) => `<li class=\"${r.me ? 'me' : ''} ${ne && from + k + 1 === ne.fail ? 'fail' : ''}\"><span><span class=\"n\">${from + k + 1}</span>${r.me ? '你' : esc(r.n)}</span><span>${r.g}</span></li>`).join('');\n2789\t  const fresh = !(S.ui && S.ui.board);\n2790\t  if (!S.ui) S.ui = {};\n2791\t  S.ui.board = true;\n2792\t  el.innerHTML = `<button class=\"wb ${fresh ? 'popin' : ''}\" data-act=\"water\" aria-label=\"水牌第 ${i + 1}，${gap}${ne ? `，第 ${ne.day} 天考核${examTx(ne)}` : ''}。点开看全部\"><span class=\"wbh\"><span>水牌</span><span>第 <b>${i + 1}</b> / ${b.length}</span></span><ol>${rows}</ol><span class=\"dif\">${gap}</span>${ex}</button>${S.relics.length ? `<div class=\"relics\" aria-label=\"物件\">${S.relics.map(r => `<button class=\"rel\" data-tip=\"${esc(RELICS[r].n)}|${esc(RELICS[r].tx)}\" aria-label=\"${esc(RELICS[r].n)}：${esc(RELICS[r].tx)}\">${RELICS[r].n}</button>`).join('')}</div>` : ''}`;\n2793\t}\n2794\t// 情報：聽來的需要，按段排；今晚的那一條亮著\n2795\tfunction intelHTML(onlyNow = false) {\n2796\t  if (seatEmpty(S)) return '';\n2797\t  const items = [];\n2798\t  // 今晚的需要已經過了（夜裡、吃完飯），就從明天記起\n2799\t  for (let d = view === 'night' || S.T.judged ? S.day + 1 : S.day; d < (onlyNow ? S.day + 1 : R.days); d++) if (S.known[d]) items.push({ d, nd: needOf(S, d) });\n2800\t  if (!items.length) return '';\n2801\t  const lab = d => (d === S.day ? '今晚' : d === S.day + 1 ? '明晚' : `第${d}天`);\n2802\t  return `<div class=\"intel\" role=\"note\" aria-label=\"情报\"><span class=\"lbl\">情报</span>${items.map(it => `<span class=\"ic ${it.d === S.day ? 'now' : ''}\"><span class=\"d\">${lab(it.d)}</span>${it.nd.items.map(x => `${lookIcon(x.look)}${x.look} → <b>${HOME[LOOK_HOME[x.look]].n}</b>×${x.n}`).join(' + ')}</span>`).join('')}</div>`;\n2803\t}\n2804\t// 這一種牌的背面是她今晚要的（早上攤開的牌用）\n2805\tconst needKind = k => !!S.known[S.day] && !seatEmpty(S) && S.choice !== 'stage' && S.choice !== 'lamp' && !T[k].blank && needOf(S).items.some(x => x.look === (T[k].home ? HOME[FAM[T[k].f].home].look : HOME[FAM[T[k].f].home].look));\n2806\t// 這張牌的背面是她今晚要的：台上留著、卸妝別弃\n2807\tconst keepHint = id => !!S.known[S.day] && !seatEmpty(S) && S.choice !== 'stage' && S.choice !== 'lamp' && !tOf(S, id).blank && needOf(S).items.some(x => x.look === lookOfCard(S, id));\n2808\tconst gotOf = t => t.need.items.reduce((a, x) => a + Math.min(x.n, t.got[x.look] || 0), 0);\n2809\tfunction renderTop() {\n2810\t  const m = $('#topmid'), t = S.T;\n2811\t  if (view === 'stage') {\n2812\t    const parts = [];\n2813\t    for (let i = 0; i < t.stageMax; i++) {\n2814\t      const p = t.plays[i];\n2815\t      if (i) parts.push(`<span class=\"lk ${p && p.broke ? 'x' : ''}\">${p ? (p.broke ? '✕' : '▸') : ''}</span>`);\n2816\t      parts.push(p ? `<div class=\"pl\" style=\"background:${FCOL[p.f]};${p.f === 'fight' ? 'color:#1c1719' : ''}\">${tOf(S, p.id).n}<small>+${p.g + p.extra + p.open + p.fin}</small></div>` : '<div class=\"pl no\"></div>');\n2817\t    }\n2818\t    const last = t.plays[t.plays.length - 1], nx = nextFam(S);\n2819\t    let line;\n2820\t    if (t.ended) line = `这一场 <b>${t.gold}</b> 金${t.perfect ? ' · 完美' : ''}`;\n2821\t    else if (!last) line = `起手打 ${fc(nx)}`;\n2822\t    else if (t.plays.length >= t.stageMax) line = `${t.stageMax === R.stageMax ? '五' : '四'}张打满了`;\n2823\t    else if (last.broke) line = `<span class=\"bad\">断了</span> 下一张接 ${nx === '*' ? '任意' : fc(nx)}`;\n2824\t    else if (nx === '*') line = `下一张接 <b>任意</b> <small>+${nextBonus(S)} 金</small>`;\n2825\t    else line = `下一张接 <i class=\"fc nx\" style=\"background:${FCOL[nx]};${nx === 'fight' ? 'color:#1c1719' : ''}\">${FAM[nx].n}</i> <small>${t.chain > 1 ? `连击 ×${t.chain} · ` : ''}+${nextBonus(S)} 金</small>`;\n2826\t    if (t.grudge && !t.ended) line += ` <small class=\"bad\">怨气 ${t.grudge}</small>`;\n2827\t    m.innerHTML = `<div class=\"chain\" id=\"chain\"><div class=\"played\">${parts.join('')}</div><div class=\"nowline\">${line}</div></div>${intelHTML(true)}`;\n2828\t    return;\n2829\t  }\n2830\t  if (view === 'evening' && lookNow(S) && S.choice !== 'lamp') {\n2831\t    const nd = t.need, look = lookNow(S), got = gotOf(t), done = got >= nd.k;\n2832\t    const rows = nd.items.map(x => { const g = Math.min(x.n, t.got[x.look] || 0); return `<div class=\"nr ${g >= x.n ? 'ok' : ''}\">${LOOK_ICON[x.look]}<span><i class=\"lkn\">她${x.look} → 要 </i><b class=\"hn\">${HOME[LOOK_HOME[x.look]].n}</b></span><span class=\"pips\">${Array.from({ length: x.n }, (_, i) => `<i class=\"${i < g ? 'on' : ''}\"></i>`).join('')}</span></div>`; }).join('');\n2833\t    m.innerHTML = `<div class=\"need ${done ? 'done' : ''}\" role=\"status\"><button class=\"lookb\" data-act=\"look\" aria-expanded=\"${lookOpen}\" aria-label=\"她今晚的样子：${look}\">${LOOK_ICON[look]}<span class=\"lb\">${look}</span></button>\n2834\t      <div class=\"nt\">${rows}<small>${done ? '都够了。再推对路的，灯 +2' : `还差 ${nd.k - got} 张${nd.items.length > 1 ? '，每一样都要够' : ''}`}</small></div></div>`;\n2835\t    return;\n2836\t  }\n2837\t  // 早上、門口、夜裡：一條金字說這一步要做什麼\n2838\t  const n = t.layers.length;\n2839\t  let goal = '';\n2840\t  if (view === 'morning' && !lockedBox(S) && S.choice !== 'lamp') goal = `装妆匣 <b>${t.box.length}</b>/${t.cap}${starterOf(S) ? ` <small>起手 ${FAM[starterOf(S)].n} 要带</small>` : ''}`;\n2841\t  else if (view === 'morning') goal = '妆匣装好了 <small>出门</small>';\n2842\t  else if (view === 'door') goal = n ? `进门前卸妆 <b>${n}</b> 层 <small>没卸的会染牌</small>` : '脸是干净的 <small>进门</small>';\n2843\t  else if (view === 'night') goal = n ? `睡前还有 <b>${n}</b> 层 <small>过夜就渗进底色</small>` : '夜深了 <small>睡吧</small>';\n2844\t  m.innerHTML = `${goal ? `<div class=\"goal\">${goal}</div>` : ''}${['morning', 'night'].includes(view) ? intelHTML() : ''}`;\n2845\t}\n2846\t// ── 介面分批出現：第 1 天台上只有木牌、連擊、手牌；第一次回家才有「家」；第 2 天早上才有水牌和圖鑑 ──\n2847\tconst uiOn = {\n2848\t  board: () => S.day >= 2,\n2849\t  home: () => S.day >= 2 || ['door', 'evening', 'night'].includes(view),\n2850\t  book: () => S.day >= 2,\n2851\t};\n2852\t// 第一次出現的那一下，彈一下引人看\n2853\tfunction uiReveal(el, k) {\n2854\t  if (!S.ui) S.ui = {};\n2855\t  if (S.ui[k]) return;\n2856\t  S.ui[k] = true;\n2857\t  el.classList.remove('popin'); void el.offsetWidth; el.classList.add('popin');\n2858\t}\n2859\t// 左欄：家（燈、熄、痕，她會不會走），和圖鑑\n2860\tfunction renderLeft() {\n2861\t  const el = $('#leftcol'), hp = $('#homep');\n2862\t  el.hidden = ['board', 'lastwipe', 'reveal', 'watch'].includes(view) || !uiOn.home();\n2863\t  if (el.hidden) return;\n2864\t  uiReveal(hp, 'home');\n2865\t  $('#bookBtn').hidden = !uiOn.book();\n2866\t  if (uiOn.book()) uiReveal($('#bookBtn'), 'book');\n2867\t  const danger = S.outs >= R.brokenOuts - 2 || S.scars >= R.brokenScar - 1;\n2868\t  hp.className = `homep ${danger ? 'warn' : ''}`;\n2869\t  hp.innerHTML = `<div class=\"hh\"><span>家 · 阿檀</span><span>${S.left ? '她走了' : seatEmpty(S) ? '座位空了' : ''}</span></div>\n2870\t    <div class=\"hl\" data-term=\"灯\">${lampSVG(S.lamp)}<div><b>${S.lamp}</b><small>/${R.lampFull}</small></div></div>\n2871\t    <div class=\"hrow ${S.outs >= R.brokenOuts - 2 ? 'hot' : ''}\" data-term=\"熄\"><span class=\"k\">熄</span>${outsHTML()}${S.outs >= R.brokenOuts - 2 ? `<em>再 ${R.brokenOuts - S.outs} 回她走</em>` : ''}</div>\n2872\t    <div class=\"hrow ${S.scars >= R.brokenScar - 1 ? 'hot' : ''}\" data-term=\"痕\"><span class=\"k\">痕</span>${scarsHTML()}${S.scars >= R.brokenScar - 1 ? `<em>再 ${R.brokenScar - S.scars} 道她走</em>` : ''}</div>`;\n2873\t  hp.setAttribute('aria-label', `家：灯 ${S.lamp}，熄过 ${S.outs} 回，痕 ${S.scars} 道；熄满 ${R.brokenOuts} 回或痕到 ${R.brokenScar} 道，她就走`);\n2874\t  if (innerWidth <= 760) el.style.top = `${Math.round(Math.max($('#plate').getBoundingClientRect().bottom, $('#topmid').getBoundingClientRect().bottom) + 6)}px`;\n2875\t  const seen = new Set(S.deck.map(c => c.t)).size;\n2876\t  $('#bookBtn').innerHTML = `图鉴<small>牌 ${seen}/${BOOK_CARDS.length}</small>`;\n2877\t}\n2878\t// ── 圖鑑：每張牌、每樣物件、每個詞；順便講一點戲 ──\n2879\tconst BOOK_CARDS = [...BASIC, ...BORROWED, ...SHOP, ...GIFTS];\n2880\tconst LORE = {\n2881\t  changqiang: '唱腔里拖得很长的一句，一个字能绕好几道弯，最见演员的气口和韵味。',\n2882\t  liangsang: '一开口就把嗓子亮出来，又高又脆。老戏迷讲究「先声夺人」，头一句就定了角儿的分量。',\n2883\t  bai: '念白，「唱念做打」里的「念」。京剧念白分韵白和京白；行里有句老话：「千斤话白四两唱」，念比唱还难。',\n2884\t  kuaiban: '京剧的快板是有板无眼、节奏很快的唱腔板式；曲艺里也有打着竹板说唱的快板。这里取它一气呵成的急劲。',\n2885\t  shenduan: '演员在台上的形体动作，统称身段。手、眼、身、法、步，都在里面。',\n2886\t  shuixiu: '戏服袖口接出的一段白绸。抖、甩、掸、挑、翻，一条袖子能演出喜怒哀乐。',\n2887\t  liangxiang: '一段动作结束时猛地停住，摆出一个定型的姿势，把人物的精神「亮」给观众看。',\n2888\t  fanshen: '身体在竖直的平面上翻转的身段，武生、刀马旦常用；连着翻，叫「串翻身」。',\n2889\t  jie_kutou: '唱腔里表现悲痛的哭腔，常接在唱句后面，一声「喂呀」。',\n2890\t  jie_guankou: '一口气连贯念出的大段词，字字清楚，像不换气似的往外送。相声里最常见，戏曲念白也讲究这股劲。',\n2891\t  jie_dadao: '武戏里的大刀，比如关羽的青龙偃月刀。耍大刀讲究刀花、背刀和下场的架势。',\n2892\t  manban: '京剧板式里最慢的一种，一板三眼，字少腔多，最适合抒情。',\n2893\t  tazhuan: '游戏里把「踏步」和「转身」这两样常见的步法身段合在一起，起了这个名字。',\n2894\t  qiba: '武将出征前整盔、束甲的一套程式动作，表现大将的英武。相传源自明代传奇《千金记》里霸王起兵的一场。',\n2895\t  daoban: '京剧板式，常用在成套唱腔的开头：演员往往先在幕内唱一句导板，再走出来。',\n2896\t  shuban: '合着板眼一句一句数下去的念诵，多由丑角来，诙谐利落。',\n2897\t  jijifeng: '一种锣鼓点子，节奏急促密集，多用在武将上下场、开打和紧张的场面。',\n2898\t  yunbai: '京剧念白的一种，用湖广音、中州韵，抑扬顿挫像在吟诵，多给正派人物用。',\n2899\t  woyu: '旦角身段：身子盘旋着卧下、往后仰。《贵妃醉酒》里杨玉环俯身闻花的卧鱼最有名。',\n2900\t  qingchang: '不化妆、不穿戏服、不做身段，只唱。票友聚在一起，常这样唱。',\n2901\t  dingchang: '角色第一次上场时念的四句诗，交代身份和心境；念完，场子就「定」住了。',\n2902\t  tuoqiang: '琴师用京胡跟着演员的唱腔走，托住、垫住，叫「托腔保调」。好琴师能让角儿唱得更舒服。',\n2903\t  tangma: '表现骑马赶路的一套程式动作。手里一根马鞭，就是一匹马。',\n2904\t  tang: '不是戏。她把汤热了第二回，等你回来。',\n2905\t  fan: '不是戏。两只碗、两双筷子，她摆好了。',\n2906\t  xin: '不是戏。她把你早年写的信翻出来，用红线又扎了一遍。',\n2907\t  zhi: '不是戏。灯糊完了，她剪了一朵花，贴在窗上。',\n2908\t};\n2909\tconst RELIC_LORE = {\n2910\t  qinshi: '京剧乐队里拉京胡的人，是角儿的「另一条嗓子」。',\n2911\t  gujing: '锣鼓点子的口诀，用「仓、才、台、七」这样的字念出来，记熟了才打得齐。',\n2912\t  cha: '唱戏的人护嗓子，常泡一杯胖大海或罗汉果。',\n2913\t  lian: '放胭脂、粉和首饰的小匣子。',\n2914\t  jin: '用旧了、用软了的手巾，卸妆不伤脸。',\n2915\t  you: '点灯用的油。',\n2916\t  luo: '乐队里的小锣，声音清脆，常给旦角、文戏打点子。',\n2917\t};\n2918\tlet bookTab = 'cards', bookSel = null;\n2919\tfunction bookPanel() {\n2920\t  const owned = new Set(S.deck.map(c => c.t));\n2921\t  const tabs = [['cards', '牌'], ['relics', '物件'], ['terms', '词条']].map(([k, n]) => `<button class=\"btn small ${bookTab === k ? 'go' : ''}\" data-act=\"booktab\" data-arg=\"${k}\" aria-pressed=\"${bookTab === k}\">${n}</button>`).join('');\n2922\t  let body = '';\n2923\t  if (bookTab === 'cards') {\n2924\t    if (bookSel) {\n2925\t      const k = bookSel, tp = T[k], kind = tp.home ? '家常牌（她送的）' : BASIC.includes(k) ? '基础牌' : BORROWED.includes(k) ? '借来的牌' : `后台的牌 · ${T[k].price} 金`;\n2926\t      const lines = tp.home ? ['不上台。', `对上她的需要，一张算两张，灯 +3。`] : stageLines(k);\n2927\t      body = `<div class=\"bookd\"><div class=\"faces\"><figure><img src=\"${cardArt(k, 'stage').url}\" alt=\"\">台上面</figure>${tp.home ? '' : `<figure><img src=\"${cardArt(k, 'home').url}\" alt=\"\">家里面</figure>`}</div>\n2928\t        <div class=\"bt\"><h3>${tp.n}<small>${tp.home ? '' : FAM[tp.f].n + ' · '}${kind}${owned.has(k) ? '' : ' · 还没拿到'}</small></h3>\n2929\t        <h4>怎么用</h4><p>${lines.map(esc).join('<br>')}${tp.home ? '' : `<br>背面：${tp.blank ? '空白（借来的牌，推给她灯不涨）' : `${HOME[FAM[tp.f].home].n}（她「${HOME[FAM[tp.f].home].look}」时要的）`}`}</p>\n2930\t        <h4>${tp.home ? '这张牌' : '戏里的讲究'}</h4><p>${esc(LORE[k] || '')}</p>\n2931\t        <button class=\"btn small\" data-act=\"booksel\" data-arg=\"\">回到全部</button></div></div>`;\n2932\t    } else {\n2933\t      const grp = (title, ks) => `<h4>${title}</h4><div class=\"bookg\">${ks.map(k => `<button class=\"bc ${owned.has(k) ? '' : 'un'}\" data-act=\"booksel\" data-arg=\"${k}\" aria-label=\"${T[k].n}${owned.has(k) ? '' : '，还没拿到'}\"><img src=\"${cardArt(k, 'stage').url}\" alt=\"\"><span>${T[k].n}</span></button>`).join('')}</div>`;\n2934\t      body = `<p class=\"note\">点一张看它怎么用、戏里有什么讲究。暗着的是还没拿到的。</p>${grp('基础牌', BASIC)}${grp('借来的牌', BORROWED)}${grp('后台的牌', SHOP)}${grp('家常牌（她送的）', GIFTS)}`;\n2935\t    }\n2936\t  } else if (bookTab === 'relics') {\n2937\t    body = `<ul class=\"bookr\">${RELIC_KEYS.map(k => `<li class=\"${S.relics.includes(k) ? 'own' : ''}\"><b>${RELICS[k].n}</b><small>${RELICS[k].price} 金${S.relics.includes(k) ? ' · 已有' : ''}</small><p>${esc(RELICS[k].tx)}</p><p class=\"lore\">${esc(RELIC_LORE[k])}</p></li>`).join('')}</ul>`;\n2938\t  } else {\n2939\t    body = `<dl class=\"bookt\">${Object.entries(TERMS).map(([k, v]) => `<dt>${k}</dt><dd>${esc(v)}</dd>`).join('')}</dl>`;\n2940\t  }\n2941\t  return `<div class=\"panel tujian\"><h2>图鉴<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2><div class=\"tabs\">${tabs}</div>${body}</div>`;\n2942\t}\n2943\tfunction midHTML() {\n2944\t  if (panel === 'book') return bookPanel();\n2945\t  if (panel === 'rules') return rulesPanel();\n2946\t  if (panel === 'shop') return shopPanel();\n2947\t  if (panel === 'water') return waterPanel();\n2948\t  if (sheet) return sheetPanel();\n2949\t  if (view === 'morning') return morningPanel();\n2950\t  return '';\n2951\t}\n2952\t// 每次點擊都會重畫；同一張紙要留住捲動位置和焦點，不然一按就跳回最上面\n2953\tfunction renderMid() {\n2954\t  const m = $('#mid'), key = `${view}|${panel}|${sheet ? sheet.k : ''}`, old = m.querySelector('.panel, .spread');\n2955\t  const top = old && m.dataset.key === key ? old.scrollTop : 0;\n2956\t  const fe = document.activeElement, fa = fe && m.contains(fe) && fe.dataset.act ? [fe.dataset.act, fe.dataset.arg] : null;\n2957\t  m.innerHTML = midHTML();\n2958\t  m.dataset.key = key;\n2959\t  const nu = m.querySelector('.panel, .spread');"}]},"parent_tool_use_id":null,"session_id":"6a86d5cc-dadd-48d8-88f6-40a0a537648f","uuid":"163634d3-d0d4-4c2e-a432-33a93b976b49","timestamp":"2026-11-12T13:30:32.651Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.6/index.html","content":"  t.style.top = `${below ? r.bottom + 8 : r.top - h - 8}px`;\n}\nconst hideTip = () => { tipEl().hidden = true; };\ndocument.addEventListener('pointerover', e => { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); });\ndocument.addEventListener('focusin', e => { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); });\ndocument.addEventListener('pointerdown', e => { if (e.pointerType !== 'mouse') { const el = e.target.closest('[data-term],[data-tip]'); if (el) showTip(el); else hideTip(); } });\n// 熄過幾回、痕幾道：到了上限，她就走了\nconst outsHTML = (fresh = false) => `<span class=\"outs\">${Array.from({ length: R.brokenOuts }, (_, i) => `<i class=\"${i < S.outs ? 'on' : ''} ${fresh && i === S.outs - 1 ? 'new' : ''}\"></i>`).join('')}</span>`;\nconst scarsHTML = () => `<span class=\"scars\">${Array.from({ length: R.brokenScar }, (_, i) => `<i class=\"${i < S.scars ? 'on' : ''}\"></i>`).join('')}</span>`;\nfunction renderPlate() {\n  const st = starterOf(S);\n  const stOn = st && ['morning', 'stage'].includes(view);\n  $('#plate').innerHTML = `<div class=\"d\">第 ${S.day} 天</div>\n    <div class=\"st\" ${stOn ? '' : 'hidden'}>起手 ${stOn ? fc(st) : ''}</div><div class=\"g\"><i class=\"term\" data-term=\"卖座\">卖座</i><b>${S.gold}</b></div>`;\n  // 左欄跟在木牌底下\n  const lc = $('#leftcol'); lc.style.top = innerWidth > 760 ? `${Math.round($('#plate').getBoundingClientRect().bottom + 8)}px` : '';\n}\n// 考核的底線怎麼說\nconst examTx = ne => (ne.fail === R.ranks ? '别垫底' : `别进倒数${['', '两', '三', '四'][R.ranks - ne.fail] || ''}名`);\n// 右上的水牌小牌：名次，和上一名差多少；下一次考核\nfunction renderBoardChip() {\n  const el = $('#wboard');\n  if (['board', 'lastwipe', 'reveal', 'watch'].includes(view) || !uiOn.board()) { el.innerHTML = ''; return; }\n  const b = boardOf(S), i = b.findIndex(r => r.me), up = b[i - 1], dn = b[i + 1];\n  const gap = boardDay(S) < 1 ? '还没开锣' : up ? `差${esc(up.n)} ${up.g - S.gold + 1}` : dn ? `领先${esc(dn.n)} ${S.gold - dn.g}` : '';\n  const ne = nextExam(S), bad = ne && i + 1 >= ne.fail && boardDay(S) >= 1;\n  const ex = ne && (bad || ne.day - S.day <= 1) ? `<span class=\"exam ${bad ? 'bad' : ''}\">${ne.day === S.day ? '今天' : '明天'}散戏后<i class=\"term\" data-term=\"考核\">考核</i>：${examTx(ne)}</span>` : '';\n  // 主畫面直接看三行：上一名、你、下一名（第一就看下兩名，墊底就看上兩名）\n  const from = clamp(i - 1, 0, b.length - 3), rows = b.slice(from, from + 3).map((r, k) => `<li class=\"${r.me ? 'me' : ''} ${ne && from + k + 1 === ne.fail ? 'fail' : ''}\"><span><span class=\"n\">${from + k + 1}</span>${r.me ? '你' : esc(r.n)}</span><span>${r.g}</span></li>`).join('');\n  const fresh = !(S.ui && S.ui.board);\n  if (!S.ui) S.ui = {};\n  S.ui.board = true;\n  el.innerHTML = `<button class=\"wb ${fresh ? 'popin' : ''}\" data-act=\"water\" aria-label=\"水牌第 ${i + 1}，${gap}${ne ? `，第 ${ne.day} 天考核${examTx(ne)}` : ''}。点开看全部\"><span class=\"wbh\"><span>水牌</span><span>第 <b>${i + 1}</b> / ${b.length}</span></span><ol>${rows}</ol><span class=\"dif\">${gap}</span>${ex}</button>${S.relics.length ? `<div class=\"relics\" aria-label=\"物件\">${S.relics.map(r => `<button class=\"rel\" data-tip=\"${esc(RELICS[r].n)}|${esc(RELICS[r].tx)}\" aria-label=\"${esc(RELICS[r].n)}：${esc(RELICS[r].tx)}\">${RELICS[r].n}</button>`).join('')}</div>` : ''}`;\n}\n// 情報：聽來的需要，按段排；今晚的那一條亮著\nfunction intelHTML(onlyNow = false) {\n  if (seatEmpty(S)) return '';\n  const items = [];\n  // 今晚的需要已經過了（夜裡、吃完飯），就從明天記起\n  for (let d = view === 'night' || S.T.judged ? S.day + 1 : S.day; d < (onlyNow ? S.day + 1 : R.days); d++) if (S.known[d]) items.push({ d, nd: needOf(S, d) });\n  if (!items.length) return '';\n  const lab = d => (d === S.day ? '今晚' : d === S.day + 1 ? '明晚' : `第${d}天`);\n  return `<div class=\"intel\" role=\"note\" aria-label=\"情报\"><span class=\"lbl\">情报</span>${items.map(it => `<span class=\"ic ${it.d === S.day ? 'now' : ''}\"><span class=\"d\">${lab(it.d)}</span>${it.nd.items.map(x => `${lookIcon(x.look)}${x.look} → <b>${HOME[LOOK_HOME[x.look]].n}</b>×${x.n}`).join(' + ')}</span>`).join('')}</div>`;\n}\n// 這一種牌的背面是她今晚要的（早上攤開的牌用）\nconst needKind = k => !!S.known[S.day] && !seatEmpty(S) && S.choice !== 'stage' && S.choice !== 'lamp' && !T[k].blank && needOf(S).items.some(x => x.look === (T[k].home ? HOME[FAM[T[k].f].home].look : HOME[FAM[T[k].f].home].look));\n// 這張牌的背面是她今晚要的：台上留著、卸妝別弃\nconst keepHint = id => !!S.known[S.day] && !seatEmpty(S) && S.choice !== 'stage' && S.choice !== 'lamp' && !tOf(S, id).blank && needOf(S).items.some(x => x.look === lookOfCard(S, id));\nconst gotOf = t => t.need.items.reduce((a, x) => a + Math.min(x.n, t.got[x.look] || 0), 0);\nfunction renderTop() {\n  const m = $('#topmid'), t = S.T;\n  if (view === 'stage') {\n    const parts = [];\n    for (let i = 0; i < t.stageMax; i++) {\n      const p = t.plays[i];\n      if (i) parts.push(`<span class=\"lk ${p && p.broke ? 'x' : ''}\">${p ? (p.broke ? '✕' : '▸') : ''}</span>`);\n      parts.push(p ? `<div class=\"pl\" style=\"background:${FCOL[p.f]};${p.f === 'fight' ? 'color:#1c1719' : ''}\">${tOf(S, p.id).n}<small>+${p.g + p.extra + p.open + p.fin}</small></div>` : '<div class=\"pl no\"></div>');\n    }\n    const last = t.plays[t.plays.length - 1], nx = nextFam(S);\n    let line;\n    if (t.ended) line = `这一场 <b>${t.gold}</b> 金${t.perfect ? ' · 完美' : ''}`;\n    else if (!last) line = `起手打 ${fc(nx)}`;\n    else if (t.plays.length >= t.stageMax) line = `${t.stageMax === R.stageMax ? '五' : '四'}张打满了`;\n    else if (last.broke) line = `<span class=\"bad\">断了</span> 下一张接 ${nx === '*' ? '任意' : fc(nx)}`;\n    else if (nx === '*') line = `下一张接 <b>任意</b> <small>+${nextBonus(S)} 金</small>`;\n    else line = `下一张接 <i class=\"fc nx\" style=\"background:${FCOL[nx]};${nx === 'fight' ? 'color:#1c1719' : ''}\">${FAM[nx].n}</i> <small>${t.chain > 1 ? `连击 ×${t.chain} · ` : ''}+${nextBonus(S)} 金</small>`;\n    if (t.grudge && !t.ended) line += ` <small class=\"bad\">怨气 ${t.grudge}</small>`;\n    m.innerHTML = `<div class=\"chain\" id=\"chain\"><div class=\"played\">${parts.join('')}</div><div class=\"nowline\">${line}</div></div>${intelHTML(true)}`;\n    return;\n  }\n  if (view === 'evening' && lookNow(S) && S.choice !== 'lamp') {\n    const nd = t.need, look = lookNow(S), got = gotOf(t), done = got >= nd.k;\n    const rows = nd.items.map(x => { const g = Math.min(x.n, t.got[x.look] || 0); return `<div class=\"nr ${g >= x.n ? 'ok' : ''}\">${LOOK_ICON[x.look]}<span><i class=\"lkn\">她${x.look} → 要 </i><b class=\"hn\">${HOME[LOOK_HOME[x.look]].n}</b></span><span class=\"pips\">${Array.from({ length: x.n }, (_, i) => `<i class=\"${i < g ? 'on' : ''}\"></i>`).join('')}</span></div>`; }).join('');\n    m.innerHTML = `<div class=\"need ${done ? 'done' : ''}\" role=\"status\"><button class=\"lookb\" data-act=\"look\" aria-expanded=\"${lookOpen}\" aria-label=\"她今晚的样子：${look}\">${LOOK_ICON[look]}<span class=\"lb\">${look}</span></button>\n      <div class=\"nt\">${rows}<small>${done ? '都够了。再推对路的，灯 +2' : `还差 ${nd.k - got} 张${nd.items.length > 1 ? '，每一样都要够' : ''}`}</small></div></div>`;\n    return;\n  }\n  // 早上、門口、夜裡：一條金字說這一步要做什麼\n  const n = t.layers.length;\n  let goal = '';\n  if (view === 'morning' && !lockedBox(S) && S.choice !== 'lamp') goal = `装妆匣 <b>${t.box.length}</b>/${t.cap}${starterOf(S) ? ` <small>起手 ${FAM[starterOf(S)].n} 要带</small>` : ''}`;\n  else if (view === 'morning') goal = '妆匣装好了 <small>出门</small>';\n  else if (view === 'door') goal = n ? `进门前卸妆 <b>${n}</b> 层 <small>没卸的会染牌</small>` : '脸是干净的 <small>进门</small>';\n  else if (view === 'night') goal = n ? `睡前还有 <b>${n}</b> 层 <small>过夜就渗进底色</small>` : '夜深了 <small>睡吧</small>';\n  m.innerHTML = `${goal ? `<div class=\"goal\">${goal}</div>` : ''}${['morning', 'night'].includes(view) ? intelHTML() : ''}`;\n}\n// ── 介面分批出現：第 1 天台上只有木牌、連擊、手牌；第一次回家才有「家」；第 2 天早上才有水牌和圖鑑 ──\nconst uiOn = {\n  board: () => S.day >= 2,\n  home: () => S.day >= 2 || ['door', 'evening', 'night'].includes(view),\n  book: () => S.day >= 2,\n};\n// 第一次出現的那一下，彈一下引人看\nfunction uiReveal(el, k) {\n  if (!S.ui) S.ui = {};\n  if (S.ui[k]) return;\n  S.ui[k] = true;\n  el.classList.remove('popin'); void el.offsetWidth; el.classList.add('popin');\n}\n// 左欄：家（燈、熄、痕，她會不會走），和圖鑑\nfunction renderLeft() {\n  const el = $('#leftcol'), hp = $('#homep');\n  el.hidden = ['board', 'lastwipe', 'reveal', 'watch'].includes(view) || !uiOn.home();\n  if (el.hidden) return;\n  uiReveal(hp, 'home');\n  $('#bookBtn').hidden = !uiOn.book();\n  if (uiOn.book()) uiReveal($('#bookBtn'), 'book');\n  const danger = S.outs >= R.brokenOuts - 2 || S.scars >= R.brokenScar - 1;\n  hp.className = `homep ${danger ? 'warn' : ''}`;\n  hp.innerHTML = `<div class=\"hh\"><span>家 · 阿檀</span><span>${S.left ? '她走了' : seatEmpty(S) ? '座位空了' : ''}</span></div>\n    <div class=\"hl\" data-term=\"灯\">${lampSVG(S.lamp)}<div><b>${S.lamp}</b><small>/${R.lampFull}</small></div></div>\n    <div class=\"hrow ${S.outs >= R.brokenOuts - 2 ? 'hot' : ''}\" data-term=\"熄\"><span class=\"k\">熄</span>${outsHTML()}${S.outs >= R.brokenOuts - 2 ? `<em>再 ${R.brokenOuts - S.outs} 回她走</em>` : ''}</div>\n    <div class=\"hrow ${S.scars >= R.brokenScar - 1 ? 'hot' : ''}\" data-term=\"痕\"><span class=\"k\">痕</span>${scarsHTML()}${S.scars >= R.brokenScar - 1 ? `<em>再 ${R.brokenScar - S.scars} 道她走</em>` : ''}</div>`;\n  hp.setAttribute('aria-label', `家：灯 ${S.lamp}，熄过 ${S.outs} 回，痕 ${S.scars} 道；熄满 ${R.brokenOuts} 回或痕到 ${R.brokenScar} 道，她就走`);\n  if (innerWidth <= 760) el.style.top = `${Math.round(Math.max($('#plate').getBoundingClientRect().bottom, $('#topmid').getBoundingClientRect().bottom) + 6)}px`;\n  const seen = new Set(S.deck.map(c => c.t)).size;\n  $('#bookBtn').innerHTML = `图鉴<small>牌 ${seen}/${BOOK_CARDS.length}</small>`;\n}\n// ── 圖鑑：每張牌、每樣物件、每個詞；順便講一點戲 ──\nconst BOOK_CARDS = [...BASIC, ...BORROWED, ...SHOP, ...GIFTS];\nconst LORE = {\n  changqiang: '唱腔里拖得很长的一句，一个字能绕好几道弯，最见演员的气口和韵味。',\n  liangsang: '一开口就把嗓子亮出来，又高又脆。老戏迷讲究「先声夺人」，头一句就定了角儿的分量。',\n  bai: '念白，「唱念做打」里的「念」。京剧念白分韵白和京白；行里有句老话：「千斤话白四两唱」，念比唱还难。',\n  kuaiban: '京剧的快板是有板无眼、节奏很快的唱腔板式；曲艺里也有打着竹板说唱的快板。这里取它一气呵成的急劲。',\n  shenduan: '演员在台上的形体动作，统称身段。手、眼、身、法、步，都在里面。',\n  shuixiu: '戏服袖口接出的一段白绸。抖、甩、掸、挑、翻，一条袖子能演出喜怒哀乐。',\n  liangxiang: '一段动作结束时猛地停住，摆出一个定型的姿势，把人物的精神「亮」给观众看。',\n  fanshen: '身体在竖直的平面上翻转的身段，武生、刀马旦常用；连着翻，叫「串翻身」。',\n  jie_kutou: '唱腔里表现悲痛的哭腔，常接在唱句后面，一声「喂呀」。',\n  jie_guankou: '一口气连贯念出的大段词，字字清楚，像不换气似的往外送。相声里最常见，戏曲念白也讲究这股劲。',\n  jie_dadao: '武戏里的大刀，比如关羽的青龙偃月刀。耍大刀讲究刀花、背刀和下场的架势。',\n  manban: '京剧板式里最慢的一种，一板三眼，字少腔多，最适合抒情。',\n  tazhuan: '游戏里把「踏步」和「转身」这两样常见的步法身段合在一起，起了这个名字。',\n  qiba: '武将出征前整盔、束甲的一套程式动作，表现大将的英武。相传源自明代传奇《千金记》里霸王起兵的一场。',\n  daoban: '京剧板式，常用在成套唱腔的开头：演员往往先在幕内唱一句导板，再走出来。',\n  shuban: '合着板眼一句一句数下去的念诵，多由丑角来，诙谐利落。',\n  jijifeng: '一种锣鼓点子，节奏急促密集，多用在武将上下场、开打和紧张的场面。',\n  yunbai: '京剧念白的一种，用湖广音、中州韵，抑扬顿挫像在吟诵，多给正派人物用。',\n  woyu: '旦角身段：身子盘旋着卧下、往后仰。《贵妃醉酒》里杨玉环俯身闻花的卧鱼最有名。',\n  qingchang: '不化妆、不穿戏服、不做身段，只唱。票友聚在一起，常这样唱。',\n  dingchang: '角色第一次上场时念的四句诗，交代身份和心境；念完，场子就「定」住了。',\n  tuoqiang: '琴师用京胡跟着演员的唱腔走，托住、垫住，叫「托腔保调」。好琴师能让角儿唱得更舒服。',\n  tangma: '表现骑马赶路的一套程式动作。手里一根马鞭，就是一匹马。',\n  tang: '不是戏。她把汤热了第二回，等你回来。',\n  fan: '不是戏。两只碗、两双筷子，她摆好了。',\n  xin: '不是戏。她把你早年写的信翻出来，用红线又扎了一遍。',\n  zhi: '不是戏。灯糊完了，她剪了一朵花，贴在窗上。',\n};\nconst RELIC_LORE = {\n  qinshi: '京剧乐队里拉京胡的人，是角儿的「另一条嗓子」。',\n  gujing: '锣鼓点子的口诀，用「仓、才、台、七」这样的字念出来，记熟了才打得齐。',\n  cha: '唱戏的人护嗓子，常泡一杯胖大海或罗汉果。',\n  lian: '放胭脂、粉和首饰的小匣子。',\n  jin: '用旧了、用软了的手巾，卸妆不伤脸。',\n  you: '点灯用的油。',\n  luo: '乐队里的小锣，声音清脆，常给旦角、文戏打点子。',\n};\nlet bookTab = 'cards', bookSel = null;\nfunction bookPanel() {\n  const owned = new Set(S.deck.map(c => c.t));\n  const tabs = [['cards', '牌'], ['relics', '物件'], ['terms', '词条']].map(([k, n]) => `<button class=\"btn small ${bookTab === k ? 'go' : ''}\" data-act=\"booktab\" data-arg=\"${k}\" aria-pressed=\"${bookTab === k}\">${n}</button>`).join('');\n  let body = '';\n  if (bookTab === 'cards') {\n    if (bookSel) {\n      const k = bookSel, tp = T[k], kind = tp.home ? '家常牌（她送的）' : BASIC.includes(k) ? '基础牌' : BORROWED.includes(k) ? '借来的牌' : `后台的牌 · ${T[k].price} 金`;\n      const lines = tp.home ? ['不上台。', `对上她的需要，一张算两张，灯 +3。`] : stageLines(k);\n      body = `<div class=\"bookd\"><div class=\"faces\"><figure><img src=\"${cardArt(k, 'stage').url}\" alt=\"\">台上面</figure>${tp.home ? '' : `<figure><img src=\"${cardArt(k, 'home').url}\" alt=\"\">家里面</figure>`}</div>\n        <div class=\"bt\"><h3>${tp.n}<small>${tp.home ? '' : FAM[tp.f].n + ' · '}${kind}${owned.has(k) ? '' : ' · 还没拿到'}</small></h3>\n        <h4>怎么用</h4><p>${lines.map(esc).join('<br>')}${tp.home ? '' : `<br>背面：${tp.blank ? '空白（借来的牌，推给她灯不涨）' : `${HOME[FAM[tp.f].home].n}（她「${HOME[FAM[tp.f].home].look}」时要的）`}`}</p>\n        <h4>${tp.home ? '这张牌' : '戏里的讲究'}</h4><p>${esc(LORE[k] || '')}</p>\n        <button class=\"btn small\" data-act=\"booksel\" data-arg=\"\">回到全部</button></div></div>`;\n    } else {\n      const grp = (title, ks) => `<h4>${title}</h4><div class=\"bookg\">${ks.map(k => `<button class=\"bc ${owned.has(k) ? '' : 'un'}\" data-act=\"booksel\" data-arg=\"${k}\" aria-label=\"${T[k].n}${owned.has(k) ? '' : '，还没拿到'}\"><img src=\"${cardArt(k, 'stage').url}\" alt=\"\"><span>${T[k].n}</span></button>`).join('')}</div>`;\n      body = `<p class=\"note\">点一张看它怎么用、戏里有什么讲究。暗着的是还没拿到的。</p>${grp('基础牌', BASIC)}${grp('借来的牌', BORROWED)}${grp('后台的牌', SHOP)}${grp('家常牌（她送的）', GIFTS)}`;\n    }\n  } else if (bookTab === 'relics') {\n    body = `<ul class=\"bookr\">${RELIC_KEYS.map(k => `<li class=\"${S.relics.includes(k) ? 'own' : ''}\"><b>${RELICS[k].n}</b><small>${RELICS[k].price} 金${S.relics.includes(k) ? ' · 已有' : ''}</small><p>${esc(RELICS[k].tx)}</p><p class=\"lore\">${esc(RELIC_LORE[k])}</p></li>`).join('')}</ul>`;\n  } else {\n    body = `<dl class=\"bookt\">${Object.entries(TERMS).map(([k, v]) => `<dt>${k}</dt><dd>${esc(v)}</dd>`).join('')}</dl>`;\n  }\n  return `<div class=\"panel tujian\"><h2>图鉴<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2><div class=\"tabs\">${tabs}</div>${body}</div>`;\n}\nfunction midHTML() {\n  if (panel === 'book') return bookPanel();\n  if (panel === 'rules') return rulesPanel();\n  if (panel === 'shop') return shopPanel();\n  if (panel === 'water') return waterPanel();\n  if (sheet) return sheetPanel();\n  if (view === 'morning') return morningPanel();\n  return '';\n}\n// 每次點擊都會重畫；同一張紙要留住捲動位置和焦點，不然一按就跳回最上面\nfunction renderMid() {\n  const m = $('#mid'), key = `${view}|${panel}|${sheet ? sheet.k : ''}`, old = m.querySelector('.panel, .spread');\n  const top = old && m.dataset.key === key ? old.scrollTop : 0;\n  const fe = document.activeElement, fa = fe && m.contains(fe) && fe.dataset.act ? [fe.dataset.act, fe.dataset.arg] : null;\n  m.innerHTML = midHTML();\n  m.dataset.key = key;\n  const nu = m.querySelector('.panel, .spread');","numLines":200,"startLine":2760,"totalLines":3877}},"tool_result_meta":[{"id":"toolu_01Lb832tWiWxC6r3wLk2HeDN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
