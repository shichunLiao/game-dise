.min(1.6, 0.35 * n);\n  if (n >= 2) swayKick = Math.max(swayKick, 0.35 * n);\n  if (n >= 3) { spawn('petal', 40 + (n - 3) * 35); const b = COMBO_TX[Math.min(n, 5)]; banner(b[0], b[1], n >= 4 ? 'big' : ''); }\n  if (n >= 4) { spawn('foil', 80); spawn('ribbon', 6); if (glOK && camPos) camPos.lerp(camAim, 0.08); }\n  if (n >= 5) [0, 350, 700].forEach(d => setTimeout(() => spawn('fw', 60, { x: innerWidth * (0.2 + Math.random() * 0.6), y: innerHeight * (0.12 + Math.random() * 0.2) }), d));\n}\nasync function run(fn) { if (busy) return; busy = true; refresh(); try { await fn(); } finally { busy = false; refresh(); } }\n\n// ── 一天 ──\n// 依目前時段擺桌面（開局、接著玩都走這裡）\nfunction placeScene() {\n  if (view !== 'stage') { clearBubs(); stageHeat = 0; }\n  if (!glOK) return;\n  const lk = lookNow(S);\n  const v = { morning: ['table', 'day'], stage: ['stage', 'stage'], door: ['door', 'door'], evening: ['home', 'home'], night: ['night', 'night'], watch: ['night', 'night'], board: ['table', 'day'], lastwipe: ['mirror', 'night'], reveal: ['home', 'home'] }[view] || ['table', 'day'];\n  focus(v[0], v[1]);\n  const base = lk && (view === 'evening' || view === 'morning') && (view === 'evening' || actOf(S.day) === 0) ? LOOK_POSE[lk] : 'work';\n  wife.base = base;\n  // 第一幕她對你笑\n  wife.expr = { eyes: 'open', smile: actOf(S.day) === 0 };\n  wife.pose(base); wife.turn(0); wife.redraw();\n  actor.root.visible = view === 'stage';\n  crowdG.visible = view === 'stage';\n  if (view === 'stage') actor.setLayers(S.T.layers);\n}\nfunction toDay() {\n  sheet = null; lookOpen = false;\n  view = S.phase;\n  clear3DCards();\n  placeScene();\n  if (glOK) actor.setLayers([]);\n  const st = starterOf(S), ev = eventOf(S), k = S.events[S.day];\n  if (view === 'stage') say('班主', DAY_TX[S.day - 1]);\n  else if (ev) sayH(ev.who, EV_TX[k](), esc(DAY_TX[S.day - 1]));\n  else say('', DAY_TX[S.day - 1]);\n  refresh();\n}\nfunction startGame(name) {\n  S = newGame(name, ((Date.now() % 2147483647) ^ Math.floor(Math.random()