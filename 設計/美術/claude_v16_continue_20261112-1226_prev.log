iv class=\"pv\">${previewTx(k)}</div><div class=\"pr\">${priceOf(k)} 金</div>${sold ? '' : `<div class=\"pv ab\">${afterBuy(k)}</div>`}\n      <button class=\"btn small ${can ? 'go' : ''}\" data-act=\"buy\" data-arg=\"${k}\" ${can ? '' : 'disabled'}>${sold ? '买下了' : can ? '买' : '钱不够'}</button></div>`;\n  }).join('');\n  return `<div class=\"panel shopp\"><h2>后台 · 孙师父<button class=\"btn small\" style=\"float:right\" data-act=\"close\">回桌上</button></h2>\n    <p class=\"note\">“这几张，是我年轻时候的看家本事。拿去，别糟践了。”</p>\n    <div class=\"purse\"><span>卖座<b>${S.gold}</b></span><span>水牌第<b>${rankOf(S)}</b></span><span>还剩 <b>${daysLeft()}</b> 场</span></div>\n    <p class=\"note\">只有一种金：花的就是卖座，买了水牌马上往下掉，要靠往后几天多挣回来。买下的牌进卡组，以后每天都能装；物件买一次整季都在。明天孙师父换一批。</p>\n    ${S.relics.length ? `<p class=\"note\">你已经有：${S.relics.map(r => RELICS[r].n).join('、')}</p>` : ''}\n    <div class=\"shop\">${cells}</div></div>`;\n}\nfunction waterPanel() {\n  const ev = eventOf(S), k = S.events[S.day];\n  return `<div class=\"panel\"><h2>水牌<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2>\n    <p class=\"note\">记到第 ${boardDay(S)} 天。每天散戏后，加上当天挣的卖座。</p>${boardHTML()}\n    ${ev ? `<p class=\"note\">今天：${EV_TX[k]()}</p>` : ''}</div>`;\n}\nfunction rulesPanel() {\n  const P = S.played;\n  return `<div class=\"panel rules\"><h2>规矩<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2>\n    <h4>内账（试玩用）</h4><div class=\"ledger\"><span>卖座 ${S.gold}</span><span>花掉 ${S.spent}</span><span>灯 ${S.lamp}</span><span>痕 ${S.scars}</span><span>灭灯 ${S.outs}</span><span>底色 ${S.base}</span><span>满足 ${S.met.join('/')}</span><span>小凤 +${S.fengGold}</span><span>唱 ${P.sing} 念 ${P.speak}</span><span>做 ${P.act} 打 ${P.fight}</span><span>水牌第 ${rankOf(S)}</span></div>\n    <h4>技巧</h4><ul class=\"tips\">${TIPS.map(r => `<li>${r}</li>`).join('')}</ul>\n    <h4>待你确认：可以开关</h4><ul>\n      <li>「开得正」+1 金：<button class=\"btn small\" data-act=\"opt\" data-arg=\"open\" aria-pressed=\"${S.