{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HWxhpQ23HDKZ7zWJXYamgG","type":"tool_result","content":"2959\t  const nu = m.querySelector('.panel, .spread');\n2960\t  if (nu) nu.scrollTop = top;\n2961\t  if (fa) {\n2962\t    const b = m.querySelector(`[data-act=\"${fa[0]}\"]${fa[1] !== undefined ? `[data-arg=\"${CSS.escape(fa[1])}\"]` : ''}`);\n2963\t    if (b && !b.disabled) b.focus({ preventScroll: true });\n2964\t  }\n2965\t}\n2966\tfunction morningPanel() {\n2967\t  const t = S.T;\n2968\t  if (S.day === R.days && !S.choice) {\n2969\t    return `<div class=\"yuan\"><h3>元宵，三选一</h3><div class=\"pair\">\n2970\t      <button class=\"yn\" data-act=\"yuan\" data-arg=\"stage\">上台<small>起手打 · 金 ×2 · 不回家，灯由她一个人点</small></button>\n2971\t      <button class=\"yn\" data-act=\"yuan\" data-arg=\"lamp\">回家点灯<small>不演 · 灯点亮 · 只有这条路能到美满</small></button>\n2972\t      <button class=\"yn\" data-act=\"yuan\" data-arg=\"cover\">替小凤代演<small>起手唱 · 金记在她名下，她留在水牌上</small></button>\n2973\t    </div></div>`;\n2974\t  }\n2975\t  if (lockedBox(S) || S.choice === 'lamp') return '';\n2976\t  const kinds = [...BASIC, ...BORROWED, ...SHOP, ...GIFTS].filter(k => S.deck.some(c => c.t === k));\n2977\t  const cells = kinds.map(k => {\n2978\t    const free = S.deck.filter(c => c.t === k && !t.box.includes(c.id)), can = free.length > 0;\n2979\t    const nk = needKind(k);\n2980\t    return `<button class=\"spc ${nk && can ? 'want' : ''}\" data-act=\"pick\" data-arg=\"${k}\" data-t=\"${k}\" ${can ? '' : 'disabled'} aria-label=\"${T[k].n}，还有 ${free.length} 张${nk ? '，背面是她今晚要的' : ''}\"><img src=\"${cardArt(k, 'stage').url}\" alt=\"\"><span class=\"ct\">${free.length}</span>${nk && can ? '<span class=\"wtag\" aria-hidden=\"true\">家</span>' : ''}</button>`;\n2981\t  }).join('');\n2982\t  const shop = t.offers.length ? `<button class=\"mini\" data-act=\"shop\" style=\"border-color:#f2d48a;color:#f2d48a\">后台 · 孙师父（花卖座，名次会掉）</button>` : '';\n2983\t  return `<div class=\"spread\"><div class=\"sph\">卡组 · 点一张放进妆匣</div>${cells}${shop ? `<div class=\"tools2\">${shop}</div>` : ''}</div>`;\n2984\t}\n2985\t// 攤開的牌照桌上的空位排：在這塊空位裡把牌放到最大，放不下一列就折行\n2986\tfunction fitSpread() {\n2987\t  const sp = $('#mid .spread');\n2988\t  if (!sp) return;\n2989\t  const n = sp.querySelectorAll('.spc').length, mid = $('#mid').getBoundingClientRect(), cs = getComputedStyle(sp);\n2990\t  const padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight), padY = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);\n2991\t  const gx = parseFloat(cs.columnGap) || 10, gy = parseFloat(cs.rowGap) || 8, tools = (sp.querySelector('.tools2')?.offsetHeight || 32) + gy + (sp.querySelector('.sph')?.offsetHeight || 0) + gy;\n2992\t  // 可用的空位：寬螢幕夾在左邊木牌、妝匣和右邊水牌之間，從情報底下開始；窄螢幕在木牌底下、整個寬度\n2993\t  const R = el => (el && !el.hidden && el.getClientRects().length ? el.getBoundingClientRect() : null);\n2994\t  const plate = R($('#plate')), tray = R($('#leftcol')), side = R(document.querySelector('.side')), tm = R($('#topmid'));\n2995\t  const wide = innerWidth >= 760;\n2996\t  let topY, gut;\n2997\t  if (wide) {\n2998\t    gut = Math.max(plate ? plate.right : 0, tray && tray.top < mid.bottom ? tray.right : 0, side ? innerWidth - side.left : 0) + 12;\n2999\t    topY = (tm && tm.height > 4 ? tm.bottom : plate ? plate.top : mid.top) + 8;\n3000\t  } else {\n3001\t    gut = 8;\n3002\t    topY = Math.max(plate ? plate.bottom : 0, side ? side.bottom : 0, tm ? tm.bottom : 0) + 8;\n3003\t  }\n3004\t  topY = Math.min(topY, mid.top);\n3005\t  const W = innerWidth - 2 * gut - padX - 2, H = mid.bottom - topY - padY - tools - 6;\n3006\t  let best = { h: 0, cols: 4, rows: 99 };\n3007\t  for (let cols = 1; cols <= n; cols++) {\n3008\t    const rows = Math.ceil(n / cols);\n3009\t    const h = Math.min(210, (H - (rows - 1) * gy) / rows, (W - (cols - 1) * gx) / cols * 1.5);\n3010\t    // 牌已經到最大了，就排成行數少的；行數一樣，取每行少的（排得勻）\n3011\t    if (h > best.h + 0.5 || (h >= 209.5 && best.h >= 209.5 && rows < best.rows)) best = { h, cols, rows };\n3012\t  }\n3013\t  const h = Math.max(84, Math.floor(best.h));\n3014\t  sp.style.top = `${topY - mid.top}px`;\n3015\t  sp.style.maxHeight = `${mid.bottom - topY}px`;\n3016\t  sp.style.setProperty('--cols', best.cols);\n3017\t  sp.style.setProperty('--chh', `${h}px`);\n3018\t  sp.style.setProperty('--cw', `${Math.round(h / 1.5)}px`);\n3019\t}\n3020\taddEventListener('resize', () => { if (view === 'morning') fitSpread(); });\n3021\t// 試排：用卡組裡這些牌，今天起手打四張，最好的一條鏈能拿多少金（不算擲骰）\n3022\tfunction bestLineGold(types, n = 4) {\n3023\t  const start = starterOf(S);\n3024\t  if (!start) return 0;\n3025\t  const cnt = {}; types.forEach(t => { cnt[t] = (cnt[t] || 0) + 1; });\n3026\t  let best = 0;\n3027\t  const walk = (k, want, g) => {\n3028\t    if (k === n) { best = Math.max(best, g); return; }\n3029\t    for (const t of Object.keys(cnt)) {\n3030\t      const tp = T[t];\n3031\t      if (!cnt[t] || tp.home || (k === 0 ? !(tp.f === want || tp.wild) : !(tp.wild || want === '*' || tp.f === want))) continue;\n3032\t      const add = tp.g + (k === 0 ? R.openGold + (has(S, 'gujing') ? 3 : 0) : (R.chainGold[Math.min(k + 1, R.stageMax)] + (has(S, 'qinshi') ? 1 : 0)) * (tp.boost ? 2 : 1)) + (tp.fin && k >= 3 ? tp.fin : 0);\n3033\t      cnt[t] -= 1; walk(k + 1, tp.wild ? '*' : tp.next, g + add); cnt[t] += 1;\n3034\t    }\n3035\t    best = Math.max(best, g);\n3036\t  };\n3037\t  walk(0, start, 0);\n3038\t  return best;\n3039\t}\n3040\t// 還剩幾場戲（今天這場也算）\n3041\tconst daysLeft = () => R.days - S.day + 1;\n3042\t// 幾天回本：每天多拿 d 金，價錢 p\n3043\tconst payback = (d, p) => { const n = Math.ceil(p / d), left = daysLeft(); return n <= left ? `约 ${n} 天回本（还剩 ${left} 场）` : `<span class=\"bad\">还剩 ${left} 场，回不了本</span>`; };\n3044\tfunction previewTx(k) {\n3045\t  const p = priceOf(k);\n3046\t  if (RELICS[k]) {\n3047\t    if (k === 'qinshi') return `四张链每天约 +3 金；${payback(3, p)}`;\n3048\t    if (k === 'gujing') return `每天开得正 +3 金；${payback(3, p)}`;\n3049\t    if (k === 'cha') return '完美的机会从一半变成三分之二：一场多三四金';\n3050\t    if (k === 'lian') return '多一格：多带一张回家，或多一张卸妆';\n3051\t    if (k === 'jin') return '她擦一次 3 层：上四张，只要再弃一张';\n3052\t    if (k === 'you') return '灭灯只熄 1（熄过一回，就到不了美满）';\n3053\t    if (k === 'luo') return '每天接错一次不伤她';\n3054\t    return '';\n3055\t  }\n3056\t  const deck = S.deck.map(c => c.t), base = bestLineGold(deck), more = bestLineGold([...deck, k]);\n3057\t  const d = more - base;\n3058\t  const tp = T[k], why = tp.wild ? '断了的链靠它接回来' : tp.clean ? '脸上少一层，省一张卸妆的牌' : '';\n3059\t  return d > 0 ? `放进今天的四张链：<b>+${d} 金</b>${tp.heavy ? '，多一层油彩' : tp.clean ? '，还少一层油彩' : ''}；起手天天换，${payback(Math.max(1, d / 2), p)}` : why ? `今天的链用不上它；${why}` : `今天起手${FAM[starterOf(S)]?.n || ''}用不上，换个日子再看`;\n3060\t}\n3061\t// 買了以後掉到第幾：照現在的水牌算\n3062\tfunction afterBuy(k) {\n3063\t  const p = priceOf(k), r0 = rankOf(S);\n3064\t  S.gold -= p; const r1 = rankOf(S); S.gold += p;\n3065\t  const ne = nextExam(S), risk = ne && r1 >= ne.fail;\n3066\t  return `买了：卖座 ${S.gold} → ${S.gold - p}，水牌第 ${r0} → <b class=\"${r1 > r0 ? 'bad' : ''}\">${r1}</b>${risk ? `<br><span class=\"bad\">第 ${ne.day} 天考核${examTx(ne)}，小心</span>` : ''}`;\n3067\t}\n3068\t// 後台：孫師父每天兩張牌、一樣物件\n3069\tfunction shopPanel() {\n3070\t  const t = S.T;\n3071\t  const cells = t.offers.map(k => {\n3072\t    const sold = t.sold.includes(k) || S.relics.includes(k), can = canBuy(S, k), rel = RELICS[k];\n3073\t    const pic = rel ? `<div class=\"relic\" aria-hidden=\"true\">${rel.n[0]}</div>` : `<img src=\"${cardArt(k, 'stage').url}\" alt=\"${T[k].n}\" data-t=\"${k}\" class=\"spc\" style=\"width:96px;height:144px\">`;\n3074\t    const kw = rel ? `<b>物件 · ${rel.n}</b><br>${rel.tx}<br>买一次，整季都有用。` : `${stageLines(k).join('<br>')}<br>背面 ${HOME[FAM[T[k].f].home].n}`;\n3075\t    return `<div class=\"offer ${sold ? 'sold' : ''} ${rel ? 'isrel' : ''}\">${pic}\n3076\t      <div class=\"kw\">${kw}</div><div class=\"pv\">${previewTx(k)}</div><div class=\"pr\">${priceOf(k)} 金</div>${sold ? '' : `<div class=\"pv ab\">${afterBuy(k)}</div>`}\n3077\t      <button class=\"btn small ${can ? 'go' : ''}\" data-act=\"buy\" data-arg=\"${k}\" ${can ? '' : 'disabled'}>${sold ? '买下了' : can ? '买' : '钱不够'}</button></div>`;\n3078\t  }).join('');\n3079\t  return `<div class=\"panel shopp\"><h2>后台 · 孙师父<button class=\"btn small\" style=\"float:right\" data-act=\"close\">回桌上</button></h2>\n3080\t    <p class=\"note\">“这几张，是我年轻时候的看家本事。拿去，别糟践了。”</p>\n3081\t    <div class=\"purse\"><span>卖座<b>${S.gold}</b></span><span>水牌第<b>${rankOf(S)}</b></span><span>还剩 <b>${daysLeft()}</b> 场</span></div>\n3082\t    <p class=\"note\">只有一种金：花的就是卖座，买了水牌马上往下掉，要靠往后几天多挣回来。买下的牌进卡组，以后每天都能装；物件买一次整季都在。明天孙师父换一批。</p>\n3083\t    ${S.relics.length ? `<p class=\"note\">你已经有：${S.relics.map(r => RELICS[r].n).join('、')}</p>` : ''}\n3084\t    <div class=\"shop\">${cells}</div></div>`;\n3085\t}\n3086\tfunction waterPanel() {\n3087\t  const ev = eventOf(S), k = S.events[S.day];\n3088\t  return `<div class=\"panel\"><h2>水牌<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2>\n3089\t    <p class=\"note\">记到第 ${boardDay(S)} 天。每天散戏后，加上当天挣的卖座。</p>${boardHTML()}\n3090\t    ${ev ? `<p class=\"note\">今天：${EV_TX[k]()}</p>` : ''}</div>`;\n3091\t}\n3092\tfunction rulesPanel() {\n3093\t  const P = S.played;\n3094\t  return `<div class=\"panel rules\"><h2>规矩<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2>\n3095\t    <h4>内账（试玩用）</h4><div class=\"ledger\"><span>卖座 ${S.gold}</span><span>花掉 ${S.spent}</span><span>灯 ${S.lamp}</span><span>痕 ${S.scars}</span><span>灭灯 ${S.outs}</span><span>底色 ${S.base}</span><span>满足 ${S.met.join('/')}</span><span>小凤 +${S.fengGold}</span><span>唱 ${P.sing} 念 ${P.speak}</span><span>做 ${P.act} 打 ${P.fight}</span><span>水牌第 ${rankOf(S)}</span></div>\n3096\t    <h4>技巧</h4><ul class=\"tips\">${TIPS.map(r => `<li>${r}</li>`).join('')}</ul>\n3097\t    <h4>待你确认：可以开关</h4><ul>\n3098\t      <li>「开得正」+1 金：<button class=\"btn small\" data-act=\"opt\" data-arg=\"open\" aria-pressed=\"${S.opt.open}\">${S.opt.open ? '保留' : '不要'}</button></li>\n3099\t    </ul>\n3100\t    <h4>待你确认：还没定</h4><ul>${PENDING.map(r => `<li>${r}</li>`).join('')}</ul>\n3101\t    <h4>规矩</h4><ol>${RULES.map(r => `<li>${termify(r)}</li>`).join('')}</ol>\n3102\t    <h4>设定没写死、原型自拟的</h4><ul>${ASSUME.map(r => `<li>${r}</li>`).join('')}</ul>\n3103\t    <div class=\"acts\"><button class=\"btn\" data-act=\"mute\">${muted ? '开声音' : '关声音'}</button><button class=\"btn\" data-act=\"again\">重开一局</button></div></div>`;\n3104\t}\n3105\tfunction boardHTML() {\n3106\t  return `<ol class=\"board\">${boardOf(S).map((r, i) => `<li class=\"${r.me ? 'me' : ''}\"><span>${i + 1}. ${esc(r.n)}</span><span>${r.g}</span></li>`).join('')}</ol>`;\n3107\t}\n3108\tfunction sheetPanel() {\n3109\t  const k = sheet.k;\n3110\t  if (k === 'board') {\n3111\t    const a = actOf(S.day), ex = examOf(S);\n3112\t    return `<div class=\"panel\"><h2>水牌 · 考核</h2><p class=\"note\">第${'一二三'[a]}幕${ACT_N[a]}，到这里。魏老板看水牌定去留：${examTx(ex)}，排到第 ${ex.fail} 名${ex.fail < R.ranks ? '或更后' : ''}就摘牌。</p>${boardHTML()}\n3113\t      ${ex.pass ? `<p>你排第 ${ex.rank}，留下了。${a === 0 ? `第 7 天还有一次：${examTx(nextExam({ day: 4 }))}。` : ''}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"nextact\">第${'一二三'[a + 1]}幕</button></div>`\n3114\t    : `<p class=\"fired\">你排第 ${ex.rank}。魏老板把你的牌子摘了下来。</p><p class=\"note\">这一季到这里为止。回家，最后一次卸妆。</p><div class=\"acts\"><button class=\"btn go\" data-act=\"nextact\">摘牌，回家</button></div>`}</div>`;\n3115\t  }\n3116\t  if (k === 'mirror') return mirrorPanel();\n3117\t  if (k === 'r_board') {\n3118\t    const rk = rankOf(S);\n3119\t    const tx = S.fired ? `第 ${S.fired} 天的考核，你排第 ${rk}。魏老板把你的牌子摘了下来。` : S.left ? `她走的那天，是第 ${S.left} 天。水牌上，你排第 ${rk}。` : rk === R.ranks ? '你的名字被摘了下来。' : rk === 1 ? '最上面那块牌子，写的是你。' : '';\n3120\t    return `<div class=\"panel\"><h2>水牌</h2>${boardHTML()}<p class=\"note\">${tx}${S.choice === 'cover' ? '小凤的名字还挂着。' : ''}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"rstep\" data-arg=\"r_home\">回家</button></div></div>`;\n3121\t  }\n3122\t  if (k === 'r_home') {\n3123\t    const seat = seatEmpty(S) || wifeOf(S) === 2;\n3124\t    const tx = S.left ? `灯坊对面的椅子空着。那盏灯搁在桌上：糊了 ${Math.min(LSEG, Math.floor(S.lamp / 2))} 片纸（糊满要 ${LSEG} 片），熄过 ${S.outs} 回，划了 ${S.scars} 道。没糊完。`\n3125\t      : S.fired ? (wifeOf(S) === 0 ? '你素着脸回家，比平时早。她愣了一下，把灯骨推过来：“正好，帮我糊完。”' : '你回家比平时早。她没问，给你盛了饭。灯上有几处熄过。')\n3126\t      : S.lit ? `灯亮着，${seat ? '是你自己点的。对面的椅子空着。' : '你们一起点的。'}${S.lamp < R.happyLamp ? '有几处熄过，补不回来了。' : ''}` : S.litAlone ? '你回来时，灯已经亮了。是她一个人点的。' : seat ? '对面的椅子空着。灯没有点。' : '灯还搁在桌上，没有点。她抬头看了你一下。';\n3127\t    return `<div class=\"panel\"><h2>回家</h2><p>${tx}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"rstep\" data-arg=\"r_chest\">打开木匣</button></div></div>`;\n3128\t  }\n3129\t  if (k === 'r_chest') {\n3130\t    const days = Array.from({ length: endDay(S) }, (_, i) => { const L = S.chest.filter(c => c.day === i + 1); return `<div>第 ${i + 1} 天<div class=\"cl\">${L.map(c => `<i style=\"background:${FCOL[c.f]}\"></i>`).join('') || ''}</div></div>`; }).join('');\n3131\t    return `<div class=\"panel\"><h2>木匣</h2><p class=\"note\">${S.chest.some(c => !c.last) ? `她替你擦过 ${S.chest.filter(c => !c.last).length} 层。每一块布都叠着，按日子放好。${S.chest.some(c => c.last) ? '最上面那一块，是最后一回。' : ''}` : S.chest.length ? '木匣里只有一块布，是最后一回。在那之前，她一次也没替你擦过。' : '木匣是空的。她一次也没替你擦过。'}</p><div class=\"book\">${days}</div><div class=\"acts\"><button class=\"btn go\" data-act=\"rfinal\">合上</button></div></div>`;\n3132\t  }\n3133\t  return '';\n3134\t}\n3135\t// 第二幕末的鏡子：台上演得最多的那一族，已經滲進臉裡；第三幕起，那一族推給她就帶著台上的字\n3136\tconst topFams = () => (S ? Object.keys(S.played).sort((a, b) => S.played[b] - S.played[a]) : ['sing']);\n3137\tfunction mirrorPanel() {\n3138\t  const [f1, f2] = topFams(), h1 = HOME[FAM[f1].home], card = BASIC.find(t => T[t].f === f1), over = S.base >= R.overBase[0];\n3139\t  const pics = (a, b) => `<div class=\"mirrorc\"><figure><img src=\"${cardArt(card, 'home').url}\" alt=\"\">${a}</figure><figure><img src=\"${cardArt(card, 'home', true).url}\" alt=\"\">${b}</figure></div>`;\n3140\t  const body = over\n3141\t    ? `<p>你对着镜子卸完妆。脸上还有一层${fc(f1)}的颜色——不是今天的油彩，是这几天一层层渗进去的，怎么擦都在。</p>${pics('你想给她的', '她听见的')}\n3142\t       <p>明天起（第三幕），你推给她的「${h1.n}」会带着台上的字。她听见的不是你，是戏：这一族推出去就算被染，灯上留一道痕。${S.base >= R.overBase[1] ? `底色已经到 ${R.overBase[1]}，${fc(f2)}那一族也一样。` : `底色到 ${R.overBase[1]}，演得第二多的那一族也会这样。`}</p>`\n3143\t    : `<p>你对着镜子卸完妆。镜子里，是你自己的脸。</p>${pics('现在', `底色到 ${R.overBase[0]} 以后`)}\n3144\t       <p>这几天你演得最多的是${fc(f1)}（${S.played[f1]} 张）。每晚没卸掉的油彩，睡一觉就渗进脸里，变成底色。第三幕里，底色到 ${R.overBase[0]}，你推给她的「${h1.n}」就会带着台上的字——推出去，就算被染。</p>`;\n3145\t  return `<div class=\"panel\"><h2>镜子</h2>${body}<p class=\"note\">现在底色 ${S.base}。底色只会多，不会少；每 2 点，妆匣少一格。</p><div class=\"acts\"><button class=\"btn go\" data-act=\"mirrorok\">睡吧</button></div></div>`;\n3146\t}\n3147\tfunction renderChoices() {\n3148\t  const opts = [], t = S.T;\n3149\t  const o = (label, act, sub, disabled, arg, pri) => opts.push(`<button class=\"opt ${pri ? 'pri' : ''}\" data-act=\"${act}\" ${arg !== undefined ? `data-arg=\"${arg}\"` : ''} ${disabled ? 'disabled' : ''}>${label}${sub ? `<small>${sub}</small>` : ''}</button>`);\n3150\t  if (busy || panel === 'rules' || sheet) { $('#choices').innerHTML = ''; return; }\n3151\t  const n = t.layers.length;\n3152\t  if (view === 'morning') {\n3153\t    const st = starterOf(S), yes = canDepart(S);\n3154\t    if (S.day !== R.days || S.choice) o(S.choice === 'lamp' ? '回家' : '出门', 'depart', yes ? (S.choice === 'lamp' ? '今天不上台' : '') : `还没带${st ? FAM[st].n : ''}`, !yes, undefined, yes);\n3155\t  }\n3156\t  if (view === 'stage') {\n3157\t    const stuck = !t.box.some(id => !t.used[id] && canStage(S, id) && (!t.plays.length || fits(S, id)));\n3158\t    if (t.ended) o(S.choice === 'stage' ? '散戏' : '回家', 'todoor', '', false, undefined, true);"}]},"parent_tool_use_id":null,"session_id":"6a86d5cc-dadd-48d8-88f6-40a0a537648f","uuid":"a5a82dfa-1830-4b91-bf21-067988a7af63","timestamp":"2026-11-12T13:30:33.305Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/tsun/Projects/game-dise/原型/v1.6/index.html","content":"  const nu = m.querySelector('.panel, .spread');\n  if (nu) nu.scrollTop = top;\n  if (fa) {\n    const b = m.querySelector(`[data-act=\"${fa[0]}\"]${fa[1] !== undefined ? `[data-arg=\"${CSS.escape(fa[1])}\"]` : ''}`);\n    if (b && !b.disabled) b.focus({ preventScroll: true });\n  }\n}\nfunction morningPanel() {\n  const t = S.T;\n  if (S.day === R.days && !S.choice) {\n    return `<div class=\"yuan\"><h3>元宵，三选一</h3><div class=\"pair\">\n      <button class=\"yn\" data-act=\"yuan\" data-arg=\"stage\">上台<small>起手打 · 金 ×2 · 不回家，灯由她一个人点</small></button>\n      <button class=\"yn\" data-act=\"yuan\" data-arg=\"lamp\">回家点灯<small>不演 · 灯点亮 · 只有这条路能到美满</small></button>\n      <button class=\"yn\" data-act=\"yuan\" data-arg=\"cover\">替小凤代演<small>起手唱 · 金记在她名下，她留在水牌上</small></button>\n    </div></div>`;\n  }\n  if (lockedBox(S) || S.choice === 'lamp') return '';\n  const kinds = [...BASIC, ...BORROWED, ...SHOP, ...GIFTS].filter(k => S.deck.some(c => c.t === k));\n  const cells = kinds.map(k => {\n    const free = S.deck.filter(c => c.t === k && !t.box.includes(c.id)), can = free.length > 0;\n    const nk = needKind(k);\n    return `<button class=\"spc ${nk && can ? 'want' : ''}\" data-act=\"pick\" data-arg=\"${k}\" data-t=\"${k}\" ${can ? '' : 'disabled'} aria-label=\"${T[k].n}，还有 ${free.length} 张${nk ? '，背面是她今晚要的' : ''}\"><img src=\"${cardArt(k, 'stage').url}\" alt=\"\"><span class=\"ct\">${free.length}</span>${nk && can ? '<span class=\"wtag\" aria-hidden=\"true\">家</span>' : ''}</button>`;\n  }).join('');\n  const shop = t.offers.length ? `<button class=\"mini\" data-act=\"shop\" style=\"border-color:#f2d48a;color:#f2d48a\">后台 · 孙师父（花卖座，名次会掉）</button>` : '';\n  return `<div class=\"spread\"><div class=\"sph\">卡组 · 点一张放进妆匣</div>${cells}${shop ? `<div class=\"tools2\">${shop}</div>` : ''}</div>`;\n}\n// 攤開的牌照桌上的空位排：在這塊空位裡把牌放到最大，放不下一列就折行\nfunction fitSpread() {\n  const sp = $('#mid .spread');\n  if (!sp) return;\n  const n = sp.querySelectorAll('.spc').length, mid = $('#mid').getBoundingClientRect(), cs = getComputedStyle(sp);\n  const padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight), padY = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);\n  const gx = parseFloat(cs.columnGap) || 10, gy = parseFloat(cs.rowGap) || 8, tools = (sp.querySelector('.tools2')?.offsetHeight || 32) + gy + (sp.querySelector('.sph')?.offsetHeight || 0) + gy;\n  // 可用的空位：寬螢幕夾在左邊木牌、妝匣和右邊水牌之間，從情報底下開始；窄螢幕在木牌底下、整個寬度\n  const R = el => (el && !el.hidden && el.getClientRects().length ? el.getBoundingClientRect() : null);\n  const plate = R($('#plate')), tray = R($('#leftcol')), side = R(document.querySelector('.side')), tm = R($('#topmid'));\n  const wide = innerWidth >= 760;\n  let topY, gut;\n  if (wide) {\n    gut = Math.max(plate ? plate.right : 0, tray && tray.top < mid.bottom ? tray.right : 0, side ? innerWidth - side.left : 0) + 12;\n    topY = (tm && tm.height > 4 ? tm.bottom : plate ? plate.top : mid.top) + 8;\n  } else {\n    gut = 8;\n    topY = Math.max(plate ? plate.bottom : 0, side ? side.bottom : 0, tm ? tm.bottom : 0) + 8;\n  }\n  topY = Math.min(topY, mid.top);\n  const W = innerWidth - 2 * gut - padX - 2, H = mid.bottom - topY - padY - tools - 6;\n  let best = { h: 0, cols: 4, rows: 99 };\n  for (let cols = 1; cols <= n; cols++) {\n    const rows = Math.ceil(n / cols);\n    const h = Math.min(210, (H - (rows - 1) * gy) / rows, (W - (cols - 1) * gx) / cols * 1.5);\n    // 牌已經到最大了，就排成行數少的；行數一樣，取每行少的（排得勻）\n    if (h > best.h + 0.5 || (h >= 209.5 && best.h >= 209.5 && rows < best.rows)) best = { h, cols, rows };\n  }\n  const h = Math.max(84, Math.floor(best.h));\n  sp.style.top = `${topY - mid.top}px`;\n  sp.style.maxHeight = `${mid.bottom - topY}px`;\n  sp.style.setProperty('--cols', best.cols);\n  sp.style.setProperty('--chh', `${h}px`);\n  sp.style.setProperty('--cw', `${Math.round(h / 1.5)}px`);\n}\naddEventListener('resize', () => { if (view === 'morning') fitSpread(); });\n// 試排：用卡組裡這些牌，今天起手打四張，最好的一條鏈能拿多少金（不算擲骰）\nfunction bestLineGold(types, n = 4) {\n  const start = starterOf(S);\n  if (!start) return 0;\n  const cnt = {}; types.forEach(t => { cnt[t] = (cnt[t] || 0) + 1; });\n  let best = 0;\n  const walk = (k, want, g) => {\n    if (k === n) { best = Math.max(best, g); return; }\n    for (const t of Object.keys(cnt)) {\n      const tp = T[t];\n      if (!cnt[t] || tp.home || (k === 0 ? !(tp.f === want || tp.wild) : !(tp.wild || want === '*' || tp.f === want))) continue;\n      const add = tp.g + (k === 0 ? R.openGold + (has(S, 'gujing') ? 3 : 0) : (R.chainGold[Math.min(k + 1, R.stageMax)] + (has(S, 'qinshi') ? 1 : 0)) * (tp.boost ? 2 : 1)) + (tp.fin && k >= 3 ? tp.fin : 0);\n      cnt[t] -= 1; walk(k + 1, tp.wild ? '*' : tp.next, g + add); cnt[t] += 1;\n    }\n    best = Math.max(best, g);\n  };\n  walk(0, start, 0);\n  return best;\n}\n// 還剩幾場戲（今天這場也算）\nconst daysLeft = () => R.days - S.day + 1;\n// 幾天回本：每天多拿 d 金，價錢 p\nconst payback = (d, p) => { const n = Math.ceil(p / d), left = daysLeft(); return n <= left ? `约 ${n} 天回本（还剩 ${left} 场）` : `<span class=\"bad\">还剩 ${left} 场，回不了本</span>`; };\nfunction previewTx(k) {\n  const p = priceOf(k);\n  if (RELICS[k]) {\n    if (k === 'qinshi') return `四张链每天约 +3 金；${payback(3, p)}`;\n    if (k === 'gujing') return `每天开得正 +3 金；${payback(3, p)}`;\n    if (k === 'cha') return '完美的机会从一半变成三分之二：一场多三四金';\n    if (k === 'lian') return '多一格：多带一张回家，或多一张卸妆';\n    if (k === 'jin') return '她擦一次 3 层：上四张，只要再弃一张';\n    if (k === 'you') return '灭灯只熄 1（熄过一回，就到不了美满）';\n    if (k === 'luo') return '每天接错一次不伤她';\n    return '';\n  }\n  const deck = S.deck.map(c => c.t), base = bestLineGold(deck), more = bestLineGold([...deck, k]);\n  const d = more - base;\n  const tp = T[k], why = tp.wild ? '断了的链靠它接回来' : tp.clean ? '脸上少一层，省一张卸妆的牌' : '';\n  return d > 0 ? `放进今天的四张链：<b>+${d} 金</b>${tp.heavy ? '，多一层油彩' : tp.clean ? '，还少一层油彩' : ''}；起手天天换，${payback(Math.max(1, d / 2), p)}` : why ? `今天的链用不上它；${why}` : `今天起手${FAM[starterOf(S)]?.n || ''}用不上，换个日子再看`;\n}\n// 買了以後掉到第幾：照現在的水牌算\nfunction afterBuy(k) {\n  const p = priceOf(k), r0 = rankOf(S);\n  S.gold -= p; const r1 = rankOf(S); S.gold += p;\n  const ne = nextExam(S), risk = ne && r1 >= ne.fail;\n  return `买了：卖座 ${S.gold} → ${S.gold - p}，水牌第 ${r0} → <b class=\"${r1 > r0 ? 'bad' : ''}\">${r1}</b>${risk ? `<br><span class=\"bad\">第 ${ne.day} 天考核${examTx(ne)}，小心</span>` : ''}`;\n}\n// 後台：孫師父每天兩張牌、一樣物件\nfunction shopPanel() {\n  const t = S.T;\n  const cells = t.offers.map(k => {\n    const sold = t.sold.includes(k) || S.relics.includes(k), can = canBuy(S, k), rel = RELICS[k];\n    const pic = rel ? `<div class=\"relic\" aria-hidden=\"true\">${rel.n[0]}</div>` : `<img src=\"${cardArt(k, 'stage').url}\" alt=\"${T[k].n}\" data-t=\"${k}\" class=\"spc\" style=\"width:96px;height:144px\">`;\n    const kw = rel ? `<b>物件 · ${rel.n}</b><br>${rel.tx}<br>买一次，整季都有用。` : `${stageLines(k).join('<br>')}<br>背面 ${HOME[FAM[T[k].f].home].n}`;\n    return `<div class=\"offer ${sold ? 'sold' : ''} ${rel ? 'isrel' : ''}\">${pic}\n      <div class=\"kw\">${kw}</div><div class=\"pv\">${previewTx(k)}</div><div class=\"pr\">${priceOf(k)} 金</div>${sold ? '' : `<div class=\"pv ab\">${afterBuy(k)}</div>`}\n      <button class=\"btn small ${can ? 'go' : ''}\" data-act=\"buy\" data-arg=\"${k}\" ${can ? '' : 'disabled'}>${sold ? '买下了' : can ? '买' : '钱不够'}</button></div>`;\n  }).join('');\n  return `<div class=\"panel shopp\"><h2>后台 · 孙师父<button class=\"btn small\" style=\"float:right\" data-act=\"close\">回桌上</button></h2>\n    <p class=\"note\">“这几张，是我年轻时候的看家本事。拿去，别糟践了。”</p>\n    <div class=\"purse\"><span>卖座<b>${S.gold}</b></span><span>水牌第<b>${rankOf(S)}</b></span><span>还剩 <b>${daysLeft()}</b> 场</span></div>\n    <p class=\"note\">只有一种金：花的就是卖座，买了水牌马上往下掉，要靠往后几天多挣回来。买下的牌进卡组，以后每天都能装；物件买一次整季都在。明天孙师父换一批。</p>\n    ${S.relics.length ? `<p class=\"note\">你已经有：${S.relics.map(r => RELICS[r].n).join('、')}</p>` : ''}\n    <div class=\"shop\">${cells}</div></div>`;\n}\nfunction waterPanel() {\n  const ev = eventOf(S), k = S.events[S.day];\n  return `<div class=\"panel\"><h2>水牌<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2>\n    <p class=\"note\">记到第 ${boardDay(S)} 天。每天散戏后，加上当天挣的卖座。</p>${boardHTML()}\n    ${ev ? `<p class=\"note\">今天：${EV_TX[k]()}</p>` : ''}</div>`;\n}\nfunction rulesPanel() {\n  const P = S.played;\n  return `<div class=\"panel rules\"><h2>规矩<button class=\"btn small\" style=\"float:right\" data-act=\"close\">关上</button></h2>\n    <h4>内账（试玩用）</h4><div class=\"ledger\"><span>卖座 ${S.gold}</span><span>花掉 ${S.spent}</span><span>灯 ${S.lamp}</span><span>痕 ${S.scars}</span><span>灭灯 ${S.outs}</span><span>底色 ${S.base}</span><span>满足 ${S.met.join('/')}</span><span>小凤 +${S.fengGold}</span><span>唱 ${P.sing} 念 ${P.speak}</span><span>做 ${P.act} 打 ${P.fight}</span><span>水牌第 ${rankOf(S)}</span></div>\n    <h4>技巧</h4><ul class=\"tips\">${TIPS.map(r => `<li>${r}</li>`).join('')}</ul>\n    <h4>待你确认：可以开关</h4><ul>\n      <li>「开得正」+1 金：<button class=\"btn small\" data-act=\"opt\" data-arg=\"open\" aria-pressed=\"${S.opt.open}\">${S.opt.open ? '保留' : '不要'}</button></li>\n    </ul>\n    <h4>待你确认：还没定</h4><ul>${PENDING.map(r => `<li>${r}</li>`).join('')}</ul>\n    <h4>规矩</h4><ol>${RULES.map(r => `<li>${termify(r)}</li>`).join('')}</ol>\n    <h4>设定没写死、原型自拟的</h4><ul>${ASSUME.map(r => `<li>${r}</li>`).join('')}</ul>\n    <div class=\"acts\"><button class=\"btn\" data-act=\"mute\">${muted ? '开声音' : '关声音'}</button><button class=\"btn\" data-act=\"again\">重开一局</button></div></div>`;\n}\nfunction boardHTML() {\n  return `<ol class=\"board\">${boardOf(S).map((r, i) => `<li class=\"${r.me ? 'me' : ''}\"><span>${i + 1}. ${esc(r.n)}</span><span>${r.g}</span></li>`).join('')}</ol>`;\n}\nfunction sheetPanel() {\n  const k = sheet.k;\n  if (k === 'board') {\n    const a = actOf(S.day), ex = examOf(S);\n    return `<div class=\"panel\"><h2>水牌 · 考核</h2><p class=\"note\">第${'一二三'[a]}幕${ACT_N[a]}，到这里。魏老板看水牌定去留：${examTx(ex)}，排到第 ${ex.fail} 名${ex.fail < R.ranks ? '或更后' : ''}就摘牌。</p>${boardHTML()}\n      ${ex.pass ? `<p>你排第 ${ex.rank}，留下了。${a === 0 ? `第 7 天还有一次：${examTx(nextExam({ day: 4 }))}。` : ''}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"nextact\">第${'一二三'[a + 1]}幕</button></div>`\n    : `<p class=\"fired\">你排第 ${ex.rank}。魏老板把你的牌子摘了下来。</p><p class=\"note\">这一季到这里为止。回家，最后一次卸妆。</p><div class=\"acts\"><button class=\"btn go\" data-act=\"nextact\">摘牌，回家</button></div>`}</div>`;\n  }\n  if (k === 'mirror') return mirrorPanel();\n  if (k === 'r_board') {\n    const rk = rankOf(S);\n    const tx = S.fired ? `第 ${S.fired} 天的考核，你排第 ${rk}。魏老板把你的牌子摘了下来。` : S.left ? `她走的那天，是第 ${S.left} 天。水牌上，你排第 ${rk}。` : rk === R.ranks ? '你的名字被摘了下来。' : rk === 1 ? '最上面那块牌子，写的是你。' : '';\n    return `<div class=\"panel\"><h2>水牌</h2>${boardHTML()}<p class=\"note\">${tx}${S.choice === 'cover' ? '小凤的名字还挂着。' : ''}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"rstep\" data-arg=\"r_home\">回家</button></div></div>`;\n  }\n  if (k === 'r_home') {\n    const seat = seatEmpty(S) || wifeOf(S) === 2;\n    const tx = S.left ? `灯坊对面的椅子空着。那盏灯搁在桌上：糊了 ${Math.min(LSEG, Math.floor(S.lamp / 2))} 片纸（糊满要 ${LSEG} 片），熄过 ${S.outs} 回，划了 ${S.scars} 道。没糊完。`\n      : S.fired ? (wifeOf(S) === 0 ? '你素着脸回家，比平时早。她愣了一下，把灯骨推过来：“正好，帮我糊完。”' : '你回家比平时早。她没问，给你盛了饭。灯上有几处熄过。')\n      : S.lit ? `灯亮着，${seat ? '是你自己点的。对面的椅子空着。' : '你们一起点的。'}${S.lamp < R.happyLamp ? '有几处熄过，补不回来了。' : ''}` : S.litAlone ? '你回来时，灯已经亮了。是她一个人点的。' : seat ? '对面的椅子空着。灯没有点。' : '灯还搁在桌上，没有点。她抬头看了你一下。';\n    return `<div class=\"panel\"><h2>回家</h2><p>${tx}</p><div class=\"acts\"><button class=\"btn go\" data-act=\"rstep\" data-arg=\"r_chest\">打开木匣</button></div></div>`;\n  }\n  if (k === 'r_chest') {\n    const days = Array.from({ length: endDay(S) }, (_, i) => { const L = S.chest.filter(c => c.day === i + 1); return `<div>第 ${i + 1} 天<div class=\"cl\">${L.map(c => `<i style=\"background:${FCOL[c.f]}\"></i>`).join('') || ''}</div></div>`; }).join('');\n    return `<div class=\"panel\"><h2>木匣</h2><p class=\"note\">${S.chest.some(c => !c.last) ? `她替你擦过 ${S.chest.filter(c => !c.last).length} 层。每一块布都叠着，按日子放好。${S.chest.some(c => c.last) ? '最上面那一块，是最后一回。' : ''}` : S.chest.length ? '木匣里只有一块布，是最后一回。在那之前，她一次也没替你擦过。' : '木匣是空的。她一次也没替你擦过。'}</p><div class=\"book\">${days}</div><div class=\"acts\"><button class=\"btn go\" data-act=\"rfinal\">合上</button></div></div>`;\n  }\n  return '';\n}\n// 第二幕末的鏡子：台上演得最多的那一族，已經滲進臉裡；第三幕起，那一族推給她就帶著台上的字\nconst topFams = () => (S ? Object.keys(S.played).sort((a, b) => S.played[b] - S.played[a]) : ['sing']);\nfunction mirrorPanel() {\n  const [f1, f2] = topFams(), h1 = HOME[FAM[f1].home], card = BASIC.find(t => T[t].f === f1), over = S.base >= R.overBase[0];\n  const pics = (a, b) => `<div class=\"mirrorc\"><figure><img src=\"${cardArt(card, 'home').url}\" alt=\"\">${a}</figure><figure><img src=\"${cardArt(card, 'home', true).url}\" alt=\"\">${b}</figure></div>`;\n  const body = over\n    ? `<p>你对着镜子卸完妆。脸上还有一层${fc(f1)}的颜色——不是今天的油彩，是这几天一层层渗进去的，怎么擦都在。</p>${pics('你想给她的', '她听见的')}\n       <p>明天起（第三幕），你推给她的「${h1.n}」会带着台上的字。她听见的不是你，是戏：这一族推出去就算被染，灯上留一道痕。${S.base >= R.overBase[1] ? `底色已经到 ${R.overBase[1]}，${fc(f2)}那一族也一样。` : `底色到 ${R.overBase[1]}，演得第二多的那一族也会这样。`}</p>`\n    : `<p>你对着镜子卸完妆。镜子里，是你自己的脸。</p>${pics('现在', `底色到 ${R.overBase[0]} 以后`)}\n       <p>这几天你演得最多的是${fc(f1)}（${S.played[f1]} 张）。每晚没卸掉的油彩，睡一觉就渗进脸里，变成底色。第三幕里，底色到 ${R.overBase[0]}，你推给她的「${h1.n}」就会带着台上的字——推出去，就算被染。</p>`;\n  return `<div class=\"panel\"><h2>镜子</h2>${body}<p class=\"note\">现在底色 ${S.base}。底色只会多，不会少；每 2 点，妆匣少一格。</p><div class=\"acts\"><button class=\"btn go\" data-act=\"mirrorok\">睡吧</button></div></div>`;\n}\nfunction renderChoices() {\n  const opts = [], t = S.T;\n  const o = (label, act, sub, disabled, arg, pri) => opts.push(`<button class=\"opt ${pri ? 'pri' : ''}\" data-act=\"${act}\" ${arg !== undefined ? `data-arg=\"${arg}\"` : ''} ${disabled ? 'disabled' : ''}>${label}${sub ? `<small>${sub}</small>` : ''}</button>`);\n  if (busy || panel === 'rules' || sheet) { $('#choices').innerHTML = ''; return; }\n  const n = t.layers.length;\n  if (view === 'morning') {\n    const st = starterOf(S), yes = canDepart(S);\n    if (S.day !== R.days || S.choice) o(S.choice === 'lamp' ? '回家' : '出门', 'depart', yes ? (S.choice === 'lamp' ? '今天不上台' : '') : `还没带${st ? FAM[st].n : ''}`, !yes, undefined, yes);\n  }\n  if (view === 'stage') {\n    const stuck = !t.box.some(id => !t.used[id] && canStage(S, id) && (!t.plays.length || fits(S, id)));\n    if (t.ended) o(S.choice === 'stage' ? '散戏' : '回家', 'todoor', '', false, undefined, true);","numLines":200,"startLine":2959,"totalLines":3877}},"tool_result_meta":[{"id":"toolu_01HWxhpQ23HDKZ7zWJXYamgG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
